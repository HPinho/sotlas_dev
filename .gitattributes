# Auto-detect text files and perform LF normalization
* text=auto
*.sh text eol=lf
*.bat text eol=crlf

# Syntax-highlighting fallback only: Rust/C are Linguist names, not Sotlas.
# Native Sotlas test recognition is provided by the Actions job and reports.
*.sotlas linguist-language=Rust linguist-detectable=true
*.sth    linguist-language=C    linguist-detectable=true

module test::string_native;

import core::string::*;
import core::alloc::*;

static mut g_arena_buf: [u8; 64] = 0;
static mut g_generic_arena_buf: [u8; 64] = 0;

static mut g_string_buf: [u8; 32] = 0;

pub fn main() -> i32 {
    let raw: *const u8 = "hello, world!" as *const u8;
    let s: StringSlice = string_from_raw(raw, 13);

    if string_len(s) != 13 {
        return 1;
    }
    if string_is_empty(s) {
        return 2;
    }
    if string_char_at(s, 0) != 104 { // 'h'
        return 3;
    }

    let hello_raw: *const u8 = "hello" as *const u8;
    let hello: StringSlice = string_from_raw(hello_raw, 5);
    if !string_starts_with(s, hello) {
        return 4;
    }

    let world_raw: *const u8 = "world!" as *const u8;
    let world: StringSlice = string_from_raw(world_raw, 6);
    if !string_ends_with(s, world) {
        return 5;
    }

    let sub: StringSlice = string_slice(s, 0, 5);
    if !string_equals(sub, hello) {
        return 6;
    }

    let comma_idx: i64 = string_find_char(s, 44); // ','
    if comma_idx != 5 {
        return 7;
    }

    let world_idx: i64 = string_find(s, world);
    if world_idx != 7 {
        return 8;
    }

    let missing_raw: *const u8 = "xyz" as *const u8;
    let missing: StringSlice = string_from_raw(missing_raw, 3);
    if string_find(s, missing) != -1 {
        return 9;
    }

    let empty: StringSlice = string_from_raw(null, 0);
    if string_find(s, empty) != 0 {
        return 10;
    }

    let comma_raw: *const u8 = ", " as *const u8;
    let comma_space: StringSlice = string_from_raw(comma_raw, 2);
    let split: StringSplit = string_split_once(s, comma_space);
    if !split.found {
        return 11;
    }
    if !string_equals(split.before, hello) {
        return 12;
    }
    if !string_equals(split.after, world) {
        return 13;
    }

    let missing_split: StringSplit = string_split_once(s, missing);
    if missing_split.found {
        return 14;
    }
    if !string_equals(missing_split.before, s) {
        return 15;
    }

    let empty_split: StringSplit = string_split_once(s, empty);
    if empty_split.found {
        return 16;
    }

    let mut combined: String = string_new(g_string_buf as *mut u8, 32);
    if !string_concat_into(&mut combined, hello, world) {
        return 17;
    }
    if combined.length != 11 {
        return 18;
    }

    let expected_raw: *const u8 = "helloworld!" as *const u8;
    let expected: StringSlice = string_from_raw(expected_raw, 11);
    if !string_equals(string_as_slice(&combined), expected) {
        return 19;
    }

    let mut too_small: String = string_new(g_string_buf as *mut u8, 5);
    if string_concat_into(&mut too_small, hello, world) {
        return 20;
    }
    if too_small.length != 0 {
        return 21;
    }

    let mut arena: ArenaAllocator = arena_new(g_arena_buf as *mut u8, 64);
    let mut arena_string: String = string_new_in_arena(&mut arena, 16);
    if arena_string.data == null || arena_string.capacity != 16 {
        return 22;
    }
    if arena_used(&arena) < 16 {
        return 23;
    }
    if !string_append_slice(&mut arena_string, hello) {
        return 24;
    }
    if !string_equals(string_as_slice(&arena_string), hello) {
        return 25;
    }

    if !string_reserve_in_arena(&mut arena_string, &mut arena, 32) {
        return 26;
    }
    if arena_string.capacity != 32 || arena_string.length != 5 {
        return 27;
    }
    if !string_equals(string_as_slice(&arena_string), hello) {
        return 28;
    }

    if string_reserve_in_arena(&mut arena_string, &mut arena, 128) {
        return 29;
    }
    if arena_string.capacity != 32 || arena_string.length != 5 {
        return 30;
    }
    if !string_equals(string_as_slice(&arena_string), hello) {
        return 31;
    }

    let append_more_raw: *const u8 = ", world!" as *const u8;
    let append_more: StringSlice = string_from_raw(append_more_raw, 8);
    let arena_string_ptr: *mut String = (&mut arena_string) as *mut String;
    let arena_ptr: *mut ArenaAllocator = (&mut arena) as *mut ArenaAllocator;
    if !string_append_slice_in_arena(arena_string_ptr, arena_ptr, append_more) {
        return 32;
    }
    if arena_string.length != 13 || arena_string.capacity < 13 {
        return 33;
    }
    if !string_equals(string_as_slice(&arena_string), s) {
        return 34;
    }

    let before_fail_length: usize = arena_string.length;
    let before_fail_capacity: usize = arena_string.capacity;
    if string_append_slice_in_arena(arena_string_ptr, arena_ptr, s) {
        return 35;
    }
    if arena_string.length != before_fail_length || arena_string.capacity != before_fail_capacity {
        return 36;
    }
    if !string_equals(string_as_slice(&arena_string), s) {
        return 37;
    }

    let mut char_arena: ArenaAllocator = arena_new(g_arena_buf as *mut u8, 64);
    let mut char_string: String = string_new_in_arena(&mut char_arena, 1);
    let char_string_ptr: *mut String = (&mut char_string) as *mut String;
    let char_arena_ptr: *mut ArenaAllocator = (&mut char_arena) as *mut ArenaAllocator;

    if !string_append_char_in_arena(char_string_ptr, char_arena_ptr, 65) {
        return 38;
    }
    if !string_append_char_in_arena(char_string_ptr, char_arena_ptr, 66) {
        return 39;
    }
    if char_string.length != 2 || char_string.capacity < 2 {
        return 40;
    }
    if string_char_at(string_as_slice(&char_string), 0) != 65 {
        return 41;
    }
    if string_char_at(string_as_slice(&char_string), 1) != 66 {
        return 42;
    }

    let failed_string: String = string_new_in_arena(&mut arena, 128);
    if failed_string.data != null || failed_string.capacity != 0 {
        return 43;
    }

    let mut generic_arena: ArenaAllocator = arena_new(
        g_generic_arena_buf as *mut u8,
        64
    );
    let generic_arena_ptr: *mut ArenaAllocator =
        (&mut generic_arena) as *mut ArenaAllocator;
    let generic: Allocator = arena_as_allocator(generic_arena_ptr);

    let first: *mut u8 = allocator_alloc(generic, 4, 1);
    if first == null {
        return 44;
    }
    unsafe {
        *first = 10;
        *(first + 1) = 20;
        *(first + 2) = 30;
        *(first + 3) = 40;
    }

    let grown: *mut u8 = allocator_realloc(generic, first, 4, 8, 1);
    if grown == null {
        return 45;
    }
    unsafe {
        if *grown != 10 || *(grown + 1) != 20 {
            return 46;
        }
        if *(grown + 2) != 30 || *(grown + 3) != 40 {
            return 47;
        }
    }

    let used_before_free: usize = arena_used(&generic_arena);
    allocator_free(generic, grown, 8, 1);
    if arena_used(&generic_arena) != used_before_free {
        return 48;
    }

    let mut owned_allocator: Allocator = arena_as_allocator(generic_arena_ptr);
    let owned_allocator_ptr: *mut Allocator =
        (&mut owned_allocator) as *mut Allocator;
    let owned: String = string_new_with_allocator(owned_allocator_ptr, 8);
    if owned.data == null || owned.capacity != 8 || owned.length != 0 {
        return 49;
    }
    if owned.allocator != owned_allocator_ptr {
        return 50;
    }

    let empty_owned: String =
        string_new_with_allocator(owned_allocator_ptr, 0);
    if empty_owned.data != null || empty_owned.capacity != 0 {
        return 51;
    }
    if empty_owned.allocator != owned_allocator_ptr {
        return 52;
    }

    return 0;
}

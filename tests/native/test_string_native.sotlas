module test::string_native;

import core::string::*;
import core::alloc::*;

static mut g_arena_buf: [u8; 64] = 0;
static mut g_generic_arena_buf: [u8; 64] = 0;
static mut g_owned_arena_buf: [u8; 48] = 0;

static mut g_string_buf: [u8; 32] = 0;

static mut g_deinit_arena_buf: [u8; 32] = 0;
static mut g_owned_free_count: u32 = 0;

fn tracking_alloc(
    context: *mut void,
    size: usize,
    alignment: usize
) -> *mut u8 {
    if context == null {
        return null;
    }
    unsafe {
        let arena: *mut ArenaAllocator =
            context as *mut ArenaAllocator;
        return arena_alloc_aligned(arena, size, alignment);
    }
}

fn tracking_realloc(
    context: *mut void,
    ptr: *mut u8,
    old_size: usize,
    new_size: usize,
    alignment: usize
) -> *mut u8 {
    if context == null || new_size == 0 {
        return null;
    }
    let grown: *mut u8 = tracking_alloc(context, new_size, alignment);
    if grown == null {
        return null;
    }
    if ptr != null {
        let mut copied: usize = old_size;
        if copied > new_size {
            copied = new_size;
        }
        let mut i: usize = 0;
        unsafe {
            while i < copied {
                *(grown + i) = *(ptr + i);
                i = i + 1;
            }
            i = 0;
            while i < old_size {
                *(ptr + i) = 238u8;
                i = i + 1;
            }
        }
    }
    return grown;
}

fn tracking_free(
    context: *mut void,
    ptr: *mut u8,
    size: usize,
    alignment: usize
) -> void {
    unsafe {
        g_owned_free_count = g_owned_free_count + 1;
    }
    return;
}

pub fn main() -> i32 {
    let mut byte_storage: [u8; 3] = 0;
    unsafe {
        byte_storage[0] = 65u8;
        byte_storage[1] = 0u8;
        byte_storage[2] = 66u8;
    }
    let embedded_nul: StringSlice = string_from_raw(
        byte_storage as *const u8, 3
    );
    let mut extracted_byte: u8 = 99u8;
    let extracted_byte_ptr: *mut u8 = unsafe {
        (&mut extracted_byte) as *mut u8
    };
    if !string_try_byte_at(embedded_nul, 1, extracted_byte_ptr) ||
       extracted_byte != 0u8 {
        return 87;
    }
    extracted_byte = 77u8;
    if string_try_byte_at(embedded_nul, 3, extracted_byte_ptr) ||
       extracted_byte != 77u8 {
        return 88;
    }
    if string_try_byte_at(embedded_nul, 0, null) {
        return 89;
    }

    let raw: *const u8 = "hello, world!" as *const u8;
    let s: StringSlice = string_from_raw(raw, 13);

    if string_len(s) != 13 {
        return 1;
    }
    if string_is_empty(s) {
        return 2;
    }
    if string_char_at(s, 0) != 104 { // 'h'
        return 3;
    }

    let hello_raw: *const u8 = "hello" as *const u8;
    let hello: StringSlice = string_from_raw(hello_raw, 5);
    if !string_starts_with(s, hello) {
        return 4;
    }

    let world_raw: *const u8 = "world!" as *const u8;
    let world: StringSlice = string_from_raw(world_raw, 6);
    if !string_ends_with(s, world) {
        return 5;
    }

    let sub: StringSlice = string_slice(s, 0, 5);
    if !string_equals(sub, hello) {
        return 6;
    }
    if string_compare(hello, hello) != 0 {
        return 83;
    }
    if string_compare(hello, world) >= 0 {
        return 84;
    }
    let malformed: StringSlice = string_from_raw(null, 1);
    let empty_utf8: StringSlice = string_from_raw(null, 0);
    if !string_is_valid_utf8(empty_utf8) {
        return 101;
    }
    if string_is_valid_utf8(malformed) {
        return 102;
    }
    if !string_is_valid_utf8(s) {
        return 103;
    }
    if !string_is_valid_utf8(embedded_nul) {
        return 112;
    }
    if string_compare(malformed, hello) != -2 {
        return 85;
    }
    if string_compare(hello, malformed) != -2 {
        return 86;
    }

    let mut utf8_two: [u8; 2] = 0;
    unsafe {
        utf8_two[0] = 0xC2u8;
        utf8_two[1] = 0xA2u8;
    }
    if !string_is_valid_utf8(string_from_raw(utf8_two as *const u8, 2)) {
        return 104;
    }
    let mut utf8_three: [u8; 3] = 0;
    unsafe {
        utf8_three[0] = 0xE2u8;
        utf8_three[1] = 0x82u8;
        utf8_three[2] = 0xACu8;
    }
    if !string_is_valid_utf8(string_from_raw(utf8_three as *const u8, 3)) {
        return 105;
    }
    let mut utf8_four: [u8; 4] = 0;
    unsafe {
        utf8_four[0] = 0xF0u8;
        utf8_four[1] = 0x9Fu8;
        utf8_four[2] = 0x92u8;
        utf8_four[3] = 0xA9u8;
    }
    if !string_is_valid_utf8(string_from_raw(utf8_four as *const u8, 4)) {
        return 106;
    }

    let mut invalid_utf8: [u8; 4] = 0;
    unsafe {
        invalid_utf8[0] = 0x80u8;
    }
    if string_is_valid_utf8(string_from_raw(invalid_utf8 as *const u8, 1)) {
        return 107;
    }
    unsafe {
        invalid_utf8[0] = 0xC0u8;
        invalid_utf8[1] = 0x80u8;
    }
    if string_is_valid_utf8(string_from_raw(invalid_utf8 as *const u8, 2)) {
        return 108;
    }
    unsafe {
        invalid_utf8[0] = 0xE2u8;
        invalid_utf8[1] = 0x82u8;
    }
    if string_is_valid_utf8(string_from_raw(invalid_utf8 as *const u8, 2)) {
        return 109;
    }
    unsafe {
        invalid_utf8[0] = 0xEDu8;
        invalid_utf8[1] = 0xA0u8;
        invalid_utf8[2] = 0x80u8;
    }
    if string_is_valid_utf8(string_from_raw(invalid_utf8 as *const u8, 3)) {
        return 110;
    }
    unsafe {
        invalid_utf8[0] = 0xF4u8;
        invalid_utf8[1] = 0x90u8;
        invalid_utf8[2] = 0x80u8;
        invalid_utf8[3] = 0x80u8;
    }
    if string_is_valid_utf8(string_from_raw(invalid_utf8 as *const u8, 4)) {
        return 111;
    }
    unsafe {
        invalid_utf8[0] = 0xF0u8;
        invalid_utf8[1] = 0x80u8;
        invalid_utf8[2] = 0x80u8;
        invalid_utf8[3] = 0x80u8;
    }
    if string_is_valid_utf8(string_from_raw(invalid_utf8 as *const u8, 4)) {
        return 113;
    }
    unsafe {
        invalid_utf8[0] = 0xF5u8;
    }
    if string_is_valid_utf8(string_from_raw(invalid_utf8 as *const u8, 4)) {
        return 114;
    }

    let comma_idx: i64 = string_find_char(s, 44); // ','
    if comma_idx != 5 {
        return 7;
    }

    let world_idx: i64 = string_find(s, world);
    if world_idx != 7 {
        return 8;
    }

    let missing_raw: *const u8 = "xyz" as *const u8;
    let missing: StringSlice = string_from_raw(missing_raw, 3);
    if string_find(s, missing) != -1 {
        return 9;
    }

    let empty: StringSlice = string_from_raw(null, 0);
    if string_find(s, empty) != 0 {
        return 10;
    }

    let comma_raw: *const u8 = ", " as *const u8;
    let comma_space: StringSlice = string_from_raw(comma_raw, 2);
    let split: StringSplit = string_split_once(s, comma_space);
    if !split.found {
        return 11;
    }
    if !string_equals(split.before, hello) {
        return 12;
    }
    if !string_equals(split.after, world) {
        return 13;
    }

    let missing_split: StringSplit = string_split_once(s, missing);
    if missing_split.found {
        return 14;
    }
    if !string_equals(missing_split.before, s) {
        return 15;
    }

    let empty_split: StringSplit = string_split_once(s, empty);
    if empty_split.found {
        return 16;
    }

    let mut combined: String = string_new(g_string_buf as *mut u8, 32);
    let combined_ptr: *mut String = unsafe { (&mut combined) as *mut String };
    if !string_concat_into(combined_ptr, hello, world) {
        return 17;
    }
    if combined.length != 11 {
        return 18;
    }

    let expected_raw: *const u8 = "helloworld!" as *const u8;
    let expected: StringSlice = string_from_raw(expected_raw, 11);
    if !string_equals(string_as_slice(combined_ptr as *const String), expected) {
        return 19;
    }

    let mut overlap_storage: [u8; 8] = 0;
    unsafe {
        overlap_storage[0] = 97u8;
        overlap_storage[1] = 98u8;
        overlap_storage[2] = 99u8;
        overlap_storage[3] = 100u8;
        overlap_storage[4] = 101u8;
        overlap_storage[5] = 102u8;
        overlap_storage[6] = 103u8;
        overlap_storage[7] = 104u8;
    }
    let mut overlap: String = string_new(overlap_storage as *mut u8, 8);
    overlap.length = 4;
    let overlap_ptr: *mut String = unsafe { (&mut overlap) as *mut String };
    let overlap_source: *const u8 = unsafe {
        (overlap_storage as *const u8) + 1
    };
    let overlap_slice: StringSlice = string_from_raw(overlap_source, 4);
    if !string_append_slice(overlap_ptr, overlap_slice) {
        return 95;
    }
    let overlap_expected_raw: *const u8 = "abcdbcde" as *const u8;
    let overlap_expected: StringSlice = string_from_raw(overlap_expected_raw, 8);
    if !string_equals(
        string_as_slice(overlap_ptr as *const String),
        overlap_expected
    ) {
        return 96;
    }

    let mut too_small: String = string_new(g_string_buf as *mut u8, 5);
    let too_small_ptr: *mut String = unsafe { (&mut too_small) as *mut String };
    let mut empty_append_storage: [u8; 2] = 0;
    unsafe {
        empty_append_storage[0] = 65u8;
        empty_append_storage[1] = 66u8;
    }
    let mut empty_append_target: String =
        string_new(empty_append_storage as *mut u8, 2);
    empty_append_target.length = 2;
    let empty_append_ptr: *mut String = unsafe {
        (&mut empty_append_target) as *mut String
    };
    let empty_after_append: StringSlice = string_from_raw(null, 0);
    if !string_append_slice(empty_append_ptr, empty_after_append) {
        return 97;
    }
    if empty_append_target.length != 2 {
        return 98;
    }
    unsafe {
        if empty_append_storage[0] != 65u8 || empty_append_storage[1] != 66u8 {
            return 99;
        }
    }
    if too_small.length != 0 {
        return 98;
    }
    if string_concat_into(too_small_ptr, hello, world) {
        return 20;
    }
    if too_small.length != 0 {
        return 21;
    }

    let mut arena: ArenaAllocator = arena_new(g_arena_buf as *mut u8, 64);
    let arena_ptr: *mut ArenaAllocator = unsafe { (&mut arena) as *mut ArenaAllocator };
    let mut arena_string: String = string_new_in_arena(arena_ptr, 16);
    let arena_string_ptr: *mut String = unsafe { (&mut arena_string) as *mut String };
    if arena_string.data == null || arena_string.capacity != 16 {
        return 22;
    }
    if arena_used(arena_ptr as *const ArenaAllocator) < 16 {
        return 23;
    }
    if !string_append_slice(arena_string_ptr, hello) {
        return 24;
    }
    if !string_equals(string_as_slice(arena_string_ptr as *const String), hello) {
        return 25;
    }

    if !string_reserve_in_arena(arena_string_ptr, arena_ptr, 32) {
        return 26;
    }
    if arena_string.capacity != 32 || arena_string.length != 5 {
        return 27;
    }
    if !string_equals(string_as_slice(arena_string_ptr as *const String), hello) {
        return 28;
    }

    if string_reserve_in_arena(arena_string_ptr, arena_ptr, 128) {
        return 29;
    }
    if arena_string.capacity != 32 || arena_string.length != 5 {
        return 30;
    }
    if !string_equals(string_as_slice(arena_string_ptr as *const String), hello) {
        return 31;
    }

    let append_more_raw: *const u8 = ", world!" as *const u8;
    let append_more: StringSlice = string_from_raw(append_more_raw, 8);
    if !string_append_slice_in_arena(arena_string_ptr, arena_ptr, append_more) {
        return 32;
    }
    if arena_string.length != 13 || arena_string.capacity < 13 {
        return 33;
    }
    if !string_equals(string_as_slice(arena_string_ptr as *const String), s) {
        return 34;
    }

    let before_fail_length: usize = arena_string.length;
    let before_fail_capacity: usize = arena_string.capacity;
    let oversized_raw: *const u8 = "01234567890123456789" as *const u8;
    let oversized: StringSlice = string_from_raw(oversized_raw, 20);
    if string_append_slice_in_arena(arena_string_ptr, arena_ptr, oversized) {
        return 35;
    }
    if arena_string.length != before_fail_length || arena_string.capacity != before_fail_capacity {
        return 36;
    }
    if !string_equals(string_as_slice(arena_string_ptr as *const String), s) {
        return 37;
    }

    let mut char_arena: ArenaAllocator = arena_new(g_arena_buf as *mut u8, 64);
    let char_arena_ptr: *mut ArenaAllocator = unsafe { (&mut char_arena) as *mut ArenaAllocator };
    let mut char_string: String = string_new_in_arena(char_arena_ptr, 1);
    let char_string_ptr: *mut String = unsafe { (&mut char_string) as *mut String };

    if !string_append_char_in_arena(char_string_ptr, char_arena_ptr, 65) {
        return 38;
    }
    if !string_append_char_in_arena(char_string_ptr, char_arena_ptr, 66) {
        return 39;
    }
    if char_string.length != 2 || char_string.capacity < 2 {
        return 40;
    }
    if string_char_at(string_as_slice(char_string_ptr as *const String), 0) != 65 {
        return 41;
    }
    if string_char_at(string_as_slice(char_string_ptr as *const String), 1) != 66 {
        return 42;
    }

    let failed_string: String = string_new_in_arena(arena_ptr, 128);
    if failed_string.data != null || failed_string.capacity != 0 {
        return 43;
    }

    let mut generic_arena: ArenaAllocator = arena_new(
        g_generic_arena_buf as *mut u8,
        64
    );
    let generic_arena_ptr: *mut ArenaAllocator =
        unsafe { (&mut generic_arena) as *mut ArenaAllocator };
    let generic: Allocator = arena_as_allocator(generic_arena_ptr);

    let first: *mut u8 = allocator_alloc(generic, 4, 1);
    if first == null {
        return 44;
    }
    unsafe {
        *first = 10;
        *(first + 1) = 20;
        *(first + 2) = 30;
        *(first + 3) = 40;
    }

    let grown: *mut u8 = allocator_realloc(generic, first, 4, 8, 1);
    if grown == null {
        return 45;
    }
    unsafe {
        if *grown != 10 || *(grown + 1) != 20 {
            return 46;
        }
        if *(grown + 2) != 30 || *(grown + 3) != 40 {
            return 47;
        }
    }

    let used_before_free: usize = arena_used(generic_arena_ptr as *const ArenaAllocator);
    allocator_free(generic, grown, 8, 1);
    if arena_used(generic_arena_ptr as *const ArenaAllocator) != used_before_free {
        return 48;
    }

    let mut owned_allocator: Allocator = arena_as_allocator(generic_arena_ptr);
    let owned_allocator_ptr: *mut Allocator =
        unsafe { (&mut owned_allocator) as *mut Allocator };
    let mut owned: String = string_new_with_allocator(owned_allocator_ptr, 8);
    if owned.data == null || owned.capacity != 8 || owned.length != 0 {
        return 49;
    }
    if owned.allocator != owned_allocator_ptr {
        return 50;
    }

    let owned_ptr: *mut String = unsafe { (&mut owned) as *mut String };
    if !string_append_slice(owned_ptr, hello) {
        return 51;
    }
    if !string_reserve(owned_ptr, 16) {
        return 52;
    }
    if owned.capacity != 16 || owned.length != 5 {
        return 53;
    }
    if !string_equals(string_as_slice(owned_ptr as *const String), hello) {
        return 54;
    }

    let before_failed_reserve: *mut u8 = owned.data;
    if string_reserve(owned_ptr, 128) {
        return 55;
    }
    if owned.data != before_failed_reserve || owned.capacity != 16 {
        return 56;
    }
    if owned.length != 5 || !string_equals(string_as_slice(owned_ptr as *const String), hello) {
        return 57;
    }

    let mut empty_owned: String =
        string_new_with_allocator(owned_allocator_ptr, 0);
    if empty_owned.data != null || empty_owned.capacity != 0 {
        return 58;
    }
    if empty_owned.allocator != owned_allocator_ptr {
        return 59;
    }

    let empty_owned_ptr: *mut String =
        unsafe { (&mut empty_owned) as *mut String };
    if !string_reserve(empty_owned_ptr, 4) {
        return 60;
    }
    if empty_owned.data == null || empty_owned.capacity != 4 {
        return 61;
    }
    if empty_owned.length != 0 {
        return 62;
    }

    let mut append_arena: ArenaAllocator = arena_new(
        g_owned_arena_buf as *mut u8,
        48
    );
    let append_arena_ptr: *mut ArenaAllocator =
        unsafe { (&mut append_arena) as *mut ArenaAllocator };
    let mut append_allocator: Allocator =
        arena_as_allocator(append_arena_ptr);
    let append_allocator_ptr: *mut Allocator =
        unsafe { (&mut append_allocator) as *mut Allocator };

    let mut owned_append: String =
        string_new_with_allocator(append_allocator_ptr, 5);
    let owned_append_ptr: *mut String =
        unsafe { (&mut owned_append) as *mut String };

    if !string_append_slice_owned(owned_append_ptr, hello) {
        return 63;
    }
    if owned_append.length != 5 || owned_append.capacity != 5 {
        return 64;
    }

    if !string_append_char_owned(owned_append_ptr, 44) {
        return 65;
    }
    if owned_append.length != 6 || owned_append.capacity != 8 {
        return 66;
    }

    if !string_append_slice_owned(owned_append_ptr, world) {
        return 67;
    }
    if owned_append.length != 12 || owned_append.capacity != 16 {
        return 68;
    }

    let expected_owned_raw: *const u8 =
        "hello,world!" as *const u8;
    let expected_owned: StringSlice =
        string_from_raw(expected_owned_raw, 12);
    if !string_equals(string_as_slice(owned_append_ptr as *const String), expected_owned) {
        return 69;
    }

    let before_owned_fail_data: *mut u8 = owned_append.data;
    let before_owned_fail_length: usize = owned_append.length;
    let before_owned_fail_capacity: usize = owned_append.capacity;
    if string_append_slice_owned(owned_append_ptr, s) {
        return 70;
    }
    if owned_append.data != before_owned_fail_data {
        return 71;
    }
    if owned_append.length != before_owned_fail_length {
        return 72;
    }
    if owned_append.capacity != before_owned_fail_capacity {
        return 73;
    }
    if !string_equals(string_as_slice(owned_append_ptr as *const String), expected_owned) {
        return 74;
    }

    let mut zero_owned: String =
        string_new_with_allocator(owned_allocator_ptr, 0);
    let zero_owned_ptr: *mut String =
        unsafe { (&mut zero_owned) as *mut String };
    if !string_append_char_owned(zero_owned_ptr, 90) {
        return 75;
    }
    if zero_owned.length != 1 || zero_owned.capacity != 8 {
        return 76;
    }
    if string_char_at(string_as_slice(zero_owned_ptr as *const String), 0) != 90 {
        return 77;
    }

    let mut deinit_arena: ArenaAllocator = arena_new(
        g_deinit_arena_buf as *mut u8,
        32
    );
    let deinit_arena_ptr: *mut ArenaAllocator =
        unsafe { (&mut deinit_arena) as *mut ArenaAllocator };
    let deinit_context: *mut void =
        deinit_arena_ptr as *mut void;
    let mut deinit_allocator: Allocator = allocator_new(
        deinit_context,
        tracking_alloc,
        tracking_realloc,
        tracking_free
    );
    let deinit_allocator_ptr: *mut Allocator =
        unsafe { (&mut deinit_allocator) as *mut Allocator };
    let mut deinit_string: String =
        string_new_with_allocator(deinit_allocator_ptr, 8);
    if deinit_string.data == null {
        return 78;
    }

    let deinit_string_ptr: *mut String =
        unsafe { (&mut deinit_string) as *mut String };
    string_deinit(deinit_string_ptr);
    unsafe {
        if g_owned_free_count != 1 {
            return 79;
        }
    }
    if deinit_string.data != null || deinit_string.length != 0 {
        return 80;
    }
    if deinit_string.capacity != 0 || deinit_string.allocator != null {
        return 81;
    }

    string_deinit(deinit_string_ptr);
    unsafe {
        if g_owned_free_count != 1 {
            return 82;
        }
    }

    let mut realloc_string: String =
        string_new_with_allocator(deinit_allocator_ptr, 2);
    let realloc_string_ptr: *mut String =
        unsafe { (&mut realloc_string) as *mut String };
    let ab_raw: *const u8 = "ab" as *const u8;
    let ab: StringSlice = string_from_raw(ab_raw, 2);
    if !string_append_slice(realloc_string_ptr, ab) {
        return 90;
    }
    let self_slice: StringSlice =
        string_as_slice(realloc_string_ptr as *const String);
    if !string_append_slice_owned(realloc_string_ptr, self_slice) {
        return 91;
    }
    let abab_raw: *const u8 = "abab" as *const u8;
    let abab: StringSlice = string_from_raw(abab_raw, 4);
    if realloc_string.length != 4 || realloc_string.capacity < 4 {
        return 92;
    }
    if !string_equals(
        string_as_slice(realloc_string_ptr as *const String),
        abab
    ) {
        return 93;
    }
    string_deinit(realloc_string_ptr);
    unsafe {
        if g_owned_free_count != 2 {
            return 94;
        }
    }

    return 0;
}

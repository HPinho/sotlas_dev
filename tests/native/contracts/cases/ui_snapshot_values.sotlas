module ui_snapshot_values;
import sotlas::runtime::ui::*;
static mut source_items:[UiItem;64]=0;
static mut target_items:[UiItem;64]=0;
static mut target_labels:[u8;8192]=0;
pub fn main_entry() -> u32 {
    let mut text:[u8;128]=0;let bytes:*mut u8=unsafe { text as *mut u8 };
    let mut index:usize=0;while index < 128 { unsafe { *(bytes+index)=65; }index=index+1; }
    let mut draft:UiView=ui_view(unsafe { source_items as *mut UiItem },64,2);
    let input:*mut UiView=unsafe { (&mut draft) as *mut UiView };
    let mut result:UiView=ui_view(unsafe { target_items as *mut UiItem },64,0);
    let output:*mut UiView=unsafe { (&mut result) as *mut UiView };
    index=0;
    while index < 64 {
        if !ui_button(input,index as u32+1,ui_rect(0,0,20,20),unsafe { bytes as *const u8 },128) { return 1; }
        index=index+1;
    }
    if !ui_snapshot(unsafe { input as *const UiView },output,unsafe { target_items as *mut UiItem },64,unsafe { target_labels as *mut u8 },8192)
        || !ui_view_valid(unsafe { output as *const UiView }) || result.count != 64 || result.focus != 2 { return 2; }
    // The maximum 64*128 snapshot owns independent label bytes.
    text[0]=90;let mut original:*mut UiItem=unsafe { source_items as *mut UiItem };unsafe { original.id=999; }
    let first:UiItem=unsafe { *(target_items as *mut UiItem) };let last:UiItem=unsafe { *((target_items as *mut UiItem)+63) };
    if target_labels[0] != 65 || target_labels[8191] != 65 || first.id != 1 || last.id != 64 { return 3; }
    if ui_key(output,13) != 2 || ui_click(output,1,1) != 64 || result.focus != 64 { return 4; }
    draft=ui_view(unsafe { source_items as *mut UiItem },64,0);
    if !ui_text(input,8,ui_rect(0,0,10,10),"",0) || !ui_text_field(input,9,ui_rect(10,0,10,10),"Ω😀",6) { return 5; }
    if !ui_snapshot(unsafe { input as *const UiView },output,unsafe { target_items as *mut UiItem },64,unsafe { target_labels as *mut u8 },6) { return 6; }
    let empty:UiItem=unsafe { *(target_items as *mut UiItem) };let unicode:UiItem=unsafe { *((target_items as *mut UiItem)+1) };
    if result.count != 2 || empty.length != 0 || unicode.length != 6 || target_labels[0] != 206 || target_labels[5] != 128 { return 6; }
    draft=ui_view(unsafe { source_items as *mut UiItem },64,0);
    if !ui_snapshot(unsafe { input as *const UiView },output,unsafe { target_items as *mut UiItem },64,unsafe { target_labels as *mut u8 },1)
        || result.count != 0 || result.error != 0 || !ui_view_valid(unsafe { output as *const UiView }) { return 7; }
    return 0;
}

module tensor_ops_values;
import sotlas::runtime::tensor_cpu::*;
import sotlas::runtime::tensor_ops::*;

pub fn main_entry()->u32 {
    let data:[f32;6]=[1.0,2.0,3.0,-4.0,-2.0,-3.0];
    let input:NativeF32View=NativeF32View{data:unsafe{data as *const f32},length:6};
    let mut result:[f32;2]=[91.0,92.0];
    let output:NativeF32MutView=NativeF32MutView{data:unsafe{result as *mut f32},length:2};
    if native_f32_row_sum_cpu(output,input,2,3)!=0 || result[0]!=6.0 || result[1]!=-9.0 { return 1; }
    if native_f32_row_mean_cpu(output,input,2,3)!=0 || result[0]!=2.0 || result[1]!=-3.0 { return 2; }
    if native_f32_row_max_cpu(output,input,2,3)!=0 || result[0]!=3.0 || result[1]!=-2.0 { return 3; }

    let vector:[f32;3]=[2.0,-1.0,0.5];
    let v:NativeF32View=NativeF32View{data:unsafe{vector as *const f32},length:3};
    let mut expanded:[f32;6]=0;
    let y:NativeF32MutView=NativeF32MutView{data:unsafe{expanded as *mut f32},length:6};
    if native_f32_broadcast_add_cpu(y,input,v,2,3)!=0
        || expanded[0]!=3.0 || expanded[1]!=1.0 || expanded[2]!=3.5
        || expanded[3]!=-2.0 || expanded[4]!=-3.0 || expanded[5]!=-2.5 { return 4; }
    let same:NativeF32View=NativeF32View{data:unsafe{expanded as *const f32},length:6};
    if native_f32_broadcast_mul_cpu(y,same,v,2,3)!=0
        || expanded[0]!=6.0 || expanded[1]!=-1.0 || expanded[2]!=1.75
        || expanded[3]!=-4.0 || expanded[4]!=3.0 || expanded[5]!=-1.25 { return 5; }
    if native_f32_broadcast_add_cpu(y,same,v,2,3)!=0
        || expanded[0]!=8.0 || expanded[1]!=-2.0 || expanded[2]!=2.25
        || expanded[3]!=-2.0 || expanded[4]!=2.0 || expanded[5]!=-0.75 { return 6; }

    // Reduction order is observable; do not reassociate the sum.
    let rounding:[f32;3]=[16777216.0,1.0,-16777216.0];
    let ordered:NativeF32View=NativeF32View{data:unsafe{rounding as *const f32},length:3};
    let scalar:NativeF32MutView=NativeF32MutView{data:output.data,length:1};
    if native_f32_row_sum_cpu(scalar,ordered,1,3)!=0 || result[0]!=0.0 { return 7; }

    // Check NaN propagation, infinity and the first signed zero maximum using
    // exact IEEE-754 bit patterns, without a host numeric runtime.
    let bits:[u32;6]=[1065353216,2143289345,1073741824,2147483648,0,4286578688];
    let bit_pointer:*const u32=unsafe{bits as *const u32};
    let special:NativeF32View=NativeF32View{data:unsafe{bit_pointer as *const f32},length:6};
    if native_f32_row_max_cpu(output,special,2,3)!=0 { return 8; }
    let out_bits:*const u32=unsafe{output.data as *const u32};
    if unsafe{*out_bits}!=2143289345 || unsafe{*(out_bits+1)}!=2147483648 { return 9; }
    let infinity_bits:[u32;3]=[1065353216,2139095040,1073741824];
    let infinity_pointer:*const u32=unsafe{infinity_bits as *const u32};
    let infinite:NativeF32View=NativeF32View{data:unsafe{infinity_pointer as *const f32},length:3};
    if native_f32_row_max_cpu(scalar,infinite,1,3)!=0 || unsafe{*out_bits}!=2139095040 { return 10; }
    let empty:NativeF32View=NativeF32View{data:null,length:0};
    if native_f32_row_sum_cpu(output,empty,2,0)!=0 || result[0]!=0.0 || result[1]!=0.0 { return 11; }
    let nothing:NativeF32MutView=NativeF32MutView{data:null,length:0};
    if native_f32_row_sum_cpu(nothing,empty,0,0)!=0
        || native_f32_row_mean_cpu(nothing,empty,0,0)!=0
        || native_f32_row_max_cpu(nothing,empty,0,0)!=0
        || native_f32_broadcast_add_cpu(nothing,empty,empty,5,0)!=0
        || native_f32_broadcast_mul_cpu(nothing,empty,empty,0,0)!=0 { return 12; }
    // Views are not limited to the compiler's small inline snapshot profile.
    let mut large:[f32;1024]=[1.0;1024];
    let factors:[f32;512]=[2.0;512];
    let large_view:NativeF32View=NativeF32View{data:unsafe{large as *const f32},length:1024};
    let large_output:NativeF32MutView=NativeF32MutView{data:unsafe{large as *mut f32},length:1024};
    let factors_view:NativeF32View=NativeF32View{data:unsafe{factors as *const f32},length:512};
    if native_f32_broadcast_mul_cpu(large_output,large_view,factors_view,2,512)!=0
        || native_f32_row_sum_cpu(output,large_view,2,512)!=0
        || result[0]!=1024.0 || result[1]!=1024.0 || large[1023]!=2.0 { return 13; }
    return 0;
}

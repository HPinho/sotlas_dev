module discern_variants;

enum Status { Ready, Busy, Offline }
static mut reads: u32 = 0;

fn current() -> Status {
    reads += 1;
    return Status::Busy;
}

pub fn main_entry() -> u32 {
    discern current() {
        case .Ready | Busy => { if reads == 1 { return 0; } return 1; }
        case Status::Offline => { return 2; }
    }
}

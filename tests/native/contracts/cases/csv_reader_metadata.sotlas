module csv_reader_metadata;
import sotlas::runtime::text::*;
import sotlas::runtime::csv::*;
pub fn main_entry()->u32 {
    let mut reader:NativeCsvReader=native_csv_open(native_text_open("a,b",3));
    let p:*mut NativeCsvReader=unsafe{(&mut reader) as *mut NativeCsvReader};
    reader=native_csv_open(native_text_open(unsafe{(p as usize) as *const u8},span_of::<NativeCsvReader>()));
    if native_csv_next(p).status!=1 || reader.offset!=0 || reader.column!=0 { return 1; }
    reader=native_csv_open(native_text_open("a,b",3));reader.row=4;
    if native_csv_next(p).status!=1 { return 2; }
    reader.row=0;reader.column=4;
    if native_csv_next(p).status!=1 { return 3; }

module pulse_cleanup;

static mut trace: u32 = 0;

fn mark(value: u32) -> void {
    trace = trace * 10 + value;
}

fn publish() -> u32 {
    defer mark(2);
    defer {
        pulse(release);
        mark(1);
    }
    pulse(acquire);
    return 42;
}

pub fn main_entry() -> u32 {
    if publish() != 42 || trace != 12 { return 1; }
    return 0;
}

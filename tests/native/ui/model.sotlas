module calculator_app::tests;
import calculator_app::model::*;
import sotlas::runtime::ui::*;

static mut test_items:[UiItem;32]=0;

fn result_is(expected:*const u8,length:usize) -> bool {
    let mut bytes:[u8;128]=0;
    let output:*mut u8=unsafe { bytes as *mut u8 };
    if calculator_ui_result(output,128) != length { return false; }
    let mut index:usize=0;
    while index < length {
        if unsafe { *(output+index) } != unsafe { *(expected+index) } { return false; }
        index=index+1;
    }
    return true;
}
fn expression_is(expected:*const u8,length:usize,caret:usize) -> bool {
    let mut view:UiView=ui_view(unsafe { test_items as *mut UiItem },32,2000);
    if !calculator_ui_view(unsafe { (&mut view) as *mut UiView }) { return false; }
    let field:UiItem=unsafe { *(view.items+1) };
    if field.length != length || field.caret != caret || calculator_ui_cursor() != caret || calculator_ui_length() != length { return false; }
    let mut index:usize=0;
    while index < length { if unsafe { *(field.label+index) } != unsafe { *(expected+index) } { return false; }index=index+1; }
    return true;
}
fn editing_tests() -> u32 {
    calculator_ui_reset();
    if !calculator_ui_key(36) || !calculator_ui_key(37) || !calculator_ui_key(39)
        || calculator_ui_delete() || calculator_ui_action(8) || !expression_is("",0,0) { return 30; }
    calculator_ui_action(49);calculator_ui_action(51);
    if !calculator_ui_seek(1) || !calculator_ui_action(43) || !expression_is("1+3",3,2) { return 31; }
    calculator_ui_action(61);if !result_is("4",1) || calculator_ui_cursor() != 2 { return 32; }
    if !calculator_ui_key(46) || !expression_is("1+",2,2) || !calculator_ui_action(8) || !expression_is("1",1,1) { return 33; }
    calculator_ui_key(36);
    if calculator_ui_action(8) || !calculator_ui_delete() || !expression_is("",0,0) { return 34; }
    calculator_ui_action(49);calculator_ui_action(47);calculator_ui_action(48);calculator_ui_action(61);
    if calculator_ui_error() != 4 { return 35; }
    calculator_ui_key(36);calculator_ui_key(39);calculator_ui_key(39);
    if calculator_ui_error() != 4 || !calculator_ui_delete() || calculator_ui_error() != 0 || !calculator_ui_action(50)
        || !expression_is("1/2",3,3) { return 36; }
    calculator_ui_action(61);if !result_is("0.5",3) { return 37; }
    if calculator_ui_seek(4) || calculator_ui_action(937) || !expression_is("1/2",3,3) { return 38; }
    calculator_ui_reset();let mut index:usize=0;
    while index < 128 { calculator_ui_action(49);index=index+1; }
    calculator_ui_key(36);
    if calculator_ui_action(50) || calculator_ui_cursor() != 0 || calculator_ui_length() != 128 || calculator_ui_error() != 9 { return 39; }
    if !calculator_ui_delete() || calculator_ui_error() != 0 || !calculator_ui_action(50) || calculator_ui_length() != 128 || calculator_ui_cursor() != 1 { return 40; }
    calculator_ui_key(35);if !calculator_ui_action(8) || calculator_ui_length() != 127 || calculator_ui_cursor() != 127 { return 41; }
    let mut view:UiView=ui_view(unsafe { test_items as *mut UiItem },32,55);let scene:*mut UiView=unsafe { (&mut view) as *mut UiView };
    if !calculator_ui_view(scene) || calculator_ui_dispatch(scene,5,36,0,0) || calculator_ui_cursor() != 127 { return 142; }
    view.focus=2000;
    if !calculator_ui_dispatch(scene,5,36,0,0) || calculator_ui_cursor() != 0 { return 43; }
    if calculator_ui_dispatch(scene,5,8,0,0) || !calculator_ui_dispatch(scene,2,8,0,0)
        || calculator_ui_cursor() != 0 || calculator_ui_length() != 127 { return 44; }
    if !calculator_ui_dispatch(scene,2,46,0,0) || calculator_ui_cursor() != 1 || calculator_ui_length() != 128 { return 45; }
    calculator_ui_action(67);if !expression_is("",0,0) { return 46; }
    return 0;
}
fn viewport_tests() -> u32 {
    calculator_ui_reset();calculator_ui_action(49);calculator_ui_action(47);calculator_ui_action(48);calculator_ui_action(61);calculator_ui_seek(1);
    let mut view:UiView=ui_view(unsafe { test_items as *mut UiItem },32,55);let scene:*mut UiView=unsafe { (&mut view) as *mut UiView };
    let mut iteration:u32=0;
    while iteration < 6 {
        let mut width:u32=280;let mut height:u32=420;
        if iteration == 1 { width=281;height=421; }
        if iteration == 2 { width=392;height=472; }
        if iteration == 3 { width=800;height=600; }
        if iteration == 4 { width=4096;height=4096; }
        if iteration == 5 { width=4294967295;height=4294967295; }
        if !calculator_ui_viewport(scene,width,height) || !ui_view_valid(unsafe { scene as *const UiView }) || view.count != 23 || view.focus != 55 { return 60; }
        if width > 4096 { width=4096; }if height > 4096 { height=4096; }
        let mut index:usize=0;
        while index < view.count {
            let item:UiItem=unsafe { *(view.items+index) };
            let bounds:UiRect=item.bounds;
            if bounds.x < 0 || bounds.y < 0 || (bounds.x as u32)+bounds.width > width || (bounds.y as u32)+bounds.height > height { return 61; }
            if item.kind == 2 {
                if ui_click(scene,bounds.x+(bounds.width/2) as i32,bounds.y+(bounds.height/2) as i32) != item.id { return 62; }
                if (index-3)%4 != 3 && ui_click(scene,bounds.x+bounds.width as i32,bounds.y+1) != 0 { return 63; }
            }
            index=index+1;
        }
        view.focus=55;iteration=iteration+1;
    }
    if !calculator_ui_viewport(scene,279,420) || view.count != 1 || view.focus != 55 || view.error != 0
        || calculator_ui_dispatch(scene,2,57,0,0) || calculator_ui_dispatch(scene,3,0,30,170) || calculator_ui_dispatch(scene,5,13,0,0)
        || calculator_ui_length() != 3 || calculator_ui_cursor() != 1 || calculator_ui_error() != 4 { return 64; }
    if !calculator_ui_viewport(scene,280,419) || view.count != 1 || !calculator_ui_viewport(scene,1,1) || view.count != 1
        || !calculator_ui_viewport(scene,0,600) || view.count != 0 || !calculator_ui_viewport(scene,600,0) || view.count != 0 { return 65; }
    if !calculator_ui_viewport(scene,640,700) || view.count != 23 || view.focus != 55 || calculator_ui_cursor() != 1
        || !result_is("division by zero",16) || !expression_is("1/0",3,1) { return 66; }
    if calculator_ui_viewport(null,640,700) { return 67; }
    view=ui_view(null,32,55);
    if calculator_ui_viewport(scene,0,0) || view.error != 1 { return 68; }
    view=ui_view(unsafe { test_items as *mut UiItem },0,55);
    if calculator_ui_viewport(scene,1,1) || view.error != 1 { return 69; }
    return 0;
}
pub fn main_entry() -> u32 {
    if ui_rect(-1,0,10,10).valid || ui_rect(4090,0,20,20).valid { return 1; }
    let mut row:UiLayout=ui_row(ui_rect(10,20,30,40),5);
    let layout:*mut UiLayout=unsafe { (&mut row) as *mut UiLayout };
    let first:UiRect=ui_cell(layout,10); let second:UiRect=ui_cell(layout,15);
    if !first.valid || !second.valid || first.x != 10 || second.x != 25 || ui_cell(layout,1).valid { return 2; }
    let storage:*mut UiItem=unsafe { test_items as *mut UiItem };
    let mut view:UiView=ui_view(storage,32,2000);
    let scene:*mut UiView=unsafe { (&mut view) as *mut UiView };
    calculator_ui_reset();
    if !calculator_ui_view(scene) || view.count != 23 || view.error != 0 { return 3; }
    if ui_click(scene,-1,-1) != 0 || ui_click(scene,104,170) != 0 { return 4; }
    let seven:u32=ui_click(scene,30,170);
    if seven != 55 || view.focus != 55 || !calculator_ui_action(seven) { return 5; }
    if !calculator_ui_action(ui_click(scene,300,350)) || !calculator_ui_action(ui_click(scene,120,170)) { return 6; }
    if !calculator_ui_action(ui_click(scene,210,350)) || !result_is("15",2) { return 7; }
    if ui_key(scene,13) != 61 || ui_key(scene,32) != 61 { return 8; }
    view.focus=2000; ui_key(scene,9);
    if view.focus != 55 { return 9; }
    view.focus=8; ui_key(scene,9);
    if view.focus != 2000 { return 10; }
    calculator_ui_reset(); view.focus=55;
    if !calculator_ui_dispatch(scene,5,13,0,0) || calculator_ui_length() != 1 { return 20; }
    if calculator_ui_dispatch(scene,2,13,0,0) || calculator_ui_length() != 1 { return 21; }
    if !calculator_ui_dispatch(scene,5,32,0,0) || calculator_ui_length() != 2 { return 22; }
    calculator_ui_dispatch(scene,2,32,0,0);
    if calculator_ui_length() != 2 { return 23; }
    calculator_ui_reset();
    if !calculator_ui_action(50) || !calculator_ui_action(43) || !calculator_ui_action(51)
        || !calculator_ui_action(42) || !calculator_ui_action(52) || !calculator_ui_action(13) || !result_is("14",2) { return 11; }
    calculator_ui_reset(); calculator_ui_action(49); calculator_ui_action(47); calculator_ui_action(48); calculator_ui_action(61);
    if calculator_ui_error() != 4 { return 12; }
    calculator_ui_action(67); let mut index:usize=0;
    while index < 128 { if !calculator_ui_action(49) { return 13; } index=index+1; }
    if calculator_ui_action(50) || calculator_ui_length() != 128 || calculator_ui_error() != 9 { return 14; }
    if !calculator_ui_action(8) || calculator_ui_length() != 127 || calculator_ui_action(937) || calculator_ui_length() != 127 { return 15; }
    view=ui_view(storage,2,0);
    let bounds:UiRect=ui_rect(0,0,50,30);
    if !ui_button(scene,1,bounds,"ok",2) || ui_text(scene,1,bounds,"duplicate",9) || view.count != 1 || view.error != 3 { return 16; }
    view=ui_view(storage,1,0);
    if !ui_button(scene,1,bounds,"ok",2) || ui_button(scene,2,bounds,"full",4) || view.count != 1 || view.error != 1 { return 17; }
    view=ui_view(storage,32,0);
    if ui_text(scene,1,bounds,"\0",1) || view.count != 0 || view.error != 4 { return 18; }
    view=ui_view(null,32,0);
    if ui_button(scene,1,bounds,"ok",2) || view.error != 1 { return 19; }
    let editing:u32=editing_tests();if editing != 0 { return editing; }
    let viewport:u32=viewport_tests();if viewport != 0 { return viewport; }
    return 42;
}

module calculator_app::render_tests;
import calculator_app::model::*;
import sotlas::runtime::ui::*;
import sotlas::runtime::ui_windows::*;
import sotlas::runtime::window_windows::*;
static mut render_items:[UiItem;32]=0;
static mut snapshot_items:[UiItem;32]=0;
static mut snapshot_labels:[u8;4096]=0;

fn editor_key(scene:*mut UiView,key:u32,position:usize) -> bool {
    if !native_window_post(256,key as u64,0) { return false; }
    let mut event:NativeWindowEvent=NativeWindowEvent{kind:0,code:0,x:0,y:0};
    let events:*mut NativeWindowEvent=unsafe { (&mut event) as *mut NativeWindowEvent };
    let mut attempt:u32=0;
    while attempt < 64 {
        if native_window_next(events,false) && event.kind == 5 && event.code == key {
            return calculator_ui_dispatch(scene,event.kind,event.code,event.x,event.y) && calculator_ui_cursor() == position;
        }
        attempt=attempt+1;
    }
    return false;
}

pub fn main_entry() -> u32 {
    if !native_window_start() { return 1; }
    let mut title:[u16;2]=0; title[0]=83;
    if !native_window_create(unsafe { title as *const u16 },416,560,false) { native_window_stop(); return 2; }
    let mut view:UiView=ui_view(unsafe { render_items as *mut UiItem },32,2000);
    let scene:*mut UiView=unsafe { (&mut view) as *mut UiView };
    let frame:*const UiView=unsafe { (&view) as *const UiView };
    let mut published:UiView=ui_view(unsafe { snapshot_items as *mut UiItem },32,2000);
    let snapshot:*mut UiView=unsafe { (&mut published) as *mut UiView };
    let stable:*const UiView=unsafe { snapshot as *const UiView };
    calculator_ui_reset();
    let mut iteration:u32=0; let mut gdi:u32=0; let mut windows:u32=0;
    while iteration < 20 {
        if !calculator_ui_view(scene)
            || !ui_snapshot(frame,snapshot,unsafe { snapshot_items as *mut UiItem },32,unsafe { snapshot_labels as *mut u8 },4096)
            || !native_window_invalidate() || !ui_windows_paint(stable) { native_window_stop(); return 3; }
        if native_window_text(0,0,unsafe { title as *const u16 },1,0) || native_window_end() { native_window_stop(); return 4; }
        let current:u32=native_window_resource_count(0); let current_user:u32=native_window_resource_count(1);
        if iteration == 1 { gdi=current; windows=current_user; }
        if iteration > 1 && (current > gdi || current_user > windows) { native_window_stop(); return 5; }
        calculator_ui_action(49); iteration=iteration+1;
    }
    // Long input scrolls to the caret; Home and End remain renderable.
    calculator_ui_reset();iteration=0;
    while iteration < 128 { calculator_ui_action(49);iteration=iteration+1; }
    view.focus=2000;
    if !calculator_ui_view(scene) || !ui_windows_paint(frame) { native_window_stop(); return 15; }
    calculator_ui_key(36);
    if !calculator_ui_view(scene) || !ui_windows_paint(frame) { native_window_stop(); return 16; }
    calculator_ui_key(35);calculator_ui_key(37);
    if !calculator_ui_view(scene) || !ui_windows_paint(frame) { native_window_stop(); return 17; }
    if !editor_key(scene,36,0) || !editor_key(scene,39,1) || !editor_key(scene,46,1)
        || calculator_ui_length() != 127 || !editor_key(scene,35,127) { native_window_stop(); return 20; }
    // Failed frame input must not leave a paint session or selected font behind.
    view.error=1;
    if ui_snapshot(frame,snapshot,unsafe { snapshot_items as *mut UiItem },32,unsafe { snapshot_labels as *mut u8 },4096)
        || !native_window_invalidate() || !ui_windows_paint(stable) { native_window_stop(); return 13; }
    if ui_windows_paint(frame) || native_window_end() { native_window_stop(); return 6; }
    if !calculator_ui_view(scene) { native_window_stop(); return 9; }
    let mut first:*mut UiItem=unsafe { render_items as *mut UiItem };
    let international:*const u8="ação Ω 文 😀";
    let bounds:UiRect=ui_rect(24,20,344,28);
    unsafe { *first=UiItem{id:2001,kind:1,bounds:bounds,label:international,length:18,caret:0}; }
    if !ui_windows_paint(frame) { native_window_stop(); return 12; }
    let invalid:*const u8="\0";
    unsafe { *first=UiItem{id:2001,kind:1,bounds:bounds,label:invalid,length:1,caret:0}; }
    if ui_windows_paint(frame) || native_window_end() || native_window_unclip() { native_window_stop(); return 10; }
    if !calculator_ui_view(scene) || !ui_windows_paint(frame) { native_window_stop(); return 11; }
    if native_window_text_width(unsafe { title as *const u16 },1) != -1 { native_window_stop(); return 18; }
    if !native_window_begin() || native_window_begin() { native_window_stop(); return 7; }
    if native_window_text_width(unsafe { title as *const u16 },1) <= 0
        || native_window_text_width(unsafe { title as *const u16 },0) != 0 { native_window_stop(); return 19; }
    if !native_window_stop() || !native_window_stop() { return 8; }
    iteration=0;
    while iteration < 3 {
        if !native_window_start() || !native_window_create(unsafe { title as *const u16 },416,560,false)
            || !native_window_invalidate() || !ui_windows_paint(stable) || !native_window_stop() { return 14; }
        iteration=iteration+1;
    }
    return 42;
}

static mut storage: [u8; 4] = 0;

pub fn main() -> i32 {
    unsafe {
        storage[0] = 77;
    }

    let mut zero: StringBuf = string_buf_new(storage as *mut u8, 0);
    let zero_ptr: *mut StringBuf = unsafe { (&mut zero) as *mut StringBuf };
    if string_buf_append_char(zero_ptr, 65) {
        return 1;
    }
    if string_buf_append_str(zero_ptr, "A" as *const u8) {
        return 2;
    }
    unsafe {
        if storage[0] != 77 {
            return 3;
        }
    }

    let mut one: StringBuf = string_buf_new(storage as *mut u8, 1);
    let one_ptr: *mut StringBuf = unsafe { (&mut one) as *mut StringBuf };
    if string_buf_append_char(one_ptr, 65) {
        return 4;
    }
    if string_buf_len(one_ptr as *const StringBuf) != 0 {
        return 5;
    }

    let mut two: StringBuf = string_buf_new(storage as *mut u8, 2);
    let two_ptr: *mut StringBuf = unsafe { (&mut two) as *mut StringBuf };
    if !string_buf_append_char(two_ptr, 65) {
        return 6;
    }
    if string_buf_len(two_ptr as *const StringBuf) != 1 {
        return 7;
    }
    unsafe {
        if storage[0] != 65 || storage[1] != 0 {
            return 8;
        }
    }
    return 0;
}

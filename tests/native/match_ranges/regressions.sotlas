module match_regressions;
enum Code { First, Last }
fn boolean(value: bool) -> u32 { match value { true => return 42; false => return 1; } }
fn enumeration(value: Code) -> u32 { match value { Code::First => return 1; Code::Last => return 42; } }
fn scalar(value: i32) -> u32 { match value { -42 => return 42; _ => return 1; } }
pub fn main_entry() -> u32 {
    if boolean(true) != 42 || enumeration(Code::Last) != 42 || scalar(-42) != 42 { return 1; }
    return 42;
}

module sotlas_compile::main;
import core::mem::*;
import core::fmt::*;
import sotlas_compile::token::*;
import sotlas_compile::ast::*;
import sotlas_compile::lexer::*;
import sotlas_compile::emitter::*;

pub const MAX_TOKENS: usize = 65536;

static mut g_tokens: [Token; 65536] = 0;

@export
@system
pub fn sotlas_compile(source: *const u8, out_buf: *mut u8, max_len: usize) -> usize {
    if source == null || out_buf == null || max_len == 0 {
        return 0;
    }
    let mut tok_count: usize = 0;
    unsafe {
        tok_count = lex_source(source, g_tokens as *mut Token, MAX_TOKENS);
    }
    if tok_count == 0 {
        return 0;
    }
    let mut emitted: usize = 0;
    unsafe {
        emitted = emit_c_from_tokens(g_tokens as *const Token, tok_count, out_buf, max_len);
    }
    return emitted;
}

@export
@system
pub fn sotlas_native_compile(source: *const u8, len: usize, out_buf: *mut u8, max_out: usize) -> usize {
    return sotlas_compile(source, out_buf, max_out);
}

@export
@system
pub fn sotlas_native_compile_object(
    source: *const u8,
    len: usize,
    output: *mut u8,
    capacity: usize,
    out_length: *mut usize
) -> bool {
    if out_length == null { return false; }
    unsafe { *out_length = 0; }
    if source == null && len == 0 && output == null && capacity == 0 {
        return false;
    }
    return false;
}

@export
@system
pub fn sotlas_native_link_executable(
    object: *const u8,
    object_len: usize,
    entry_name: *const u8,
    entry_name_len: usize,
    freestanding: bool,
    output: *mut u8,
    capacity: usize,
    out_length: *mut usize
) -> bool {
    if out_length == null { return false; }
    unsafe { *out_length = 0; }
    if object == null && object_len == 0 && entry_name == null
        && entry_name_len == 0 && !freestanding && output == null
        && capacity == 0 {
        return false;
    }
    return false;
}

@export
@system
pub fn sotlas_native_last_error_line() -> u32 {
    return 0;
}

@export
@system
pub fn sotlas_native_last_error_col() -> u32 {
    return 0;
}

@export
@system
pub fn sotlas_native_link_objects(
    object_data: *const u8,
    object_offsets: *const usize,
    object_lengths: *const usize,
    object_count: u32,
    entry_name: *const u8,
    entry_name_len: usize,
    freestanding: bool,
    output: *mut u8,
    capacity: usize,
    out_length: *mut usize
) -> bool {
    if out_length == null { return false; }
    unsafe { *out_length = 0; }
    if object_data == null && object_offsets == null && object_lengths == null
        && object_count == 0 && entry_name == null && entry_name_len == 0
        && !freestanding && output == null && capacity == 0 {
        return false;
    }
    return false;
}


module sotlas::compiler::linux_driver;
import sotlas::compiler::token::*;
import sotlas::compiler::ast::*;
import sotlas::compiler::lexer::*;
import sotlas::compiler::parser::*;
import sotlas::compiler::sema::*;
import sotlas::compiler::backend::target_ir::*;
import sotlas::compiler::backend::lower_scalar::*;
import sotlas::compiler::backend::x86_64_scalar::*;

@extern(C)
fn sotlas_linux_open(path: *const u8, flags: u64, mode: u64) -> i64;
@extern(C)
fn sotlas_linux_read(fd: u64, data: *mut u8, count: u64) -> i64;
@extern(C)
fn sotlas_linux_write(fd: u64, data: *const u8, count: u64) -> i64;
@extern(C)
fn sotlas_linux_close(fd: u64) -> i64;

static mut driver_source_bytes: [u8; 4194304] = 0;
static mut driver_tokens: [Token; 262144] = 0;
static mut driver_nodes: [AstNode; 262144] = 0;
static mut driver_values: [TargetValue; 131072] = 0;
static mut driver_parameters: [TargetParameter; 16384] = 0;
static mut driver_instructions: [TargetInstruction; 262144] = 0;
static mut driver_operands: [TargetOperand; 524288] = 0;
static mut driver_phi_inputs: [TargetPhiInput; 16384] = 0;
static mut driver_blocks: [TargetBlock; 65536] = 0;
static mut driver_targets: [u32; 65536] = 0;
static mut driver_functions: [TargetFunction; 8192] = 0;
static mut driver_object_bytes: [u8; 8388608] = 0;
static mut driver_image_bytes: [u8; 16777216] = 0;
// One compilation per process; --build-mac selects the owned Mach-O writer.
static mut driver_macho_target: [u8; 1] = 0;

// Opt-in resolved projects retain their raw source while producing an ordered,
// import-free stream in driver_source_bytes for the certified compiler core.
// 64 modules maximum, two megabytes of combined input, no host allocators.
static mut driver_project_raw: [u8; 2097152] = 0;
static mut driver_project_starts: [usize; 64] = 0;
static mut driver_project_lengths: [usize; 64] = 0;
static mut driver_module_starts: [usize; 64] = 0;
static mut driver_module_lengths: [usize; 64] = 0;
static mut driver_module_edges: [u8; 4096] = 0;
static mut driver_module_selected: [u8; 64] = 0;
static mut driver_module_order: [usize; 64] = 0;
// Process-local resolver scratch. The native CFG currently cannot lower
// multiple address-taken scalar locals in a helper call. The driver runs
// one compilation per process; this storage is deliberately not reentrant.
static mut driver_path_start: [usize; 1] = 0;
static mut driver_path_length: [usize; 1] = 0;
static mut driver_path_end: [usize; 1] = 0;
static mut driver_resolved_length: [usize; 1] = 0;
// Discovery queue: bounded NUL-terminated paths, with no host path resolver.
static mut driver_discovery_paths: [u8; 262144] = 0;
static mut driver_discovery_count: [usize; 1] = 0;
// SV8.70 opt-in typed ELF pair: bounded sidecar source names and SOTI v1 records.
static mut driver_typed_names: [u8; 4096] = 0;
static mut driver_typed_records: [u8; 480] = 0;


fn fail(code: u32) -> u32 {
    let message: *const u8 = "sotlas-native: compilation failed\n";
    let written: i64 = sotlas_linux_write(2, message, 34);
    return code;
}

// Report the actual owned profile without initializing compiler arenas.
fn driver_print_profile(help: bool) -> u32 {
    let mut text: *const u8 = "sotlas-native capabilities v1\nbackend=x86_64\ninteger_bits=8,16,32,64\nfloats=f32,f64\nfloat_literals=coefficient<10^18;decimal-places<=18\nfloat_abi=internal-bits\nnumeric_casts=integer-float-checked\nfloat_external_abi=unsupported\nownership_analysis=exclusive-pod,whisper-internal,direct-internal\nownership_runtime=unsupported\nflow_execution=unsupported\n";
    if help { text = "Usage: sotlas-native INPUT OUTPUT [--object|--compiler]\n       sotlas-native --check INPUT\n       sotlas-native --project[-object|-compiler] OUTPUT INPUT...\n       sotlas-native --check-build ROOT ENTRY\n       sotlas-native --build[-obj|-cc] OUTPUT ROOT ENTRY\n       sotlas-native --capabilities\nInspect --version, --limits, --target, --exit-codes or --capabilities.\nBootstrap: --compare LEFT RIGHT, --fingerprint FILE, --verify-seed FILE, --self-test.\n"; }
    return driver_print_text(text);
}

fn driver_print_text(text: *const u8) -> u32 {
    let mut length: usize = 0;
    while length < 2048 && unsafe { *(text + length) } != 0 { length = length + 1; }
    if length == 2048 { return fail(13); }
    let mut position: usize = 0;
    while position < length {
        let written: i64 = sotlas_linux_write(1, unsafe { text + position }, (length - position) as u64);
        if written == -4 { continue; }
        if written <= 0 || written as u64 > (length - position) as u64 { return fail(13); }
        position = position + written as usize;
    }
    return 0;
}


fn driver_query_mode(option: *const u8) -> u32 {
    if option_equals(option,"--version",9) { return 1; }
    if option_equals(option,"--limits",8) { return 2; }
    if option_equals(option,"--target",8) { return 3; }
    if option_equals(option,"--exit-codes",12) { return 4; }
    return 0;
}
fn driver_query_print(mode: u32) -> u32 {
    let mut text: *const u8 = "native-driver-contract=1\ntarget-ir=1\n";
    if mode == 2 { text = "single_source_bytes<2097152\nproject_modules<=64\nproject_source_bytes<2097152\nfunctions<=1024\nstring_symbols<=2048\nstring_bytes<=65536\nparameters_per_function<=24\nblocks_per_function<=2048\nlocal_bindings<=128\nlocal_scalar_array_elements<=4096\nrecord_array_storage_bytes<=65536\ndefer_slots<=128\nlink_elf_objects<=16\nlink_elf_input_bytes<=8388608\n"; }
    if mode == 3 { text = "architecture=x86_64\npointer_bits=64\nendianness=little\nobject=ELF64-relocatable\nimage=ELF64\ninternal_float_abi=integer-bits\nforeign_float_abi=unsupported\n"; }
    if mode == 4 { text = "0=success\n1=usage\n2=open\n3=read-or-close\n4=lexical\n5=syntax\n6=semantic\n7=lowering\n8=object\n9=link\n10=output-open\n11=output-write\n12=project-resolution\n13=report-write\n14=artifacts-differ\n15=seed-envelope\n16=seed-stamp\n"; }
    return driver_print_text(text);
}

static mut driver_audit_left: [u8;4096] = 0;
static mut driver_audit_right: [u8;4096] = 0;

// Fill short reads before comparing chunks. Interrupted reads are retried.
fn driver_audit_read(fd: u64, buffer: *mut u8) -> i64 {
    let mut count: u64 = 0;
    while count < 4096 {
        let got: i64 = sotlas_linux_read(fd,unsafe{buffer+count},4096-count);
        if got == -4 { continue; }
        if got < 0 || got as u64 > 4096-count { return -1; }
        if got == 0 { break; }
        count = count + got as u64;
    }
    return count as i64;
}

// This proves byte identity, not a feature-complete bootstrap fixed point.
fn driver_compare_files_quiet(left: *const u8, right: *const u8) -> u32 {
    if left == null || right == null { return fail(1); }
    let a: i64 = sotlas_linux_open(left,0,0);
    if a < 0 { return fail(2); }
    let b: i64 = sotlas_linux_open(right,0,0);
    if b < 0 { let closed: i64 = sotlas_linux_close(a as u64); return fail(2); }
    let first: *mut u8 = unsafe{driver_audit_left as *mut u8};
    let second: *mut u8 = unsafe{driver_audit_right as *mut u8};
    let mut status: u32 = 0;
    while true {
        let count_a: i64 = driver_audit_read(a as u64,first);
        let count_b: i64 = driver_audit_read(b as u64,second);
        if count_a < 0 || count_b < 0 { status = 3; break; }
        if count_a != count_b { status = 14; break; }
        let mut index: u64 = 0;
        while index < count_a as u64 {
            if unsafe{*(first+index)} != unsafe{*(second+index)} { status = 14; break; }
            index = index+1;
        }
        if status != 0 || count_a == 0 { break; }
    }
    let close_a: i64 = sotlas_linux_close(a as u64);
    let close_b: i64 = sotlas_linux_close(b as u64);
    if close_a < 0 || close_b < 0 { return fail(3); }
    if status != 0 { return fail(status); }
    return 0;
}

fn driver_compare_files(left: *const u8, right: *const u8) -> u32 {
    let result: u32=driver_compare_files_quiet(left,right);
    if result != 0 { return result; }return driver_print_text("byte-identical\n");
}

// FNV-1a is a reproducibility fingerprint, not a cryptographic signature.
static mut driver_hash:[u64;1]=0;
static mut driver_size:[u64;1]=0;
fn driver_hash_file(path: *const u8) -> u32 {
    if path == null { return fail(1); }
    let opened: i64 = sotlas_linux_open(path,0,0);
    if opened < 0 { return fail(2); }
    let buffer: *mut u8 = unsafe{driver_audit_left as *mut u8};
    let mut total: u64=0;
    let mut hash: u64 = 14695981039346656037;
    let mut status: u32 = 0;
    while true {
        let count: i64 = driver_audit_read(opened as u64,buffer);
        if count < 0 { status=3; break; }
        if count == 0 { break; }
        if count as u64 > 18446744073709551615-total { status=3;break; }
        total=total+count as u64;
        let mut index: u64 = 0;
        while index < count as u64 {
            hash = (hash ^ unsafe{*(buffer+index)} as u64)*1099511628211;
            index=index+1;
        }
    }
    let closed: i64 = sotlas_linux_close(opened as u64);
    if closed < 0 || status != 0 { return fail(3); }
    unsafe{driver_hash[0]=hash;driver_size[0]=total;}return 0;
}
fn driver_fingerprint_file(path: *const u8) -> u32 {
    let result: u32=driver_hash_file(path);if result != 0 { return result; }
    let hash: u64=unsafe{driver_hash[0]};let buffer: *mut u8=unsafe{driver_audit_left as *mut u8};
    let digits: *const u8 = "0123456789abcdef";
    let mut index: u64 = 0;
    while index < 16 {
        let nibble: u64 = (hash >> ((15-index)*4)) & 15;
        unsafe{*(buffer+index)=*(digits+nibble);}
        index=index+1;
    }
    unsafe{*(buffer+16)=10;*(buffer+17)=0;}
    return driver_print_text(buffer);
}

// Check the platform/architecture envelope before accepting a seed artifact.
// This does not authenticate its origin or prove that it is a compiler.
fn driver_seed_envelope(path: *const u8) -> u32 {
    if path == null { return fail(1); }
    let opened: i64 = sotlas_linux_open(path,0,0);
    if opened < 0 { return fail(2); }
    let buffer: *mut u8 = unsafe{driver_audit_left as *mut u8};
    let count: i64 = driver_audit_read(opened as u64,buffer);
    let closed: i64 = sotlas_linux_close(opened as u64);
    if count < 0 || closed < 0 { return fail(3); }
    if count < 64 || unsafe{*buffer} != 127 || unsafe{*(buffer+1)} != 69
            || unsafe{*(buffer+2)} != 76 || unsafe{*(buffer+3)} != 70
            || unsafe{*(buffer+4)} != 2 || unsafe{*(buffer+5)} != 1
            || unsafe{*(buffer+6)} != 1 || unsafe{*(buffer+16)} != 2
            || unsafe{*(buffer+17)} != 0 || unsafe{*(buffer+18)} != 62
            || unsafe{*(buffer+19)} != 0 { return fail(15); }
    return 0;
}
fn driver_verify_seed(path: *const u8) -> u32 {
    let result: u32=driver_seed_envelope(path);if result != 0 { return result; }
    return driver_print_text("seed-envelope=x86_64-ELF64\n");
}

fn driver_self_test() -> u32 {
    let sample: *const u8 = "module native_self_test;pub fn main_entry()->u32{let value:u64=21;return (value+21) as u32;}";
    let destination: *mut u8 = unsafe{driver_source_bytes as *mut u8};
    let mut length: u64 = 0;
    while length < 1024 && unsafe{*(sample+length)} != 0 {
        unsafe{*(destination+length)=*(sample+length);}
        length=length+1;
    }
    if length == 1024 { return fail(7); }
    driver_set_error_path("<self-test>");
    let result: u32 = driver_compile_loaded(length as usize,null,true,false,true,false);
    if result != 0 { return result; }
    return driver_print_text("self-test=frontend,typed-ir,owned-object\n");
}

fn driver_audit_dispatch(argc: u64, argv: *const *const u8, option: *const u8) -> u32 {
    if option_equals(option,"--compare",9) {
        if argc != 4 { return fail(1); }
        return driver_compare_files(unsafe{*(argv+2)},unsafe{*(argv+3)});
    }
    if option_equals(option,"--fingerprint",13) {
        if argc != 3 { return fail(1); }
        return driver_fingerprint_file(unsafe{*(argv+2)});
    }
    if option_equals(option,"--verify-seed",13) {
        if argc != 3 { return fail(1); }
        return driver_verify_seed(unsafe{*(argv+2)});
    }
    return 4294967295;
}

// Diagnostics describe one file, or the combined stream of a native project.
static mut driver_error_path:[u8;4096]=0;
static mut driver_error_path_length:[usize;1]=0;
static mut driver_error_source_length:[usize;1]=0;

// Flat source segments preserve original file positions after import removal
// and topological ordering. Bounds are checked before compiler output I/O.
static mut driver_map_paths:[u8;262144]=0;
static mut driver_map_starts:[usize;8192]=0;
static mut driver_map_lengths:[usize;8192]=0;
static mut driver_map_raw_starts:[usize;8192]=0;
static mut driver_map_files:[usize;8192]=0;
static mut driver_map_count:[usize;1]=0;
static mut driver_map_current_file:[usize;1]=0;
static mut driver_map_file_count:[usize;1]=0;
static mut driver_map_active:[u8;1]=0;
static mut driver_map_error_file:[usize;1]=0;
static mut driver_map_error_line:[u32;1]=0;
static mut driver_map_error_column:[u32;1]=0;

fn driver_map_path(file:usize,path:*const u8)->bool {
    if file>=64 || path==null{return false;}
    let bytes:*mut u8=unsafe{driver_map_paths as *mut u8};
    let mut index:usize=0;
    while index<4095 && unsafe{*(path+index)}!=0 {
        unsafe{*(bytes+file*4096+index)=*(path+index);}index=index+1;
    }
    if unsafe{*(path+index)}!=0{return false;}
    unsafe{*(bytes+file*4096+index)=0;}
    return true;
}

fn driver_map_add(position:usize,length:usize,raw:usize,file:usize)->bool {
    if length==0{return true;}
    let count:usize=unsafe{driver_map_count[0]};
    if count>=8192 || file>=64 || position>=2097152 || length>2097152-position
        || raw>=2097152 || length>2097152-raw{return false;}
    unsafe{driver_map_starts[count]=position;driver_map_lengths[count]=length;
        driver_map_raw_starts[count]=raw;driver_map_files[count]=file;driver_map_count[0]=count+1;}
    return true;
}

fn driver_map_position(line:u32,column:u32)->bool {
    if line==0 || column==0 || unsafe{driver_map_active[0]}==0{return false;}
    let source:*const u8=unsafe{driver_source_bytes as *const u8};
    let limit:usize=unsafe{driver_error_source_length[0]};
    let mut position:usize=0;let mut current_line:u32=1;
    while position<limit && current_line<line {
        if unsafe{*(source+position)}==10{current_line=current_line+1;}position=position+1;
    }
    if current_line!=line || column as usize-1>limit-position{return false;}
    position=position+column as usize-1;
    let count:usize=unsafe{driver_map_count[0]};let mut segment:usize=0;
    let mut found:usize=8192;
    while segment<count {
        let start:usize=unsafe{driver_map_starts[segment]};let length:usize=unsafe{driver_map_lengths[segment]};
        if position>=start && position<start+length{found=segment;break;}
        if position==start+length{found=segment;}
        segment=segment+1;
    }
    if found==8192{return false;}
    let file:usize=unsafe{driver_map_files[found]};
    if file>=unsafe{driver_map_file_count[0]}{return false;}
    let start:usize=unsafe{driver_project_starts[file]};let length:usize=unsafe{driver_project_lengths[file]};
    let mut original:usize=unsafe{driver_map_raw_starts[found]}+position-unsafe{driver_map_starts[found]};
    if original<start{return false;}if original>start+length{original=start+length;}
    let raw:*const u8=unsafe{driver_project_raw as *const u8};
    let mut offset:usize=start;let mut mapped_line:u32=1;let mut mapped_column:u32=1;
    while offset<original {
        if unsafe{*(raw+offset)}==10{mapped_line=mapped_line+1;mapped_column=1;}
        else{mapped_column=mapped_column+1;}offset=offset+1;
    }
    unsafe{driver_map_error_file[0]=file;driver_map_error_line[0]=mapped_line;driver_map_error_column[0]=mapped_column;}
    return true;
}

fn driver_set_error_path(path:*const u8) {
    if path==null {unsafe{*(driver_error_path_length as *mut usize)=0;}return;}
    let mut index:usize=0;
    let path_buffer:*mut u8=unsafe{driver_error_path as *mut u8};
    while index<4095 && unsafe{*(path+index)}!=0 {
        unsafe{*(path_buffer+index)=*(path+index);}index=index+1;
    }
    unsafe{*(driver_error_path_length as *mut usize)=index;*(path_buffer+index)=0;}
}

fn driver_error_text(text:*const u8,count:usize) {
    let mut position:usize=0;
    while position<count {
        let written:i64=sotlas_linux_write(2,unsafe{text+position},(count-position) as u64);
        if written == -4 {continue;}
        if written<=0 || written as u64>(count-position) as u64 {return;}
        position=position+written as usize;
    }
}

fn driver_error_number(value:u32) {
    let mut digits:[u8;10]=0;
    let bytes:*mut u8=unsafe{digits as *mut u8};
    let mut remaining:u32=value;let mut length:usize=0;
    while length<10 {unsafe{*(bytes+length)=((remaining%10) as u8)+48;}
        length=length+1;remaining=remaining/10;if remaining==0{break;}}
    while length>0 {length=length-1;driver_error_text(unsafe{bytes+length},1);}
}

fn driver_position_error(code:u32,line:u32,column:u32,phase:*const u8,phase_length:usize,expected:TokenKind)->u32 {
    let mapped:bool=driver_map_position(line,column);
    let mut display_line:u32=line;let mut display_column:u32=column;
    let mut source:*const u8=unsafe{driver_source_bytes as *const u8};
    let mut limit:usize=unsafe{driver_error_source_length[0]};
    if mapped {
        let file:usize=unsafe{driver_map_error_file[0]};
        display_line=unsafe{driver_map_error_line[0]};display_column=unsafe{driver_map_error_column[0]};
        source=unsafe{driver_project_raw as *const u8+driver_project_starts[file]};
        limit=unsafe{driver_project_lengths[file]};
        driver_set_error_path(unsafe{driver_map_paths as *const u8+file*4096});
    }
    driver_error_text("sotlas: error: ",15);
    let path_length:usize=unsafe{*(driver_error_path_length as *const usize)};
    if path_length!=0 {driver_error_text(unsafe{driver_error_path as *const u8},path_length);}
    else {driver_error_text("<native-project>",16);}
    driver_error_text(":",1);driver_error_number(display_line);driver_error_text(":",1);driver_error_number(display_column);
    driver_error_text(": ",2);driver_error_text(phase,phase_length);
    if expected==TokenKind::Ident {driver_error_text("; expected identifier",21);}
    driver_error_text("\n",1);
    if line==0 || column==0 {return code;}
    let mut offset:usize=0;let mut current:u32=1;
    while offset<limit && current<display_line {
        let ch:u8=unsafe{*(source+offset)};if ch==0{return code;}
        if ch==10{current=current+1;}offset=offset+1;
    }
    let start:usize=offset;let mut count:usize=0;
    while offset<limit && count<160 {
        let ch:u8=unsafe{*(source+offset)};if ch==0 || ch==10 || ch==13{break;}
        offset=offset+1;count=count+1;
    }
    driver_error_text("  ",2);driver_error_text(unsafe{source+start},count);driver_error_text("\n  ",3);
    let mut indent:u32=1;while indent<display_column && indent<=160 {driver_error_text(" ",1);indent=indent+1;}
    driver_error_text("^\n",2);return code;
}

fn option_equals(option: *const u8, expected: *const u8, length: usize) -> bool {
    let mut index: usize = 0;
    while index <= length {
        if unsafe { *(option + index) } != unsafe { *(expected + index) } { return false; }
        index = index + 1;
    }
    return true;
}

// Exact, allocation-free option decoder; no new native string relocations.
// Return 1/2/3 for resolved executable/object/compiler; 0 means unsupported.
fn driver_resolve_mode(option: *const u8) -> u32 {
    if option == null { return 0; }
    let mut index: usize = 0;
    while index < 17 {
        let mut expected: u8 = 0;
        if index == 0 || index == 1 || index == 9 { expected = 45; }
        else if index == 7 { expected = 99; }
        else if index == 6 || index == 11 || index == 16 { expected = 101; }
        else if index == 5 { expected = 106; }
        else if index == 14 { expected = 108; }
        else if index == 4 || index == 13 { expected = 111; }
        else if index == 2 { expected = 112; }
        else if index == 3 || index == 10 { expected = 114; }
        else if index == 12 { expected = 115; }
        else if index == 8 { expected = 116; }
        else if index == 15 { expected = 118; }
        let actual: u8 = unsafe { *(option + index) };
        if actual != expected { return 0; }
        index = index + 1;
    }
    let suffix: *const u8 = unsafe { option + 17 };
    if unsafe { *suffix } == 0 { return 1; }
    if unsafe { *suffix } != 45 { return 0; }
    if unsafe { *(suffix + 1) } == 111 {
        if unsafe { *(suffix + 2) } != 98 { return 0; }
        if unsafe { *(suffix + 3) } != 106 { return 0; }
        if unsafe { *(suffix + 4) } != 101 { return 0; }
        if unsafe { *(suffix + 5) } != 99 { return 0; }
        if unsafe { *(suffix + 6) } != 116 { return 0; }
        if unsafe { *(suffix + 7) } == 0 { return 2; }
        return 0;
    }
    if unsafe { *(suffix + 1) } == 99 {
        if unsafe { *(suffix + 2) } != 111 { return 0; }
        if unsafe { *(suffix + 3) } != 109 { return 0; }
        if unsafe { *(suffix + 4) } != 112 { return 0; }
        if unsafe { *(suffix + 5) } != 105 { return 0; }
        if unsafe { *(suffix + 6) } != 108 { return 0; }
        if unsafe { *(suffix + 7) } != 101 { return 0; }
        if unsafe { *(suffix + 8) } != 114 { return 0; }
        if unsafe { *(suffix + 9) } == 0 { return 3; }
        return 0;
    }
    return 0;
}

// Keep new-option dispatch isolated from the certified legacy control flow.
fn driver_dispatch_resolved(
    argc: u64, argv: *const *const u8, option: *const u8
) -> u32 {
    let mode: u32 = driver_resolve_mode(option);
    if mode == 1 {
        return driver_compile_project(argc, argv, false, false, true, false);
    }
    if mode == 2 {
        return driver_compile_project(argc, argv, true, false, true, false);
    }
    if mode == 3 {
        return driver_compile_project(argc, argv, false, true, true, false);
    }
    return fail(1);
}

// Keep filesystem/control-flow state outside the compiler pipeline.
// The ELF linker must not share the nested project file-reading CFG.
fn driver_compile_loaded(
    source_length: usize,
    output_name: *const u8,
    object_only: bool,
    compiler_entry: bool,
    check_only: bool,
    windows: bool
) -> u32 {
    let source: *mut u8 = unsafe { driver_source_bytes as *mut u8 };
    unsafe { g_extended_len = source_length; *(driver_error_source_length as *mut usize) = source_length; }
    let token_buffer: *mut Token = unsafe { driver_tokens as *mut Token };
    let node_buffer: *mut AstNode = unsafe { driver_nodes as *mut AstNode };
    let mut lexer: Lexer = Lexer::new(source, source_length);
    let mut token_count: usize = 0;
    while token_count < 262144 {
        let token: Token = lexer.next_token();
        if token.kind == TokenKind::KwImport { return fail(12); }

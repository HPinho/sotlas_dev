        }
        return driver_artifact_set_stamp(first,second,project_verify,false);
    }
    if option_equals(option,"--check-project-list",20) || option_equals(option,"--check-project-list-resolve",28) {
        if argc != 3 { return fail(1); }let mut mode: u32=1;
        if option_equals(option,"--check-project-list-resolve",28) { mode=2; }
        return driver_project_manifest(unsafe{*(argv+2)},null,mode);
    }
    if option_equals(option,"--project-list-object",21) || option_equals(option,"--build-project-list",20) {
        if argc != 4 { return fail(1); }let mut mode: u32=3;
        if option_equals(option,"--build-project-list",20) { mode=4; }
        return driver_project_manifest(unsafe{*(argv+3)},unsafe{*(argv+2)},mode);
    }
    if option_equals(option,"--artifact-set-info",19) {
        if argc != 3 { return fail(1); }return driver_artifact_set_info(unsafe{*(argv+2)});

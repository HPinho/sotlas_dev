        || option_equals(option,"--project-list-resolve-compiler",31) || option_equals(option,"--project-list-macho",20) {
        if argc != 4 { return fail(1); }let mut mode: u32=5;
        if option_equals(option,"--project-list-compiler",23) { mode=6; }
        if option_equals(option,"--project-list-resolve-compiler",31) { mode=7; }
        if option_equals(option,"--project-list-macho",20) { mode=8; }
        return driver_project_manifest(unsafe{*(argv+3)},unsafe{*(argv+2)},mode);
    }

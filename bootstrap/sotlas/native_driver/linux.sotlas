fn driver_extended_dispatch(argc: u64, argv: *const *const u8, option: *const u8) -> u32 {
    if option_equals(option,"--object-info-json",18) || option_equals(option,"--seed-info-json",16)
        || option_equals(option,"--artifact-set-info-json",24) || option_equals(option,"--project-set-info-json",23) {

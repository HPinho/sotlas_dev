module sotlas::compiler::linux_driver;
import sotlas::compiler::token::*;
import sotlas::compiler::ast::*;
import sotlas::compiler::lexer::*;
import sotlas::compiler::parser::*;
import sotlas::compiler::sema::*;
import sotlas::compiler::backend::target_ir::*;
import sotlas::compiler::backend::lower_scalar::*;
import sotlas::compiler::backend::x86_64_scalar::*;

@extern(C)
fn sotlas_linux_open(path: *const u8, flags: u64, mode: u64) -> i64;
@extern(C)
fn sotlas_linux_read(fd: u64, data: *mut u8, count: u64) -> i64;
@extern(C)
fn sotlas_linux_write(fd: u64, data: *const u8, count: u64) -> i64;
@extern(C)
fn sotlas_linux_close(fd: u64) -> i64;

static mut driver_source_bytes: [u8; 2097152] = 0;
static mut driver_tokens: [Token; 262144] = 0;
static mut driver_nodes: [AstNode; 262144] = 0;
static mut driver_values: [TargetValue; 65536] = 0;
static mut driver_parameters: [TargetParameter; 16384] = 0;
static mut driver_instructions: [TargetInstruction; 131072] = 0;
static mut driver_operands: [TargetOperand; 262144] = 0;
static mut driver_phi_inputs: [TargetPhiInput; 16384] = 0;
static mut driver_blocks: [TargetBlock; 32768] = 0;
static mut driver_targets: [u32; 65536] = 0;
static mut driver_functions: [TargetFunction; 2048] = 0;
static mut driver_object_bytes: [u8; 8388608] = 0;
static mut driver_image_bytes: [u8; 16777216] = 0;

// Opt-in resolved projects retain their raw source while producing an ordered,
// import-free stream in driver_source_bytes for the certified compiler core.
// 64 modules maximum, one megabyte of combined input, no host allocators.
static mut driver_project_raw: [u8; 1048576] = 0;
static mut driver_project_starts: [usize; 64] = 0;
static mut driver_project_lengths: [usize; 64] = 0;
static mut driver_module_starts: [usize; 64] = 0;
static mut driver_module_lengths: [usize; 64] = 0;
static mut driver_module_edges: [u8; 4096] = 0;
static mut driver_module_selected: [u8; 64] = 0;
static mut driver_module_order: [usize; 64] = 0;
// Process-local resolver scratch. The native CFG currently cannot lower
// multiple address-taken scalar locals in a helper call. The driver runs
// one compilation per process; this storage is deliberately not reentrant.
static mut driver_path_start: [usize; 1] = 0;
static mut driver_path_length: [usize; 1] = 0;
static mut driver_path_end: [usize; 1] = 0;
static mut driver_resolved_length: [usize; 1] = 0;

fn fail(code: u32) -> u32 {
    let message: *const u8 = "sotlas-native: compilation failed\n";
    let written: i64 = sotlas_linux_write(2, message, 34);
    return code;
}

fn option_equals(option: *const u8, expected: *const u8, length: usize) -> bool {
    let mut index: usize = 0;
    while index <= length {
        if unsafe { *(option + index) } != unsafe { *(expected + index) } { return false; }
        index = index + 1;
    }
    return true;
}

// Compare long CLI names in short, exact fragments. The native compiler's
// string-literal lowering/ELF rodata path is kept out of the >16-byte
// option-dispatch profile. Unlike prefix-only matching, this also checks
// the terminating NUL so --project-resolve-unknown is always rejected.
fn option_prefix_equals(option: *const u8, prefix: *const u8, length: usize) -> bool {
    if option == null || prefix == null { return false; }
    let mut index: usize = 0;
    while index < length {
        let actual: u8 = unsafe { *(option + index) };
        if actual == 0 || actual != unsafe { *(prefix + index) } {
            return false;
        }
        index = index + 1;
    }
    return true;
}

// Return 1 for --project-resolve, 2 for -object and 3 for -compiler.
// No single string literal in this decoder is longer than 9 bytes.
fn driver_resolve_mode(option: *const u8) -> u32 {
    if !option_prefix_equals(option, "--project", 9) { return 0; }
    let middle: *const u8 = unsafe { option + 9 };
    if !option_prefix_equals(middle, "-resolve", 8) { return 0; }
    let suffix: *const u8 = unsafe { middle + 8 };
    if unsafe { *suffix } == 0 { return 1; }
    if option_equals(suffix, "-object", 7) { return 2; }
    if option_equals(suffix, "-compiler", 9) { return 3; }
    return 0;
}

// Keep filesystem/control-flow state outside the compiler pipeline.
// The ELF linker must not share the nested project file-reading CFG.
fn driver_compile_loaded(
    source_length: usize,
    output_name: *const u8,
    object_only: bool,
    compiler_entry: bool
) -> u32 {
    let source: *mut u8 = unsafe { driver_source_bytes as *mut u8 };
    unsafe { g_extended_len = source_length; }
    let token_buffer: *mut Token = unsafe { driver_tokens as *mut Token };
    let node_buffer: *mut AstNode = unsafe { driver_nodes as *mut AstNode };
    let mut lexer: Lexer = Lexer::new(source, source_length);
    let mut token_count: usize = 0;
    while token_count < 262144 {
        let token: Token = lexer.next_token();
        if token.kind == TokenKind::KwImport { return fail(12); }
        unsafe { *(token_buffer + token_count) = token; }
        token_count = token_count + 1;
        if token.kind == TokenKind::Eof { break; }
        if token.kind == TokenKind::Error { return fail(4); }
    }
    if lexer.error_count != 0 || token_count == 262144 { return fail(4); }
    let mut parser: Parser = Parser::new(token_buffer, token_count, node_buffer, 262144);
    let module_index: usize = parser.parse_module();
    if module_index == 0 || parser.error_count != 0 { return fail(5); }
    let mut sema: Sema = Sema::new();
    if !sema.check_top_level_declarations(node_buffer, parser.node_count,
        module_index, source, source_length) { return fail(6); }
    let mut lowering: ScalarLowering = ScalarLowering::new(node_buffer, parser.node_count,
        source, source_length, unsafe { driver_values as *mut TargetValue }, 65536,
        unsafe { driver_parameters as *mut TargetParameter }, 16384,
        unsafe { driver_instructions as *mut TargetInstruction }, 131072,
        unsafe { driver_operands as *mut TargetOperand }, 262144,
        unsafe { driver_phi_inputs as *mut TargetPhiInput }, 16384,
        unsafe { driver_blocks as *mut TargetBlock }, 32768,
        unsafe { driver_targets as *mut u32 }, 65536,
        unsafe { driver_functions as *mut TargetFunction }, 2048);
    let mut ir: TargetModule = TargetModule { version: 1, function_count: 0,
        parameter_count: 0, block_count: 0, instruction_count: 0, value_count: 0,
        operand_count: 0, phi_input_count: 0, target_count: 0 };
    if !lower_scalar_module(&mut lowering, module_index, &mut ir) { return fail(7); }
    let object_buffer: *mut u8 = unsafe { driver_object_bytes as *mut u8 };
    let mut object_length: usize = 0;
    let ir_pointer: *const TargetModule = unsafe { (&ir) as *const TargetModule };
    let length_pointer: *mut usize = unsafe { (&object_length) as *mut usize };
    if !emit_elf64_module_object(source, unsafe { g_extended_len }, ir_pointer,
        unsafe { driver_functions as *const TargetFunction }, unsafe { driver_parameters as *const TargetParameter },
        unsafe { driver_values as *const TargetValue }, unsafe { driver_blocks as *const TargetBlock },
        unsafe { driver_instructions as *const TargetInstruction }, unsafe { driver_operands as *const TargetOperand },
        unsafe { driver_phi_inputs as *const TargetPhiInput }, unsafe { driver_targets as *const u32 },
        object_buffer, 8388608, length_pointer) { return fail(8); }
    let mut artifact: *const u8 = object_buffer as *const u8;
    let mut artifact_length: usize = object_length;
    if !object_only {
        let image_buffer: *mut u8 = unsafe { driver_image_bytes as *mut u8 };
        let mut offset: usize = 0;
        let mut image_length: usize = 0;
        let offset_pointer: *const usize = unsafe { (&offset) as *const usize };
        let object_length_pointer: *const usize = length_pointer as *const usize;
        let image_length_pointer: *mut usize = unsafe { (&image_length) as *mut usize };
        let mut entry_name: *const u8 = "main_entry";
        let mut entry_length: usize = 10;
        if compiler_entry { entry_name = "sotlas_linux_main"; entry_length = 17; }
        if !link_elf64_executable(object_buffer, offset_pointer, object_length_pointer, 1,
            entry_name, entry_length, null, 0, 4194304, false,
            image_buffer, 16777216, image_length_pointer) { return fail(9); }
        artifact = image_buffer as *const u8;
        artifact_length = image_length;
    }
    // Create/truncate only after the complete artifact has been validated.
    let output_opened: i64 = sotlas_linux_open(output_name, 577, 493);
    if output_opened < 0 { return fail(10); }
    let output_fd: u64 = output_opened as u64;
    let mut position: usize = 0;
    while position < artifact_length {
        let remaining: u64 = artifact_length - position;
        let written: i64 = sotlas_linux_write(output_fd, unsafe { artifact + position }, remaining);
        if written == -4 { continue; }
        if written <= 0 { let closed_output: i64 = sotlas_linux_close(output_fd); return fail(11); }
        position = position + (written as usize);
    }
    let closed_output: i64 = sotlas_linux_close(output_fd);
    if closed_output < 0 { return fail(11); }
    return 0;
}



// SV8.21b1: parse a canonical, contiguous module path from lexer tokens.
// Imports currently support only explicit glob declarations `import path::*;`.
// The path excludes the import glob, and end_offset includes its semicolon.
fn driver_read_module_path(mut lexer: &mut Lexer, import_path: bool) -> bool {
    let first: Token = lexer.next_token();
    if first.kind != TokenKind::Ident { return false; }
    let start: usize = first.span.offset;
    let mut finish: usize = start + first.span.length;
    let mut next: Token = lexer.next_token();
    while next.kind == TokenKind::DColon {
        if next.span.offset != finish { return false; }
        let part: Token = lexer.next_token();
        if part.kind == TokenKind::Star && import_path {
            if part.span.offset != finish + 2 { return false; }
            let semi: Token = lexer.next_token();
            if semi.kind != TokenKind::SemiColon { return false; }
            unsafe {
                *(driver_path_start as *mut usize) = start;
                *(driver_path_length as *mut usize) = finish - start;
                *(driver_path_end as *mut usize) = semi.span.offset + semi.span.length;
            }
            return true;
        }
        if part.kind != TokenKind::Ident || part.span.offset != finish + 2 {
            return false;
        }
        finish = part.span.offset + part.span.length;
        next = lexer.next_token();
    }
    if import_path || next.kind != TokenKind::SemiColon { return false; }
    unsafe {
        *(driver_path_start as *mut usize) = start;
        *(driver_path_length as *mut usize) = finish - start;
        *(driver_path_end as *mut usize) = next.span.offset + next.span.length;
    }
    return true;
}

fn driver_module_name_equals(
    source: *const u8, a_start: usize, a_len: usize,
    b_start: usize, b_len: usize
) -> bool {
    if a_len == 0 || a_len != b_len { return false; }
    let mut pos: usize = 0;
    while pos < a_len {
        if unsafe { *(source + a_start + pos) != *(source + b_start + pos) } {
            return false;
        }
        pos = pos + 1;
    }
    return true;
}

// Scan each full file with the production lexer, never a substring/regex:
// commented-out imports and string literals are not interpreted as edges.
// A file must have exactly one top-level module declaration.
fn driver_resolve_scan_file(source: *const u8, file: usize, file_count: usize) -> bool {
    let start: usize = unsafe { *(driver_project_starts as *const usize + file) };
    let length: usize = unsafe { *(driver_project_lengths as *const usize + file) };
    let mut lexer: Lexer = Lexer::new(unsafe { source + start }, length);
    let mut module_count: usize = 0;
    let mut depth: usize = 0;
    let mut token: Token = lexer.next_token();
    while token.kind != TokenKind::Eof {
        if token.kind == TokenKind::Error { return false; }
        if token.kind == TokenKind::KwModule {
            if module_count != 0 || depth != 0 { return false; }
            if !driver_read_module_path(&mut lexer, false) { return false; }
            let off: usize = unsafe { *(driver_path_start as *const usize) };
            let size: usize = unsafe { *(driver_path_length as *const usize) };
            let own_name: usize = unsafe { *(driver_module_starts as *const usize + file) };
            let own_size: usize = unsafe { *(driver_module_lengths as *const usize + file) };
            if !driver_module_name_equals(source, start + off, size, own_name, own_size) {
                return false;
            }
            module_count = module_count + 1;
        } else if token.kind == TokenKind::KwImport {
            if module_count != 1 || depth != 0 { return false; }
            if !driver_read_module_path(&mut lexer, true) { return false; }
            let off: usize = unsafe { *(driver_path_start as *const usize) };
            let size: usize = unsafe { *(driver_path_length as *const usize) };
            let mut found: bool = false;
            let mut dependency: usize = 0;
            while dependency < file_count {
                let dep_start: usize = unsafe {
                    *(driver_module_starts as *const usize + dependency)
                };
                let dep_size: usize = unsafe {
                    *(driver_module_lengths as *const usize + dependency)
                };
                if driver_module_name_equals(source, start + off, size, dep_start, dep_size) {
                    if dependency == file { return false; }
                    let edge: *mut u8 = unsafe {
                        (driver_module_edges as *mut u8) + file * 64 + dependency
                    };
                    if unsafe { *edge } != 0 { return false; }
                    unsafe { *edge = 1; }
                    found = true;
                    break;
                }
                dependency = dependency + 1;
            }
            if !found { return false; }
        } else if token.kind == TokenKind::OpenBrace {
            depth = depth + 1;
        } else if token.kind == TokenKind::CloseBrace {
            if depth == 0 { return false; }
            depth = depth - 1;
        }
        token = lexer.next_token();
    }
    return module_count == 1 && depth == 0 && lexer.error_count == 0;
}

// A deterministic stable topological order: among ready modules pick the
// earliest input index. Missing, repeated and self-imports fail at scan;
// a dependency cycle leaves no ready vertex and fails without output I/O.
fn driver_resolve_order(file_count: usize) -> bool {
    let mut i: usize = 0;
    while i < file_count {
        unsafe { *(driver_module_selected as *mut u8 + i) = 0; }
        i = i + 1;
    }
    let mut written: usize = 0;
    while written < file_count {
        let mut found: bool = false;
        let mut candidate: usize = 0;
        while candidate < file_count {
            if unsafe { *(driver_module_selected as *const u8 + candidate) } == 0 {
                let mut ready: bool = true;
                let mut dependency: usize = 0;
                while dependency < file_count {
                    let edge: u8 = unsafe {
                        *(driver_module_edges as *const u8 + candidate * 64 + dependency)
                    };
                    if edge != 0 && unsafe {
                        *(driver_module_selected as *const u8 + dependency)
                    } == 0 {
                        ready = false;
                        break;
                    }
                    dependency = dependency + 1;
                }
                if ready {
                    unsafe {
                        *(driver_module_selected as *mut u8 + candidate) = 1;
                        *(driver_module_order as *mut usize + written) = candidate;
                    }
                    found = true;
                    break;
                }
            }
            candidate = candidate + 1;
        }
        if !found { return false; }
        written = written + 1;
    }
    return true;
}

fn driver_copy_project_slice(source: *const u8, first: usize, last: usize) -> bool {
    if first > last { return false; }
    let position: usize = unsafe { *(driver_resolved_length as *const usize) };
    if position >= 1048576 || last - first >= 1048576 - position {
        return false;
    }
    let destination: *mut u8 = unsafe { driver_source_bytes as *mut u8 };
    let mut cursor: usize = first;
    while cursor < last {
        unsafe { *(destination + position + cursor - first) = *(source + cursor); }
        cursor = cursor + 1;
    }
    unsafe { *(driver_resolved_length as *mut usize) = position + last - first; }
    return true;
}

// Reuse the same lexer to remove only validated import declarations (not
// comments, string contents, or similarly named identifiers). The full
// original declarations remain available in the raw input for validation.
fn driver_resolve_append_file(source: *const u8, file: usize) -> bool {
    let start: usize = unsafe { *(driver_project_starts as *const usize + file) };
    let length: usize = unsafe { *(driver_project_lengths as *const usize + file) };
    let mut lexer: Lexer = Lexer::new(unsafe { source + start }, length);
    let mut copied: usize = 0;
    let mut token: Token = lexer.next_token();
    while token.kind != TokenKind::Eof {
        if token.kind == TokenKind::Error { return false; }
        if token.kind == TokenKind::KwImport {
            if !driver_read_module_path(&mut lexer, true)
                || token.span.offset < copied { return false; }
            let finish: usize = unsafe { *(driver_path_end as *const usize) };
            if !driver_copy_project_slice(
                source, start + copied, start + token.span.offset
            ) { return false; }
            copied = finish;
        }
        token = lexer.next_token();
    }
    if !driver_copy_project_slice(source, start + copied, start + length) {
        return false;
    }
    let destination: *mut u8 = unsafe { driver_source_bytes as *mut u8 };
    let position: usize = unsafe { *(driver_resolved_length as *const usize) };
    if position >= 1048575 { return false; }
    unsafe {
        *(destination + position) = 10;
        *(driver_resolved_length as *mut usize) = position + 1;
    }
    return true;
}

// Returns zero on any unsafe or unresolved graph. The caller must not open
// the requested output until this returns a valid source stream and the
// complete native compiler pipeline succeeds.
fn driver_resolve_project(file_count: usize) -> usize {
    if file_count < 2 || file_count > 64 { return 0; }
    let source: *const u8 = unsafe { driver_project_raw as *const u8 };
    let mut file: usize = 0;
    while file < file_count {
        let start: usize = unsafe { *(driver_project_starts as *const usize + file) };
        let length: usize = unsafe { *(driver_project_lengths as *const usize + file) };
        let mut lexer: Lexer = Lexer::new(unsafe { source + start }, length);
        if lexer.next_token().kind != TokenKind::KwModule { return 0; }
        if !driver_read_module_path(&mut lexer, false) { return 0; }
        let off: usize = unsafe { *(driver_path_start as *const usize) };
        let size: usize = unsafe { *(driver_path_length as *const usize) };
        unsafe {
            *(driver_module_starts as *mut usize + file) = start + off;
            *(driver_module_lengths as *mut usize + file) = size;
        }
        let mut other: usize = 0;
        while other < file {
            let name_start: usize = unsafe {
                *(driver_module_starts as *const usize + other)
            };
            let name_len: usize = unsafe {
                *(driver_module_lengths as *const usize + other)
            };
            if driver_module_name_equals(source, start + off, size, name_start, name_len) {
                return 0;
            }
            other = other + 1;
        }
        file = file + 1;
    }
    file = 0;
    while file < file_count {
        if !driver_resolve_scan_file(source, file, file_count) { return 0; }
        file = file + 1;
    }
    if !driver_resolve_order(file_count) { return 0; }
    unsafe { *(driver_resolved_length as *mut usize) = 0; }
    let mut ordered: usize = 0;
    while ordered < file_count {
        let index: usize = unsafe { *(driver_module_order as *const usize + ordered) };
        if !driver_resolve_append_file(source, index) { return 0; }
        ordered = ordered + 1;
    }
    return unsafe { *(driver_resolved_length as *const usize) };
}

// Retain the certified single-file input byte stream, options and limits.
fn driver_compile_single(argc: u64, argv: *const *const u8) -> u32 {
    if argc != 3 && argc != 4 { return fail(1); }
    let input_name: *const u8 = unsafe { *(argv + 1) };
    let output_name: *const u8 = unsafe { *(argv + 2) };
    if input_name == null || output_name == null { return fail(1); }
    let mut object_only: bool = false;
    let mut compiler_entry: bool = false;
    if argc == 4 {
        let option: *const u8 = unsafe { *(argv + 3) };
        if option_equals(option, "--object", 8) {
            object_only = true;
        } else if option_equals(option, "--compiler", 10) {
            compiler_entry = true;
        } else {
            return fail(1);
        }
    }
    let opened: i64 = sotlas_linux_open(input_name, 0, 0);
    if opened < 0 { return fail(2); }
    let input_fd: u64 = opened as u64;
    let source: *mut u8 = unsafe { driver_source_bytes as *mut u8 };
    let mut source_length: usize = 0;
    while source_length < 1048576 {
        let available: u64 = 1048576 - source_length;
        let got: i64 = sotlas_linux_read(input_fd, unsafe { source + source_length }, available);
        if got == -4 { continue; }
        if got < 0 { let closed_error: i64 = sotlas_linux_close(input_fd); return fail(3); }
        if got == 0 { break; }
        source_length = source_length + (got as usize);
    }
    let closed: i64 = sotlas_linux_close(input_fd);
    if closed < 0 || source_length == 0 || source_length == 1048576 { return fail(3); }
    return driver_compile_loaded(source_length, output_name, object_only, compiler_entry);
}

// Explicit input order is authoritative until safe native import resolution
// ships. Append one newline per file to match the hosted reference bytes.
fn driver_compile_project(
    argc: u64, argv: *const *const u8,
    object_only: bool, compiler_entry: bool, resolve_imports: bool
) -> u32 {
    if argc < 5 || argc > 67 { return fail(1); }
    let output_name: *const u8 = unsafe { *(argv + 2) };
    if output_name == null { return fail(1); }
    let mut source: *mut u8 = unsafe { driver_source_bytes as *mut u8 };
    if resolve_imports { source = unsafe { driver_project_raw as *mut u8 }; }
    let mut source_length: usize = 0;
    let mut input_index: u64 = 3;
    while input_index < argc {
        let input_name: *const u8 = unsafe { *(argv + input_index) };
        if input_name == null { return fail(1); }
        let opened: i64 = sotlas_linux_open(input_name, 0, 0);
        if opened < 0 { return fail(2); }
        let input_fd: u64 = opened as u64;
        let before_file: usize = source_length;
        if resolve_imports {
            let file: usize = (input_index - 3) as usize;
            unsafe { *(driver_project_starts as *mut usize + file) = before_file; }
        }
        while source_length < 1048576 {
            let available: u64 = 1048576 - source_length;
            let got: i64 = sotlas_linux_read(
                input_fd, unsafe { source + source_length }, available
            );
            if got == -4 { continue; }
            if got < 0 {
                let closed_error: i64 = sotlas_linux_close(input_fd);
                return fail(3);
            }
            if got == 0 { break; }
            source_length = source_length + (got as usize);
        }
        let closed: i64 = sotlas_linux_close(input_fd);
        // The separator is included in the bounded combined source size.
        if closed < 0 || source_length == before_file || source_length >= 1048575 {
            return fail(3);
        }
        if resolve_imports {
            let file: usize = (input_index - 3) as usize;
            unsafe {
                *(driver_project_lengths as *mut usize + file) = source_length - before_file;
            }
        }
        unsafe { *(source + source_length) = 10; }
        source_length = source_length + 1;
        input_index = input_index + 1;
    }
    if resolve_imports {
        source_length = driver_resolve_project((argc - 3) as usize);
        if source_length == 0 { return fail(12); }
    }
    return driver_compile_loaded(source_length, output_name, object_only, compiler_entry);
}

// Linux x86-64 commands:
//   sotlas-native INPUT.sotlas OUTPUT [--object|--compiler]
//   sotlas-native --project[-object|-compiler] OUTPUT INPUT1 INPUT2 ...
// Imports still fail closed; the bounded explicit list is not module loading.
pub fn sotlas_linux_main(argc: u64, argv: *const *const u8) -> u32 {
    if argc < 3 || argv == null { return fail(1); }
    let first_option: *const u8 = unsafe { *(argv + 1) };
    if first_option == null { return fail(1); }
    if option_equals(first_option, "--project", 9) {
        return driver_compile_project(argc, argv, false, false, false);
    }
    if option_equals(first_option, "--project-object", 16) {
        return driver_compile_project(argc, argv, true, false, false);
    }
    if option_equals(first_option, "--project-compiler", 18) {
        return driver_compile_project(argc, argv, false, true, false);
    }
    let resolve_mode: u32 = driver_resolve_mode(first_option);
    if resolve_mode == 1 {
        return driver_compile_project(argc, argv, false, false, true);
    }
    if resolve_mode == 2 {
        return driver_compile_project(argc, argv, true, false, true);
    }
    if resolve_mode == 3 {
        return driver_compile_project(argc, argv, false, true, true);
    }
    return driver_compile_single(argc, argv);
}

        if token.kind == TokenKind::Error { return driver_position_error(4,lexer.error_line,lexer.error_col,"lexical error",13,TokenKind::Error); }
    }
    if lexer.error_count != 0 || token_count == 262144 { return fail(4); }
    let mut parser: Parser = Parser::new(token_buffer, token_count, node_buffer, 262144);
    let module_index: usize = parser.parse_module();
    if module_index == 0 || parser.error_count != 0 { return driver_position_error(5,parser.error_line,parser.error_col,"syntax error",12,parser.error_expected); }
    let mut sema: Sema = Sema::new();
    if !sema.check_top_level_declarations(node_buffer, parser.node_count,
        module_index, source, source_length) {
if sema.ownership_error_reason == 1 { return driver_position_error(6,sema.error_line,sema.error_col,"ownership constraint violated",29,TokenKind::Error); }
if sema.ownership_error_reason == 2 { return driver_position_error(6,sema.error_line,sema.error_col,"use of moved or maybe-moved value",33,TokenKind::Error); }
if sema.ownership_error_reason == 3 { return driver_position_error(6,sema.error_line,sema.error_col,"borrowed value cannot be mutated",32,TokenKind::Error); }
if sema.ownership_error_reason == 4 { return driver_position_error(6,sema.error_line,sema.error_col,"borrowed value cannot escape",28,TokenKind::Error); }
if sema.ownership_error_reason == 5 { return driver_position_error(6,sema.error_line,sema.error_col,"deferred borrow prevents ownership transfer",43,TokenKind::Error); }
if sema.ownership_error_reason == 6 { return driver_position_error(6,sema.error_line,sema.error_col,"deferred argument has unproven effects",38,TokenKind::Error); }
if sema.ownership_error_reason == 7 { return driver_position_error(6,sema.error_line,sema.error_col,"match guard cannot consume ownership",36,TokenKind::Error); }
return driver_position_error(6,sema.error_line,sema.error_col,"semantic error",14,TokenKind::Error); }
    let mut lowering: ScalarLowering = ScalarLowering::new(node_buffer, parser.node_count,
        source, source_length, unsafe { driver_values as *mut TargetValue }, 131072,
        unsafe { driver_parameters as *mut TargetParameter }, 16384,
        unsafe { driver_instructions as *mut TargetInstruction }, 262144,
        unsafe { driver_operands as *mut TargetOperand }, 524288,
        unsafe { driver_phi_inputs as *mut TargetPhiInput }, 16384,
        unsafe { driver_blocks as *mut TargetBlock }, 65536,
        unsafe { driver_targets as *mut u32 }, 65536,
        unsafe { driver_functions as *mut TargetFunction }, 8192);
    let mut ir: TargetModule = TargetModule { version: 1, function_count: 0,
        parameter_count: 0, block_count: 0, instruction_count: 0, value_count: 0,
        operand_count: 0, phi_input_count: 0, target_count: 0 };
    if !lower_scalar_module(&mut lowering, module_index, &mut ir) {
        if lowering.error_node!=0 && lowering.error_node<parser.node_count {
            let point:AstNode=unsafe{*(node_buffer+lowering.error_node)};
            if lowering.error_reason != 0 {
                return driver_position_error(7,point.span.line,point.span.col,
                    native_match_error_text(lowering.error_reason),native_match_error_length(lowering.error_reason),TokenKind::Error);
            }
            return driver_position_error(7,point.span.line,point.span.col,"unsupported native form",23,TokenKind::Error);
        }
        return fail(7);
    }
    let object_buffer: *mut u8 = unsafe { driver_object_bytes as *mut u8 };
    let mut object_length: usize = 0;
    let ir_pointer: *const TargetModule = unsafe { (&ir) as *const TargetModule };
    let length_pointer: *mut usize = unsafe { (&object_length) as *mut usize };
    if !emit_elf64_module_object(source, unsafe { g_extended_len }, ir_pointer,
        unsafe { driver_functions as *const TargetFunction }, unsafe { driver_parameters as *const TargetParameter },
        unsafe { driver_values as *const TargetValue }, unsafe { driver_blocks as *const TargetBlock },
        unsafe { driver_instructions as *const TargetInstruction }, unsafe { driver_operands as *const TargetOperand },
        unsafe { driver_phi_inputs as *const TargetPhiInput }, unsafe { driver_targets as *const u32 },
        object_buffer, 8388608, length_pointer) { return fail(8); }
    // Checking includes native object validation, but performs no output I/O
    // and does not require an executable entry or resolved foreign symbols.
    unsafe{driver_last_object_length[0]=object_length;}
    if check_only { return 0; }
    let mut artifact: *const u8 = object_buffer as *const u8;
    let mut artifact_length: usize = object_length;
    if !object_only {
        let image_buffer: *mut u8 = unsafe { driver_image_bytes as *mut u8 };
        let mut offset: usize = 0;
        let mut image_length: usize = 0;
        let offset_pointer: *const usize = unsafe { (&offset) as *const usize };
        let object_length_pointer: *const usize = length_pointer as *const usize;
        let image_length_pointer: *mut usize = unsafe { (&image_length) as *mut usize };
        let mut entry_name: *const u8 = "main_entry";
        let mut entry_length: usize = 10;
        if compiler_entry && !windows {
            if unsafe { driver_macho_target[0] } == 1 {
                entry_name = "sotlas_darwin_main"; entry_length = 18;
            } else { entry_name = "sotlas_linux_main"; entry_length = 17; }
        }
        let mut linked: bool = false;
        if windows {
            linked = link_pe64_executable(object_buffer, object_length, entry_name,
                entry_length, image_buffer, 16777216, image_length_pointer);
        } else if unsafe { driver_macho_target[0] } == 1 {
            linked = link_macho64_executable(object_buffer, object_length, entry_name,
                entry_length, image_buffer, 16777216, image_length_pointer);
        } else {
            linked = link_elf64_executable(object_buffer, offset_pointer, object_length_pointer, 1,
                entry_name, entry_length, null, 0, 4194304, false,
                image_buffer, 16777216, image_length_pointer);
        }
        if !linked { return fail(9); }
        artifact = image_buffer as *const u8;
        artifact_length = image_length;
    }
    // Create/truncate only after the complete artifact has been validated.
    let output_opened: i64 = sotlas_linux_open(output_name, 577, 493);
    if output_opened < 0 { return fail(10); }
    let output_fd: u64 = output_opened as u64;
    let mut position: usize = 0;
    while position < artifact_length {
        let remaining: u64 = artifact_length - position;
        let written: i64 = sotlas_linux_write(output_fd, unsafe { artifact + position }, remaining);
        if written == -4 { continue; }
        if written <= 0 { let closed_output: i64 = sotlas_linux_close(output_fd); return fail(11); }
        position = position + (written as usize);
    }
    let closed_output: i64 = sotlas_linux_close(output_fd);
    if closed_output < 0 { return fail(11); }
    return 0;
}



// SV8.21b1: parse a canonical, contiguous module path from lexer tokens.
// Imports currently support only explicit glob declarations `import path::*;`.
// The path excludes the import glob, and end_offset includes its semicolon.
// Module paths use contextual identifiers. Words such as `gate` and `system`
// are keywords in expression syntax but valid namespace segments. Validate
// their spelling in this context instead of requiring TokenKind::Ident.
fn driver_path_identifier(token: Token, source: *const u8, length: usize) -> bool {
    let start: usize = token.span.offset;
    let count: usize = token.span.length;
    if source == null || count == 0 || start > length || count > length - start { return false; }
    let mut index: usize = 0;
    while index < count {
        let ch: u8 = unsafe { *(source + start + index) };
        let letter: bool = (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95;
        let digit: bool = ch >= 48 && ch <= 57;
        if !letter && (index == 0 || !digit) { return false; }
        index = index + 1;
    }
    return true;
}

fn driver_read_module_path(mut lexer: &mut Lexer, import_path: bool) -> bool {
    let first: Token = lexer.next_token();
    if !driver_path_identifier(first, lexer.source, lexer.source_len) { return false; }
    let start: usize = first.span.offset;
    let mut finish: usize = start + first.span.length;
    let mut next: Token = lexer.next_token();
    while next.kind == TokenKind::DColon {
        if next.span.offset != finish { return false; }
        let part: Token = lexer.next_token();
        if part.kind == TokenKind::Star && import_path {
            if part.span.offset != finish + 2 { return false; }
            let semi: Token = lexer.next_token();
            if semi.kind != TokenKind::SemiColon { return false; }
            unsafe {
                *(driver_path_start as *mut usize) = start;
                *(driver_path_length as *mut usize) = finish - start;
                *(driver_path_end as *mut usize) = semi.span.offset + semi.span.length;
            }
            return true;
        }
        if !driver_path_identifier(part, lexer.source, lexer.source_len) || part.span.offset != finish + 2 {
            return false;
        }
        finish = part.span.offset + part.span.length;
        next = lexer.next_token();
    }
    if import_path || next.kind != TokenKind::SemiColon { return false; }
    unsafe {
        *(driver_path_start as *mut usize) = start;
        *(driver_path_length as *mut usize) = finish - start;
        *(driver_path_end as *mut usize) = next.span.offset + next.span.length;
    }
    return true;
}

fn driver_module_name_equals(
    source: *const u8, a_start: usize, a_len: usize,
    b_start: usize, b_len: usize
) -> bool {
    if a_len == 0 || a_len != b_len { return false; }
    let mut pos: usize = 0;
    while pos < a_len {
        if unsafe { *(source + a_start + pos) != *(source + b_start + pos) } {
            return false;
        }
        pos = pos + 1;
    }
    return true;
}

// Scan each full file with the production lexer, never a substring/regex:
// commented-out imports and string literals are not interpreted as edges.
// A file must have exactly one top-level module declaration.
fn driver_resolve_scan_file(source: *const u8, file: usize, file_count: usize) -> bool {
    let start: usize = unsafe { *(driver_project_starts as *const usize + file) };
    let length: usize = unsafe { *(driver_project_lengths as *const usize + file) };
    let mut lexer: Lexer = Lexer::new(unsafe { source + start }, length);
    let mut module_count: usize = 0;
    let mut depth: usize = 0;
    let mut token: Token = lexer.next_token();
    while token.kind != TokenKind::Eof {
        if token.kind == TokenKind::Error { return false; }
        if token.kind == TokenKind::KwModule {
            if module_count != 0 || depth != 0 { return false; }
            if !driver_read_module_path(&mut lexer, false) { return false; }
            let off: usize = unsafe { *(driver_path_start as *const usize) };
            let size: usize = unsafe { *(driver_path_length as *const usize) };
            let own_name: usize = unsafe { *(driver_module_starts as *const usize + file) };
            let own_size: usize = unsafe { *(driver_module_lengths as *const usize + file) };
            if !driver_module_name_equals(source, start + off, size, own_name, own_size) {
                return false;
            }
            module_count = module_count + 1;
        } else if token.kind == TokenKind::KwImport {
            if module_count != 1 || depth != 0 { return false; }
            if !driver_read_module_path(&mut lexer, true) { return false; }
            let off: usize = unsafe { *(driver_path_start as *const usize) };
            let size: usize = unsafe { *(driver_path_length as *const usize) };
            let mut found: bool = false;
            let mut dependency: usize = 0;
            while dependency < file_count {
                let dep_start: usize = unsafe {
                    *(driver_module_starts as *const usize + dependency)
                };
                let dep_size: usize = unsafe {
                    *(driver_module_lengths as *const usize + dependency)
                };
                if driver_module_name_equals(source, start + off, size, dep_start, dep_size) {
                    if dependency == file { return false; }
                    let edge: *mut u8 = unsafe {
                        (driver_module_edges as *mut u8) + file * 64 + dependency
                    };
                    if unsafe { *edge } != 0 { return false; }
                    unsafe { *edge = 1; }
                    found = true;
                    break;
                }
                dependency = dependency + 1;
            }
            if !found { return false; }
        } else if token.kind == TokenKind::OpenBrace {
            depth = depth + 1;
        } else if token.kind == TokenKind::CloseBrace {
            if depth == 0 { return false; }
            depth = depth - 1;
        }
        token = lexer.next_token();
    }
    return module_count == 1 && depth == 0 && lexer.error_count == 0;
}

// A deterministic stable topological order: among ready modules pick the
// earliest input index. Missing, repeated and self-imports fail at scan;
// a dependency cycle leaves no ready vertex and fails without output I/O.
fn driver_resolve_order(file_count: usize) -> bool {
    let mut i: usize = 0;
    while i < file_count {
        unsafe { *(driver_module_selected as *mut u8 + i) = 0; }
        i = i + 1;
    }
    let mut written: usize = 0;
    while written < file_count {
        let mut found: bool = false;
        let mut candidate: usize = 0;
        while candidate < file_count {
            if unsafe { *(driver_module_selected as *const u8 + candidate) } == 0 {
                let mut ready: bool = true;
                let mut dependency: usize = 0;
                while dependency < file_count {
                    let edge: u8 = unsafe {
                        *(driver_module_edges as *const u8 + candidate * 64 + dependency)
                    };
                    if edge != 0 && unsafe {
                        *(driver_module_selected as *const u8 + dependency)
                    } == 0 {
                        ready = false;
                        break;
                    }
                    dependency = dependency + 1;
                }
                if ready {
                    unsafe {
                        *(driver_module_selected as *mut u8 + candidate) = 1;
                        *(driver_module_order as *mut usize + written) = candidate;
                    }
                    found = true;
                    break;
                }
            }
            candidate = candidate + 1;
        }
        if !found { return false; }
        written = written + 1;
    }
    return true;
}

fn driver_copy_project_slice(source: *const u8, first: usize, last: usize) -> bool {
    if first > last { return false; }
    let position: usize = unsafe { *(driver_resolved_length as *const usize) };
    if position >= 2097152 || last - first >= 2097152 - position {
        return false;
    }
    if !driver_map_add(position,last-first,first,unsafe{driver_map_current_file[0]}) { return false; }
    let destination: *mut u8 = unsafe { driver_source_bytes as *mut u8 };
    let mut cursor: usize = first;
    while cursor < last {
        unsafe { *(destination + position + cursor - first) = *(source + cursor); }
        cursor = cursor + 1;
    }
    unsafe { *(driver_resolved_length as *mut usize) = position + last - first; }
    return true;
}

// Reuse the same lexer to remove only validated import declarations (not
// comments, string contents, or similarly named identifiers). The full
// original declarations remain available in the raw input for validation.
fn driver_resolve_append_file(source: *const u8, file: usize) -> bool {
    unsafe{driver_map_current_file[0]=file;}
    let start: usize = unsafe { *(driver_project_starts as *const usize + file) };
    let length: usize = unsafe { *(driver_project_lengths as *const usize + file) };
    let mut lexer: Lexer = Lexer::new(unsafe { source + start }, length);
    let mut copied: usize = 0;
    let mut token: Token = lexer.next_token();
    while token.kind != TokenKind::Eof {
        if token.kind == TokenKind::Error { return false; }
        if token.kind == TokenKind::KwImport {
            if !driver_read_module_path(&mut lexer, true)
                || token.span.offset < copied { return false; }
            let finish: usize = unsafe { *(driver_path_end as *const usize) };
            if !driver_copy_project_slice(
                source, start + copied, start + token.span.offset
            ) { return false; }
            copied = finish;
        }
        token = lexer.next_token();
    }
    if !driver_copy_project_slice(source, start + copied, start + length) {
        return false;
    }
    let destination: *mut u8 = unsafe { driver_source_bytes as *mut u8 };
    let position: usize = unsafe { *(driver_resolved_length as *const usize) };
    if position >= 2097151 || !driver_map_add(position,1,start+length,file) { return false; }
    unsafe {
        *(destination + position) = 10;
        *(driver_resolved_length as *mut usize) = position + 1;
    }
    return true;
}

// Returns zero on any unsafe or unresolved graph. The caller must not open
// the requested output until this returns a valid source stream and the
// complete native compiler pipeline succeeds.
fn driver_resolve_project(file_count: usize) -> usize {
    if file_count == 0 || file_count > 64 { return 0; }
    // Each project check owns a fresh dependency graph, including audit batches.
    let mut edge_index: usize=0;
    while edge_index < 4096 {
        unsafe{*(driver_module_edges as *mut u8+edge_index)=0;}edge_index=edge_index+1;
    }
    let source: *const u8 = unsafe { driver_project_raw as *const u8 };
    let mut file: usize = 0;
    while file < file_count {
        let start: usize = unsafe { *(driver_project_starts as *const usize + file) };
        let length: usize = unsafe { *(driver_project_lengths as *const usize + file) };
        let mut lexer: Lexer = Lexer::new(unsafe { source + start }, length);
        if lexer.next_token().kind != TokenKind::KwModule { return 0; }
        if !driver_read_module_path(&mut lexer, false) { return 0; }
        let off: usize = unsafe { *(driver_path_start as *const usize) };
        let size: usize = unsafe { *(driver_path_length as *const usize) };
        unsafe {
            *(driver_module_starts as *mut usize + file) = start + off;
            *(driver_module_lengths as *mut usize + file) = size;
        }
        let mut other: usize = 0;
        while other < file {
            let name_start: usize = unsafe {
                *(driver_module_starts as *const usize + other)
            };
            let name_len: usize = unsafe {
                *(driver_module_lengths as *const usize + other)
            };
            if driver_module_name_equals(source, start + off, size, name_start, name_len) {
                return 0;
            }
            other = other + 1;
        }
        file = file + 1;
    }
    file = 0;
    while file < file_count {
        if !driver_resolve_scan_file(source, file, file_count) { return 0; }
        file = file + 1;
    }
    if !driver_resolve_order(file_count) { return 0; }
    unsafe { *(driver_resolved_length as *mut usize) = 0; driver_map_count[0]=0;driver_map_active[0]=0;driver_map_file_count[0]=file_count; }
    let mut ordered: usize = 0;
    while ordered < file_count {
        let index: usize = unsafe { *(driver_module_order as *const usize + ordered) };
        if !driver_resolve_append_file(source, index) { return 0; }
        ordered = ordered + 1;
    }
    unsafe{driver_map_active[0]=1;}
    return unsafe { *(driver_resolved_length as *const usize) };
}


fn driver_filename_length(path: *const u8) -> usize {
    let mut length: usize = 0;
    while length < 4096 {
        if unsafe { *(path + length) } == 0 { return length; }
        length = length + 1;
    }
    return 4096;
}

fn driver_discovery_add(path: *const u8) -> bool {
    let length: usize = driver_filename_length(path);
    if length == 0 || length >= 4096 { return false; }
    let count: usize = unsafe { *(driver_discovery_count as *const usize) };
    let base: *mut u8 = unsafe { driver_discovery_paths as *mut u8 };
    let mut file: usize = 0;
    while file < count {
        let candidate: *const u8 = unsafe { base + file * 4096 };
        if driver_filename_length(candidate) == length {
            let mut index: usize = 0;
            let mut same: bool = true;
            while index < length {
                if unsafe { *(candidate + index) } != unsafe { *(path + index) } { same = false; break; }
                index = index + 1;
            }
            if same { return true; }
        }
        file = file + 1;
    }
    if count >= 64 { return false; }
    let destination: *mut u8 = unsafe { base + count * 4096 };
    let mut index: usize = 0;
    while index <= length {
        unsafe { *(destination + index) = *(path + index); }
        index = index + 1;
    }
    unsafe { *(driver_discovery_count as *mut usize) = count + 1; }
    return true;
}

fn driver_discovery_import(root: *const u8, source: *const u8,
    first: usize, length: usize) -> bool {
    let root_length: usize = driver_filename_length(root);
    if root_length == 0 || root_length >= 4096 || length == 0
        || root_length + length + 9 >= 4096 { return false; }
    let mut path: [u8; 4096] = 0;
    let pointer: *mut u8 = unsafe { path as *mut u8 };
    let mut position: usize = 0;
    while position < root_length {
        unsafe { *(pointer + position) = *(root + position); }
        position = position + 1;
    }
    if unsafe { *(root + root_length - 1) } != 47 {
        unsafe { *(pointer + position) = 47; }
        position = position + 1;
    }
    let mut index: usize = 0;
    while index < length {
        let ch: u8 = unsafe { *(source + first + index) };
        if ch == 58 {
            if index + 1 >= length || unsafe { *(source + first + index + 1) } != 58 { return false; }
            unsafe { *(pointer + position) = 47; }
            index = index + 2;
        } else {
            unsafe { *(pointer + position) = ch; }
            index = index + 1;
        }
        position = position + 1;
    }
    let suffix: *const u8 = ".sotlas";
    index = 0;
    while index <= 7 {
        unsafe { *(pointer + position + index) = *(suffix + index); }
        index = index + 1;
    }
    return driver_discovery_add(pointer);
}

fn driver_build_mode(option: *const u8) -> u32 {
    let mut index: usize = 0;
    while index < 7 {
        let mut expected: u8 = 45;
        if index == 2 { expected = 98; }
        else if index == 3 { expected = 117; }
        else if index == 4 { expected = 105; }
        else if index == 5 { expected = 108; }
        else if index == 6 { expected = 100; }
        if unsafe { *(option + index) } != expected { return 0; }
        index = index + 1;
    }
    if unsafe { *(option + 7) } == 0 { return 1; }
    if unsafe { *(option + 7) } != 45 { return 0; }
    if unsafe { *(option + 8) } == 111 {
        if unsafe { *(option + 9) } != 98 || unsafe { *(option + 10) } != 106 { return 0; }
        if unsafe { *(option + 11) } == 0 { return 2; }
    } else if unsafe { *(option + 8) } == 99 {
        if unsafe { *(option + 9) } == 99 && unsafe { *(option + 10) } == 0 { return 3; }
    }
    return 0;
}

fn driver_dispatch_build(argc: u64, argv: *const *const u8, mode: u32) -> u32 {
    if mode == 1 { return driver_compile_discovered(argc, argv, false, false, false, false); }
    if mode == 2 { return driver_compile_discovered(argc, argv, true, false, false, false); }
    if mode == 3 { return driver_compile_discovered(argc, argv, false, true, false, false); }
    return fail(1);
}

fn driver_compile_discovered(argc: u64, argv: *const *const u8,
    object_only: bool, compiler_entry: bool, check_only: bool, windows: bool) -> u32 {
    let mut argument_index: usize = 3;
    let mut output: *const u8 = null;
    if check_only {
        if argc != 4 { return fail(1); }
        argument_index = 2;
    } else {
        if argc != 5 { return fail(1); }
        output = unsafe { *(argv + 2) };
        if output == null { return fail(1); }
    }
    let root: *const u8 = unsafe { *(argv + argument_index) };
    let entry: *const u8 = unsafe { *(argv + argument_index + 1) };
    if root == null || entry == null { return fail(1); }
    unsafe { *(driver_discovery_count as *mut usize) = 0; }
    if !driver_discovery_add(entry) { return fail(12); }
    let source: *mut u8 = unsafe { driver_project_raw as *mut u8 };
    let paths: *const u8 = unsafe { driver_discovery_paths as *const u8 };
    let mut position: usize = 0;
    let mut file: usize = 0;
    while file < unsafe { *(driver_discovery_count as *const usize) } {
        let path: *const u8 = unsafe { paths + file * 4096 };
        if !driver_map_path(file,path){return fail(12);}
        let opened: i64 = sotlas_linux_open(path, 0, 0);
        if opened < 0 { return fail(2); }
        let descriptor: u64 = opened as u64;
        let start: usize = position;
        while position < 2097152 {
            let available: u64 = 2097152 - position;
            let count: i64 = sotlas_linux_read(descriptor, unsafe { source + position }, available);
            if count == -4 { continue; }
            if count < 0 { let closed: i64 = sotlas_linux_close(descriptor); return fail(3); }
            if count == 0 { break; }
            position = position + (count as usize);
        }
        let closed: i64 = sotlas_linux_close(descriptor);
        if closed < 0 || position == start || position >= 2097151 { return fail(3); }
        let length: usize = position - start;
        unsafe {
            *(driver_project_starts as *mut usize + file) = start;
            *(driver_project_lengths as *mut usize + file) = length;
            *(source + position) = 10;
        }
        position = position + 1;
        let mut lexer: Lexer = Lexer::new(unsafe { source + start }, length);
        let mut depth: usize = 0;
        let mut token: Token = lexer.next_token();
        while token.kind != TokenKind::Eof {
            if token.kind == TokenKind::Error { return fail(4); }
            if token.kind == TokenKind::KwImport {
                if depth != 0 || !driver_read_module_path(&mut lexer, true) { return fail(12); }
                let first: usize = unsafe { *(driver_path_start as *const usize) };
                let count: usize = unsafe { *(driver_path_length as *const usize) };
                if !driver_discovery_import(root, source, start + first, count) { return fail(12); }
            } else if token.kind == TokenKind::OpenBrace { depth = depth + 1; }
            else if token.kind == TokenKind::CloseBrace {
                if depth == 0 { return fail(12); }
                depth = depth - 1;
            }
            token = lexer.next_token();
        }
        file = file + 1;
    }
    let count: usize = unsafe { *(driver_discovery_count as *const usize) };
    let length: usize = driver_resolve_project(count);
    if length == 0 { return fail(12); }
    return driver_compile_loaded(length, output, object_only, compiler_entry, check_only, windows);
}

// Retain the certified single-file input byte stream, options and limits.
fn driver_compile_single(argc: u64, argv: *const *const u8) -> u32 {
    if argc != 3 && argc != 4 { return fail(1); }
    let input_name: *const u8 = unsafe { *(argv + 1) };
    let output_name: *const u8 = unsafe { *(argv + 2) };
    if input_name == null || output_name == null { return fail(1); }
    let mut object_only: bool = false;
    let mut compiler_entry: bool = false;
    let mut windows: bool = false;
    if argc == 4 {
        let option: *const u8 = unsafe { *(argv + 3) };
        if option_equals(option, "--object", 8) {
            object_only = true;
        } else if option_equals(option, "--compiler", 10) {
            compiler_entry = true;
        } else if option_equals(option, "--windows", 9) {
            windows = true;
        } else {
            return fail(1);
        }
    }
    return driver_read_single(input_name, output_name, object_only, compiler_entry, false, windows);
}

fn driver_check_single(argc: u64, argv: *const *const u8) -> u32 {
    if argc != 3 { return fail(1); }
    let input_name: *const u8 = unsafe { *(argv + 2) };
    if input_name == null { return fail(1); }
    return driver_read_single(input_name, null, true, false, true, false);
}

// Single-file check and compilation share the bounded reader and pipeline.
fn driver_read_single(input_name: *const u8, output_name: *const u8,
    object_only: bool, compiler_entry: bool, check_only: bool, windows: bool) -> u32 {
    driver_set_error_path(input_name);
    let opened: i64 = sotlas_linux_open(input_name, 0, 0);
    if opened < 0 { return fail(2); }
    let input_fd: u64 = opened as u64;
    let source: *mut u8 = unsafe { driver_source_bytes as *mut u8 };
    let mut source_length: usize = 0;
    while source_length < 2097152 {
        let available: u64 = 2097152 - source_length;
        let got: i64 = sotlas_linux_read(input_fd, unsafe { source + source_length }, available);
        if got == -4 { continue; }
        if got < 0 { let closed_error: i64 = sotlas_linux_close(input_fd); return fail(3); }
        if got == 0 { break; }
        source_length = source_length + (got as usize);
    }
    let closed: i64 = sotlas_linux_close(input_fd);
    if closed < 0 || source_length == 0 || source_length == 2097152 { return fail(3); }
    return driver_compile_loaded(source_length, output_name, object_only, compiler_entry, check_only, windows);
}

// Explicit input order is authoritative until safe native import resolution
// ships. Append one newline per file to match the hosted reference bytes.
fn driver_compile_project(
    argc: u64, argv: *const *const u8,
    object_only: bool, compiler_entry: bool, resolve_imports: bool, check_only: bool
) -> u32 {
    let mut input_base: u64=3;let mut output_name: *const u8=null;
    if check_only { input_base=2; }
    else { if argc < 5 { return fail(1); }output_name=unsafe{*(argv+2)};if output_name == null{return fail(1);} }
    if argc < input_base+1 || argc > input_base+64 { return fail(1); }
    let mut source: *mut u8 = unsafe { driver_source_bytes as *mut u8 };
    if resolve_imports { source = unsafe { driver_project_raw as *mut u8 }; }
    let mut source_length: usize = 0;
    let mut input_index: u64 = input_base;
    while input_index < argc {
        let input_name: *const u8 = unsafe { *(argv + input_index) };
        if input_name == null { return fail(1); }
        let file:usize=(input_index-input_base) as usize;
        if !driver_map_path(file,input_name){return fail(12);}
        let opened: i64 = sotlas_linux_open(input_name, 0, 0);
        if opened < 0 { return fail(2); }
        let input_fd: u64 = opened as u64;
        let before_file: usize = source_length;
        unsafe{driver_project_starts[file]=before_file;}
        while source_length < 2097152 {
            let available: u64 = 2097152 - source_length;
            let got: i64 = sotlas_linux_read(
                input_fd, unsafe { source + source_length }, available
            );
            if got == -4 { continue; }
            if got < 0 {
                let closed_error: i64 = sotlas_linux_close(input_fd);
                return fail(3);
            }
            if got == 0 { break; }
            source_length = source_length + (got as usize);
        }
        let closed: i64 = sotlas_linux_close(input_fd);
        // The separator is included in the bounded combined source size.
        if closed < 0 || source_length == before_file || source_length >= 2097151 {
            return fail(3);
        }
        unsafe{driver_project_lengths[file]=source_length-before_file;}
        if !resolve_imports && !driver_map_add(before_file,source_length-before_file,before_file,file){return fail(12);}
        if !resolve_imports && !driver_map_add(source_length,1,source_length,file){return fail(12);}
        unsafe { *(source + source_length) = 10; }
        source_length = source_length + 1;
        input_index = input_index + 1;
    }
    if resolve_imports {
        source_length = driver_resolve_project((argc - input_base) as usize);
        if source_length == 0 { return fail(12); }
    } else {
        let raw:*mut u8=unsafe{driver_project_raw as *mut u8};let mut copied:usize=0;
        while copied<source_length{unsafe{*(raw+copied)=*(source+copied);}copied=copied+1;}
        unsafe{driver_map_file_count[0]=(argc-input_base) as usize;driver_map_active[0]=1;}
    }
    return driver_compile_loaded(source_length, output_name, object_only, compiler_entry, check_only, false);
}

// Linux x86-64 commands:
//   sotlas-native INPUT.sotlas OUTPUT [--object|--compiler]
//   sotlas-native --project[-object|-compiler] OUTPUT INPUT1 INPUT2 ...
// Imports still fail closed; the bounded explicit list is not module loading.
pub fn sotlas_linux_main(argc: u64, argv: *const *const u8) -> u32 {
    if argc == 2 && argv != null {
        let option: *const u8 = unsafe { *(argv + 1) };
        if option == null { return fail(1); }
        let query: u32 = driver_query_mode(option);
        if query != 0 { return driver_query_print(query); }
        if option_equals(option,"--self-test",11) { return driver_self_test(); }
        if option_equals(option, "--help", 6) { return driver_print_profile(true); }
        if option_equals(option, "--capabilities", 14) { return driver_print_profile(false); }
        return fail(1);
    }
    if argc < 3 || argv == null { return fail(1); }
    let first_option: *const u8 = unsafe { *(argv + 1) };
    if first_option == null { return fail(1); }
    let extended: u32=driver_extended_dispatch(argc,argv,first_option);
    if extended != 4294967295 { return extended; }
    let audit: u32 = driver_audit_dispatch(argc,argv,first_option);
    if audit != 4294967295 { return audit; }
    if driver_query_mode(first_option) != 0 || option_equals(first_option,"--self-test",11) { return fail(1); }

    if option_equals(first_option, "--check", 7) {
        return driver_check_single(argc, argv);
    }
    if option_equals(first_option, "--check-build", 13) {
        return driver_compile_discovered(argc, argv, true, false, true, false);
    }
    if option_equals(first_option, "--build-win", 11) {
        return driver_compile_discovered(argc, argv, false, false, false, true);
    }
    if option_equals(first_option, "--build-mac-cc", 14) {
        unsafe { driver_macho_target[0] = 1; }
        return driver_compile_discovered(argc, argv, false, true, false, false);
    }
    if option_equals(first_option, "--build-mac", 11) {
        unsafe { driver_macho_target[0] = 1; }
        return driver_compile_discovered(argc, argv, false, false, false, false);
    }
    let build_mode: u32 = driver_build_mode(first_option);
    if build_mode != 0 { return driver_dispatch_build(argc, argv, build_mode); }
    if option_equals(first_option, "--project", 9) {
        return driver_compile_project(argc, argv, false, false, false, false);
    }
    if option_equals(first_option, "--project-object", 16) {
        return driver_compile_project(argc, argv, true, false, false, false);
    }
    if option_equals(first_option, "--project-compiler", 18) {
        return driver_compile_project(argc, argv, false, true, false, false);
    }
    if argc > 4 {
        return driver_dispatch_resolved(argc, argv, first_option);
    }
    return driver_compile_single(argc, argv);
}


// Bounded reads distinguish an exact-capacity artifact from truncation.
fn driver_read_artifact(path: *const u8, buffer: *mut u8, capacity: usize) -> i64 {
    if path == null || buffer == null || capacity == 0 { return -3; }
    let fd: i64=sotlas_linux_open(path,0,0);if fd < 0 { return -2; }
    let mut length: usize=0;let mut failed: bool=false;
    while length < capacity {
        let got: i64=sotlas_linux_read(fd as u64,unsafe{buffer+length},(capacity-length) as u64);
        if got == -4 { continue; }
        if got < 0 || got as u64 > (capacity-length) as u64 { failed=true;break; }
        if got == 0 { break; }length=length+got as usize;
    }
    if !failed && length == capacity {
        let extra: *mut u8=unsafe{driver_audit_right as *mut u8};let mut got: i64=-4;
        while got == -4 { got=sotlas_linux_read(fd as u64,extra,1); }
        if got != 0 { failed=true; }
    }
    let closed: i64=sotlas_linux_close(fd as u64);if failed || closed < 0 { return -3; }
    return length as i64;
}

fn driver_write_artifact(path: *const u8, bytes: *const u8, length: usize, exclusive: bool) -> u32 {
    let mut flags: u64=577;if exclusive { flags=705; }
    let fd: i64=sotlas_linux_open(path,flags,493);if fd < 0 { return fail(10); }
    let mut index: usize=0;
    while index < length {
        let written: i64=sotlas_linux_write(fd as u64,unsafe{bytes+index},(length-index) as u64);
        if written == -4 { continue; }
        if written <= 0 || written as u64 > (length-index) as u64 {
            let closed: i64=sotlas_linux_close(fd as u64);return fail(11);
        }
        index=index+written as usize;
    }
    let closed: i64=sotlas_linux_close(fd as u64);if closed < 0 { return fail(11); }return 0;
}

fn driver_object_operation(argc: u64, argv: *const *const u8, linking: bool, check_only: bool) -> u32 {
    if (!linking && argc != 3) || (linking && !check_only && argc != 5)
        || (check_only && argc != 4) { return fail(1); }
    let input: *const u8=unsafe{*(argv+2)};
    let bytes: *mut u8=unsafe{driver_object_bytes as *mut u8};
    let length: i64=driver_read_artifact(input,bytes,8388608);
    if length == -2 { return fail(2); }if length < 0 { return fail(3); }
    if !validate_elf64_object(bytes,length as usize) { return fail(8); }
    if !linking { return driver_print_text("object=ELF64-x86_64-valid\n"); }
    let output: *const u8=unsafe{*(argv+3)};let mut entry: *const u8=output;
    if !check_only { entry=unsafe{*(argv+4)}; }
    if output == null || entry == null { return fail(1); }
    let mut entry_length: u64=0;
    while entry_length < 4096 && unsafe{*(entry+entry_length)} != 0 { entry_length=entry_length+1; }
    if entry_length == 0 || entry_length == 4096 { return fail(1); }
    let mut offset: usize=0;let mut object_length: usize=length as usize;
    let mut image_length: usize=0;let image: *mut u8=unsafe{driver_image_bytes as *mut u8};
    let offsets: *const usize=unsafe{(&offset) as *const usize};
    let lengths: *const usize=unsafe{(&mut object_length) as *const usize};
    let result_length: *mut usize=unsafe{(&mut image_length) as *mut usize};
    let linked: bool=link_elf64_executable(bytes,offsets,lengths,1,entry,entry_length as usize,null,0,4194304,false,image,16777216,result_length);
    if !linked || image_length == 0 { return fail(9); }
    if check_only { return 0; }
    return driver_write_artifact(output,image,image_length,false);
}



// SV8.70: opted-in typed linking for two independently compiled ELF objects.
// Usage: --link-elf-typed-pair OUT ENTRY NAMES IMPORT.o IMPORT.soti EXPORT.o EXPORT.soti
// The SOTI records are untrusted attestations provided by the caller.
// Check both records against *actual ELF symbol names and definition state*,
// then apply the checked ABI/role/effect/capability comparison before the
// existing production linker is allowed to publish an executable.
// Existing --link-elf-objects behavior is deliberately unchanged.
fn driver_link_elf_typed_pair(argc: u64, argv: *const *const u8) -> u32 {
    if argc != 9 { return fail(1); }
    let output_path: *const u8 = unsafe { *(argv+2) };
    let entry: *const u8 = unsafe { *(argv+3) };
    if output_path == null || entry == null { return fail(1); }
    let mut entry_len: usize = 0;
    while entry_len < 4096 && unsafe { *(entry+entry_len) } != 0 {
        entry_len = entry_len+1;
    }
    if entry_len == 0 || entry_len == 4096 { return fail(1); }
    let names: *mut u8 = unsafe { driver_typed_names as *mut u8 };
    let source_size: i64 = driver_read_artifact(unsafe { *(argv+4) },names,4096);
    if source_size == -2 { return fail(2); }
    if source_size <= 0 { return fail(3); }
    let objects: *mut u8 = unsafe { driver_object_bytes as *mut u8 };
    let records: *mut u8 = unsafe { driver_typed_records as *mut u8 };
    let mut positions: [usize;2] = [0;2];
    let mut lengths: [usize;2] = [0;2];
    let mut record_lengths: [usize;2] = [0;2];
    let mut total: usize = 0;
    let mut index: usize = 0;
    while index < 2 {
        let object_path: *const u8 = unsafe { *(argv+5+index*2) };
        let signature_path: *const u8 = unsafe { *(argv+6+index*2) };
        if object_path == null || signature_path == null { return fail(1); }
        if total == 8388608 { return fail(3); }
        let count: i64 = driver_read_artifact(object_path,unsafe{objects+total},8388608-total);
        if count == -2 { return fail(2); }
        if count <= 0 { return fail(3); }
        if !validate_elf64_object(unsafe{objects+total},count as usize) { return fail(8); }
        positions[index] = total;
        lengths[index] = count as usize;
        total = total+count as usize;
        let sig: i64 = driver_read_artifact(signature_path,
            unsafe{records+index*240},240);
        if sig == -2 { return fail(2); }
        if sig <= 0 { return fail(3); }
        record_lengths[index] = sig as usize;
        if !target_interface_wire_valid(unsafe{records+index*240},sig as usize,
            names as *const u8,source_size as usize) { return fail(9); }
        index = index+1;
    }
    let first: *const u8 = records as *const u8;
    let second: *const u8 = unsafe { records+240 };
    if !target_interface_wire_compatible(first,record_lengths[0],second,
        record_lengths[1],names as *const u8,source_size as usize) { return fail(9); }
    let start1: usize = get_u32(first,record_lengths[0],16) as usize;
    let size1: usize = get_u32(first,record_lengths[0],20) as usize;
    let start2: usize = get_u32(second,record_lengths[1],16) as usize;
    let size2: usize = get_u32(second,record_lengths[1],20) as usize;
    if !elf_typed_function_symbol_exists(
            unsafe{objects+positions[0]},lengths[0],
            unsafe{names+start1},size1,false)
        || !elf_typed_function_symbol_exists(
            unsafe{objects+positions[1]},lengths[1],
            unsafe{names+start2},size2,true) { return fail(9); }
    let image: *mut u8 = unsafe { driver_image_bytes as *mut u8 };
    let mut image_len: usize = 0;
    let success: bool = link_elf64_executable(objects as *const u8,
        unsafe{positions as *const usize},unsafe{lengths as *const usize},
        2,entry,entry_len,null,0,4194304,false,
        image,16777216,unsafe{(&mut image_len) as *mut usize});
    if !success || image_len == 0 { return fail(9); }
    return driver_write_artifact(output_path,image,image_len,false);
}

// Cross-host ELF linking: at most 16 independently emitted objects, 8 MiB total.
// All inputs are loaded and validated before the output is opened.
fn driver_link_elf_objects(argc: u64, argv: *const *const u8) -> u32 {
    if argc < 5 || argc > 20 { return fail(1); }
    let output: *const u8 = unsafe{*(argv+2)};
    let entry: *const u8 = unsafe{*(argv+3)};
    if output == null || entry == null { return fail(1); }
    let mut entry_length: usize = 0;
    while entry_length < 4096 && unsafe{*(entry+entry_length)} != 0 {
        entry_length = entry_length+1;
    }
    if entry_length == 0 || entry_length == 4096 { return fail(1); }
    let bytes: *mut u8 = unsafe{driver_object_bytes as *mut u8};
    let mut offsets: [usize;16] = 0;
    let mut lengths: [usize;16] = 0;
    let mut total: usize = 0;
    let mut index: usize = 0;
    while index < (argc-4) as usize {
        if total == 8388608 { return fail(3); }
        let path: *const u8 = unsafe{*(argv+index+4)};
        let part: *mut u8 = unsafe{bytes+total};
        let length: i64 = driver_read_artifact(path,part,8388608-total);
        if length == -2 { return fail(2); }
        if length < 0 { return fail(3); }
        if !validate_elf64_object(part,length as usize) { return fail(8); }
        offsets[index] = total;
        lengths[index] = length as usize;
        total = total+length as usize;
        index = index+1;
    }
    let image: *mut u8 = unsafe{driver_image_bytes as *mut u8};
    let mut image_length: usize = 0;
    let linked: bool = link_elf64_executable(bytes,
        unsafe{offsets as *const usize},unsafe{lengths as *const usize},
        index as u32,entry,entry_length,null,0,4194304,false,
        image,16777216,unsafe{(&mut image_length) as *mut usize});
    if !linked || image_length == 0 { return fail(9); }
    return driver_write_artifact(output,image,image_length,false);
}

fn driver_stamp_seed(seed: *const u8, output: *const u8) -> u32 {
    if seed == null || output == null { return fail(1); }
    let envelope: u32=driver_seed_envelope(seed);if envelope != 0 { return envelope; }
    let hashed: u32=driver_hash_file(seed);if hashed != 0 { return hashed; }
    let buffer: *mut u8=unsafe{driver_audit_left as *mut u8};
    let magic: *const u8="SOTSEED1";let mut index: u64=0;
    while index < 8 { unsafe{*(buffer+index)=*(magic+index);}index=index+1; }
    let hash: u64=unsafe{driver_hash[0]};let size: u64=unsafe{driver_size[0]};index=0;
    while index < 8 {
        unsafe{*(buffer+8+index)=((hash >> (index*8)) & 255) as u8;
            *(buffer+16+index)=((size >> (index*8)) & 255) as u8;}
        index=index+1;
    }
    unsafe{*(buffer+24)=1;*(buffer+25)=1;}
    index=26;while index < 32 { unsafe{*(buffer+index)=0;}index=index+1; }
    return driver_write_artifact(output,buffer,32,true);
}

fn driver_verify_stamp_quiet(seed: *const u8, stamp: *const u8) -> u32 {
    if seed == null || stamp == null { return fail(1); }
    let envelope: u32=driver_seed_envelope(seed);if envelope != 0 { return envelope; }
    let hashed: u32=driver_hash_file(seed);if hashed != 0 { return hashed; }
    let buffer: *mut u8=unsafe{driver_audit_left as *mut u8};
    let length: i64=driver_read_artifact(stamp,buffer,32);
    if length == -2 { return fail(2); }if length < 0 { return fail(16); }
    if length != 32 { return fail(16); }
    let magic: *const u8="SOTSEED1";let mut index: u64=0;
    while index < 8 { if unsafe{*(buffer+index)} != unsafe{*(magic+index)} { return fail(16); }index=index+1; }
    let hash: u64=unsafe{driver_hash[0]};let size: u64=unsafe{driver_size[0]};index=0;
    while index < 8 {
        if unsafe{*(buffer+8+index)} != ((hash >> (index*8)) & 255) as u8
            || unsafe{*(buffer+16+index)} != ((size >> (index*8)) & 255) as u8 { return fail(16); }
        index=index+1;
    }
    if unsafe{*(buffer+24)} != 1 || unsafe{*(buffer+25)} != 1 { return fail(16); }
    index=26;while index < 32 { if unsafe{*(buffer+index)} != 0 { return fail(16); }index=index+1; }
    return 0;
}

fn driver_verify_stamp(seed: *const u8, stamp: *const u8) -> u32 {
    let status: u32=driver_verify_stamp_quiet(seed,stamp);
    if status != 0 { return status; }return driver_print_text("seed-stamp=matched\n");
}

fn driver_seed_info(seed: *const u8) -> u32 {
    let envelope: u32=driver_seed_envelope(seed);if envelope != 0 { return envelope; }
    let hashed: u32=driver_hash_file(seed);if hashed != 0 { return hashed; }
    let buffer: *mut u8=unsafe{driver_audit_left as *mut u8};let digits: *const u8="0123456789abcdef";
    let hash: u64=unsafe{driver_hash[0]};let size: u64=unsafe{driver_size[0]};let mut index: u64=0;
    while index < 16 {
        let shift: u64=(15-index)*4;
        unsafe{*(buffer+index)=*(digits+((hash >> shift) & 15));
            *(buffer+17+index)=*(digits+((size >> shift) & 15));}
        index=index+1;
    }
    unsafe{*(buffer+16)=10;*(buffer+33)=10;*(buffer+34)=0;}
    return driver_print_text(buffer);
}


// Batch success is emitted only after every item has passed.
fn driver_batch_operation(argc: u64, argv: *const *const u8, mode: u32) -> u32 {
    if argc < 3 || argc > 18 { return fail(1); }
    if mode == 3 && argc < 4 { return fail(1); }
    let mut index: u64=2;
    let reference: *const u8=unsafe{*(argv+2)};
    while index < argc {

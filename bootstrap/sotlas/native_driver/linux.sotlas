    // the bounded native compiler-source profile.
    let project_info: bool=option_equals(option,"--project-set-info",18);
    let project_verify: bool=option_equals(option,"--verify-project-stamp",22);
    let project_compare: bool=option_equals(option,"--compare-projects",18);
    if project_info || option_equals(option,"--stamp-project",15) || project_verify || project_compare {

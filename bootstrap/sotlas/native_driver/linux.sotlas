        return driver_json_report(unsafe{*(argv+2)},mode);
    }
    if option_equals(option,"--verify-project-object",23) || option_equals(option,"--compare-project-objects",25)
        || option_equals(option,"--stamp-project-object",22) || option_equals(option,"--verify-project-object-stamp",29) {
        if argc != 4 { return fail(1); }let first:*const u8=unsafe{*(argv+2)};let second:*const u8=unsafe{*(argv+3)};
        if option_equals(option,"--verify-project-object",23) { return driver_verify_project_object(first,second); }
        if option_equals(option,"--compare-project-objects",25) { return driver_compare_project_objects(first,second); }
        return driver_project_object_stamp(first,second,option_equals(option,"--verify-project-object-stamp",29));
    }

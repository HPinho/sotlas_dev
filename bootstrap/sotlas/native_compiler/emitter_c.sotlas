module sotlas::compiler::emitter_c;

import sotlas::compiler::token::*;
import sotlas::compiler::ast::*;

pub struct CEmitter {
    pub out_buf: *mut u8;
    pub max_len: usize;
    pub cursor: usize;
    pub source: *const u8;
    pub source_len: usize;
    pub nodes: *const AstNode;
    pub node_count: usize;
}

impl CEmitter {
    pub fn new(
        buf: *mut u8,
        max: usize,
        source: *const u8,
        source_len: usize,
        nodes: *const AstNode,
        node_count: usize
    ) -> CEmitter {
        return CEmitter {
            out_buf: buf,
            max_len: max,
            cursor: 0,
            source: source,
            source_len: source_len,
            nodes: nodes,
            node_count: node_count
        };
    }

    pub fn write_byte(mut self: &mut Self, b: u8) -> bool {
        if self.cursor >= self.max_len {
            return false;
        }
        unsafe {
            *(self.out_buf + self.cursor) = b;
        }
        self.cursor = self.cursor + 1;
        return true;
    }

    pub fn write_str(mut self: &mut Self, s: *const u8, len: usize) -> bool {
        let mut i: usize = 0;
        while i < len {
            let b: u8 = unsafe { *(s + i) };
            if !self.write_byte(b) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    pub fn write_source_slice(
        mut self: &mut Self,
        offset: usize,
        len: usize
    ) -> bool {
        if self.source == null || offset > self.source_len {
            return false;
        }
        if len > self.source_len - offset {
            return false;
        }
        return self.write_str(self.source + offset, len);
    }

    pub fn valid_node(self: &Self, index: usize) -> bool {
        return self.nodes != null && index > 0 && index < self.node_count;
    }

    pub fn emit_binary_operator(mut self: &mut Self, tag: i64) -> bool {
        if tag == 80 { return self.write_byte(43); } // +
        if tag == 81 { return self.write_byte(45); } // -
        if tag == 82 { return self.write_byte(42); } // *
        if tag == 83 { return self.write_byte(47); } // /
        if tag == 84 { return self.write_byte(37); } // %
        if tag == 86 {
            return self.write_byte(61) && self.write_byte(61);
        }
        if tag == 87 {
            return self.write_byte(33) && self.write_byte(61);
        }
        if tag == 88 { return self.write_byte(60); }
        if tag == 89 {
            return self.write_byte(60) && self.write_byte(61);
        }
        if tag == 90 { return self.write_byte(62); }
        if tag == 91 {
            return self.write_byte(62) && self.write_byte(61);
        }
        return false;
    }

    pub fn emit_expression(mut self: &mut Self, index: usize) -> bool {
        if !self.valid_node(index) {
            return false;
        }
        let node: AstNode = unsafe { *(self.nodes + index) };

        if node.kind == AstKind::ExprIdent || node.kind == AstKind::ExprLiteral {
            return self.write_source_slice(node.str_offset, node.str_len);
        }

        if node.kind == AstKind::ExprBinary {
            let left: usize = node.first_child;
            if !self.valid_node(left) {
                return false;
            }
            let left_node: AstNode = unsafe { *(self.nodes + left) };
            let right: usize = left_node.next_sibling;
            if !self.valid_node(right) {
                return false;
            }
            if !self.write_byte(40) { return false; }
            if !self.emit_expression(left) { return false; }
            if !self.write_byte(32) { return false; }
            if !self.emit_binary_operator(node.int_value) { return false; }
            if !self.write_byte(32) { return false; }
            if !self.emit_expression(right) { return false; }
            return self.write_byte(41);
        }

        if node.kind == AstKind::ExprCall {
            let callee: usize = node.first_child;
            if !self.valid_node(callee) {
                return false;
            }
            if !self.emit_expression(callee) { return false; }
            if !self.write_byte(40) { return false; }

            let callee_node: AstNode = unsafe { *(self.nodes + callee) };
            let mut arg: usize = callee_node.next_sibling;
            let mut first: bool = true;
            while arg != 0 {
                if !self.valid_node(arg) {
                    return false;
                }
                if !first {
                    if !self.write_byte(44) || !self.write_byte(32) {
                        return false;
                    }
                }
                if !self.emit_expression(arg) {
                    return false;
                }
                let arg_node: AstNode = unsafe { *(self.nodes + arg) };
                arg = arg_node.next_sibling;
                first = false;
            }
            return self.write_byte(41);
        }

        return false;
    }

    pub fn emit_statement_payload(mut self: &mut Self, index: usize) -> bool {
        if !self.valid_node(index) {
            return false;
        }
        let node: AstNode = unsafe { *(self.nodes + index) };

        if node.kind == AstKind::AssignStmt {
            let left: usize = node.first_child;
            if !self.valid_node(left) {
                return false;
            }
            let left_node: AstNode = unsafe { *(self.nodes + left) };
            let right: usize = left_node.next_sibling;
            if !self.valid_node(right) {
                return false;
            }
            if !self.emit_expression(left) { return false; }
            if !self.write_str(" = ", 3) { return false; }
            if !self.emit_expression(right) { return false; }
            return self.write_str(";\n", 2);
        }

        if node.kind == AstKind::ExprCall
            || node.kind == AstKind::ExprBinary
            || node.kind == AstKind::ExprIdent
            || node.kind == AstKind::ExprLiteral {
            if !self.emit_expression(index) {
                return false;
            }
            return self.write_str(";\n", 2);
        }

        return false;
    }

    pub fn emit_defer_payload(mut self: &mut Self, index: usize) -> bool {
        if !self.valid_node(index) {
            return false;
        }
        let node: AstNode = unsafe { *(self.nodes + index) };
        if node.kind != AstKind::DeferStmt || node.first_child == 0 {
            return false;
        }

        let payload_index: usize = node.first_child;
        if !self.valid_node(payload_index) {
            return false;
        }
        let payload: AstNode = unsafe { *(self.nodes + payload_index) };

        if payload.kind == AstKind::Block {
            return self.emit_braced_block(payload_index);
        }
        return self.emit_statement_payload(payload_index);
    }

    pub fn emit_defer_chain_lifo(mut self: &mut Self, index: usize) -> bool {
        if index == 0 {
            return true;
        }
        if !self.valid_node(index) {
            return false;
        }

        let node: AstNode = unsafe { *(self.nodes + index) };

        // Walk to the end of the lexical sibling chain first so defers are
        // emitted in reverse registration order when this scope closes.
        if !self.emit_defer_chain_lifo(node.next_sibling) {
            return false;
        }

        if node.kind == AstKind::DeferStmt {
            return self.emit_defer_payload(index);
        }
        return true;
    }

    pub fn emit_block_exit_defers(
        mut self: &mut Self,
        block_index: usize
    ) -> bool {
        if !self.valid_node(block_index) {
            return false;
        }
        let block: AstNode = unsafe { *(self.nodes + block_index) };
        if block.kind != AstKind::Block {
            return false;
        }
        return self.emit_defer_chain_lifo(block.first_child);
    }

    pub fn emit_defer_prefix_lifo(
        mut self: &mut Self,
        index: usize,
        stop_before: usize
    ) -> bool {
        if index == stop_before {
            return true;
        }
        if index == 0 {
            return stop_before == 0;
        }
        if !self.valid_node(index) {
            return false;
        }

        let node: AstNode = unsafe { *(self.nodes + index) };
        if !self.emit_defer_prefix_lifo(node.next_sibling, stop_before) {
            return false;
        }
        if node.kind == AstKind::DeferStmt {
            return self.emit_defer_payload(index);
        }
        return true;
    }

    pub fn emit_scope_defers_before(
        mut self: &mut Self,
        block_index: usize,
        stop_before: usize
    ) -> bool {
        if !self.valid_node(block_index) || !self.valid_node(stop_before) {
            return false;
        }
        let block: AstNode = unsafe { *(self.nodes + block_index) };
        let stop: AstNode = unsafe { *(self.nodes + stop_before) };
        if block.kind != AstKind::Block || stop.parent != block_index {
            return false;
        }
        return self.emit_defer_prefix_lifo(block.first_child, stop_before);
    }

    pub fn emit_return_scope_defers(
        mut self: &mut Self,
        return_index: usize
    ) -> bool {
        if !self.valid_node(return_index) {
            return false;
        }
        let return_node: AstNode = unsafe { *(self.nodes + return_index) };
        if return_node.kind != AstKind::ReturnStmt {
            return false;
        }

        let mut child_on_path: usize = return_index;
        let mut parent_index: usize = return_node.parent;

        while parent_index != 0 {
            if !self.valid_node(parent_index) {
                return false;
            }
            let parent_node: AstNode = unsafe { *(self.nodes + parent_index) };

            if parent_node.kind == AstKind::Block {
                if !self.emit_scope_defers_before(parent_index, child_on_path) {
                    return false;
                }
            } else if parent_node.kind == AstKind::FnDecl
                || parent_node.kind == AstKind::TrapfnDecl {
                return true;
            }

            child_on_path = parent_index;
            parent_index = parent_node.parent;
        }

        return false;
    }

    pub fn emit_loop_jump_scope_defers(
        mut self: &mut Self,
        jump_index: usize
    ) -> bool {
        if !self.valid_node(jump_index) {
            return false;
        }
        let jump: AstNode = unsafe { *(self.nodes + jump_index) };
        if jump.kind != AstKind::BreakStmt
            && jump.kind != AstKind::ContinueStmt {
            return false;
        }

        let mut child_on_path: usize = jump_index;
        let mut parent_index: usize = jump.parent;

        while parent_index != 0 {
            if !self.valid_node(parent_index) {
                return false;
            }
            let parent_node: AstNode = unsafe { *(self.nodes + parent_index) };

            if parent_node.kind == AstKind::Block {
                if !self.emit_scope_defers_before(parent_index, child_on_path) {
                    return false;
                }
            } else if parent_node.kind == AstKind::WhileStmt {
                return true;
            } else if parent_node.kind == AstKind::FnDecl
                || parent_node.kind == AstKind::TrapfnDecl {
                // A loop jump outside a loop is structurally invalid.
                return false;
            }

            child_on_path = parent_index;
            parent_index = parent_node.parent;
        }

        return false;
    }

    pub fn emit_loop_jump_statement(
        mut self: &mut Self,
        jump_index: usize
    ) -> bool {
        if !self.valid_node(jump_index) {
            return false;
        }
        let jump: AstNode = unsafe { *(self.nodes + jump_index) };
        if jump.kind != AstKind::BreakStmt
            && jump.kind != AstKind::ContinueStmt {
            return false;
        }

        if !self.emit_loop_jump_scope_defers(jump_index) {
            return false;
        }
        if jump.kind == AstKind::BreakStmt {
            return self.write_str("break;\n", 7);
        }
        return self.write_str("continue;\n", 10);
    }

    pub fn source_slice_equals(
        self: &Self,
        offset: usize,
        len: usize,
        expected: *const u8,
        expected_len: usize
    ) -> bool {
        if self.source == null || expected == null || len != expected_len {
            return false;
        }
        if offset > self.source_len || len > self.source_len - offset {
            return false;
        }
        let mut i: usize = 0;
        while i < len {
            let a: u8 = unsafe { *(self.source + offset + i) };
            let b: u8 = unsafe { *(expected + i) };
            if a != b {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    pub fn emit_c_type(mut self: &mut Self, type_index: usize) -> bool {
        if !self.valid_node(type_index) {
            return false;
        }
        let typ: AstNode = unsafe { *(self.nodes + type_index) };
        if typ.kind != AstKind::TypeRef || typ.str_len == 0 {
            return false;
        }

        if self.source_slice_equals(typ.str_offset, typ.str_len, "i8", 2) {
            return self.write_str("int8_t", 6);
        }
        if self.source_slice_equals(typ.str_offset, typ.str_len, "i16", 3) {
            return self.write_str("int16_t", 7);
        }
        if self.source_slice_equals(typ.str_offset, typ.str_len, "i32", 3) {
            return self.write_str("int32_t", 7);
        }
        if self.source_slice_equals(typ.str_offset, typ.str_len, "i64", 3) {
            return self.write_str("int64_t", 7);
        }
        if self.source_slice_equals(typ.str_offset, typ.str_len, "u8", 2) {
            return self.write_str("uint8_t", 7);
        }
        if self.source_slice_equals(typ.str_offset, typ.str_len, "u16", 3) {
            return self.write_str("uint16_t", 8);
        }
        if self.source_slice_equals(typ.str_offset, typ.str_len, "u32", 3) {
            return self.write_str("uint32_t", 8);
        }
        if self.source_slice_equals(typ.str_offset, typ.str_len, "u64", 3) {
            return self.write_str("uint64_t", 8);
        }
        if self.source_slice_equals(typ.str_offset, typ.str_len, "usize", 5) {
            return self.write_str("size_t", 6);
        }
        if self.source_slice_equals(typ.str_offset, typ.str_len, "isize", 5) {
            return self.write_str("intptr_t", 8);
        }
        if self.source_slice_equals(typ.str_offset, typ.str_len, "bool", 4) {
            return self.write_str("bool", 4);
        }
        if self.source_slice_equals(typ.str_offset, typ.str_len, "void", 4) {
            return self.write_str("void", 4);
        }

        // Named user types remain source-named until native type lowering is
        // introduced. Composite pointer/generic types are intentionally not
        // claimed as complete by this helper.
        return self.write_source_slice(typ.str_offset, typ.str_len);
    }

    pub fn find_enclosing_function(self: &Self, index: usize) -> usize {
        if !self.valid_node(index) {
            return 0;
        }
        let mut current: usize = index;
        while current != 0 {
            if !self.valid_node(current) {
                return 0;
            }
            let node: AstNode = unsafe { *(self.nodes + current) };
            if node.kind == AstKind::FnDecl || node.kind == AstKind::TrapfnDecl {
                return current;
            }
            current = node.parent;
        }
        return 0;
    }

    pub fn find_function_return_type(self: &Self, fn_index: usize) -> usize {
        if !self.valid_node(fn_index) {
            return 0;
        }
        let function_node: AstNode = unsafe { *(self.nodes + fn_index) };
        if function_node.kind != AstKind::FnDecl
            && function_node.kind != AstKind::TrapfnDecl {
            return 0;
        }

        let mut child: usize = function_node.first_child;
        while child != 0 {
            if !self.valid_node(child) {
                return 0;
            }
            let node: AstNode = unsafe { *(self.nodes + child) };
            if node.kind == AstKind::TypeRef {
                return child;
            }
            child = node.next_sibling;
        }
        return 0;
    }

    pub fn emit_return_statement(
        mut self: &mut Self,
        return_index: usize
    ) -> bool {
        if !self.valid_node(return_index) {
            return false;
        }
        let ret: AstNode = unsafe { *(self.nodes + return_index) };
        if ret.kind != AstKind::ReturnStmt {
            return false;
        }

        if ret.first_child == 0 {
            if !self.emit_return_scope_defers(return_index) {
                return false;
            }
            return self.write_str("return;\n", 8);
        }

        let fn_index: usize = self.find_enclosing_function(return_index);
        if fn_index == 0 {
            return false;
        }
        let type_index: usize = self.find_function_return_type(fn_index);
        if type_index == 0 {
            return false;
        }

        // The nested C block gives every return site its own temporary scope.
        if !self.write_str("{\n", 2) {
            return false;
        }
        if !self.emit_c_type(type_index) {
            return false;
        }
        if !self.write_str(" __sotlas_return_value = ", 25) {
            return false;
        }

        // Normative defer rule: evaluate and capture the return expression
        // before any active cleanup can mutate referenced state.
        if !self.emit_expression(ret.first_child) {
            return false;
        }
        if !self.write_str(";\n", 2) {
            return false;
        }
        if !self.emit_return_scope_defers(return_index) {
            return false;
        }
        return self.write_str("return __sotlas_return_value;\n}\n", 32);
    }


    pub fn emit_braced_block(mut self: &mut Self, block_index: usize) -> bool {
        if !self.valid_node(block_index) {
            return false;
        }
        let block: AstNode = unsafe { *(self.nodes + block_index) };
        if block.kind != AstKind::Block {
            return false;
        }
        if !self.write_str("{\n", 2) {
            return false;
        }
        if !self.emit_block_normal_exit(block_index) {
            return false;
        }
        return self.write_str("}\n", 2);
    }

    pub fn emit_while_statement(mut self: &mut Self, index: usize) -> bool {
        if !self.valid_node(index) {
            return false;
        }
        let node: AstNode = unsafe { *(self.nodes + index) };
        if node.kind != AstKind::WhileStmt {
            return false;
        }

        let cond_index: usize = node.first_child;
        if !self.valid_node(cond_index) {
            return false;
        }
        let cond: AstNode = unsafe { *(self.nodes + cond_index) };
        let body_index: usize = cond.next_sibling;
        if !self.valid_node(body_index) {
            return false;
        }
        let body: AstNode = unsafe { *(self.nodes + body_index) };
        if body.kind != AstKind::Block {
            return false;
        }

        if !self.write_str("while (", 7) {
            return false;
        }
        if !self.emit_expression(cond_index) {
            return false;
        }
        if !self.write_str(") ", 2) {
            return false;
        }
        return self.emit_braced_block(body_index);
    }

    pub fn emit_if_statement(mut self: &mut Self, index: usize) -> bool {
        if !self.valid_node(index) {
            return false;
        }
        let node: AstNode = unsafe { *(self.nodes + index) };
        if node.kind != AstKind::IfStmt {
            return false;
        }

        let cond_index: usize = node.first_child;
        if !self.valid_node(cond_index) {
            return false;
        }
        let cond: AstNode = unsafe { *(self.nodes + cond_index) };
        let then_index: usize = cond.next_sibling;
        if !self.valid_node(then_index) {
            return false;
        }
        let then_node: AstNode = unsafe { *(self.nodes + then_index) };
        if then_node.kind != AstKind::Block {
            return false;
        }

        if !self.write_str("if (", 4) {
            return false;
        }
        if !self.emit_expression(cond_index) {
            return false;
        }
        if !self.write_str(") ", 2) {
            return false;
        }
        if !self.emit_braced_block(then_index) {
            return false;
        }

        let else_index: usize = then_node.next_sibling;
        if else_index == 0 {
            return true;
        }
        if !self.valid_node(else_index) {
            return false;
        }
        let else_node: AstNode = unsafe { *(self.nodes + else_index) };
        if !self.write_str("else ", 5) {
            return false;
        }
        if else_node.kind == AstKind::Block {
            return self.emit_braced_block(else_index);
        }
        if else_node.kind == AstKind::IfStmt {
            return self.emit_if_statement(else_index);
        }
        return false;
    }

    pub fn emit_unsafe_block(mut self: &mut Self, index: usize) -> bool {
        if !self.valid_node(index) {
            return false;
        }
        let node: AstNode = unsafe { *(self.nodes + index) };
        if node.kind != AstKind::UnsafeBlock || node.first_child == 0 {
            return false;
        }

        let body_index: usize = node.first_child;
        if !self.valid_node(body_index) {
            return false;
        }
        let body: AstNode = unsafe { *(self.nodes + body_index) };
        if body.kind != AstKind::Block {
            return false;
        }

        return self.emit_braced_block(body_index);
    }

    pub fn emit_let_statement(mut self: &mut Self, index: usize) -> bool {
        if !self.valid_node(index) {
            return false;
        }
        let node: AstNode = unsafe { *(self.nodes + index) };
        if node.kind != AstKind::LetStmt || node.str_len == 0 {
            return false;
        }

        let type_index: usize = node.first_child;
        if !self.valid_node(type_index) {
            // Strict C11 has no native local type inference. Untyped locals
            // must remain fail-closed until typed SIR lowering is available.
            return false;
        }
        let type_node: AstNode = unsafe { *(self.nodes + type_index) };
        if type_node.kind != AstKind::TypeRef {
            return false;
        }

        if !self.emit_c_type(type_index) {
            return false;
        }
        if !self.write_byte(32) {
            return false;
        }
        if !self.write_source_slice(node.str_offset, node.str_len) {
            return false;
        }

        let init_index: usize = type_node.next_sibling;
        if init_index != 0 {
            if !self.valid_node(init_index) {
                return false;
            }
            if !self.write_str(" = ", 3) {
                return false;
            }
            if !self.emit_expression(init_index) {
                return false;
            }
        }

        return self.write_str(";\n", 2);
    }

    pub fn emit_normal_statement(mut self: &mut Self, index: usize) -> bool {
        if !self.valid_node(index) {
            return false;
        }
        let node: AstNode = unsafe { *(self.nodes + index) };

        // A defer declaration registers work for scope exit and emits nothing
        // at its declaration site.
        if node.kind == AstKind::DeferStmt {
            return true;
        }

        if node.kind == AstKind::LetStmt {
            return self.emit_let_statement(index);
        }
        if node.kind == AstKind::UnsafeBlock {
            return self.emit_unsafe_block(index);
        }
        if node.kind == AstKind::IfStmt {
            return self.emit_if_statement(index);
        }
        if node.kind == AstKind::WhileStmt {
            return self.emit_while_statement(index);
        }

        if node.kind == AstKind::AssignStmt
            || node.kind == AstKind::ExprCall
            || node.kind == AstKind::ExprBinary
            || node.kind == AstKind::ExprIdent
            || node.kind == AstKind::ExprLiteral {
            return self.emit_statement_payload(index);
        }

        // Control-flow and declarations require dedicated lowering; never
        // silently drop them from generated output.
        return false;
    }

    pub fn emit_block_normal_exit(
        mut self: &mut Self,
        block_index: usize
    ) -> bool {
        if !self.valid_node(block_index) {
            return false;
        }
        let block: AstNode = unsafe { *(self.nodes + block_index) };
        if block.kind != AstKind::Block {
            return false;
        }

        let mut stmt: usize = block.first_child;
        while stmt != 0 {
            if !self.valid_node(stmt) {
                return false;
            }
            let stmt_node: AstNode = unsafe { *(self.nodes + stmt) };

            // A return terminates this control-flow path. Its dedicated
            // lowering performs all active lexical cleanup itself, so the
            // block must not emit later statements or normal-exit cleanup.
            if stmt_node.kind == AstKind::ReturnStmt {
                return self.emit_return_statement(stmt);
            }
            if stmt_node.kind == AstKind::BreakStmt
                || stmt_node.kind == AstKind::ContinueStmt {
                return self.emit_loop_jump_statement(stmt);
            }

            if !self.emit_normal_statement(stmt) {
                return false;
            }
            stmt = stmt_node.next_sibling;
        }

        // Only a fallthrough path reaches the normal lexical cleanup.
        return self.emit_block_exit_defers(block_index);
    }

    pub fn emit_header(mut self: &mut Self) -> bool {
        let hdr: *const u8 = "// Compilado nativamente pelo compilador Sotlas in Sotlas (v1.0-selfhost)\n#include <stdint.h>\n#include <stdbool.h>\n#include <stddef.h>\n\n";
        return self.write_str(hdr, 136);
    }
}

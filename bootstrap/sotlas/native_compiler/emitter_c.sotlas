module sotlas::compiler::emitter_c;

import sotlas::compiler::token::*;
import sotlas::compiler::ast::*;

pub struct CEmitter {
    pub out_buf: *mut u8;
    pub max_len: usize;
    pub cursor: usize;
    pub source: *const u8;
    pub source_len: usize;
}

impl CEmitter {
    pub fn new(
        buf: *mut u8,
        max: usize,
        source: *const u8,
        source_len: usize
    ) -> CEmitter {
        return CEmitter {
            out_buf: buf,
            max_len: max,
            cursor: 0,
            source: source,
            source_len: source_len
        };
    }

    pub fn write_byte(mut self: &mut Self, b: u8) -> bool {
        if self.cursor >= self.max_len {
            return false;
        }
        unsafe {
            *(self.out_buf + self.cursor) = b;
        }
        self.cursor = self.cursor + 1;
        return true;
    }

    pub fn write_str(mut self: &mut Self, s: *const u8, len: usize) -> bool {
        let mut i: usize = 0;
        while i < len {
            let b: u8 = unsafe { *(s + i) };
            if !self.write_byte(b) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    pub fn write_source_slice(
        mut self: &mut Self,
        offset: usize,
        len: usize
    ) -> bool {
        if self.source == null || offset > self.source_len {
            return false;
        }
        if len > self.source_len - offset {
            return false;
        }
        return self.write_str(self.source + offset, len);
    }

    pub fn emit_header(mut self: &mut Self) -> bool {
        let hdr: *const u8 = "// Compilado nativamente pelo compilador Sotlas in Sotlas (v1.0-selfhost)\n#include <stdint.h>\n#include <stdbool.h>\n\n";
        return self.write_str(hdr, 110);
    }
}

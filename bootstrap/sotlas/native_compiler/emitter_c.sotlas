module sotlas::compiler::emitter_c;

import sotlas::compiler::token::*;
import sotlas::compiler::ast::*;

pub struct CEmitter {
    pub out_buf: *mut u8;
    pub max_len: usize;
    pub cursor: usize;
    pub source: *const u8;
    pub source_len: usize;
    pub nodes: *const AstNode;
    pub node_count: usize;
}

impl CEmitter {
    pub fn new(
        buf: *mut u8,
        max: usize,
        source: *const u8,
        source_len: usize,
        nodes: *const AstNode,
        node_count: usize
    ) -> CEmitter {
        return CEmitter {
            out_buf: buf,
            max_len: max,
            cursor: 0,
            source: source,
            source_len: source_len,
            nodes: nodes,
            node_count: node_count
        };
    }

    pub fn write_byte(mut self: &mut Self, b: u8) -> bool {
        if self.cursor >= self.max_len {
            return false;
        }
        unsafe {
            *(self.out_buf + self.cursor) = b;
        }
        self.cursor = self.cursor + 1;
        return true;
    }

    pub fn write_str(mut self: &mut Self, s: *const u8, len: usize) -> bool {
        let mut i: usize = 0;
        while i < len {
            let b: u8 = unsafe { *(s + i) };
            if !self.write_byte(b) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    pub fn write_source_slice(
        mut self: &mut Self,
        offset: usize,
        len: usize
    ) -> bool {
        if self.source == null || offset > self.source_len {
            return false;
        }
        if len > self.source_len - offset {
            return false;
        }
        let slice: *const u8 = unsafe { self.source + offset };
        return self.write_str(slice, len);
    }

    pub fn valid_node(self: &Self, index: usize) -> bool {
        return self.nodes != null && index > 0 && index < self.node_count;
    }

    pub fn emit_binary_operator(mut self: &mut Self, tag: i64) -> bool {
        if tag == 80 { return self.write_byte(43); } // +
        if tag == 81 { return self.write_byte(45); } // -
        if tag == 82 { return self.write_byte(42); } // *
        if tag == 83 { return self.write_byte(47); } // /
        if tag == 84 { return self.write_byte(37); } // %
        if tag == 86 {
            return self.write_byte(61) && self.write_byte(61);
        }
        if tag == 87 {
            return self.write_byte(33) && self.write_byte(61);
        }
        if tag == 88 { return self.write_byte(60); }
        if tag == 89 {
            return self.write_byte(60) && self.write_byte(61);
        }
        if tag == 90 { return self.write_byte(62); }
        if tag == 91 {
            return self.write_byte(62) && self.write_byte(61);
        }
        return false;
    }

    pub fn emit_unary_operator(mut self: &mut Self, tag: i64) -> bool {
        if tag == 80 { return self.write_byte(43); } // +
        if tag == 81 { return self.write_byte(45); } // -
        if tag == 95 { return self.write_byte(126); } // ~
        if tag == 98 { return self.write_byte(33); } // !
        return false;
    }

    pub fn find_struct_decl_for_literal(
        self: &Self,
        literal_index: usize
    ) -> usize {
        if !self.valid_node(literal_index) {
            return 0;
        }
        let literal: AstNode = unsafe { *(self.nodes + literal_index) };
        if literal.kind != AstKind::ExprStructLiteral || literal.str_len == 0 {
            return 0;
        }
        let module_index: usize = self.find_enclosing_module(literal_index);
        if !self.valid_node(module_index) {
            return 0;
        }
        let module_node: AstNode = unsafe { *(self.nodes + module_index) };
        let mut child: usize = module_node.first_child;
        while child != 0 {
            if !self.valid_node(child) {
                return 0;
            }
            let candidate: AstNode = unsafe { *(self.nodes + child) };
            if candidate.kind == AstKind::StructDecl && candidate.str_len != 0
                && self.source_slices_equal(
                    candidate.str_offset,
                    candidate.str_len,
                    literal.str_offset,
                    literal.str_len
                ) {
                return child;
            }
            child = candidate.next_sibling;
        }
        return 0;
    }

    pub fn find_struct_field_decl(
        self: &Self,
        struct_index: usize,
        init_index: usize
    ) -> usize {
        if !self.valid_node(struct_index) || !self.valid_node(init_index) {
            return 0;
        }
        let decl: AstNode = unsafe { *(self.nodes + struct_index) };
        let init: AstNode = unsafe { *(self.nodes + init_index) };
        if decl.kind != AstKind::StructDecl || init.kind != AstKind::StructFieldInit
            || init.str_len == 0 {
            return 0;
        }

        let mut field_index: usize = decl.first_child;
        while field_index != 0 {
            if !self.valid_node(field_index) {
                return 0;
            }
            let field: AstNode = unsafe { *(self.nodes + field_index) };
            if field.kind == AstKind::FieldDecl && field.str_len != 0
                && self.source_slices_equal(
                    field.str_offset,
                    field.str_len,
                    init.str_offset,
                    init.str_len
                ) {
                return field_index;
            }
            field_index = field.next_sibling;
        }
        return 0;
    }

    pub fn struct_literal_shape_valid(
        self: &Self,
        literal_index: usize
    ) -> bool {
        let struct_index: usize = self.find_struct_decl_for_literal(literal_index);
        if struct_index == 0 || !self.valid_node(literal_index) {
            return false;
        }
        let decl: AstNode = unsafe { *(self.nodes + struct_index) };
        let literal: AstNode = unsafe { *(self.nodes + literal_index) };

        let mut declared_count: usize = 0;
        let mut field_index: usize = decl.first_child;
        while field_index != 0 {
            if !self.valid_node(field_index) {
                return false;
            }
            let field: AstNode = unsafe { *(self.nodes + field_index) };
            if field.kind != AstKind::FieldDecl || field.str_len == 0
                || !self.valid_node(field.first_child) {
                return false;
            }
            let typ: AstNode = unsafe { *(self.nodes + field.first_child) };
            if typ.kind != AstKind::TypeRef || typ.next_sibling != 0 {
                return false;
            }
            declared_count = declared_count + 1;
            field_index = field.next_sibling;
        }

        let mut init_count: usize = 0;
        let mut init_index: usize = literal.first_child;
        while init_index != 0 {
            if !self.valid_node(init_index) {
                return false;
            }
            let init: AstNode = unsafe { *(self.nodes + init_index) };
            if init.kind != AstKind::StructFieldInit || init.str_len == 0
                || !self.valid_node(init.first_child)
                || self.find_struct_field_decl(struct_index, init_index) == 0 {
                return false;
            }
            let value: AstNode = unsafe { *(self.nodes + init.first_child) };
            if value.next_sibling != 0 {
                return false;
            }

            let mut previous: usize = literal.first_child;
            while previous != init_index {
                if previous == 0 || !self.valid_node(previous) {
                    return false;
                }
                let previous_init: AstNode = unsafe { *(self.nodes + previous) };
                if previous_init.kind != AstKind::StructFieldInit {
                    return false;
                }
                if self.source_slices_equal(
                    previous_init.str_offset,
                    previous_init.str_len,
                    init.str_offset,
                    init.str_len
                ) {
                    return false;
                }
                previous = previous_init.next_sibling;
            }

            init_count = init_count + 1;
            init_index = init.next_sibling;
        }

        return declared_count != 0 && declared_count == init_count;
    }

    pub fn fixed_array_type_matches_zero_repeat(
        self: &Self,
        type_index: usize,
        repeat_index: usize
    ) -> bool {
        if !self.valid_node(type_index) || !self.valid_node(repeat_index)
            || self.source == null {
            return false;
        }
        let typ: AstNode = unsafe { *(self.nodes + type_index) };
        let repeat: AstNode = unsafe { *(self.nodes + repeat_index) };
        if typ.kind != AstKind::TypeRef || typ.str_len < 5
            || repeat.kind != AstKind::ExprArrayRepeat
            || !self.valid_node(repeat.first_child) {
            return false;
        }
        let value_index: usize = repeat.first_child;
        let value: AstNode = unsafe { *(self.nodes + value_index) };
        let count_index: usize = value.next_sibling;
        if value.kind != AstKind::ExprLiteral
            || !self.source_slice_equals(value.str_offset, value.str_len, "0", 1)
            || !self.valid_node(count_index) {
            return false;
        }
        let count: AstNode = unsafe { *(self.nodes + count_index) };
        if count.kind != AstKind::ExprLiteral || count.str_len == 0
            || count.next_sibling != 0 {
            return false;
        }

        let mut i: usize = 0;
        while i < typ.str_len {
            let ch: u8 = unsafe { *(self.source + typ.str_offset + i) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 { i = i + 1; }
            else { break; }
        }
        if i >= typ.str_len || unsafe { *(self.source + typ.str_offset + i) } != 91 {
            return false;
        }
        i = i + 1;
        while i < typ.str_len {
            let ch: u8 = unsafe { *(self.source + typ.str_offset + i) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 { i = i + 1; }
            else { break; }
        }
        let element_start: usize = i;
        while i < typ.str_len {
            let ch: u8 = unsafe { *(self.source + typ.str_offset + i) };
            let alpha: bool = (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122);
            let digit: bool = ch >= 48 && ch <= 57;
            if alpha || digit || ch == 95 { i = i + 1; }
            else { break; }
        }
        if i == element_start {
            return false;
        }
        while i < typ.str_len {
            let ch: u8 = unsafe { *(self.source + typ.str_offset + i) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 { i = i + 1; }
            else { break; }
        }
        if i >= typ.str_len || unsafe { *(self.source + typ.str_offset + i) } != 59 {
            return false;
        }
        i = i + 1;
        while i < typ.str_len {
            let ch: u8 = unsafe { *(self.source + typ.str_offset + i) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 { i = i + 1; }
            else { break; }
        }
        let count_start: usize = i;
        let mut nonzero: bool = false;
        while i < typ.str_len {
            let ch: u8 = unsafe { *(self.source + typ.str_offset + i) };
            if ch >= 48 && ch <= 57 {
                if ch != 48 { nonzero = true; }
                i = i + 1;
            } else {
                break;
            }
        }
        let type_count_len: usize = i - count_start;
        if type_count_len == 0 || !nonzero {
            return false;
        }
        while i < typ.str_len {
            let ch: u8 = unsafe { *(self.source + typ.str_offset + i) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 { i = i + 1; }
            else { break; }
        }
        if i >= typ.str_len || unsafe { *(self.source + typ.str_offset + i) } != 93 {
            return false;
        }
        i = i + 1;
        while i < typ.str_len {
            let ch: u8 = unsafe { *(self.source + typ.str_offset + i) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 { i = i + 1; }
            else { return false; }
        }

        return self.source_slices_equal(
            typ.str_offset + count_start,
            type_count_len,
            count.str_offset,
            count.str_len
        );
    }

    pub fn type_ref_matches_struct_literal(
        self: &Self,
        type_index: usize,
        literal_index: usize
    ) -> bool {
        if !self.valid_node(type_index) || !self.valid_node(literal_index) {
            return false;
        }
        let typ: AstNode = unsafe { *(self.nodes + type_index) };
        let literal: AstNode = unsafe { *(self.nodes + literal_index) };
        if typ.kind != AstKind::TypeRef || literal.kind != AstKind::ExprStructLiteral
            || typ.str_len == 0 || literal.str_len == 0 {
            return false;
        }
        return self.source_slices_equal(
            typ.str_offset,
            typ.str_len,
            literal.str_offset,
            literal.str_len
        );
    }

    pub fn emit_expression_for_type(
        mut self: &mut Self,
        index: usize,
        type_index: usize
    ) -> bool {
        if !self.valid_node(index) || !self.valid_node(type_index) {
            return false;
        }
        let node: AstNode = unsafe { *(self.nodes + index) };
        if node.kind == AstKind::ExprStructLiteral {
            if !self.type_ref_matches_struct_literal(type_index, index) {
                return false;
            }
            return self.emit_struct_literal(index);
        }
        if node.kind == AstKind::ExprArrayRepeat {
            if !self.fixed_array_type_matches_zero_repeat(type_index, index) {
                return false;
            }
            return self.write_str("{0}", 3);
        }
        return self.emit_expression(index);
    }

    pub fn emit_struct_literal(
        mut self: &mut Self,
        literal_index: usize
    ) -> bool {
        if !self.struct_literal_shape_valid(literal_index) {
            return false;
        }
        let literal: AstNode = unsafe { *(self.nodes + literal_index) };
        let struct_index: usize = self.find_struct_decl_for_literal(literal_index);
        if struct_index == 0 {
            return false;
        }

        if !self.write_byte(40)
            || !self.write_source_slice(literal.str_offset, literal.str_len)
            || !self.write_str("){ ", 3) {
            return false;
        }

        let mut init_index: usize = literal.first_child;
        let mut first: bool = true;
        while init_index != 0 {
            if !self.valid_node(init_index) {
                return false;
            }
            let init: AstNode = unsafe { *(self.nodes + init_index) };
            let field_index: usize = self.find_struct_field_decl(
                struct_index, init_index
            );
            if field_index == 0 || !self.valid_node(init.first_child) {
                return false;
            }
            let field: AstNode = unsafe { *(self.nodes + field_index) };
            let type_index: usize = field.first_child;
            let value_index: usize = init.first_child;

            if !first && !self.write_str(", ", 2) {
                return false;
            }
            if !self.write_byte(46)
                || !self.write_source_slice(init.str_offset, init.str_len)
                || !self.write_str(" = ", 3) {
                return false;
            }
            if !self.emit_expression_for_type(value_index, type_index) {
                return false;
            }

            first = false;
            init_index = init.next_sibling;
        }
        return self.write_str(" }", 2);
    }

    pub fn emit_expression(mut self: &mut Self, index: usize) -> bool {
        if !self.valid_node(index) {
            return false;
        }
        let node: AstNode = unsafe { *(self.nodes + index) };

        if node.kind == AstKind::ExprIdent || node.kind == AstKind::ExprLiteral {
            return self.write_source_slice(node.str_offset, node.str_len);
        }

        if node.kind == AstKind::ExprStructLiteral {
            return self.emit_struct_literal(index);
        }
        if node.kind == AstKind::ExprArrayRepeat {
            // Array repeat requires a declared target type so count and element
            // semantics cannot be invented by the backend.
            return false;
        }

        if node.kind == AstKind::ExprPath {
            // A path is only lowerable when used as the callee of a validated
            // static impl call. Standalone qualified values remain fail-closed.
            return false;
        }

        if node.kind == AstKind::TryExpr {
            // Parsing and context validation are intentionally separate from
            // lowering. Until Result<T,E> has a native C11 ABI, emitting '?'
            // would invent semantics, so this path remains fail-closed.
            if !self.try_context_returns_result(index) {
                return false;
            }
            return false;
        }

        if node.kind == AstKind::ExprUnary {
            if node.first_child == 0 || !self.valid_node(node.first_child) {
                return false;
            }
            if !self.emit_unary_operator(node.int_value) {
                return false;
            }
            return self.emit_expression(node.first_child);
        }

        if node.kind == AstKind::ExprBinary {
            let left: usize = node.first_child;
            if !self.valid_node(left) {
                return false;
            }
            let left_node: AstNode = unsafe { *(self.nodes + left) };
            let right: usize = left_node.next_sibling;
            if !self.valid_node(right) {
                return false;
            }
            if !self.write_byte(40) { return false; }
            if !self.emit_expression(left) { return false; }
            if !self.write_byte(32) { return false; }
            if !self.emit_binary_operator(node.int_value) { return false; }
            if !self.write_byte(32) { return false; }
            if !self.emit_expression(right) { return false; }
            return self.write_byte(41);
        }

        if node.kind == AstKind::ExprCall {
            let callee: usize = node.first_child;
            if !self.valid_node(callee) {
                return false;
            }
            let callee_node: AstNode = unsafe { *(self.nodes + callee) };
            if callee_node.kind == AstKind::ExprPath {
                let method_index: usize = self.find_static_impl_method_for_path(callee);
                if method_index == 0
                    || self.static_impl_method_has_receiver(method_index)
                    || !self.emit_static_impl_symbol(method_index) {
                    return false;
                }
            } else if !self.emit_expression(callee) {
                return false;
            }
            if !self.write_byte(40) { return false; }

            let mut arg: usize = callee_node.next_sibling;
            let mut first: bool = true;
            while arg != 0 {
                if !self.valid_node(arg) {
                    return false;
                }
                if !first {
                    if !self.write_byte(44) || !self.write_byte(32) {
                        return false;
                    }
                }
                if !self.emit_expression(arg) {
                    return false;
                }
                let arg_node: AstNode = unsafe { *(self.nodes + arg) };
                arg = arg_node.next_sibling;
                first = false;
            }
            return self.write_byte(41);
        }

        return false;
    }

    pub fn emit_statement_payload(mut self: &mut Self, index: usize) -> bool {
        if !self.valid_node(index) {
            return false;
        }
        let node: AstNode = unsafe { *(self.nodes + index) };

        if node.kind == AstKind::AssignStmt {
            let left: usize = node.first_child;
            if !self.valid_node(left) {
                return false;
            }
            let left_node: AstNode = unsafe { *(self.nodes + left) };
            let right: usize = left_node.next_sibling;
            if !self.valid_node(right) {
                return false;
            }
            if !self.emit_expression(left) { return false; }
            if !self.write_str(" = ", 3) { return false; }
            if !self.emit_expression(right) { return false; }
            return self.write_str(";\n", 2);
        }

        if node.kind == AstKind::ExprCall
            || node.kind == AstKind::ExprBinary
            || node.kind == AstKind::ExprUnary
            || node.kind == AstKind::ExprIdent
            || node.kind == AstKind::ExprLiteral {
            if !self.emit_expression(index) {
                return false;
            }
            return self.write_str(";\n", 2);
        }

        return false;
    }

    pub fn emit_defer_payload(mut self: &mut Self, index: usize) -> bool {
        if !self.valid_node(index) {
            return false;
        }
        let node: AstNode = unsafe { *(self.nodes + index) };
        if node.kind != AstKind::DeferStmt || node.first_child == 0 {
            return false;
        }

        let payload_index: usize = node.first_child;
        if !self.valid_node(payload_index) {
            return false;
        }
        let payload: AstNode = unsafe { *(self.nodes + payload_index) };

        if payload.kind == AstKind::Block {
            return self.emit_braced_block(payload_index);
        }
        return self.emit_statement_payload(payload_index);
    }

    pub fn emit_defer_chain_lifo(mut self: &mut Self, index: usize) -> bool {
        if index == 0 {
            return true;
        }
        if !self.valid_node(index) {
            return false;
        }

        let node: AstNode = unsafe { *(self.nodes + index) };

        // Walk to the end of the lexical sibling chain first so defers are
        // emitted in reverse registration order when this scope closes.
        if !self.emit_defer_chain_lifo(node.next_sibling) {
            return false;
        }

        if node.kind == AstKind::DeferStmt {
            return self.emit_defer_payload(index);
        }
        return true;
    }

    pub fn emit_block_exit_defers(
        mut self: &mut Self,
        block_index: usize
    ) -> bool {
        if !self.valid_node(block_index) {
            return false;
        }
        let block: AstNode = unsafe { *(self.nodes + block_index) };
        if block.kind != AstKind::Block {
            return false;
        }
        return self.emit_defer_chain_lifo(block.first_child);
    }

    pub fn emit_defer_prefix_lifo(
        mut self: &mut Self,
        index: usize,
        stop_before: usize
    ) -> bool {
        if index == stop_before {
            return true;
        }
        if index == 0 {
            return stop_before == 0;
        }
        if !self.valid_node(index) {
            return false;
        }

        let node: AstNode = unsafe { *(self.nodes + index) };
        if !self.emit_defer_prefix_lifo(node.next_sibling, stop_before) {
            return false;
        }
        if node.kind == AstKind::DeferStmt {
            return self.emit_defer_payload(index);
        }
        return true;
    }

    pub fn emit_scope_defers_before(
        mut self: &mut Self,
        block_index: usize,
        stop_before: usize
    ) -> bool {
        if !self.valid_node(block_index) || !self.valid_node(stop_before) {
            return false;
        }
        let block: AstNode = unsafe { *(self.nodes + block_index) };
        let stop: AstNode = unsafe { *(self.nodes + stop_before) };
        if block.kind != AstKind::Block || stop.parent != block_index {
            return false;
        }
        return self.emit_defer_prefix_lifo(block.first_child, stop_before);
    }

    pub fn emit_function_exit_defers(
        mut self: &mut Self,
        exit_index: usize
    ) -> bool {
        if !self.valid_node(exit_index) {
            return false;
        }
        let exit_node: AstNode = unsafe { *(self.nodes + exit_index) };

        let mut child_on_path: usize = exit_index;
        let mut parent_index: usize = exit_node.parent;

        while parent_index != 0 {
            if !self.valid_node(parent_index) {
                return false;
            }
            let parent_node: AstNode = unsafe { *(self.nodes + parent_index) };

            if parent_node.kind == AstKind::Block {
                if !self.emit_scope_defers_before(parent_index, child_on_path) {
                    return false;
                }
            } else if parent_node.kind == AstKind::FnDecl
                || parent_node.kind == AstKind::TrapfnDecl {
                return true;
            }

            child_on_path = parent_index;
            parent_index = parent_node.parent;
        }

        return false;
    }

    pub fn emit_return_scope_defers(
        mut self: &mut Self,
        return_index: usize
    ) -> bool {
        if !self.valid_node(return_index) {
            return false;
        }
        let return_node: AstNode = unsafe { *(self.nodes + return_index) };
        if return_node.kind != AstKind::ReturnStmt {
            return false;
        }
        return self.emit_function_exit_defers(return_index);
    }

    pub fn emit_loop_jump_scope_defers(
        mut self: &mut Self,
        jump_index: usize
    ) -> bool {
        if !self.valid_node(jump_index) {
            return false;
        }
        let jump: AstNode = unsafe { *(self.nodes + jump_index) };
        if jump.kind != AstKind::BreakStmt
            && jump.kind != AstKind::ContinueStmt {
            return false;
        }

        let mut child_on_path: usize = jump_index;
        let mut parent_index: usize = jump.parent;

        while parent_index != 0 {
            if !self.valid_node(parent_index) {
                return false;
            }
            let parent_node: AstNode = unsafe { *(self.nodes + parent_index) };

            if parent_node.kind == AstKind::Block {
                if !self.emit_scope_defers_before(parent_index, child_on_path) {
                    return false;
                }
            } else if parent_node.kind == AstKind::WhileStmt {
                return true;
            } else if parent_node.kind == AstKind::FnDecl
                || parent_node.kind == AstKind::TrapfnDecl {
                // A loop jump outside a loop is structurally invalid.
                return false;
            }

            child_on_path = parent_index;
            parent_index = parent_node.parent;
        }

        return false;
    }

    pub fn emit_loop_jump_statement(
        mut self: &mut Self,
        jump_index: usize
    ) -> bool {
        if !self.valid_node(jump_index) {
            return false;
        }
        let jump: AstNode = unsafe { *(self.nodes + jump_index) };
        if jump.kind != AstKind::BreakStmt
            && jump.kind != AstKind::ContinueStmt {
            return false;
        }

        if !self.emit_loop_jump_scope_defers(jump_index) {
            return false;
        }
        if jump.kind == AstKind::BreakStmt {
            return self.write_str("break;\n", 7);
        }
        return self.write_str("continue;\n", 10);
    }

    pub fn source_slice_equals(
        self: &Self,
        offset: usize,
        len: usize,
        expected: *const u8,
        expected_len: usize
    ) -> bool {
        if self.source == null || expected == null || len != expected_len {
            return false;
        }
        if offset > self.source_len || len > self.source_len - offset {
            return false;
        }
        let mut i: usize = 0;
        while i < len {
            let a: u8 = unsafe { *(self.source + offset + i) };
            let b: u8 = unsafe { *(expected + i) };
            if a != b {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    pub fn source_slice_equals_compact(
        self: &Self,
        offset: usize,
        len: usize,
        expected: *const u8,
        expected_len: usize
    ) -> bool {
        if self.source == null || expected == null {
            return false;
        }
        if offset > self.source_len || len > self.source_len - offset {
            return false;
        }

        let mut source_i: usize = 0;
        let mut expected_i: usize = 0;
        while source_i < len {
            let ch: u8 = unsafe { *(self.source + offset + source_i) };
            source_i = source_i + 1;
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                continue;
            }
            if expected_i >= expected_len {
                return false;
            }
            let want: u8 = unsafe { *(expected + expected_i) };
            if ch != want {
                return false;
            }
            expected_i = expected_i + 1;
        }
        return expected_i == expected_len;
    }

    pub fn result_constructor_kind(self: &Self, call_index: usize) -> i64 {
        if !self.valid_node(call_index) {
            return 0;
        }
        let call: AstNode = unsafe { *(self.nodes + call_index) };
        if call.kind != AstKind::ExprCall || !self.valid_node(call.first_child) {
            return 0;
        }
        let callee: AstNode = unsafe { *(self.nodes + call.first_child) };
        if callee.kind != AstKind::ExprPath || callee.str_len == 0 {
            return 0;
        }
        if self.source_slice_equals_compact(
            callee.str_offset,
            callee.str_len,
            "Result::ok",
            10
        ) || self.source_slice_equals_compact(
            callee.str_offset,
            callee.str_len,
            "Result::Ok",
            10
        ) {
            return 1;
        }
        if self.source_slice_equals_compact(
            callee.str_offset,
            callee.str_len,
            "Result::err",
            11
        ) || self.source_slice_equals_compact(
            callee.str_offset,
            callee.str_len,
            "Result::Err",
            11
        ) {
            return 2;
        }
        return 0;
    }

    pub fn emit_result_u64_constructor(
        mut self: &mut Self,
        call_index: usize
    ) -> bool {
        let kind: i64 = self.result_constructor_kind(call_index);
        if kind == 0 || !self.valid_node(call_index) {
            return false;
        }
        let call: AstNode = unsafe { *(self.nodes + call_index) };
        let callee: AstNode = unsafe { *(self.nodes + call.first_child) };
        let arg_index: usize = callee.next_sibling;
        if !self.valid_node(arg_index) {
            return false;
        }
        let arg: AstNode = unsafe { *(self.nodes + arg_index) };
        if arg.next_sibling != 0 {
            return false;
        }

        if kind == 1 {
            if !self.write_str("(SotlasResultU64I32){ .is_ok = true, .payload.ok = ", 51) {
                return false;
            }
            if !self.emit_expression(arg_index) {
                return false;
            }
            return self.write_str(" }", 2);
        }

        if !self.write_str("(SotlasResultU64I32){ .is_ok = false, .payload.err = ", 53) {
            return false;
        }
        if !self.emit_expression(arg_index) {
            return false;
        }
        return self.write_str(" }", 2);
    }

    pub fn source_slices_equal(
        self: &Self,
        left_offset: usize,
        left_len: usize,
        right_offset: usize,
        right_len: usize
    ) -> bool {
        if self.source == null || left_len != right_len {
            return false;
        }
        if left_offset > self.source_len || left_len > self.source_len - left_offset {
            return false;
        }
        if right_offset > self.source_len || right_len > self.source_len - right_offset {
            return false;
        }

        let mut i: usize = 0;
        while i < left_len {
            let a: u8 = unsafe { *(self.source + left_offset + i) };
            let b: u8 = unsafe { *(self.source + right_offset + i) };
            if a != b {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    pub fn impl_target_is_declared(
        self: &Self,
        module_index: usize,
        impl_index: usize
    ) -> bool {
        if !self.valid_node(module_index) || !self.valid_node(impl_index) {
            return false;
        }
        let module_node: AstNode = unsafe { *(self.nodes + module_index) };
        let impl_node: AstNode = unsafe { *(self.nodes + impl_index) };
        if module_node.kind != AstKind::Module || impl_node.kind != AstKind::ImplDecl
            || impl_node.str_len == 0 {
            return false;
        }

        let mut child: usize = module_node.first_child;
        while child != 0 {
            if !self.valid_node(child) {
                return false;
            }
            let candidate: AstNode = unsafe { *(self.nodes + child) };
            if (candidate.kind == AstKind::StructDecl || candidate.kind == AstKind::EnumDecl)
                && candidate.str_len != 0
                && self.source_slices_equal(
                    candidate.str_offset,
                    candidate.str_len,
                    impl_node.str_offset,
                    impl_node.str_len
                ) {
                return true;
            }
            child = candidate.next_sibling;
        }
        return false;
    }

    pub fn static_method_is_unique(
        self: &Self,
        module_index: usize,
        impl_index: usize,
        method_index: usize
    ) -> bool {
        if !self.valid_node(module_index) || !self.valid_node(impl_index)
            || !self.valid_node(method_index) {
            return false;
        }
        let module_node: AstNode = unsafe { *(self.nodes + module_index) };
        let impl_node: AstNode = unsafe { *(self.nodes + impl_index) };
        let method: AstNode = unsafe { *(self.nodes + method_index) };
        if module_node.kind != AstKind::Module || impl_node.kind != AstKind::ImplDecl
            || method.kind != AstKind::FnDecl || method.parent != impl_index
            || impl_node.str_len == 0 || method.str_len == 0 {
            return false;
        }

        let mut declaration_index: usize = module_node.first_child;
        while declaration_index != 0 {
            if !self.valid_node(declaration_index) {
                return false;
            }
            let declaration: AstNode = unsafe { *(self.nodes + declaration_index) };
            if declaration.kind == AstKind::ImplDecl && declaration.str_len != 0
                && self.source_slices_equal(
                    declaration.str_offset,
                    declaration.str_len,
                    impl_node.str_offset,
                    impl_node.str_len
                ) {
                let mut candidate_index: usize = declaration.first_child;
                while candidate_index != 0 {
                    if !self.valid_node(candidate_index) {
                        return false;
                    }
                    let candidate: AstNode = unsafe { *(self.nodes + candidate_index) };
                    if candidate_index != method_index
                        && candidate.kind == AstKind::FnDecl
                        && candidate.str_len != 0
                        && self.source_slices_equal(
                            candidate.str_offset,
                            candidate.str_len,
                            method.str_offset,
                            method.str_len
                        ) {
                        return false;
                    }
                    candidate_index = candidate.next_sibling;
                }
            }
            declaration_index = declaration.next_sibling;
        }
        return true;
    }

    pub fn path_matches_static_method(
        self: &Self,
        path_index: usize,
        impl_index: usize,
        method_index: usize
    ) -> bool {
        if !self.valid_node(path_index) || !self.valid_node(impl_index)
            || !self.valid_node(method_index) || self.source == null {
            return false;
        }
        let path: AstNode = unsafe { *(self.nodes + path_index) };
        let impl_node: AstNode = unsafe { *(self.nodes + impl_index) };
        let method: AstNode = unsafe { *(self.nodes + method_index) };
        if path.kind != AstKind::ExprPath || path.str_len == 0
            || impl_node.kind != AstKind::ImplDecl || impl_node.str_len == 0
            || method.kind != AstKind::FnDecl || method.str_len == 0
            || method.parent != impl_index
            || path.str_offset > self.source_len
            || path.str_len > self.source_len - path.str_offset {
            return false;
        }

        let mut first: usize = 0;
        while first < path.str_len {
            let ch: u8 = unsafe { *(self.source + path.str_offset + first) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                first = first + 1;
            } else {
                break;
            }
        }

        let mut separator: usize = first;
        let mut found_separator: bool = false;
        while separator + 1 < path.str_len {
            let left: u8 = unsafe { *(self.source + path.str_offset + separator) };
            let right: u8 = unsafe { *(self.source + path.str_offset + separator + 1) };
            if left == 58 && right == 58 {
                found_separator = true;
                break;
            }
            separator = separator + 1;
        }
        if !found_separator || separator <= first {
            return false;
        }

        let mut target_end: usize = separator;
        while target_end > first {
            let ch: u8 = unsafe { *(self.source + path.str_offset + target_end - 1) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                target_end = target_end - 1;
            } else {
                break;
            }
        }
        if target_end <= first {
            return false;
        }

        let mut method_start: usize = separator + 2;
        while method_start < path.str_len {
            let ch: u8 = unsafe { *(self.source + path.str_offset + method_start) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                method_start = method_start + 1;
            } else {
                break;
            }
        }

        let mut method_end: usize = path.str_len;
        while method_end > method_start {
            let ch: u8 = unsafe { *(self.source + path.str_offset + method_end - 1) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                method_end = method_end - 1;
            } else {
                break;
            }
        }
        if method_end <= method_start {
            return false;
        }

        let mut scan: usize = method_start;
        while scan + 1 < method_end {
            let left: u8 = unsafe { *(self.source + path.str_offset + scan) };
            let right: u8 = unsafe { *(self.source + path.str_offset + scan + 1) };
            if left == 58 && right == 58 {
                return false;
            }
            scan = scan + 1;
        }

        return self.source_slices_equal(
            path.str_offset + first,
            target_end - first,
            impl_node.str_offset,
            impl_node.str_len
        ) && self.source_slices_equal(
            path.str_offset + method_start,
            method_end - method_start,
            method.str_offset,
            method.str_len
        );
    }

    pub fn find_static_impl_method_for_path(
        self: &Self,
        path_index: usize
    ) -> usize {
        if !self.valid_node(path_index) {
            return 0;
        }
        let module_index: usize = self.find_enclosing_module(path_index);
        if !self.valid_node(module_index) {
            return 0;
        }
        let module_node: AstNode = unsafe { *(self.nodes + module_index) };
        if module_node.kind != AstKind::Module {
            return 0;
        }

        let mut found: usize = 0;
        let mut declaration_index: usize = module_node.first_child;
        while declaration_index != 0 {
            if !self.valid_node(declaration_index) {
                return 0;
            }
            let declaration: AstNode = unsafe { *(self.nodes + declaration_index) };
            if declaration.kind == AstKind::ImplDecl
                && self.impl_target_is_declared(module_index, declaration_index) {
                let mut method_index: usize = declaration.first_child;
                while method_index != 0 {
                    if !self.valid_node(method_index) {
                        return 0;
                    }
                    let method: AstNode = unsafe { *(self.nodes + method_index) };
                    if method.kind == AstKind::FnDecl
                        && self.static_method_is_unique(
                            module_index, declaration_index, method_index
                        )
                        && self.path_matches_static_method(
                            path_index, declaration_index, method_index
                        ) {
                        if found != 0 {
                            return 0;
                        }
                        found = method_index;
                    }
                    method_index = method.next_sibling;
                }
            }
            declaration_index = declaration.next_sibling;
        }
        return found;
    }

    pub fn static_impl_method_has_receiver(
        self: &Self,
        method_index: usize
    ) -> bool {
        if !self.valid_node(method_index) {
            return true;
        }
        let method: AstNode = unsafe { *(self.nodes + method_index) };
        if method.kind != AstKind::FnDecl {
            return true;
        }
        let mut child: usize = method.first_child;
        while child != 0 {
            if !self.valid_node(child) {
                return true;
            }
            let node: AstNode = unsafe { *(self.nodes + child) };
            if node.kind == AstKind::ParamDecl
                && self.source_slice_equals(node.str_offset, node.str_len, "self", 4) {
                return true;
            }
            child = node.next_sibling;
        }
        return false;
    }

    pub fn emit_static_impl_symbol(
        mut self: &mut Self,
        method_index: usize
    ) -> bool {
        if !self.valid_node(method_index) {
            return false;
        }
        let method: AstNode = unsafe { *(self.nodes + method_index) };
        let impl_index: usize = method.parent;
        if method.kind != AstKind::FnDecl || method.str_len == 0
            || !self.valid_node(impl_index) {
            return false;
        }
        let impl_node: AstNode = unsafe { *(self.nodes + impl_index) };
        let module_index: usize = impl_node.parent;
        if impl_node.kind != AstKind::ImplDecl || impl_node.str_len == 0
            || !self.valid_node(module_index)
            || !self.impl_target_is_declared(module_index, impl_index) {
            return false;
        }
        return self.write_source_slice(impl_node.str_offset, impl_node.str_len)
            && self.write_byte(95)
            && self.write_source_slice(method.str_offset, method.str_len);
    }

    pub fn find_enclosing_module(self: &Self, index: usize) -> usize {
        if !self.valid_node(index) {
            return 0;
        }
        let mut current: usize = index;
        while current != 0 {
            if !self.valid_node(current) {
                return 0;
            }
            let node: AstNode = unsafe { *(self.nodes + current) };
            if node.kind == AstKind::Module {
                return current;
            }
            current = node.parent;
        }
        return 0;
    }

    pub fn find_module_function_by_name(
        self: &Self,
        module_index: usize,
        name_offset: usize,
        name_len: usize
    ) -> usize {
        if !self.valid_node(module_index) {
            return 0;
        }
        let module_node: AstNode = unsafe { *(self.nodes + module_index) };
        if module_node.kind != AstKind::Module {
            return 0;
        }

        let mut child: usize = module_node.first_child;
        while child != 0 {
            if !self.valid_node(child) {
                return 0;
            }
            let node: AstNode = unsafe { *(self.nodes + child) };
            if node.kind == AstKind::FnDecl
                && self.source_slices_equal(
                    node.str_offset,
                    node.str_len,
                    name_offset,
                    name_len
                ) {
                return child;
            }
            child = node.next_sibling;
        }
        return 0;
    }

    pub fn try_call_returns_result_u64_i32(
        self: &Self,
        try_index: usize
    ) -> bool {
        if !self.valid_node(try_index) {
            return false;
        }
        let try_node: AstNode = unsafe { *(self.nodes + try_index) };
        if try_node.kind != AstKind::TryExpr || !self.valid_node(try_node.first_child) {
            return false;
        }

        let call: AstNode = unsafe { *(self.nodes + try_node.first_child) };
        if call.kind != AstKind::ExprCall || !self.valid_node(call.first_child) {
            return false;
        }
        let callee: AstNode = unsafe { *(self.nodes + call.first_child) };
        if callee.kind != AstKind::ExprIdent || callee.str_len == 0 {
            return false;
        }

        let module_index: usize = self.find_enclosing_module(try_index);
        if module_index == 0 {
            return false;
        }
        let fn_index: usize = self.find_module_function_by_name(
            module_index,
            callee.str_offset,
            callee.str_len
        );
        if fn_index == 0 {
            return false;
        }
        let return_type: usize = self.find_function_return_type(fn_index);
        return return_type != 0 && self.type_ref_is_result_u64_i32(return_type);
    }

    pub fn try_context_returns_result_u64_i32(
        self: &Self,
        try_index: usize
    ) -> bool {
        let fn_index: usize = self.find_enclosing_function(try_index);
        if fn_index == 0 {
            return false;
        }
        let return_type: usize = self.find_function_return_type(fn_index);
        return return_type != 0 && self.type_ref_is_result_u64_i32(return_type);
    }

    pub fn type_ref_is_result_u64_i32(self: &Self, type_index: usize) -> bool {
        if !self.valid_node(type_index) {
            return false;
        }
        let typ: AstNode = unsafe { *(self.nodes + type_index) };
        if typ.kind != AstKind::TypeRef || typ.str_len == 0 || self.source == null {
            return false;
        }

        let expected: *const u8 = "Result<u64,i32>";
        let expected_len: usize = 15;
        let mut source_i: usize = 0;
        let mut expected_i: usize = 0;

        while source_i < typ.str_len {
            let ch: u8 = unsafe { *(self.source + typ.str_offset + source_i) };
            source_i = source_i + 1;
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                continue;
            }
            if expected_i >= expected_len {
                return false;
            }
            let want: u8 = unsafe { *(expected + expected_i) };
            if ch != want {
                return false;
            }
            expected_i = expected_i + 1;
        }
        return expected_i == expected_len;
    }

    pub fn type_ref_is_result(self: &Self, type_index: usize) -> bool {
        if !self.valid_node(type_index) {
            return false;
        }
        let typ: AstNode = unsafe { *(self.nodes + type_index) };
        if typ.kind != AstKind::TypeRef || typ.str_len < 8 {
            return false;
        }
        if !self.source_slice_equals(typ.str_offset, 6, "Result", 6) {
            return false;
        }

        let mut i: usize = 6;
        while i < typ.str_len {
            let ch: u8 = unsafe { *(self.source + typ.str_offset + i) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                i = i + 1;
            } else {
                break;
            }
        }
        if i >= typ.str_len {
            return false;
        }
        let open: u8 = unsafe { *(self.source + typ.str_offset + i) };
        if open != 60 {
            return false;
        }

        let mut end: usize = typ.str_len;
        while end > i + 1 {
            let ch: u8 = unsafe { *(self.source + typ.str_offset + end - 1) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                end = end - 1;
            } else {
                break;
            }
        }
        if end <= i + 1 {
            return false;
        }
        let close: u8 = unsafe { *(self.source + typ.str_offset + end - 1) };
        return close == 62;
    }

    pub fn try_context_returns_result(self: &Self, try_index: usize) -> bool {
        if !self.valid_node(try_index) {
            return false;
        }
        let node: AstNode = unsafe { *(self.nodes + try_index) };
        if node.kind != AstKind::TryExpr || node.first_child == 0 {
            return false;
        }

        let fn_index: usize = self.find_enclosing_function(try_index);
        if fn_index == 0 {
            return false;
        }
        let type_index: usize = self.find_function_return_type(fn_index);
        if type_index == 0 {
            return false;
        }
        return self.type_ref_is_result(type_index);
    }

    pub fn type_ref_is_plain_field_type(self: &Self, type_index: usize) -> bool {
        if !self.valid_node(type_index) || self.source == null {
            return false;
        }
        let typ: AstNode = unsafe { *(self.nodes + type_index) };
        if typ.kind != AstKind::TypeRef || typ.str_len == 0 {
            return false;
        }
        if typ.str_offset > self.source_len || typ.str_len > self.source_len - typ.str_offset {
            return false;
        }

        let mut i: usize = 0;
        while i < typ.str_len {
            let ch: u8 = unsafe { *(self.source + typ.str_offset + i) };
            let alpha: bool = (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122);
            let digit: bool = ch >= 48 && ch <= 57;
            if !alpha && !digit && ch != 95 {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    pub fn emit_plain_c_type_slice(
        mut self: &mut Self,
        offset: usize,
        len: usize
    ) -> bool {
        if self.source == null || len == 0 || offset > self.source_len
            || len > self.source_len - offset {
            return false;
        }
        if self.source_slice_equals(offset, len, "void", 4) {
            return false;
        }
        if self.source_slice_equals(offset, len, "i8", 2) {
            return self.write_str("int8_t", 6);
        }
        if self.source_slice_equals(offset, len, "i16", 3) {
            return self.write_str("int16_t", 7);
        }
        if self.source_slice_equals(offset, len, "i32", 3) {
            return self.write_str("int32_t", 7);
        }
        if self.source_slice_equals(offset, len, "i64", 3) {
            return self.write_str("int64_t", 7);
        }
        if self.source_slice_equals(offset, len, "u8", 2) {
            return self.write_str("uint8_t", 7);
        }
        if self.source_slice_equals(offset, len, "u16", 3) {
            return self.write_str("uint16_t", 8);
        }
        if self.source_slice_equals(offset, len, "u32", 3) {
            return self.write_str("uint32_t", 8);
        }
        if self.source_slice_equals(offset, len, "u64", 3) {
            return self.write_str("uint64_t", 8);
        }
        if self.source_slice_equals(offset, len, "usize", 5) {
            return self.write_str("size_t", 6);
        }
        if self.source_slice_equals(offset, len, "isize", 5) {
            return self.write_str("intptr_t", 8);
        }
        if self.source_slice_equals(offset, len, "bool", 4) {
            return self.write_str("bool", 4);
        }
        return self.write_source_slice(offset, len);
    }

    pub fn emit_fixed_array_field(
        mut self: &mut Self,
        field_index: usize,
        type_index: usize
    ) -> bool {
        if !self.valid_node(field_index) || !self.valid_node(type_index)
            || self.source == null {
            return false;
        }
        let field: AstNode = unsafe { *(self.nodes + field_index) };
        let typ: AstNode = unsafe { *(self.nodes + type_index) };
        if field.kind != AstKind::FieldDecl || field.str_len == 0
            || typ.kind != AstKind::TypeRef || typ.str_len < 5
            || typ.str_offset > self.source_len
            || typ.str_len > self.source_len - typ.str_offset {
            return false;
        }

        let mut i: usize = 0;
        while i < typ.str_len {
            let ch: u8 = unsafe { *(self.source + typ.str_offset + i) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                i = i + 1;
            } else {
                break;
            }
        }
        if i >= typ.str_len || unsafe { *(self.source + typ.str_offset + i) } != 91 {
            return false;
        }
        i = i + 1;
        while i < typ.str_len {
            let ch: u8 = unsafe { *(self.source + typ.str_offset + i) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                i = i + 1;
            } else {
                break;
            }
        }

        let element_start: usize = i;
        while i < typ.str_len {
            let ch: u8 = unsafe { *(self.source + typ.str_offset + i) };
            let alpha: bool = (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122);
            let digit: bool = ch >= 48 && ch <= 57;
            if alpha || digit || ch == 95 {
                i = i + 1;
            } else {
                break;
            }
        }
        let element_len: usize = i - element_start;
        if element_len == 0 {
            return false;
        }

        while i < typ.str_len {
            let ch: u8 = unsafe { *(self.source + typ.str_offset + i) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                i = i + 1;
            } else {
                break;
            }
        }
        if i >= typ.str_len || unsafe { *(self.source + typ.str_offset + i) } != 59 {
            return false;
        }
        i = i + 1;
        while i < typ.str_len {
            let ch: u8 = unsafe { *(self.source + typ.str_offset + i) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                i = i + 1;
            } else {
                break;
            }
        }

        let count_start: usize = i;
        let mut nonzero: bool = false;
        while i < typ.str_len {
            let ch: u8 = unsafe { *(self.source + typ.str_offset + i) };
            if ch >= 48 && ch <= 57 {
                if ch != 48 {
                    nonzero = true;
                }
                i = i + 1;
            } else {
                break;
            }
        }
        let count_len: usize = i - count_start;
        if count_len == 0 || !nonzero {
            return false;
        }

        while i < typ.str_len {
            let ch: u8 = unsafe { *(self.source + typ.str_offset + i) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                i = i + 1;
            } else {
                break;
            }
        }
        if i >= typ.str_len || unsafe { *(self.source + typ.str_offset + i) } != 93 {
            return false;
        }
        i = i + 1;
        while i < typ.str_len {
            let ch: u8 = unsafe { *(self.source + typ.str_offset + i) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                i = i + 1;
            } else {
                return false;
            }
        }

        if !self.emit_plain_c_type_slice(typ.str_offset + element_start, element_len)
            || !self.write_byte(32)
            || !self.write_source_slice(field.str_offset, field.str_len)
            || !self.write_byte(91)
            || !self.write_source_slice(typ.str_offset + count_start, count_len)
            || !self.write_str("];\n", 3) {
            return false;
        }
        return true;
    }

    pub fn emit_c_type(mut self: &mut Self, type_index: usize) -> bool {
        if !self.valid_node(type_index) {
            return false;
        }
        let typ: AstNode = unsafe { *(self.nodes + type_index) };
        if typ.kind != AstKind::TypeRef || typ.str_len == 0 {
            return false;
        }

        // Result<T,E> requires its own ABI lowering. Never leak the Sotlas
        // generic spelling into C11 as though it were a valid C type.
        if self.type_ref_is_result_u64_i32(type_index) {
            return self.write_str("SotlasResultU64I32", 18);
        }
        if self.type_ref_is_result(type_index) {
            return false;
        }

        if self.source_slice_equals(typ.str_offset, typ.str_len, "i8", 2) {
            return self.write_str("int8_t", 6);
        }
        if self.source_slice_equals(typ.str_offset, typ.str_len, "i16", 3) {
            return self.write_str("int16_t", 7);
        }
        if self.source_slice_equals(typ.str_offset, typ.str_len, "i32", 3) {
            return self.write_str("int32_t", 7);
        }
        if self.source_slice_equals(typ.str_offset, typ.str_len, "i64", 3) {
            return self.write_str("int64_t", 7);
        }
        if self.source_slice_equals(typ.str_offset, typ.str_len, "u8", 2) {
            return self.write_str("uint8_t", 7);
        }
        if self.source_slice_equals(typ.str_offset, typ.str_len, "u16", 3) {
            return self.write_str("uint16_t", 8);
        }
        if self.source_slice_equals(typ.str_offset, typ.str_len, "u32", 3) {
            return self.write_str("uint32_t", 8);
        }
        if self.source_slice_equals(typ.str_offset, typ.str_len, "u64", 3) {
            return self.write_str("uint64_t", 8);
        }
        if self.source_slice_equals(typ.str_offset, typ.str_len, "usize", 5) {
            return self.write_str("size_t", 6);
        }
        if self.source_slice_equals(typ.str_offset, typ.str_len, "isize", 5) {
            return self.write_str("intptr_t", 8);
        }
        if self.source_slice_equals(typ.str_offset, typ.str_len, "bool", 4) {
            return self.write_str("bool", 4);
        }
        if self.source_slice_equals(typ.str_offset, typ.str_len, "void", 4) {
            return self.write_str("void", 4);
        }

        // Named user types remain source-named until native type lowering is
        // introduced. Composite pointer/generic types are intentionally not
        // claimed as complete by this helper.
        return self.write_source_slice(typ.str_offset, typ.str_len);
    }

    pub fn find_enclosing_function(self: &Self, index: usize) -> usize {
        if !self.valid_node(index) {
            return 0;
        }
        let mut current: usize = index;
        while current != 0 {
            if !self.valid_node(current) {
                return 0;
            }
            let node: AstNode = unsafe { *(self.nodes + current) };
            if node.kind == AstKind::FnDecl || node.kind == AstKind::TrapfnDecl {
                return current;
            }
            current = node.parent;
        }
        return 0;
    }

    pub fn find_function_return_type(self: &Self, fn_index: usize) -> usize {
        if !self.valid_node(fn_index) {
            return 0;
        }
        let function_node: AstNode = unsafe { *(self.nodes + fn_index) };
        if function_node.kind != AstKind::FnDecl
            && function_node.kind != AstKind::TrapfnDecl {
            return 0;
        }

        let mut child: usize = function_node.first_child;
        while child != 0 {
            if !self.valid_node(child) {
                return 0;
            }
            let node: AstNode = unsafe { *(self.nodes + child) };
            if node.kind == AstKind::TypeRef {
                return child;
            }
            child = node.next_sibling;
        }
        return 0;
    }

    pub fn emit_return_statement(
        mut self: &mut Self,
        return_index: usize
    ) -> bool {
        if !self.valid_node(return_index) {
            return false;
        }
        let ret: AstNode = unsafe { *(self.nodes + return_index) };
        if ret.kind != AstKind::ReturnStmt {
            return false;
        }

        if ret.first_child == 0 {
            if !self.emit_return_scope_defers(return_index) {
                return false;
            }
            return self.write_str("return;\n", 8);
        }

        let fn_index: usize = self.find_enclosing_function(return_index);
        if fn_index == 0 {
            return false;
        }
        let type_index: usize = self.find_function_return_type(fn_index);
        if type_index == 0 {
            return false;
        }

        // The nested C block gives every return site its own temporary scope.
        if !self.write_str("{\n", 2) {
            return false;
        }
        if !self.emit_c_type(type_index) {
            return false;
        }
        if !self.write_str(" __sotlas_return_value = ", 25) {
            return false;
        }

        // Normative defer rule: evaluate and capture the return expression
        // before any active cleanup can mutate referenced state.
        let ret_expr: AstNode = unsafe { *(self.nodes + ret.first_child) };
        if self.type_ref_is_result_u64_i32(type_index)
            && ret_expr.kind == AstKind::ExprCall
            && self.result_constructor_kind(ret.first_child) != 0 {
            if !self.emit_result_u64_constructor(ret.first_child) {
                return false;
            }
        } else if !self.emit_expression_for_type(ret.first_child, type_index) {
            return false;
        }
        if !self.write_str(";\n", 2) {
            return false;
        }
        if !self.emit_return_scope_defers(return_index) {
            return false;
        }
        return self.write_str("return __sotlas_return_value;\n}\n", 32);
    }

    pub fn find_function_body(self: &Self, fn_index: usize) -> usize {
        if !self.valid_node(fn_index) {
            return 0;
        }
        let function_node: AstNode = unsafe { *(self.nodes + fn_index) };
        if function_node.kind != AstKind::FnDecl {
            return 0;
        }

        let mut child: usize = function_node.first_child;
        while child != 0 {
            if !self.valid_node(child) {
                return 0;
            }
            let node: AstNode = unsafe { *(self.nodes + child) };
            if node.kind == AstKind::Block {
                return child;
            }
            child = node.next_sibling;
        }
        return 0;
    }

    pub fn emit_parameter(mut self: &mut Self, param_index: usize) -> bool {
        if !self.valid_node(param_index) {
            return false;
        }
        let param: AstNode = unsafe { *(self.nodes + param_index) };
        if param.kind != AstKind::ParamDecl || param.str_len == 0 {
            return false;
        }

        let type_index: usize = param.first_child;
        if !self.valid_node(type_index) {
            return false;
        }
        let typ: AstNode = unsafe { *(self.nodes + type_index) };
        if typ.kind != AstKind::TypeRef {
            return false;
        }

        if !self.emit_c_type(type_index) {
            return false;
        }
        if !self.write_byte(32) {
            return false;
        }
        return self.write_source_slice(param.str_offset, param.str_len);
    }

    pub fn emit_enum(mut self: &mut Self, enum_index: usize) -> bool {
        if !self.valid_node(enum_index) {
            return false;
        }
        let decl: AstNode = unsafe { *(self.nodes + enum_index) };
        if decl.kind != AstKind::EnumDecl || decl.str_len == 0 || decl.first_child == 0 {
            return false;
        }

        if !self.write_str("typedef enum ", 13) {
            return false;
        }
        if !self.write_source_slice(decl.str_offset, decl.str_len) {
            return false;
        }
        if !self.write_str(" {\n", 3) {
            return false;
        }

        let mut variant_index: usize = decl.first_child;
        while variant_index != 0 {
            if !self.valid_node(variant_index) {
                return false;
            }
            let variant: AstNode = unsafe { *(self.nodes + variant_index) };
            if variant.kind != AstKind::EnumVariant || variant.str_len == 0
                || !self.valid_node(variant.first_child) {
                return false;
            }
            let value_index: usize = variant.first_child;
            let value: AstNode = unsafe { *(self.nodes + value_index) };
            if value.kind != AstKind::ExprLiteral || value.next_sibling != 0 {
                return false;
            }

            if !self.write_source_slice(decl.str_offset, decl.str_len) {
                return false;
            }
            if !self.write_byte(95) {
                return false;
            }
            if !self.write_source_slice(variant.str_offset, variant.str_len) {
                return false;
            }
            if !self.write_str(" = ", 3) {
                return false;
            }
            if !self.emit_expression(value_index) {
                return false;
            }

            variant_index = variant.next_sibling;
            if variant_index != 0 {
                if !self.write_str(",\n", 2) {
                    return false;
                }
            } else if !self.write_byte(10) {
                return false;
            }
        }

        if !self.write_str("} ", 2) {
            return false;
        }
        if !self.write_source_slice(decl.str_offset, decl.str_len) {
            return false;
        }
        return self.write_str(";\n", 2);
    }

    pub fn emit_struct(mut self: &mut Self, struct_index: usize) -> bool {
        if !self.valid_node(struct_index) {
            return false;
        }
        let decl: AstNode = unsafe { *(self.nodes + struct_index) };
        if decl.kind != AstKind::StructDecl || decl.str_len == 0 || decl.first_child == 0 {
            return false;
        }

        if !self.write_str("typedef struct ", 15) {
            return false;
        }
        if !self.write_source_slice(decl.str_offset, decl.str_len) {
            return false;
        }
        if !self.write_str(" {\n", 3) {
            return false;
        }

        let mut field_index: usize = decl.first_child;
        while field_index != 0 {
            if !self.valid_node(field_index) {
                return false;
            }
            let field: AstNode = unsafe { *(self.nodes + field_index) };
            if field.kind != AstKind::FieldDecl || field.str_len == 0
                || !self.valid_node(field.first_child) {
                return false;
            }
            let type_index: usize = field.first_child;
            let typ: AstNode = unsafe { *(self.nodes + type_index) };
            if typ.kind != AstKind::TypeRef || typ.next_sibling != 0 {
                return false;
            }

            if self.type_ref_is_plain_field_type(type_index) {
                if !self.emit_c_type(type_index) || !self.write_byte(32) {
                    return false;
                }
                if !self.write_source_slice(field.str_offset, field.str_len) {
                    return false;
                }
                if !self.write_str(";\n", 2) {
                    return false;
                }
            } else if !self.emit_fixed_array_field(field_index, type_index) {
                return false;
            }
            field_index = field.next_sibling;
        }

        if !self.write_str("} ", 2) {
            return false;
        }
        if !self.write_source_slice(decl.str_offset, decl.str_len) {
            return false;
        }
        return self.write_str(";\n", 2);
    }

    pub fn emit_function(mut self: &mut Self, fn_index: usize) -> bool {
        if !self.valid_node(fn_index) {
            return false;
        }
        let function_node: AstNode = unsafe { *(self.nodes + fn_index) };
        if function_node.kind != AstKind::FnDecl || function_node.str_len == 0 {
            return false;
        }

        let return_type: usize = self.find_function_return_type(fn_index);
        if return_type == 0 {
            if !self.write_str("void", 4) {
                return false;
            }
        } else if !self.emit_c_type(return_type) {
            return false;
        }

        if !self.write_byte(32) {
            return false;
        }

        if function_node.parent != 0 && self.valid_node(function_node.parent) {
            let parent: AstNode = unsafe { *(self.nodes + function_node.parent) };
            if parent.kind == AstKind::ImplDecl {
                if self.static_impl_method_has_receiver(fn_index)
                    || !self.emit_static_impl_symbol(fn_index) {
                    return false;
                }
            } else if !self.write_source_slice(
                function_node.str_offset, function_node.str_len
            ) {
                return false;
            }
        } else if !self.write_source_slice(
            function_node.str_offset, function_node.str_len
        ) {
            return false;
        }

        if !self.write_byte(40) {
            return false;
        }

        let mut child: usize = function_node.first_child;
        let mut first_param: bool = true;
        while child != 0 {
            if !self.valid_node(child) {
                return false;
            }
            let node: AstNode = unsafe { *(self.nodes + child) };
            if node.kind == AstKind::ParamDecl {
                if !first_param {
                    if !self.write_str(", ", 2) {
                        return false;
                    }
                }
                if !self.emit_parameter(child) {
                    return false;
                }
                first_param = false;
            }
            child = node.next_sibling;
        }

        let body_index: usize = self.find_function_body(fn_index);
        if body_index == 0 {
            return self.write_str(");\n", 3);
        }
        if !self.write_str(") ", 2) {
            return false;
        }
        return self.emit_braced_block(body_index);
    }

    pub fn emit_braced_block(mut self: &mut Self, block_index: usize) -> bool {
        if !self.valid_node(block_index) {
            return false;
        }
        let block: AstNode = unsafe { *(self.nodes + block_index) };
        if block.kind != AstKind::Block {
            return false;
        }
        if !self.write_str("{\n", 2) {
            return false;
        }
        if !self.emit_block_normal_exit(block_index) {
            return false;
        }
        return self.write_str("}\n", 2);
    }

    pub fn emit_while_statement(mut self: &mut Self, index: usize) -> bool {
        if !self.valid_node(index) {
            return false;
        }
        let node: AstNode = unsafe { *(self.nodes + index) };
        if node.kind != AstKind::WhileStmt {
            return false;
        }

        let cond_index: usize = node.first_child;
        if !self.valid_node(cond_index) {
            return false;
        }
        let cond: AstNode = unsafe { *(self.nodes + cond_index) };
        let body_index: usize = cond.next_sibling;
        if !self.valid_node(body_index) {
            return false;
        }
        let body: AstNode = unsafe { *(self.nodes + body_index) };
        if body.kind != AstKind::Block {
            return false;
        }

        if !self.write_str("while (", 7) {
            return false;
        }
        if !self.emit_expression(cond_index) {
            return false;
        }
        if !self.write_str(") ", 2) {
            return false;
        }
        return self.emit_braced_block(body_index);
    }

    pub fn emit_if_statement(mut self: &mut Self, index: usize) -> bool {
        if !self.valid_node(index) {
            return false;
        }
        let node: AstNode = unsafe { *(self.nodes + index) };
        if node.kind != AstKind::IfStmt {
            return false;
        }

        let cond_index: usize = node.first_child;
        if !self.valid_node(cond_index) {
            return false;
        }
        let cond: AstNode = unsafe { *(self.nodes + cond_index) };
        let then_index: usize = cond.next_sibling;
        if !self.valid_node(then_index) {
            return false;
        }
        let then_node: AstNode = unsafe { *(self.nodes + then_index) };
        if then_node.kind != AstKind::Block {
            return false;
        }

        if !self.write_str("if (", 4) {
            return false;
        }
        if !self.emit_expression(cond_index) {
            return false;
        }
        if !self.write_str(") ", 2) {
            return false;
        }
        if !self.emit_braced_block(then_index) {
            return false;
        }

        let else_index: usize = then_node.next_sibling;
        if else_index == 0 {
            return true;
        }
        if !self.valid_node(else_index) {
            return false;
        }
        let else_node: AstNode = unsafe { *(self.nodes + else_index) };
        if !self.write_str("else ", 5) {
            return false;
        }
        if else_node.kind == AstKind::Block {
            return self.emit_braced_block(else_index);
        }
        if else_node.kind == AstKind::IfStmt {
            return self.emit_if_statement(else_index);
        }
        return false;
    }

    pub fn emit_unsafe_block(mut self: &mut Self, index: usize) -> bool {
        if !self.valid_node(index) {
            return false;
        }
        let node: AstNode = unsafe { *(self.nodes + index) };
        if node.kind != AstKind::UnsafeBlock || node.first_child == 0 {
            return false;
        }

        let body_index: usize = node.first_child;
        if !self.valid_node(body_index) {
            return false;
        }
        let body: AstNode = unsafe { *(self.nodes + body_index) };
        if body.kind != AstKind::Block {
            return false;
        }

        return self.emit_braced_block(body_index);
    }

    pub fn emit_try_statement(mut self: &mut Self, try_index: usize) -> bool {
        if !self.valid_node(try_index) {
            return false;
        }
        let try_node: AstNode = unsafe { *(self.nodes + try_index) };
        if try_node.kind != AstKind::TryExpr || !self.valid_node(try_node.first_child) {
            return false;
        }
        if !self.try_context_returns_result_u64_i32(try_index)
            || !self.try_call_returns_result_u64_i32(try_index) {
            return false;
        }

        if !self.write_str("{\nSotlasResultU64I32 __sotlas_try_value = ", 42) {
            return false;
        }
        if !self.emit_expression(try_node.first_child) {
            return false;
        }
        if !self.write_str(";\nif (!__sotlas_try_value.is_ok) {\n", 35) {
            return false;
        }
        if !self.emit_function_exit_defers(try_index) {
            return false;
        }
        return self.write_str("return __sotlas_try_value;\n}\n}\n", 31);
    }

    pub fn emit_try_let_u64_statement(
        mut self: &mut Self,
        let_index: usize,
        try_index: usize
    ) -> bool {
        if !self.valid_node(let_index) || !self.valid_node(try_index) {
            return false;
        }

        let local: AstNode = unsafe { *(self.nodes + let_index) };
        let try_node: AstNode = unsafe { *(self.nodes + try_index) };
        if local.kind != AstKind::LetStmt
            || try_node.kind != AstKind::TryExpr
            || local.str_len == 0 {
            return false;
        }
        if !self.try_context_returns_result_u64_i32(try_index)
            || !self.try_call_returns_result_u64_i32(try_index) {
            return false;
        }

        if !self.write_str("SotlasResultU64I32 __sotlas_try_", 32) {
            return false;
        }
        if !self.write_source_slice(local.str_offset, local.str_len) {
            return false;
        }
        if !self.write_str(" = ", 3) {
            return false;
        }
        if !self.emit_expression(try_node.first_child) {
            return false;
        }
        if !self.write_str(";\nif (!__sotlas_try_", 20) {
            return false;
        }
        if !self.write_source_slice(local.str_offset, local.str_len) {
            return false;
        }
        if !self.write_str(".is_ok) {\n", 10) {
            return false;
        }

        if !self.emit_function_exit_defers(let_index) {
            return false;
        }
        if !self.write_str("return __sotlas_try_", 20) {
            return false;
        }
        if !self.write_source_slice(local.str_offset, local.str_len) {
            return false;
        }
        if !self.write_str(";\n}\nuint64_t ", 13) {
            return false;
        }
        if !self.write_source_slice(local.str_offset, local.str_len) {
            return false;
        }
        if !self.write_str(" = __sotlas_try_", 16) {
            return false;
        }
        if !self.write_source_slice(local.str_offset, local.str_len) {
            return false;
        }
        return self.write_str(".payload.ok;\n", 13);
    }

    pub fn emit_try_let_statement(
        mut self: &mut Self,
        let_index: usize,
        type_index: usize,
        try_index: usize
    ) -> bool {
        if !self.valid_node(type_index) {
            return false;
        }
        let typ: AstNode = unsafe { *(self.nodes + type_index) };
        if typ.kind != AstKind::TypeRef
            || !self.source_slice_equals(typ.str_offset, typ.str_len, "u64", 3) {
            return false;
        }
        return self.emit_try_let_u64_statement(let_index, try_index);
    }

    pub fn emit_let_statement(mut self: &mut Self, index: usize) -> bool {
        if !self.valid_node(index) {
            return false;
        }
        let node: AstNode = unsafe { *(self.nodes + index) };
        if node.kind != AstKind::LetStmt || node.str_len == 0 {
            return false;
        }

        let type_index: usize = node.first_child;
        if !self.valid_node(type_index) {
            return false;
        }
        let type_node: AstNode = unsafe { *(self.nodes + type_index) };

        // Restricted native inference: a direct Result<u64,i32> try unwrap
        // has a statically known success payload of u64.
        if type_node.kind == AstKind::TryExpr {
            return self.emit_try_let_u64_statement(index, type_index);
        }
        if type_node.kind != AstKind::TypeRef {
            return false;
        }

        let init_index: usize = type_node.next_sibling;
        if init_index != 0 {
            if !self.valid_node(init_index) {
                return false;
            }
            let init_node: AstNode = unsafe { *(self.nodes + init_index) };
            if init_node.kind == AstKind::TryExpr {
                return self.emit_try_let_statement(index, type_index, init_index);
            }
        }

        if !self.emit_c_type(type_index) {
            return false;
        }
        if !self.write_byte(32) {
            return false;
        }
        if !self.write_source_slice(node.str_offset, node.str_len) {
            return false;
        }

        if init_index != 0 {
            if !self.write_str(" = ", 3) {
                return false;
            }

            let init_node: AstNode = unsafe { *(self.nodes + init_index) };
            if self.type_ref_is_result_u64_i32(type_index)
                && init_node.kind == AstKind::ExprCall
                && self.result_constructor_kind(init_index) != 0 {
                if !self.emit_result_u64_constructor(init_index) {
                    return false;
                }
            } else if !self.emit_expression_for_type(init_index, type_index) {
                return false;
            }
        }

        return self.write_str(";\n", 2);
    }

    pub fn emit_normal_statement(mut self: &mut Self, index: usize) -> bool {
        if !self.valid_node(index) {
            return false;
        }
        let node: AstNode = unsafe { *(self.nodes + index) };

        // A defer declaration registers work for scope exit and emits nothing
        // at its declaration site.
        if node.kind == AstKind::DeferStmt {
            return true;
        }

        if node.kind == AstKind::LetStmt {
            return self.emit_let_statement(index);
        }
        if node.kind == AstKind::TryExpr {
            return self.emit_try_statement(index);
        }
        if node.kind == AstKind::UnsafeBlock {
            return self.emit_unsafe_block(index);
        }
        if node.kind == AstKind::IfStmt {
            return self.emit_if_statement(index);
        }
        if node.kind == AstKind::WhileStmt {
            return self.emit_while_statement(index);
        }

        if node.kind == AstKind::AssignStmt
            || node.kind == AstKind::ExprCall
            || node.kind == AstKind::ExprBinary
            || node.kind == AstKind::ExprIdent
            || node.kind == AstKind::ExprLiteral {
            return self.emit_statement_payload(index);
        }

        // Control-flow and declarations require dedicated lowering; never
        // silently drop them from generated output.
        return false;
    }

    pub fn emit_block_normal_exit(
        mut self: &mut Self,
        block_index: usize
    ) -> bool {
        if !self.valid_node(block_index) {
            return false;
        }
        let block: AstNode = unsafe { *(self.nodes + block_index) };
        if block.kind != AstKind::Block {
            return false;
        }

        let mut stmt: usize = block.first_child;
        while stmt != 0 {
            if !self.valid_node(stmt) {
                return false;
            }
            let stmt_node: AstNode = unsafe { *(self.nodes + stmt) };

            // A return terminates this control-flow path. Its dedicated
            // lowering performs all active lexical cleanup itself, so the
            // block must not emit later statements or normal-exit cleanup.
            if stmt_node.kind == AstKind::ReturnStmt {
                return self.emit_return_statement(stmt);
            }
            if stmt_node.kind == AstKind::BreakStmt
                || stmt_node.kind == AstKind::ContinueStmt {
                return self.emit_loop_jump_statement(stmt);
            }

            if !self.emit_normal_statement(stmt) {
                return false;
            }
            stmt = stmt_node.next_sibling;
        }

        // Only a fallthrough path reaches the normal lexical cleanup.
        return self.emit_block_exit_defers(block_index);
    }

    pub fn emit_impl(mut self: &mut Self, impl_index: usize) -> bool {
        if !self.valid_node(impl_index) {
            return false;
        }
        let impl_node: AstNode = unsafe { *(self.nodes + impl_index) };
        let module_index: usize = impl_node.parent;
        if impl_node.kind != AstKind::ImplDecl || impl_node.str_len == 0
            || impl_node.first_child == 0 || !self.valid_node(module_index)
            || !self.impl_target_is_declared(module_index, impl_index) {
            return false;
        }

        let mut method_index: usize = impl_node.first_child;
        while method_index != 0 {
            if !self.valid_node(method_index) {
                return false;
            }
            let method: AstNode = unsafe { *(self.nodes + method_index) };
            if method.kind != AstKind::FnDecl || method.parent != impl_index
                || self.static_impl_method_has_receiver(method_index)
                || !self.static_method_is_unique(
                    module_index, impl_index, method_index
                ) {
                return false;
            }
            if !self.emit_function(method_index) || !self.write_byte(10) {
                return false;
            }
            method_index = method.next_sibling;
        }
        return true;
    }

    pub fn emit_module(mut self: &mut Self, module_index: usize) -> bool {
        if !self.valid_node(module_index) {
            return false;
        }
        let module_node: AstNode = unsafe { *(self.nodes + module_index) };
        if module_node.kind != AstKind::Module {
            return false;
        }

        let mut child: usize = module_node.first_child;
        while child != 0 {
            if !self.valid_node(child) {
                return false;
            }
            let node: AstNode = unsafe { *(self.nodes + child) };

            if node.kind == AstKind::Import {
                // Native imports are resolved by the compiler/module graph;
                // they do not become textual C preprocessor includes here.
            } else if node.kind == AstKind::EnumDecl {
                if !self.emit_enum(child) {
                    return false;
                }
                if !self.write_byte(10) {
                    return false;
                }
            } else if node.kind == AstKind::StructDecl {
                if !self.emit_struct(child) {
                    return false;
                }
                if !self.write_byte(10) {
                    return false;
                }
            } else if node.kind == AstKind::FnDecl {
                if !self.emit_function(child) {
                    return false;
                }
                if !self.write_byte(10) {
                    return false;
                }
            } else if node.kind == AstKind::ImplDecl {
                if !self.emit_impl(child) {
                    return false;
                }
            } else {
                // Unsupported top-level forms must not disappear silently.
                return false;
            }

            child = node.next_sibling;
        }
        return true;
    }

    pub fn emit_header(mut self: &mut Self) -> bool {
        let hdr: *const u8 = "// Compilado nativamente pelo compilador Sotlas in Sotlas (v1.0-selfhost)\n#include <stdint.h>\n#include <stdbool.h>\n#include <stddef.h>\n#ifndef SOTLAS_RESULT_U64_DEFINED\n#define SOTLAS_RESULT_U64_DEFINED 1\ntypedef struct { int32_t status; uint64_t value; } SotlasResultU64;\n#endif\n#ifndef SOTLAS_RESULT_U64_I32_DEFINED\n#define SOTLAS_RESULT_U64_I32_DEFINED 1\ntypedef struct { bool is_ok; union { uint64_t ok; int32_t err; } payload; } SotlasResultU64I32;\n#endif\n\n";
        return self.write_str(hdr, 462);
    }
}

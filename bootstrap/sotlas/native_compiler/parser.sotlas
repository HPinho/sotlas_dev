module sotlas::compiler::parser;

import sotlas::compiler::token::*;
import sotlas::compiler::ast::*;

pub const MAX_AST_NODES: usize = 65536;

pub struct Parser {
    pub tokens: *const Token;
    pub token_count: usize;
    pub cursor: usize;
    pub nodes: *mut AstNode;
    pub node_capacity: usize;
    pub node_count: usize;
}

impl Parser {
    pub fn new(
        toks: *const Token,
        count: usize,
        node_buf: *mut AstNode,
        node_cap: usize
    ) -> Parser {
        return Parser {
            tokens: toks,
            token_count: count,
            cursor: 0,
            nodes: node_buf,
            node_capacity: node_cap,
            node_count: 1 // 0 é reservado como NULL_INDEX
        };
    }

    pub fn is_at_end(self: &Self) -> bool {
        if self.cursor >= self.token_count {
            return true;
        }
        let tok: Token = unsafe { *(self.tokens + self.cursor) };
        return tok.kind == TokenKind::Eof;
    }

    pub fn current(self: &Self) -> Token {
        if self.cursor >= self.token_count {
            return Token::new(TokenKind::Eof, 0, 0);
        }
        unsafe {
            return *(self.tokens + self.cursor);
        }
    }

    pub fn advance(mut self: &mut Self) -> Token {
        let tok: Token = self.current();
        if self.cursor < self.token_count {
            self.cursor = self.cursor + 1;
        }
        return tok;
    }

    pub fn match_token(self: &Self, kind: TokenKind) -> bool {
        return self.current().kind == kind;
    }

    pub fn expect(mut self: &mut Self, kind: TokenKind) -> Token {
        let tok: Token = self.current();
        if tok.kind == kind {
            return self.advance();
        }
        // Retorna o token atual mesmo em caso de erro para prosseguir análise
        return self.advance();
    }

    pub fn alloc_node(mut self: &mut Self, kind: AstKind, span: Span) -> usize {
        if self.nodes == null || self.node_count >= self.node_capacity {
            return 0;
        }
        let idx: usize = self.node_count;
        unsafe {
            *(self.nodes + idx) = AstNode::new(kind, span);
        }
        self.node_count = self.node_count + 1;
        return idx;
    }

    pub fn set_node_text(mut self: &mut Self, index: usize, tok: Token) -> bool {
        if self.nodes == null || index == 0 || index >= self.node_count {
            return false;
        }
        let mut node: AstNode = unsafe { *(self.nodes + index) };
        node.str_offset = tok.span.offset;
        node.str_len = tok.span.length;
        unsafe {
            *(self.nodes + index) = node;
        }
        return true;
    }

    pub fn alloc_text_node(mut self: &mut Self, kind: AstKind, tok: Token) -> usize {
        let node: usize = self.alloc_node(kind, tok.span);
        if node == 0 {
            return 0;
        }
        if !self.set_node_text(node, tok) {
            return 0;
        }
        return node;
    }

    pub fn set_node_text_range(
        mut self: &mut Self,
        index: usize,
        first: Token,
        last: Token
    ) -> bool {
        if self.nodes == null || index == 0 || index >= self.node_count {
            return false;
        }
        if last.span.offset < first.span.offset {
            return false;
        }
        let end_offset: usize = last.span.offset + last.span.length;
        if end_offset < first.span.offset {
            return false;
        }
        let mut node: AstNode = unsafe { *(self.nodes + index) };
        node.str_offset = first.span.offset;
        node.str_len = end_offset - first.span.offset;
        unsafe {
            *(self.nodes + index) = node;
        }
        return true;
    }

    pub fn append_child(mut self: &mut Self, parent: usize, child: usize) -> bool {
        if self.nodes == null || parent == 0 || child == 0 {
            return false;
        }
        if parent >= self.node_count || child >= self.node_count {
            return false;
        }

        let mut child_node: AstNode = unsafe { *(self.nodes + child) };
        if child_node.parent != 0 {
            return false;
        }

        let mut parent_node: AstNode = unsafe { *(self.nodes + parent) };
        if parent_node.first_child == 0 {
            parent_node.first_child = child;
            child_node.parent = parent;
            unsafe {
                *(self.nodes + parent) = parent_node;
                *(self.nodes + child) = child_node;
            }
            return true;
        }

        let mut current: usize = parent_node.first_child;
        while current != 0 {
            let mut current_node: AstNode = unsafe { *(self.nodes + current) };
            if current_node.next_sibling == 0 {
                current_node.next_sibling = child;
                child_node.parent = parent;
                unsafe {
                    *(self.nodes + current) = current_node;
                    *(self.nodes + child) = child_node;
                }
                return true;
            }
            current = current_node.next_sibling;
        }
        return false;
    }

    pub fn parse_module(mut self: &mut Self) -> usize {
        let start_tok: Token = self.current();
        let mod_node: usize = self.alloc_node(AstKind::Module, start_tok.span);
        if mod_node == 0 {
            return 0;
        }

        if self.match_token(TokenKind::KwModule) {
            self.advance();
            // Consome identificadores de módulo separados por ::
            while !self.is_at_end() && !self.match_token(TokenKind::SemiColon) {
                self.advance();
            }
            if self.match_token(TokenKind::SemiColon) {
                self.advance();
            }
        }

        // Persiste todas as declarações de topo como filhos do módulo.
        while !self.is_at_end() {
            let before: usize = self.cursor;
            let decl_node: usize = self.parse_declaration();
            if decl_node == 0 {
                return 0;
            }
            if !self.append_child(mod_node, decl_node) {
                return 0;
            }

            // Guarda de progresso: um parser malformado nunca pode travar o compilador.
            if self.cursor <= before {
                self.advance();
            }
        }
        return mod_node;
    }

    pub fn parse_block(mut self: &mut Self) -> usize {
        let open_tok: Token = self.current();
        if !self.match_token(TokenKind::OpenBrace) {
            return 0;
        }
        self.advance();

        let block_node: usize = self.alloc_node(AstKind::Block, open_tok.span);
        if block_node == 0 {
            return 0;
        }

        while !self.is_at_end() && !self.match_token(TokenKind::CloseBrace) {
            let before: usize = self.cursor;
            let stmt_node: usize = self.parse_statement();
            if stmt_node == 0 {
                return 0;
            }
            if !self.append_child(block_node, stmt_node) {
                return 0;
            }
            if self.cursor <= before {
                self.advance();
            }
        }

        if !self.match_token(TokenKind::CloseBrace) {
            return 0;
        }
        self.advance();
        return block_node;
    }

    pub fn operator_tag(self: &Self, kind: TokenKind) -> i64 {
        if kind == TokenKind::Plus { return 80; }
        if kind == TokenKind::Minus { return 81; }
        if kind == TokenKind::Star { return 82; }
        if kind == TokenKind::Slash { return 83; }
        if kind == TokenKind::Percent { return 84; }
        if kind == TokenKind::EqEq { return 86; }
        if kind == TokenKind::BangEq { return 87; }
        if kind == TokenKind::Lt { return 88; }
        if kind == TokenKind::LtEq { return 89; }
        if kind == TokenKind::Gt { return 90; }
        if kind == TokenKind::GtEq { return 91; }
        if kind == TokenKind::Tilde { return 95; }
        if kind == TokenKind::Bang { return 98; }
        return 0;
    }

    pub fn make_binary(
        mut self: &mut Self,
        left: usize,
        op: Token,
        right: usize
    ) -> usize {
        if left == 0 || right == 0 {
            return 0;
        }
        let node: usize = self.alloc_node(AstKind::ExprBinary, op.span);
        if node == 0 {
            return 0;
        }
        let mut ast_node: AstNode = unsafe { *(self.nodes + node) };
        ast_node.int_value = self.operator_tag(op.kind);
        unsafe {
            *(self.nodes + node) = ast_node;
        }
        if !self.append_child(node, left) {
            return 0;
        }
        if !self.append_child(node, right) {
            return 0;
        }
        return node;
    }

    pub fn parse_expression_statement(mut self: &mut Self) -> usize {
        let left: usize = self.parse_expression();
        if left == 0 {
            return 0;
        }

        if self.match_token(TokenKind::Equal) {
            let assign_tok: Token = self.advance();
            let assign_node: usize = self.alloc_node(AstKind::AssignStmt, assign_tok.span);
            if assign_node == 0 {
                return 0;
            }
            let right: usize = self.parse_expression();
            if right == 0 {
                return 0;
            }
            if !self.append_child(assign_node, left) {
                return 0;
            }
            if !self.append_child(assign_node, right) {
                return 0;
            }
            if !self.match_token(TokenKind::SemiColon) {
                return 0;
            }
            self.advance();
            return assign_node;
        }

        if !self.match_token(TokenKind::SemiColon) {
            return 0;
        }
        self.advance();
        return left;
    }

    pub fn parse_statement(mut self: &mut Self) -> usize {
        let tok: Token = self.current();
        if tok.kind == TokenKind::KwLet || tok.kind == TokenKind::KwVar {
            self.advance();
            let let_node: usize = self.alloc_node(AstKind::LetStmt, tok.span);
            if let_node == 0 {
                return 0;
            }

            let mut is_mutable: bool = tok.kind == TokenKind::KwVar;
            if self.match_token(TokenKind::KwMut) {
                self.advance();
                is_mutable = true;
            }

            let name_tok: Token = self.current();
            if name_tok.kind != TokenKind::Ident {
                return 0;
            }
            self.advance();
            if !self.set_node_text(let_node, name_tok) {
                return 0;
            }

            let mut stored_node: AstNode = unsafe { *(self.nodes + let_node) };
            if is_mutable {
                stored_node.int_value = 1;
            }
            unsafe {
                *(self.nodes + let_node) = stored_node;
            }

            if self.match_token(TokenKind::Colon) {
                self.advance();
                if self.is_at_end()
                    || self.match_token(TokenKind::Equal)
                    || self.match_token(TokenKind::SemiColon) {
                    return 0;
                }

                let type_start: Token = self.current();
                let mut type_end: Token = type_start;
                while !self.is_at_end()
                    && !self.match_token(TokenKind::Equal)
                    && !self.match_token(TokenKind::SemiColon) {
                    type_end = self.advance();
                }

                let type_node: usize = self.alloc_node(AstKind::TypeRef, type_start.span);
                if type_node == 0 {
                    return 0;
                }
                if !self.set_node_text_range(type_node, type_start, type_end) {
                    return 0;
                }
                if !self.append_child(let_node, type_node) {
                    return 0;
                }
            }

            if self.match_token(TokenKind::Equal) {
                self.advance();
                let val_node: usize = self.parse_expression();
                if val_node == 0 || !self.append_child(let_node, val_node) {
                    return 0;
                }
            }

            if !self.match_token(TokenKind::SemiColon) {
                return 0;
            }
            self.advance();
            return let_node;
        } else if tok.kind == TokenKind::KwReturn {
            self.advance();
            let ret_node: usize = self.alloc_node(AstKind::ReturnStmt, tok.span);
            if ret_node == 0 {
                return 0;
            }
            if !self.match_token(TokenKind::SemiColon) {
                let expr_node: usize = self.parse_expression();
                if expr_node == 0 || !self.append_child(ret_node, expr_node) {
                    return 0;
                }
            }
            self.expect(TokenKind::SemiColon);
            return ret_node;
        } else if tok.kind == TokenKind::KwBreak {
            self.advance();
            let break_node: usize = self.alloc_node(AstKind::BreakStmt, tok.span);
            if break_node == 0 {
                return 0;
            }
            if !self.match_token(TokenKind::SemiColon) {
                return 0;
            }
            self.advance();
            return break_node;
        } else if tok.kind == TokenKind::KwContinue {
            self.advance();
            let continue_node: usize = self.alloc_node(AstKind::ContinueStmt, tok.span);
            if continue_node == 0 {
                return 0;
            }
            if !self.match_token(TokenKind::SemiColon) {
                return 0;
            }
            self.advance();
            return continue_node;
        } else if tok.kind == TokenKind::KwAsm {
            self.advance();
            let asm_node: usize = self.alloc_node(AstKind::AsmStmt, tok.span);
            if self.match_token(TokenKind::KwVolatile) {
                self.advance();
            }
            self.expect(TokenKind::OpenParen);
            self.expect(TokenKind::StrLit);
            self.expect(TokenKind::CloseParen);
            self.expect(TokenKind::SemiColon);
            return asm_node;
        } else if tok.kind == TokenKind::KwUnsafe {
            self.advance();
            let unsafe_node: usize = self.alloc_node(AstKind::UnsafeBlock, tok.span);
            if unsafe_node == 0 {
                return 0;
            }
            if self.match_token(TokenKind::OpenBrace) {
                let body_node: usize = self.parse_block();
                if body_node == 0 || !self.append_child(unsafe_node, body_node) {
                    return 0;
                }
            }
            return unsafe_node;
        } else if tok.kind == TokenKind::KwClinch {
            self.advance();
            let clinch_node: usize = self.alloc_node(AstKind::ClinchStmt, tok.span);
            if clinch_node == 0 {
                return 0;
            }
            if self.match_token(TokenKind::OpenBrace) {
                let body_node: usize = self.parse_block();
                if body_node == 0 || !self.append_child(clinch_node, body_node) {
                    return 0;
                }
            }
            if self.match_token(TokenKind::KwRevert) {
                self.advance();
                if self.match_token(TokenKind::OpenBrace) {
                    let revert_node: usize = self.parse_block();
                    if revert_node == 0 || !self.append_child(clinch_node, revert_node) {
                        return 0;
                    }
                }
            }
            return clinch_node;
        } else if tok.kind == TokenKind::KwDiscern {
            self.advance();
            let discern_node: usize = self.alloc_node(AstKind::DiscernStmt, tok.span);
            let _target: usize = self.parse_expression();
            if self.match_token(TokenKind::OpenBrace) {
                self.advance();
                while !self.is_at_end() && !self.match_token(TokenKind::CloseBrace) {
                    self.advance();
                }
                self.expect(TokenKind::CloseBrace);
            }
            return discern_node;
        } else if tok.kind == TokenKind::KwIf {
            self.advance();
            let if_node: usize = self.alloc_node(AstKind::IfStmt, tok.span);
            if if_node == 0 {
                return 0;
            }
            let cond_node: usize = self.parse_expression();
            if cond_node == 0 || !self.append_child(if_node, cond_node) {
                return 0;
            }
            if self.match_token(TokenKind::OpenBrace) {
                let then_node: usize = self.parse_block();
                if then_node == 0 || !self.append_child(if_node, then_node) {
                    return 0;
                }
            }
            if self.match_token(TokenKind::KwElse) {
                self.advance();
                if self.match_token(TokenKind::OpenBrace) {
                    let else_node: usize = self.parse_block();
                    if else_node == 0 || !self.append_child(if_node, else_node) {
                        return 0;
                    }
                } else if self.match_token(TokenKind::KwIf) {
                    let else_if_node: usize = self.parse_statement();
                    if else_if_node == 0 || !self.append_child(if_node, else_if_node) {
                        return 0;
                    }
                }
            }
            return if_node;
        } else if tok.kind == TokenKind::KwWhile {
            self.advance();
            let while_node: usize = self.alloc_node(AstKind::WhileStmt, tok.span);
            if while_node == 0 {
                return 0;
            }
            let cond_node: usize = self.parse_expression();
            if cond_node == 0 || !self.append_child(while_node, cond_node) {
                return 0;
            }
            if self.match_token(TokenKind::OpenBrace) {
                let body_node: usize = self.parse_block();
                if body_node == 0 || !self.append_child(while_node, body_node) {
                    return 0;
                }
            }
            return while_node;
        } else if tok.kind == TokenKind::KwDefer {
            self.advance();
            let defer_node: usize = self.alloc_node(AstKind::DeferStmt, tok.span);
            if defer_node == 0 {
                return 0;
            }

            let mut payload_node: usize = 0;
            if self.match_token(TokenKind::OpenBrace) {
                payload_node = self.parse_block();
            } else {
                payload_node = self.parse_expression_statement();
            }
            if payload_node == 0 {
                return 0;
            }
            if !self.append_child(defer_node, payload_node) {
                return 0;
            }
            return defer_node;
        }
        return self.parse_expression_statement();
    }

    pub fn parse_declaration(mut self: &mut Self) -> usize {
        let tok: Token = self.current();
        if tok.kind == TokenKind::KwPub {
            self.advance();
        }
        let inner: Token = self.current();
        if inner.kind == TokenKind::KwFn || inner.kind == TokenKind::KwTrapfn {
            self.advance();
            let fn_node: usize = self.alloc_node(if inner.kind == TokenKind::KwTrapfn { AstKind::TrapfnDecl } else { AstKind::FnDecl }, inner.span);
            let name_tok: Token = self.expect(TokenKind::Ident);
            if !self.set_node_text(fn_node, name_tok) {
                return 0;
            }
            if self.match_token(TokenKind::OpenParen) {
                self.advance();

                while !self.is_at_end() && !self.match_token(TokenKind::CloseParen) {
                    let mut param_mutable: bool = false;
                    if self.match_token(TokenKind::KwMut) {
                        self.advance();
                        param_mutable = true;
                    }

                    let param_name: Token = self.current();
                    if param_name.kind != TokenKind::Ident {
                        return 0;
                    }
                    self.advance();

                    let param_node: usize = self.alloc_node(AstKind::ParamDecl, param_name.span);
                    if param_node == 0 || !self.set_node_text(param_node, param_name) {
                        return 0;
                    }
                    if param_mutable {
                        let mut stored_param: AstNode = unsafe { *(self.nodes + param_node) };
                        stored_param.int_value = 1;
                        unsafe {
                            *(self.nodes + param_node) = stored_param;
                        }
                    }

                    if !self.match_token(TokenKind::Colon) {
                        return 0;
                    }
                    self.advance();
                    if self.is_at_end()
                        || self.match_token(TokenKind::Comma)
                        || self.match_token(TokenKind::CloseParen) {
                        return 0;
                    }

                    let type_start: Token = self.current();
                    let mut type_end: Token = type_start;
                    while !self.is_at_end()
                        && !self.match_token(TokenKind::Comma)
                        && !self.match_token(TokenKind::CloseParen) {
                        type_end = self.advance();
                    }

                    let param_type: usize = self.alloc_node(AstKind::TypeRef, type_start.span);
                    if param_type == 0 {
                        return 0;
                    }
                    if !self.set_node_text_range(param_type, type_start, type_end) {
                        return 0;
                    }
                    if !self.append_child(param_node, param_type) {
                        return 0;
                    }
                    if !self.append_child(fn_node, param_node) {
                        return 0;
                    }

                    if self.match_token(TokenKind::Comma) {
                        self.advance();
                    } else {
                        break;
                    }
                }

                if !self.match_token(TokenKind::CloseParen) {
                    return 0;
                }
                self.advance();
            }
            if self.match_token(TokenKind::Arrow) {
                self.advance();
                if self.is_at_end()
                    || self.match_token(TokenKind::OpenBrace)
                    || self.match_token(TokenKind::SemiColon) {
                    return 0;
                }

                let type_start: Token = self.current();
                let mut type_end: Token = type_start;
                let type_node: usize = self.alloc_node(AstKind::TypeRef, type_start.span);
                if type_node == 0 {
                    return 0;
                }

                while !self.is_at_end()
                    && !self.match_token(TokenKind::OpenBrace)
                    && !self.match_token(TokenKind::SemiColon) {
                    type_end = self.advance();
                }

                if !self.set_node_text_range(type_node, type_start, type_end) {
                    return 0;
                }
                if !self.append_child(fn_node, type_node) {
                    return 0;
                }
            }
            if fn_node == 0 {
                return 0;
            }
            if self.match_token(TokenKind::OpenBrace) {
                let body_node: usize = self.parse_block();
                if body_node == 0 {
                    return 0;
                }
                if !self.append_child(fn_node, body_node) {
                    return 0;
                }
            } else if self.match_token(TokenKind::SemiColon) {
                self.advance();
            }
            return fn_node;
        } else if inner.kind == TokenKind::KwStruct || inner.kind == TokenKind::KwMesh || inner.kind == TokenKind::KwSpec {
            self.advance();
            let struct_node: usize = self.alloc_node(if inner.kind == TokenKind::KwMesh { AstKind::MeshDecl } else { AstKind::StructDecl }, inner.span);
            let name_tok: Token = self.expect(TokenKind::Ident);
            if !self.set_node_text(struct_node, name_tok) {
                return 0;
            }
            if self.match_token(TokenKind::OpenBrace) {
                self.advance();
                while !self.is_at_end() && !self.match_token(TokenKind::CloseBrace) {
                    self.advance();
                }
                self.expect(TokenKind::CloseBrace);
            }
            return struct_node;
        } else if inner.kind == TokenKind::KwEnum {
            self.advance();
            let enum_node: usize = self.alloc_node(AstKind::EnumDecl, inner.span);
            if enum_node == 0 {
                return 0;
            }
            let name_tok: Token = self.expect(TokenKind::Ident);
            if !self.set_node_text(enum_node, name_tok) {
                return 0;
            }
            if self.match_token(TokenKind::OpenBrace) {
                self.advance();
                while !self.is_at_end() && !self.match_token(TokenKind::CloseBrace) {
                    self.advance();
                }
                self.expect(TokenKind::CloseBrace);
            }
            return enum_node;
        } else if inner.kind == TokenKind::KwImport {
            self.advance();
            let imp_node: usize = self.alloc_node(AstKind::Import, inner.span);
            while !self.is_at_end() && !self.match_token(TokenKind::SemiColon) {
                self.advance();
            }
            self.expect(TokenKind::SemiColon);
            return imp_node;
        }
        return self.parse_statement();
    }

    pub fn parse_primary_expression(mut self: &mut Self) -> usize {
        let tok: Token = self.advance();
        if tok.kind == TokenKind::IntLit || tok.kind == TokenKind::StrLit {
            return self.alloc_text_node(AstKind::ExprLiteral, tok);
        }

        if tok.kind == TokenKind::Ident {
            let ident_node: usize = self.alloc_text_node(AstKind::ExprIdent, tok);
            if ident_node == 0 {
                return 0;
            }
            if !self.match_token(TokenKind::OpenParen) {
                return ident_node;
            }

            let call_node: usize = self.alloc_node(AstKind::ExprCall, tok.span);
            if call_node == 0 {
                return 0;
            }
            if !self.append_child(call_node, ident_node) {
                return 0;
            }

            self.advance();
            while !self.is_at_end() && !self.match_token(TokenKind::CloseParen) {
                let arg_node: usize = self.parse_expression();
                if arg_node == 0 {
                    return 0;
                }
                if !self.append_child(call_node, arg_node) {
                    return 0;
                }
                if self.match_token(TokenKind::Comma) {
                    self.advance();
                } else {
                    break;
                }
            }
            if !self.match_token(TokenKind::CloseParen) {
                return 0;
            }
            self.advance();
            return call_node;
        }

        if tok.kind == TokenKind::OpenParen {
            let inner: usize = self.parse_expression();
            if inner == 0 || !self.match_token(TokenKind::CloseParen) {
                return 0;
            }
            self.advance();
            return inner;
        }

        return self.alloc_node(AstKind::ExprLiteral, tok.span);
    }

    pub fn parse_unary_expression(mut self: &mut Self) -> usize {
        if self.match_token(TokenKind::Bang)
            || self.match_token(TokenKind::Minus)
            || self.match_token(TokenKind::Plus)
            || self.match_token(TokenKind::Tilde) {
            let op: Token = self.advance();
            let operand: usize = self.parse_unary_expression();
            if operand == 0 {
                return 0;
            }
            let node: usize = self.alloc_node(AstKind::ExprUnary, op.span);
            if node == 0 {
                return 0;
            }
            let mut unary_node: AstNode = unsafe { *(self.nodes + node) };
            unary_node.int_value = self.operator_tag(op.kind);
            unsafe {
                *(self.nodes + node) = unary_node;
            }
            if !self.append_child(node, operand) {
                return 0;
            }
            return node;
        }
        return self.parse_primary_expression();
    }

    pub fn parse_multiplicative_expression(mut self: &mut Self) -> usize {
        let mut left: usize = self.parse_unary_expression();
        while self.match_token(TokenKind::Star)
            || self.match_token(TokenKind::Slash)
            || self.match_token(TokenKind::Percent) {
            let op: Token = self.advance();
            let right: usize = self.parse_unary_expression();
            left = self.make_binary(left, op, right);
            if left == 0 {
                return 0;
            }
        }
        return left;
    }

    pub fn parse_additive_expression(mut self: &mut Self) -> usize {
        let mut left: usize = self.parse_multiplicative_expression();
        while self.match_token(TokenKind::Plus)
            || self.match_token(TokenKind::Minus) {
            let op: Token = self.advance();
            let right: usize = self.parse_multiplicative_expression();
            left = self.make_binary(left, op, right);
            if left == 0 {
                return 0;
            }
        }
        return left;
    }

    pub fn parse_expression(mut self: &mut Self) -> usize {
        let mut left: usize = self.parse_additive_expression();
        while self.match_token(TokenKind::EqEq)
            || self.match_token(TokenKind::BangEq)
            || self.match_token(TokenKind::Lt)
            || self.match_token(TokenKind::LtEq)
            || self.match_token(TokenKind::Gt)
            || self.match_token(TokenKind::GtEq) {
            let op: Token = self.advance();
            let right: usize = self.parse_additive_expression();
            left = self.make_binary(left, op, right);
            if left == 0 {
                return 0;
            }
        }
        return left;
    }
}

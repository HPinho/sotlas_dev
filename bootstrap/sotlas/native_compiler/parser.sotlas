module sotlas::compiler::parser;

import sotlas::compiler::token::*;
import sotlas::compiler::ast::*;

pub const MAX_AST_NODES: usize = 65536;

pub struct Parser {
    pub tokens: *const Token;
    pub token_count: usize;
    pub cursor: usize;
    pub nodes: *mut AstNode;
    pub node_capacity: usize;
    pub node_count: usize;
    pub error_count: usize;
    pub error_line: u32;
    pub error_col: u32;
    pub error_expected: TokenKind;
    pub error_actual: TokenKind;
}

impl Parser {
    pub fn new(
        toks: *const Token,
        count: usize,
        node_buf: *mut AstNode,
        node_cap: usize
    ) -> Parser {
        return Parser {
            tokens: toks,
            token_count: count,
            cursor: 0,
            nodes: node_buf,
            node_capacity: node_cap,
            node_count: 1, // 0 é reservado como NULL_INDEX
            error_count: 0,
            error_line: 0,
            error_col: 0,
            error_expected: TokenKind::Error,
            error_actual: TokenKind::Error
        };
    }

    pub fn is_at_end(self: &Self) -> bool {
        if self.cursor >= self.token_count {
            return true;
        }
        let tok: Token = unsafe { *(self.tokens + self.cursor) };
        return tok.kind == TokenKind::Eof;
    }

    pub fn current(self: &Self) -> Token {
        if self.cursor >= self.token_count {
            return Token::new(TokenKind::Eof, 0, 0);
        }
        unsafe {
            return *(self.tokens + self.cursor);
        }
    }

    pub fn advance(mut self: &mut Self) -> Token {
        let tok: Token = self.current();
        if self.cursor < self.token_count {
            self.cursor = self.cursor + 1;
        }
        return tok;
    }

    pub fn match_token(self: &Self, kind: TokenKind) -> bool {
        return self.current().kind == kind;
    }

    pub fn starts_struct_literal(self: &Self) -> bool {
        if self.tokens == null || !self.match_token(TokenKind::OpenBrace) {
            return false;
        }
        // First bounded subset requires at least one explicit `field: value`
        // pair.  Besides keeping empty literals fail-closed, this makes the
        // expression unambiguous with control-flow blocks such as `if cond {`.
        let field_index: usize = self.cursor + 1;
        let colon_index: usize = self.cursor + 2;
        if colon_index >= self.token_count {
            return false;
        }
        let field: Token = unsafe { *(self.tokens + field_index) };
        let colon: Token = unsafe { *(self.tokens + colon_index) };
        return field.kind == TokenKind::Ident && colon.kind == TokenKind::Colon;
    }

    pub fn expect(mut self: &mut Self, kind: TokenKind) -> Token {
        let tok: Token = self.current();
        if tok.kind == kind {
            return self.advance();
        }
        // Preserve the first parser error and its exact source location.
        // Do not consume the unexpected token; the caller's progress guard
        // can recover while parse_module still rejects the entire module.
        if self.error_count == 0 {
            self.error_line = tok.span.line;
            self.error_col = tok.span.col;
            self.error_expected = kind;
            self.error_actual = tok.kind;
        }
        self.error_count = self.error_count + 1;
        return tok;
    }

    pub fn reject_current(mut self: &mut Self) {
        let tok: Token = self.current();
        if self.error_count == 0 {
            self.error_line = tok.span.line;
            self.error_col = tok.span.col;
            self.error_actual = tok.kind;
        }
        self.error_count = self.error_count + 1;
    }

    pub fn record_unexpected(mut self: &mut Self, tok: Token) {
        if self.error_count == 0 {
            self.error_line = tok.span.line;
            self.error_col = tok.span.col;
            self.error_actual = tok.kind;
        }
        self.error_count = self.error_count + 1;
    }

    pub fn alloc_node(mut self: &mut Self, kind: AstKind, span: Span) -> usize {
        if self.nodes == null || self.node_count >= self.node_capacity {
            return 0;
        }
        let idx: usize = self.node_count;
        unsafe {
            *(self.nodes + idx) = AstNode::new(kind, span);
        }
        self.node_count = self.node_count + 1;
        return idx;
    }

    pub fn set_node_text(mut self: &mut Self, index: usize, tok: Token) -> bool {
        if self.nodes == null || index == 0 || index >= self.node_count {
            return false;
        }
        let mut node: AstNode = unsafe { *(self.nodes + index) };
        node.str_offset = tok.span.offset;
        node.str_len = tok.span.length;
        unsafe {
            *(self.nodes + index) = node;
        }
        return true;
    }

    pub fn alloc_text_node(mut self: &mut Self, kind: AstKind, tok: Token) -> usize {
        let node: usize = self.alloc_node(kind, tok.span);
        if node == 0 {
            return 0;
        }
        if !self.set_node_text(node, tok) {
            return 0;
        }
        return node;
    }

    pub fn set_node_text_range(
        mut self: &mut Self,
        index: usize,
        first: Token,
        last: Token
    ) -> bool {
        if self.nodes == null || index == 0 || index >= self.node_count {
            return false;
        }
        if last.span.offset < first.span.offset {
            return false;
        }
        let end_offset: usize = last.span.offset + last.span.length;
        if end_offset < first.span.offset {
            return false;
        }
        let mut node: AstNode = unsafe { *(self.nodes + index) };
        node.str_offset = first.span.offset;
        node.str_len = end_offset - first.span.offset;
        unsafe {
            *(self.nodes + index) = node;
        }
        return true;
    }

    pub fn token_word(self: &Self, token: Token, word: *const u8, length: usize) -> bool {
        if token.text_len != length || length > 128 { return false; }
        let mut index: usize = 0;
        while index < length {
            if token.text[index] != unsafe { *(word + index) } { return false; }
            index = index + 1;
        }
        return true;
    }

    pub fn parse_type_ref(mut self: &mut Self, context: i64) -> usize {
        if self.is_at_end() {
            return 0;
        }

        let original_start: Token = self.current();
        let mut domain: i64 = 0;
        if original_start.kind == TokenKind::KwSole { domain = 1; }
        else if original_start.kind == TokenKind::KwWhisper { domain = 4; }
        else if original_start.kind == TokenKind::Ident {
            if self.token_word(original_start, "exclusive", 9) { domain = 1; }
            else if self.token_word(original_start, "shared", 6) { domain = 2; }
            else if self.token_word(original_start, "island", 6) { domain = 3; }
            else if self.token_word(original_start, "region", 6) { domain = 5; }
            else if self.token_word(original_start, "direct", 6) { domain = 6; }
            else if self.token_word(original_start, "device", 6) { domain = 7; }
            else if self.token_word(original_start, "external", 8) { domain = 8; }
            if self.cursor + 1 < self.token_count
                && unsafe { (*(self.tokens + self.cursor + 1)).kind } == TokenKind::DColon { domain = 0; }
        }
        if domain != 0 { self.advance(); if self.is_at_end() { self.reject_current(); return 0; } }
        let type_start: Token = self.current();
        let mut type_end: Token = type_start;
        let mut angle_depth: i64 = 0;
        let mut bracket_depth: i64 = 0;
        let mut consumed: bool = false;
        let mut type_complete: bool = false;

        while !self.is_at_end() {
            let kind: TokenKind = self.current().kind;

            if angle_depth == 0 && bracket_depth == 0 {
                if context == 1
                    && (kind == TokenKind::Equal || kind == TokenKind::SemiColon) {
                    break;
                }
                if context == 2
                    && (kind == TokenKind::Comma || kind == TokenKind::CloseParen) {
                    break;
                }
                if context == 3
                    && (kind == TokenKind::OpenBrace || kind == TokenKind::SemiColon) {
                    break;
                }
                if context == 4
                    && (kind == TokenKind::SemiColon || kind == TokenKind::Comma || kind == TokenKind::CloseBrace) {
                    break;
                }
                if context == 5 && consumed
                    && (kind == TokenKind::Plus || kind == TokenKind::Minus
                        || (kind == TokenKind::Star && type_complete) || kind == TokenKind::Slash
                        || kind == TokenKind::Percent || kind == TokenKind::EqEq
                        || kind == TokenKind::Shl || kind == TokenKind::Shr
                        || kind == TokenKind::Amp || kind == TokenKind::Pipe
                        || kind == TokenKind::Caret
                        || kind == TokenKind::BangEq || kind == TokenKind::Lt
                        || kind == TokenKind::LtEq || kind == TokenKind::Gt
                        || kind == TokenKind::GtEq || kind == TokenKind::LogicalAnd
                        || kind == TokenKind::LogicalOr || kind == TokenKind::Comma
                        || kind == TokenKind::CloseParen || kind == TokenKind::CloseBracket
                        || kind == TokenKind::SemiColon || kind == TokenKind::OpenBrace
                        || kind == TokenKind::CloseBrace || kind == TokenKind::Equal) {
                    break;
                }
            }

            if kind == TokenKind::Lt {
                angle_depth = angle_depth + 1;
            } else if kind == TokenKind::Gt {
                if angle_depth == 0 {
                    return 0;
                }
                angle_depth = angle_depth - 1;
            } else if kind == TokenKind::Shr {
                if angle_depth < 2 {
                    return 0;
                }
                angle_depth = angle_depth - 2;
            } else if kind == TokenKind::OpenBracket {
                bracket_depth = bracket_depth + 1;
            } else if kind == TokenKind::CloseBracket {
                if bracket_depth == 0 {
                    return 0;
                }
                bracket_depth = bracket_depth - 1;
            }

            type_end = self.advance();
            if kind == TokenKind::Ident { type_complete = true; }
            consumed = true;
        }

        if !consumed || angle_depth != 0 || bracket_depth != 0 {
            return 0;
        }

        let type_node: usize = self.alloc_node(AstKind::TypeRef, original_start.span);
        if type_node == 0 {
            return 0;
        }
        if !self.set_node_text_range(type_node, type_start, type_end) {
            return 0;
        }
        unsafe {
            (*(self.nodes + type_node)).int_value = domain;
            (*(self.nodes + type_node)).span.length = type_end.span.offset + type_end.span.length - original_start.span.offset;
        }
        return type_node;
    }

    pub fn append_child(mut self: &mut Self, parent: usize, child: usize) -> bool {
        if self.nodes == null || parent == 0 || child == 0 {
            return false;
        }
        if parent >= self.node_count || child >= self.node_count {
            return false;
        }

        let mut child_node: AstNode = unsafe { *(self.nodes + child) };
        if child_node.parent != 0 {
            return false;
        }

        let mut parent_node: AstNode = unsafe { *(self.nodes + parent) };
        if parent_node.first_child == 0 {
            parent_node.first_child = child;
            child_node.parent = parent;
            unsafe {
                *(self.nodes + parent) = parent_node;
                *(self.nodes + child) = child_node;
            }
            return true;
        }

        let mut current: usize = parent_node.first_child;
        while current != 0 {
            let mut current_node: AstNode = unsafe { *(self.nodes + current) };
            if current_node.next_sibling == 0 {
                current_node.next_sibling = child;
                child_node.parent = parent;
                unsafe {
                    *(self.nodes + current) = current_node;
                    *(self.nodes + child) = child_node;
                }
                return true;
            }
            current = current_node.next_sibling;
        }
        return false;
    }

    pub fn parse_module(mut self: &mut Self) -> usize {
        let start_tok: Token = self.current();
        let mod_node: usize = self.alloc_node(AstKind::Module, start_tok.span);
        if mod_node == 0 {
            return 0;
        }

        if self.match_token(TokenKind::KwBarecore) {
            self.advance();
            if self.match_token(TokenKind::SemiColon) {
                self.advance();
            }
        } else if self.match_token(TokenKind::KwTarget) {
            self.advance();
            while !self.is_at_end() && !self.match_token(TokenKind::SemiColon) {
                self.advance();
            }
            if self.match_token(TokenKind::SemiColon) {
                self.advance();
            }
        }

        if self.match_token(TokenKind::KwModule) {
            self.advance();
            // Consome identificadores de módulo separados por ::
            while !self.is_at_end() && !self.match_token(TokenKind::SemiColon) {
                self.advance();
            }
            if self.match_token(TokenKind::SemiColon) {
                self.advance();
            }
        }

        if self.match_token(TokenKind::KwBarecore) {
            self.advance();
            if self.match_token(TokenKind::SemiColon) {
                self.advance();
            }
        } else if self.match_token(TokenKind::KwTarget) {
            self.advance();
            while !self.is_at_end() && !self.match_token(TokenKind::SemiColon) {
                self.advance();
            }
            if self.match_token(TokenKind::SemiColon) {
                self.advance();
            }
        }

        // Persiste todas as declarações de topo como filhos do módulo.
        while !self.is_at_end() {
            if self.match_token(TokenKind::KwModule) {
                self.advance();
                while !self.is_at_end() && !self.match_token(TokenKind::SemiColon) {
                    self.advance();
                }
                if self.match_token(TokenKind::SemiColon) {
                    self.advance();
                }
                continue;
            }
            if self.match_token(TokenKind::KwBarecore) {
                self.advance();
                if self.match_token(TokenKind::SemiColon) { self.advance(); }
                continue;
            } else if self.match_token(TokenKind::KwTarget) {
                self.advance();
                while !self.is_at_end() && !self.match_token(TokenKind::SemiColon) { self.advance(); }
                if self.match_token(TokenKind::SemiColon) { self.advance(); }
                continue;
            }
            let before: usize = self.cursor;
            let decl_node: usize = self.parse_declaration();
            if decl_node == 0 {
                return 0;
            }
            if !self.append_child(mod_node, decl_node) {
                return 0;
            }

            // Guarda de progresso: um parser malformado nunca pode travar o compilador.
            if self.cursor <= before {
                self.advance();
            }
        }
        if self.error_count != 0 {
            return 0;
        }
        return mod_node;
    }

    pub fn parse_block(mut self: &mut Self) -> usize {
        let open_tok: Token = self.current();
        if !self.match_token(TokenKind::OpenBrace) {
            return 0;
        }
        self.advance();

        let block_node: usize = self.alloc_node(AstKind::Block, open_tok.span);
        if block_node == 0 {
            return 0;
        }

        while !self.is_at_end() && !self.match_token(TokenKind::CloseBrace) {
            let before: usize = self.cursor;
            let stmt_node: usize = self.parse_statement();
            if stmt_node == 0 {
                return 0;
            }
            if !self.append_child(block_node, stmt_node) {
                return 0;
            }
            if self.cursor <= before {
                self.advance();
            }
        }

        if !self.match_token(TokenKind::CloseBrace) {
            return 0;
        }
        self.advance();
        return block_node;
    }

    pub fn operator_tag(self: &Self, kind: TokenKind) -> i64 {
        if kind == TokenKind::Plus { return 80; }
        if kind == TokenKind::Minus { return 81; }
        if kind == TokenKind::Star { return 82; }
        if kind == TokenKind::Slash { return 83; }
        if kind == TokenKind::Percent { return 84; }
        if kind == TokenKind::Amp { return 92; }
        if kind == TokenKind::Pipe { return 93; }
        if kind == TokenKind::Caret { return 94; }
        if kind == TokenKind::Shl { return 96; }
        if kind == TokenKind::Shr { return 97; }
        if kind == TokenKind::EqEq { return 86; }
        if kind == TokenKind::BangEq { return 87; }
        if kind == TokenKind::Lt { return 88; }
        if kind == TokenKind::LtEq { return 89; }
        if kind == TokenKind::Gt { return 90; }
        if kind == TokenKind::GtEq { return 91; }
        if kind == TokenKind::LogicalAnd { return 110; }
        if kind == TokenKind::LogicalOr { return 111; }
        if kind == TokenKind::Tilde { return 95; }
        if kind == TokenKind::Bang { return 98; }
        return 0;
    }

    pub fn make_binary(
        mut self: &mut Self,
        left: usize,
        op: Token,
        right: usize
    ) -> usize {
        if left == 0 || right == 0 {
            return 0;
        }
        let node: usize = self.alloc_node(AstKind::ExprBinary, op.span);
        if node == 0 {
            return 0;
        }
        let mut ast_node: AstNode = unsafe { *(self.nodes + node) };
        ast_node.int_value = self.operator_tag(op.kind);
        unsafe {
            *(self.nodes + node) = ast_node;
        }
        if !self.append_child(node, left) {
            return 0;
        }
        if !self.append_child(node, right) {
            return 0;
        }
        return node;
    }

    // Internal literal payload: zero source length plus -(value+1). Source
    // literals never use this representation; source spans still name syntax.
    pub fn generated_integer(mut self: &mut Self, point: Span, value: u64) -> usize {
        if value > 4294967295 { self.reject_current();return 0; }
        let node:usize=self.alloc_node(AstKind::ExprLiteral,point);
        if node != 0 { unsafe{(*(self.nodes+node)).int_value=-(value as i64)-1;} }return node;
    }

    pub fn name_expression(mut self: &mut Self, name: Token) -> usize {
        return self.alloc_text_node(AstKind::ExprIdent,name);
    }

    pub fn range_for_statement(mut self: &mut Self, keyword: Token) -> usize {
        self.advance();let mut mutable:bool=false;
        if self.match_token(TokenKind::KwMut) || self.match_token(TokenKind::KwVar) || self.match_token(TokenKind::KwLet) {
            mutable=!self.match_token(TokenKind::KwLet);self.advance();
        }
        let name:Token=self.expect(TokenKind::Ident);let separator:Token=self.expect(TokenKind::KwIn);
        if self.error_count != 0 { return 0; }
        let start:usize=self.parse_expression();self.expect(TokenKind::DotDot);
        let finish:usize=self.parse_expression();
        if start == 0 || finish == 0 || self.error_count != 0 || !self.match_token(TokenKind::OpenBrace) { self.reject_current();return 0; }
        let user_body:usize=self.parse_block();if user_body == 0 { return 0; }
        let outer:usize=self.alloc_node(AstKind::Block,keyword.span);
        // Reserved keyword spellings are hygienic hidden binding names.
        let cursor:usize=self.alloc_text_node(AstKind::LetStmt,keyword);
        let limit:usize=self.alloc_text_node(AstKind::LetStmt,separator);
        let repeating:usize=self.alloc_node(AstKind::WhileStmt,keyword.span);
        let body:usize=self.alloc_node(AstKind::Block,keyword.span);
        let binding:usize=self.alloc_text_node(AstKind::LetStmt,name);
        let increment:usize=self.alloc_node(AstKind::AssignStmt,keyword.span);
        if outer == 0 || cursor == 0 || limit == 0 || repeating == 0 || body == 0 || binding == 0 || increment == 0 { return 0; }
        unsafe{(*(self.nodes+cursor)).int_value=1;(*(self.nodes+repeating)).int_value=1;
            if mutable { (*(self.nodes+binding)).int_value=1; }}
        let mut compare:Token=keyword;compare.kind=TokenKind::Lt;
        let condition_left:usize=self.name_expression(keyword);let condition_right:usize=self.name_expression(separator);
        let condition:usize=self.make_binary(condition_left,compare,condition_right);
        let mut plus:Token=keyword;plus.kind=TokenKind::Plus;
        let next_left:usize=self.name_expression(keyword);let one:usize=self.generated_integer(keyword.span,1);
        let next:usize=self.make_binary(next_left,plus,one);
        if condition == 0 || next == 0
            || !self.append_child(cursor,start) || !self.append_child(limit,finish)
            || !self.append_child(binding,self.name_expression(keyword))
            || !self.append_child(increment,self.name_expression(keyword)) || !self.append_child(increment,next)
            || !self.append_child(body,binding) || !self.append_child(body,increment) || !self.append_child(body,user_body)
            || !self.append_child(repeating,condition) || !self.append_child(repeating,body)
            || !self.append_child(outer,cursor) || !self.append_child(outer,limit) || !self.append_child(outer,repeating) { return 0; }
        return outer;
    }

    pub fn parse_expression_statement(mut self: &mut Self) -> usize {
        let left: usize = self.parse_expression();
        if left == 0 {
            return 0;
        }
        return self.finish_expression_statement(left);
    }

    pub fn finish_expression_statement(mut self: &mut Self, left: usize) -> usize {
        if self.match_token(TokenKind::Equal) || self.match_token(TokenKind::PlusEqual)
            || self.match_token(TokenKind::MinusEqual) || self.match_token(TokenKind::StarEqual)
            || self.match_token(TokenKind::SlashEqual)
            || self.match_token(TokenKind::PercentEqual) || self.match_token(TokenKind::AmpEqual)
            || self.match_token(TokenKind::PipeEqual) || self.match_token(TokenKind::CaretEqual)
            || self.match_token(TokenKind::ShlEqual) || self.match_token(TokenKind::ShrEqual) {
            let assign_tok: Token = self.advance();
            let assign_node: usize = self.alloc_node(AstKind::AssignStmt, assign_tok.span);
            if assign_node == 0 {
                return 0;
            }
            let mut right: usize = self.parse_expression();
            if right == 0 { return 0; }
            if assign_tok.kind != TokenKind::Equal {
                // Only a name can be safely desugared without evaluating a
                // side-effecting address twice. General places remain gated.
                let original: AstNode=unsafe{*(self.nodes+left)};
                if original.kind != AstKind::ExprIdent { self.reject_current();return 0; }
                let copied: usize=self.alloc_node(AstKind::ExprIdent,original.span);
                if copied == 0 { return 0; }
                unsafe{(*(self.nodes+copied)).str_offset=original.str_offset;(*(self.nodes+copied)).str_len=original.str_len;}
                let mut operation: Token=assign_tok;
                if assign_tok.kind == TokenKind::PlusEqual { operation.kind=TokenKind::Plus; }
                if assign_tok.kind == TokenKind::MinusEqual { operation.kind=TokenKind::Minus; }
                if assign_tok.kind == TokenKind::StarEqual { operation.kind=TokenKind::Star; }
                if assign_tok.kind == TokenKind::SlashEqual { operation.kind=TokenKind::Slash; }
                if assign_tok.kind == TokenKind::PercentEqual { operation.kind=TokenKind::Percent; }
                if assign_tok.kind == TokenKind::AmpEqual { operation.kind=TokenKind::Amp; }
                if assign_tok.kind == TokenKind::PipeEqual { operation.kind=TokenKind::Pipe; }
                if assign_tok.kind == TokenKind::CaretEqual { operation.kind=TokenKind::Caret; }
                if assign_tok.kind == TokenKind::ShlEqual { operation.kind=TokenKind::Shl; }
                if assign_tok.kind == TokenKind::ShrEqual { operation.kind=TokenKind::Shr; }
                right=self.make_binary(copied,operation,right);if right == 0 { return 0; }
            }
            if !self.append_child(assign_node, left) {
                return 0;
            }
            if !self.append_child(assign_node, right) {
                return 0;
            }
            if !self.match_token(TokenKind::SemiColon) {
                self.reject_current();
                return 0;
            }
            self.advance();
            return assign_node;
        }

        if !self.match_token(TokenKind::SemiColon) {
            self.reject_current();
            return 0;
        }
        self.advance();
        return left;
    }

    pub fn parse_statement(mut self: &mut Self) -> usize {
        let tok: Token = self.current();
        if tok.kind == TokenKind::OpenBrace { return self.parse_block(); }
        if tok.kind == TokenKind::KwFor { return self.range_for_statement(tok); }
        if tok.kind == TokenKind::KwLoop {
            self.advance();let loop_node:usize=self.alloc_node(AstKind::WhileStmt,tok.span);
            let mut equal:Token=tok;equal.kind=TokenKind::EqEq;
            let left:usize=self.generated_integer(tok.span,1);let right:usize=self.generated_integer(tok.span,1);
            let condition:usize=self.make_binary(left,equal,right);
            if !self.match_token(TokenKind::OpenBrace) { self.reject_current();return 0; }
            let body:usize=self.parse_block();
            if loop_node == 0 || condition == 0 || body == 0
                || !self.append_child(loop_node,condition) || !self.append_child(loop_node,body) { return 0; }
            unsafe{(*(self.nodes+loop_node)).int_value=2;}return loop_node;
        }
        if tok.kind == TokenKind::KwMatch { return self.parse_match_statement(); }
        if tok.kind == TokenKind::KwLet || tok.kind == TokenKind::KwVar {
            self.advance();
            let let_node: usize = self.alloc_node(AstKind::LetStmt, tok.span);
            if let_node == 0 {
                return 0;
            }

            let mut is_mutable: bool = tok.kind == TokenKind::KwVar;
            if self.match_token(TokenKind::KwMut) {
                self.advance();
                is_mutable = true;
            }

            let name_tok: Token = self.current();
            if name_tok.kind != TokenKind::Ident {
                self.expect(TokenKind::Ident);
                return 0;
            }
            self.advance();
            if !self.set_node_text(let_node, name_tok) {
                return 0;
            }

            let mut stored_node: AstNode = unsafe { *(self.nodes + let_node) };
            if is_mutable {
                stored_node.int_value = 1;
            }
            unsafe {
                *(self.nodes + let_node) = stored_node;
            }

            if self.match_token(TokenKind::Colon) {
                self.advance();
                if self.is_at_end()
                    || self.match_token(TokenKind::Equal)
                    || self.match_token(TokenKind::SemiColon) {
                    return 0;
                }

                let type_node: usize = self.parse_type_ref(1);
                if type_node == 0 {
                    return 0;
                }
                if !self.append_child(let_node, type_node) {
                    return 0;
                }
            }

            if self.match_token(TokenKind::Equal) {
                self.advance();
                let val_node: usize = self.parse_expression();
                if val_node == 0 || !self.append_child(let_node, val_node) {
                    return 0;
                }
            }

            if !self.match_token(TokenKind::SemiColon) {
                self.reject_current();
                return 0;
            }
            self.advance();
            return let_node;
        } else if tok.kind == TokenKind::KwReturn {
            self.advance();
            let ret_node: usize = self.alloc_node(AstKind::ReturnStmt, tok.span);
            if ret_node == 0 {
                return 0;
            }
            if !self.match_token(TokenKind::SemiColon) {
                let expr_node: usize = self.parse_expression();
                if expr_node == 0 || !self.append_child(ret_node, expr_node) {
                    return 0;
                }
            }
            self.expect(TokenKind::SemiColon);
            return ret_node;
        } else if tok.kind == TokenKind::KwBreak {
            self.advance();
            let break_node: usize = self.alloc_node(AstKind::BreakStmt, tok.span);
            if break_node == 0 {
                return 0;
            }
            if !self.match_token(TokenKind::SemiColon) {
                return 0;
            }
            self.advance();
            return break_node;
        } else if tok.kind == TokenKind::KwContinue {
            self.advance();
            let continue_node: usize = self.alloc_node(AstKind::ContinueStmt, tok.span);
            if continue_node == 0 {
                return 0;
            }
            if !self.match_token(TokenKind::SemiColon) {
                return 0;
            }
            self.advance();
            return continue_node;
        } else if tok.kind == TokenKind::KwAsm {
            self.advance();
            let asm_node: usize = self.alloc_node(AstKind::AsmStmt, tok.span);
            if self.match_token(TokenKind::KwVolatile) {
                self.advance();
            }
            self.expect(TokenKind::OpenParen);
            self.expect(TokenKind::StrLit);
            self.expect(TokenKind::CloseParen);
            self.expect(TokenKind::SemiColon);
            return asm_node;
        } else if tok.kind == TokenKind::KwUnsafe {
            self.advance();
            let unsafe_node: usize = self.alloc_node(AstKind::UnsafeBlock, tok.span);
            if unsafe_node == 0 {
                return 0;
            }
            if self.match_token(TokenKind::OpenBrace) {
                let body_node: usize = self.parse_block();
                if body_node == 0 || !self.append_child(unsafe_node, body_node) {
                    return 0;
                }
            }
            return unsafe_node;
        } else if tok.kind == TokenKind::KwClinch {
            self.advance();
            let clinch_node: usize = self.alloc_node(AstKind::ClinchStmt, tok.span);
            if clinch_node == 0 {
                return 0;
            }
            if self.match_token(TokenKind::OpenBrace) {
                let body_node: usize = self.parse_block();
                if body_node == 0 || !self.append_child(clinch_node, body_node) {
                    return 0;
                }
            }
            if self.match_token(TokenKind::KwRevert) {
                self.advance();
                if self.match_token(TokenKind::OpenBrace) {
                    let revert_node: usize = self.parse_block();
                    if revert_node == 0 || !self.append_child(clinch_node, revert_node) {
                        return 0;
                    }
                }
            }
            return clinch_node;
        } else if tok.kind == TokenKind::KwDiscern {
            self.advance();
            let discern_node: usize = self.alloc_node(AstKind::DiscernStmt, tok.span);
            let _target: usize = self.parse_expression();
            if self.match_token(TokenKind::OpenBrace) {
                self.advance();
                while !self.is_at_end() && !self.match_token(TokenKind::CloseBrace) {
                    self.advance();
                }
                self.expect(TokenKind::CloseBrace);
            }
            return discern_node;
        } else if tok.kind == TokenKind::KwIf {
            self.advance();
            let if_node: usize = self.alloc_node(AstKind::IfStmt, tok.span);
            if if_node == 0 {
                return 0;
            }
            let cond_node: usize = self.parse_expression();
            if cond_node == 0 || !self.append_child(if_node, cond_node) {
                return 0;
            }
            if self.match_token(TokenKind::OpenBrace) {
                let then_node: usize = self.parse_block();
                if then_node == 0 || !self.append_child(if_node, then_node) {
                    return 0;
                }
            }
            if self.match_token(TokenKind::KwElse) {
                self.advance();
                if self.match_token(TokenKind::OpenBrace) {
                    let else_node: usize = self.parse_block();
                    if else_node == 0 || !self.append_child(if_node, else_node) {
                        return 0;
                    }
                } else if self.match_token(TokenKind::KwIf) {
                    let else_if_node: usize = self.parse_statement();
                    if else_if_node == 0 || !self.append_child(if_node, else_if_node) {
                        return 0;
                    }
                }
            }
            return if_node;
        } else if tok.kind == TokenKind::KwWhile {
            self.advance();
            let while_node: usize = self.alloc_node(AstKind::WhileStmt, tok.span);
            if while_node == 0 {
                return 0;
            }
            let cond_node: usize = self.parse_expression();
            if cond_node == 0 || !self.append_child(while_node, cond_node) {
                return 0;
            }
            if self.match_token(TokenKind::OpenBrace) {
                let body_node: usize = self.parse_block();
                if body_node == 0 || !self.append_child(while_node, body_node) {
                    return 0;
                }
            }
            return while_node;
        } else if tok.kind == TokenKind::KwDefer {
            self.advance();
            let defer_node: usize = self.alloc_node(AstKind::DeferStmt, tok.span);
            if defer_node == 0 {
                return 0;
            }
            let mut payload_node: usize = 0;
            if self.match_token(TokenKind::OpenBrace) {
                payload_node = self.parse_block();
            } else {
                payload_node = self.parse_expression_statement();
            }
            if payload_node == 0 {
                return 0;
            }
            if !self.append_child(defer_node, payload_node) {
                return 0;
            }
            return defer_node;
        }
        return self.parse_expression_statement();
    }

    pub fn parse_declaration(mut self: &mut Self) -> usize {
        while self.match_token(TokenKind::At) {
            self.advance();
            if !self.is_at_end() && !self.match_token(TokenKind::OpenParen) && !self.match_token(TokenKind::At) && !self.match_token(TokenKind::SemiColon) {
                self.advance();
            }
            if self.match_token(TokenKind::OpenParen) {
                self.advance();
                while !self.is_at_end() && !self.match_token(TokenKind::CloseParen) {
                    self.advance();
                }
                if self.match_token(TokenKind::CloseParen) {
                    self.advance();
                }
            }
        }
        let tok: Token = self.current();
        if tok.kind == TokenKind::KwPub {
            self.advance();
            while self.match_token(TokenKind::At) {
                self.advance();
                if !self.is_at_end() && !self.match_token(TokenKind::OpenParen) && !self.match_token(TokenKind::At) && !self.match_token(TokenKind::SemiColon) {
                    self.advance();
                }
                if self.match_token(TokenKind::OpenParen) {
                    self.advance();
                    while !self.is_at_end() && !self.match_token(TokenKind::CloseParen) {
                        self.advance();
                    }
                    if self.match_token(TokenKind::CloseParen) {
                        self.advance();
                    }
                }
            }
        }
        let inner: Token = self.current();
        if inner.kind == TokenKind::KwFn || inner.kind == TokenKind::KwTrapfn {
            self.advance();
            let mut fn_kind: AstKind = AstKind::FnDecl;
            if inner.kind == TokenKind::KwTrapfn {
                fn_kind = AstKind::TrapfnDecl;
            }
            let fn_node: usize = self.alloc_node(fn_kind, inner.span);
            if fn_node == 0 {
                return 0;
            }
            let name_tok: Token = self.expect(TokenKind::Ident);
            if self.error_count != 0 || !self.set_node_text(fn_node, name_tok) {
                return 0;
            }
            if self.match_token(TokenKind::OpenParen) {
                self.advance();

                while !self.is_at_end() && !self.match_token(TokenKind::CloseParen) {
                    let mut param_mutable: bool = false;
                    if self.match_token(TokenKind::KwMut) {
                        self.advance();
                        param_mutable = true;
                    }

                    let param_name: Token = self.current();
                    if param_name.kind != TokenKind::Ident {
                        self.expect(TokenKind::Ident);
                        return 0;
                    }
                    self.advance();

                    let param_node: usize = self.alloc_node(AstKind::ParamDecl, param_name.span);
                    if param_node == 0 || !self.set_node_text(param_node, param_name) {
                        return 0;
                    }
                    if param_mutable {
                        let mut stored_param: AstNode = unsafe { *(self.nodes + param_node) };
                        stored_param.int_value = 1;
                        unsafe {
                            *(self.nodes + param_node) = stored_param;
                        }
                    }

                    if !self.match_token(TokenKind::Colon) {
                        self.reject_current();
                        return 0;
                    }
                    self.advance();
                    if self.is_at_end()
                        || self.match_token(TokenKind::Comma)
                        || self.match_token(TokenKind::CloseParen) {
                        return 0;
                    }

                    let param_type: usize = self.parse_type_ref(2);
                    if param_type == 0 {
                        return 0;
                    }
                    if !self.append_child(param_node, param_type) {
                        return 0;
                    }
                    if !self.append_child(fn_node, param_node) {
                        return 0;
                    }

                    if self.match_token(TokenKind::Comma) {
                        self.advance();
                    } else {
                        break;
                    }
                }

                if !self.match_token(TokenKind::CloseParen) {
                    self.reject_current();
                    return 0;
                }
                self.advance();
            }
            if self.match_token(TokenKind::Arrow) {
                self.advance();
                if self.is_at_end()
                    || self.match_token(TokenKind::OpenBrace)
                    || self.match_token(TokenKind::SemiColon) {
                    self.reject_current();
                    return 0;
                }

                let type_node: usize = self.parse_type_ref(3);
                if type_node == 0 {
                    return 0;
                }
                if !self.append_child(fn_node, type_node) {
                    return 0;
                }
            }
            if fn_node == 0 {
                return 0;
            }
            if self.match_token(TokenKind::OpenBrace) {
                let body_node: usize = self.parse_block();
                if body_node == 0 {
                    return 0;
                }
                if !self.append_child(fn_node, body_node) {
                    return 0;
                }
            } else if self.match_token(TokenKind::SemiColon) {
                self.advance();
            }
            return fn_node;
        } else if inner.kind == TokenKind::KwStruct || inner.kind == TokenKind::KwMesh || inner.kind == TokenKind::KwSpec {
            self.advance();
            let mut struct_kind: AstKind = AstKind::StructDecl;
            if inner.kind == TokenKind::KwMesh {
                struct_kind = AstKind::MeshDecl;
            }
            let struct_node: usize = self.alloc_node(struct_kind, inner.span);
            let name_tok: Token = self.expect(TokenKind::Ident);
            if !self.set_node_text(struct_node, name_tok) {
                return 0;
            }
            if self.match_token(TokenKind::OpenBrace) {
                self.advance();
                if inner.kind == TokenKind::KwStruct {
                    while !self.is_at_end() && !self.match_token(TokenKind::CloseBrace) {
                        if self.match_token(TokenKind::KwPub) {
                            self.advance();
                        }
                        let field_name: Token = self.current();
                        if field_name.kind != TokenKind::Ident {
                            self.reject_current();
                            return 0;
                        }
                        self.advance();

                        let field_node: usize = self.alloc_node(AstKind::FieldDecl, field_name.span);
                        if field_node == 0 || !self.set_node_text(field_node, field_name) {
                            return 0;
                        }
                        if !self.match_token(TokenKind::Colon) {
                            self.reject_current();
                            return 0;
                        }
                        self.advance();
                        if self.is_at_end()
                            || self.match_token(TokenKind::SemiColon)
                            || self.match_token(TokenKind::Comma)
                            || self.match_token(TokenKind::CloseBrace) {
                            self.reject_current();
                            return 0;
                        }

                        let field_type: usize = self.parse_type_ref(4);
                        if field_type == 0 || !self.append_child(field_node, field_type) {
                            return 0;
                        }
                        if !self.match_token(TokenKind::SemiColon) {
                            if self.error_count == 0 {
                                self.error_line = field_name.span.line;
                                self.error_col = field_name.span.col;
                            }
                            self.error_count = self.error_count + 1;
                            return 0;
                        }
                        self.advance();
                        if !self.append_child(struct_node, field_node) {
                            return 0;
                        }
                    }
                    if !self.match_token(TokenKind::CloseBrace) {
                        return 0;
                    }
                    self.advance();
                } else {
                    if !self.match_token(TokenKind::CloseBrace) {
                        // Mesh/spec members remain outside this native subset.
                        self.reject_current();
                        return 0;
                    }
                    self.advance();
                }
            }
            return struct_node;
        } else if inner.kind == TokenKind::KwEnum {
            self.advance();
            let enum_node: usize = self.alloc_node(AstKind::EnumDecl, inner.span);
            if enum_node == 0 {
                return 0;
            }
            let name_tok: Token = self.expect(TokenKind::Ident);
            if !self.set_node_text(enum_node, name_tok) {
                return 0;
            }
            if self.match_token(TokenKind::OpenBrace) {
                self.advance();
                while !self.is_at_end() && !self.match_token(TokenKind::CloseBrace) {
                    let variant_name: Token = self.current();
                    if variant_name.kind != TokenKind::Ident {
                        self.reject_current();
                        return 0;
                    }
                    self.advance();

                    let variant_node: usize = self.alloc_node(AstKind::EnumVariant, variant_name.span);
                    if variant_node == 0 || !self.set_node_text(variant_node, variant_name) {
                        return 0;
                    }

                    if self.match_token(TokenKind::OpenParen) {
                        self.advance();
                        while !self.is_at_end() && !self.match_token(TokenKind::CloseParen) {
                            let payload: usize = self.parse_type_ref(2);
                            if payload == 0 || !self.append_child(variant_node,payload) { return 0; }
                            if self.match_token(TokenKind::Comma) { self.advance(); }
                            else if !self.match_token(TokenKind::CloseParen) { self.reject_current();return 0; }
                        }
                        if !self.match_token(TokenKind::CloseParen) { self.reject_current();return 0; }
                        self.advance();
                    } else if self.match_token(TokenKind::Equal) {
                        self.advance();let value_tok:Token=self.current();
                        if value_tok.kind != TokenKind::IntLit { self.reject_current();return 0; }
                        self.advance();let value_node:usize=self.alloc_text_node(AstKind::ExprLiteral,value_tok);
                        if value_node == 0 || !self.append_child(variant_node,value_node) { return 0; }
                    } else if !self.match_token(TokenKind::Comma) && !self.match_token(TokenKind::CloseBrace) {
                        self.reject_current();return 0;
                    }
                    if !self.append_child(enum_node, variant_node) {
                        return 0;
                    }

                    if self.match_token(TokenKind::Comma) {
                        self.advance();
                    } else if !self.match_token(TokenKind::CloseBrace) {
                        self.reject_current();
                        return 0;
                    }
                }
                if !self.match_token(TokenKind::CloseBrace) {
                    return 0;
                }
                self.advance();
            }
            return enum_node;
        } else if inner.kind == TokenKind::KwImpl {
            self.advance();
            let impl_node: usize = self.alloc_node(AstKind::ImplDecl, inner.span);
            if impl_node == 0 {
                return 0;
            }

            let target_tok: Token = self.current();
            if target_tok.kind != TokenKind::Ident {
                self.reject_current();
                return 0;
            }
            self.advance();
            if !self.set_node_text(impl_node, target_tok) {
                return 0;
            }

            if !self.match_token(TokenKind::OpenBrace) {
                self.reject_current();
                return 0;
            }
            self.advance();

            while !self.is_at_end() && !self.match_token(TokenKind::CloseBrace) {
                let before: usize = self.cursor;
                let member_index: usize = self.parse_declaration();
                if member_index == 0 || member_index >= self.node_count {
                    return 0;
                }
                let member: AstNode = unsafe { *(self.nodes + member_index) };
                if member.kind != AstKind::FnDecl {
                    if self.error_count == 0 {
                        self.error_line = member.span.line;
                        self.error_col = member.span.col;
                    }
                    self.error_count = self.error_count + 1;
                    return 0;
                }
                if !self.append_child(impl_node, member_index) {
                    return 0;
                }
                if self.cursor <= before {
                    return 0;
                }
            }

            if !self.match_token(TokenKind::CloseBrace) {
                self.reject_current();
                return 0;
            }
            self.advance();
            return impl_node;
        } else if inner.kind == TokenKind::KwImport {
            self.advance();
            let imp_node: usize = self.alloc_node(AstKind::Import, inner.span);
            while !self.is_at_end() && !self.match_token(TokenKind::SemiColon) {
                self.advance();
            }
            self.expect(TokenKind::SemiColon);
            return imp_node;
        } else if inner.kind == TokenKind::KwConst || inner.kind == TokenKind::KwStatic {
            self.advance();
            let decl_node: usize = self.alloc_node(AstKind::LetStmt, inner.span);
            if decl_node == 0 {
                return 0;
            }
            let mut is_mutable: bool = false;
            if self.match_token(TokenKind::KwMut) {
                self.advance();
                is_mutable = true;
            }
            let name_tok: Token = self.current();
            if name_tok.kind != TokenKind::Ident {
                self.expect(TokenKind::Ident);
                return 0;
            }
            self.advance();
            if !self.set_node_text(decl_node, name_tok) {
                return 0;
            }
            let mut stored_node: AstNode = unsafe { *(self.nodes + decl_node) };
            if is_mutable {
                stored_node.int_value = 1;
            }
            unsafe {
                *(self.nodes + decl_node) = stored_node;
            }
            if self.match_token(TokenKind::Colon) {
                self.advance();
                if self.is_at_end()
                    || self.match_token(TokenKind::Equal)
                    || self.match_token(TokenKind::SemiColon) {
                    return 0;
                }
                let type_node: usize = self.parse_type_ref(1);
                if type_node == 0 {
                    return 0;
                }
                if !self.append_child(decl_node, type_node) {
                    return 0;
                }
            }
            if self.match_token(TokenKind::Equal) {
                self.advance();
                let val_node: usize = self.parse_expression();
                if val_node == 0 || !self.append_child(decl_node, val_node) {
                    return 0;
                }
            }
            if !self.match_token(TokenKind::SemiColon) {
                self.reject_current();
                return 0;
            }
            self.advance();
            return decl_node;
        }
        return self.parse_statement();
    }

    pub fn parse_primary_expression(mut self: &mut Self) -> usize {
        let tok: Token = self.current();
        if tok.kind == TokenKind::KwMatch { return self.parse_match(true); }
        if tok.kind != TokenKind::IntLit && tok.kind != TokenKind::FloatLit
            && tok.kind != TokenKind::StrLit && tok.kind != TokenKind::CharLit
            && tok.kind != TokenKind::BoolLit
            && tok.kind != TokenKind::OpenBracket && tok.kind != TokenKind::Ident
            && tok.kind != TokenKind::OpenParen
            && tok.kind != TokenKind::KwUnsafe && tok.kind != TokenKind::KwIf {
            self.record_unexpected(tok);
            return 0;
        }
        self.advance();
        if tok.kind == TokenKind::IntLit || tok.kind == TokenKind::FloatLit
            || tok.kind == TokenKind::StrLit || tok.kind == TokenKind::CharLit
            || tok.kind == TokenKind::BoolLit {
            return self.alloc_text_node(AstKind::ExprLiteral, tok);
        }

        if tok.kind == TokenKind::KwIf {
            let conditional: usize = self.alloc_node(AstKind::ExprConditional, tok.span);
            let condition: usize = self.parse_expression();
            if conditional == 0 || condition == 0 || !self.match_token(TokenKind::OpenBrace) { self.reject_current(); return 0; }
            self.advance(); let yes: usize = self.parse_expression();
            if yes == 0 || !self.match_token(TokenKind::CloseBrace) { self.reject_current(); return 0; }
            self.advance();
            if !self.match_token(TokenKind::KwElse) { self.expect(TokenKind::KwElse); return 0; }
            self.advance(); let mut no: usize = 0;
            if self.match_token(TokenKind::OpenBrace) {
                self.advance(); no = self.parse_expression();
                if no == 0 || !self.match_token(TokenKind::CloseBrace) { self.reject_current(); return 0; }
                self.advance();
            } else { no = self.parse_expression(); }
            if no == 0 || !self.append_child(conditional, condition)
                || !self.append_child(conditional, yes) || !self.append_child(conditional, no) { return 0; }
            return conditional;
        }

        if tok.kind == TokenKind::KwUnsafe {
            let unsafe_node: usize = self.alloc_node(AstKind::UnsafeExpr, tok.span);
            if unsafe_node == 0 || !self.match_token(TokenKind::OpenBrace) {
                self.reject_current();
                return 0;
            }
            self.advance();
            let value_node: usize = self.parse_expression();
            if value_node == 0 || !self.match_token(TokenKind::CloseBrace) {
                self.reject_current();
                return 0;
            }
            self.advance();
            if !self.append_child(unsafe_node, value_node) {
                return 0;
            }
            return unsafe_node;
        }

        if tok.kind == TokenKind::OpenBracket {
            let repeat_node: usize = self.alloc_node(AstKind::ExprArrayRepeat, tok.span);
            if repeat_node == 0 || self.match_token(TokenKind::CloseBracket) {
                return 0;
            }
            let value_node: usize = self.parse_expression();
            if value_node != 0 && (self.match_token(TokenKind::Comma) || self.match_token(TokenKind::CloseBracket)) {
                unsafe { (*(self.nodes + repeat_node)).kind = AstKind::ExprArrayLiteral; }
                if !self.append_child(repeat_node, value_node) { return 0; }
                while self.match_token(TokenKind::Comma) {
                    self.advance();
                    if self.match_token(TokenKind::CloseBracket) { break; }
                    let element: usize = self.parse_expression();
                    if element == 0 || !self.append_child(repeat_node, element) { return 0; }
                }
                if !self.match_token(TokenKind::CloseBracket) { self.reject_current(); return 0; }
                self.advance(); return repeat_node;
            }
            if value_node == 0 || !self.match_token(TokenKind::SemiColon) {
                return 0;
            }
            self.advance();
            let count_tok: Token = self.current();
            if count_tok.kind != TokenKind::IntLit {
                self.reject_current();
                return 0;
            }
            self.advance();
            let count_node: usize = self.alloc_text_node(AstKind::ExprLiteral, count_tok);
            if count_node == 0 || !self.match_token(TokenKind::CloseBracket) {
                return 0;
            }
            self.advance();
            if !self.append_child(repeat_node, value_node)
                || !self.append_child(repeat_node, count_node) {
                return 0;
            }
            return repeat_node;
        }

        if tok.kind == TokenKind::Ident {
            // A bounded struct literal is recognized only when the opening
            // brace begins with an explicit named field.  This avoids stealing
            // `{` from `if cond { ... }` / `while cond { ... }`.
            if self.starts_struct_literal() {
                let literal_node: usize = self.alloc_node(AstKind::ExprStructLiteral, tok.span);
                if literal_node == 0 || !self.set_node_text(literal_node, tok) {
                    return 0;
                }
                self.advance(); // {

                while !self.is_at_end() && !self.match_token(TokenKind::CloseBrace) {
                    let field_tok: Token = self.current();
                    if field_tok.kind != TokenKind::Ident {
                        self.reject_current();
                        return 0;
                    }
                    self.advance();
                    let field_node: usize = self.alloc_node(AstKind::StructFieldInit, field_tok.span);
                    if field_node == 0 || !self.set_node_text(field_node, field_tok) {
                        return 0;
                    }
                    if !self.match_token(TokenKind::Colon) {
                        self.reject_current();
                        return 0;
                    }
                    self.advance();

                    let value_node: usize = self.parse_expression();
                    if value_node == 0 || !self.append_child(field_node, value_node)
                        || !self.append_child(literal_node, field_node) {
                        return 0;
                    }

                    if self.match_token(TokenKind::Comma) {
                        self.advance();
                    } else if !self.match_token(TokenKind::CloseBrace) {
                        self.reject_current();
                        return 0;
                    }
                }
                if !self.match_token(TokenKind::CloseBrace) {
                    self.reject_current();
                    return 0;
                }
                self.advance();
                return literal_node;
            }

            // Do not allocate an ExprIdent until the parser knows this is an
            // unqualified identifier.  Eager allocation would leave a detached
            // prefix node behind for qualified paths such as `Counter::add`.
            let mut callee_node: usize = 0;

            if self.match_token(TokenKind::DColon) {
                let mut path_end: Token = tok;
                while self.match_token(TokenKind::DColon) {
                    self.advance();
                    let segment: Token = self.current();
                    if segment.kind != TokenKind::Ident {
                        return 0;
                    }
                    path_end = self.advance();
                }

                let path_node: usize = self.alloc_node(AstKind::ExprPath, tok.span);
                if path_node == 0 {
                    return 0;
                }
                if !self.set_node_text_range(path_node, tok, path_end) {
                    return 0;
                }
                callee_node = path_node;
            } else {
                callee_node = self.alloc_text_node(AstKind::ExprIdent, tok);
                if callee_node == 0 {
                    return 0;
                }
            }

            let mut current_expr: usize = callee_node;
            while !self.is_at_end() {
                if self.match_token(TokenKind::Dot) {
                    self.advance();
                    let field_tok: Token = self.current();
                    if field_tok.kind != TokenKind::Ident {
                        self.reject_current();
                        return 0;
                    }
                    self.advance();
                    let field_node: usize = self.alloc_node(AstKind::ExprFieldAccess, field_tok.span);
                    if field_node == 0 || !self.set_node_text(field_node, field_tok) {
                        return 0;
                    }
                    if !self.append_child(field_node, current_expr) {
                        return 0;
                    }
                    current_expr = field_node;
                } else if self.match_token(TokenKind::OpenParen) {
                    let call_node: usize = self.alloc_node(AstKind::ExprCall, tok.span);
                    if call_node == 0 {
                        return 0;
                    }
                    if current_expr == callee_node {
                        if !self.append_child(call_node, callee_node) {
                            return 0;
                        }
                    } else {
                        if !self.append_child(call_node, current_expr) {
                            return 0;
                        }
                    }

                    self.advance();
                    while !self.is_at_end() && !self.match_token(TokenKind::CloseParen) {
                        let arg_node: usize = self.parse_expression();
                        if arg_node == 0 {
                            return 0;
                        }
                        if !self.append_child(call_node, arg_node) {
                            return 0;
                        }
                        if self.match_token(TokenKind::Comma) {
                            self.advance();
                        } else {
                            break;
                        }
                    }
                    if !self.match_token(TokenKind::CloseParen) {
                        return 0;
                    }
                    self.advance();
                    current_expr = call_node;
                } else {
                    break;
                }
            }
            return current_expr;
        }

        if tok.kind == TokenKind::OpenParen {
            let inner: usize = self.parse_expression();
            if inner == 0 || !self.match_token(TokenKind::CloseParen) {
                return 0;
            }
            self.advance();
            let mut current_expr: usize = inner;
            while !self.is_at_end() && self.match_token(TokenKind::Dot) {
                self.advance();
                let field_tok: Token = self.current();
                if field_tok.kind != TokenKind::Ident {
                    self.reject_current();
                    return 0;
                }
                self.advance();
                let field_node: usize = self.alloc_node(AstKind::ExprFieldAccess, field_tok.span);
                if field_node == 0 || !self.set_node_text(field_node, field_tok) {
                    return 0;
                }
                if !self.append_child(field_node, current_expr) {
                    return 0;
                }
                current_expr = field_node;
            }
            return current_expr;
        }

        return self.alloc_node(AstKind::ExprLiteral, tok.span);
    }

    pub fn parse_match_value_block(mut self: &mut Self) -> usize {
        let open: Token = self.advance();
        let block: usize = self.alloc_node(AstKind::MatchValueBlock,open.span);
        if block == 0 { return 0; }
        while !self.is_at_end() && !self.match_token(TokenKind::CloseBrace) {
            let token: Token = self.current();
            let mut statement: usize = 0;
            if token.kind == TokenKind::KwLet || token.kind == TokenKind::KwVar
                || token.kind == TokenKind::KwIf || token.kind == TokenKind::KwLoop
                || token.kind == TokenKind::KwWhile || token.kind == TokenKind::KwFor
                || token.kind == TokenKind::KwDefer || token.kind == TokenKind::KwReturn
                || token.kind == TokenKind::KwBreak || token.kind == TokenKind::KwContinue
                || token.kind == TokenKind::KwUnsafe || token.kind == TokenKind::OpenBrace {
                statement=self.parse_statement();
            } else {
                let value: usize = self.parse_expression();
                if value == 0 { return 0; }
                if self.match_token(TokenKind::CloseBrace) {
                    let tail: usize = self.alloc_node(AstKind::MatchYield,token.span);
                    if tail == 0 || !self.append_child(tail,value) || !self.append_child(block,tail) { return 0; }
                    self.advance();return block;
                }
                statement=self.finish_expression_statement(value);
            }
            if statement == 0 || !self.append_child(block,statement) { return 0; }
        }
        if self.match_token(TokenKind::CloseBrace) { self.advance();return block; }
        self.reject_current();return 0;
    }

    pub fn parse_match_statement(mut self: &mut Self) -> usize {
        return self.parse_match(false);
    }

    pub fn parse_match_pattern(mut self: &mut Self, depth: usize) -> usize {
        let first: usize = self.parse_match_pattern_atom(depth);
        if first == 0 || !self.match_token(TokenKind::Pipe) { return first; }
        let choice: usize = self.alloc_node(AstKind::PatternOr,unsafe{(*(self.nodes+first)).span});
        if choice == 0 || !self.append_child(choice,first) { return 0; }
        let mut count: usize = 1;
        while self.match_token(TokenKind::Pipe) {
            self.advance();
            if count >= 64 { self.reject_current();return 0; }
            let next: usize = self.parse_match_pattern_atom(depth);
            if next == 0 || !self.append_child(choice,next) { return 0; }
            count=count+1;
        }
        return choice;
    }

    pub fn match_pattern_group(self: &Self) -> bool {
        let mut cursor: usize = self.cursor+1;let mut nesting: usize = 1;let mut patterned: bool = false;
        while cursor < self.token_count && nesting != 0 {
            let kind: TokenKind = unsafe{(*(self.tokens+cursor)).kind};
            if kind == TokenKind::OpenParen {
                if cursor >= 2 && unsafe{(*(self.tokens+cursor-1)).kind} == TokenKind::Ident
                    && unsafe{(*(self.tokens+cursor-2)).kind} == TokenKind::DColon { patterned=true; }
                nesting=nesting+1;
            } else if kind == TokenKind::CloseParen { nesting=nesting-1; }
            if kind == TokenKind::OpenBrace && cursor != 0
                && unsafe{(*(self.tokens+cursor-1)).kind} == TokenKind::Ident { patterned=true; }
            if nesting != 0 && (kind == TokenKind::Pipe || kind == TokenKind::DotDot) { patterned=true; }
            cursor=cursor+1;
        }
        if cursor < self.token_count && unsafe{(*(self.tokens+cursor)).kind} == TokenKind::DotDot { return false; }
        return patterned;
    }

    pub fn parse_match_pattern_atom(mut self: &mut Self, depth: usize) -> usize {
        if depth >= 32 { self.reject_current();return 0; }
        // Keep parenthesized arithmetic range bounds on the expression parser.
        if self.match_token(TokenKind::OpenParen) && self.match_pattern_group() {
            self.advance();let grouped: usize = self.parse_match_pattern(depth+1);
            if grouped == 0 || !self.match_token(TokenKind::CloseParen) { self.reject_current();return 0; }
            self.advance();return grouped;
        }
        let first: Token = self.current();
        let mut pattern: usize = 0;
        let open_start: bool = self.match_token(TokenKind::DotDot);
        if first.kind == TokenKind::Ident && self.cursor+1 < self.token_count
            && unsafe{(*(self.tokens+self.cursor+1)).kind} == TokenKind::OpenBrace {
            self.advance();return self.parse_record_pattern(first,depth);
        } else if first.kind == TokenKind::Ident && self.cursor+1 < self.token_count
            && unsafe{(*(self.tokens+self.cursor+1)).kind} == TokenKind::DColon {
            self.advance();let mut last: Token = first;
            while self.match_token(TokenKind::DColon) {
                self.advance();last=self.expect(TokenKind::Ident);
                if self.error_count != 0 { return 0; }
            }
            let path: usize = self.alloc_node(AstKind::ExprPath,first.span);
            if path == 0 || !self.set_node_text_range(path,first,last) { return 0; }
            pattern=path;
            if self.match_token(TokenKind::OpenParen) {
                self.advance();pattern=self.alloc_node(AstKind::PatternVariant,first.span);
                if pattern == 0 || !self.append_child(pattern,path) { return 0; }
                while !self.is_at_end() && !self.match_token(TokenKind::CloseParen) {
                    let field: usize = self.parse_match_pattern(depth+1);
                    if field == 0 || !self.append_child(pattern,field) { return 0; }
                    if self.match_token(TokenKind::Comma) { self.advance(); }
                    else if !self.match_token(TokenKind::CloseParen) { self.reject_current();return 0; }
                }
                if !self.match_token(TokenKind::CloseParen) { self.reject_current();return 0; }
                self.advance();
            }
        } else if !open_start { pattern=self.parse_unary_expression(); }
        if self.match_token(TokenKind::DotDot) {
            let separator: Token = self.advance();
            let range: usize = self.alloc_node(AstKind::PatternRange,separator.span);
            if range == 0 { return 0; }
            if open_start { unsafe{(*(self.nodes+range)).int_value=2;} }
            if self.match_token(TokenKind::Equal) {
                self.advance();unsafe{(*(self.nodes+range)).int_value=(*(self.nodes+range)).int_value | 1;}
            }
            let missing: bool = self.match_token(TokenKind::FatArrow) || self.match_token(TokenKind::KwIf)
                || self.match_token(TokenKind::Comma) || self.match_token(TokenKind::CloseParen)
                || self.match_token(TokenKind::CloseBrace) || self.match_token(TokenKind::Pipe);
            let mut end: usize = 0;
            if missing { unsafe{(*(self.nodes+range)).int_value=(*(self.nodes+range)).int_value | 4;} }
            else { end=self.parse_unary_expression(); }
            if (!open_start && (pattern == 0 || !self.append_child(range,pattern)))
                || (!missing && (end == 0 || !self.append_child(range,end)))
                || (missing && ((unsafe{(*(self.nodes+range)).int_value} & 1) != 0)) { self.reject_current();return 0; }
            pattern=range;
        }
        return pattern;
    }

    pub fn parse_record_pattern(mut self: &mut Self, name: Token, depth: usize) -> usize {
        let pattern: usize = self.alloc_node(AstKind::PatternRecord,name.span);
        if pattern == 0 || !self.set_node_text(pattern,name) { return 0; }
        self.advance();
        while !self.is_at_end() && !self.match_token(TokenKind::CloseBrace) {
            if self.match_token(TokenKind::DotDot) {
                self.advance();unsafe{(*(self.nodes+pattern)).int_value=1;}
                if self.match_token(TokenKind::Comma) { self.advance(); }
                if !self.match_token(TokenKind::CloseBrace) { self.reject_current();return 0; }
                break;
            }
            let field_name: Token = self.expect(TokenKind::Ident);
            if self.error_count != 0 { return 0; }
            let field: usize = self.alloc_node(AstKind::PatternField,field_name.span);
            if field == 0 || !self.set_node_text(field,field_name) { return 0; }
            let mut value: usize = 0;
            if self.match_token(TokenKind::Colon) {
                self.advance();value=self.parse_match_pattern(depth+1);
            } else {
                value=self.alloc_node(AstKind::ExprIdent,field_name.span);
                if value == 0 || !self.set_node_text(value,field_name) { return 0; }
                // Shorthand is a binding even if a module constant shares its name.
                unsafe{(*(self.nodes+value)).int_value=-1;}
            }
            if value == 0 || !self.append_child(field,value) || !self.append_child(pattern,field) { return 0; }
            if self.match_token(TokenKind::Comma) { self.advance(); }
            else if !self.match_token(TokenKind::CloseBrace) { self.reject_current();return 0; }
        }
        if !self.match_token(TokenKind::CloseBrace) { self.reject_current();return 0; }
        self.advance();return pattern;
    }

    // Distribute choices into bounded decision rows. Bodies/guards retain their
    // source spans; rows from one source arm share a group identifier so a false
    // guard skips the entire group, including overlapping alternatives.
    pub fn match_pattern_choices(self: &Self, pattern: usize, depth: usize) -> usize {
        if pattern == 0 || pattern >= self.node_count || depth >= 32 { return 0; }
        let node: AstNode = unsafe{*(self.nodes+pattern)};
        if node.kind == AstKind::PatternField { return self.match_pattern_choices(node.first_child,depth); }
        if node.kind != AstKind::PatternOr && node.kind != AstKind::PatternVariant
            && node.kind != AstKind::PatternRecord { return 1; }
        let mut child: usize = node.first_child;let mut count: usize = 1;
        if node.kind == AstKind::PatternOr { count=0; }
        else if node.kind == AstKind::PatternVariant && child != 0 { child=unsafe{(*(self.nodes+child)).next_sibling}; }
        while child != 0 && child < self.node_count {
            let ways: usize = self.match_pattern_choices(child,depth+1);
            if ways == 0 { return 0; }
            if node.kind == AstKind::PatternOr { count=count+ways; }
            else { count=count*ways; }
            if count > 64 { return 0; }
            child=unsafe{(*(self.nodes+child)).next_sibling};
        }
        if child != 0 { return 0; }
        return count;
    }

    pub fn clone_match_tree(mut self: &mut Self, index: usize, depth: usize) -> usize {
        if index == 0 || index >= self.node_count || depth >= 128 { return 0; }
        let node: AstNode = unsafe{*(self.nodes+index)};
        let copy: usize = self.alloc_node(node.kind,node.span);
        if copy == 0 { return 0; }
        unsafe{(*(self.nodes+copy)).int_value=node.int_value;
            (*(self.nodes+copy)).str_offset=node.str_offset;(*(self.nodes+copy)).str_len=node.str_len;}
        let mut child: usize = node.first_child;
        while child != 0 && child < self.node_count {
            let cloned: usize = self.clone_match_tree(child,depth+1);
            if cloned == 0 || !self.append_child(copy,cloned) { return 0; }
            child=unsafe{(*(self.nodes+child)).next_sibling};
        }
        if child != 0 { return 0; }
        return copy;
    }

    pub fn clone_match_choice(mut self: &mut Self, pattern: usize, choice: usize, depth: usize) -> usize {
        if pattern == 0 || pattern >= self.node_count || depth >= 32 { return 0; }
        let node: AstNode = unsafe{*(self.nodes+pattern)};
        if node.kind == AstKind::PatternOr {
            let mut ordinal: usize = choice;let mut child: usize = node.first_child;
            while child != 0 && child < self.node_count {
                let ways: usize = self.match_pattern_choices(child,depth+1);
                if ways == 0 { return 0; }
                if ordinal < ways { return self.clone_match_choice(child,ordinal,depth+1); }
                ordinal=ordinal-ways;child=unsafe{(*(self.nodes+child)).next_sibling};
            }
            return 0;
        }
        if node.kind == AstKind::PatternField {
            let field: usize = self.alloc_node(node.kind,node.span);
            let selected: usize = self.clone_match_choice(node.first_child,choice,depth);
            if field == 0 || selected == 0 { return 0; }
            unsafe{(*(self.nodes+field)).str_offset=node.str_offset;(*(self.nodes+field)).str_len=node.str_len;}
            if !self.append_child(field,selected) { return 0; }
            return field;
        }
        if node.kind != AstKind::PatternVariant && node.kind != AstKind::PatternRecord { return self.clone_match_tree(pattern,0); }
        let copy: usize = self.alloc_node(node.kind,node.span);
        if copy == 0 { return 0; }
        unsafe{(*(self.nodes+copy)).str_offset=node.str_offset;(*(self.nodes+copy)).str_len=node.str_len;
            (*(self.nodes+copy)).int_value=node.int_value;}
        let mut ordinal: usize = choice;
        let mut child: usize = node.first_child;
        if node.kind == AstKind::PatternVariant {
            let path: usize = self.clone_match_tree(child,0);
            if path == 0 || !self.append_child(copy,path) { return 0; }
            child=unsafe{(*(self.nodes+child)).next_sibling};
        }
        while child != 0 && child < self.node_count {
            let ways: usize = self.match_pattern_choices(child,depth+1);
            if ways == 0 { return 0; }
            let cloned: usize = self.clone_match_choice(child,ordinal%ways,depth+1);
            if cloned == 0 || !self.append_child(copy,cloned) { return 0; }
            ordinal=ordinal/ways;child=unsafe{(*(self.nodes+child)).next_sibling};
        }
        if child != 0 || ordinal != 0 { return 0; }
        return copy;
    }

    pub fn expand_match_patterns(mut self: &mut Self, statement: usize) -> bool {
        let subject: usize = unsafe{(*(self.nodes+statement)).first_child};
        let first: usize = unsafe{(*(self.nodes+subject)).next_sibling};
        let mut arm: usize = first;let mut total: usize = 0;
        while arm != 0 && arm < self.node_count {
            let ways: usize = self.match_pattern_choices(unsafe{(*(self.nodes+arm)).first_child},0);
            if ways == 0 || total+ways > 64 { self.reject_current();return false; }
            total=total+ways;arm=unsafe{(*(self.nodes+arm)).next_sibling};
        }
        if arm != 0 { return false; }
        arm=first;
        while arm != 0 && arm < self.node_count {
            // A mutable POD local requests a snapshot of this unsafe view.
            // Keep next_sibling stable while rewiring the original row.
            let mut original: AstNode = unsafe{*(self.nodes+arm)};
            let pattern: usize = original.first_child;
            let ways: usize = self.match_pattern_choices(pattern,0);
            if ways > 1 {
                let body: usize = unsafe{(*(self.nodes+pattern)).next_sibling};
                let guard: usize = unsafe{(*(self.nodes+body)).next_sibling};
                let mut rows: [usize;64] = 0;let mut patterns: [usize;64] = 0;
                let mut bodies: [usize;64] = 0;let mut guards: [usize;64] = 0;
                let mut choice: usize = 0;
                while choice < ways {
                    rows[choice]=arm;bodies[choice]=body;guards[choice]=guard;
                    patterns[choice]=self.clone_match_choice(pattern,choice,0);
                    if choice != 0 {
                        rows[choice]=self.alloc_node(AstKind::MatchArm,original.span);
                        bodies[choice]=self.clone_match_tree(body,0);
                        if guard != 0 { guards[choice]=self.clone_match_tree(guard,0); }
                    }
                    if rows[choice] == 0 || patterns[choice] == 0 || bodies[choice] == 0
                        || (guard != 0 && guards[choice] == 0) { self.reject_current();return false; }
                    choice=choice+1;
                }
                choice=0;
                while choice < ways {
                    let row: usize = rows[choice];
                    unsafe{(*(self.nodes+row)).first_child=0;(*(self.nodes+row)).parent=statement;
                        (*(self.nodes+row)).int_value=original.int_value;
                        (*(self.nodes+row)).str_offset=original.span.offset;
                        (*(self.nodes+row)).str_len=ways-choice;
                        (*(self.nodes+patterns[choice])).next_sibling=0;
                        (*(self.nodes+bodies[choice])).parent=0;
                        (*(self.nodes+bodies[choice])).next_sibling=0;
                        if guard != 0 { (*(self.nodes+guards[choice])).parent=0; }}
                    if !self.append_child(row,patterns[choice]) || !self.append_child(row,bodies[choice]) { return false; }
                    if guard != 0 && !self.append_child(row,guards[choice]) { return false; }
                    let mut next: usize = original.next_sibling;
                    if choice+1 < ways { next=rows[choice+1]; }
                    unsafe{(*(self.nodes+row)).next_sibling=next;}
                    choice=choice+1;
                }
            }
            arm=original.next_sibling;
        }
        return true;
    }

    pub fn parse_match(mut self: &mut Self, expression_mode: bool) -> usize {
        let keyword: Token = self.advance();
        let mut kind: AstKind = AstKind::MatchStmt;
        if expression_mode { kind=AstKind::ExprMatch; }
        let statement: usize = self.alloc_node(kind, keyword.span);
        let subject: usize = self.parse_expression();
        if statement == 0 || subject == 0 || !self.append_child(statement, subject)
            || !self.match_token(TokenKind::OpenBrace) { self.reject_current(); return 0; }
        self.advance();
        let mut count: usize = 0;
        while !self.is_at_end() && !self.match_token(TokenKind::CloseBrace) {
            if count >= 64 { self.reject_current(); return 0; }
            let pattern_token: Token = self.current();
            let arm: usize = self.alloc_node(AstKind::MatchArm, pattern_token.span);
            let pattern: usize = self.parse_match_pattern(0);
            let mut guard: usize = 0;
            if self.match_token(TokenKind::KwIf) {
                self.advance();
                guard = self.parse_expression();
                if guard == 0 { self.reject_current(); return 0; }
            }
            if arm == 0 || pattern == 0 || !self.append_child(arm, pattern)
                || !self.match_token(TokenKind::FatArrow) { self.reject_current(); return 0; }
            self.advance();
            let mut body: usize = 0;
            if expression_mode {
                if self.match_token(TokenKind::OpenBrace) { body=self.parse_match_value_block(); }
                else { body=self.parse_expression(); }
            }
            else if self.match_token(TokenKind::OpenBrace) { body = self.parse_block(); }
            else {
                let body_token: Token = self.current();
                body = self.alloc_node(AstKind::Block, body_token.span);
                let statement_body: usize = self.parse_statement();
                if body == 0 || statement_body == 0 || !self.append_child(body, statement_body) { return 0; }
            }
            if body == 0 || !self.append_child(arm, body) { return 0; }
            // Keep the body as the second child for the existing scope/return
            // analysis; an optional third child is the source-level guard.
            if guard != 0 {
                if !self.append_child(arm, guard) { return 0; }
                unsafe { (*(self.nodes + arm)).int_value = 1; }
            }
            if !self.append_child(statement, arm) { return 0; }
            count = count + 1;
            if expression_mode && !self.match_token(TokenKind::Comma)
                && !self.match_token(TokenKind::CloseBrace) { self.reject_current(); return 0; }
            if self.match_token(TokenKind::Comma) { self.advance(); }
        }
        if count == 0 || !self.match_token(TokenKind::CloseBrace) { self.reject_current(); return 0; }
        self.advance();
        if !self.expand_match_patterns(statement) { return 0; }
        return statement;
    }

    pub fn parse_unary_expression(mut self: &mut Self) -> usize {
        if self.match_token(TokenKind::Bang)
            || self.match_token(TokenKind::Minus)
            || self.match_token(TokenKind::Plus)
            || self.match_token(TokenKind::Tilde)
            || self.match_token(TokenKind::Amp)
            || self.match_token(TokenKind::Star) {
            let op: Token = self.advance();
            if op.kind == TokenKind::Amp && self.match_token(TokenKind::KwMut) {
                self.advance();
            }
            let operand: usize = self.parse_unary_expression();
            if operand == 0 {
                self.record_unexpected(self.current());
                return 0;
            }
            let node: usize = self.alloc_node(AstKind::ExprUnary, op.span);
            if node == 0 {
                return 0;
            }
            let mut unary_node: AstNode = unsafe { *(self.nodes + node) };
            unary_node.int_value = self.operator_tag(op.kind);
            unsafe {
                *(self.nodes + node) = unary_node;
            }
            if !self.append_child(node, operand) {
                return 0;
            }
            return node;
        }
        return self.parse_postfix_expression();
    }

    pub fn parse_postfix_expression(mut self: &mut Self) -> usize {
        let mut expr: usize = self.parse_primary_expression();
        if expr == 0 {
            return 0;
        }

        while self.match_token(TokenKind::Qmark) || self.match_token(TokenKind::KwAs) {
            if self.match_token(TokenKind::Qmark) {
                let qmark: Token = self.advance();
                let try_node: usize = self.alloc_node(AstKind::TryExpr, qmark.span);
                if try_node == 0 || !self.append_child(try_node, expr) {
                    return 0;
                }
                expr = try_node;
            } else {
                let as_token: Token = self.advance();
                let cast_node: usize = self.alloc_node(AstKind::ExprCast, as_token.span);
                if cast_node == 0 || !self.append_child(cast_node, expr) {
                    return 0;
                }
                let cast_type: usize = self.parse_type_ref(5);
                if cast_type == 0 || !self.append_child(cast_node, cast_type) {
                    return 0;
                }
                expr = cast_node;
            }
        }
        while self.match_token(TokenKind::OpenBracket) || self.match_token(TokenKind::Dot) {
            if self.match_token(TokenKind::Dot) {
                self.advance();
                let field: Token = self.current();
                if field.kind != TokenKind::Ident { self.reject_current(); return 0; }
                self.advance();
                let access: usize = self.alloc_node(AstKind::ExprFieldAccess, field.span);
                if access == 0 || !self.set_node_text(access, field) || !self.append_child(access, expr) { return 0; }
                expr = access;
                continue;
            }
            let open: Token = self.advance();
            let index_expr: usize = self.parse_expression();
            if index_expr == 0 || !self.match_token(TokenKind::CloseBracket) {
                self.record_unexpected(self.current());
                return 0;
            }
            self.advance();
            let index_node: usize = self.alloc_node(AstKind::ExprIndex, open.span);
            if index_node == 0 || !self.append_child(index_node, expr)
                || !self.append_child(index_node, index_expr) {
                return 0;
            }
            expr = index_node;
        }
        while self.match_token(TokenKind::Qmark) || self.match_token(TokenKind::KwAs) {
            if self.match_token(TokenKind::Qmark) {
                let qmark: Token = self.advance();
                let try_node: usize = self.alloc_node(AstKind::TryExpr, qmark.span);
                if try_node == 0 || !self.append_child(try_node, expr) { return 0; }
                expr = try_node;
            } else {
                let as_token: Token = self.advance();
                let cast_node: usize = self.alloc_node(AstKind::ExprCast, as_token.span);
                if cast_node == 0 || !self.append_child(cast_node, expr) { return 0; }
                let cast_type: usize = self.parse_type_ref(5);
                if cast_type == 0 || !self.append_child(cast_node, cast_type) { return 0; }
                expr = cast_node;
            }
        }
        return expr;
    }

    pub fn parse_multiplicative_expression(mut self: &mut Self) -> usize {
        let mut left: usize = self.parse_unary_expression();
        while self.match_token(TokenKind::Star)
            || self.match_token(TokenKind::Slash)
            || self.match_token(TokenKind::Percent) {
            let op: Token = self.advance();
            let right: usize = self.parse_unary_expression();
            left = self.make_binary(left, op, right);
            if left == 0 {
                return 0;
            }
        }
        return left;
    }

    pub fn parse_additive_expression(mut self: &mut Self) -> usize {
        let mut left: usize = self.parse_multiplicative_expression();
        if left == 0 {
            return 0;
        }
        while self.match_token(TokenKind::Plus)
            || self.match_token(TokenKind::Minus) {
            let op: Token = self.advance();
            let right: usize = self.parse_multiplicative_expression();
            if right == 0 {
                self.record_unexpected(self.current());
                return 0;
            }
            left = self.make_binary(left, op, right);
            if left == 0 {
                return 0;
            }
        }
        return left;
    }

    pub fn parse_comparison_expression(mut self: &mut Self) -> usize {
        let mut left: usize = self.parse_shift_expression();
        if left == 0 {
            return 0;
        }
        while self.match_token(TokenKind::EqEq)
            || self.match_token(TokenKind::BangEq)
            || self.match_token(TokenKind::Lt)
            || self.match_token(TokenKind::LtEq)
            || self.match_token(TokenKind::Gt)
            || self.match_token(TokenKind::GtEq) {
            let op: Token = self.advance();
            let right: usize = self.parse_shift_expression();
            if right == 0 {
                self.record_unexpected(self.current());
                return 0;
            }
            left = self.make_binary(left, op, right);
            if left == 0 {
                return 0;
            }
        }
        return left;
    }

    pub fn parse_shift_expression(mut self: &mut Self) -> usize {
        let mut left: usize = self.parse_additive_expression();
        while self.match_token(TokenKind::Shl) || self.match_token(TokenKind::Shr) {
            let op: Token = self.advance();
            let right: usize = self.parse_additive_expression();
            left = self.make_binary(left, op, right);
            if left == 0 { return 0; }
        }
        return left;
    }

    pub fn parse_bitwise_expression(mut self: &mut Self) -> usize {
        let mut left: usize = self.parse_comparison_expression();
        while self.match_token(TokenKind::Amp) || self.match_token(TokenKind::Pipe)
            || self.match_token(TokenKind::Caret) {
            let op: Token = self.advance();
            let right: usize = self.parse_comparison_expression();
            left = self.make_binary(left, op, right);
            if left == 0 { return 0; }
        }
        return left;
    }

    pub fn parse_logical_and_expression(mut self: &mut Self) -> usize {
        let mut left: usize = self.parse_bitwise_expression();
        if left == 0 {
            return 0;
        }
        while self.match_token(TokenKind::LogicalAnd) {
            let op: Token = self.advance();
            let right: usize = self.parse_bitwise_expression();
            if right == 0 {
                self.record_unexpected(self.current());
                return 0;
            }
            left = self.make_binary(left, op, right);
            if left == 0 {
                return 0;
            }
        }
        return left;
    }

    pub fn parse_expression(mut self: &mut Self) -> usize {
        let mut left: usize = self.parse_logical_and_expression();
        if left == 0 {
            return 0;
        }
        while self.match_token(TokenKind::LogicalOr) {
            let op: Token = self.advance();
            let right: usize = self.parse_logical_and_expression();
            if right == 0 {
                self.record_unexpected(self.current());
                return 0;
            }
            left = self.make_binary(left, op, right);
            if left == 0 {
                return 0;
            }
        }
        return left;
    }
}

module sotlas::compiler::backend::target_ir;

// Native in-memory Target IR contract for the self-hosting compiler.
// This module deliberately contains no C ABI, host-runtime or Python concepts.
// It is a data boundary only: lowering and machine emission are separate stages.

pub const TARGET_IR_VERSION: u32 = 1;
pub const TARGET_OBJECT_FUNCTION_CAPACITY: u32 = 1024;
pub const TARGET_EXTENDED_SOURCE_CAPACITY: usize = 4194304;
pub const TARGET_VALUE_NONE: u32 = 0;
pub const TARGET_BLOCK_NONE: u32 = 0;
pub const TARGET_FLAG_SEMANTIC_ONLY: u32 = 1;
pub const TARGET_FLAG_SYSTEM: u32 = 2;
pub const TARGET_FUNCTION_EXTERNAL: u32 = 4;
// SV8.48b: optional typed call capabilities carried in the existing IR
// instruction header. The call's immediate_bits packs two bits per argument:
// 0=plain, 1=sole/exclusive transfer, 2=whisper, 3=direct borrow.
// Legacy manually constructed IR calls with flags=0 and immediate_bits=0
// remain valid; machine emitters ignore this semantic-only metadata.
pub const TARGET_CALL_CAPABILITIES_TYPED: u32 = 16;
// Value metadata keeps domain identity independently of machine storage type.
// 0=plain, 1=exclusive, 2=shared, 3=island, 4=whisper, 5=region,
// 6=direct, 7=device, 8=external. These bits do not change the record ABI.
pub const TARGET_VALUE_DOMAIN_MASK: u32 = 3840;
pub const TARGET_VALUE_DOMAIN_SHIFT: u32 = 8;

pub enum TargetTypeTag {
    Invalid = 0,
    Bool = 1,
    U8 = 2,
    U16 = 3,
    U32 = 4,
    U64 = 5,
    Usize = 6,
    I8 = 7,
    I16 = 8,
    I32 = 9,
    I64 = 10,
    Isize = 11,
    F32 = 12,
    F64 = 13,
    Pointer = 14,
    Aggregate = 15,
    Void = 16
}

pub enum TargetOpcode {
    Invalid = 0,
    AllocStack = 1,
    Store = 2,
    Load = 3,
    ConstInt = 4,
    Add = 5,
    Sub = 6,
    Mul = 7,
    Compare = 8,
    Phi = 9,
    Call = 10,
    SystemOp = 11,
    Branch = 12,
    CondBranch = 13,
    Return = 14,
    SemanticDirectBorrow = 15,
    SemanticWhisperBorrow = 16,
    SemanticOwnershipTransfer = 17,
    SemanticShare = 18,
    SemanticRetain = 19,
    SemanticRelease = 20,
    SemanticDestroy = 21,
    SemanticOwnershipPoint = 22,
    SemanticSharedOwnershipPoint = 23,
    SemanticDeferUse = 24,
    SemanticStateTransition = 25,
    BoolAnd = 26,
    BoolOr = 27,
    BitAnd = 28,
    BitOr = 29,
    BitXor = 30,
    ShiftLeft = 31,
    ShiftRight = 32,
    Div = 33,
    Mod = 34,
    IntCast = 35,
    IndexAddr = 36,
    PtrOffset = 37,
    ConstFloat = 38,
    FloatNeg = 39,
    FloatCast = 40,
    NumericCast = 41,
    PointerCast = 42
}

pub struct TargetSourceSlice {
    pub offset: usize;
    pub length: usize;
}

impl TargetSourceSlice {
    pub fn empty() -> TargetSourceSlice {
        return TargetSourceSlice {
            offset: 0,
            length: 0
        };
    }
}

// Values are identified by stable numeric SSA ids instead of host-language
// strings. Id zero is reserved for "no value".
pub struct TargetValue {
    pub id: u32;
    pub type_tag: TargetTypeTag;
    pub source_name: TargetSourceSlice;
    pub flags: u32;
}

impl TargetValue {
    pub fn empty() -> TargetValue {
        return TargetValue {
            id: TARGET_VALUE_NONE,
            type_tag: TargetTypeTag::Invalid,
            source_name: TargetSourceSlice::empty(),
            flags: 0
        };
    }
}

// Operand arrays are stored in a flat table owned by the module. Calls and
// future variadic instructions therefore do not bake a host container into IR.
pub struct TargetOperand {
    pub value_id: u32;
}

impl TargetOperand {
    pub fn new(value_id: u32) -> TargetOperand {
        return TargetOperand { value_id: value_id };
    }
}

// Phi inputs require both the incoming value and predecessor block.
pub struct TargetPhiInput {
    pub value_id: u32;
    pub block_id: u32;
}

impl TargetPhiInput {
    pub fn new(value_id: u32, block_id: u32) -> TargetPhiInput {
        return TargetPhiInput {
            value_id: value_id,
            block_id: block_id
        };
    }
}

pub struct TargetInstruction {
    pub opcode: TargetOpcode;
    pub result_value: u32;
    pub type_tag: TargetTypeTag;
    pub first_operand: u32;
    pub operand_count: u32;
    pub first_phi_input: u32;
    pub phi_input_count: u32;
    pub first_target: u32;
    pub target_count: u32;
    pub immediate_bits: u64;
    pub symbol: TargetSourceSlice;
    pub source_point: TargetSourceSlice;
    pub flags: u32;
}

impl TargetInstruction {
    pub fn new(opcode: TargetOpcode) -> TargetInstruction {
        return TargetInstruction {
            opcode: opcode,
            result_value: TARGET_VALUE_NONE,
            type_tag: TargetTypeTag::Invalid,
            first_operand: 0,
            operand_count: 0,
            first_phi_input: 0,
            phi_input_count: 0,
            first_target: 0,
            target_count: 0,
            immediate_bits: 0,
            symbol: TargetSourceSlice::empty(),
            source_point: TargetSourceSlice::empty(),
            flags: 0
        };
    }
}

pub struct TargetBlock {
    pub id: u32;
    pub label: TargetSourceSlice;
    pub first_instruction: u32;
    pub instruction_count: u32;
}

impl TargetBlock {
    pub fn empty() -> TargetBlock {
        return TargetBlock {
            id: TARGET_BLOCK_NONE,
            label: TargetSourceSlice::empty(),
            first_instruction: 0,
            instruction_count: 0
        };
    }
}

pub struct TargetFunction {
    pub name: TargetSourceSlice;
    pub return_type: TargetTypeTag;
    pub first_parameter: u32;
    pub parameter_count: u32;
    pub first_block: u32;
    pub block_count: u32;
    pub flags: u32;
}

// Function parameters are stored in a flat module table. Their names remain
// source slices and their SSA identities are numeric, like all other values.
pub struct TargetParameter {
    pub value_id: u32;
    pub type_tag: TargetTypeTag;
    pub name: TargetSourceSlice;
}

impl TargetFunction {
    pub fn empty() -> TargetFunction {
        return TargetFunction {
            name: TargetSourceSlice::empty(),
            return_type: TargetTypeTag::Void,
            first_parameter: 0,
            parameter_count: 0,
            first_block: 0,
            block_count: 0,
            flags: 0
        };
    }
}

// TargetModule contains only counts and versioning. Storage ownership stays with
// the compiler arena so the same IR can be used by hosted apps and barecore.
pub struct TargetModule {
    pub version: u32;
    pub function_count: u32;
    pub parameter_count: u32;
    pub block_count: u32;
    pub instruction_count: u32;
    pub value_count: u32;
    pub operand_count: u32;
    pub phi_input_count: u32;
    pub target_count: u32;
}

impl TargetModule {
    pub fn empty() -> TargetModule {
        return TargetModule {
            version: TARGET_IR_VERSION,
            function_count: 0,
            parameter_count: 0,
            block_count: 0,
            instruction_count: 0,
            value_count: 0,
            operand_count: 0,
            phi_input_count: 0,
            target_count: 0
        };
    }
}

pub fn target_opcode_is_terminator(opcode: TargetOpcode) -> bool {
    return opcode == TargetOpcode::Branch
        || opcode == TargetOpcode::CondBranch
        || opcode == TargetOpcode::Return;
}

pub fn target_opcode_is_semantic_only(opcode: TargetOpcode) -> bool {
    return opcode == TargetOpcode::SemanticDirectBorrow
        || opcode == TargetOpcode::SemanticWhisperBorrow
        || opcode == TargetOpcode::SemanticOwnershipTransfer
        || opcode == TargetOpcode::SemanticShare
        || opcode == TargetOpcode::SemanticRetain
        || opcode == TargetOpcode::SemanticRelease
        || opcode == TargetOpcode::SemanticDestroy
        || opcode == TargetOpcode::SemanticOwnershipPoint
        || opcode == TargetOpcode::SemanticSharedOwnershipPoint
        || opcode == TargetOpcode::SemanticDeferUse
        || opcode == TargetOpcode::SemanticStateTransition;
}

pub fn target_type_is_float(type_tag: TargetTypeTag) -> bool {
    return type_tag == TargetTypeTag::F32 || type_tag == TargetTypeTag::F64;
}

pub fn target_type_is_integer(type_tag: TargetTypeTag) -> bool {
    return type_tag == TargetTypeTag::U8
        || type_tag == TargetTypeTag::U16
        || type_tag == TargetTypeTag::U32
        || type_tag == TargetTypeTag::U64
        || type_tag == TargetTypeTag::Usize
        || type_tag == TargetTypeTag::I8
        || type_tag == TargetTypeTag::I16
        || type_tag == TargetTypeTag::I32
        || type_tag == TargetTypeTag::I64
        || type_tag == TargetTypeTag::Isize;
}

// Shift counts are checked against the declared width, before x86 can mask CL.
// Zero identifies a type without an integer bit representation.
pub fn target_integer_width(type_tag: TargetTypeTag) -> u32 {
    if type_tag == TargetTypeTag::U8 || type_tag == TargetTypeTag::I8 { return 8; }
    if type_tag == TargetTypeTag::U16 || type_tag == TargetTypeTag::I16 { return 16; }
    if type_tag == TargetTypeTag::U32 || type_tag == TargetTypeTag::I32 { return 32; }
    if type_tag == TargetTypeTag::U64 || type_tag == TargetTypeTag::I64
        || type_tag == TargetTypeTag::Usize || type_tag == TargetTypeTag::Isize { return 64; }
    return 0;
}

pub fn target_range_is_valid(first: u32, count: u32, total: u32) -> bool {
    return first <= total && count <= total - first;
}

pub fn target_cfg_has_block(
    blocks: *const TargetBlock,
    first_block: u32,
    block_count: u32,
    block_id: u32
) -> bool {
    if blocks == null || block_id == TARGET_BLOCK_NONE {
        return false;
    }
    let mut offset: u32 = 0;
    while offset < block_count {
        if unsafe { (*(blocks + first_block + offset)).id } == block_id {
            return true;
        }
        offset = offset + 1;
    }
    return false;
}

pub fn target_cfg_block_has_edge(
    block: &TargetBlock,
    instructions: *const TargetInstruction,
    targets: *const u32,
    target_id: u32
) -> bool {
    if block.instruction_count == 0 || instructions == null || targets == null {
        return false;
    }
    let terminator_index: u32 = block.first_instruction + block.instruction_count - 1;
    let terminator: TargetInstruction = unsafe { *(instructions + terminator_index) };
    if terminator.opcode != TargetOpcode::Branch
        && terminator.opcode != TargetOpcode::CondBranch {
        return false;
    }
    let mut target_offset: u32 = 0;
    while target_offset < terminator.target_count {
        let actual: u32 = unsafe {
            *(targets + terminator.first_target + target_offset)
        };
        if actual == target_id {
            return true;
        }
        target_offset = target_offset + 1;
    }
    return false;
}

pub fn target_value_matches(
    values: *const TargetValue,
    value_count: u32,
    value_id: u32,
    type_tag: TargetTypeTag
) -> bool {
    if values == null || value_id == TARGET_VALUE_NONE || value_id > value_count {
        return false;
    }
    let value: TargetValue = unsafe { *(values + value_id - 1) };
    return value.id == value_id && value.type_tag == type_tag;
}

pub fn target_parameters_define_value(
    function: &TargetFunction,
    parameters: *const TargetParameter,
    value_id: u32
) -> bool {
    let mut parameter_offset: u32 = 0;
    while parameter_offset < function.parameter_count {
        if unsafe {
            (*(parameters + function.first_parameter + parameter_offset)).value_id
        } == value_id {
            return true;
        }
        parameter_offset = parameter_offset + 1;
    }
    return false;
}

pub fn target_block_defines_value(
    blocks: *const TargetBlock,
    block_index: u32,
    instructions: *const TargetInstruction,
    value_id: u32
) -> bool {
    let block: TargetBlock = unsafe { *(blocks + block_index) };
    let mut instruction_offset: u32 = 0;
    while instruction_offset < block.instruction_count {
        if unsafe {
            (*(instructions + block.first_instruction + instruction_offset)).result_value
        } == value_id {
            return true;
        }
        instruction_offset = instruction_offset + 1;
    }
    return false;
}

pub fn target_function_defines_value(
    function: &TargetFunction,
    parameters: *const TargetParameter,
    blocks: *const TargetBlock,
    instructions: *const TargetInstruction,
    value_id: u32
) -> bool {
    let in_parameters: bool = target_parameters_define_value(
        function, parameters, value_id
    );
    if in_parameters {
        return true;
    }
    let mut block_offset: u32 = 0;
    while block_offset < function.block_count {
        let in_block: bool = target_block_defines_value(
            blocks, function.first_block + block_offset, instructions, value_id
        );
        if in_block {
            return true;
        }
        block_offset = block_offset + 1;
    }
    return false;
}

pub fn target_cfg_block_offset(
    blocks: *const TargetBlock,
    function: &TargetFunction,
    block_id: u32
) -> u32 {
    let mut offset: u32 = 0;
    while offset < function.block_count {
        if unsafe { (*(blocks + function.first_block + offset)).id } == block_id {
            return offset;
        }
        offset = offset + 1;
    }
    return function.block_count;
}

pub fn target_dom_contains(
    dominators: *mut u8,
    stride: usize,
    block_offset: u32,
    dominator_offset: u32
) -> bool {
    let byte_offset: usize = block_offset as usize * stride
        + dominator_offset as usize / 8;
    let bit: u8 = (1 << (dominator_offset % 8)) as u8;
    let byte: u8 = unsafe { *(dominators + byte_offset) };
    let masked: u32 = (byte as u32) & (bit as u32);
    return masked != 0;
}

pub fn target_definition_block_offset(
    function: &TargetFunction,
    blocks: *const TargetBlock,
    instructions: *const TargetInstruction,
    value_id: u32
) -> u32 {
    let mut block_offset: u32 = 0;
    while block_offset < function.block_count {
        let found: bool = target_block_defines_value(
            blocks, function.first_block + block_offset, instructions, value_id
        );
        if found {
            return block_offset;
        }
        block_offset = block_offset + 1;
    }
    return function.block_count;
}

pub fn target_block_definition_instruction_offset(
    blocks: *const TargetBlock,
    block_index: u32,
    instructions: *const TargetInstruction,
    value_id: u32
) -> u32 {
    let block: TargetBlock = unsafe { *(blocks + block_index) };
    let mut instruction_offset: u32 = 0;
    while instruction_offset < block.instruction_count {
        if unsafe {
            (*(instructions + block.first_instruction + instruction_offset)).result_value
        } == value_id {
            return instruction_offset;
        }
        instruction_offset = instruction_offset + 1;
    }
    return block.instruction_count;
}

pub fn target_value_dominates_point(
    function: &TargetFunction,
    parameters: *const TargetParameter,
    blocks: *const TargetBlock,
    instructions: *const TargetInstruction,
    dominators: *mut u8,
    stride: usize,
    value_id: u32,
    use_block_id: u32,
    use_instruction_offset: u32
) -> bool {
    let in_parameters: bool = target_parameters_define_value(
        function, parameters, value_id
    );
    if in_parameters { return true; }
    // CFG validation requires a unique definition for each SSA value.
    let definition_block_offset: u32 = target_definition_block_offset(
        function, blocks, instructions, value_id
    );
    if definition_block_offset >= function.block_count { return false; }
    let definition: TargetBlock = unsafe {
        *(blocks + function.first_block + definition_block_offset)
    };
    let definition_instruction_offset: u32 = target_block_definition_instruction_offset(
        blocks, function.first_block + definition_block_offset, instructions, value_id
    );
    let definition_block: u32 = target_cfg_block_offset(
        blocks, function, definition.id
    );
    let use_block: u32 = target_cfg_block_offset(blocks, function, use_block_id);
    if definition_block >= function.block_count || use_block >= function.block_count {
        return false;
    }
    if definition_block == use_block {
        return definition_instruction_offset < use_instruction_offset;
    }
    return target_dom_contains(dominators, stride, use_block, definition_block);
}

pub fn target_module_value_invalid(
    values: *const TargetValue,
    value_index: u32
) -> bool {
    let value: TargetValue = unsafe { *(values + value_index) };
    return value.id != value_index + 1 || !target_type_is_value(value.type_tag)
        || !target_value_flags_valid(value.flags);
}

pub fn target_type_is_value(type_tag: TargetTypeTag) -> bool {
    let tag: u32 = type_tag as u32;
    return tag >= 1 && tag <= 15;
}

pub fn target_type_is_return(type_tag: TargetTypeTag) -> bool {
    return target_type_is_value(type_tag) || type_tag == TargetTypeTag::Void;
}

pub fn target_opcode_is_valid(opcode: TargetOpcode) -> bool {
    let code: u32=opcode as u32;
    return code >= 1 && code <= 42;
}

pub fn target_function_flags_valid(flags: u32) -> bool {
    return (flags & ~(TARGET_FLAG_SYSTEM | TARGET_FUNCTION_EXTERNAL)) == 0;
}

pub fn target_value_flags_valid(flags: u32) -> bool {
    return (flags & ~(TARGET_VALUE_DOMAIN_MASK | TARGET_FLAG_SYSTEM | TARGET_FLAG_SEMANTIC_ONLY)) == 0
        && ((flags & TARGET_VALUE_DOMAIN_MASK) >> TARGET_VALUE_DOMAIN_SHIFT) <= 8;
}

pub fn target_instruction_metadata_valid(instruction: TargetInstruction) -> bool {
    if !target_opcode_is_valid(instruction.opcode) { return false; }
    if instruction.opcode == TargetOpcode::PointerCast {
        return instruction.flags == 0 && instruction.immediate_bits == 0
            && instruction.symbol.offset == 0 && instruction.symbol.length == 0
            && instruction.phi_input_count == 0 && instruction.target_count == 0;
    }
    if instruction.opcode == TargetOpcode::ConstInt || instruction.opcode == TargetOpcode::ConstFloat {
        return instruction.flags == 0 && instruction.symbol.offset == 0 && instruction.symbol.length == 0
            && instruction.phi_input_count == 0 && instruction.target_count == 0;
    }
    if instruction.opcode == TargetOpcode::Return || instruction.opcode == TargetOpcode::Branch
        || instruction.opcode == TargetOpcode::CondBranch {
        return instruction.flags == 0 && instruction.immediate_bits == 0
            && instruction.symbol.offset == 0 && instruction.symbol.length == 0
            && instruction.phi_input_count == 0;
    }
    if instruction.opcode == TargetOpcode::Phi {
        return instruction.flags == 0 && instruction.immediate_bits == 0
            && instruction.symbol.offset == 0 && instruction.symbol.length == 0 && instruction.target_count == 0;
    }
    if instruction.opcode == TargetOpcode::Load || instruction.opcode == TargetOpcode::Store {
        return instruction.flags == 0 && instruction.symbol.offset == 0 && instruction.symbol.length == 0
            && instruction.phi_input_count == 0 && instruction.target_count == 0;
    }
    if instruction.opcode == TargetOpcode::IntCast || instruction.opcode == TargetOpcode::FloatCast
        || instruction.opcode == TargetOpcode::FloatNeg || instruction.opcode == TargetOpcode::NumericCast {
        return instruction.flags == 0 && instruction.immediate_bits == 0
            && instruction.symbol.offset == 0 && instruction.symbol.length == 0
            && instruction.phi_input_count == 0 && instruction.target_count == 0;
    }
    if instruction.opcode == TargetOpcode::Add || instruction.opcode == TargetOpcode::Sub
        || instruction.opcode == TargetOpcode::Mul || instruction.opcode == TargetOpcode::Div
        || instruction.opcode == TargetOpcode::Mod || instruction.opcode == TargetOpcode::BitAnd
        || instruction.opcode == TargetOpcode::BitOr || instruction.opcode == TargetOpcode::BitXor
        || instruction.opcode == TargetOpcode::ShiftLeft || instruction.opcode == TargetOpcode::ShiftRight
        || instruction.opcode == TargetOpcode::BoolAnd || instruction.opcode == TargetOpcode::BoolOr {
        return instruction.flags == 0 && instruction.immediate_bits == 0
            && instruction.symbol.offset == 0 && instruction.symbol.length == 0
            && instruction.phi_input_count == 0 && instruction.target_count == 0;
    }
    if instruction.opcode == TargetOpcode::Compare || instruction.opcode == TargetOpcode::IndexAddr
        || instruction.opcode == TargetOpcode::PtrOffset {
        return instruction.flags == 0 && instruction.symbol.offset == 0 && instruction.symbol.length == 0
            && instruction.phi_input_count == 0 && instruction.target_count == 0;
    }
    if instruction.opcode == TargetOpcode::AllocStack {
        return instruction.flags == 0 && instruction.phi_input_count == 0 && instruction.target_count == 0;
    }
    if instruction.opcode == TargetOpcode::Call {
        return (instruction.flags == 0 || instruction.flags == TARGET_CALL_CAPABILITIES_TYPED)
            && instruction.phi_input_count == 0 && instruction.target_count == 0;
    }
    if instruction.opcode == TargetOpcode::SystemOp {
        return instruction.flags == 0 && instruction.symbol.offset == 0 && instruction.symbol.length == 0
            && instruction.phi_input_count == 0 && instruction.target_count == 0;
    }
    return true;
}

pub fn target_source_slice_valid(slice: TargetSourceSlice, source_len: usize) -> bool {
    return slice.offset <= source_len && slice.length <= source_len-slice.offset;
}

pub fn target_module_values_valid(
    target_section: &TargetModule,
    values: *const TargetValue
) -> bool {
    let value_count: u32 = target_section.value_count;
    let mut value_index: u32 = 0;
    while value_index < value_count {
        let invalid: bool = target_module_value_invalid(values, value_index);
        if invalid {
            return false;
        }
        value_index = value_index + 1;
    }
    return true;
}

// Validate flat table ranges and the structural CFG contract before a backend
// consumes it. This checks branch destinations and phi predecessor edges, but
// deliberately leaves type checking and full SSA dominance to later passes.
pub fn target_module_validate_cfg(
    target_module: *const TargetModule,
    functions: *const TargetFunction,
    parameters: *const TargetParameter,
    values: *const TargetValue,
    blocks: *const TargetBlock,
    instructions: *const TargetInstruction,
    operands: *const TargetOperand,
    phi_inputs: *const TargetPhiInput,
    targets: *const u32
) -> bool {
    if target_module == null {
        return false;
    }
    let target_section: TargetModule = unsafe { *target_module };
    if target_section.version != TARGET_IR_VERSION
        || (target_section.function_count != 0 && functions == null)
        || (target_section.parameter_count != 0 && parameters == null)
        || (target_section.value_count != 0 && values == null)
        || (target_section.block_count != 0 && blocks == null)
        || (target_section.instruction_count != 0 && instructions == null)
        || (target_section.operand_count != 0 && operands == null)
        || (target_section.phi_input_count != 0 && phi_inputs == null)
        || (target_section.target_count != 0 && targets == null) {
        return false;
    }

    if !target_module_values_valid(&target_section, values) { return false; }

    let mut function_index: u32 = 0;
    while function_index < target_section.function_count {
        let function: TargetFunction = unsafe { *(functions + function_index) };
        if !target_function_flags_valid(function.flags) { return false; }
        if (function.flags & TARGET_FUNCTION_EXTERNAL) != 0 {
            if function.flags != TARGET_FUNCTION_EXTERNAL
                || function.block_count != 0
                || !target_type_is_return(function.return_type)
                || function.name.length == 0
                || function.name.offset > 536870911
                || !target_range_is_valid(
                    function.first_parameter, function.parameter_count, target_section.parameter_count
                ) {
                return false;
            }
            let mut external_parameter: u32 = 0;
            while external_parameter < function.parameter_count {
                let parameter: TargetParameter = unsafe {
                    *(parameters + function.first_parameter + external_parameter)
                };
                if parameter.value_id != TARGET_VALUE_NONE
                    || !target_type_is_value(parameter.type_tag) {
                    return false;
                }
                external_parameter = external_parameter + 1;
            }
            function_index = function_index + 1;
            continue;
        }
        if function.block_count == 0
            || !target_type_is_return(function.return_type)
            || !target_range_is_valid(
                function.first_parameter, function.parameter_count,
                target_section.parameter_count
            )
            || !target_range_is_valid(
                function.first_block, function.block_count, target_section.block_count
            ) {
            return false;
        }

        let mut parameter_offset: u32 = 0;
        while parameter_offset < function.parameter_count {
            let parameter: TargetParameter = unsafe {
                *(parameters + function.first_parameter + parameter_offset)
            };
            if parameter.value_id == TARGET_VALUE_NONE
                || !target_type_is_value(parameter.type_tag)
                || parameter.value_id > target_section.value_count
                || !target_value_matches(
                    values, target_section.value_count, parameter.value_id, parameter.type_tag
                ) {
                return false;
            }
            let mut prior_parameter: u32 = 0;
            while prior_parameter < parameter_offset {
                if unsafe {
                    (*(parameters + function.first_parameter + prior_parameter)).value_id
                } == parameter.value_id {
                    return false;
                }
                prior_parameter = prior_parameter + 1;
            }
            parameter_offset = parameter_offset + 1;
        }

        let mut block_offset: u32 = 0;
        while block_offset < function.block_count {
            let block_index: u32 = function.first_block + block_offset;
            let block: TargetBlock = unsafe { *(blocks + block_index) };
            if block.id == TARGET_BLOCK_NONE || block.instruction_count == 0
                || !target_range_is_valid(
                    block.first_instruction, block.instruction_count,
                    target_section.instruction_count
                ) {
                return false;
            }

            let mut prior_range_offset: u32 = 0;
            while prior_range_offset < block_offset {
                let prior_range: TargetBlock = unsafe {
                    *(blocks + function.first_block + prior_range_offset)
                };
                let current_end: u32 = block.first_instruction + block.instruction_count;
                let prior_end: u32 = prior_range.first_instruction
                    + prior_range.instruction_count;
                if block.first_instruction < prior_end
                    && prior_range.first_instruction < current_end {
                    return false;
                }
                prior_range_offset = prior_range_offset + 1;
            }

            let mut other_offset: u32 = 0;
            while other_offset < block_offset {
                if unsafe {
                    (*(blocks + function.first_block + other_offset)).id
                } == block.id {
                    return false;
                }
                other_offset = other_offset + 1;
            }

            let mut instruction_offset: u32 = 0;
            let mut saw_non_phi: bool = false;
            while instruction_offset < block.instruction_count {
                let instruction_index: u32 = block.first_instruction + instruction_offset;
                let instruction: TargetInstruction = unsafe {
                    *(instructions + instruction_index)
                };
                let is_last: bool = instruction_offset + 1 == block.instruction_count;
                if (is_last && !target_opcode_is_terminator(instruction.opcode))
                    || (!is_last && target_opcode_is_terminator(instruction.opcode))
                    || !target_instruction_metadata_valid(instruction)
                    || !target_range_is_valid(
                        instruction.first_operand, instruction.operand_count,
                        target_section.operand_count
                    )
                    || !target_range_is_valid(
                        instruction.first_phi_input, instruction.phi_input_count,
                        target_section.phi_input_count
                    )
                    || !target_range_is_valid(
                        instruction.first_target, instruction.target_count,
                        target_section.target_count
                    )
                    || (instruction.result_value != TARGET_VALUE_NONE
                        && instruction.result_value > target_section.value_count) {
                    return false;
                }
                if instruction.opcode == TargetOpcode::Phi {
                    if saw_non_phi { return false; }
                } else {
                    saw_non_phi = true;
                }

                if instruction.result_value != TARGET_VALUE_NONE {
                    if instruction.type_tag == TargetTypeTag::Invalid
                        || !target_value_matches(
                            values, target_section.value_count,
                            instruction.result_value, instruction.type_tag
                        ) {
                        return false;
                    }
                    let mut prior_function: u32 = 0;
                    while prior_function <= function_index {
                        let prior_fn: TargetFunction = unsafe { *(functions + prior_function) };
                        let mut prior_block_end: u32 = prior_fn.block_count;
                        if prior_function == function_index {
                            prior_block_end = block_offset;
                        }
                        let mut prior_block_offset: u32 = 0;
                        while prior_block_offset < prior_block_end {
                            let prior_block: TargetBlock = unsafe {
                                *(blocks + prior_fn.first_block + prior_block_offset)
                            };
                            let mut prior_instruction_end: u32 = prior_block.instruction_count;
                            if prior_function == function_index
                                && prior_block_offset == block_offset {
                                prior_instruction_end = instruction_offset;
                            }
                            let mut prior_instruction_offset: u32 = 0;
                            while prior_instruction_offset < prior_instruction_end {
                                let prior_instruction: TargetInstruction = unsafe {
                                    *(instructions + prior_block.first_instruction
                                        + prior_instruction_offset)
                                };
                                if prior_instruction.result_value == instruction.result_value {
                                    return false;
                                }
                                prior_instruction_offset = prior_instruction_offset + 1;
                            }
                            prior_block_offset = prior_block_offset + 1;
                        }
                        prior_function = prior_function + 1;
                    }
                    let mut parameter_fn: u32 = 0;
                    while parameter_fn <= function_index {
                        let prior_fn: TargetFunction = unsafe { *(functions + parameter_fn) };
                        let mut prior_parameter: u32 = 0;
                        while prior_parameter < prior_fn.parameter_count {
                            if unsafe {
                                (*(parameters + prior_fn.first_parameter + prior_parameter)).value_id
                            } == instruction.result_value {
                                return false;
                            }
                            prior_parameter = prior_parameter + 1;
                        }
                        parameter_fn = parameter_fn + 1;
                    }
                }

                let mut operand_offset: u32 = 0;
                while operand_offset < instruction.operand_count {
                    let operand: TargetOperand = unsafe {
                        *(operands + instruction.first_operand + operand_offset)
                    };
                    if operand.value_id == TARGET_VALUE_NONE
                        || operand.value_id > target_section.value_count
                        || !target_function_defines_value(
                            &function, parameters, blocks, instructions, operand.value_id
                        ) {
                        return false;
                    }
                    operand_offset = operand_offset + 1;
                }

                if instruction.opcode == TargetOpcode::Branch {
                    if instruction.result_value != TARGET_VALUE_NONE
                        || instruction.operand_count != 0 || instruction.target_count != 1
                        || instruction.phi_input_count != 0 {
                        return false;
                    }
                } else if instruction.opcode == TargetOpcode::CondBranch {
                    if instruction.result_value != TARGET_VALUE_NONE
                        || instruction.operand_count != 1 || instruction.target_count != 2
                        || instruction.phi_input_count != 0 {
                        return false;
                    }
                    let condition: TargetOperand = unsafe {
                        *(operands + instruction.first_operand)
                    };
                    if condition.value_id == TARGET_VALUE_NONE
                        || !target_value_matches(
                            values, target_section.value_count, condition.value_id,
                            TargetTypeTag::Bool
                        ) {
                        return false;
                    }
                } else if instruction.opcode == TargetOpcode::Return {
                    if instruction.result_value != TARGET_VALUE_NONE
                        || instruction.type_tag != function.return_type
                        || instruction.target_count != 0 || instruction.phi_input_count != 0
                        || instruction.operand_count > 1
                        || (function.return_type == TargetTypeTag::Void
                            && instruction.operand_count != 0)
                        || (function.return_type != TargetTypeTag::Void
                            && instruction.operand_count != 1) {
                        return false;
                    }
                    if instruction.operand_count == 1 {
                        let returned: TargetOperand = unsafe {
                            *(operands + instruction.first_operand)
                        };
                        if !target_value_matches(
                            values, target_section.value_count, returned.value_id,
                            function.return_type
                        ) { return false; }
                    }
                } else if instruction.opcode == TargetOpcode::Phi {
                    if instruction.phi_input_count == 0
                        || instruction.operand_count != 0
                        || instruction.result_value == TARGET_VALUE_NONE {
                        return false;
                    }
                    let mut phi_offset: u32 = 0;
                    let mut predecessor_count: u32 = 0;
                    let mut predecessor_scan: u32 = 0;
                    while predecessor_scan < function.block_count {
                        let predecessor: TargetBlock = unsafe {
                            *(blocks + function.first_block + predecessor_scan)
                        };
                        if target_cfg_block_has_edge(
                            &predecessor, instructions, targets, block.id
                        ) {
                            predecessor_count = predecessor_count + 1;
                        }
                        predecessor_scan = predecessor_scan + 1;
                    }
                    if instruction.phi_input_count != predecessor_count {
                        return false;
                    }
                    while phi_offset < instruction.phi_input_count {
                        let incoming: TargetPhiInput = unsafe {
                            *(phi_inputs + instruction.first_phi_input + phi_offset)
                        };
                        if incoming.value_id == TARGET_VALUE_NONE
                            || incoming.value_id > target_section.value_count
                            || !target_function_defines_value(
                                &function, parameters, blocks, instructions,
                                incoming.value_id
                            )
                            || !target_value_matches(
                                values, target_section.value_count, incoming.value_id,
                                instruction.type_tag
                            )
                            || !target_cfg_has_block(
                                blocks, function.first_block, function.block_count,
                                incoming.block_id
                            ) {
                            return false;
                        }
                        let mut predecessor_offset: u32 = 0;
                        let mut has_predecessor: bool = false;
                        while predecessor_offset < function.block_count {
                            let predecessor: TargetBlock = unsafe {
                                *(blocks + function.first_block + predecessor_offset)
                            };
                            if target_cfg_block_has_edge(
                                &predecessor, instructions, targets, block.id
                            ) && predecessor.id == incoming.block_id {
                                has_predecessor = true;
                            }
                            predecessor_offset = predecessor_offset + 1;
                        }
                        if !has_predecessor {
                            return false;
                        }
                        let mut earlier_phi: u32 = 0;
                        while earlier_phi < phi_offset {
                            let prior: TargetPhiInput = unsafe {
                                *(phi_inputs + instruction.first_phi_input + earlier_phi)
                            };
                            if prior.block_id == incoming.block_id {
                                return false;
                            }
                            earlier_phi = earlier_phi + 1;
                        }
                        phi_offset = phi_offset + 1;
                    }
                } else if instruction.target_count != 0
                    || instruction.phi_input_count != 0 {
                    return false;
                }

                if instruction.opcode == TargetOpcode::ConstFloat {
                    if instruction.result_value == TARGET_VALUE_NONE
                        || instruction.operand_count != 0 || !target_type_is_float(instruction.type_tag)
                        || (instruction.type_tag == TargetTypeTag::F32 && instruction.immediate_bits > 4294967295) { return false; }
                } else if instruction.opcode == TargetOpcode::NumericCast {
                    if instruction.result_value == 0 || instruction.operand_count != 1 { return false; }
                    let operand: TargetOperand = unsafe { *(operands + instruction.first_operand) };
                    if operand.value_id == 0 || operand.value_id > target_section.value_count { return false; }
                    let source_type: TargetTypeTag = unsafe { (*(values + operand.value_id as usize - 1)).type_tag };
                    if !((target_type_is_float(source_type) && target_type_is_integer(instruction.type_tag))
                        || (target_type_is_integer(source_type) && target_type_is_float(instruction.type_tag))) { return false; }
                } else if instruction.opcode == TargetOpcode::FloatCast {
                    if instruction.result_value == TARGET_VALUE_NONE || instruction.operand_count != 1
                        || !target_type_is_float(instruction.type_tag) { return false; }
                    let operand: TargetOperand = unsafe { *(operands + instruction.first_operand) };
                    if operand.value_id == 0 || operand.value_id > target_section.value_count { return false; }
                    let source_type: TargetTypeTag = unsafe { (*(values + operand.value_id as usize - 1)).type_tag };
                    if !target_type_is_float(source_type) || source_type == instruction.type_tag { return false; }
                } else if instruction.opcode == TargetOpcode::FloatNeg {
                    if instruction.result_value == TARGET_VALUE_NONE || instruction.operand_count != 1
                        || !target_type_is_float(instruction.type_tag) { return false; }
                    let operand: TargetOperand = unsafe { *(operands + instruction.first_operand) };
                    if !target_value_matches(values, target_section.value_count,
                        operand.value_id, instruction.type_tag) { return false; }
                } else if instruction.opcode == TargetOpcode::ConstInt {
                    if instruction.result_value == TARGET_VALUE_NONE
                        || instruction.operand_count != 0
                        || (!target_type_is_integer(instruction.type_tag)
                            && !(instruction.type_tag == TargetTypeTag::Bool
                                && instruction.immediate_bits <= 1)
                            && !(instruction.type_tag == TargetTypeTag::Pointer
                                && instruction.immediate_bits == 0)) {
                        return false;
                    }
                } else if instruction.opcode == TargetOpcode::PointerCast {
                    if instruction.result_value == TARGET_VALUE_NONE || instruction.operand_count != 1 { return false; }
                    let cast_operand: TargetOperand = unsafe { *(operands+instruction.first_operand) };
                    if cast_operand.value_id == 0 || cast_operand.value_id > target_section.value_count { return false; }
                    let from: TargetTypeTag = unsafe { (*(values+cast_operand.value_id-1)).type_tag };
                    let to: TargetTypeTag = instruction.type_tag;
                    if !((from == TargetTypeTag::Pointer && (to == TargetTypeTag::U64 || to == TargetTypeTag::Usize))
                        || (to == TargetTypeTag::Pointer && (from == TargetTypeTag::U64 || from == TargetTypeTag::Usize))) { return false; }
                } else if instruction.opcode == TargetOpcode::IntCast {
                    if instruction.result_value == TARGET_VALUE_NONE
                        || !target_type_is_integer(instruction.type_tag)
                        || instruction.operand_count != 1 {
                        return false;
                    }
                    let source: TargetOperand = unsafe {
                        *(operands + instruction.first_operand)
                    };
                    if source.value_id == TARGET_VALUE_NONE
                        || source.value_id > target_section.value_count
                        || !target_type_is_integer(unsafe {
                            (*(values + source.value_id as usize - 1)).type_tag
                        }) {
                        return false;
                    }
                } else if instruction.opcode == TargetOpcode::IndexAddr {
                    if instruction.result_value == TARGET_VALUE_NONE
                        || instruction.type_tag != TargetTypeTag::Pointer
                        || instruction.operand_count != 2 {
                        return false;
                    }
                    let base: TargetOperand = unsafe {
                        *(operands + instruction.first_operand)
                    };
                    let index: TargetOperand = unsafe {
                        *(operands + instruction.first_operand + 1)
                    };
                    if !target_value_matches(
                        values, target_section.value_count,
                        base.value_id, TargetTypeTag::Pointer
                    ) || index.value_id == TARGET_VALUE_NONE
                        || index.value_id > target_section.value_count
                        || !target_type_is_integer(unsafe {
                            (*(values + index.value_id as usize - 1)).type_tag
                        }) {
                        return false;
                    }
                    let stride: u32 = instruction.immediate_bits as u32;
                    let count: u32 = (instruction.immediate_bits >> 32) as u32;
                    if count == 0
                        || stride == 0 || stride > 2147483647 {
                        return false;
                    }
                } else if instruction.opcode == TargetOpcode::PtrOffset {
                    if instruction.result_value == TARGET_VALUE_NONE
                        || instruction.type_tag != TargetTypeTag::Pointer
                        || instruction.operand_count != 2 {
                        return false;
                    }
                    let base: TargetOperand = unsafe {
                        *(operands + instruction.first_operand)
                    };
                    let index: TargetOperand = unsafe {
                        *(operands + instruction.first_operand + 1)
                    };
                    if !target_value_matches(
                        values, target_section.value_count,
                        base.value_id, TargetTypeTag::Pointer
                    ) || index.value_id == TARGET_VALUE_NONE
                        || index.value_id > target_section.value_count
                        || !target_type_is_integer(unsafe {
                            (*(values + index.value_id as usize - 1)).type_tag
                        }) {
                        return false;
                    }
                    let stride: u32 = instruction.immediate_bits as u32;
                    let subtract: u32 = (instruction.immediate_bits >> 32) as u32;
                    if subtract > 1 || stride == 0 || stride > 2147483647 {
                        return false;
                    }
                } else if instruction.opcode == TargetOpcode::Add
                    || instruction.opcode == TargetOpcode::Sub
                    || instruction.opcode == TargetOpcode::Mul
                    || instruction.opcode == TargetOpcode::BitAnd
                    || instruction.opcode == TargetOpcode::BitOr
                    || instruction.opcode == TargetOpcode::BitXor
                    || instruction.opcode == TargetOpcode::ShiftLeft
                    || instruction.opcode == TargetOpcode::ShiftRight
                    || instruction.opcode == TargetOpcode::Div
                    || instruction.opcode == TargetOpcode::Mod {
                    if instruction.result_value == TARGET_VALUE_NONE
                        || (!target_type_is_integer(instruction.type_tag)
                            && !(target_type_is_float(instruction.type_tag)
                                && (instruction.opcode == TargetOpcode::Add || instruction.opcode == TargetOpcode::Sub
                                    || instruction.opcode == TargetOpcode::Mul || instruction.opcode == TargetOpcode::Div)))
                        || instruction.operand_count != 2 {
                        return false;
                    }
                    let left: TargetOperand = unsafe {
                        *(operands + instruction.first_operand)
                    };
                    let right: TargetOperand = unsafe {
                        *(operands + instruction.first_operand + 1)
                    };
                    if !target_value_matches(
                        values, target_section.value_count, left.value_id, instruction.type_tag
                    ) || !target_value_matches(
                        values, target_section.value_count, right.value_id, instruction.type_tag
                    ) { return false; }
                } else if instruction.opcode == TargetOpcode::Compare {
                    if instruction.result_value == TARGET_VALUE_NONE
                        || instruction.type_tag != TargetTypeTag::Bool
                        || instruction.operand_count != 2
                        || instruction.immediate_bits < 86 || instruction.immediate_bits > 91 {
                        return false;
                    }
                    let left: TargetOperand = unsafe {
                        *(operands + instruction.first_operand)
                    };
                    let right: TargetOperand = unsafe {
                        *(operands + instruction.first_operand + 1)
                    };
                    if left.value_id == TARGET_VALUE_NONE || right.value_id == TARGET_VALUE_NONE
                        || left.value_id > target_section.value_count || right.value_id > target_section.value_count {
                        return false;
                    }
                    let left_type: TargetTypeTag = unsafe {
                        (*(values + left.value_id as usize - 1)).type_tag
                    };
                    let right_type: TargetTypeTag = unsafe {
                        (*(values + right.value_id as usize - 1)).type_tag
                    };
                    if left_type != right_type
                        || (!target_type_is_integer(left_type)
                            && left_type != TargetTypeTag::Pointer
                            && left_type != TargetTypeTag::Bool && !target_type_is_float(left_type))
                        || ((left_type == TargetTypeTag::Pointer
                            || left_type == TargetTypeTag::Bool)
                            && instruction.immediate_bits > 87) {
                        return false;
                    }
                } else if instruction.opcode == TargetOpcode::BoolAnd
                    || instruction.opcode == TargetOpcode::BoolOr {
                    if instruction.result_value == TARGET_VALUE_NONE
                        || instruction.type_tag != TargetTypeTag::Bool
                        || instruction.operand_count != 2 {
                        return false;
                    }
                    let left: TargetOperand = unsafe {
                        *(operands + instruction.first_operand)
                    };
                    let right: TargetOperand = unsafe {
                        *(operands + instruction.first_operand + 1)
                    };
                    if !target_value_matches(
                        values, target_section.value_count, left.value_id, TargetTypeTag::Bool
                    ) || !target_value_matches(
                        values, target_section.value_count, right.value_id, TargetTypeTag::Bool
                    ) {
                        return false;
                    }
                } else if instruction.opcode == TargetOpcode::Call {
                    // New Sotlas AST lowering writes a typed capability profile;
                    // older hand-authored IR may omit it (both fields zero).
                    // A forged/truncated profile must fail before machine output.
                    if instruction.flags != 0 || instruction.immediate_bits != 0 {
                        if instruction.flags != TARGET_CALL_CAPABILITIES_TYPED
                            || instruction.operand_count > 24
                            || (instruction.immediate_bits >>
                                ((instruction.operand_count as u64) * 2)) != 0 {
                            return false;
                        }
                    }
                    if instruction.type_tag == TargetTypeTag::Invalid
                        || instruction.symbol.length == 0
                        || instruction.phi_input_count != 0
                        || instruction.target_count != 0
                        || (instruction.type_tag == TargetTypeTag::Void
                            && instruction.result_value != TARGET_VALUE_NONE)
                        || (instruction.type_tag != TargetTypeTag::Void
                            && instruction.result_value == TARGET_VALUE_NONE) {
                        return false;
                    }
                } else if instruction.opcode == TargetOpcode::SystemOp {
                    // IDs 0..3 and 5 are Linux; 16..19 and 21..22 are Darwin.
                    // Darwin fstat64 (22) uses the explicit 64-bit inode layout.
                    let mut operation: u64 = instruction.immediate_bits;
                    if operation >= 16 && operation <= 22 { operation = operation - 16; }
                    let mut expected: u32 = 3;
                    if operation == 3 { expected = 1; }
                    if operation == 5 || operation == 6 { expected = 2; }
                    if (operation > 3 && operation != 5 && operation != 6)
                        || (operation == 6 && instruction.immediate_bits != 22) || instruction.type_tag != TargetTypeTag::I64
                        || instruction.result_value == 0 || instruction.operand_count != expected
                        || instruction.symbol.length != 0 || instruction.target_count != 0
                        || instruction.phi_input_count != 0 { return false; }
                    let mut check: u32 = 0;
                    while check < expected {
                        let mut wanted: TargetTypeTag = TargetTypeTag::U64;
                        if (operation <= 1 && check == 1)
                            || (operation == 2 && check == 0)
                            || ((operation == 5 || operation == 6) && check == 1) { wanted = TargetTypeTag::Pointer; }
                        let operand: TargetOperand = unsafe { *(operands + instruction.first_operand + check) };
                        if !target_value_matches(values, target_section.value_count, operand.value_id, wanted) { return false; }
                        check = check + 1;
                    }
                } else if instruction.opcode == TargetOpcode::AllocStack {
                    if instruction.result_value == TARGET_VALUE_NONE
                        || instruction.type_tag != TargetTypeTag::Pointer
                        || instruction.operand_count != 0
                        || instruction.immediate_bits == 0 {
                        return false;
                    }
                } else if instruction.opcode == TargetOpcode::Store {
                    if instruction.result_value != TARGET_VALUE_NONE
                        || instruction.operand_count != 2 {
                        return false;
                    }
                    let ptr_op: TargetOperand = unsafe { *(operands + instruction.first_operand) };
                    let val_op: TargetOperand = unsafe { *(operands + instruction.first_operand + 1) };
                    if ptr_op.value_id == TARGET_VALUE_NONE || val_op.value_id == TARGET_VALUE_NONE
                        || ptr_op.value_id > target_section.value_count || val_op.value_id > target_section.value_count {
                        return false;
                    }
                    let ptr_type: TargetTypeTag = unsafe { (*(values + ptr_op.value_id as usize - 1)).type_tag };
                    let val_type: TargetTypeTag = unsafe { (*(values + val_op.value_id as usize - 1)).type_tag };
                    if ptr_type != TargetTypeTag::Pointer || val_type != instruction.type_tag {
                        return false;
                    }
                } else if instruction.opcode == TargetOpcode::Load {
                    if instruction.result_value == TARGET_VALUE_NONE
                        || instruction.operand_count != 1 {
                        return false;
                    }
                    let ptr_op: TargetOperand = unsafe { *(operands + instruction.first_operand) };
                    if ptr_op.value_id == TARGET_VALUE_NONE || ptr_op.value_id > target_section.value_count {
                        return false;
                    }
                    let ptr_type: TargetTypeTag = unsafe { (*(values + ptr_op.value_id as usize - 1)).type_tag };
                    if ptr_type != TargetTypeTag::Pointer {
                        return false;
                    }
                }

                if instruction.opcode == TargetOpcode::Branch
                    || instruction.opcode == TargetOpcode::CondBranch {
                    let mut target_offset: u32 = 0;
                    while target_offset < instruction.target_count {
                        let target_id: u32 = unsafe {
                            *(targets + instruction.first_target + target_offset)
                        };
                        if !target_cfg_has_block(
                            blocks, function.first_block, function.block_count,
                            target_id
                        ) {
                            return false;
                        }
                        target_offset = target_offset + 1;
                    }
                }
                instruction_offset = instruction_offset + 1;
            }
            block_offset = block_offset + 1;
        }
        function_index = function_index + 1;
    }
    return true;
}

// Validate call targets against the function table, including external
// declarations. This keeps a direct call's symbol, arity and scalar types
// consistent before backend-specific ABI lowering.

pub fn target_debug_slices_valid(source_len: usize, block_count: u32, blocks: *const TargetBlock,
    instruction_count: u32, instructions: *const TargetInstruction) -> bool {
    if (block_count != 0 && blocks == null) || (instruction_count != 0 && instructions == null) { return false; }
    let mut index: u32=0;
    while index < block_count {
        if !target_source_slice_valid(unsafe{(*(blocks+index)).label},source_len) { return false; }index=index+1;
    }
    index=0;while index < instruction_count {
        if !target_source_slice_valid(unsafe{(*(instructions+index)).source_point},source_len) { return false; }index=index+1;
    }
    return true;
}

// Independent functions cannot claim the same flat parameter/block rows.
pub fn target_ranges_overlap(first: u32, count: u32, other: u32, other_count: u32) -> bool {
    if count == 0 || other_count == 0 { return false; }
    if first <= other { return other-first < count; }return first-other < other_count;
}

pub fn target_function_partitions_valid(count: u32, functions: *const TargetFunction) -> bool {
    if count != 0 && functions == null { return false; }
    let mut index:u32=0;while index < count {
        let first:TargetFunction=unsafe{*(functions+index)};let mut other:u32=0;
        while other < index {
            let second:TargetFunction=unsafe{*(functions+other)};
            if target_ranges_overlap(first.first_parameter,first.parameter_count,second.first_parameter,second.parameter_count)
                || target_ranges_overlap(first.first_block,first.block_count,second.first_block,second.block_count) { return false; }
            other=other+1;
        }index=index+1;
    }return true;
}

pub fn target_names_equal(source: *const u8, length: usize, left: TargetSourceSlice, right: TargetSourceSlice) -> bool {
    if source == null || left.length == 0 || left.length != right.length
        || !target_source_slice_valid(left,length) || !target_source_slice_valid(right,length) { return false; }
    let mut index:usize=0;while index < left.length {
        if unsafe{*(source+left.offset+index)} != unsafe{*(source+right.offset+index)} { return false; }index=index+1;
    }return true;
}

pub fn target_function_names_unique(source: *const u8, length: usize, count: u32, functions: *const TargetFunction) -> bool {
    if count != 0 && functions == null { return false; }
    let mut index:u32=0;while index < count { let mut other:u32=0;
        while other < index {
            if target_names_equal(source,length,unsafe{(*(functions+index)).name},unsafe{(*(functions+other)).name}) { return false; }other=other+1;
        }index=index+1;
    }return true;
}

pub fn target_parameter_names_unique(source: *const u8, length: usize, count: u32, parameters: *const TargetParameter) -> bool {
    if count != 0 && parameters == null { return false; }
    let mut index:u32=0;while index < count { let mut other:u32=0;
        while other < index {
            if target_names_equal(source,length,unsafe{(*(parameters+index)).name},unsafe{(*(parameters+other)).name}) { return false; }other=other+1;
        }index=index+1;
    }return true;
}

pub fn target_module_validate_calls(
    source: *const u8,
    source_len: usize,
    target_module: *const TargetModule,
    functions: *const TargetFunction,
    parameters: *const TargetParameter,
    values: *const TargetValue,
    blocks: *const TargetBlock,
    instructions: *const TargetInstruction,
    operands: *const TargetOperand,
    phi_inputs: *const TargetPhiInput,
    targets: *const u32
) -> bool {
    if source == null || target_module == null || functions == null
        || (unsafe { (*target_module).parameter_count } != 0 && parameters == null)
        || (unsafe { (*target_module).value_count } != 0 && values == null)
        || (unsafe { (*target_module).block_count } != 0 && blocks == null)
        || (unsafe { (*target_module).instruction_count } != 0 && instructions == null)
        || (unsafe { (*target_module).operand_count } != 0 && operands == null)
        || !target_module_validate_cfg(
            target_module, functions, parameters, values, blocks, instructions,
            operands, phi_inputs, targets
        ) {
        return false;
    }
    let target_section: TargetModule = unsafe { *target_module };
    if !target_debug_slices_valid(source_len,target_section.block_count,blocks,
        target_section.instruction_count,instructions) { return false; }
    // Source identities are part of the IR boundary, including declarations
    // that are never called. Validate before any writer reads symbol bytes.
    let mut name_index: u32 = 0;
    while name_index < target_section.function_count {
        let named_function: TargetFunction = unsafe { *(functions+name_index) };
        if named_function.name.length == 0
            || !target_source_slice_valid(named_function.name,source_len) { return false; }
        name_index = name_index+1;
    }
    name_index = 0;
    while name_index < target_section.parameter_count {
        let named_parameter: TargetParameter = unsafe { *(parameters+name_index) };
        if !target_source_slice_valid(named_parameter.name,source_len) { return false; }
        name_index = name_index+1;
    }
    name_index = 0;
    while name_index < target_section.value_count {
        let named_value: TargetValue = unsafe { *(values+name_index) };
        if !target_source_slice_valid(named_value.source_name,source_len) { return false; }
        name_index = name_index+1;
    }
    if !target_function_partitions_valid(target_section.function_count,functions)
        || !target_function_names_unique(source,source_len,target_section.function_count,functions) { return false; }
    let mut function_index: u32 = 0;
    while function_index < target_section.function_count {
        let caller: TargetFunction = unsafe { *(functions + function_index) };
        if !target_parameter_names_unique(source,source_len,caller.parameter_count,
            unsafe{parameters+caller.first_parameter}) { return false; }
        let mut block_offset: u32 = 0;
        while block_offset < caller.block_count {
            let block: TargetBlock = unsafe { *(blocks + caller.first_block + block_offset) };
            let mut instruction_offset: u32 = 0;
            while instruction_offset < block.instruction_count {
                let instruction: TargetInstruction = unsafe {
                    *(instructions + block.first_instruction + instruction_offset)
                };
                if instruction.opcode == TargetOpcode::Call {
                    if instruction.symbol.length == 0 || instruction.symbol.offset > source_len
                        || instruction.symbol.length > source_len - instruction.symbol.offset {
                        return false;
                    }
                    let mut callee_index: u32 = 0;
                    while callee_index < target_section.function_count {
                        let callee: TargetFunction = unsafe { *(functions + callee_index) };
                        if callee.name.length == instruction.symbol.length
                            && callee.name.offset <= source_len
                            && callee.name.length <= source_len - callee.name.offset {
                            let mut name_index: usize = 0;
                            let mut names_match: bool = true;
                            while name_index < callee.name.length {
                                let callee_byte: u8 = unsafe {
                                    *(source + callee.name.offset + name_index)
                                };
                                let symbol_byte: u8 = unsafe {
                                    *(source + instruction.symbol.offset + name_index)
                                };
                                if callee_byte != symbol_byte {
                                    names_match = false;
                                    break;
                                }
                                name_index = name_index + 1;
                            }
                            if names_match { break; }
                        }
                        callee_index = callee_index + 1;
                    }
                    if callee_index >= target_section.function_count { return false; }
                    let callee: TargetFunction = unsafe { *(functions + callee_index) };
                    if callee.return_type != instruction.type_tag
                        || callee.parameter_count != instruction.operand_count {
                        return false;
                    }
                    let mut argument_index: u32 = 0;
                    while argument_index < instruction.operand_count {
                        let argument: TargetOperand = unsafe {
                            *(operands + instruction.first_operand + argument_index)
                        };
                        let argument_type: TargetTypeTag = unsafe {
                            (*(values + argument.value_id as usize - 1)).type_tag
                        };
                        let parameter: TargetParameter = unsafe {
                            *(parameters + callee.first_parameter + argument_index)
                        };
                        if argument_type != parameter.type_tag { return false; }
                        // SV8.48c: for typed calls, verify each 2-bit
                        // argument capability against the callee's own
                        // parameter domain, not merely its scalar ABI type.
                        if instruction.flags == TARGET_CALL_CAPABILITIES_TYPED {
                            let actual_role: u64 = (instruction.immediate_bits >>
                                ((argument_index as u64) * 2)) & 3;
                            if (callee.flags & TARGET_FUNCTION_EXTERNAL) != 0 {
                                // Imported declarations expose no owned
                                // parameter SSA domain; no non-plain
                                // capability is certified across FFI.
                                if actual_role != 0 { return false; }
                            } else {
                                if parameter.value_id == TARGET_VALUE_NONE
                                    || parameter.value_id > target_section.value_count {
                                    return false;
                                }
                                // Hidden aggregate-return storage is an
                                // ABI destination, not a source argument.
                                // A sole result retains its owned SSA domain,
                                // but its final synthetic pointer is plain.
                                if parameter.name.length == 0 {
                                    if parameter.name.offset != 0
                                        || argument_index + 1 != instruction.operand_count
                                        || callee.return_type != TargetTypeTag::Void
                                        || parameter.type_tag != TargetTypeTag::Pointer
                                        || actual_role != 0 { return false; }
                                } else {
                                    let domain_flags: u32 = unsafe {
                                        (*(values + parameter.value_id as usize - 1)).flags
                                    };
                                    let domain: u32 = (domain_flags & TARGET_VALUE_DOMAIN_MASK)
                                        >> TARGET_VALUE_DOMAIN_SHIFT;
                                    let mut expected_role: u64 = 0;
                                    if domain == 1 { expected_role = 1; }
                                    else if domain == 4 { expected_role = 2; }
                                    else if domain == 6 { expected_role = 3; }
                                    else if domain != 0 { return false; }
                                    if actual_role != expected_role { return false; }
                                }
                            }
                        }
                        argument_index = argument_index + 1;
                    }
                }
                instruction_offset = instruction_offset + 1;
            }
            block_offset = block_offset + 1;
        }
        function_index = function_index + 1;
    }
    return true;
}

// Add full reachable-block dominance checks to the structural CFG validator.
// The caller provides bounded scratch storage so this pass works without a
// host allocator and can be used by both hosted and barecore builds.
pub fn target_module_validate_ssa_dominance(
    target_module: *const TargetModule,
    functions: *const TargetFunction,
    parameters: *const TargetParameter,
    values: *const TargetValue,
    blocks: *const TargetBlock,
    instructions: *const TargetInstruction,
    operands: *const TargetOperand,
    phi_inputs: *const TargetPhiInput,
    targets: *const u32,
    scratch: *mut u8,
    scratch_capacity: usize
) -> bool {
    if !target_module_validate_cfg(
        target_module, functions, parameters, values, blocks, instructions,
        operands, phi_inputs, targets
    ) { return false; }
    let target_section: TargetModule = unsafe { *target_module };
    let mut function_index: u32 = 0;
    while function_index < target_section.function_count {
        let function: TargetFunction = unsafe { *(functions + function_index) };
        let block_count: usize = function.block_count as usize;
        if block_count > 4096 { return false; }
        let stride: usize = (block_count + 7) / 8;
        let matrix_size: usize = block_count * stride;
        let needed: usize = matrix_size + stride + block_count;
        if scratch == null || scratch_capacity < needed { return false; }
        let dominators: *mut u8 = scratch;
        let temporary: *mut u8 = unsafe { scratch + matrix_size };
        let reachable: *mut u8 = unsafe { scratch + matrix_size + stride };

        let mut byte_index: usize = 0;
        while byte_index < needed {
            unsafe { *(scratch + byte_index) = 0; }
            byte_index = byte_index + 1;
        }
        unsafe { *reachable = 1; }
        let mut reach_changed: bool = true;
        let mut reach_round: u32 = 0;
        while reach_changed && reach_round < function.block_count {
            reach_changed = false;
            let mut destination_offset: u32 = 1;
            while destination_offset < function.block_count {
                let destination_reachable: u8 = unsafe {
                    *(reachable + destination_offset as usize)
                };
                if destination_reachable == 0 {
                    let destination: TargetBlock = unsafe {
                        *(blocks + function.first_block + destination_offset)
                    };
                    let mut predecessor_offset: u32 = 0;
                    while predecessor_offset < function.block_count {
                        let predecessor: TargetBlock = unsafe {
                            *(blocks + function.first_block + predecessor_offset)
                        };
                        let predecessor_reachable: u8 = unsafe {
                            *(reachable + predecessor_offset as usize)
                        };
                        if predecessor_reachable != 0
                            && target_cfg_block_has_edge(
                                &predecessor, instructions, targets, destination.id
                            ) {
                            unsafe { *(reachable + destination_offset as usize) = 1; }
                            reach_changed = true;
                            break;
                        }
                        predecessor_offset = predecessor_offset + 1;
                    }
                }
                destination_offset = destination_offset + 1;
            }
            reach_round = reach_round + 1;
        }

        let mut block_offset: u32 = 0;
        while block_offset < function.block_count {
            let row_offset: usize = block_offset as usize * stride;
            let mut row_byte: usize = 0;
            while row_byte < stride {
                unsafe { *(dominators + row_offset + row_byte) = 255; }
                row_byte = row_byte + 1;
            }
            if block_offset == 0
                || unsafe { *(reachable + block_offset as usize) } == 0 {
                row_byte = 0;
                while row_byte < stride {
                    unsafe { *(dominators + row_offset + row_byte) = 0; }
                    row_byte = row_byte + 1;
                }
                let own_bit: u8 = (1 << (block_offset % 8)) as u8;
                unsafe { *(dominators + row_offset + block_offset as usize / 8) = own_bit; }
            }
            block_offset = block_offset + 1;
        }

        let mut dom_changed: bool = true;
        let mut dom_round: u32 = 0;
        while dom_changed && dom_round <= function.block_count {
            dom_changed = false;
            block_offset = 1;
            while block_offset < function.block_count {
                if unsafe { *(reachable + block_offset as usize) } != 0 {
                    let destination: TargetBlock = unsafe {
                        *(blocks + function.first_block + block_offset)
                    };
                    let mut row_byte: usize = 0;
                    while row_byte < stride {
                        unsafe { *(temporary + row_byte) = 255; }
                        row_byte = row_byte + 1;
                    }
                    let mut predecessor_count: u32 = 0;
                    let mut predecessor_offset: u32 = 0;
                    while predecessor_offset < function.block_count {
                        if unsafe { *(reachable + predecessor_offset as usize) } != 0 {
                            let predecessor: TargetBlock = unsafe {
                                *(blocks + function.first_block + predecessor_offset)
                            };
                            if target_cfg_block_has_edge(
                                &predecessor, instructions, targets, destination.id
                            ) {
                                predecessor_count = predecessor_count + 1;
                                row_byte = 0;
                                while row_byte < stride {
                                    let current: u8 = unsafe {
                                        *(temporary + row_byte)
                                    };
                                    let incoming: u8 = unsafe {
                                        *(dominators + predecessor_offset as usize * stride + row_byte)
                                    };
                                    unsafe { *(temporary + row_byte) = current & incoming; }
                                    row_byte = row_byte + 1;
                                }
                            }
                        }
                        predecessor_offset = predecessor_offset + 1;
                    }
                    if predecessor_count == 0 {
                        row_byte = 0;
                        while row_byte < stride {
                            unsafe { *(temporary + row_byte) = 0; }
                            row_byte = row_byte + 1;
                        }
                    }
                    let own_bit: u8 = (1 << (block_offset % 8)) as u8;
                    let own_byte: usize = block_offset as usize / 8;
                    unsafe { *(temporary + own_byte) = *(temporary + own_byte) | own_bit; }
                    row_byte = 0;
                    while row_byte < stride {
                        let old_value: u8 = unsafe {
                            *(dominators + block_offset as usize * stride + row_byte)
                        };
                        let new_value: u8 = unsafe { *(temporary + row_byte) };
                        if old_value != new_value { dom_changed = true; }
                        unsafe {
                            *(dominators + block_offset as usize * stride + row_byte) = new_value;
                        }
                        row_byte = row_byte + 1;
                    }
                }
                block_offset = block_offset + 1;
            }
            dom_round = dom_round + 1;
        }
        if dom_changed { return false; }

        block_offset = 0;
        while block_offset < function.block_count {
            let block: TargetBlock = unsafe {
                *(blocks + function.first_block + block_offset)
            };
            let mut instruction_offset: u32 = 0;
            while instruction_offset < block.instruction_count {
                let instruction: TargetInstruction = unsafe {
                    *(instructions + block.first_instruction + instruction_offset)
                };
                let mut operand_offset: u32 = 0;
                while operand_offset < instruction.operand_count {
                    let operand: TargetOperand = unsafe {
                        *(operands + instruction.first_operand + operand_offset)
                    };
                    if !target_value_dominates_point(
                        &function, parameters, blocks, instructions, dominators,
                        stride, operand.value_id, block.id, instruction_offset
                    ) { return false; }
                    operand_offset = operand_offset + 1;
                }
                let mut phi_offset: u32 = 0;
                while phi_offset < instruction.phi_input_count {
                    let incoming: TargetPhiInput = unsafe {
                        *(phi_inputs + instruction.first_phi_input + phi_offset)
                    };
                    let predecessor_offset: u32 = target_cfg_block_offset(
                        blocks, &function, incoming.block_id
                    );
                    if predecessor_offset >= function.block_count { return false; }
                    let predecessor: TargetBlock = unsafe {
                        *(blocks + function.first_block + predecessor_offset)
                    };
                    if !target_value_dominates_point(
                        &function, parameters, blocks, instructions, dominators,
                        stride, incoming.value_id, incoming.block_id,
                        predecessor.instruction_count - 1
                    ) { return false; }
                    phi_offset = phi_offset + 1;
                }
                instruction_offset = instruction_offset + 1;
            }
            block_offset = block_offset + 1;
        }
        function_index = function_index + 1;
    }
    return true;
}

pub static mut g_rodata_buf: [u8; 65536] = 0;
pub static mut g_rodata_len: usize = 0;
pub const TARGET_RODATA_SYMBOL_CAPACITY: usize = 2048;
pub static mut g_rodata_sym_offsets: [usize; 2048] = 0;
pub static mut g_rodata_sym_lens: [usize; 2048] = 0;
pub static mut g_rodata_sym_places: [usize; 2048] = 0;
pub static mut g_rodata_sym_sizes: [usize; 2048] = 0;
pub static mut g_rodata_sym_count: usize = 0;

pub static mut g_bss_total_size: usize = 0;
pub static mut g_bss_sym_offsets: [usize; 256] = 0;
pub static mut g_bss_sym_lens: [usize; 256] = 0;
pub static mut g_bss_sym_places: [usize; 256] = 0;
pub static mut g_bss_sym_sizes: [usize; 256] = 0;
pub static mut g_bss_sym_is_array: [u8; 256] = 0;
pub static mut g_bss_sym_types: [u32; 256] = 0;
pub static mut g_bss_sym_element_types: [u32; 256] = 0;
pub static mut g_bss_sym_element_structs: [u32; 256] = 0;
pub static mut g_bss_sym_element_strides: [usize; 256] = 0;
pub static mut g_bss_sym_element_counts: [usize; 256] = 0;
pub static mut g_bss_sym_type_refs: [usize; 256] = 0;
pub static mut g_bss_sym_count: usize = 0;
pub static mut g_data_total_size: usize = 0;
pub static mut g_bss_sym_initial_bits: [u64; 256] = 0;
pub static mut g_bss_sym_initial_stride: [usize; 256] = 0;
// Explicit static lists share a bounded table of folded scalar values.
// Repeated initializers keep their compact representation above.
pub const TARGET_STATIC_LIST_CAPACITY: usize = 4096;
pub static mut g_static_list_values: [u64; 4096] = 0;
pub static mut g_static_list_count: usize = 0;
pub static mut g_bss_sym_initial_start: [usize; 256] = 0;
pub static mut g_bss_sym_initial_count: [usize; 256] = 0;

@export
@system
pub fn sotlas_native_get_rodata_buffer() -> *const u8 {
    return unsafe { g_rodata_buf as *const u8 };
}

@export
@system
pub fn sotlas_native_get_rodata_len() -> usize {
    return unsafe { g_rodata_len };
}

@export
@system
pub fn sotlas_native_get_bss_size() -> usize {
    return unsafe { g_bss_total_size };
}

@export
@system
pub fn sotlas_native_get_rodata_sym_count() -> usize {
    return unsafe { g_rodata_sym_count };
}

@export
@system
pub fn sotlas_native_get_rodata_sym_offset(index: usize) -> usize {
    if index >= unsafe { g_rodata_sym_count } { return 0; }
    return unsafe { g_rodata_sym_offsets[index] };
}

@export
@system
pub fn sotlas_native_get_rodata_sym_len(index: usize) -> usize {
    if index >= unsafe { g_rodata_sym_count } { return 0; }
    return unsafe { g_rodata_sym_lens[index] };
}

@export
@system
pub fn sotlas_native_get_rodata_sym_place(index: usize) -> usize {
    if index >= unsafe { g_rodata_sym_count } { return 0; }
    return unsafe { g_rodata_sym_places[index] };
}

@export
@system
pub fn sotlas_native_get_rodata_sym_size(index: usize) -> usize {
    if index >= unsafe { g_rodata_sym_count } { return 0; }
    return unsafe { g_rodata_sym_sizes[index] };
}

@export
@system
pub fn sotlas_native_get_bss_sym_count() -> usize {
    return unsafe { g_bss_sym_count };
}

@export
@system
pub fn sotlas_native_get_bss_sym_offset(index: usize) -> usize {
    if index >= unsafe { g_bss_sym_count } { return 0; }
    return unsafe { g_bss_sym_offsets[index] };
}

@export
@system
pub fn sotlas_native_get_bss_sym_len(index: usize) -> usize {
    if index >= unsafe { g_bss_sym_count } { return 0; }
    return unsafe { g_bss_sym_lens[index] };
}

@export
@system
pub fn sotlas_native_get_bss_sym_place(index: usize) -> usize {
    if index >= unsafe { g_bss_sym_count } { return 0; }
    return unsafe { g_bss_sym_places[index] };
}

@export
@system
pub fn sotlas_native_get_bss_sym_size(index: usize) -> usize {
    if index >= unsafe { g_bss_sym_count } { return 0; }
    return unsafe { g_bss_sym_sizes[index] };
}



// SV8.68: machine-independent, Sotlas-owned pre-link interface contracts.
// All names are slices into one caller-owned immutable source-name buffer.
// Parameter records are a flat caller-owned table. This is a verified
// pre-link contract, NOT an emitted ELF/PE/Mach-O import metadata format.
pub const TARGET_INTERFACE_EXPORT: u32 = 1;
pub const TARGET_INTERFACE_IMPORT: u32 = 2;

pub struct TargetInterfaceParameter {
    pub type_tag: TargetTypeTag;
    // 0=plain, 1=sole, 2=direct, 3=whisper.
    pub role: u32;
}

pub struct TargetInterface {
    pub name: TargetSourceSlice;
    pub return_type: TargetTypeTag;
    pub first_parameter: u32;
    pub parameter_count: u32;
    // Opaque bitmasks whose subset checks enforce least privilege.
    pub effects: u64;
    pub required_capabilities: u64;
    pub flags: u32;
}

// Individual signatures are restricted to the scalar/pointer ABI
// certified by the native object writer. Generic aggregates, variadics,
// arbitrary resource payload layout and FFI-specific roles fail closed.
pub fn target_interface_valid(
    source: *const u8, source_len: usize, entry: TargetInterface,
    parameters: *const TargetInterfaceParameter, parameter_count: u32
) -> bool {
    if source == null || entry.name.length == 0 || entry.name.length > 4096
        || !target_source_slice_valid(entry.name,source_len)
        || (entry.flags != TARGET_INTERFACE_EXPORT
            && entry.flags != TARGET_INTERFACE_IMPORT)
        || !target_type_is_return(entry.return_type)
        || entry.return_type == TargetTypeTag::Aggregate
        || entry.parameter_count > 24
        || !target_range_is_valid(entry.first_parameter,entry.parameter_count,parameter_count)
        || (entry.parameter_count != 0 && parameters == null) { return false; }
    let mut index: u32 = 0;
    while index < entry.parameter_count {
        let parameter: TargetInterfaceParameter = unsafe {
            *(parameters+entry.first_parameter+index)
        };
        if !target_type_is_value(parameter.type_tag)
            || parameter.type_tag == TargetTypeTag::Aggregate
            || parameter.role > 3 { return false; }
        index = index + 1;
    }
    return true;
}

// Repeated symbol spellings are ambiguous at the pre-link boundary,
// even if the repeated records otherwise carry identical types.
pub fn target_interfaces_unique(
    source: *const u8, source_len: usize,
    entries: *const TargetInterface, count: u32,
    parameters: *const TargetInterfaceParameter, parameter_count: u32,
    expected_flag: u32
) -> bool {
    if expected_flag != TARGET_INTERFACE_EXPORT
        && expected_flag != TARGET_INTERFACE_IMPORT { return false; }
    if count != 0 && entries == null { return false; }
    let mut index: u32 = 0;
    while index < count {
        let candidate: TargetInterface = unsafe { *(entries+index) };
        if candidate.flags != expected_flag
            || !target_interface_valid(source,source_len,candidate,
                parameters,parameter_count) { return false; }
        let mut previous: u32 = 0;
        while previous < index {
            let older: TargetInterface = unsafe { *(entries+previous) };
            if target_names_equal(source,source_len,candidate.name,older.name) {
                return false;
            }
            previous = previous + 1;
        }
        index = index + 1;
    }
    return true;
}

// A callee may use a subset of effects and required authority promised
// by the importing declaration, but never a superset. ABI types and
// ownership roles must agree exactly; no role gets silently erased.
pub fn target_interface_compatible(
    source: *const u8, source_len: usize,
    imported: TargetInterface, exported: TargetInterface,
    parameters: *const TargetInterfaceParameter, parameter_count: u32
) -> bool {
    if imported.flags != TARGET_INTERFACE_IMPORT
        || exported.flags != TARGET_INTERFACE_EXPORT
        || !target_interface_valid(source,source_len,imported,
            parameters,parameter_count)
        || !target_interface_valid(source,source_len,exported,
            parameters,parameter_count)
        || !target_names_equal(source,source_len,imported.name,exported.name)
        || imported.return_type != exported.return_type
        || imported.parameter_count != exported.parameter_count
        || (exported.effects & ~imported.effects) != 0
        || (exported.required_capabilities
            & ~imported.required_capabilities) != 0 { return false; }
    let mut index: u32 = 0;
    while index < imported.parameter_count {
        let expected: TargetInterfaceParameter = unsafe {
            *(parameters+imported.first_parameter+index)
        };
        let actual: TargetInterfaceParameter = unsafe {
            *(parameters+exported.first_parameter+index)
        };
        if expected.type_tag != actual.type_tag
            || expected.role != actual.role { return false; }
        index = index + 1;
    }
    return true;
}

// Resolve a single imported symbol against one validated export manifest.
// Do not alter the output index if no unique ABI-compatible symbol exists.
pub fn target_interface_resolve(
    source: *const u8, source_len: usize, imported: TargetInterface,
    exports: *const TargetInterface, export_count: u32,
    parameters: *const TargetInterfaceParameter, parameter_count: u32,
    output: *mut u32
) -> bool {
    if output == null || (export_count != 0 && exports == null)
        || !target_interface_valid(source,source_len,imported,
            parameters,parameter_count)
        || imported.flags != TARGET_INTERFACE_IMPORT { return false; }
    let mut found: bool = false;
    let mut selected: u32 = 0;
    let mut index: u32 = 0;
    while index < export_count {
        let candidate: TargetInterface = unsafe { *(exports+index) };
        if !target_interface_valid(source,source_len,candidate,
            parameters,parameter_count)
            || candidate.flags != TARGET_INTERFACE_EXPORT { return false; }
        if target_names_equal(source,source_len,imported.name,candidate.name) {
            if found || !target_interface_compatible(source,source_len,
                imported,candidate,parameters,parameter_count) { return false; }
            found = true;
            selected = index;
        }
        index = index + 1;
    }
    if !found { return false; }
    unsafe { *output = selected; }
    return true;
}

// First validate *every* import/export and binding, then publish the
// selected export indices. Failed imports never leave partial output.
// This is single-threaded: input manifests and output cannot alias.
pub fn target_interface_bind_manifest(
    source: *const u8, source_len: usize,
    imports: *const TargetInterface, import_count: u32,
    exports: *const TargetInterface, export_count: u32,
    parameters: *const TargetInterfaceParameter, parameter_count: u32,
    output: *mut u32, output_capacity: u32
) -> bool {
    if output_capacity < import_count
        || (import_count != 0 && output == null)
        || !target_interfaces_unique(source,source_len,imports,import_count,
            parameters,parameter_count,TARGET_INTERFACE_IMPORT)
        || !target_interfaces_unique(source,source_len,exports,export_count,
            parameters,parameter_count,TARGET_INTERFACE_EXPORT) { return false; }
    let mut index: u32 = 0;
    while index < import_count {
        let item: TargetInterface = unsafe { *(imports+index) };
        let mut matched: u32 = 0;
        if !target_interface_resolve(source,source_len,item,exports,
            export_count,parameters,parameter_count,
            unsafe { (&mut matched) as *mut u32 }) { return false; }
        index = index + 1;
    }
    // Nothing above writes the output. The verified immutable manifests
    // guarantee that the second pass cannot fail or choose another binding.
    index = 0;
    while index < import_count {
        let item: TargetInterface = unsafe { *(imports+index) };
        let mut matched: u32 = 0;
        if !target_interface_resolve(source,source_len,item,exports,
            export_count,parameters,parameter_count,
            unsafe { (&mut matched) as *mut u32 }) { return false; }
        unsafe { *(output+index) = matched; }
        index = index + 1;
    }
    return true;
}


// SV8.69: stable version-one little-endian wire representation of a single
// typed symbol interface. Format: 48-byte header (magic/version/flags/type/
// name-offset/name-length/param-count/reserved/effect bits/capability bits),
// followed by param-count (type,ownership-role) u32 pairs. Source spellings
// are external immutable byte slices. This is portable object-side metadata;
// the ELF/PE/Mach-O emitters do not yet install it in their symbol tables.
pub const TARGET_INTERFACE_WIRE_MAGIC: u32 = 0x49544f53;
pub const TARGET_INTERFACE_WIRE_VERSION: u32 = 1;
pub const TARGET_INTERFACE_WIRE_HEADER: usize = 48;

fn target_interface_wire_store_u32(bytes: *mut u8, at: usize, number: u32) -> void {
    let mut index: usize = 0;
    while index < 4 {
        unsafe { *(bytes+at+index) = (number >> ((index*8) as u32)) as u8; }
        index = index + 1;
    }
}

fn target_interface_wire_store_u64(bytes: *mut u8, at: usize, number: u64) -> void {
    let mut index: usize = 0;
    while index < 8 {
        unsafe { *(bytes+at+index) = (number >> ((index as u64)*8)) as u8; }
        index = index + 1;
    }
}

fn target_interface_wire_load_u32(bytes: *const u8, at: usize) -> u32 {
    let mut number: u32 = 0;
    let mut index: usize = 0;
    while index < 4 {
        number = number | ((unsafe { *(bytes+at+index) } as u32) << ((index*8) as u32));
        index = index + 1;
    }
    return number;
}

fn target_interface_wire_load_u64(bytes: *const u8, at: usize) -> u64 {
    let mut number: u64 = 0;
    let mut index: usize = 0;
    while index < 8 {
        number = number | ((unsafe { *(bytes+at+index) } as u64) << ((index as u64)*8));
        index = index + 1;
    }
    return number;
}

// Decode an integer tag without an unchecked numeric-to-enum cast.
fn target_interface_wire_type(code: u32) -> TargetTypeTag {
    if code == 1 { return TargetTypeTag::Bool; }
    if code == 2 { return TargetTypeTag::U8; }
    if code == 3 { return TargetTypeTag::U16; }
    if code == 4 { return TargetTypeTag::U32; }
    if code == 5 { return TargetTypeTag::U64; }
    if code == 6 { return TargetTypeTag::Usize; }
    if code == 7 { return TargetTypeTag::I8; }
    if code == 8 { return TargetTypeTag::I16; }
    if code == 9 { return TargetTypeTag::I32; }
    if code == 10 { return TargetTypeTag::I64; }
    if code == 11 { return TargetTypeTag::Isize; }
    if code == 12 { return TargetTypeTag::F32; }
    if code == 13 { return TargetTypeTag::F64; }
    if code == 14 { return TargetTypeTag::Pointer; }
    if code == 15 { return TargetTypeTag::Aggregate; }
    if code == 16 { return TargetTypeTag::Void; }
    return TargetTypeTag::Invalid;
}

// The maximum supported record is 48 + 24*8 = 240 bytes.
pub fn target_interface_wire_size(parameter_count: u32) -> usize {
    if parameter_count > 24 { return 0; }
    return TARGET_INTERFACE_WIRE_HEADER + (parameter_count as usize)*8;
}

// Encode only after checking *all* input. On failure do not mutate output,
// length or any portion of a previous generated metadata record.
pub fn target_interface_wire_encode(
    source: *const u8, source_len: usize, entry: TargetInterface,
    parameters: *const TargetInterfaceParameter, parameter_count: u32,
    output: *mut u8, capacity: usize, written: *mut usize
) -> bool {
    let needed: usize = target_interface_wire_size(entry.parameter_count);
    if output == null || written == null || needed == 0 || capacity < needed
        || entry.name.offset > 4294967295 || entry.name.length > 4294967295
        || !target_interface_valid(source,source_len,entry,
            parameters,parameter_count) { return false; }
    target_interface_wire_store_u32(output,0,TARGET_INTERFACE_WIRE_MAGIC);
    target_interface_wire_store_u32(output,4,TARGET_INTERFACE_WIRE_VERSION);
    target_interface_wire_store_u32(output,8,entry.flags);
    target_interface_wire_store_u32(output,12,entry.return_type as u32);
    target_interface_wire_store_u32(output,16,entry.name.offset as u32);
    target_interface_wire_store_u32(output,20,entry.name.length as u32);
    target_interface_wire_store_u32(output,24,entry.parameter_count);
    target_interface_wire_store_u32(output,28,0);
    target_interface_wire_store_u64(output,32,entry.effects);
    target_interface_wire_store_u64(output,40,entry.required_capabilities);
    let mut index: u32 = 0;
    while index < entry.parameter_count {
        let parameter: TargetInterfaceParameter = unsafe {
            *(parameters+entry.first_parameter+index)
        };
        let at: usize = TARGET_INTERFACE_WIRE_HEADER+(index as usize)*8;
        target_interface_wire_store_u32(output,at,parameter.type_tag as u32);
        target_interface_wire_store_u32(output,at+4,parameter.role);
        index = index + 1;
    }
    unsafe { *written = needed; }
    return true;
}

// Validate the exact wire extent before parsing any table fields. Untrusted
// wire bytes are not cast to packed native structs, avoiding alignment,
// platform pointer size, endian and padding dependencies.
pub fn target_interface_wire_valid(
    bytes: *const u8, length: usize,
    source: *const u8, source_len: usize
) -> bool {
    if bytes == null || source == null || length < TARGET_INTERFACE_WIRE_HEADER {
        return false;
    }
    if target_interface_wire_load_u32(bytes,0) != TARGET_INTERFACE_WIRE_MAGIC
        || target_interface_wire_load_u32(bytes,4) != TARGET_INTERFACE_WIRE_VERSION
        || target_interface_wire_load_u32(bytes,28) != 0 { return false; }
    let flags: u32 = target_interface_wire_load_u32(bytes,8);
    let ret: TargetTypeTag = target_interface_wire_type(
        target_interface_wire_load_u32(bytes,12));
    let off: usize = target_interface_wire_load_u32(bytes,16) as usize;
    let len: usize = target_interface_wire_load_u32(bytes,20) as usize;
    let count: u32 = target_interface_wire_load_u32(bytes,24);
    let required: usize = target_interface_wire_size(count);
    if required == 0 || length != required
        || (flags != TARGET_INTERFACE_IMPORT && flags != TARGET_INTERFACE_EXPORT)
        || !target_type_is_return(ret) || ret == TargetTypeTag::Aggregate
        || len == 0 || len > 4096
        || !target_source_slice_valid(TargetSourceSlice{offset:off,length:len},
            source_len) { return false; }
    let mut index: u32 = 0;
    while index < count {
        let at: usize = TARGET_INTERFACE_WIRE_HEADER+(index as usize)*8;
        let typ: TargetTypeTag = target_interface_wire_type(
            target_interface_wire_load_u32(bytes,at));
        let role: u32 = target_interface_wire_load_u32(bytes,at+4);
        if !target_type_is_value(typ) || typ == TargetTypeTag::Aggregate
            || role > 3 { return false; }
        index = index + 1;
    }
    return true;
}

// Transactional decode: neither output record, parameter slots nor count
// change unless the entire exact wire record and destination shape pass.
// Decoded parameter data begins at index zero in caller-supplied output.
pub fn target_interface_wire_decode(
    bytes: *const u8, length: usize,
    source: *const u8, source_len: usize,
    output: *mut TargetInterface,
    parameters: *mut TargetInterfaceParameter, parameter_capacity: u32
) -> bool {
    if output == null || !target_interface_wire_valid(bytes,length,source,source_len) {
        return false;
    }
    let count: u32 = target_interface_wire_load_u32(bytes,24);
    if count > parameter_capacity || (count != 0 && parameters == null) {
        return false;
    }
    let header: TargetInterface = TargetInterface {
        name: TargetSourceSlice {
            offset:target_interface_wire_load_u32(bytes,16) as usize,
            length:target_interface_wire_load_u32(bytes,20) as usize
        },
        return_type:target_interface_wire_type(target_interface_wire_load_u32(bytes,12)),
        first_parameter:0, parameter_count:count,
        effects:target_interface_wire_load_u64(bytes,32),
        required_capabilities:target_interface_wire_load_u64(bytes,40),
        flags:target_interface_wire_load_u32(bytes,8)
    };
    let mut index: u32 = 0;
    while index < count {
        let at: usize = TARGET_INTERFACE_WIRE_HEADER+(index as usize)*8;
        unsafe {
            *(parameters+index) = TargetInterfaceParameter {
                type_tag:target_interface_wire_type(target_interface_wire_load_u32(bytes,at)),
                role:target_interface_wire_load_u32(bytes,at+4)
            };
        }
        index = index + 1;
    }
    unsafe { *output = header; }
    return true;
}

// Validate encoded records themselves, so consumers can reject ABI and
// authority mismatches without decoding into host-language objects.
pub fn target_interface_wire_compatible(
    imported: *const u8, import_len: usize,
    exported: *const u8, export_len: usize,
    source: *const u8, source_len: usize
) -> bool {
    if !target_interface_wire_valid(imported,import_len,source,source_len)
        || !target_interface_wire_valid(exported,export_len,source,source_len)
        || target_interface_wire_load_u32(imported,8) != TARGET_INTERFACE_IMPORT
        || target_interface_wire_load_u32(exported,8) != TARGET_INTERFACE_EXPORT
        || target_interface_wire_load_u32(imported,12)
            != target_interface_wire_load_u32(exported,12)
        || target_interface_wire_load_u32(imported,24)
            != target_interface_wire_load_u32(exported,24) { return false; }
    let first_name: TargetSourceSlice = TargetSourceSlice {
        offset:target_interface_wire_load_u32(imported,16) as usize,
        length:target_interface_wire_load_u32(imported,20) as usize
    };
    let second_name: TargetSourceSlice = TargetSourceSlice {
        offset:target_interface_wire_load_u32(exported,16) as usize,
        length:target_interface_wire_load_u32(exported,20) as usize
    };
    if !target_names_equal(source,source_len,first_name,second_name)
        || (target_interface_wire_load_u64(exported,32)
            & ~target_interface_wire_load_u64(imported,32)) != 0
        || (target_interface_wire_load_u64(exported,40)
            & ~target_interface_wire_load_u64(imported,40)) != 0 { return false; }
    let count: u32 = target_interface_wire_load_u32(imported,24);
    let mut index: u32 = 0;
    while index < count {
        let at: usize = TARGET_INTERFACE_WIRE_HEADER+(index as usize)*8;
        if target_interface_wire_load_u32(imported,at)
                != target_interface_wire_load_u32(exported,at)
            || target_interface_wire_load_u32(imported,at+4)
                != target_interface_wire_load_u32(exported,at+4) { return false; }
        index = index + 1;
    }
    return true;
}


// SV8.71: derive ABI types, arity and import/export identity from the
// compiler's own typed TargetFunction/TargetParameter IR, instead of trusting
// handwritten ABI parameter metadata. This is a deliberately bounded PLAIN
// parameter subset: TargetParameter does not yet carry ownership roles.
// Effect/capability masks are explicit caller assertions, NOT proofs of
// inferred machine effects or authority. Names are normalized to offset 0
// in a separately provided buffer containing exactly the symbol spelling.
pub fn target_interface_wire_encode_from_function_abi(
    source: *const u8, source_len: usize,
    function: TargetFunction,
    parameters: *const TargetParameter, parameter_count: u32,
    declared_effects: u64, declared_capabilities: u64,
    output: *mut u8, capacity: usize, written: *mut usize
) -> bool {
    let needed: usize = target_interface_wire_size(function.parameter_count);
    if source == null || output == null || written == null
        || needed == 0 || needed > capacity || function.name.length == 0
        || function.name.length > 4096 || function.name.length > 4294967295
        || !target_source_slice_valid(function.name,source_len)
        || !target_type_is_return(function.return_type)
        || function.return_type == TargetTypeTag::Aggregate
        || (function.flags & ~TARGET_FUNCTION_EXTERNAL) != 0
        || !target_range_is_valid(function.first_parameter,
            function.parameter_count,parameter_count)
        || (function.parameter_count != 0 && parameters == null) { return false; }
    // Complete preflight ensures an unsupported signature never damages
    // a previously written SOTI record or its written-length marker.
    let mut index: u32 = 0;
    while index < function.parameter_count {
        let parameter: TargetParameter = unsafe {
            *(parameters+function.first_parameter+index)
        };
        if !target_type_is_value(parameter.type_tag)
            || parameter.type_tag == TargetTypeTag::Aggregate { return false; }
        index = index+1;
    }
    let mut kind: u32 = TARGET_INTERFACE_EXPORT;
    if (function.flags & TARGET_FUNCTION_EXTERNAL) != 0 {
        kind = TARGET_INTERFACE_IMPORT;
    }
    target_interface_wire_store_u32(output,0,TARGET_INTERFACE_WIRE_MAGIC);
    target_interface_wire_store_u32(output,4,TARGET_INTERFACE_WIRE_VERSION);
    target_interface_wire_store_u32(output,8,kind);
    target_interface_wire_store_u32(output,12,function.return_type as u32);
    target_interface_wire_store_u32(output,16,0);
    target_interface_wire_store_u32(output,20,function.name.length as u32);
    target_interface_wire_store_u32(output,24,function.parameter_count);
    target_interface_wire_store_u32(output,28,0);
    target_interface_wire_store_u64(output,32,declared_effects);
    target_interface_wire_store_u64(output,40,declared_capabilities);
    index = 0;
    while index < function.parameter_count {
        let parameter: TargetParameter = unsafe {
            *(parameters+function.first_parameter+index)
        };
        let at: usize = TARGET_INTERFACE_WIRE_HEADER+(index as usize)*8;
        target_interface_wire_store_u32(output,at,parameter.type_tag as u32);
        target_interface_wire_store_u32(output,at+4,0);
        index = index+1;
    }
    unsafe { *written = needed; }
    return true;
}

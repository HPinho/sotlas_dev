                    let mem_offset: u32 = instruction.immediate_bits as u32;
                    if instruction.operand_count != 1
                        || !object_scalar_type(instruction.type_tag)
                        || result_type != instruction.type_tag
                        || object_value_type(values, ir.value_count, base_op.value_id) != TargetTypeTag::Pointer
                        || !append_object_slot_load_ptr(output, capacity, &mut code, base_op.value_id - slot_base) {
                        return false;
                    }
                    if instruction.type_tag == TargetTypeTag::U8 || instruction.type_tag == TargetTypeTag::Bool {
                        if !append_object_load_mem8(output, capacity, &mut code, mem_offset)
                            || !append_object_slot_store(output, capacity, &mut code, instruction.result_value - slot_base) {
                            return false;
                        }
                    } else if instruction.type_tag == TargetTypeTag::U16 {
                        if !append_object_load_mem16(output, capacity, &mut code, mem_offset)
                            || !append_object_slot_store(output, capacity, &mut code, instruction.result_value - slot_base) {
                            return false;
                        }
                    } else if object_type_is_64(instruction.type_tag) {
                        if !append_object_load_mem64(output, capacity, &mut code, mem_offset)
                            || !append_object_slot_store64(output, capacity, &mut code, instruction.result_value - slot_base) {
                            return false;
                        }
                    } else if !append_object_load_mem32(output, capacity, &mut code, mem_offset)
                        || !append_object_slot_store(output, capacity, &mut code, instruction.result_value - slot_base) {
                        return false;
                    }
                } else if instruction.opcode == TargetOpcode::Compare {
                    if instruction.operand_count != 2 || result_type != TargetTypeTag::Bool
                        || instruction.immediate_bits < 86 || instruction.immediate_bits > 91 {
                        return false;
                    }
                    let left: TargetOperand = unsafe { *(operands + instruction.first_operand) };
                    let right: TargetOperand = unsafe { *(operands + instruction.first_operand + 1) };
                    let left_type: TargetTypeTag = object_value_type(values, ir.value_count, left.value_id);
                    if !object_scalar_type(left_type)
                        || object_value_type(values, ir.value_count, right.value_id) != left_type
                        || (left_type == TargetTypeTag::Bool && instruction.immediate_bits > 87)
                        || (left_type == TargetTypeTag::Pointer && instruction.immediate_bits > 87)
                        || !append_object_slot_load_typed(output, capacity, &mut code, left.value_id - slot_base, left_type) {
                        return false;
                    }
                    if object_type_is_64(left_type)
                        && !append_object_byte(output, capacity, &mut code, 72) {
                        return false;
                    }
                    if !append_object_byte(output, capacity, &mut code, 59)
                        || !append_object_byte(output, capacity, &mut code, 133)
                        || !append_object_u32(output, capacity, &mut code, 0 as u32 - (right.value_id - slot_base) * 8) {
                        return false;
                    }
                    let mut setcc: u8 = 147 as u8;
                    if instruction.immediate_bits == 86 { setcc = 148 as u8; }
                    else if instruction.immediate_bits == 87 { setcc = 149 as u8; }
                    else if instruction.immediate_bits == 88 { setcc = 146 as u8; }
                    else if instruction.immediate_bits == 89 { setcc = 150 as u8; }
                    else if instruction.immediate_bits == 90 { setcc = 151 as u8; }
                    if left_type == TargetTypeTag::I64 {
                        if instruction.immediate_bits == 88 { setcc = 156 as u8; }
                        else if instruction.immediate_bits == 89 { setcc = 158 as u8; }
                        else if instruction.immediate_bits == 90 { setcc = 159 as u8; }
                        else if instruction.immediate_bits == 91 { setcc = 157 as u8; }
                    }
                    if !append_object_byte(output, capacity, &mut code, 15)
                        || !append_object_byte(output, capacity, &mut code, setcc)
                        || !append_object_byte(output, capacity, &mut code, 192)
                        || !append_object_byte(output, capacity, &mut code, 15)
                        || !append_object_byte(output, capacity, &mut code, 182)
                        || !append_object_byte(output, capacity, &mut code, 192)
                        || !append_object_slot_store(output, capacity, &mut code, instruction.result_value - slot_base) {
                        return false;
                    }
                } else if instruction.opcode == TargetOpcode::BoolAnd
                    || instruction.opcode == TargetOpcode::BoolOr {
                    if instruction.operand_count != 2 || result_type != TargetTypeTag::Bool {
                        return false;
                    }
                    let left: TargetOperand = unsafe {
                        *(operands + instruction.first_operand)
                    };
                    let right: TargetOperand = unsafe {
                        *(operands + instruction.first_operand + 1)
                    };
                    if object_value_type(values, ir.value_count, left.value_id)
                            != TargetTypeTag::Bool
                        || object_value_type(values, ir.value_count, right.value_id)
                            != TargetTypeTag::Bool
                        || !append_object_slot_load(
                            output, capacity, &mut code, left.value_id - slot_base
                        ) {
                        return false;
                    }
                    let mut opcode: u8 = 35 as u8;
                    if instruction.opcode == TargetOpcode::BoolOr {
                        opcode = 11 as u8;
                    }
                    if !append_object_byte(output, capacity, &mut code, opcode)
                        || !append_object_byte(output, capacity, &mut code, 133)
                        || !append_object_u32(
                            output, capacity, &mut code, 0 as u32 - (right.value_id - slot_base) * 8
                        )
                        || !append_object_slot_store(
                            output, capacity, &mut code, instruction.result_value - slot_base
                        ) {
                        return false;
                    }
                } else if instruction.opcode == TargetOpcode::SystemOp {
                    let darwin: bool = instruction.immediate_bits >= 16 && instruction.immediate_bits <= 19;
                    let mut operation: u64 = instruction.immediate_bits;
                    if darwin { operation = operation - 16; platform_flags = platform_flags | 2; }
                    else { platform_flags = platform_flags | 1; }
                    let mut expected: u32 = 3;
                    if operation == 3 { expected = 1; }
                    if operation > 3 || instruction.operand_count != expected
                        || result_type != TargetTypeTag::I64 || instruction.type_tag != result_type { return false; }
                    let mut argument_index: u32 = 0;
                    while argument_index < expected {
                        let argument: TargetOperand = unsafe { *(operands + instruction.first_operand + argument_index) };
                        let mut wanted: TargetTypeTag = TargetTypeTag::U64;
                        if (operation <= 1 && argument_index == 1)
                            || (operation == 2 && argument_index == 0) { wanted = TargetTypeTag::Pointer; }
                        if object_value_type(values, ir.value_count, argument.value_id) != wanted
                            || !append_object_slot_load_rax64(output, capacity, &mut code, argument.value_id - slot_base)
                            || !append_object_rax_to_argument(output, capacity, &mut code, argument_index) { return false; }
                        argument_index = argument_index + 1;
                    }
                    let mut syscall_number: u32 = operation as u32;
                    if darwin {
                        syscall_number = (operation as u32) + 33554435;
                        if operation == 1 { syscall_number = 33554436; }
                        if operation == 2 { syscall_number = 33554437; }
                        if operation == 3 { syscall_number = 33554438; }
                    }
                    if !append_object_byte(output, capacity, &mut code, 184)
                        || !append_object_u32(output, capacity, &mut code, syscall_number)
                        || !append_object_byte(output, capacity, &mut code, 15)
                        || !append_object_byte(output, capacity, &mut code, 5) { return false; }
                    // Darwin reports positive errno with CF set. Normalize to
                    // the negative-error contract used by the native drivers.
                    // jnc +3; neg rax. Nothing may clobber flags before jnc.
                    if darwin {
                        if !append_object_byte(output, capacity, &mut code, 115)
                            || !append_object_byte(output, capacity, &mut code, 3)
                            || !append_object_byte(output, capacity, &mut code, 72)
                            || !append_object_byte(output, capacity, &mut code, 247)
                            || !append_object_byte(output, capacity, &mut code, 216) { return false; }
                    }
                    if !append_object_slot_store64(output, capacity, &mut code, instruction.result_value - slot_base) { return false; }
                } else if instruction.opcode == TargetOpcode::Call {
                    let callee_index: u32 = object_find_function(
                        source, source_len, functions, ir.function_count, instruction.symbol
                    );
                    if callee_index >= ir.function_count || call_patch_count >= 4096 { return false; }
                    let callee: TargetFunction = unsafe { *(functions + callee_index) };
                    if callee.parameter_count != instruction.operand_count || instruction.operand_count > 24 { return false; }
                    if callee.return_type == TargetTypeTag::Void {
                        if instruction.result_value != 0 { return false; }
                    } else if result_type != callee.return_type || instruction.type_tag != callee.return_type {
                        return false;
                    }
                    let mut outgoing_bytes: u32 = 0;
                    if instruction.operand_count > 6 {
                        outgoing_bytes = (((instruction.operand_count - 6) * 8) + 15) & (0 as u32 - 16);
                    }
                    if !append_object_adjust_rsp(output, capacity, &mut code, outgoing_bytes, true) {
                        return false;
                    }
                    let mut argument_index: u32 = 0;
                    while argument_index < instruction.operand_count {
                        let argument: TargetOperand = unsafe { *(operands + instruction.first_operand + argument_index) };
                        let parameter: TargetParameter = unsafe { *(parameters + callee.first_parameter + argument_index) };
                        if object_value_type(values, ir.value_count, argument.value_id) != parameter.type_tag {
                            return false;
                        }
                        let is_64: bool = object_type_is_64(parameter.type_tag);
                        if is_64 {
                            if !append_object_slot_load_rax64(output, capacity, &mut code, argument.value_id - slot_base)
                                || (argument_index < 6
                                    && !append_object_rax_to_argument(output, capacity, &mut code, argument_index))
                                || (argument_index >= 6
                                    && !append_object_rax_to_stack_argument(output, capacity, &mut code, argument_index)) {
                                return false;
                            }
                        } else {
                            if !append_object_slot_load(output, capacity, &mut code, argument.value_id - slot_base)
                                || (argument_index < 6
                                    && !append_object_eax_to_argument(output, capacity, &mut code, argument_index))
                                || (argument_index >= 6
                                    && !append_object_rax_to_stack_argument(output, capacity, &mut code, argument_index)) {
                                return false;
                            }
                        }
                        argument_index = argument_index + 1;
                    }
                    if !append_object_byte(output, capacity, &mut code, 232) { return false; }
                    call_patch_offsets[call_patch_count as usize] = code;
                    call_patch_functions[call_patch_count as usize] = callee_index;
                    call_patch_count = call_patch_count + 1;
                    if !append_object_u32(output, capacity, &mut code, 0) { return false; }
                    if !append_object_adjust_rsp(output, capacity, &mut code, outgoing_bytes, false) {
                        return false;
                    }
                    if instruction.result_value != 0
                        && !append_object_slot_store_typed(
                            output, capacity, &mut code, instruction.result_value - slot_base, callee.return_type
                        ) {
                        return false;
                    }
                } else if instruction.opcode == TargetOpcode::Branch {
                    if instruction.target_count != 1 || branch_count >= 4096 { return false; }
                    let destination_id: u32 = unsafe { *(targets + instruction.first_target) };
                    let destination: u32 = object_block_offset(blocks, function.first_block, function.block_count, destination_id);
                    if destination >= function.block_count
                        || !append_object_phi_copies(output, capacity, &mut code,
                            unsafe { *(blocks + function.first_block + destination) }, block.id,
                            instructions, phi_inputs, values, ir.value_count, scratch_base, slot_base)
                        || !append_object_byte(output, capacity, &mut code, 233) {
                        return false;
                    }
                    branch_offsets[branch_count as usize] = code;
                    branch_blocks[branch_count as usize] = destination;
                    branch_count = branch_count + 1;
                    if !append_object_u32(output, capacity, &mut code, 0) { return false; }
                } else if instruction.opcode == TargetOpcode::CondBranch {
                    if instruction.target_count != 2 || instruction.operand_count != 1 || branch_count > 2046 { return false; }
                    let condition: TargetOperand = unsafe { *(operands + instruction.first_operand) };
                    let yes: u32 = object_block_offset(blocks, function.first_block, function.block_count,
                        unsafe { *(targets + instruction.first_target) });
                    let no: u32 = object_block_offset(blocks, function.first_block, function.block_count,
                        unsafe { *(targets + instruction.first_target + 1) });
                    if yes >= function.block_count || no >= function.block_count
                        || object_value_type(values, ir.value_count, condition.value_id) != TargetTypeTag::Bool
                        || !append_object_slot_load(output, capacity, &mut code, condition.value_id - slot_base)
                        || !append_object_byte(output, capacity, &mut code, 133)
                        || !append_object_byte(output, capacity, &mut code, 192)
                        || !append_object_byte(output, capacity, &mut code, 15)
                        || !append_object_byte(output, capacity, &mut code, 132) {
                        return false;
                    }
                    let skip_offset: usize = code;
                    if !append_object_u32(output, capacity, &mut code, 0)
                        || !append_object_phi_copies(output, capacity, &mut code,
                            unsafe { *(blocks + function.first_block + yes) }, block.id,
                            instructions, phi_inputs, values, ir.value_count, scratch_base, slot_base)
                        || !append_object_byte(output, capacity, &mut code, 233) {
                        return false;
                    }
                    branch_offsets[branch_count as usize] = code;
                    branch_blocks[branch_count as usize] = yes;
                    branch_count = branch_count + 1;
                    if !append_object_u32(output, capacity, &mut code, 0)
                        || !put_u32(output, capacity, skip_offset, (code as u32) - (skip_offset as u32 + 4))
                        || !append_object_phi_copies(output, capacity, &mut code,
                            unsafe { *(blocks + function.first_block + no) }, block.id,
                            instructions, phi_inputs, values, ir.value_count, scratch_base, slot_base)
                        || !append_object_byte(output, capacity, &mut code, 233) {
                        return false;
                    }
                    branch_offsets[branch_count as usize] = code;
                    branch_blocks[branch_count as usize] = no;
                    branch_count = branch_count + 1;
                    if !append_object_u32(output, capacity, &mut code, 0) { return false; }
                } else if instruction.opcode == TargetOpcode::Return {
                    if function.return_type == TargetTypeTag::Void {
                        if instruction.operand_count != 0
                            || !append_object_byte(output, capacity, &mut code, 49)
                            || !append_object_byte(output, capacity, &mut code, 192) {
                            return false;
                        }
                    } else {
                        if instruction.operand_count != 1 { return false; }
                        let returned: TargetOperand = unsafe { *(operands + instruction.first_operand) };
                        if object_value_type(values, ir.value_count, returned.value_id) != function.return_type {
                            return false;
                        }
                        let is_64: bool = object_type_is_64(function.return_type);
                        if is_64 {
                            if !append_object_slot_load_rax64(output, capacity, &mut code, returned.value_id - slot_base) {
                                return false;
                            }
                        } else {
                            if !append_object_slot_load(output, capacity, &mut code, returned.value_id - slot_base) {
                                return false;
                            }
                        }
                    }
                    if !append_object_byte(output, capacity, &mut code, 201)
                        || !append_object_byte(output, capacity, &mut code, 195) {
                        return false;
                    }
                } else if target_opcode_is_semantic_only(instruction.opcode) {
                    if instruction.result_value != 0 { return false; }
                } else {
                    return false;
                }
                local = local + 1;
            }
            block_offset = block_offset + 1;
        }
        let mut patch_index: u32 = 0;
        while patch_index < branch_count {
            let patch_offset: usize = branch_offsets[patch_index as usize];
            if !put_u32(output, capacity, patch_offset,
                (block_offsets[branch_blocks[patch_index as usize] as usize] as u32) - (patch_offset as u32 + 4)) {
                return false;
            }
            patch_index = patch_index + 1;
        }
        function_sizes[function_index as usize] = code - text_offset - function_offsets[function_index as usize];
        function_index = function_index + 1;
    }

    let text_size: usize = code - text_offset;
    let mut relocation_offsets: [usize; 512] = 0;
    let mut relocation_symbols: [u32; 512] = 0;
    let mut relocation_count: u32 = 0;
    let mut call_index: u32 = 0;
    while call_index < call_patch_count {
        let patch_offset: usize = call_patch_offsets[call_index as usize];
        let callee_index: u32 = call_patch_functions[call_index as usize];
        if (unsafe { (*(functions + callee_index)).flags } & TARGET_FUNCTION_EXTERNAL) != 0 {
            relocation_offsets[relocation_count as usize] = patch_offset - text_offset;
            relocation_symbols[relocation_count as usize] = symbol_of_function[callee_index as usize];
            relocation_count = relocation_count + 1;
        } else if !put_u32(output, capacity, patch_offset,
            (text_offset + function_offsets[callee_index as usize]) as u32 - (patch_offset as u32 + 4)) {
            return false;
        }
        call_index = call_index + 1;
    }

    let rodata_len: usize = sotlas_native_get_rodata_len();
    let bss_size: usize = sotlas_native_get_bss_size();
    let rodata_sym_cnt: usize = sotlas_native_get_rodata_sym_count();
    let bss_sym_cnt: usize = sotlas_native_get_bss_sym_count();

    if rodata_len > 0 || bss_size > 0 {
        let rodata_offset: usize = align_to(code, 16);
        if rodata_len > 0 {
            let rodata_src: *const u8 = sotlas_native_get_rodata_buffer();
            let mut r_i: usize = 0;
            while r_i < rodata_len {
                unsafe { *(output + rodata_offset + r_i) = *(rodata_src + r_i); }
                r_i = r_i + 1;
            }
        }
        code = rodata_offset + rodata_len;
        let bss_offset: usize = code;

        let call_relocation_count: u32 = relocation_count;
        let mut data_p: u32 = 0;
        while data_p < data_patch_count {
            let p_off: usize = data_patch_offsets[data_p as usize];
            let p_sym_off: usize = data_patch_sym_offsets[data_p as usize];
            let p_sym_len: usize = data_patch_sym_lens[data_p as usize];
            let mut sym_num: u32 = 0;
            let mut r_idx: usize = 0;
            while r_idx < rodata_sym_cnt {
                let o: usize = sotlas_native_get_rodata_sym_offset(r_idx);
                let l: usize = sotlas_native_get_rodata_sym_len(r_idx);
                if slice_names_equal(source, p_sym_off, p_sym_len, o, l) {
                    sym_num = defined_count + 1 + r_idx as u32;
                    break;
                }
                r_idx = r_idx + 1;
            }
            if sym_num == 0 {
                let mut b_idx: usize = 0;
                while b_idx < bss_sym_cnt {
                    let o: usize = sotlas_native_get_bss_sym_offset(b_idx);
                    let l: usize = sotlas_native_get_bss_sym_len(b_idx);
                    if slice_names_equal(source, p_sym_off, p_sym_len, o, l) {
                        sym_num = defined_count + rodata_sym_cnt as u32 + 1 + b_idx as u32;
                        break;
                    }
                    b_idx = b_idx + 1;
                }
            }
            if sym_num != 0 && relocation_count < 512 {
                relocation_offsets[relocation_count as usize] = p_off - text_offset;
                relocation_symbols[relocation_count as usize] = sym_num;
                relocation_count = relocation_count + 1;
            }
            data_p = data_p + 1;
        }

        let mut r_scan: usize = 0;
        while r_scan < rodata_sym_cnt {
            let l: usize = sotlas_native_get_rodata_sym_len(r_scan);
            strings_size = strings_size + l + 1;
            r_scan = r_scan + 1;
        }
        let mut b_scan: usize = 0;
        while b_scan < bss_sym_cnt {
            let l: usize = sotlas_native_get_bss_sym_len(b_scan);
            strings_size = strings_size + l + 1;
            b_scan = b_scan + 1;
        }

        let data_sym_total: usize = rodata_sym_cnt + bss_sym_cnt;
        let symbol_count: usize = (defined_count + external_count + data_sym_total as u32) as usize + 1;
        let rela_offset: usize = align_to(code, 8);
        let rela_size: usize = relocation_count as usize * 24;
        let symtab_offset: usize = rela_offset + rela_size;
        let symtab_size: usize = symbol_count * 24;
        let strtab_offset: usize = symtab_offset + symtab_size;
        let shstrtab_offset: usize = strtab_offset + strings_size;
        let shstrtab_size: usize = 74;
        let note_offset: usize = align_to(shstrtab_offset + shstrtab_size, 4);
        let note_size: usize = 20 + defined_count as usize * 4;
        let section_header_offset: usize = align_to(note_offset + note_size, 8);
        let file_size: usize = section_header_offset + 9 * 64;
        if file_size > capacity { return false; }
        clear_index = code;
        while clear_index < file_size {
            unsafe { *(output + clear_index) = 0; }
            clear_index = clear_index + 1;
        }
        if !put_u8(output, capacity, 0, 127) || !put_u8(output, capacity, 1, 69)
            || !put_u8(output, capacity, 2, 76) || !put_u8(output, capacity, 3, 70)
            || !put_u8(output, capacity, 4, 2) || !put_u8(output, capacity, 5, 1)
            || !put_u8(output, capacity, 6, 1) || !put_u16(output, capacity, 16, 1)
            || !put_u16(output, capacity, 18, 62) || !put_u32(output, capacity, 20, 1)
            || !put_u64(output, capacity, 40, section_header_offset as u64)
            || !put_u32(output, capacity, 48, platform_flags)
            || !put_u16(output, capacity, 52, 64) || !put_u16(output, capacity, 58, 64)
            || !put_u16(output, capacity, 60, 9) || !put_u16(output, capacity, 62, 6)
            || !put_section_header(output, capacity, section_header_offset + 64,
                1, 1, 6, text_offset as u64, text_size as u64, 0, 0, 16, 0)
            || !put_section_header(output, capacity, section_header_offset + 128,
                7, 1, 2, rodata_offset as u64, rodata_len as u64, 0, 0, 16, 0)
            || !put_section_header(output, capacity, section_header_offset + 192,
                15, 8, 3, bss_offset as u64, bss_size as u64, 0, 0, 16, 0)
            || !put_section_header(output, capacity, section_header_offset + 256,
                20, 2, 0, symtab_offset as u64, symtab_size as u64, 5, defined_count + 1 + rodata_sym_cnt as u32, 8, 24)
            || !put_section_header(output, capacity, section_header_offset + 320,
                28, 3, 0, strtab_offset as u64, strings_size as u64, 0, 0, 1, 0)
            || !put_section_header(output, capacity, section_header_offset + 384,
                36, 3, 0, shstrtab_offset as u64, shstrtab_size as u64, 0, 0, 1, 0)
            || !put_section_header(output, capacity, section_header_offset + 448,
                46, 7, 0, note_offset as u64, note_size as u64, 0, 0, 4, 0)
            || !put_section_header(output, capacity, section_header_offset + 512,
                63, 4, 64, rela_offset as u64, rela_size as u64, 4, 1, 8, 24)
            || !put_u32(output, capacity, note_offset, 7)
            || !put_u32(output, capacity, note_offset + 4, defined_count * 4)
            || !put_u32(output, capacity, note_offset + 8, 2)
            || !put_u8(output, capacity, note_offset + 12, 83)
            || !put_u8(output, capacity, note_offset + 13, 79)
            || !put_u8(output, capacity, note_offset + 14, 84)
            || !put_u8(output, capacity, note_offset + 15, 76)
            || !put_u8(output, capacity, note_offset + 16, 65)
            || !put_u8(output, capacity, note_offset + 17, 83) {
            return false;
        }

        let section_names_data: *const u8 = ".text\x00.rodata\x00.bss\x00.symtab\x00.strtab\x00.shstrtab\x00.note.sotlas.abi\x00.rela.text\x00";
        let mut copy_index: usize = 0;
        while copy_index < 73 {
            unsafe { *(output + shstrtab_offset + 1 + copy_index) = *(section_names_data + copy_index); }
            copy_index = copy_index + 1;
        }

        let mut string_cursor: usize = 1;
        function_index = 0;
        while function_index < ir.function_count {
            let function: TargetFunction = unsafe { *(functions + function_index) };
            let symbol_index: u32 = symbol_of_function[function_index as usize];
            let external: bool = (function.flags & TARGET_FUNCTION_EXTERNAL) != 0;
            let mut actual_sym_index: u32 = symbol_index;
            let mut symbol_info: u8 = 18 as u8;
            let mut symbol_section: u16 = 1 as u16;
            let mut symbol_value: u64 = function_offsets[function_index as usize] as u64;
            let mut symbol_size: u64 = function_sizes[function_index as usize] as u64;
            if external {
                actual_sym_index = symbol_index + data_sym_total as u32;
                symbol_info = 16 as u8;
                symbol_section = 0 as u16;
                symbol_value = 0;
                symbol_size = 0;
                let windows_id: u32 = windows_import_id(unsafe { source + function.name.offset }, function.name.length as usize);
                if windows_id != 0 { symbol_size = (windows_id as u64) + 1459617792; }
            }
            let symbol_offset: usize = symtab_offset + actual_sym_index as usize * 24;
            if !put_u32(output, capacity, symbol_offset, string_cursor as u32)
                || !put_u8(output, capacity, symbol_offset + 4, symbol_info)
                || !put_u16(output, capacity, symbol_offset + 6, symbol_section)
                || !put_u64(output, capacity, symbol_offset + 8, symbol_value)
                || !put_u64(output, capacity, symbol_offset + 16, symbol_size) {
                return false;
            }
            copy_index = 0;
            while copy_index < function.name.length {
                unsafe { *(output + strtab_offset + string_cursor + copy_index) = *(source + function.name.offset + copy_index); }
                copy_index = copy_index + 1;
            }
            string_cursor = string_cursor + function.name.length + 1;
            if !external {
                let mut linux_entry_flag: u32 = 0;
                if linux_process_entry_name(unsafe { source + function.name.offset }, function.name.length as usize) { linux_entry_flag = 128; }
                let mut bool_mask: u32 = 0;
                let mut parameter_index: u32 = 0;
                while parameter_index < function.parameter_count {
                    if unsafe { (*(parameters + function.first_parameter + parameter_index)).type_tag } == TargetTypeTag::Bool {
                        bool_mask = bool_mask | ((1 as u32) << parameter_index);
                    }
                    parameter_index = parameter_index + 1;
                }
                if !put_u32(output, capacity, note_offset + 20 + (actual_sym_index as usize - 1) * 4,
                    function.parameter_count | (bool_mask << 8) | linux_entry_flag) {
                    return false;
                }
            }
            function_index = function_index + 1;
        }

        let mut r_sym_i: usize = 0;
        while r_sym_i < rodata_sym_cnt {
            let o: usize = sotlas_native_get_rodata_sym_offset(r_sym_i);
            let l: usize = sotlas_native_get_rodata_sym_len(r_sym_i);
            let p: usize = sotlas_native_get_rodata_sym_place(r_sym_i);
            let s: usize = sotlas_native_get_rodata_sym_size(r_sym_i);
            let sym_idx: u32 = defined_count + 1 + r_sym_i as u32;
            let symbol_offset: usize = symtab_offset + sym_idx as usize * 24;
            if !put_u32(output, capacity, symbol_offset, string_cursor as u32)
                || !put_u8(output, capacity, symbol_offset + 4, 0 as u8)
                || !put_u16(output, capacity, symbol_offset + 6, 2 as u16)
                || !put_u64(output, capacity, symbol_offset + 8, p as u64)
                || !put_u64(output, capacity, symbol_offset + 16, s as u64) {
                return false;
            }
            copy_index = 0;
            while copy_index < l {
                unsafe { *(output + strtab_offset + string_cursor + copy_index) = *(source + o + copy_index); }
                copy_index = copy_index + 1;
            }
            string_cursor = string_cursor + l + 1;
            r_sym_i = r_sym_i + 1;
        }

        let mut b_sym_i: usize = 0;
        while b_sym_i < bss_sym_cnt {
            let o: usize = sotlas_native_get_bss_sym_offset(b_sym_i);
            let l: usize = sotlas_native_get_bss_sym_len(b_sym_i);
            let p: usize = sotlas_native_get_bss_sym_place(b_sym_i);
            let s: usize = sotlas_native_get_bss_sym_size(b_sym_i);
            let sym_idx: u32 = defined_count + rodata_sym_cnt as u32 + 1 + b_sym_i as u32;
            let symbol_offset: usize = symtab_offset + sym_idx as usize * 24;
            if !put_u32(output, capacity, symbol_offset, string_cursor as u32)
                || !put_u8(output, capacity, symbol_offset + 4, 17 as u8)
                || !put_u16(output, capacity, symbol_offset + 6, 3 as u16)
                || !put_u64(output, capacity, symbol_offset + 8, p as u64)
                || !put_u64(output, capacity, symbol_offset + 16, s as u64) {
                return false;
            }
            copy_index = 0;
            while copy_index < l {
                unsafe { *(output + strtab_offset + string_cursor + copy_index) = *(source + o + copy_index); }
                copy_index = copy_index + 1;
            }
            string_cursor = string_cursor + l + 1;
            b_sym_i = b_sym_i + 1;
        }

        let mut relocation_index: u32 = 0;
        while relocation_index < relocation_count {
            let entry: usize = rela_offset + relocation_index as usize * 24;
            let orig_sym: u32 = relocation_symbols[relocation_index as usize];
            let mut final_sym: u32 = orig_sym;
            if relocation_index < call_relocation_count
                && orig_sym > defined_count && orig_sym <= defined_count + external_count {
                final_sym = orig_sym + data_sym_total as u32;
            }
            if !put_u64(output, capacity, entry, relocation_offsets[relocation_index as usize] as u64)
                || !put_u32(output, capacity, entry + 8, 4)
                || !put_u32(output, capacity, entry + 12, final_sym)
                || !put_u32(output, capacity, entry + 16, 4294967292)
                || !put_u32(output, capacity, entry + 20, 4294967295) {
                return false;
            }
            relocation_index = relocation_index + 1;
        }
        unsafe { *output_length = file_size; }
        return true;
    }

    let symbol_count: usize = (defined_count + external_count) as usize + 1;
    let rela_offset: usize = align_to(code, 8);
    let rela_size: usize = relocation_count as usize * 24;
    let symtab_offset: usize = rela_offset + rela_size;
    let symtab_size: usize = symbol_count * 24;
    let strtab_offset: usize = symtab_offset + symtab_size;
    let shstrtab_offset: usize = strtab_offset + strings_size;
    let shstrtab_size: usize = 61;
    let note_offset: usize = align_to(shstrtab_offset + shstrtab_size, 4);
    let note_size: usize = 20 + defined_count as usize * 4;
    let section_header_offset: usize = align_to(note_offset + note_size, 8);
    let file_size: usize = section_header_offset + 7 * 64;
    if file_size > capacity { return false; }
    clear_index = code;
    while clear_index < file_size {
        unsafe { *(output + clear_index) = 0; }
        clear_index = clear_index + 1;
    }
    if !put_u8(output, capacity, 0, 127) || !put_u8(output, capacity, 1, 69)
        || !put_u8(output, capacity, 2, 76) || !put_u8(output, capacity, 3, 70)
        || !put_u8(output, capacity, 4, 2) || !put_u8(output, capacity, 5, 1)
        || !put_u8(output, capacity, 6, 1) || !put_u16(output, capacity, 16, 1)
        || !put_u16(output, capacity, 18, 62) || !put_u32(output, capacity, 20, 1)
        || !put_u64(output, capacity, 40, section_header_offset as u64)
        || !put_u32(output, capacity, 48, platform_flags)
        || !put_u16(output, capacity, 52, 64) || !put_u16(output, capacity, 58, 64)
        || !put_u16(output, capacity, 60, 7) || !put_u16(output, capacity, 62, 4)
        || !put_section_header(output, capacity, section_header_offset + 64,
            1, 1, 6, text_offset as u64, text_size as u64, 0, 0, 16, 0)
        || !put_section_header(output, capacity, section_header_offset + 128,
            7, 2, 0, symtab_offset as u64, symtab_size as u64, 3, 1, 8, 24)
        || !put_section_header(output, capacity, section_header_offset + 192,
            15, 3, 0, strtab_offset as u64, strings_size as u64, 0, 0, 1, 0)
        || !put_section_header(output, capacity, section_header_offset + 256,
            23, 3, 0, shstrtab_offset as u64, shstrtab_size as u64, 0, 0, 1, 0)
        || !put_section_header(output, capacity, section_header_offset + 320,
            33, 7, 0, note_offset as u64, note_size as u64, 0, 0, 4, 0)
        || !put_section_header(output, capacity, section_header_offset + 384,
            50, 4, 64, rela_offset as u64, rela_size as u64, 2, 1, 8, 24)
        || !put_u32(output, capacity, note_offset, 7)
        || !put_u32(output, capacity, note_offset + 4, defined_count * 4)
        || !put_u32(output, capacity, note_offset + 8, 2)
        || !put_u8(output, capacity, note_offset + 12, 83)
        || !put_u8(output, capacity, note_offset + 13, 79)
        || !put_u8(output, capacity, note_offset + 14, 84)
        || !put_u8(output, capacity, note_offset + 15, 76)
        || !put_u8(output, capacity, note_offset + 16, 65)
        || !put_u8(output, capacity, note_offset + 17, 83) {
        return false;
    }
    let section_names: *const u8 = ".text\x00.symtab\x00.strtab\x00.shstrtab\x00.note.sotlas.abi\x00.rela.text\x00";
    let mut copy_index: usize = 0;
    while copy_index < 60 {
        unsafe { *(output + shstrtab_offset + 1 + copy_index) = *(section_names + copy_index); }
        copy_index = copy_index + 1;
    }
    let mut string_cursor: usize = 1;
    function_index = 0;
    while function_index < ir.function_count {
        let function: TargetFunction = unsafe { *(functions + function_index) };
        let symbol_index: u32 = symbol_of_function[function_index as usize];
        let symbol_offset: usize = symtab_offset + symbol_index as usize * 24;
        let external: bool = (function.flags & TARGET_FUNCTION_EXTERNAL) != 0;
        let mut symbol_info: u8 = 18 as u8;
        let mut symbol_section: u16 = 1 as u16;
        let mut symbol_value: u64 = function_offsets[function_index as usize] as u64;
        let mut symbol_size: u64 = function_sizes[function_index as usize] as u64;
        if external {
            symbol_info = 16 as u8;
            symbol_section = 0 as u16;
            symbol_value = 0;
            symbol_size = 0;
            let windows_id: u32 = windows_import_id(unsafe { source + function.name.offset }, function.name.length as usize);
            if windows_id != 0 { symbol_size = (windows_id as u64) + 1459617792; }
        }
        if !put_u32(output, capacity, symbol_offset, string_cursor as u32)
            || !put_u8(output, capacity, symbol_offset + 4, symbol_info)
            || !put_u16(output, capacity, symbol_offset + 6, symbol_section)
            || !put_u64(output, capacity, symbol_offset + 8, symbol_value)
            || !put_u64(output, capacity, symbol_offset + 16, symbol_size) {
            return false;
        }
        copy_index = 0;
        while copy_index < function.name.length {
            unsafe { *(output + strtab_offset + string_cursor + copy_index) = *(source + function.name.offset + copy_index); }
            copy_index = copy_index + 1;
        }
        string_cursor = string_cursor + function.name.length + 1;
        if !external {
            let mut linux_entry_flag: u32 = 0;
            if linux_process_entry_name(unsafe { source + function.name.offset }, function.name.length as usize) { linux_entry_flag = 128; }
            let mut bool_mask: u32 = 0;
            let mut parameter_index: u32 = 0;
            while parameter_index < function.parameter_count {
                if unsafe { (*(parameters + function.first_parameter + parameter_index)).type_tag } == TargetTypeTag::Bool {
                    bool_mask = bool_mask | ((1 as u32) << parameter_index);
                }
                parameter_index = parameter_index + 1;
            }
            if !put_u32(output, capacity, note_offset + 20 + (symbol_index as usize - 1) * 4,
                function.parameter_count | (bool_mask << 8) | linux_entry_flag) {
                return false;
            }
        }
        function_index = function_index + 1;
    }
    let mut relocation_index: u32 = 0;
    while relocation_index < relocation_count {
        let entry: usize = rela_offset + relocation_index as usize * 24;
        if !put_u64(output, capacity, entry, relocation_offsets[relocation_index as usize] as u64)
            || !put_u32(output, capacity, entry + 8, 4)
            || !put_u32(output, capacity, entry + 12, relocation_symbols[relocation_index as usize])
            || !put_u32(output, capacity, entry + 16, 4294967292)
            || !put_u32(output, capacity, entry + 20, 4294967295) {
            return false;
        }
        relocation_index = relocation_index + 1;
    }
    unsafe { *output_length = file_size; }
    return true;
}

fn elf_names_equal(
    left: *const u8,
    left_length: usize,
    left_offset: usize,
    right: *const u8,
    right_length: usize,
    right_offset: usize
) -> bool {
    let mut index: usize = 0;
    while left_offset + index < left_length && right_offset + index < right_length {
        let a: u8 = unsafe { *(left + left_offset + index) };
        let b: u8 = unsafe { *(right + right_offset + index) };
        if a != b { return false; }
        if a == 0 { return true; }
        index = index + 1;
    }
    return false;
}

fn elf_name_matches_slice(
    object: *const u8,
    object_length: usize,
    name_offset: usize,
    name: *const u8,
    name_length: usize
) -> bool {
    if name_offset > object_length || name_length >= object_length - name_offset { return false; }
    let mut index: usize = 0;
    while index < name_length {
        if unsafe { *(object + name_offset + index) } != unsafe { *(name + index) } { return false; }
        index = index + 1;
    }
    return unsafe { *(object + name_offset + name_length) } == 0;
}

// Static ELF64 x86-64 linker for multiple relocatable objects. Objects are
// supplied as one byte buffer plus per-object offsets and lengths. Supported
// inputs: allocatable PROGBITS/NOBITS sections (.text, .rodata, .data, .bss),
// SYMTAB/STRTAB, NOTE and RELA sections with R_X86_64_64, PC32, PLT32, 32 and
// 32S relocations. Global/weak symbols are resolved across objects; duplicate
// strong definitions, undefined references, COMMON symbols, TLS and unknown
// section kinds fail closed. With freestanding=false the image receives a
// Linux `_start` shim that passes up to six u32 arguments and exits with the
// u32 result; with freestanding=true the entry symbol is the ELF entry point.
// The whole image is one RWX PT_LOAD segment at the page-aligned base address.
@export
@system
pub fn link_elf64_executable(
    object_data: *const u8,
    object_offsets: *const usize,
    object_lengths: *const usize,
    object_count: u32,
    entry_name: *const u8,
    entry_name_length: usize,
    entry_arguments: *const u32,
    entry_argument_count: u32,
    base_address: u64,
    freestanding: bool,
    output: *mut u8,
    capacity: usize,
    output_length: *mut usize
) -> bool {
    if output_length == null { return false; }
    unsafe { *output_length = 0; }
    if object_data == null || object_offsets == null || object_lengths == null || output == null
        || entry_name == null || entry_name_length == 0
        || object_count == 0 || object_count > 16
        || base_address == 0 || base_address % 4096 != 0 || base_address > 2147483648
        || entry_argument_count > 6
        || (entry_argument_count != 0 && entry_arguments == null)
        || (freestanding && entry_argument_count != 0) {
        return false;
    }
    let process_entry: bool = linux_process_entry_name(entry_name, entry_name_length);
    if process_entry && (freestanding || entry_argument_count != 0) { return false; }
    let mut symtab_of_object: [u32; 16] = 0;
    let mut section_place: [usize; 512] = 0;
    let mut section_kind: [u8; 512] = 0;
    let mut object_index: u32 = 0;
    while object_index < object_count {
        let object: *const u8 = unsafe { object_data + *(object_offsets + object_index) };
        let length: usize = unsafe { *(object_lengths + object_index) };
        if length < 64
            || unsafe { *object } != 127 || unsafe { *(object + 1) } != 69
            || unsafe { *(object + 2) } != 76 || unsafe { *(object + 3) } != 70
            || unsafe { *(object + 4) } != 2 || unsafe { *(object + 5) } != 1
            || get_u16(object, length, 16) != 1 || get_u16(object, length, 18) != 62
            || get_u32(object, length, 20) != 1 || get_u16(object, length, 58) != 64
            || (!freestanding && get_u32(object, length, 48) != (get_u32(object, length, 48) & 1)) {
            return false;
        }
        let section_count: u32 = get_u16(object, length, 60) as u32;
        let headers: usize = get_u64(object, length, 40) as usize;
        if section_count == 0 || section_count > 32 || headers > length
            || section_count as usize * 64 > length - headers {
            return false;
        }
        let mut symtab_index: u32 = 0;
        let mut section_index: u32 = 1;
        while section_index < section_count {
            let header: usize = headers + section_index as usize * 64;
            let section_type: u32 = get_u32(object, length, header + 4);
            let flags: u64 = get_u64(object, length, header + 8);
            let offset: usize = get_u64(object, length, header + 24) as usize;
            let size: usize = get_u64(object, length, header + 32) as usize;
            let alignment: u64 = get_u64(object, length, header + 48);
            if (flags >> 7) != 0 || (flags & 8) != 0
                || alignment > 4096 || (alignment != 0 && (alignment & (alignment - 1)) != 0) {
                return false;
            }
            if section_type != 8 && (offset > length || size > length - offset) { return false; }
            if section_type == 2 {
                if symtab_index != 0 || get_u64(object, length, header + 56) != 24 || size % 24 != 0
                    || get_u32(object, length, header + 40) >= section_count
                    || get_u32(object, length, headers + get_u32(object, length, header + 40) as usize * 64 + 4) != 3 {
                    return false;
                }
                symtab_index = section_index;
            } else if section_type == 4 {
                if get_u64(object, length, header + 56) != 24 || size % 24 != 0 { return false; }
            } else if section_type == 1 || section_type == 8 {
                if (flags & 2) != 0 {
                    let mut stored_kind: u8 = 1;
                    if section_type == 8 { stored_kind = 2; }
                    section_kind[(object_index * 32 + section_index) as usize] = stored_kind;
                }
            } else if section_type != 3 && section_type != 7 {
                return false;
            }
            section_index = section_index + 1;
        }
        if symtab_index == 0 { return false; }
        symtab_of_object[object_index as usize] = symtab_index;
        object_index = object_index + 1;
    }

    let code_offset: usize = 120;
    let mut shim_size: usize = 0;
    if !freestanding {
        shim_size = 16;
        if process_entry { shim_size = 32; }
        let mut argument_index: u32 = 0;
        while argument_index < entry_argument_count {
            if argument_index >= 4 {
                shim_size = shim_size + 6;
            } else {
                shim_size = shim_size + 5;
            }
            argument_index = argument_index + 1;
        }
    }
    let mut cursor: usize = code_offset + shim_size;
    let mut pass: u32 = 0;
    while pass < 4 {
        object_index = 0;
        while object_index < object_count {
            let object: *const u8 = unsafe { object_data + *(object_offsets + object_index) };
            let length: usize = unsafe { *(object_lengths + object_index) };
            let headers: usize = get_u64(object, length, 40) as usize;
            let section_count: u32 = get_u16(object, length, 60) as u32;
            let mut section_index: u32 = 1;
            while section_index < section_count {
                let slot: usize = (object_index * 32 + section_index) as usize;
                let header: usize = headers + section_index as usize * 64;
                let flags: u64 = get_u64(object, length, header + 8);
                let kind: u8 = section_kind[slot];
                let mut placement_class: u32 = 2;
                if kind == 2 { placement_class = 3; }
                else if (flags & 4) != 0 { placement_class = 0; }
                else if (flags & 1) == 0 { placement_class = 1; }
                if kind != 0 && placement_class == pass {
                    let alignment: u64 = get_u64(object, length, header + 48);
                    let size: usize = get_u64(object, length, header + 32) as usize;
                    let mut effective_alignment: usize = alignment as usize;
                    if alignment == 0 { effective_alignment = 1; }
                    cursor = align_to(cursor, effective_alignment);
                    if size > 268435456 || cursor > 268435456 { return false; }
                    section_place[slot] = cursor;
                    cursor = cursor + size;
                }
                section_index = section_index + 1;
            }
            object_index = object_index + 1;
        }
        if pass == 2 { if cursor > capacity { return false; } }
        pass = pass + 1;
    }
    let memory_size: usize = cursor;
    let mut file_size: usize = code_offset + shim_size;
    let mut index: usize = 0;
    while index < capacity && index < memory_size {
        unsafe { *(output + index) = 0; }
        index = index + 1;
    }
    object_index = 0;
    while object_index < object_count {
        let object: *const u8 = unsafe { object_data + *(object_offsets + object_index) };
        let length: usize = unsafe { *(object_lengths + object_index) };
        let headers: usize = get_u64(object, length, 40) as usize;
        let section_count: u32 = get_u16(object, length, 60) as u32;
        let mut section_index: u32 = 1;
        while section_index < section_count {
            let slot: usize = (object_index * 32 + section_index) as usize;
            if section_kind[slot] == 1 {
                let header: usize = headers + section_index as usize * 64;
                let offset: usize = get_u64(object, length, header + 24) as usize;
                let size: usize = get_u64(object, length, header + 32) as usize;
                if section_place[slot] + size > capacity { return false; }
                index = 0;
                while index < size {
                    unsafe { *(output + section_place[slot] + index) = *(object + offset + index); }
                    index = index + 1;
                }
                if section_place[slot] + size > file_size { file_size = section_place[slot] + size; }
            }
            section_index = section_index + 1;
        }
        object_index = object_index + 1;
    }

    let mut global_object: [u32; 1024] = 0;
    let mut global_name: [usize; 1024] = 0;
    let mut global_symbol: [u32; 1024] = 0;
    let mut global_address: [u64; 1024] = 0;
    let mut global_weak: [u8; 1024] = 0;
    let mut global_count: u32 = 0;
    object_index = 0;
    while object_index < object_count {
        let object: *const u8 = unsafe { object_data + *(object_offsets + object_index) };
        let length: usize = unsafe { *(object_lengths + object_index) };
        let headers: usize = get_u64(object, length, 40) as usize;
        let section_count: u32 = get_u16(object, length, 60) as u32;
        let symtab_header: usize = headers + symtab_of_object[object_index as usize] as usize * 64;
        let symbols: usize = get_u64(object, length, symtab_header + 24) as usize;
        let symbol_count: u32 = (get_u64(object, length, symtab_header + 32) / 24) as u32;
        let strings_header: usize = headers + get_u32(object, length, symtab_header + 40) as usize * 64;
        let strings: usize = get_u64(object, length, strings_header + 24) as usize;
        let strings_size: usize = get_u64(object, length, strings_header + 32) as usize;
        let mut symbol_index: u32 = 1;
        while symbol_index < symbol_count {
            let symbol: usize = symbols + symbol_index as usize * 24;
            let info: u8 = unsafe { *(object + symbol + 4) };
            let bind: u8 = info >> 4;
            let shndx: u32 = get_u16(object, length, symbol + 6) as u32;
            let name: u32 = get_u32(object, length, symbol);
            if (info & 15) == 6 || shndx == 65522 { return false; }
            if (bind == 1 || bind == 2) && shndx != 0 {
                if name == 0 || name as usize >= strings_size || global_count >= 1024 { return false; }
                let mut address: u64 = get_u64(object, length, symbol + 8);
                if shndx != 65521 {
                    if shndx >= section_count || section_kind[(object_index * 32 + shndx) as usize] == 0 { return false; }
                    address = address + base_address + section_place[(object_index * 32 + shndx) as usize] as u64;
                }
                let mut existing: u32 = 0;
                while existing < global_count {
                    let other: *const u8 = unsafe { object_data + *(object_offsets + global_object[existing as usize]) };
                    let other_length: usize = unsafe { *(object_lengths + global_object[existing as usize]) };
                    if elf_names_equal(object, length, strings + name as usize, other, other_length, global_name[existing as usize]) {
                        break;
                    }
                    existing = existing + 1;
                }
                if existing < global_count {
                    if global_weak[existing as usize] == 0 && bind == 1 { return false; }
                    if global_weak[existing as usize] != 0 && bind == 1 {
                        global_object[existing as usize] = object_index;
                        global_name[existing as usize] = strings + name as usize;
                        global_symbol[existing as usize] = symbol_index;
                        global_address[existing as usize] = address;
                        global_weak[existing as usize] = 0;
                    }
                } else {
                    global_object[global_count as usize] = object_index;
                    global_name[global_count as usize] = strings + name as usize;
                    global_symbol[global_count as usize] = symbol_index;
                    global_address[global_count as usize] = address;
                    let mut weak_flag: u8 = 0;
                    if bind == 2 { weak_flag = 1; }
                    global_weak[global_count as usize] = weak_flag;
                    global_count = global_count + 1;
                }
            }
            symbol_index = symbol_index + 1;
        }
        object_index = object_index + 1;
    }

    object_index = 0;
    while object_index < object_count {
        let object: *const u8 = unsafe { object_data + *(object_offsets + object_index) };
        let length: usize = unsafe { *(object_lengths + object_index) };
        let headers: usize = get_u64(object, length, 40) as usize;
        let section_count: u32 = get_u16(object, length, 60) as u32;
        let symtab_index: u32 = symtab_of_object[object_index as usize];
        let symtab_header: usize = headers + symtab_index as usize * 64;
        let symbols: usize = get_u64(object, length, symtab_header + 24) as usize;
        let symbol_count: u32 = (get_u64(object, length, symtab_header + 32) / 24) as u32;
        let strings_header: usize = headers + get_u32(object, length, symtab_header + 40) as usize * 64;
        let strings: usize = get_u64(object, length, strings_header + 24) as usize;
        let mut section_index: u32 = 1;
        while section_index < section_count {
            let header: usize = headers + section_index as usize * 64;
            if get_u32(object, length, header + 4) == 4 {
                let target_section: u32 = get_u32(object, length, header + 44);
                if target_section == 0 || target_section >= section_count { return false; }
                let target_slot: usize = (object_index * 32 + target_section) as usize;
                let target_header: usize = headers + target_section as usize * 64;
                if section_kind[target_slot] == 0 && (get_u64(object, length, target_header + 8) & 2) == 0 {
                    section_index = section_index + 1;
                    continue;
                }
                if section_kind[target_slot] != 1 || get_u32(object, length, header + 40) != symtab_index { return false; }
                let target_size: u64 = get_u64(object, length, target_header + 32);
                let entries: usize = get_u64(object, length, header + 24) as usize;
                let entry_count: usize = get_u64(object, length, header + 32) as usize / 24;
                let mut entry_index: usize = 0;
                while entry_index < entry_count {
                    let entry: usize = entries + entry_index * 24;
                    let r_offset: u64 = get_u64(object, length, entry);
                    let r_type: u32 = get_u32(object, length, entry + 8);
                    let r_symbol: u32 = get_u32(object, length, entry + 12);
                    let addend: u64 = get_u64(object, length, entry + 16);
                    let mut width: u64 = 4;
                    if r_type == 1 { width = 8; }
                    if r_symbol >= symbol_count || r_offset > target_size || width > target_size - r_offset { return false; }
                    let symbol: usize = symbols + r_symbol as usize * 24;
                    let shndx: u32 = get_u16(object, length, symbol + 6) as u32;
                    let mut resolved: u64 = 0;
                    if shndx == 0 {
                        let name: usize = strings + get_u32(object, length, symbol) as usize;
                        let mut found: u32 = 0;
                        while found < global_count {
                            let other: *const u8 = unsafe { object_data + *(object_offsets + global_object[found as usize]) };
                            let other_length: usize = unsafe { *(object_lengths + global_object[found as usize]) };
                            if elf_names_equal(object, length, name, other, other_length, global_name[found as usize]) { break; }
                            found = found + 1;
                        }
                        if found >= global_count { return false; }
                        resolved = global_address[found as usize];
                    } else if shndx == 65521 {
                        resolved = get_u64(object, length, symbol + 8);
                    } else {
                        if shndx >= section_count || section_kind[(object_index * 32 + shndx) as usize] == 0 { return false; }
                        resolved = base_address + section_place[(object_index * 32 + shndx) as usize] as u64
                            + get_u64(object, length, symbol + 8);
                    }
                    let patch: usize = section_place[target_slot] + r_offset as usize;
                    let place: u64 = base_address + patch as u64;
                    let value: u64 = resolved + addend;
                    if r_type == 1 {
                        if !put_u64(output, capacity, patch, value) { return false; }
                    } else if r_type == 2 || r_type == 4 {
                        let relative: u64 = value - place;
                        if relative + 2147483648 > 4294967295 || !put_u32(output, capacity, patch, relative as u32) {
                            return false;
                        }
                    } else if r_type == 10 {
                        if value > 4294967295 || !put_u32(output, capacity, patch, value as u32) { return false; }
                    } else if r_type == 11 {
                        if value + 2147483648 > 4294967295 || !put_u32(output, capacity, patch, value as u32) {
                            return false;
                        }
                    } else {
                        return false;
                    }
                    entry_index = entry_index + 1;
                }
            }
            section_index = section_index + 1;
        }
        object_index = object_index + 1;
    }

    let mut entry: u32 = 0;
    while entry < global_count {
        let other: *const u8 = unsafe { object_data + *(object_offsets + global_object[entry as usize]) };
        let other_length: usize = unsafe { *(object_lengths + global_object[entry as usize]) };
        if elf_name_matches_slice(other, other_length, global_name[entry as usize], entry_name, entry_name_length) { break; }
        entry = entry + 1;
    }
    if entry >= global_count { return false; }
    let entry_address: u64 = global_address[entry as usize];
    if !freestanding {
        let owner: u32 = global_object[entry as usize];
        let object: *const u8 = unsafe { object_data + *(object_offsets + owner) };
        let length: usize = unsafe { *(object_lengths + owner) };
        let headers: usize = get_u64(object, length, 40) as usize;
        let section_count: u32 = get_u16(object, length, 60) as u32;
        let symbol_index: u32 = global_symbol[entry as usize];
        let mut have_descriptor: bool = false;
        let mut descriptor: u32 = 0;
        let mut section_index: u32 = 1;
        while section_index < section_count {
            let header: usize = headers + section_index as usize * 64;
            if get_u32(object, length, header + 4) == 7 {
                let note: usize = get_u64(object, length, header + 24) as usize;
                let note_size: usize = get_u64(object, length, header + 32) as usize;
                let descriptor_size: u32 = get_u32(object, length, note + 4);
                let note_type: u32 = get_u32(object, length, note + 8);
                if note_size >= 20 && get_u32(object, length, note) == 7
                    && unsafe { *(object + note + 12) } == 83 && unsafe { *(object + note + 13) } == 79
                    && unsafe { *(object + note + 14) } == 84 && unsafe { *(object + note + 15) } == 76
                    && unsafe { *(object + note + 16) } == 65 && unsafe { *(object + note + 17) } == 83
                    && descriptor_size as usize <= note_size - 20 {
                    if note_type == 1 && descriptor_size == 4 && symbol_index == 1 {
                        descriptor = get_u32(object, length, note + 20);
                        have_descriptor = true;
                    } else if note_type == 2 && symbol_index as usize * 4 <= descriptor_size as usize {
                        descriptor = get_u32(object, length, note + 20 + (symbol_index as usize - 1) * 4);
                        have_descriptor = true;
                    }
                }
            }
            section_index = section_index + 1;
        }
        if process_entry {
            if !have_descriptor || descriptor != 130 { return false; }
        } else if !have_descriptor {
            if entry_argument_count != 0 { return false; }
        } else {
            let declared: u32 = descriptor & 255;
            let bool_mask: u32 = (descriptor >> 8) & 63;
            if declared > 6 || declared != entry_argument_count || (descriptor >> 14) != 0
                || bool_mask >= ((1 as u32) << declared) { return false; }
            let mut check: u32 = 0;
            while check < entry_argument_count {
                if ((bool_mask >> check) & 1) != 0 && unsafe { *(entry_arguments + check) } > 1 { return false; }
                check = check + 1;
            }
        }
        let mut shim_cursor: usize = code_offset;
        if process_entry {
            // Kernel entry rsp is 16-byte aligned: argc is [rsp], argv is rsp+8.
            if !put_u8(output, capacity, shim_cursor, 72) || !put_u8(output, capacity, shim_cursor + 1, 139)
                || !put_u8(output, capacity, shim_cursor + 2, 60) || !put_u8(output, capacity, shim_cursor + 3, 36)
                || !put_u8(output, capacity, shim_cursor + 4, 72) || !put_u8(output, capacity, shim_cursor + 5, 141)
                || !put_u8(output, capacity, shim_cursor + 6, 116) || !put_u8(output, capacity, shim_cursor + 7, 36)
                || !put_u8(output, capacity, shim_cursor + 8, 8) { return false; }
            shim_cursor = shim_cursor + 9;
        }
        let mut argument_index: u32 = 0;
        while argument_index < entry_argument_count {
            let mut register_opcode: u8 = 185 as u8;
            if argument_index == 0 { register_opcode = 191 as u8; }
            else if argument_index == 1 { register_opcode = 190 as u8; }
            else if argument_index == 2 { register_opcode = 186 as u8; }
            else if argument_index == 4 { register_opcode = 184 as u8; }
            if argument_index >= 4 {
                if !put_u8(output, capacity, shim_cursor, 65) { return false; }
                shim_cursor = shim_cursor + 1;
            }
            if !put_u8(output, capacity, shim_cursor, register_opcode)
                || !put_u32(output, capacity, shim_cursor + 1, unsafe { *(entry_arguments + argument_index) }) {
                return false;
            }
            shim_cursor = shim_cursor + 5;
            argument_index = argument_index + 1;
        }
        let call_place: u64 = base_address + shim_cursor as u64 + 5;
        let relative: u64 = entry_address - call_place;
        if relative + 2147483648 > 4294967295
            || !put_u8(output, capacity, shim_cursor, 232)
            || !put_u32(output, capacity, shim_cursor + 1, relative as u32)
            || !put_u8(output, capacity, shim_cursor + 5, 137)
            || !put_u8(output, capacity, shim_cursor + 6, 199)
            || !put_u8(output, capacity, shim_cursor + 7, 184)
            || !put_u32(output, capacity, shim_cursor + 8, 60)
            || !put_u8(output, capacity, shim_cursor + 12, 15)
            || !put_u8(output, capacity, shim_cursor + 13, 5) {
            return false;
        }
        shim_cursor = shim_cursor + 14;
        while shim_cursor < code_offset + shim_size {
            if !put_u8(output, capacity, shim_cursor, 144) { return false; }
            shim_cursor = shim_cursor + 1;
        }
    }
    let mut elf_entry_address: u64 = base_address + code_offset as u64;
    if freestanding { elf_entry_address = entry_address; }
    if !put_u8(output, capacity, 0, 127) || !put_u8(output, capacity, 1, 69)
        || !put_u8(output, capacity, 2, 76) || !put_u8(output, capacity, 3, 70)
        || !put_u8(output, capacity, 4, 2) || !put_u8(output, capacity, 5, 1)
        || !put_u8(output, capacity, 6, 1) || !put_u16(output, capacity, 16, 2)
        || !put_u16(output, capacity, 18, 62) || !put_u32(output, capacity, 20, 1)
        || !put_u64(output, capacity, 24, elf_entry_address)
        || !put_u64(output, capacity, 32, 64)
        || !put_u16(output, capacity, 52, 64) || !put_u16(output, capacity, 54, 56)
        || !put_u16(output, capacity, 56, 1)
        || !put_u32(output, capacity, 64, 1) || !put_u32(output, capacity, 68, 7)
        || !put_u64(output, capacity, 72, 0)
        || !put_u64(output, capacity, 80, base_address)
        || !put_u64(output, capacity, 88, base_address)
        || !put_u64(output, capacity, 96, file_size as u64)
        || !put_u64(output, capacity, 104, memory_size as u64)
        || !put_u64(output, capacity, 112, 4096) {
        return false;
    }
    unsafe { *output_length = file_size; }
    return true;
}

// Native Windows imports use a frozen scalar machine ABI. These names are
// resolved only by the PE backend; all other foreign names remain unresolved.
static mut g_pe_link_objects: [u8; 8388608] = 0;

fn windows_name_equals(name: *const u8, length: usize, expected: *const u8, size: usize) -> bool {
    if name == null || length != size { return false; }
    let mut index: usize = 0;
    while index < size {
        if unsafe { *(name + index) } != unsafe { *(expected + index) } { return false; }
        index = index + 1;
    }
    return true;
}

fn windows_import_id(name: *const u8, length: usize) -> u32 {
    if windows_name_equals(name, length, "sotlas_windows_exit", 19) { return 1; }
    if windows_name_equals(name, length, "sotlas_windows_get_command_line", 31) { return 2; }
    if windows_name_equals(name, length, "sotlas_windows_create_file", 26) { return 3; }
    if windows_name_equals(name, length, "sotlas_windows_read_file", 24) { return 4; }
    if windows_name_equals(name, length, "sotlas_windows_write_file", 25) { return 5; }
    if windows_name_equals(name, length, "sotlas_windows_close_handle", 27) { return 6; }
    if windows_name_equals(name, length, "sotlas_windows_get_std_handle", 29) { return 7; }
    if windows_name_equals(name, length, "sotlas_windows_get_last_error", 29) { return 8; }
    return 0;
}

fn windows_symbol_name(id: u32) -> *const u8 {
    if id == 1 { return "sotlas_windows_exit"; }
    if id == 2 { return "sotlas_windows_get_command_line"; }
    if id == 3 { return "sotlas_windows_create_file"; }
    if id == 4 { return "sotlas_windows_read_file"; }
    if id == 5 { return "sotlas_windows_write_file"; }
    if id == 6 { return "sotlas_windows_close_handle"; }
    if id == 7 { return "sotlas_windows_get_std_handle"; }
    if id == 8 { return "sotlas_windows_get_last_error"; }
    return null;
}

fn windows_symbol_length(id: u32) -> usize {
    if id == 1 { return 19; }
    if id == 2 { return 31; }
    if id == 3 { return 26; }
    if id == 4 { return 24; }
    if id == 5 { return 25; }
    if id == 6 { return 27; }
    if id == 7 { return 29; }
    if id == 8 { return 29; }
    return 0;
}

fn windows_dll_name(id: u32) -> *const u8 {
    if id == 1 { return "ExitProcess"; }
    if id == 2 { return "GetCommandLineA"; }
    if id == 3 { return "CreateFileA"; }
    if id == 4 { return "ReadFile"; }
    if id == 5 { return "WriteFile"; }
    if id == 6 { return "CloseHandle"; }
    if id == 7 { return "GetStdHandle"; }
    if id == 8 { return "GetLastError"; }
    return null;
}

fn windows_dll_name_length(id: u32) -> usize {
    if id == 1 { return 11; }
    if id == 2 { return 15; }
    if id == 3 { return 11; }
    if id == 4 { return 8; }
    if id == 5 { return 9; }
    if id == 6 { return 11; }
    if id == 7 { return 12; }
    if id == 8 { return 12; }
    return 0;
}

fn windows_parameter_count(id: u32) -> u32 {
    if id == 1 { return 1; }
    if id == 2 { return 0; }
    if id == 3 { return 7; }
    if id == 4 { return 5; }
    if id == 5 { return 5; }
    if id == 6 { return 1; }
    if id == 7 { return 1; }
    if id == 8 { return 0; }
    return 0;
}

fn windows_signature_valid(id: u32, function: TargetFunction, parameters: *const TargetParameter) -> bool {
    if id == 0 { return true; }
    if function.parameter_count != windows_parameter_count(id) { return false; }
    let mut result: TargetTypeTag = TargetTypeTag::U32;
    if id == 1 { result = TargetTypeTag::Void; }
    if id == 2 { result = TargetTypeTag::Pointer; }
    if id == 3 { result = TargetTypeTag::U64; }
    if id == 7 { result = TargetTypeTag::U64; }
    if function.return_type != result { return false; }
    let mut index: u32 = 0;
    while index < function.parameter_count {
        let mut wanted: TargetTypeTag = TargetTypeTag::U32;
        if id == 3 && index == 0 { wanted = TargetTypeTag::Pointer; }
        if id == 3 && index == 3 { wanted = TargetTypeTag::Pointer; }
        if id == 3 && index == 6 { wanted = TargetTypeTag::U64; }
        if id == 4 && index == 0 { wanted = TargetTypeTag::U64; }
        if id == 4 && index == 1 { wanted = TargetTypeTag::Pointer; }
        if id == 4 && index == 3 { wanted = TargetTypeTag::Pointer; }
        if id == 4 && index == 4 { wanted = TargetTypeTag::Pointer; }
        if id == 5 && index == 0 { wanted = TargetTypeTag::U64; }
        if id == 5 && index == 1 { wanted = TargetTypeTag::Pointer; }
        if id == 5 && index == 3 { wanted = TargetTypeTag::Pointer; }
        if id == 5 && index == 4 { wanted = TargetTypeTag::Pointer; }
        if id == 6 && index == 0 { wanted = TargetTypeTag::U64; }
        if unsafe { (*(parameters + function.first_parameter + index)).type_tag } != wanted { return false; }
        index = index + 1;
    }
    return true;
}

// Check the entry note only after the ELF linker has validated every table.
// Mach-O startup currently supports a zero-argument scalar entry, never an
// inferred signature or the Linux process-entry descriptor.
fn macho_zero_argument_entry(object: *const u8, length: usize,
    entry_name: *const u8, entry_length: usize) -> bool {
    let headers: usize = get_u64(object, length, 40) as usize;
    let count: usize = get_u16(object, length, 60) as usize;
    let mut entry_symbol: usize = 0;
    let mut section: usize = 1;
    while section < count {
        let header: usize = headers + section * 64;
        if get_u32(object, length, header + 4) == 2 {
            let symbols: usize = get_u64(object, length, header + 24) as usize;
            let size: usize = get_u64(object, length, header + 32) as usize;
            let strings_header: usize = headers + get_u32(object, length, header + 40) as usize * 64;
            let strings: usize = get_u64(object, length, strings_header + 24) as usize;
            let mut symbol: usize = 1;
            while symbol < size / 24 {
                let record: usize = symbols + symbol * 24;
                let name: usize = strings + get_u32(object, length, record) as usize;
                if elf_name_matches_slice(object, length, name, entry_name, entry_length) {
                    if (unsafe { *(object + record + 4) } & 15) != 2 { return false; }
                    entry_symbol = symbol;
                }
                symbol = symbol + 1;
            }
        }
        section = section + 1;
    }
    if entry_symbol == 0 { return false; }
    section = 1;
    while section < count {
        let header: usize = headers + section * 64;
        if get_u32(object, length, header + 4) == 7 {
            let note: usize = get_u64(object, length, header + 24) as usize;
            let size: usize = get_u64(object, length, header + 32) as usize;
            if size >= 24 && get_u32(object, length, note) == 7
                && unsafe { *(object + note + 12) } == 83
                && unsafe { *(object + note + 13) } == 79
                && unsafe { *(object + note + 14) } == 84
                && unsafe { *(object + note + 15) } == 76
                && unsafe { *(object + note + 16) } == 65
                && unsafe { *(object + note + 17) } == 83 {
                let descriptor: usize = get_u32(object, length, note + 4) as usize;
                let kind: u32 = get_u32(object, length, note + 8);
                if descriptor <= size - 20 {
                    if kind == 1 && descriptor == 4 && entry_symbol == 1 {
                        return get_u32(object, length, note + 20) == 0;
                    }
                    if kind == 2 && entry_symbol <= descriptor / 4 {
                        return get_u32(object, length, note + 20 + (entry_symbol - 1) * 4) == 0;
                    }
                }
            }
        }
        section = section + 1;
    }
    return false;
}

fn macho_segment(output: *mut u8, capacity: usize, offset: usize,
    name: *const u8, name_length: usize, address: u64, memory_size: u64,
    file_offset: u64, file_size: u64, protection: u32) -> bool {
    if name_length > 16 || !pe_copy_bytes(output, capacity, offset + 8, name, name_length) { return false; }
    return put_u32(output, capacity, offset, 25)
        && put_u32(output, capacity, offset + 4, 72)
        && put_u64(output, capacity, offset + 24, address)
        && put_u64(output, capacity, offset + 32, memory_size)
        && put_u64(output, capacity, offset + 40, file_offset)
        && put_u64(output, capacity, offset + 48, file_size)
        && put_u32(output, capacity, offset + 56, protection)
        && put_u32(output, capacity, offset + 60, protection);
}

// Experimental static macOS x86-64 image. XNU permits static Intel binaries;
// LC_UNIXTHREAD selects the kernel entry without dyld or a C startup object.
// The owned ELF resolver is an internal relocation format, not an external
// linker invocation. No ARM64, signing, ASLR, dylibs or general process ABI.
pub fn link_macho64_executable(object: *const u8, object_length: usize,
    entry_name: *const u8, entry_name_length: usize,
    output: *mut u8, capacity: usize, output_length: *mut usize) -> bool {
    if output_length == null { return false; }
    unsafe { *output_length = 0; }
    if object == null || output == null || entry_name == null
        || object_length < 64 || capacity < 12288 || capacity > 268435456
        || get_u32(object, object_length, 48) != (get_u32(object, object_length, 48) & 2) { return false; }
    let mut offsets: [usize; 1] = 0;
    let mut lengths: [usize; 1] = 0;
    lengths[0] = object_length;
    let mut linked_length: usize = 0;
    let payload: *mut u8 = unsafe { output + 4096 };
    if !link_elf64_executable(object, unsafe { offsets as *const usize },
        unsafe { lengths as *const usize }, 1, entry_name, entry_name_length,
        null, 0, 4198400, true, payload, capacity - 8192,
        unsafe { (&linked_length) as *mut usize }) { return false; }
    if !macho_zero_argument_entry(object, object_length, entry_name, entry_name_length) { return false; }
    let memory_size: usize = get_u64(payload, linked_length, 104) as usize;
    if memory_size < linked_length || memory_size > 1879048192 { return false; }
    let start_file: usize = align_to(linked_length + 4096, 4096);
    if start_file > capacity - 4096 { return false; }
    let start_virtual: usize = align_to(memory_size + 4096, 4096);
    let start_address: u64 = 4194304 + start_virtual as u64;
    let entry_address: u64 = get_u64(payload, linked_length, 24);
    let relative: u64 = entry_address - (start_address + 9);
    if relative + 2147483648 > 4294967295 { return false; }
    let mut index: usize = 0;
    while index < 4096 { unsafe { *(output + index) = 0; } index = index + 1; }
    index = linked_length + 4096;
    while index < start_file + 4096 { unsafe { *(output + index) = 0; } index = index + 1; }
    // mach_header_64: MH_EXECUTE, MH_NOUNDEFS, five load commands.
    if !put_u32(output, capacity, 0, 4277009103)
        || !put_u32(output, capacity, 4, 16777223)
        || !put_u32(output, capacity, 8, 3)
        || !put_u32(output, capacity, 12, 2)
        || !put_u32(output, capacity, 16, 5)
        || !put_u32(output, capacity, 20, 416)
        || !put_u32(output, capacity, 24, 1)
        || !macho_segment(output, capacity, 32, "__PAGEZERO", 10, 0, 4194304, 0, 0, 0)
        || !macho_segment(output, capacity, 104, "__SOTLAS", 8, 4194304,
            start_virtual as u64, 0, start_file as u64, 7)
        || !macho_segment(output, capacity, 176, "__START", 7, start_address,
            4096, start_file as u64, 4096, 5)
        // LC_UNIXTHREAD, x86_THREAD_STATE64 (4), count 42 uint32s.
        || !put_u32(output, capacity, 248, 5)
        || !put_u32(output, capacity, 252, 184)
        || !put_u32(output, capacity, 256, 4)
        || !put_u32(output, capacity, 260, 42)
        || !put_u64(output, capacity, 392, start_address)
        || !put_u64(output, capacity, 400, 514)
        // LC_VERSION_MIN_MACOSX, deployment floor 10.13.
        || !put_u32(output, capacity, 432, 36)
        || !put_u32(output, capacity, 436, 16)
        || !put_u32(output, capacity, 440, 658688) { return false; }
    // and rsp,-16; call entry; mov edi,eax; mov eax,0x2000001;
    // syscall (exit); ud2 if the kernel unexpectedly returns.
    let mut code: usize = start_file;
    if !append_object_byte(output, capacity, &mut code, 72)
        || !append_object_byte(output, capacity, &mut code, 131)
        || !append_object_byte(output, capacity, &mut code, 228)
        || !append_object_byte(output, capacity, &mut code, 240)
        || !append_object_byte(output, capacity, &mut code, 232)
        || !append_object_u32(output, capacity, &mut code, relative as u32)
        || !append_object_byte(output, capacity, &mut code, 137)
        || !append_object_byte(output, capacity, &mut code, 199)
        || !append_object_byte(output, capacity, &mut code, 184)
        || !append_object_u32(output, capacity, &mut code, 33554433)
        || !append_object_byte(output, capacity, &mut code, 15)
        || !append_object_byte(output, capacity, &mut code, 5)
        || !append_object_byte(output, capacity, &mut code, 15)
        || !append_object_byte(output, capacity, &mut code, 11) { return false; }
    unsafe { *output_length = start_file + 4096; }
    return true;
}

// Validate before inspecting imports. The platform flag records actual IR
// Linux SystemOps, avoiding false rejection of syscall-shaped immediate bytes.
fn pe_import_mask(object: *const u8, length: usize) -> u32 {
    if length < 64 || get_u32(object, length, 0) != 1179403647
        || get_u16(object, length, 16) != 1 || get_u16(object, length, 18) != 62
        || get_u32(object, length, 48) != 0 || get_u16(object, length, 58) != 64 { return 4294967295; }
    let headers: usize = get_u64(object, length, 40) as usize;
    let count: usize = get_u16(object, length, 60) as usize;
    if count == 0 || count > 32 || headers > length || count * 64 > length - headers { return 4294967295; }
    let mut index: usize = 1;
    let mut symtab: usize = 0;
    while index < count {
        let header: usize = headers + index * 64;
        let kind: u32 = get_u32(object, length, header + 4);
        let offset: usize = get_u64(object, length, header + 24) as usize;
        let size: usize = get_u64(object, length, header + 32) as usize;
        if kind != 8 && (offset > length || size > length - offset) { return 4294967295; }
        if kind == 2 {
            if symtab != 0 || size % 24 != 0 || get_u64(object, length, header + 56) != 24 { return 4294967295; }
            symtab = header;
        }
        index = index + 1;
    }
    if symtab == 0 { return 4294967295; }
    let strings_index: usize = get_u32(object, length, symtab + 40) as usize;
    if strings_index >= count { return 4294967295; }
    let strings_header: usize = headers + strings_index * 64;
    if get_u32(object, length, strings_header + 4) != 3 { return 4294967295; }
    let strings: usize = get_u64(object, length, strings_header + 24) as usize;
    let strings_size: usize = get_u64(object, length, strings_header + 32) as usize;
    let symbols: usize = get_u64(object, length, symtab + 24) as usize;
    let symbol_count: usize = get_u64(object, length, symtab + 32) as usize / 24;
    let mut mask: u32 = 0;
    index = 1;
    while index < symbol_count {
        let symbol: usize = symbols + index * 24;
        if get_u16(object, length, symbol + 6) == 0 {
            let name: usize = get_u32(object, length, symbol) as usize;
            if name == 0 || name >= strings_size { return 4294967295; }
            let mut size: usize = 0;
            while size < strings_size - name {
                if unsafe { *(object + strings + name + size) } == 0 { break; }
                size = size + 1;
            }
            if size == strings_size - name { return 4294967295; }
            let id: u32 = windows_import_id(unsafe { object + strings + name }, size);
            if id == 0 || get_u64(object, length, symbol + 16) != (id as u64) + 1459617792 { return 4294967295; }
            mask = mask | ((1 as u32) << (id - 1));
        }
        index = index + 1;
    }
    return mask;
}

// Absolute symbols let the existing resolver link calls to PE startup thunks.
// No allocated sections are added, so the payload layout is independent of the
// final import addresses and can be resolved in two bounded passes.
fn pe_import_provider(output: *mut u8, capacity: usize, mask: u32, start_rva: usize) -> bool {
    if capacity < 2048 { return false; }
    let mut clear: usize = 0;
    while clear < 2048 { unsafe { *(output + clear) = 0; } clear = clear + 1; }
    let mut count: usize = 0;
    let mut id: u32 = 1;
    while id <= 8 {
        if (mask & ((1 as u32) << (id - 1))) != 0 { count = count + 1; }
        id = id + 1;
    }
    let strings: usize = (count + 1) * 24 + 320;
    let mut string_size: usize = 1;
    let mut symbol: usize = 1;
    id = 1;
    while id <= 8 {
        if (mask & ((1 as u32) << (id - 1))) != 0 {
            let record: usize = symbol * 24 + 320;
            let address: u64 = (start_rva + 1024 + (id as usize - 1) * 96) as u64 + 4194304;
            if !put_u32(output, capacity, record, string_size as u32)
                || !put_u8(output, capacity, record + 4, 18)
                || !put_u16(output, capacity, record + 6, 65521)
                || !put_u64(output, capacity, record + 8, address) { return false; }
            let name: *const u8 = windows_symbol_name(id);
            let size: usize = windows_symbol_length(id);
            let mut index: usize = 0;
            while index < size {
                unsafe { *(output + strings + string_size + index) = *(name + index); }
                index = index + 1;
            }
            string_size = string_size + size + 1;
            symbol = symbol + 1;
        }
        id = id + 1;
    }
    let names_offset: usize = strings + string_size;
    if !put_u32(output, capacity, 0, 1179403647)
        || !put_u8(output, capacity, 4, 2) || !put_u8(output, capacity, 5, 1)
        || !put_u8(output, capacity, 6, 1) || !put_u16(output, capacity, 16, 1)
        || !put_u16(output, capacity, 18, 62) || !put_u32(output, capacity, 20, 1)
        || !put_u64(output, capacity, 40, 64)
        || !put_u16(output, capacity, 52, 64) || !put_u16(output, capacity, 58, 64)
        || !put_u16(output, capacity, 60, 4) || !put_u16(output, capacity, 62, 3)
        || !put_section_header(output, capacity, 128, 1, 2, 0, 320,
            ((count + 1) * 24) as u64, 2, 1, 8, 24)
        || !put_section_header(output, capacity, 192, 9, 3, 0, strings as u64,
            string_size as u64, 0, 0, 1, 0)
        || !put_section_header(output, capacity, 256, 17, 3, 0, names_offset as u64,
            27, 0, 0, 1, 0) { return false; }
    let names: *const u8 = "\x00.symtab\x00.strtab\x00.shstrtab\x00";
    let mut index: usize = 0;
    while index < 27 { unsafe { *(output + names_offset + index) = *(names + index); } index = index + 1; }
    return true;
}

fn pe_copy_bytes(output: *mut u8, capacity: usize, offset: usize, data: *const u8, size: usize) -> bool {
    if offset > capacity || size > capacity - offset { return false; }
    let mut index: usize = 0;
    while index < size { unsafe { *(output + offset + index) = *(data + index); } index = index + 1; }
    return true;
}

fn pe_windows_thunk(output: *mut u8, capacity: usize, raw: usize, rva: usize,
    iat: usize, id: u32) -> bool {
    let count: u32 = windows_parameter_count(id);
    if !pe_copy_bytes(output, capacity, raw, "\x48\x83\xec\x48", 4) { return false; }
    let mut cursor: usize = raw + 4;
    if count >= 5 {
        if !pe_copy_bytes(output, capacity, cursor, "\x4c\x89\x44\x24\x20", 5) { return false; }
        cursor = cursor + 5;
    }
    if count >= 6 {
        if !pe_copy_bytes(output, capacity, cursor, "\x4c\x89\x4c\x24\x28", 5) { return false; }
        cursor = cursor + 5;
    }
    if count >= 7 {
        if !pe_copy_bytes(output, capacity, cursor, "\x4c\x8b\x54\x24\x50\x4c\x89\x54\x24\x30", 10) { return false; }
        cursor = cursor + 10;
    }
    if !pe_copy_bytes(output, capacity, cursor,
        "\x49\x89\xca\x49\x89\xd3\x48\x89\xf9\x48\x89\xf2\x4d\x89\xd8\x4d\x89\xd1\xff\x15", 20) { return false; }
    cursor = cursor + 20;
    let next_rva: usize = rva + cursor - raw + 4;
    if !put_u32(output, capacity, cursor, (iat as u32) - (next_rva as u32)) { return false; }
    cursor = cursor + 4;
    return pe_copy_bytes(output, capacity, cursor, "\x48\x83\xc4\x48\xc3", 5);
}

// Windows PE32+ candidate: retain the validated internal SysV calling convention,
// bridge a zero-argument entry to Win64 ExitProcess, and import only KERNEL32.
// Fixed image base, no external user symbols, unwind tables or base relocations.
pub fn link_pe64_executable(
    object: *const u8, object_length: usize,
    entry_name: *const u8, entry_name_length: usize,
    output: *mut u8, capacity: usize, output_length: *mut usize
) -> bool {
    if output_length == null { return false; }
    unsafe { *output_length = 0; }
    if object == null || output == null || entry_name == null
        || object_length < 64 || capacity < 3072 || capacity > 268435456 {
        return false;
    }
    let import_mask: u32 = pe_import_mask(object, object_length);
    if import_mask == 4294967295 || object_length > 8386544 { return false; }
    let joined: *mut u8 = unsafe { g_pe_link_objects as *mut u8 };
    if !pe_copy_bytes(joined, 8388608, 0, object, object_length) { return false; }
    let provider_offset: usize = align_to(object_length, 16);
    let provider: *mut u8 = unsafe { joined + provider_offset };
    if !pe_import_provider(provider, 2048, import_mask, 1073741824) { return false; }
    let mut offsets: [usize; 2] = 0;
    let mut lengths: [usize; 2] = 0;
    offsets[1] = provider_offset;
    lengths[0] = object_length;
    lengths[1] = 2048;
    let mut linked_length: usize = 0;
    let payload: *mut u8 = unsafe { output + 512 };
    if !link_elf64_executable(joined as *const u8, unsafe { offsets as *const usize },
        unsafe { lengths as *const usize }, 2, entry_name, entry_name_length,
        null, 0, 4198400, true, payload, capacity - 2560,
        unsafe { (&linked_length) as *mut usize }) { return false; }

    // The ELF linker above validates all section and symbol bounds. Require
    // explicit zero-argument ABI evidence. Platform requirements were checked
    // before resolving imports; machine immediates are not decoded as opcodes.
    let headers: usize = get_u64(object, object_length, 40) as usize;
    let section_count: usize = get_u16(object, object_length, 60) as usize;
    let mut entry_symbol: usize = 0;
    let mut section: usize = 1;
    while section < section_count {
        let header: usize = headers + section * 64;
        let kind: u32 = get_u32(object, object_length, header + 4);
        let start: usize = get_u64(object, object_length, header + 24) as usize;
        let size: usize = get_u64(object, object_length, header + 32) as usize;
        if kind == 2 {
            let strings_header: usize = headers + get_u32(object, object_length, header + 40) as usize * 64;
            let strings: usize = get_u64(object, object_length, strings_header + 24) as usize;
            let mut symbol: usize = 1;
            while symbol < size / 24 {
                let record: usize = start + symbol * 24;
                let name: usize = strings + get_u32(object, object_length, record) as usize;
                if elf_name_matches_slice(object, object_length, name, entry_name, entry_name_length) {
                    if (unsafe { *(object + record + 4) } & 15) != 2 { return false; }
                    entry_symbol = symbol;
                }
                symbol = symbol + 1;
            }
        }
        section = section + 1;
    }
    if entry_symbol == 0 { return false; }
    let mut valid_abi: bool = false;
    section = 1;
    while section < section_count {
        let header: usize = headers + section * 64;
        if get_u32(object, object_length, header + 4) == 7 {
            let note: usize = get_u64(object, object_length, header + 24) as usize;
            let size: usize = get_u64(object, object_length, header + 32) as usize;
            if size >= 24 && get_u32(object, object_length, note) == 7
                && unsafe { *(object + note + 12) } == 83
                && unsafe { *(object + note + 13) } == 79
                && unsafe { *(object + note + 14) } == 84
                && unsafe { *(object + note + 15) } == 76
                && unsafe { *(object + note + 16) } == 65
                && unsafe { *(object + note + 17) } == 83 {
                let descriptor_size: usize = get_u32(object, object_length, note + 4) as usize;
                let note_type: u32 = get_u32(object, object_length, note + 8);
                if descriptor_size <= size - 20 {
                    if note_type == 1 && descriptor_size == 4 && entry_symbol == 1 {
                        valid_abi = get_u32(object, object_length, note + 20) == 0;
                    } else if note_type == 2 && entry_symbol <= descriptor_size / 4 {
                        valid_abi = get_u32(object, object_length, note + 20 + (entry_symbol - 1) * 4) == 0;
                    }
                }
            }
        }
        section = section + 1;
    }
    if !valid_abi { return false; }
    let memory_size: usize = get_u64(payload, linked_length, 104) as usize;
    if memory_size < linked_length || memory_size > 1879048192 { return false; }
    let raw_size: usize = align_to(linked_length, 512);
    let start_raw: usize = raw_size + 512;
    if start_raw > capacity - 2048 { return false; }
    let start_rva: usize = align_to(memory_size + 4096, 4096);
    if !pe_import_provider(provider, 2048, import_mask, start_rva) { return false; }
    if !link_elf64_executable(joined as *const u8, unsafe { offsets as *const usize },
        unsafe { lengths as *const usize }, 2, entry_name, entry_name_length,
        null, 0, 4198400, true, payload, capacity - 2560,
        unsafe { (&linked_length) as *mut usize }) { return false; }
    if get_u64(payload, linked_length, 104) != (memory_size as u64) { return false; }
    let entry_address: u64 = get_u64(payload, linked_length, 24);
    if entry_address < 4198400 || entry_address - 4198400 >= (linked_length as u64) { return false; }
    let entry_rva: u32 = (entry_address - 4198400 + 4096) as u32;
    let mut index: usize = 0;
    while index < 512 { unsafe { *(output + index) = 0; } index = index + 1; }
    index = linked_length + 512;
    while index < start_raw + 2048 { unsafe { *(output + index) = 0; } index = index + 1; }
    if !put_u16(output, capacity, 0, 23117) || !put_u32(output, capacity, 60, 128)
        || !put_u32(output, capacity, 128, 17744)
        || !put_u16(output, capacity, 132, 34404) || !put_u16(output, capacity, 134, 2)
        || !put_u16(output, capacity, 148, 240) || !put_u16(output, capacity, 150, 35)
        || !put_u16(output, capacity, 152, 523)
        || !put_u32(output, capacity, 156, (raw_size + 2048) as u32)
        || !put_u32(output, capacity, 164, (memory_size - linked_length) as u32)
        || !put_u32(output, capacity, 168, start_rva as u32)
        || !put_u32(output, capacity, 172, 4096)
        || !put_u64(output, capacity, 176, 4194304)
        || !put_u32(output, capacity, 184, 4096) || !put_u32(output, capacity, 188, 512)
        || !put_u16(output, capacity, 192, 6) || !put_u16(output, capacity, 200, 6)
        || !put_u32(output, capacity, 208, (start_rva + 4096) as u32)
        || !put_u32(output, capacity, 212, 512)
        || !put_u16(output, capacity, 220, 3) || !put_u16(output, capacity, 222, 256)
        || !put_u64(output, capacity, 224, 8388608) || !put_u64(output, capacity, 232, 65536)
        || !put_u64(output, capacity, 240, 1048576) || !put_u64(output, capacity, 248, 4096)
        || !put_u32(output, capacity, 260, 16)
        || !put_u32(output, capacity, 272, (start_rva + 32) as u32)
        || !put_u32(output, capacity, 276, 40)
        || !put_u32(output, capacity, 360, (start_rva + 160) as u32)
        || !put_u32(output, capacity, 364, 72) { return false; }
    let names: *const u8 = ".sotlas\x00.start\x00\x00";
    index = 0;
    while index < 8 {
        unsafe { *(output + 392 + index) = *(names + index); }
        unsafe { *(output + 432 + index) = *(names + 8 + index); }
        index = index + 1;
    }
    if !put_u32(output, capacity, 400, memory_size as u32)
        || !put_u32(output, capacity, 404, 4096)
        || !put_u32(output, capacity, 408, raw_size as u32)
        || !put_u32(output, capacity, 412, 512)
        || !put_u32(output, capacity, 428, 3758096480)
        || !put_u32(output, capacity, 440, 2048)
        || !put_u32(output, capacity, 444, start_rva as u32)
        || !put_u32(output, capacity, 448, 2048)
        || !put_u32(output, capacity, 452, start_raw as u32)
        || !put_u32(output, capacity, 468, 3758096480) { return false; }
    // Win64 entry: shadow space and alignment, SysV no-argument call, then
    // move EAX to ECX and call ExitProcess through the loader-populated IAT.
    let startup: *const u8 = "\x48\x83\xec\x28\xe8\x00\x00\x00\x00\x89\xc1\xff\x15\x8f\x00\x00\x00\x0f\x0b";
    index = 0;
    while index < 19 { unsafe { *(output + start_raw + index) = *(startup + index); } index = index + 1; }
    let displacement: u32 = entry_rva - (start_rva as u32 + 9);
    if !put_u32(output, capacity, start_raw + 5, displacement)
        || !put_u32(output, capacity, start_raw + 32, (start_rva + 80) as u32)
        || !put_u32(output, capacity, start_raw + 44, (start_rva + 240) as u32)
        || !put_u32(output, capacity, start_raw + 48, (start_rva + 160) as u32) { return false; }
    let dll: *const u8 = "KERNEL32.dll";
    index = 0;
    while index < 13 { unsafe { *(output + start_raw + 240 + index) = *(dll + index); } index = index + 1; }
    let mut id: u32 = 1;
    while id <= 8 {
        let hint_offset: usize = (id as usize - 1) * 64 + 256;
        let lookup_offset: usize = (id as usize - 1) * 8 + 80;
        let iat_offset: usize = (id as usize - 1) * 8 + 160;
        if !put_u64(output, capacity, start_raw + lookup_offset, (start_rva + hint_offset) as u64)
            || !put_u64(output, capacity, start_raw + iat_offset, (start_rva + hint_offset) as u64)
            || !pe_copy_bytes(output, capacity, start_raw + hint_offset + 2,
                windows_dll_name(id), windows_dll_name_length(id)) { return false; }
        let thunk_offset: usize = (id as usize - 1) * 96 + 1024;
        if !pe_windows_thunk(output, capacity, start_raw + thunk_offset,
            start_rva + thunk_offset, start_rva + iat_offset, id) { return false; }
        id = id + 1;
    }
    unsafe { *output_length = start_raw + 2048; }
    return true;
}

// The assembler-text path supports the scalar function subset below. A narrow
// direct ELF object writer and a narrow single-object linker are defined above;
// broader link layouts and object formats remain separate stages.
fn append_bytes(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    bytes: *const u8,
    byte_count: usize
) -> bool {
    if output == null || bytes == null
        || *length > capacity || byte_count > capacity - *length {
        return false;
    }
    let mut index: usize = 0;
    while index < byte_count {
        unsafe { *(output + *length + index) = *(bytes + index); }
        index = index + 1;
    }
    *length = *length + byte_count;
    return true;
}

fn append_u32_decimal(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    value: u32
) -> bool {
    let mut digits: [u8; 10] = 0;
    let mut count: usize = 0;
    let mut remaining: u32 = value;
    if remaining == 0 {
        digits[0] = 48;
        count = 1;
    } else {
        while remaining != 0 && count < 10 {
            digits[count] = (48 + remaining % 10) as u8;
            remaining = remaining / 10;
            count = count + 1;
        }
    }
    if remaining != 0 || *length > capacity || count > capacity - *length {
        return false;
    }
    let mut index: usize = 0;
    while index < count {
        unsafe { *(output + *length + index) = digits[count - index - 1]; }
        index = index + 1;
    }
    *length = *length + count;
    return true;
}

fn valid_symbol_byte(value: u8, first: bool) -> bool {
    if value == 95 || (value >= 65 && value <= 90)
        || (value >= 97 && value <= 122) {
        return true;
    }
    return !first && value >= 48 && value <= 57;
}

fn abi_uses_sysv_registers(abi: u32) -> bool {
    return abi == 1 || abi == 3;
}

fn append_assembly_symbol(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    abi: u32,
    name: *const u8,
    name_length: usize
) -> bool {
    if abi == 3 {
        if !append_bytes(output, capacity, length, "_", 1) {
            return false;
        }
    }
    return append_bytes(output, capacity, length, name, name_length);
}

fn append_slot_load(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    value_id: u32
) -> bool {
    if value_id == 0 {
        return false;
    }
    return append_bytes(output, capacity, length, "  movl -", 8)
        && append_u32_decimal(output, capacity, length, value_id * 8)
        && append_bytes(output, capacity, length, "(%rbp), %eax\n", 13);
}

fn append_slot_store(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    value_id: u32
) -> bool {
    if value_id == 0 {
        return false;
    }
    return append_bytes(output, capacity, length, "  movl %eax, -", 14)
        && append_u32_decimal(output, capacity, length, value_id * 8)
        && append_bytes(output, capacity, length, "(%rbp)\n", 7);
}

fn append_argument_register(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    abi: u32,
    index: u32
) -> bool {
    if abi_uses_sysv_registers(abi) {
        if index == 0 { return append_bytes(output, capacity, length, "%edi", 4); }
        if index == 1 { return append_bytes(output, capacity, length, "%esi", 4); }
        if index == 2 { return append_bytes(output, capacity, length, "%edx", 4); }
        if index == 3 { return append_bytes(output, capacity, length, "%ecx", 4); }
        if index == 4 { return append_bytes(output, capacity, length, "%r8d", 4); }
        if index == 5 { return append_bytes(output, capacity, length, "%r9d", 4); }
    } else if abi == 2 {
        if index == 0 { return append_bytes(output, capacity, length, "%ecx", 4); }
        if index == 1 { return append_bytes(output, capacity, length, "%edx", 4); }
        if index == 2 { return append_bytes(output, capacity, length, "%r8d", 4); }
        if index == 3 { return append_bytes(output, capacity, length, "%r9d", 4); }
    }
    return false;
}

fn append_arithmetic_mnemonic(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    opcode: TargetOpcode
) -> bool {
    if opcode == TargetOpcode::Add {
        return append_bytes(output, capacity, length, "  addl ", 7);
    }
    if opcode == TargetOpcode::Sub {
        return append_bytes(output, capacity, length, "  subl ", 7);
    }
    if opcode == TargetOpcode::Mul {
        return append_bytes(output, capacity, length, "  imull ", 8);
    }
    return false;
}

// Emit a one-block U32 scalar function for the x86-64 SysV (abi=1) or
// Windows x64 (abi=2) calling convention. Values spill to frame slots so this
// first backend subset does not depend on a host register allocator.
@export
@system
pub fn emit_x86_64_scalar_function(
    abi: u32,
    source: *const u8,
    source_len: usize,
    target_module: *const TargetModule,
    functions: *const TargetFunction,
    parameters: *const TargetParameter,
    blocks: *const TargetBlock,
    instructions: *const TargetInstruction,
    operands: *const TargetOperand,
    output: *mut u8,
    capacity: usize,
    output_length: *mut usize
) -> bool {
    if output_length == null {
        return false;
    }
    unsafe { *output_length = 0; }
    if (abi != 1 && abi != 2 && abi != 3) || source == null || target_module == null
        || functions == null || parameters == null || blocks == null
        || instructions == null || operands == null || output == null
        || unsafe { (*target_module).version } != 1
        || unsafe { (*target_module).function_count } != 1
        || unsafe { (*target_module).block_count } != 1
        || unsafe { (*target_module).value_count } == 0
        || unsafe { (*target_module).value_count } > 536870911 {
        return false;
    }

    let function: TargetFunction = unsafe { *functions };
    let block: TargetBlock = unsafe { *blocks };
    if function.name.length == 0 || function.name.offset > source_len
        || function.name.length > source_len - function.name.offset
        || function.return_type != TargetTypeTag::U32
        || function.block_count != 1 || function.first_block != 0
        || function.first_parameter != 0
        || block.id != 1 || block.first_instruction != 0
        || block.instruction_count != unsafe { (*target_module).instruction_count }
        || function.parameter_count != unsafe { (*target_module).parameter_count }
        || function.parameter_count > 536870911
        || (abi_uses_sysv_registers(abi) && function.parameter_count > 6)
        || (abi == 2 && function.parameter_count > 4) {
        return false;
    }

    let mut name_index: usize = 0;
    while name_index < function.name.length {
        let byte: u8 = unsafe { *(source + function.name.offset + name_index) };
        if !valid_symbol_byte(byte, name_index == 0) {
            return false;
        }
        name_index = name_index + 1;
    }
    let name_bytes: *const u8 = unsafe { source + function.name.offset };
    let mut length: usize = 0;
    if !append_bytes(output, capacity, &mut length, ".text\n.globl ", 13)
        || !append_assembly_symbol(output, capacity, &mut length, abi, name_bytes, function.name.length)
        || !append_bytes(output, capacity, &mut length, "\n", 1)
        || !append_assembly_symbol(output, capacity, &mut length, abi, name_bytes, function.name.length)
        || !append_bytes(output, capacity, &mut length, ":\n  pushq %rbp\n  movq %rsp, %rbp\n", 33) {
        unsafe { *output_length = 0; }
        return false;
    }

    let base_frame_size: u32 = (((unsafe { (*target_module).value_count } * 8) + 15) / 16) * 16;
    let mut frame_size: u32 = base_frame_size;
    if abi == 2 { frame_size = frame_size + 32; }
    let mut max_call_arguments: u32 = 6;
    if abi == 2 { max_call_arguments = 4; }
    if !append_bytes(output, capacity, &mut length, "  subq $", 8)
        || !append_u32_decimal(output, capacity, &mut length, frame_size)
        || !append_bytes(output, capacity, &mut length, ", %rsp\n", 7) {
        unsafe { *output_length = 0; }
        return false;
    }

    let mut parameter_index: u32 = 0;
    while parameter_index < function.parameter_count {
        let parameter: TargetParameter = unsafe {
            *(parameters + function.first_parameter + parameter_index)
        };
        if parameter.type_tag != TargetTypeTag::U32
            || parameter.value_id == 0
            || parameter.value_id != parameter_index + 1
            || parameter.value_id > unsafe { (*target_module).value_count }
            || !append_bytes(output, capacity, &mut length, "  movl ", 7)
            || !append_argument_register(
                output, capacity, &mut length, abi, parameter_index
            )
            || !append_bytes(output, capacity, &mut length, ", -", 3)
            || !append_u32_decimal(output, capacity, &mut length, parameter.value_id * 8)
            || !append_bytes(output, capacity, &mut length, "(%rbp)\n", 7) {
            unsafe { *output_length = 0; }
            return false;
        }
        parameter_index = parameter_index + 1;
    }

    let mut next_value_id: u32 = function.parameter_count + 1;
    let mut instruction_index: u32 = 0;
    let mut saw_return: bool = false;
    let instruction_count: u32 = unsafe { (*target_module).instruction_count };
    while instruction_index < instruction_count {
        let instruction: TargetInstruction = unsafe { *(instructions + instruction_index) };
        if instruction.result_value > unsafe { (*target_module).value_count } {
            unsafe { *output_length = 0; }
            return false;
        }
        if instruction.opcode == TargetOpcode::ConstInt {
            if instruction.type_tag != TargetTypeTag::U32
                || instruction.immediate_bits > 4294967295
                || instruction.result_value != next_value_id
                || instruction.operand_count != 0
                || !append_bytes(output, capacity, &mut length, "  movl $", 8)
                || !append_u32_decimal(
                    output, capacity, &mut length, instruction.immediate_bits as u32
                )
                || !append_bytes(output, capacity, &mut length, ", %eax\n", 7)
                || !append_slot_store(output, capacity, &mut length, instruction.result_value) {
                unsafe { *output_length = 0; }
                return false;
            }
            next_value_id = next_value_id + 1;
        } else if instruction.opcode == TargetOpcode::Add
            || instruction.opcode == TargetOpcode::Sub
            || instruction.opcode == TargetOpcode::Mul {
            if instruction.type_tag != TargetTypeTag::U32
                || instruction.result_value != next_value_id || instruction.operand_count != 2
                || instruction.first_operand > unsafe { (*target_module).operand_count }
                || 2 > unsafe { (*target_module).operand_count } - instruction.first_operand {
                unsafe { *output_length = 0; }
                return false;
            }
            let left: TargetOperand = unsafe { *(operands + instruction.first_operand) };
            let right: TargetOperand = unsafe { *(operands + instruction.first_operand + 1) };
            if left.value_id == 0 || right.value_id == 0
                || left.value_id >= next_value_id
                || right.value_id >= next_value_id
                || !append_slot_load(output, capacity, &mut length, left.value_id)
                || !append_arithmetic_mnemonic(
                    output, capacity, &mut length, instruction.opcode
                )
                || !append_bytes(output, capacity, &mut length, "-", 1)
                || !append_u32_decimal(output, capacity, &mut length, right.value_id * 8)
                || !append_bytes(output, capacity, &mut length, "(%rbp), %eax\n", 13)
                || !append_slot_store(output, capacity, &mut length, instruction.result_value) {
                unsafe { *output_length = 0; }
                return false;
            }
            next_value_id = next_value_id + 1;
        } else if instruction.opcode == TargetOpcode::Call {
            if instruction.type_tag != TargetTypeTag::U32
                || instruction.result_value != next_value_id
                || instruction.operand_count > max_call_arguments
                || instruction.first_operand > unsafe { (*target_module).operand_count }
                || instruction.operand_count > unsafe { (*target_module).operand_count } - instruction.first_operand
                || instruction.phi_input_count != 0 || instruction.target_count != 0
                || instruction.symbol.length == 0 || instruction.symbol.offset > source_len
                || instruction.symbol.length > source_len - instruction.symbol.offset {
                unsafe { *output_length = 0; }
                return false;
            }
            let mut symbol_index: usize = 0;
            while symbol_index < instruction.symbol.length {
                if !valid_symbol_byte(
                    unsafe { *(source + instruction.symbol.offset + symbol_index) },
                    symbol_index == 0
                ) {
                    unsafe { *output_length = 0; }
                    return false;
                }
                symbol_index = symbol_index + 1;
            }
            let mut argument_index: u32 = 0;
            while argument_index < instruction.operand_count {
                let argument: TargetOperand = unsafe {
                    *(operands + instruction.first_operand + argument_index)
                };
                if argument.value_id == 0 || argument.value_id >= next_value_id
                    || !append_slot_load(output, capacity, &mut length, argument.value_id)
                    || !append_bytes(output, capacity, &mut length, "  movl %eax, ", 13)
                    || !append_argument_register(output, capacity, &mut length, abi, argument_index)
                    || !append_bytes(output, capacity, &mut length, "\n", 1) {
                    unsafe { *output_length = 0; }
                    return false;
                }
                argument_index = argument_index + 1;
            }
            if !append_bytes(output, capacity, &mut length, "  call ", 7)
                || !append_assembly_symbol(
                    output, capacity, &mut length, abi,
                    unsafe { source + instruction.symbol.offset }, instruction.symbol.length
                )
                || !append_bytes(output, capacity, &mut length, "\n", 1)
                || !append_slot_store(output, capacity, &mut length, instruction.result_value) {
                unsafe { *output_length = 0; }
                return false;
            }
            next_value_id = next_value_id + 1;
        } else if instruction.opcode == TargetOpcode::Return {
            if instruction_index + 1 != instruction_count
                || instruction.type_tag != TargetTypeTag::U32
                || instruction.result_value != 0
                || instruction.operand_count != 1
                || instruction.first_operand >= unsafe { (*target_module).operand_count } {
                unsafe { *output_length = 0; }
                return false;
            }
            let returned: TargetOperand = unsafe { *(operands + instruction.first_operand) };
            if returned.value_id == 0
                || returned.value_id >= next_value_id
                || !append_slot_load(output, capacity, &mut length, returned.value_id)
                || !append_bytes(output, capacity, &mut length, "  leave\n  ret\n", 14) {
                unsafe { *output_length = 0; }
                return false;
            }
            saw_return = true;
        } else {
            unsafe { *output_length = 0; }
            return false;
        }
        instruction_index = instruction_index + 1;
    }

    if !saw_return || next_value_id - 1 != unsafe { (*target_module).value_count } {
        unsafe { *output_length = 0; }
        return false;
    }
    unsafe { *output_length = length; }
    return true;
}

// Emit several one-block scalar functions so direct Target IR calls can be
// assembled and resolved by the platform linker. Object relocation ownership
// remains a separate SV5 concern.
@export
@system
pub fn emit_x86_64_scalar_module(
    abi: u32,
    source: *const u8,
    source_len: usize,
    target_module: *const TargetModule,
    functions: *const TargetFunction,
    parameters: *const TargetParameter,
    values: *const TargetValue,
    blocks: *const TargetBlock,
    instructions: *const TargetInstruction,
    operands: *const TargetOperand,
    output: *mut u8,
    capacity: usize,
    output_length: *mut usize
) -> bool {
    if output_length == null { return false; }
    unsafe { *output_length = 0; }
    if (abi != 1 && abi != 2 && abi != 3) || source == null || target_module == null
        || functions == null || parameters == null || values == null || blocks == null
        || instructions == null || operands == null || output == null
        || unsafe { (*target_module).version } != 1
        || unsafe { (*target_module).function_count } < 2
        || unsafe { (*target_module).block_count } != unsafe { (*target_module).function_count }
        || unsafe { (*target_module).value_count } == 0
        || unsafe { (*target_module).value_count } > 536870911 {
        return false;
    }
    let mut length: usize = 0;
    let mut function_index: u32 = 0;
    while function_index < unsafe { (*target_module).function_count } {
        let function: TargetFunction = unsafe { *(functions + function_index) };
        if function.return_type != TargetTypeTag::U32 || function.block_count != 1
            || function.first_block != function_index
            || function.first_parameter > unsafe { (*target_module).parameter_count }
            || function.parameter_count > unsafe { (*target_module).parameter_count } - function.first_parameter
            || (abi_uses_sysv_registers(abi) && function.parameter_count > 6)
            || (abi == 2 && function.parameter_count > 4)
            || function.name.length == 0 || function.name.offset > source_len
            || function.name.length > source_len - function.name.offset {
            unsafe { *output_length = 0; }
            return false;
        }
        let mut name_index: usize = 0;
        while name_index < function.name.length {
            if !valid_symbol_byte(unsafe { *(source + function.name.offset + name_index) }, name_index == 0) {
                unsafe { *output_length = 0; }
                return false;
            }
            name_index = name_index + 1;
        }
        let block: TargetBlock = unsafe { *(blocks + function.first_block) };
        if block.id != function.first_block + 1 || block.instruction_count == 0
            || block.first_instruction > unsafe { (*target_module).instruction_count }
            || block.instruction_count > unsafe { (*target_module).instruction_count } - block.first_instruction {
            unsafe { *output_length = 0; }
            return false;
        }
        let function_name: *const u8 = unsafe { source + function.name.offset };
        if !append_bytes(output, capacity, &mut length, ".text\n.globl ", 13)
            || !append_assembly_symbol(output, capacity, &mut length, abi, function_name, function.name.length)
            || !append_bytes(output, capacity, &mut length, "\n", 1)
            || !append_assembly_symbol(output, capacity, &mut length, abi, function_name, function.name.length)
            || !append_bytes(output, capacity, &mut length, ":\n  pushq %rbp\n  movq %rsp, %rbp\n", 33) {
            unsafe { *output_length = 0; }
            return false;
        }
        let base_frame_size: u32 = (((unsafe { (*target_module).value_count } * 8) + 15) / 16) * 16;
        let mut frame_size: u32 = base_frame_size;
        if abi == 2 { frame_size = frame_size + 32; }
        let mut max_call_arguments: u32 = 6;
        if abi == 2 { max_call_arguments = 4; }
        if !append_bytes(output, capacity, &mut length, "  subq $", 8)
            || !append_u32_decimal(output, capacity, &mut length, frame_size)
            || !append_bytes(output, capacity, &mut length, ", %rsp\n", 7) {
            unsafe { *output_length = 0; }
            return false;
        }
        let mut parameter_index: u32 = 0;
        let mut next_value_id: u32 = 0;
        let mut first_value_id: u32 = 0;
        while parameter_index < function.parameter_count {
            let parameter: TargetParameter = unsafe {
                *(parameters + function.first_parameter + parameter_index)
            };
            if parameter.type_tag != TargetTypeTag::U32 || parameter.value_id == 0
                || (parameter_index != 0 && parameter.value_id != next_value_id)
                || parameter.value_id > unsafe { (*target_module).value_count }
                || unsafe { (*(values + parameter.value_id as usize - 1)).id } != parameter.value_id
                || unsafe { (*(values + parameter.value_id as usize - 1)).type_tag } != TargetTypeTag::U32
                || !append_bytes(output, capacity, &mut length, "  movl ", 7)
                || !append_argument_register(output, capacity, &mut length, abi, parameter_index)
                || !append_bytes(output, capacity, &mut length, ", -", 3)
                || !append_u32_decimal(output, capacity, &mut length, parameter.value_id * 8)
                || !append_bytes(output, capacity, &mut length, "(%rbp)\n", 7) {
                unsafe { *output_length = 0; }
                return false;
            }
            if parameter_index == 0 { first_value_id = parameter.value_id; }
            next_value_id = parameter.value_id + 1;
            parameter_index = parameter_index + 1;
        }
        if function.parameter_count == 0 {
            let mut scan: u32 = 0;
            while scan < block.instruction_count {
                let candidate: TargetInstruction = unsafe {
                    *(instructions + block.first_instruction + scan)
                };
                if candidate.result_value != 0 {
                    next_value_id = candidate.result_value;
                    first_value_id = candidate.result_value;
                    break;
                }
                scan = scan + 1;
            }
            if next_value_id == 0 { return false; }
        }
        let mut local_index: u32 = 0;
        let mut saw_return: bool = false;
        while local_index < block.instruction_count {
            let instruction: TargetInstruction = unsafe {
                *(instructions + block.first_instruction + local_index)
            };
            if instruction.opcode == TargetOpcode::ConstInt {
                if instruction.type_tag != TargetTypeTag::U32
                    || instruction.immediate_bits > 4294967295
                    || instruction.result_value != next_value_id || instruction.operand_count != 0
                    || !append_bytes(output, capacity, &mut length, "  movl $", 8)
                    || !append_u32_decimal(output, capacity, &mut length, instruction.immediate_bits as u32)
                    || !append_bytes(output, capacity, &mut length, ", %eax\n", 7)
                    || !append_slot_store(output, capacity, &mut length, instruction.result_value) {
                    unsafe { *output_length = 0; }
                    return false;
                }
                next_value_id = next_value_id + 1;
            } else if instruction.opcode == TargetOpcode::Add
                || instruction.opcode == TargetOpcode::Sub || instruction.opcode == TargetOpcode::Mul {
                if instruction.type_tag != TargetTypeTag::U32 || instruction.result_value != next_value_id
                    || instruction.operand_count != 2
                    || instruction.first_operand > unsafe { (*target_module).operand_count }
                    || 2 > unsafe { (*target_module).operand_count } - instruction.first_operand {
                    unsafe { *output_length = 0; }
                    return false;
                }
                let left: TargetOperand = unsafe { *(operands + instruction.first_operand) };
                let right: TargetOperand = unsafe { *(operands + instruction.first_operand + 1) };
                if left.value_id < first_value_id || right.value_id < first_value_id
                    || left.value_id >= next_value_id || right.value_id >= next_value_id
                    || unsafe { (*(values + left.value_id as usize - 1)).id } != left.value_id
                    || unsafe { (*(values + right.value_id as usize - 1)).id } != right.value_id
                    || unsafe { (*(values + left.value_id as usize - 1)).type_tag } != TargetTypeTag::U32
                    || unsafe { (*(values + right.value_id as usize - 1)).type_tag } != TargetTypeTag::U32
                    || unsafe { (*(values + instruction.result_value as usize - 1)).id } != instruction.result_value
                    || unsafe { (*(values + instruction.result_value as usize - 1)).type_tag } != TargetTypeTag::U32
                    || !append_slot_load(output, capacity, &mut length, left.value_id)
                    || !append_arithmetic_mnemonic(output, capacity, &mut length, instruction.opcode)
                    || !append_bytes(output, capacity, &mut length, "-", 1)
                    || !append_u32_decimal(output, capacity, &mut length, right.value_id * 8)
                    || !append_bytes(output, capacity, &mut length, "(%rbp), %eax\n", 13)
                    || !append_slot_store(output, capacity, &mut length, instruction.result_value) {
                    unsafe { *output_length = 0; }
                    return false;
                }
                next_value_id = next_value_id + 1;
            } else if instruction.opcode == TargetOpcode::Call {
                if instruction.type_tag != TargetTypeTag::U32 || instruction.result_value != next_value_id
                    || instruction.operand_count > max_call_arguments
                    || instruction.first_operand > unsafe { (*target_module).operand_count }
                    || instruction.operand_count > unsafe { (*target_module).operand_count } - instruction.first_operand
                    || instruction.symbol.length == 0 || instruction.symbol.offset > source_len
                    || instruction.symbol.length > source_len - instruction.symbol.offset {
                    unsafe { *output_length = 0; }
                    return false;
                }
                let mut callee_index: u32 = 0;
                let mut callee_found: bool = false;
                while callee_index < unsafe { (*target_module).function_count } {
                    let callee: TargetFunction = unsafe { *(functions + callee_index) };
                    if callee.name.length == instruction.symbol.length
                        && callee.name.offset <= source_len
                        && callee.name.length <= source_len - callee.name.offset {
                        let mut name_index: usize = 0;
                        let mut names_match: bool = true;
                        while name_index < instruction.symbol.length {
                            if unsafe { *(source + callee.name.offset + name_index) }
                                != unsafe { *(source + instruction.symbol.offset + name_index) } {
                                names_match = false;
                                break;
                            }
                            name_index = name_index + 1;
                        }
                        if names_match {
                            if callee.return_type != TargetTypeTag::U32
                                || callee.parameter_count != instruction.operand_count
                                || callee.first_parameter > unsafe { (*target_module).parameter_count }
                                || callee.parameter_count > unsafe { (*target_module).parameter_count } - callee.first_parameter {
                                unsafe { *output_length = 0; }
                                return false;
                            }
                            let mut signature_index: u32 = 0;
                            while signature_index < callee.parameter_count {
                                let parameter: TargetParameter = unsafe {
                                    *(parameters + callee.first_parameter + signature_index)
                                };
                                if parameter.type_tag != TargetTypeTag::U32 {
                                    unsafe { *output_length = 0; }
                                    return false;
                                }
                                signature_index = signature_index + 1;
                            }
                            callee_found = true;
                            break;
                        }
                    }
                    callee_index = callee_index + 1;
                }
                if !callee_found {
                    unsafe { *output_length = 0; }
                    return false;
                }
                let mut argument_index: u32 = 0;
                while argument_index < instruction.operand_count {
                    let argument: TargetOperand = unsafe {
                        *(operands + instruction.first_operand + argument_index)
                    };
                    if argument.value_id < first_value_id || argument.value_id >= next_value_id
                        || unsafe { (*(values + argument.value_id as usize - 1)).id } != argument.value_id
                        || unsafe { (*(values + argument.value_id as usize - 1)).type_tag } != TargetTypeTag::U32
                        || unsafe { (*(values + instruction.result_value as usize - 1)).id } != instruction.result_value
                        || unsafe { (*(values + instruction.result_value as usize - 1)).type_tag } != TargetTypeTag::U32
                        || !append_slot_load(output, capacity, &mut length, argument.value_id)
                        || !append_bytes(output, capacity, &mut length, "  movl %eax, ", 13)
                        || !append_argument_register(output, capacity, &mut length, abi, argument_index)
                        || !append_bytes(output, capacity, &mut length, "\n", 1) {
                        unsafe { *output_length = 0; }
                        return false;
                    }
                    argument_index = argument_index + 1;
                }
                if !append_bytes(output, capacity, &mut length, "  call ", 7)
                    || !append_assembly_symbol(
                        output, capacity, &mut length, abi,
                        unsafe { source + instruction.symbol.offset }, instruction.symbol.length
                    )
                    || !append_bytes(output, capacity, &mut length, "\n", 1)
                    || !append_slot_store(output, capacity, &mut length, instruction.result_value) {
                    unsafe { *output_length = 0; }
                    return false;
                }
                next_value_id = next_value_id + 1;
            } else if instruction.opcode == TargetOpcode::Return {
                if local_index + 1 != block.instruction_count || instruction.type_tag != TargetTypeTag::U32
                    || instruction.result_value != 0 || instruction.operand_count != 1
                    || instruction.first_operand >= unsafe { (*target_module).operand_count } {
                    unsafe { *output_length = 0; }
                    return false;
                }
                let returned: TargetOperand = unsafe { *(operands + instruction.first_operand) };
                if returned.value_id < first_value_id || returned.value_id >= next_value_id
                    || unsafe { (*(values + returned.value_id as usize - 1)).id } != returned.value_id
                    || unsafe { (*(values + returned.value_id as usize - 1)).type_tag } != TargetTypeTag::U32
                    || !append_slot_load(output, capacity, &mut length, returned.value_id)
                    || !append_bytes(output, capacity, &mut length, "  leave\n  ret\n", 14) {
                    unsafe { *output_length = 0; }
                    return false;
                }
                saw_return = true;
            } else {
                unsafe { *output_length = 0; }
                return false;
            }
            local_index = local_index + 1;
        }
        if !saw_return || next_value_id - 1 > unsafe { (*target_module).value_count } {
            unsafe { *output_length = 0; }
            return false;
        }
        function_index = function_index + 1;
    }
    unsafe { *output_length = length; }
    return true;
}

fn append_cfg_label(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    function_name: *const u8,
    function_name_length: usize,
    block_id: u32
) -> bool {
    return append_bytes(output, capacity, length, ".L", 2)
        && append_bytes(output, capacity, length, function_name, function_name_length)
        && append_bytes(output, capacity, length, "_bb", 3)
        && append_u32_decimal(output, capacity, length, block_id)
        && append_bytes(output, capacity, length, ":\n", 2);
}

fn append_cfg_label_name(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    function_name: *const u8,
    function_name_length: usize,
    block_id: u32
) -> bool {
    return append_bytes(output, capacity, length, ".L", 2)
        && append_bytes(output, capacity, length, function_name, function_name_length)
        && append_bytes(output, capacity, length, "_bb", 3)
        && append_u32_decimal(output, capacity, length, block_id)
        && append_bytes(output, capacity, length, "\n", 1);
}

// Emit a three-block bool-controlled choice function. This is the first
// executable multi-block CFG slice: one conditional edge and two returns.
@export
@system
pub fn emit_x86_64_scalar_if_return(
    abi: u32,
    source: *const u8,
    source_len: usize,
    target_module: *const TargetModule,
    functions: *const TargetFunction,
    parameters: *const TargetParameter,
    blocks: *const TargetBlock,
    instructions: *const TargetInstruction,
    operands: *const TargetOperand,
    targets: *const u32,
    output: *mut u8,
    capacity: usize,
    output_length: *mut usize
) -> bool {
    if output_length == null { return false; }
    unsafe { *output_length = 0; }
    if (abi != 1 && abi != 2 && abi != 3) || source == null || target_module == null
        || functions == null || parameters == null || blocks == null
        || instructions == null || operands == null || targets == null || output == null
        || unsafe { (*target_module).version } != 1
        || unsafe { (*target_module).function_count } != 1
        || (unsafe { (*target_module).parameter_count } != 2
            && unsafe { (*target_module).parameter_count } != 3)
        || unsafe { (*target_module).block_count } != 3
        || unsafe { (*target_module).instruction_count } < 3
        || unsafe { (*target_module).operand_count } < 3
        || unsafe { (*target_module).target_count } != 2
        || unsafe { (*target_module).value_count } < unsafe { (*target_module).parameter_count }
        || unsafe { (*target_module).value_count } > 536870911 {
        return false;
    }
    let function: TargetFunction = unsafe { *functions };
    if function.name.length == 0 || function.name.offset > source_len
        || function.name.length > source_len - function.name.offset
        || function.return_type != TargetTypeTag::U32 || function.first_parameter != 0
        || function.parameter_count != unsafe { (*target_module).parameter_count }
        || function.first_block != 0
        || function.block_count != 3 {
        return false;
    }
    let mut name_index: usize = 0;
    while name_index < function.name.length {
        if !valid_symbol_byte(
            unsafe { *(source + function.name.offset + name_index) }, name_index == 0
        ) { return false; }
        name_index = name_index + 1;
    }
    let mut parameter_check: u32 = 0;
    while parameter_check < function.parameter_count {
        let parameter: TargetParameter = unsafe { *(parameters + parameter_check) };
        let mut expected: TargetTypeTag = TargetTypeTag::U32;
        if function.parameter_count == 3 && parameter_check == 0 {
            expected = TargetTypeTag::Bool;
        }
        if parameter.value_id != parameter_check + 1 || parameter.type_tag != expected {
            return false;
        }
        parameter_check = parameter_check + 1;
    }
    let entry: TargetBlock = unsafe { *blocks };
    let yes_block: TargetBlock = unsafe { *(blocks + 1) };
    let no_block: TargetBlock = unsafe { *(blocks + 2) };
    if entry.id != 1 || entry.first_instruction != 0 || entry.instruction_count < 1
        || yes_block.id != 2 || yes_block.first_instruction != entry.first_instruction + entry.instruction_count
        || yes_block.instruction_count < 1
        || no_block.id != 3 || no_block.first_instruction != yes_block.first_instruction + yes_block.instruction_count
        || no_block.instruction_count < 1
        || no_block.first_instruction + no_block.instruction_count != unsafe { (*target_module).instruction_count } {
        return false;
    }
    let condition: TargetInstruction = unsafe {
        *(instructions + entry.first_instruction + entry.instruction_count - 1)
    };
    if condition.opcode != TargetOpcode::CondBranch || condition.type_tag != TargetTypeTag::Bool
        || condition.result_value != 0 || condition.operand_count != 1
        || condition.first_operand >= unsafe { (*target_module).operand_count }
        || condition.target_count != 2
        || condition.first_target > unsafe { (*target_module).target_count }
        || 2 > unsafe { (*target_module).target_count } - condition.first_target
        || unsafe { *(targets + condition.first_target) } != 2
        || unsafe { *(targets + condition.first_target + 1) } != 3 {
        return false;
    }
    let condition_operand: TargetOperand = unsafe { *(operands + condition.first_operand) };
    if condition_operand.value_id == 0
        || condition_operand.value_id > unsafe { (*target_module).value_count }
        || (function.parameter_count == 2 && condition_operand.value_id < 3)
        || (function.parameter_count == 3 && condition_operand.value_id != 1
            && condition_operand.value_id < 4) {
        return false;
    }
    let function_name: *const u8 = unsafe { source + function.name.offset };
    let mut length: usize = 0;
    if !append_bytes(output, capacity, &mut length, ".text\n.globl ", 13)
        || !append_assembly_symbol(output, capacity, &mut length, abi, function_name, function.name.length)
        || !append_bytes(output, capacity, &mut length, "\n", 1)
        || !append_assembly_symbol(output, capacity, &mut length, abi, function_name, function.name.length)
        || !append_bytes(output, capacity, &mut length, ":\n  pushq %rbp\n  movq %rsp, %rbp\n", 33) {
        return false;
    }
    let frame_size: u32 = (((unsafe { (*target_module).value_count } * 8) + 15) / 16) * 16;
    if !append_bytes(output, capacity, &mut length, "  subq $", 8)
        || !append_u32_decimal(output, capacity, &mut length, frame_size)
        || !append_bytes(output, capacity, &mut length, ", %rsp\n", 7) {
        return false;
    }
    let mut parameter_index: u32 = 0;
    while parameter_index < function.parameter_count {
        if !append_bytes(output, capacity, &mut length, "  movl ", 7)
            || !append_argument_register(output, capacity, &mut length, abi, parameter_index)
            || !append_bytes(output, capacity, &mut length, ", -", 3)
            || !append_u32_decimal(output, capacity, &mut length, (parameter_index + 1) * 8)
            || !append_bytes(output, capacity, &mut length, "(%rbp)\n", 7) {
            unsafe { *output_length = 0; }
            return false;
        }
        parameter_index = parameter_index + 1;
    }
    let mut block_index: u32 = 0;
    let mut next_value_id: u32 = function.parameter_count + 1;
    while block_index < 3 {
        let block: TargetBlock = unsafe { *(blocks + block_index) };
        if !append_cfg_label(
            output, capacity, &mut length, function_name, function.name.length, block.id
        ) {
            unsafe { *output_length = 0; }
            return false;
        }
        if block_index == 0 {
            let mut local_index: u32 = 0;
            while local_index < block.instruction_count {
                let instruction: TargetInstruction = unsafe {
                    *(instructions + block.first_instruction + local_index)
                };
                if instruction.opcode == TargetOpcode::Compare {
                    if instruction.type_tag != TargetTypeTag::Bool
                        || instruction.result_value != next_value_id
                        || instruction.operand_count != 2
                        || instruction.first_operand > unsafe { (*target_module).operand_count }
                        || 2 > unsafe { (*target_module).operand_count } - instruction.first_operand
                        || instruction.immediate_bits < 86 || instruction.immediate_bits > 91 {
                        unsafe { *output_length = 0; }
                        return false;
                    }
                    let left: TargetOperand = unsafe { *(operands + instruction.first_operand) };
                    let right: TargetOperand = unsafe { *(operands + instruction.first_operand + 1) };
                    if left.value_id == 0 || right.value_id == 0
                        || left.value_id > function.parameter_count
                        || right.value_id > function.parameter_count
                        || (function.parameter_count == 3 && (left.value_id == 1 || right.value_id == 1))
                        || (function.parameter_count == 2 && (left.value_id < 1 || right.value_id < 1))
                        || !append_slot_load(output, capacity, &mut length, left.value_id)
                        || !append_bytes(output, capacity, &mut length, "  cmpl -", 8)
                        || !append_u32_decimal(output, capacity, &mut length, right.value_id * 8)
                        || !append_bytes(output, capacity, &mut length, "(%rbp), %eax\n", 13) {
                        unsafe { *output_length = 0; }
                        return false;
                    }
                    if instruction.immediate_bits == 86 {
                        if !append_bytes(output, capacity, &mut length, "  sete %al\n", 11) { return false; }
                    } else if instruction.immediate_bits == 87 {
                        if !append_bytes(output, capacity, &mut length, "  setne %al\n", 12) { return false; }
                    } else if instruction.immediate_bits == 88 {
                        if !append_bytes(output, capacity, &mut length, "  setb %al\n", 11) { return false; }
                    } else if instruction.immediate_bits == 89 {
                        if !append_bytes(output, capacity, &mut length, "  setbe %al\n", 12) { return false; }
                    } else if instruction.immediate_bits == 90 {
                        if !append_bytes(output, capacity, &mut length, "  seta %al\n", 11) { return false; }
                    } else if !append_bytes(output, capacity, &mut length, "  setae %al\n", 12) {
                        return false;
                    }
                    if !append_bytes(output, capacity, &mut length, "  movzbl %al, %eax\n", 19)
                        || !append_slot_store(output, capacity, &mut length, instruction.result_value) {
                        unsafe { *output_length = 0; }
                        return false;
                    }
                    next_value_id = next_value_id + 1;
                } else if instruction.opcode == TargetOpcode::CondBranch {
                    if local_index + 1 != block.instruction_count
                        || instruction.first_operand >= unsafe { (*target_module).operand_count }
                        || instruction.operand_count != 1 {
                        unsafe { *output_length = 0; }
                        return false;
                    }
                    let branch_condition: TargetOperand = unsafe { *(operands + instruction.first_operand) };
                    if branch_condition.value_id == 0 || branch_condition.value_id >= next_value_id
                        || !append_slot_load(output, capacity, &mut length, branch_condition.value_id)
                        || !append_bytes(output, capacity, &mut length, "  testl %eax, %eax\n  jne .L", 27)
                        || !append_bytes(output, capacity, &mut length, function_name, function.name.length)
                        || !append_bytes(output, capacity, &mut length, "_bb2\n  jmp .L", 13)
                        || !append_bytes(output, capacity, &mut length, function_name, function.name.length)
                        || !append_bytes(output, capacity, &mut length, "_bb3\n", 5) {
                        unsafe { *output_length = 0; }
                        return false;
                    }
                } else {
                    unsafe { *output_length = 0; }
                    return false;
                }
                local_index = local_index + 1;
            }
        } else {
            let mut local_index: u32 = 0;
            while local_index < block.instruction_count {
                let instruction: TargetInstruction = unsafe {
                    *(instructions + block.first_instruction + local_index)
                };
                if instruction.opcode == TargetOpcode::ConstInt {
                    if instruction.type_tag != TargetTypeTag::U32
                        || instruction.result_value != next_value_id
                        || instruction.immediate_bits > 4294967295
                        || instruction.operand_count != 0 || instruction.phi_input_count != 0
                        || instruction.target_count != 0
                        || !append_bytes(output, capacity, &mut length, "  movl $", 8)
                        || !append_u32_decimal(output, capacity, &mut length, instruction.immediate_bits as u32)
                        || !append_bytes(output, capacity, &mut length, ", %eax\n", 7)
                        || !append_slot_store(output, capacity, &mut length, instruction.result_value) {
                        unsafe { *output_length = 0; }
                        return false;
                    }
                    next_value_id = next_value_id + 1;
                } else if instruction.opcode == TargetOpcode::Add
                    || instruction.opcode == TargetOpcode::Sub || instruction.opcode == TargetOpcode::Mul {
                    if instruction.type_tag != TargetTypeTag::U32
                        || instruction.result_value != next_value_id || instruction.operand_count != 2
                        || instruction.first_operand > unsafe { (*target_module).operand_count }
                        || 2 > unsafe { (*target_module).operand_count } - instruction.first_operand {
                        unsafe { *output_length = 0; }
                        return false;
                    }
                    let left: TargetOperand = unsafe { *(operands + instruction.first_operand) };
                    let right: TargetOperand = unsafe { *(operands + instruction.first_operand + 1) };
                    if left.value_id == 0 || right.value_id == 0
                        || left.value_id >= next_value_id || right.value_id >= next_value_id
                        || !append_slot_load(output, capacity, &mut length, left.value_id)
                        || !append_arithmetic_mnemonic(output, capacity, &mut length, instruction.opcode)
                        || !append_bytes(output, capacity, &mut length, "-", 1)
                        || !append_u32_decimal(output, capacity, &mut length, right.value_id * 8)
                        || !append_bytes(output, capacity, &mut length, "(%rbp), %eax\n", 13)
                        || !append_slot_store(output, capacity, &mut length, instruction.result_value) {
                        unsafe { *output_length = 0; }
                        return false;
                    }
                    next_value_id = next_value_id + 1;
                } else if instruction.opcode == TargetOpcode::Return {
                    if local_index + 1 != block.instruction_count
                        || instruction.type_tag != TargetTypeTag::U32
                        || instruction.result_value != 0 || instruction.operand_count != 1
                        || instruction.first_operand >= unsafe { (*target_module).operand_count } {
                        unsafe { *output_length = 0; }
                        return false;
                    }
                    let returned: TargetOperand = unsafe { *(operands + instruction.first_operand) };
                    if returned.value_id == 0 || returned.value_id >= next_value_id
                        || !append_slot_load(output, capacity, &mut length, returned.value_id)
                        || !append_bytes(output, capacity, &mut length, "  leave\n  ret\n", 14) {
                        unsafe { *output_length = 0; }
                        return false;
                    }
                } else {
                    unsafe { *output_length = 0; }
                    return false;
                }
                local_index = local_index + 1;
            }
        }
        block_index = block_index + 1;
    }
    if next_value_id - 1 != unsafe { (*target_module).value_count } {
        unsafe { *output_length = 0; }
        return false;
    }
    unsafe { *output_length = length; }
    return true;
}

@export
@system
pub fn emit_x86_64_scalar_constant(
    source: *const u8,
    source_len: usize,
    target_module: *const TargetModule,
    functions: *const TargetFunction,
    blocks: *const TargetBlock,
    instructions: *const TargetInstruction,
    operands: *const TargetOperand,
    output: *mut u8,
    capacity: usize,
    output_length: *mut usize
) -> bool {
    if output_length == null {
        return false;
    }
    unsafe { *output_length = 0; }
    if source == null || target_module == null || functions == null || blocks == null
        || instructions == null || operands == null || output == null
        || unsafe { (*target_module).version } != 1
        || unsafe { (*target_module).function_count } != 1
        || unsafe { (*target_module).parameter_count } != 0
        || unsafe { (*target_module).block_count } != 1
        || unsafe { (*target_module).instruction_count } != 2
        || unsafe { (*target_module).operand_count } != 1 {
        return false;
    }

    let function: TargetFunction = unsafe { *functions };
    let block: TargetBlock = unsafe { *blocks };
    let constant: TargetInstruction = unsafe { *instructions };
    let ret: TargetInstruction = unsafe { *(instructions + 1) };
    let operand: TargetOperand = unsafe { *operands };
    if function.name.length == 0 || function.name.offset > source_len
        || function.name.length > source_len - function.name.offset
        || function.parameter_count != 0 || function.block_count != 1
        || function.first_block != 0 || block.id != 1
        || block.first_instruction != 0 || block.instruction_count != 2
        || constant.opcode != TargetOpcode::ConstInt
        || constant.result_value == 0 || constant.type_tag != TargetTypeTag::U32
        || constant.immediate_bits > 4294967295
        || constant.operand_count != 0
        || ret.opcode != TargetOpcode::Return || ret.operand_count != 1
        || ret.first_operand != 0 || operand.value_id != constant.result_value
        || (function.return_type != TargetTypeTag::U32
            && function.return_type != TargetTypeTag::I32) {
        return false;
    }

    let mut name_index: usize = 0;
    while name_index < function.name.length {
        let byte: u8 = unsafe { *(source + function.name.offset + name_index) };
        if !valid_symbol_byte(byte, name_index == 0) {
            return false;
        }
        name_index = name_index + 1;
    }
    let name_bytes: *const u8 = unsafe { source + function.name.offset };

    let mut length: usize = 0;
    let header: *const u8 = ".text\n.globl ";
    if !append_bytes(output, capacity, &mut length, header, 13)
        || !append_bytes(
            output, capacity, &mut length,
            name_bytes, function.name.length
        )
        || !append_bytes(output, capacity, &mut length, "\n", 1)
        || !append_bytes(
            output, capacity, &mut length,
            name_bytes, function.name.length
        )
        || !append_bytes(output, capacity, &mut length, ":\n  movl $", 10)
        || !append_u32_decimal(
            output, capacity, &mut length, constant.immediate_bits as u32
        )
        || !append_bytes(output, capacity, &mut length, ", %eax\n  ret\n", 13) {
        unsafe { *output_length = 0; }
        return false;
    }
    unsafe { *output_length = length; }
    return true;
}

// Emit one scalar function from an arbitrary ordered Target CFG. The accepted
// instructions include constants, integer arithmetic/comparisons, branches,
// conditional branches, phi merges and returns. SSA validation is performed by
// the caller; this emitter independently checks local ranges, value types and
// terminators, and supports phi edge copies on unconditional single-successor
// predecessors.
@export
@system
pub fn emit_x86_64_scalar_cfg(
    abi: u32,
    source: *const u8,
    source_len: usize,
    target_module: *const TargetModule,
    functions: *const TargetFunction,
    parameters: *const TargetParameter,
    values: *const TargetValue,
    blocks: *const TargetBlock,
    instructions: *const TargetInstruction,
    operands: *const TargetOperand,
    phi_inputs: *const TargetPhiInput,
    targets: *const u32,
    output: *mut u8,
    capacity: usize,
    output_length: *mut usize
) -> bool {
    if output_length == null { return false; }
    unsafe { *output_length = 0; }
    if (abi != 1 && abi != 2 && abi != 3) || source == null || target_module == null
        || functions == null || parameters == null || values == null || blocks == null
        || instructions == null || operands == null || targets == null || output == null
        || unsafe { (*target_module).version } != 1
        || unsafe { (*target_module).function_count } != 1
        || unsafe { (*target_module).block_count } == 0
        || unsafe { (*target_module).value_count } == 0
        || unsafe { (*target_module).value_count } > 536870911 {
        return false;
    }
    if unsafe { (*target_module).phi_input_count } != 0 && phi_inputs == null {
        return false;
    }
    let function: TargetFunction = unsafe { *functions };
    if function.return_type != TargetTypeTag::U32 || function.first_parameter != 0
        || function.parameter_count != unsafe { (*target_module).parameter_count }
        || function.first_block != 0 || function.block_count != unsafe { (*target_module).block_count }
        || function.name.length == 0 || function.name.offset > source_len
        || function.name.length > source_len - function.name.offset
        || (abi_uses_sysv_registers(abi) && function.parameter_count > 6)
        || (abi == 2 && function.parameter_count > 4) {
        return false;
    }
    if !target_module_validate_cfg(target_module, functions, parameters, values,
        blocks, instructions, operands, phi_inputs, targets) { return false; }
    let mut name_index: usize = 0;
    while name_index < function.name.length {
        if !valid_symbol_byte(unsafe { *(source + function.name.offset + name_index) }, name_index == 0) {
            return false;
        }
        name_index = name_index + 1;
    }
    let mut phi_scratch_slots: u32 = 0;
    let mut scan_block_index: u32 = 0;
    while scan_block_index < function.block_count {
        let scan_block: TargetBlock = unsafe { *(blocks + scan_block_index) };
        let mut scan_phi_index: u32 = 0;
        while scan_phi_index < scan_block.instruction_count
            && unsafe { (*(instructions + scan_block.first_instruction + scan_phi_index)).opcode } == TargetOpcode::Phi {
            scan_phi_index = scan_phi_index + 1;
        }
        if scan_phi_index > phi_scratch_slots { phi_scratch_slots = scan_phi_index; }
        scan_block_index = scan_block_index + 1;
    }
    let frame_slots: u32 = unsafe { (*target_module).value_count } + phi_scratch_slots;
    if frame_slots > 536870909 { return false; }
    let mut length: usize = 0;
    let function_name: *const u8 = unsafe { source + function.name.offset };
    if !append_bytes(output, capacity, &mut length, ".text\n.globl ", 13)
        || !append_assembly_symbol(output, capacity, &mut length, abi, function_name, function.name.length)
        || !append_bytes(output, capacity, &mut length, "\n", 1)
        || !append_assembly_symbol(output, capacity, &mut length, abi, function_name, function.name.length)
        || !append_bytes(output, capacity, &mut length, ":\n  pushq %rbp\n  movq %rsp, %rbp\n", 33) {
        return false;
    }
    let frame_size: u32 = (((frame_slots * 8) + 15) / 16) * 16;
    if !append_bytes(output, capacity, &mut length, "  subq $", 8)
        || !append_u32_decimal(output, capacity, &mut length, frame_size)
        || !append_bytes(output, capacity, &mut length, ", %rsp\n", 7) {
        return false;
    }
    let mut parameter_index: u32 = 0;
    while parameter_index < function.parameter_count {
        let parameter: TargetParameter = unsafe { *(parameters + parameter_index) };
        if parameter.value_id != parameter_index + 1
            || (parameter.type_tag != TargetTypeTag::U32 && parameter.type_tag != TargetTypeTag::Bool)
            || unsafe { (*(values + parameter.value_id as usize - 1)).id } != parameter.value_id
            || unsafe { (*(values + parameter.value_id as usize - 1)).type_tag } != parameter.type_tag
            || !append_bytes(output, capacity, &mut length, "  movl ", 7)
            || !append_argument_register(output, capacity, &mut length, abi, parameter_index)
            || !append_bytes(output, capacity, &mut length, ", -", 3)
            || !append_u32_decimal(output, capacity, &mut length, parameter.value_id * 8)
            || !append_bytes(output, capacity, &mut length, "(%rbp)\n", 7) {
            unsafe { *output_length = 0; }
            return false;
        }
        parameter_index = parameter_index + 1;
    }

    let mut next_value_id: u32 = function.parameter_count + 1;
    let mut saw_return: bool = false;
    let mut expected_first_instruction: u32 = 0;
    let mut block_index: u32 = 0;
    while block_index < function.block_count {
        let block: TargetBlock = unsafe { *(blocks + block_index) };
        if block.id != block_index + 1
            || block.instruction_count == 0
            || block.first_instruction > unsafe { (*target_module).instruction_count }
            || block.instruction_count > unsafe { (*target_module).instruction_count } - block.first_instruction {
            unsafe { *output_length = 0; }
            return false;
        }
        expected_first_instruction = expected_first_instruction + block.instruction_count;
        if !append_cfg_label(output, capacity, &mut length, function_name, function.name.length, block.id) {
            unsafe { *output_length = 0; }
            return false;
        }
        let mut local_index: u32 = 0;
        let mut saw_non_phi: bool = false;
        while local_index < block.instruction_count {
            let instruction_index: u32 = block.first_instruction + local_index;
            let instruction: TargetInstruction = unsafe { *(instructions + instruction_index) };
            let is_last: bool = local_index + 1 == block.instruction_count;
            if instruction.opcode == TargetOpcode::Phi {
                if saw_non_phi || instruction.result_value != next_value_id
                    || (instruction.type_tag != TargetTypeTag::U32
                        && instruction.type_tag != TargetTypeTag::Bool)
                    || instruction.phi_input_count == 0
                    || instruction.first_phi_input > unsafe { (*target_module).phi_input_count }
                    || instruction.phi_input_count > unsafe { (*target_module).phi_input_count } - instruction.first_phi_input
                    || instruction.operand_count != 0 || instruction.target_count != 0
                    || instruction.result_value == 0
                    || unsafe { (*(values + instruction.result_value as usize - 1)).id } != instruction.result_value
                    || unsafe { (*(values + instruction.result_value as usize - 1)).type_tag } != instruction.type_tag {
                    unsafe { *output_length = 0; }
                    return false;
                }
                let mut incoming_index: u32 = 0;
                while incoming_index < instruction.phi_input_count {
                    let incoming: TargetPhiInput = unsafe {
                        *(phi_inputs + instruction.first_phi_input + incoming_index)
                    };
                    if incoming.value_id == 0
                        || incoming.value_id > unsafe { (*target_module).value_count }
                        || incoming.block_id == 0 || incoming.block_id > function.block_count
                        || unsafe { (*(values + incoming.value_id as usize - 1)).id } != incoming.value_id
                        || unsafe { (*(values + incoming.value_id as usize - 1)).type_tag } != instruction.type_tag {
                        unsafe { *output_length = 0; }
                        return false;
                    }
                    let predecessor: TargetBlock = unsafe { *(blocks + incoming.block_id - 1) };
                    if predecessor.instruction_count == 0 {
                        unsafe { *output_length = 0; }
                        return false;
                    }
                    let terminator_index: u32 = predecessor.first_instruction + predecessor.instruction_count - 1;
                    let terminator: TargetInstruction = unsafe { *(instructions + terminator_index) };
                    if terminator.opcode != TargetOpcode::Branch || terminator.target_count != 1
                        || terminator.first_target >= unsafe { (*target_module).target_count }
                        || unsafe { *(targets + terminator.first_target) } != block.id {
                        unsafe { *output_length = 0; }
                        return false;
                    }
                    incoming_index = incoming_index + 1;
                }
                next_value_id = next_value_id + 1;
            } else if instruction.opcode == TargetOpcode::ConstInt {
                saw_non_phi = true;
                if instruction.type_tag != TargetTypeTag::U32
                    || instruction.result_value != next_value_id
                    || instruction.immediate_bits > 4294967295
                    || instruction.operand_count != 0 || instruction.phi_input_count != 0
                    || instruction.target_count != 0
                    || unsafe { (*(values + instruction.result_value as usize - 1)).id } != instruction.result_value
                    || unsafe { (*(values + instruction.result_value as usize - 1)).type_tag } != TargetTypeTag::U32
                    || !append_bytes(output, capacity, &mut length, "  movl $", 8)
                    || !append_u32_decimal(output, capacity, &mut length, instruction.immediate_bits as u32)
                    || !append_bytes(output, capacity, &mut length, ", %eax\n", 7)
                    || !append_slot_store(output, capacity, &mut length, instruction.result_value) {
                    unsafe { *output_length = 0; }
                    return false;
                }
                next_value_id = next_value_id + 1;
            } else if instruction.opcode == TargetOpcode::Add
                || instruction.opcode == TargetOpcode::Sub || instruction.opcode == TargetOpcode::Mul {
                saw_non_phi = true;
                if instruction.type_tag != TargetTypeTag::U32
                    || instruction.result_value != next_value_id || instruction.operand_count != 2
                    || instruction.first_operand > unsafe { (*target_module).operand_count }
                    || 2 > unsafe { (*target_module).operand_count } - instruction.first_operand
                    || instruction.phi_input_count != 0 || instruction.target_count != 0 {
                    unsafe { *output_length = 0; }
                    return false;
                }
                let left: TargetOperand = unsafe { *(operands + instruction.first_operand) };
                let right: TargetOperand = unsafe { *(operands + instruction.first_operand + 1) };
                if left.value_id == 0 || right.value_id == 0
                    || left.value_id >= next_value_id || right.value_id >= next_value_id
                    || unsafe { (*(values + left.value_id as usize - 1)).id } != left.value_id
                    || unsafe { (*(values + right.value_id as usize - 1)).id } != right.value_id
                    || unsafe { (*(values + left.value_id as usize - 1)).type_tag } != TargetTypeTag::U32
                    || unsafe { (*(values + right.value_id as usize - 1)).type_tag } != TargetTypeTag::U32
                    || unsafe { (*(values + instruction.result_value as usize - 1)).id } != instruction.result_value
                    || unsafe { (*(values + instruction.result_value as usize - 1)).type_tag } != TargetTypeTag::U32
                    || !append_slot_load(output, capacity, &mut length, left.value_id)
                    || !append_arithmetic_mnemonic(output, capacity, &mut length, instruction.opcode)
                    || !append_bytes(output, capacity, &mut length, "-", 1)
                    || !append_u32_decimal(output, capacity, &mut length, right.value_id * 8)
                    || !append_bytes(output, capacity, &mut length, "(%rbp), %eax\n", 13)
                    || !append_slot_store(output, capacity, &mut length, instruction.result_value) {
                    unsafe { *output_length = 0; }
                    return false;
                }
                next_value_id = next_value_id + 1;
            } else if instruction.opcode == TargetOpcode::Compare {
                if instruction.type_tag != TargetTypeTag::Bool || instruction.result_value != next_value_id
                    || instruction.operand_count != 2 || instruction.first_operand > unsafe { (*target_module).operand_count }
                    || 2 > unsafe { (*target_module).operand_count } - instruction.first_operand
                    || instruction.phi_input_count != 0 || instruction.target_count != 0
                    || instruction.immediate_bits < 86 || instruction.immediate_bits > 91
                    || unsafe { (*(values + instruction.result_value as usize - 1)).id } != instruction.result_value
                    || unsafe { (*(values + instruction.result_value as usize - 1)).type_tag } != TargetTypeTag::Bool {
                    unsafe { *output_length = 0; }
                    return false;
                }
                let left: TargetOperand = unsafe { *(operands + instruction.first_operand) };
                let right: TargetOperand = unsafe { *(operands + instruction.first_operand + 1) };
                if left.value_id == 0 || right.value_id == 0
                    || left.value_id >= next_value_id || right.value_id >= next_value_id
                    || unsafe { (*(values + left.value_id as usize - 1)).id } != left.value_id
                    || unsafe { (*(values + right.value_id as usize - 1)).id } != right.value_id
                    || unsafe { (*(values + left.value_id as usize - 1)).type_tag } != TargetTypeTag::U32
                    || unsafe { (*(values + right.value_id as usize - 1)).type_tag } != TargetTypeTag::U32
                    || !append_slot_load(output, capacity, &mut length, left.value_id)
                    || !append_bytes(output, capacity, &mut length, "  cmpl -", 8)
                    || !append_u32_decimal(output, capacity, &mut length, right.value_id * 8)
                    || !append_bytes(output, capacity, &mut length, "(%rbp), %eax\n", 13) {
                    unsafe { *output_length = 0; }
                    return false;
                }
                if instruction.immediate_bits == 86 {
                    if !append_bytes(output, capacity, &mut length, "  sete %al\n", 11) { return false; }
                } else if instruction.immediate_bits == 87 {
                    if !append_bytes(output, capacity, &mut length, "  setne %al\n", 12) { return false; }
                } else if instruction.immediate_bits == 88 {
                    if !append_bytes(output, capacity, &mut length, "  setb %al\n", 11) { return false; }
                } else if instruction.immediate_bits == 89 {
                    if !append_bytes(output, capacity, &mut length, "  setbe %al\n", 12) { return false; }
                } else if instruction.immediate_bits == 90 {
                    if !append_bytes(output, capacity, &mut length, "  seta %al\n", 11) { return false; }
                } else if !append_bytes(output, capacity, &mut length, "  setae %al\n", 12) { return false; }
                if !append_bytes(output, capacity, &mut length, "  movzbl %al, %eax\n", 19)
                    || !append_slot_store(output, capacity, &mut length, instruction.result_value) {
                    unsafe { *output_length = 0; }
                    return false;
                }
                next_value_id = next_value_id + 1;
            } else if instruction.opcode == TargetOpcode::Branch {
                saw_non_phi = true;
                if !is_last || instruction.result_value != 0 || instruction.type_tag != TargetTypeTag::Invalid
                    || instruction.operand_count != 0 || instruction.phi_input_count != 0
                    || instruction.target_count != 1
                    || instruction.first_target >= unsafe { (*target_module).target_count } {
                    unsafe { *output_length = 0; }
                    return false;
                }
                let destination: u32 = unsafe { *(targets + instruction.first_target) };
                if destination == 0 || destination > function.block_count {
                    unsafe { *output_length = 0; }
                    return false;
                }
                let destination_block: TargetBlock = unsafe { *(blocks + destination - 1) };
                let mut phi_instruction_offset: u32 = 0;
                while phi_instruction_offset < destination_block.instruction_count {
                    let phi_instruction: TargetInstruction = unsafe {
                        *(instructions + destination_block.first_instruction + phi_instruction_offset)
                    };
                    if phi_instruction.opcode != TargetOpcode::Phi { break; }
                    let mut phi_offset: u32 = 0;
                    let mut found_edge: bool = false;
                    while phi_offset < phi_instruction.phi_input_count {
                        let incoming: TargetPhiInput = unsafe {
                            *(phi_inputs + phi_instruction.first_phi_input + phi_offset)
                        };
                        if incoming.block_id == block.id {
                            if incoming.value_id == 0 || incoming.value_id >= next_value_id
                                || !append_slot_load(output, capacity, &mut length, incoming.value_id)
                                || !append_slot_store(
                                    output, capacity, &mut length,
                                    unsafe { (*target_module).value_count } + phi_instruction_offset + 1
                                ) {
                                unsafe { *output_length = 0; }
                                return false;
                            }
                            found_edge = true;
                            break;
                        }
                        phi_offset = phi_offset + 1;
                    }
                    if !found_edge {
                        unsafe { *output_length = 0; }
                        return false;
                    }
                    phi_instruction_offset = phi_instruction_offset + 1;
                }
                phi_instruction_offset = 0;
                while phi_instruction_offset < destination_block.instruction_count {
                    let phi_instruction: TargetInstruction = unsafe {
                        *(instructions + destination_block.first_instruction + phi_instruction_offset)
                    };
                    if phi_instruction.opcode != TargetOpcode::Phi { break; }
                    let temporary_value: u32 = unsafe { (*target_module).value_count }
                        + phi_instruction_offset + 1;
                    if !append_slot_load(output, capacity, &mut length, temporary_value)
                        || !append_slot_store(output, capacity, &mut length, phi_instruction.result_value) {
                        unsafe { *output_length = 0; }
                        return false;
                    }
                    phi_instruction_offset = phi_instruction_offset + 1;
                }
                if !append_bytes(output, capacity, &mut length, "  jmp ", 6)
                    || !append_cfg_label_name(output, capacity, &mut length, function_name, function.name.length, destination) {
                    unsafe { *output_length = 0; }
                    return false;
                }
            } else if instruction.opcode == TargetOpcode::CondBranch {
                saw_non_phi = true;
                if !is_last || instruction.result_value != 0
                    || (instruction.type_tag != TargetTypeTag::Bool && instruction.type_tag != TargetTypeTag::Invalid)
                    || instruction.operand_count != 1 || instruction.phi_input_count != 0
                    || instruction.target_count != 2
                    || instruction.first_operand >= unsafe { (*target_module).operand_count }
                    || instruction.first_target > unsafe { (*target_module).target_count }
                    || 2 > unsafe { (*target_module).target_count } - instruction.first_target {
                    unsafe { *output_length = 0; }
                    return false;
                }
                let condition: TargetOperand = unsafe { *(operands + instruction.first_operand) };
                let yes: u32 = unsafe { *(targets + instruction.first_target) };
                let no: u32 = unsafe { *(targets + instruction.first_target + 1) };
                if condition.value_id == 0 || condition.value_id >= next_value_id
                    || unsafe { (*(values + condition.value_id as usize - 1)).id } != condition.value_id
                    || unsafe { (*(values + condition.value_id as usize - 1)).type_tag } != TargetTypeTag::Bool
                    || yes == 0 || yes > function.block_count || no == 0 || no > function.block_count
                    || !append_slot_load(output, capacity, &mut length, condition.value_id)
                    || !append_bytes(output, capacity, &mut length, "  testl %eax, %eax\n  jne ", 25)
                    || !append_cfg_label_name(output, capacity, &mut length, function_name, function.name.length, yes)
                    || !append_bytes(output, capacity, &mut length, "  jmp ", 6)
                    || !append_cfg_label_name(output, capacity, &mut length, function_name, function.name.length, no) {
                    unsafe { *output_length = 0; }
                    return false;
                }
                let yes_block: TargetBlock = unsafe { *(blocks + yes - 1) };
                let no_block: TargetBlock = unsafe { *(blocks + no - 1) };
                if (yes_block.instruction_count != 0
                    && unsafe { (*(instructions + yes_block.first_instruction)).opcode } == TargetOpcode::Phi)
                    || (no_block.instruction_count != 0
                        && unsafe { (*(instructions + no_block.first_instruction)).opcode } == TargetOpcode::Phi) {
                    unsafe { *output_length = 0; }
                    return false;
                }
            } else if instruction.opcode == TargetOpcode::Return {
                saw_non_phi = true;
                if !is_last || instruction.type_tag != TargetTypeTag::U32 || instruction.result_value != 0
                    || instruction.operand_count != 1 || instruction.phi_input_count != 0
                    || instruction.first_operand >= unsafe { (*target_module).operand_count }
                    || instruction.target_count != 0 {
                    unsafe { *output_length = 0; }
                    return false;
                }
                let returned: TargetOperand = unsafe { *(operands + instruction.first_operand) };
                if returned.value_id == 0 || returned.value_id >= next_value_id
                    || unsafe { (*(values + returned.value_id as usize - 1)).id } != returned.value_id
                    || unsafe { (*(values + returned.value_id as usize - 1)).type_tag } != TargetTypeTag::U32
                    || !append_slot_load(output, capacity, &mut length, returned.value_id)
                    || !append_bytes(output, capacity, &mut length, "  leave\n  ret\n", 14) {
                    unsafe { *output_length = 0; }
                    return false;
                }
                saw_return = true;
            } else {
                unsafe { *output_length = 0; }
                return false;
            }
            local_index = local_index + 1;
        }
        block_index = block_index + 1;
    }
    if expected_first_instruction != unsafe { (*target_module).instruction_count }
        || next_value_id - 1 != unsafe { (*target_module).value_count } || !saw_return {
        unsafe { *output_length = 0; }
        return false;
    }
    unsafe { *output_length = length; }
    return true;
}

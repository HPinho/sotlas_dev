module sotlas::compiler::backend::x86_64_scalar;

import sotlas::compiler::backend::target_ir::*;

fn slice_names_equal(source: *const u8, off1: usize, len1: usize, off2: usize, len2: usize) -> bool {
    if len1 != len2 { return false; }
    let mut i: usize = 0;
    while i < len1 {
        if unsafe { *(source + off1 + i) != *(source + off2 + i) } { return false; }
        i = i + 1;
    }
    return true;
}

fn put_u8(output: *mut u8, capacity: usize, offset: usize, value: u8) -> bool {
    if output == null || offset >= capacity { return false; }
    unsafe { *(output + offset) = value; }
    return true;
}

fn put_u16(output: *mut u8, capacity: usize, offset: usize, value: u16) -> bool {
    return put_u8(output, capacity, offset, value as u8)
        && put_u8(output, capacity, offset + 1, (value >> 8) as u8);
}

fn put_u32(output: *mut u8, capacity: usize, offset: usize, value: u32) -> bool {
    return put_u16(output, capacity, offset, value as u16)
        && put_u16(output, capacity, offset + 2, (value >> 16) as u16);
}

fn put_u64(output: *mut u8, capacity: usize, offset: usize, value: u64) -> bool {
    return put_u32(output, capacity, offset, value as u32)
        && put_u32(output, capacity, offset + 4, (value >> 32) as u32);
}

fn get_u16(input: *const u8, length: usize, offset: usize) -> u16 {
    if input == null || offset > length || 2 > length - offset { return 0; }
    let low: u16 = unsafe { *(input + offset) } as u16;
    let high: u16 = unsafe { *(input + offset + 1) } as u16;
    return low | (high << 8);
}

fn get_u32(input: *const u8, length: usize, offset: usize) -> u32 {
    if input == null || offset > length || 4 > length - offset { return 0; }
    return (get_u16(input, length, offset) as u32)
        | ((get_u16(input, length, offset + 2) as u32) << 16);
}

fn get_u64(input: *const u8, length: usize, offset: usize) -> u64 {
    if input == null || offset > length || 8 > length - offset { return 0; }
    return (get_u32(input, length, offset) as u64)
        | ((get_u32(input, length, offset + 4) as u64) << 32);
}

fn align_to(value: usize, alignment: usize) -> usize {
    return (value + alignment - 1) / alignment * alignment;
}

fn append_object_byte(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    value: u8
) -> bool {
    if output == null || *length >= capacity { return false; }
    unsafe { *(output + *length) = value; }
    *length = *length + 1;
    return true;
}

fn append_object_u32(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    value: u32
) -> bool {
    return append_object_byte(output, capacity, length, value as u8)
        && append_object_byte(output, capacity, length, (value >> 8) as u8)
        && append_object_byte(output, capacity, length, (value >> 16) as u8)
        && append_object_byte(output, capacity, length, (value >> 24) as u8);
}

fn append_object_u64(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    value: u64
) -> bool {
    return append_object_u32(output, capacity, length, value as u32)
        && append_object_u32(output, capacity, length, (value >> 32) as u32);
}


fn append_object_slot_load(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    value_id: u32
) -> bool {
    if value_id == 0 || value_id > 536870911 { return false; }
    return append_object_byte(output, capacity, length, 139)
        && append_object_byte(output, capacity, length, 133)
        && append_object_u32(output, capacity, length, 0 as u32 - value_id * 8);
}

fn append_object_slot_store(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    value_id: u32
) -> bool {
    if value_id == 0 || value_id > 536870911 { return false; }
    return append_object_byte(output, capacity, length, 137)
        && append_object_byte(output, capacity, length, 133)
        && append_object_u32(output, capacity, length, 0 as u32 - value_id * 8);
}

fn append_object_slot_load_ptr(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    value_id: u32
) -> bool {
    if value_id == 0 || value_id > 536870911 { return false; }
    return append_object_byte(output, capacity, length, 72)
        && append_object_byte(output, capacity, length, 139)
        && append_object_byte(output, capacity, length, 141)
        && append_object_u32(output, capacity, length, 0 as u32 - value_id * 8);
}

fn append_object_slot_load_ptr_rcx(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    value_id: u32
) -> bool {
    if value_id == 0 || value_id > 536870911 { return false; }
    return append_object_byte(output, capacity, length, 72)
        && append_object_byte(output, capacity, length, 139)
        && append_object_byte(output, capacity, length, 141)
        && append_object_u32(output, capacity, length, 0 as u32 - value_id * 8);
}

fn append_object_slot_store64(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    value_id: u32
) -> bool {
    if value_id == 0 || value_id > 536870911 { return false; }
    return append_object_byte(output, capacity, length, 72)
        && append_object_byte(output, capacity, length, 137)
        && append_object_byte(output, capacity, length, 133)
        && append_object_u32(output, capacity, length, 0 as u32 - value_id * 8);
}

fn append_object_lea_rbp(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    offset_from_rbp: u32
) -> bool {
    return append_object_byte(output, capacity, length, 72)
        && append_object_byte(output, capacity, length, 141)
        && append_object_byte(output, capacity, length, 133)
        && append_object_u32(output, capacity, length, 0 as u32 - offset_from_rbp);
}

fn append_object_store_mem8(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    offset: u32
) -> bool {
    return append_object_byte(output, capacity, length, 136)
        && append_object_byte(output, capacity, length, 129)
        && append_object_u32(output, capacity, length, offset);
}

fn append_object_load_mem8(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    offset: u32
) -> bool {
    return append_object_byte(output, capacity, length, 15)
        && append_object_byte(output, capacity, length, 182)
        && append_object_byte(output, capacity, length, 129)
        && append_object_u32(output, capacity, length, offset);
}

fn append_object_store_mem16(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    offset: u32
) -> bool {
    return append_object_byte(output, capacity, length, 102)
        && append_object_byte(output, capacity, length, 137)
        && append_object_byte(output, capacity, length, 129)
        && append_object_u32(output, capacity, length, offset);
}

fn append_object_load_mem16(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    offset: u32
) -> bool {
    return append_object_byte(output, capacity, length, 15)
        && append_object_byte(output, capacity, length, 183)
        && append_object_byte(output, capacity, length, 129)
        && append_object_u32(output, capacity, length, offset);
}

fn append_object_store_mem32(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    offset: u32
) -> bool {
    return append_object_byte(output, capacity, length, 137)
        && append_object_byte(output, capacity, length, 129)
        && append_object_u32(output, capacity, length, offset);
}

fn append_object_load_mem32(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    offset: u32
) -> bool {
    return append_object_byte(output, capacity, length, 139)
        && append_object_byte(output, capacity, length, 129)
        && append_object_u32(output, capacity, length, offset);
}

fn append_object_store_mem64(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    offset: u32
) -> bool {
    return append_object_byte(output, capacity, length, 72)
        && append_object_byte(output, capacity, length, 137)
        && append_object_byte(output, capacity, length, 129)
        && append_object_u32(output, capacity, length, offset);
}

fn append_object_load_mem64(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    offset: u32
) -> bool {
    return append_object_byte(output, capacity, length, 72)
        && append_object_byte(output, capacity, length, 139)
        && append_object_byte(output, capacity, length, 129)
        && append_object_u32(output, capacity, length, offset);
}


fn append_object_sysv_parameter_store(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    value_id: u32,
    parameter_index: u32,
    is_64bit: bool
) -> bool {
    if value_id == 0 || value_id > 536870911 || parameter_index > 5 { return false; }
    if is_64bit {
        let mut rex: u8 = 72;
        if parameter_index == 4 || parameter_index == 5 { rex = 76; }
        if !append_object_byte(output, capacity, length, rex) { return false; }
    } else {
        if parameter_index == 4 || parameter_index == 5 {
            if !append_object_byte(output, capacity, length, 68) { return false; }
        }
    }
    let mut modrm: u8 = 141;
    if parameter_index == 0 { modrm = 189; }
    else if parameter_index == 1 { modrm = 181; }
    else if parameter_index == 2 { modrm = 149; }
    else if parameter_index == 3 { modrm = 141; }
    else if parameter_index == 4 { modrm = 133; }
    return append_object_byte(output, capacity, length, 137)
        && append_object_byte(output, capacity, length, modrm)
        && append_object_u32(output, capacity, length, 0 as u32 - value_id * 8);
}

// SysV arguments after the sixth register arrive at rbp + 16, in
// eight-byte slots. Normalize narrow values before entering the IR frame.
fn append_object_sysv_stack_parameter_store(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    value_id: u32,
    parameter_index: u32,
    type_tag: TargetTypeTag
) -> bool {
    if value_id == 0 || parameter_index < 6 || parameter_index >= 24
        || !object_scalar_type(type_tag) { return false; }
    let displacement: u32 = 16 + (parameter_index - 6) * 8;
    if object_type_is_64(type_tag) {
        if !append_object_byte(output, capacity, length, 72)
            || !append_object_byte(output, capacity, length, 139)
            || !append_object_byte(output, capacity, length, 133)
            || !append_object_u32(output, capacity, length, displacement) {
            return false;
        }
    } else if type_tag == TargetTypeTag::U8 || type_tag == TargetTypeTag::U16 {
        let mut movzx_opcode: u8 = 182;
        if type_tag == TargetTypeTag::U16 { movzx_opcode = 183; }
        if !append_object_byte(output, capacity, length, 15)
            || !append_object_byte(output, capacity, length, movzx_opcode)
            || !append_object_byte(output, capacity, length, 133)
            || !append_object_u32(output, capacity, length, displacement) {
            return false;
        }
    } else if !append_object_byte(output, capacity, length, 139)
        || !append_object_byte(output, capacity, length, 133)
        || !append_object_u32(output, capacity, length, displacement) {
        return false;
    }
    return append_object_slot_store_typed(output, capacity, length, value_id, type_tag);
}

fn object_value_defined_in_block(
    value_id: u32,
    block_id: u32,
    blocks: *const TargetBlock,
    instructions: *const TargetInstruction,
    block_count: u32
) -> bool {
    if value_id == 0 || block_id == 0 || block_id > block_count { return false; }
    let block: TargetBlock = unsafe { *(blocks + block_id - 1) };
    let mut index: u32 = 0;
    while index < block.instruction_count {
        let instruction: TargetInstruction = unsafe { *(instructions + block.first_instruction + index) };
        if instruction.result_value == value_id { return true; }
        index = index + 1;
    }
    return false;
}

fn put_section_header(
    output: *mut u8,
    capacity: usize,
    offset: usize,
    name: u32,
    section_type: u32,
    flags: u64,
    section_offset: u64,
    size: u64,
    link: u32,
    info: u32,
    alignment: u64,
    entry_size: u64
) -> bool {
    return put_u32(output, capacity, offset, name)
        && put_u32(output, capacity, offset + 4, section_type)
        && put_u64(output, capacity, offset + 8, flags)
        && put_u64(output, capacity, offset + 16, 0)
        && put_u64(output, capacity, offset + 24, section_offset)
        && put_u64(output, capacity, offset + 32, size)
        && put_u32(output, capacity, offset + 40, link)
        && put_u32(output, capacity, offset + 44, info)
        && put_u64(output, capacity, offset + 48, alignment)
        && put_u64(output, capacity, offset + 56, entry_size);
}

// Emit an ELF64 ET_REL object for one scalar CFG function. The initial subset
// supports U32 results, U32/Bool parameters and values, integer arithmetic,
// comparisons, branches, returns and edge copies for Phi. Object bytes and
// tables are authored here in Sotlas; no assembler or C emitter participates.
@export
@system
pub fn emit_elf64_scalar_function_object(
    source: *const u8,
    source_len: usize,
    target_module: *const TargetModule,
    functions: *const TargetFunction,
    parameters: *const TargetParameter,
    values: *const TargetValue,
    blocks: *const TargetBlock,
    instructions: *const TargetInstruction,
    operands: *const TargetOperand,
    phi_inputs: *const TargetPhiInput,
    targets: *const u32,
    output: *mut u8,
    capacity: usize,
    output_length: *mut usize
) -> bool {
    if output_length == null { return false; }
    unsafe { *output_length = 0; }
    if source == null || target_module == null || functions == null || parameters == null || values == null || blocks == null
        || instructions == null || operands == null || targets == null || output == null
        || unsafe { (*target_module).version } != 1
        || unsafe { (*target_module).function_count } != 1
        || unsafe { (*target_module).block_count } == 0
        || unsafe { (*target_module).block_count } > 128
        || unsafe { (*target_module).target_count } > 128
        || unsafe { (*target_module).instruction_count } < 2
        || unsafe { (*target_module).value_count } == 0
        || unsafe { (*target_module).value_count } > 536870910 {
        return false;
    }
    if unsafe { (*target_module).phi_input_count } != 0 && phi_inputs == null { return false; }
    if !target_module_validate_cfg(
        target_module, functions, parameters, values, blocks, instructions, operands, phi_inputs, targets
    ) { return false; }

    let function: TargetFunction = unsafe { *functions };
    let block: TargetBlock = unsafe { *blocks };
    if function.name.length == 0 || function.name.offset > source_len
        || function.name.length > source_len - function.name.offset
        || function.return_type != TargetTypeTag::U32
        || function.parameter_count != unsafe { (*target_module).parameter_count }
        || function.parameter_count > 6 || function.block_count != unsafe { (*target_module).block_count }
        || function.first_block != 0 || block.id != 1 || targets == null {
        return false;
    }
    let mut block_offsets: [usize; 128] = 0;
    let mut branch_patch_offsets: [usize; 256] = 0;
    let mut branch_patch_targets: [u32; 256] = 0;
    let mut branch_patch_count: u32 = 0;
    let mut name_index: usize = 0;
    while name_index < function.name.length {
        if !valid_symbol_byte(
            unsafe { *(source + function.name.offset + name_index) },
            name_index == 0
        ) { return false; }
        name_index = name_index + 1;
    }

    let text_offset: usize = 64;
    if capacity <= text_offset { return false; }
    let mut clear_index: usize = 0;
    while clear_index < text_offset {
        unsafe { *(output + clear_index) = 0; }
        clear_index = clear_index + 1;
    }
    let mut code_length: usize = text_offset;
    if !append_object_byte(output, capacity, &mut code_length, 85)
        || !append_object_byte(output, capacity, &mut code_length, 72)
        || !append_object_byte(output, capacity, &mut code_length, 137)
        || !append_object_byte(output, capacity, &mut code_length, 229) {
        return false;
    }
    let mut phi_scratch_slots: u32 = 0;
    let mut scan_block_index: u32 = 0;
    while scan_block_index < function.block_count {
        let scan_block: TargetBlock = unsafe { *(blocks + scan_block_index) };
        let mut scan_phi_index: u32 = 0;
        while scan_phi_index < scan_block.instruction_count
            && unsafe { (*(instructions + scan_block.first_instruction + scan_phi_index)).opcode } == TargetOpcode::Phi {
            scan_phi_index = scan_phi_index + 1;
        }
        if scan_phi_index > phi_scratch_slots { phi_scratch_slots = scan_phi_index; }
        scan_block_index = scan_block_index + 1;
    }
    let frame_slots: u32 = unsafe { (*target_module).value_count } + phi_scratch_slots;
    if frame_slots > 536870910 { return false; }
    let frame_size: u32 = (((frame_slots * 8) + 15) / 16) * 16;
    if !append_object_byte(output, capacity, &mut code_length, 72)
        || !append_object_byte(output, capacity, &mut code_length, 129)
        || !append_object_byte(output, capacity, &mut code_length, 236)
        || !append_object_u32(output, capacity, &mut code_length, frame_size) {
        return false;
    }
    let mut parameter_index: u32 = 0;
    while parameter_index < function.parameter_count {
        let parameter: TargetParameter = unsafe { *(parameters + parameter_index) };
        if parameter.value_id != parameter_index + 1
            || (parameter.type_tag != TargetTypeTag::U32 && parameter.type_tag != TargetTypeTag::Bool)
            || unsafe { (*(values + parameter.value_id as usize - 1)).id } != parameter.value_id
            || unsafe { (*(values + parameter.value_id as usize - 1)).type_tag } != parameter.type_tag
            || !append_object_sysv_parameter_store(
                output, capacity, &mut code_length, parameter.value_id, parameter_index, false
            ) {
            return false;
        }
        parameter_index = parameter_index + 1;
    }
    let instruction_count: u32 = unsafe { (*target_module).instruction_count };
    let mut next_value_id: u32 = function.parameter_count + 1;
    let mut saw_return: bool = false;
    let mut instruction_index: u32 = 0;
    let mut block_index: u32 = 0;
    let mut expected_instruction: u32 = 0;
    let mut saw_non_phi: bool = false;
    while block_index < function.block_count {
        let current_block: TargetBlock = unsafe { *(blocks + block_index) };
        if current_block.id != block_index + 1 || current_block.first_instruction != expected_instruction
            || current_block.instruction_count == 0
            || current_block.instruction_count > instruction_count - expected_instruction {
            return false;
        }
        expected_instruction = expected_instruction + current_block.instruction_count;
        block_index = block_index + 1;
    }
    if expected_instruction != instruction_count { return false; }
    block_index = 0;
    let mut active_block_end: u32 = 0;
    while instruction_index < instruction_count {
        if instruction_index == active_block_end {
            if block_index >= function.block_count { return false; }
            let current_block: TargetBlock = unsafe { *(blocks + block_index) };
            block_offsets[block_index as usize] = code_length - text_offset;
            active_block_end = current_block.first_instruction + current_block.instruction_count;
            block_index = block_index + 1;
            saw_non_phi = false;
        }
        let instruction: TargetInstruction = unsafe { *(instructions + instruction_index) };
        if instruction.opcode == TargetOpcode::Phi {
            if saw_non_phi || instruction.result_value != next_value_id
                || (instruction.type_tag != TargetTypeTag::U32 && instruction.type_tag != TargetTypeTag::Bool)
                || instruction.phi_input_count == 0
                || instruction.first_phi_input > unsafe { (*target_module).phi_input_count }
                || instruction.phi_input_count > unsafe { (*target_module).phi_input_count } - instruction.first_phi_input
                || instruction.operand_count != 0 || instruction.target_count != 0
                || instruction.result_value == 0 || instruction.result_value > unsafe { (*target_module).value_count }
                || unsafe { (*(values + instruction.result_value as usize - 1)).id } != instruction.result_value
                || unsafe { (*(values + instruction.result_value as usize - 1)).type_tag } != instruction.type_tag {
                return false;
            }
            let mut incoming_index: u32 = 0;
            while incoming_index < instruction.phi_input_count {
                let incoming: TargetPhiInput = unsafe { *(phi_inputs + instruction.first_phi_input + incoming_index) };
                if incoming.value_id == 0 || incoming.value_id > unsafe { (*target_module).value_count }
                    || incoming.block_id == 0 || incoming.block_id > function.block_count
                    || unsafe { (*(values + incoming.value_id as usize - 1)).type_tag } != instruction.type_tag {
                    return false;
                }
                incoming_index = incoming_index + 1;
            }
            next_value_id = next_value_id + 1;
        } else if instruction.opcode == TargetOpcode::ConstInt {
            saw_non_phi = true;
            if instruction.type_tag != TargetTypeTag::U32
                || instruction.result_value != next_value_id
                || instruction_index + 1 == active_block_end
                || unsafe { (*(values + instruction.result_value as usize - 1)).id } != instruction.result_value
                || unsafe { (*(values + instruction.result_value as usize - 1)).type_tag } != TargetTypeTag::U32
                || instruction.immediate_bits > 4294967295
                || instruction.operand_count != 0 || instruction.phi_input_count != 0
                || instruction.target_count != 0
                || !append_object_byte(output, capacity, &mut code_length, 184)
                || !append_object_u32(
                    output, capacity, &mut code_length, instruction.immediate_bits as u32
                )
                || !append_object_slot_store(
                    output, capacity, &mut code_length, instruction.result_value
                ) {
                return false;
            }
            next_value_id = next_value_id + 1;
        } else if instruction.opcode == TargetOpcode::Add
            || instruction.opcode == TargetOpcode::Sub
            || instruction.opcode == TargetOpcode::Mul {
            saw_non_phi = true;
            if instruction.type_tag != TargetTypeTag::U32
                || instruction.result_value != next_value_id
                || instruction_index + 1 == active_block_end
                || instruction.operand_count != 2
                || instruction.first_operand > unsafe { (*target_module).operand_count }
                || 2 > unsafe { (*target_module).operand_count } - instruction.first_operand
                || instruction.phi_input_count != 0 || instruction.target_count != 0 {
                return false;
            }
            let left: TargetOperand = unsafe { *(operands + instruction.first_operand) };
            let right: TargetOperand = unsafe { *(operands + instruction.first_operand + 1) };
            if left.value_id == 0 || right.value_id == 0
                || left.value_id >= next_value_id || right.value_id >= next_value_id
                || unsafe { (*(values + left.value_id as usize - 1)).id } != left.value_id
                || unsafe { (*(values + right.value_id as usize - 1)).id } != right.value_id
                || unsafe { (*(values + left.value_id as usize - 1)).type_tag } != TargetTypeTag::U32
                || unsafe { (*(values + right.value_id as usize - 1)).type_tag } != TargetTypeTag::U32
                || unsafe { (*(values + instruction.result_value as usize - 1)).id } != instruction.result_value
                || unsafe { (*(values + instruction.result_value as usize - 1)).type_tag } != TargetTypeTag::U32
                || !append_object_slot_load(output, capacity, &mut code_length, left.value_id) {
                return false;
            }
            if instruction.opcode == TargetOpcode::Add {
                if !append_object_byte(output, capacity, &mut code_length, 3)
                    || !append_object_byte(output, capacity, &mut code_length, 133) {
                    return false;
                }
            } else if instruction.opcode == TargetOpcode::Sub {
                if !append_object_byte(output, capacity, &mut code_length, 43)
                    || !append_object_byte(output, capacity, &mut code_length, 133) {
                    return false;
                }
            } else if !append_object_byte(output, capacity, &mut code_length, 15)
                || !append_object_byte(output, capacity, &mut code_length, 175)
                || !append_object_byte(output, capacity, &mut code_length, 133) {
                return false;
            }
            if !append_object_u32(
                output, capacity, &mut code_length, 0 as u32 - right.value_id * 8
            )
                || !append_object_slot_store(
                    output, capacity, &mut code_length, instruction.result_value
                ) {
                return false;
            }
            next_value_id = next_value_id + 1;
        } else if instruction.opcode == TargetOpcode::Compare {
            saw_non_phi = true;
            if instruction.type_tag != TargetTypeTag::Bool || instruction.result_value != next_value_id
                || instruction_index + 1 == active_block_end
                || instruction.immediate_bits < 86 || instruction.immediate_bits > 91
                || instruction.operand_count != 2
                || instruction.first_operand > unsafe { (*target_module).operand_count }
                || 2 > unsafe { (*target_module).operand_count } - instruction.first_operand
                || instruction.phi_input_count != 0 || instruction.target_count != 0 {
                return false;
            }
            let left: TargetOperand = unsafe { *(operands + instruction.first_operand) };
            let right: TargetOperand = unsafe { *(operands + instruction.first_operand + 1) };
            if left.value_id == 0 || right.value_id == 0 || left.value_id >= next_value_id || right.value_id >= next_value_id
                || unsafe { (*(values + left.value_id as usize - 1)).type_tag } != TargetTypeTag::U32
                || unsafe { (*(values + right.value_id as usize - 1)).type_tag } != TargetTypeTag::U32
                || unsafe { (*(values + instruction.result_value as usize - 1)).id } != instruction.result_value
                || unsafe { (*(values + instruction.result_value as usize - 1)).type_tag } != TargetTypeTag::Bool
                || !append_object_slot_load(output, capacity, &mut code_length, left.value_id)
                || !append_object_byte(output, capacity, &mut code_length, 59)
                || !append_object_byte(output, capacity, &mut code_length, 133)
                || !append_object_u32(output, capacity, &mut code_length, 0 as u32 - right.value_id * 8) {
                return false;
            }
            let mut setcc: u8 = 147;
            if instruction.immediate_bits == 86 { setcc = 148; }
            else if instruction.immediate_bits == 87 { setcc = 149; }
            else if instruction.immediate_bits == 88 { setcc = 146; }
            else if instruction.immediate_bits == 89 { setcc = 150; }
            else if instruction.immediate_bits == 90 { setcc = 151; }
            if !append_object_byte(output, capacity, &mut code_length, 15)
                || !append_object_byte(output, capacity, &mut code_length, setcc)
                || !append_object_byte(output, capacity, &mut code_length, 192)
                || !append_object_byte(output, capacity, &mut code_length, 15)
                || !append_object_byte(output, capacity, &mut code_length, 182)
                || !append_object_byte(output, capacity, &mut code_length, 192)
                || !append_object_slot_store(output, capacity, &mut code_length, instruction.result_value) {
                return false;
            }
            next_value_id = next_value_id + 1;
        } else if instruction.opcode == TargetOpcode::Call {
            saw_non_phi = true;
            if instruction_index + 1 == active_block_end || instruction.type_tag != TargetTypeTag::U32
                || instruction.result_value != next_value_id || instruction.result_value == 0
                || instruction.result_value > unsafe { (*target_module).value_count }
                || instruction.operand_count != function.parameter_count || instruction.operand_count > 6
                || instruction.first_operand > unsafe { (*target_module).operand_count }
                || instruction.operand_count > unsafe { (*target_module).operand_count } - instruction.first_operand
                || instruction.symbol.length != function.name.length || instruction.symbol.offset > source_len
                || instruction.symbol.length > source_len - instruction.symbol.offset
                || instruction.phi_input_count != 0 || instruction.target_count != 0
                || unsafe { (*(values + instruction.result_value as usize - 1)).id } != instruction.result_value
                || unsafe { (*(values + instruction.result_value as usize - 1)).type_tag } != TargetTypeTag::U32 {
                return false;
            }
            let mut name_index: usize = 0;
            while name_index < function.name.length {
                if unsafe { *(source + function.name.offset + name_index) }
                    != unsafe { *(source + instruction.symbol.offset + name_index) } { return false; }
                name_index = name_index + 1;
            }
            let mut argument_index: u32 = 0;
            while argument_index < instruction.operand_count {
                let argument: TargetOperand = unsafe { *(operands + instruction.first_operand + argument_index) };
                if argument.value_id == 0 || argument.value_id >= next_value_id
                    || unsafe { (*(values + argument.value_id as usize - 1)).type_tag } != TargetTypeTag::U32
                    || !append_object_slot_load(output, capacity, &mut code_length, argument.value_id) {
                    return false;
                }
                if argument_index == 0 {
                    if !append_object_byte(output, capacity, &mut code_length, 137)
                        || !append_object_byte(output, capacity, &mut code_length, 199) { return false; }
                } else if argument_index == 1 {
                    if !append_object_byte(output, capacity, &mut code_length, 137)
                        || !append_object_byte(output, capacity, &mut code_length, 198) { return false; }
                } else if argument_index == 2 {
                    if !append_object_byte(output, capacity, &mut code_length, 137)
                        || !append_object_byte(output, capacity, &mut code_length, 194) { return false; }
                } else if argument_index == 3 {
                    if !append_object_byte(output, capacity, &mut code_length, 137)
                        || !append_object_byte(output, capacity, &mut code_length, 193) { return false; }
                } else if argument_index == 4 {
                    if !append_object_byte(output, capacity, &mut code_length, 65)
                        || !append_object_byte(output, capacity, &mut code_length, 137)
                        || !append_object_byte(output, capacity, &mut code_length, 192) { return false; }
                } else if !append_object_byte(output, capacity, &mut code_length, 65)
                    || !append_object_byte(output, capacity, &mut code_length, 137)
                    || !append_object_byte(output, capacity, &mut code_length, 193) { return false; }
                argument_index = argument_index + 1;
            }
            if !append_object_byte(output, capacity, &mut code_length, 232) { return false; }
            let call_displacement_offset: usize = code_length;
            if !append_object_u32(output, capacity, &mut code_length,
                    text_offset as u32 - (call_displacement_offset as u32 + 4))
                || !append_object_slot_store(output, capacity, &mut code_length, instruction.result_value) {
                return false;
            }
            next_value_id = next_value_id + 1;
        } else if instruction.opcode == TargetOpcode::Branch {
            saw_non_phi = true;
            if instruction_index + 1 != active_block_end || instruction.result_value != 0
                || instruction.type_tag != TargetTypeTag::Invalid || instruction.operand_count != 0
                || instruction.target_count != 1
                || instruction.first_target >= unsafe { (*target_module).target_count }
                || branch_patch_count >= 256 { return false; }
            let destination: u32 = unsafe { *(targets + instruction.first_target) };
            if destination == 0 || destination > function.block_count { return false; }
            let destination_block: TargetBlock = unsafe { *(blocks + destination - 1) };
            let mut phi_index: u32 = 0;
            while phi_index < destination_block.instruction_count {
                let phi: TargetInstruction = unsafe { *(instructions + destination_block.first_instruction + phi_index) };
                if phi.opcode != TargetOpcode::Phi { break; }
                let mut incoming_index: u32 = 0;
                let mut found: bool = false;
                while incoming_index < phi.phi_input_count {
                    let incoming: TargetPhiInput = unsafe { *(phi_inputs + phi.first_phi_input + incoming_index) };
                    if incoming.block_id == block_index {
                        if incoming.value_id == 0 || incoming.value_id >= next_value_id
                            || !append_object_slot_load(output, capacity, &mut code_length, incoming.value_id)
                            || !append_object_slot_store(output, capacity, &mut code_length,
                                unsafe { (*target_module).value_count } + phi_index + 1) { return false; }
                        found = true;
                        break;
                    }
                    incoming_index = incoming_index + 1;
                }
                if !found { return false; }
                phi_index = phi_index + 1;
            }
            phi_index = 0;
            while phi_index < destination_block.instruction_count {
                let phi: TargetInstruction = unsafe { *(instructions + destination_block.first_instruction + phi_index) };
                if phi.opcode != TargetOpcode::Phi { break; }
                if !append_object_slot_load(output, capacity, &mut code_length,
                        unsafe { (*target_module).value_count } + phi_index + 1)
                    || !append_object_slot_store(output, capacity, &mut code_length, phi.result_value) { return false; }
                phi_index = phi_index + 1;
            }
            if !append_object_byte(output, capacity, &mut code_length, 233) { return false; }
            branch_patch_offsets[branch_patch_count as usize] = code_length;
            branch_patch_targets[branch_patch_count as usize] = destination;
            branch_patch_count = branch_patch_count + 1;
            if !append_object_u32(output, capacity, &mut code_length, 0) { return false; }
        } else if instruction.opcode == TargetOpcode::CondBranch {
            saw_non_phi = true;
            if instruction_index + 1 != active_block_end || instruction.type_tag != TargetTypeTag::Bool
                || instruction.result_value != 0 || instruction.operand_count != 1
                || instruction.first_operand >= unsafe { (*target_module).operand_count }
                || instruction.target_count != 2 || instruction.first_target > unsafe { (*target_module).target_count }
                || 2 > unsafe { (*target_module).target_count } - instruction.first_target
                || branch_patch_count > 254 { return false; }
            let condition: TargetOperand = unsafe { *(operands + instruction.first_operand) };
            let yes: u32 = unsafe { *(targets + instruction.first_target) };
            let no: u32 = unsafe { *(targets + instruction.first_target + 1) };
            let yes_block: TargetBlock = unsafe { *(blocks + yes - 1) };
            let no_block: TargetBlock = unsafe { *(blocks + no - 1) };
            if condition.value_id == 0 || condition.value_id >= next_value_id || yes == 0 || no == 0
                || yes > function.block_count || no > function.block_count
                || (yes_block.instruction_count != 0 && unsafe { (*(instructions + yes_block.first_instruction)).opcode } == TargetOpcode::Phi)
                || (no_block.instruction_count != 0 && unsafe { (*(instructions + no_block.first_instruction)).opcode } == TargetOpcode::Phi)
                || unsafe { (*(values + condition.value_id as usize - 1)).type_tag } != TargetTypeTag::Bool
                || !append_object_slot_load(output, capacity, &mut code_length, condition.value_id)
                || !append_object_byte(output, capacity, &mut code_length, 133)
                || !append_object_byte(output, capacity, &mut code_length, 192)
                || !append_object_byte(output, capacity, &mut code_length, 15)
                || !append_object_byte(output, capacity, &mut code_length, 133) { return false; }
            branch_patch_offsets[branch_patch_count as usize] = code_length;
            branch_patch_targets[branch_patch_count as usize] = yes;
            branch_patch_count = branch_patch_count + 1;
            if !append_object_u32(output, capacity, &mut code_length, 0)
                || !append_object_byte(output, capacity, &mut code_length, 233) { return false; }
            branch_patch_offsets[branch_patch_count as usize] = code_length;
            branch_patch_targets[branch_patch_count as usize] = no;
            branch_patch_count = branch_patch_count + 1;
            if !append_object_u32(output, capacity, &mut code_length, 0) { return false; }
        } else if instruction.opcode == TargetOpcode::Return {
            saw_non_phi = true;
            if instruction_index + 1 != active_block_end || instruction.type_tag != TargetTypeTag::U32
                || instruction.result_value != 0 || instruction.operand_count != 1
                || instruction.first_operand >= unsafe { (*target_module).operand_count }
                || instruction.phi_input_count != 0 || instruction.target_count != 0 {
                return false;
            }
            let returned: TargetOperand = unsafe {
                *(operands + instruction.first_operand)
            };
            if returned.value_id == 0 || returned.value_id >= next_value_id
                || unsafe { (*(values + returned.value_id as usize - 1)).id } != returned.value_id
                || unsafe { (*(values + returned.value_id as usize - 1)).type_tag } != TargetTypeTag::U32
                || !append_object_slot_load(
                    output, capacity, &mut code_length, returned.value_id
                )
                || !append_object_byte(output, capacity, &mut code_length, 201)
                || !append_object_byte(output, capacity, &mut code_length, 195) {
                return false;
            }
            saw_return = true;
        } else {
            return false;
        }
        instruction_index = instruction_index + 1;
    }
    if !saw_return || next_value_id - 1 != unsafe { (*target_module).value_count } {
        return false;
    }
    let mut patch_index: u32 = 0;
    while patch_index < branch_patch_count {
        let destination: u32 = branch_patch_targets[patch_index as usize];
        let patch_offset: usize = branch_patch_offsets[patch_index as usize];
        let displacement: u32 = (text_offset + block_offsets[destination as usize - 1]) as u32
            - (patch_offset as u32 + 4);
        if !put_u32(output, capacity, patch_offset, displacement) { return false; }
        patch_index = patch_index + 1;
    }
    let text_size: usize = code_length - text_offset;
    let name_length: usize = function.name.length;
    if name_length > 4294967290 { return false; }
    let symtab_offset: usize = align_to(text_offset + text_size, 8);
    let strtab_offset: usize = symtab_offset + 48;
    let strtab_size: usize = name_length + 2;
    let shstrtab_offset: usize = strtab_offset + strtab_size;
    let shstrtab_size: usize = 50;
    let abi_note_offset: usize = align_to(shstrtab_offset + shstrtab_size, 4);
    let section_header_offset: usize = align_to(abi_note_offset + 24, 8);
    let file_size: usize = section_header_offset + 6 * 64;
    if file_size > capacity { return false; }
    let mut bool_argument_mask: u32 = 0;
    let mut abi_parameter_index: u32 = 0;
    while abi_parameter_index < function.parameter_count {
        if unsafe { (*(parameters + abi_parameter_index)).type_tag } == TargetTypeTag::Bool {
            bool_argument_mask = bool_argument_mask | ((1 as u32) << abi_parameter_index);
        }
        abi_parameter_index = abi_parameter_index + 1;
    }
    let abi_descriptor: u32 = function.parameter_count | (bool_argument_mask << 8);
    clear_index = align_to(text_offset + text_size, 8);
    while clear_index < file_size {
        unsafe { *(output + clear_index) = 0; }
        clear_index = clear_index + 1;
    }

    if !put_u8(output, capacity, 0, 127)
        || !put_u8(output, capacity, 1, 69)
        || !put_u8(output, capacity, 2, 76)
        || !put_u8(output, capacity, 3, 70)
        || !put_u8(output, capacity, 4, 2)
        || !put_u8(output, capacity, 5, 1)
        || !put_u8(output, capacity, 6, 1)
        || !put_u16(output, capacity, 16, 1)
        || !put_u16(output, capacity, 18, 62)
        || !put_u32(output, capacity, 20, 1)
        || !put_u64(output, capacity, 40, section_header_offset as u64)
        || !put_u16(output, capacity, 52, 64)
        || !put_u16(output, capacity, 58, 64)
        || !put_u16(output, capacity, 60, 6)
        || !put_u16(output, capacity, 62, 4)
        || !put_u32(output, capacity, symtab_offset + 24, 1)
        || !put_u8(output, capacity, symtab_offset + 28, 18)
        || !put_u16(output, capacity, symtab_offset + 30, 1)
        || !put_u64(output, capacity, symtab_offset + 40, text_size as u64)
        || !put_u8(output, capacity, strtab_offset, 0)
        || !put_u8(output, capacity, strtab_offset + name_length + 1, 0)
        || !put_section_header(output, capacity, section_header_offset + 64,
            1, 1, 6, text_offset as u64, text_size as u64, 0, 0, 16, 0)
        || !put_section_header(output, capacity, section_header_offset + 128,
            7, 2, 0, symtab_offset as u64, 48, 3, 1, 8, 24)
        || !put_section_header(output, capacity, section_header_offset + 192,
            15, 3, 0, strtab_offset as u64, strtab_size as u64, 0, 0, 1, 0)
        || !put_section_header(output, capacity, section_header_offset + 256,
            23, 3, 0, shstrtab_offset as u64, shstrtab_size as u64, 0, 0, 1, 0)
        || !put_section_header(output, capacity, section_header_offset + 320,
            33, 7, 0, abi_note_offset as u64, 24, 0, 0, 4, 0)
        || !put_u32(output, capacity, abi_note_offset, 7)
        || !put_u32(output, capacity, abi_note_offset + 4, 4)
        || !put_u32(output, capacity, abi_note_offset + 8, 1)
        || !put_u8(output, capacity, abi_note_offset + 12, 83)
        || !put_u8(output, capacity, abi_note_offset + 13, 79)
        || !put_u8(output, capacity, abi_note_offset + 14, 84)
        || !put_u8(output, capacity, abi_note_offset + 15, 76)
        || !put_u8(output, capacity, abi_note_offset + 16, 65)
        || !put_u8(output, capacity, abi_note_offset + 17, 83)
        || !put_u32(output, capacity, abi_note_offset + 20, abi_descriptor) {
        return false;
    }

    let mut copy_index: usize = 0;
    while copy_index < name_length {
        unsafe {
            *(output + strtab_offset + 1 + copy_index) =
                *(source + function.name.offset + copy_index);
        }
        copy_index = copy_index + 1;
    }
    let section_names: *const u8 = ".text\x00.symtab\x00.strtab\x00.shstrtab\x00.note.sotlas.abi\x00";
    copy_index = 0;
    while copy_index < 49 {
        unsafe { *(output + shstrtab_offset + 1 + copy_index) = *(section_names + copy_index); }
        copy_index = copy_index + 1;
    }
    unsafe { *output_length = file_size; }
    return true;
}

// Emit an ELF64 object containing multiple zero-argument U32 scalar functions.
// Each function has one block and can use constants, arithmetic, calls to
// earlier functions in the same module, and a return. Internal call offsets
// are resolved while the object is written, so no external relocation is needed.
@export
@system
pub fn emit_elf64_scalar_module_object(
    source: *const u8,
    source_len: usize,
    target_module: *const TargetModule,
    functions: *const TargetFunction,
    parameters: *const TargetParameter,
    values: *const TargetValue,
    blocks: *const TargetBlock,
    instructions: *const TargetInstruction,
    operands: *const TargetOperand,
    output: *mut u8,
    capacity: usize,
    output_length: *mut usize
) -> bool {
    if output_length == null { return false; }
    unsafe { *output_length = 0; }
    if source == null || target_module == null || functions == null || parameters == null || values == null
        || blocks == null || instructions == null || operands == null || output == null
        || unsafe { (*target_module).version } != 1
        || unsafe { (*target_module).function_count } < 2
        || unsafe { (*target_module).function_count } > 128
        || unsafe { (*target_module).block_count } != unsafe { (*target_module).function_count }
        || unsafe { (*target_module).instruction_count } < unsafe { (*target_module).function_count }
        || unsafe { (*target_module).value_count } == 0
        || unsafe { (*target_module).value_count } > 536870910 {
        return false;
    }
    let function_count: u32 = unsafe { (*target_module).function_count };
    let text_offset: usize = 64;
    let mut function_offsets: [usize; 128] = 0;
    let mut function_sizes: [usize; 128] = 0;
    let mut text_size: usize = 0;
    let mut strings_size: usize = 1;
    let mut value_id: u32 = 1;
    let mut parameter_cursor: u32 = 0;
    let mut operand_cursor: u32 = 0;
    let mut instruction_cursor: u32 = 0;
    let mut function_index: u32 = 0;
    while function_index < function_count {
        let function: TargetFunction = unsafe { *(functions + function_index) };
        let block: TargetBlock = unsafe { *(blocks + function_index) };
        if function.name.length == 0 || function.name.offset > source_len
            || function.name.length > source_len - function.name.offset
            || function.return_type != TargetTypeTag::U32 || function.parameter_count > 6
            || function.first_parameter != parameter_cursor
            || function.first_parameter > unsafe { (*target_module).parameter_count }
            || function.parameter_count > unsafe { (*target_module).parameter_count } - function.first_parameter
            || function.first_block != function_index
            || function.block_count != 1 || block.id != function_index + 1
            || block.first_instruction != instruction_cursor || block.instruction_count < 2
            || block.first_instruction > unsafe { (*target_module).instruction_count }
            || block.instruction_count > unsafe { (*target_module).instruction_count } - block.first_instruction {
            return false;
        }
        function_offsets[function_index as usize] = text_size;
        let function_first_value: u32 = value_id;
        text_size = text_size + 11;
        let mut parameter_index: u32 = 0;
        while parameter_index < function.parameter_count {
            let parameter: TargetParameter = unsafe {
                *(parameters + function.first_parameter + parameter_index)
            };
            if parameter.value_id != value_id || parameter.type_tag != TargetTypeTag::U32
                || value_id > unsafe { (*target_module).value_count } {
                return false;
            }
            let parameter_value: TargetValue = unsafe { *(values + value_id as usize - 1) };
            if parameter_value.id != value_id || parameter_value.type_tag != TargetTypeTag::U32 {
                return false;
            }
            value_id = value_id + 1;
            if parameter_index >= 4 {
                text_size = text_size + 7;
            } else {
                text_size = text_size + 6;
            }
            parameter_index = parameter_index + 1;
        }
        parameter_cursor = parameter_cursor + function.parameter_count;
        let mut name_index: usize = 0;
        while name_index < function.name.length {
            if !valid_symbol_byte(
                unsafe { *(source + function.name.offset + name_index) },
                name_index == 0
            ) { return false; }
            name_index = name_index + 1;
        }
        let mut prior_index: u32 = 0;
        while prior_index < function_index {
            let prior: TargetFunction = unsafe { *(functions + prior_index) };
            if prior.name.length == function.name.length
                && prior.name.offset <= source_len
                && prior.name.length <= source_len - prior.name.offset {
                let mut same: bool = true;
                name_index = 0;
                while name_index < function.name.length {
                    if unsafe { *(source + prior.name.offset + name_index) }
                        != unsafe { *(source + function.name.offset + name_index) } {
                        same = false;
                        break;
                    }
                    name_index = name_index + 1;
                }
                if same { return false; }
            }
            prior_index = prior_index + 1;
        }
        let mut local_instruction: u32 = 0;
        let mut saw_return: bool = false;
        while local_instruction < block.instruction_count {
            let instruction: TargetInstruction = unsafe {
                *(instructions + block.first_instruction + local_instruction)
            };
            if instruction.phi_input_count != 0 || instruction.target_count != 0 {
                return false;
            }
            if instruction.opcode == TargetOpcode::ConstInt {
                if saw_return || instruction.type_tag != TargetTypeTag::U32
                    || instruction.result_value != value_id
                    || value_id > unsafe { (*target_module).value_count }
                    || instruction.immediate_bits > 4294967295
                    || instruction.operand_count != 0 {
                    return false;
                }
                let value: TargetValue = unsafe { *(values + value_id as usize - 1) };
                if value.id != value_id || value.type_tag != TargetTypeTag::U32 { return false; }
                value_id = value_id + 1;
                text_size = text_size + 11;
            } else if instruction.opcode == TargetOpcode::Add
                || instruction.opcode == TargetOpcode::Sub
                || instruction.opcode == TargetOpcode::Mul {
                if saw_return || instruction.type_tag != TargetTypeTag::U32
                    || instruction.result_value != value_id
                    || value_id > unsafe { (*target_module).value_count }
                    || instruction.operand_count != 2
                    || instruction.first_operand != operand_cursor
                    || instruction.first_operand > unsafe { (*target_module).operand_count }
                    || 2 > unsafe { (*target_module).operand_count } - instruction.first_operand {
                    return false;
                }
                let left: TargetOperand = unsafe { *(operands + operand_cursor) };
                let right: TargetOperand = unsafe { *(operands + operand_cursor + 1) };
                if left.value_id < function_first_value || left.value_id >= value_id
                    || right.value_id < function_first_value || right.value_id >= value_id
                    || unsafe { (*(values + left.value_id as usize - 1)).type_tag } != TargetTypeTag::U32
                    || unsafe { (*(values + right.value_id as usize - 1)).type_tag } != TargetTypeTag::U32 {
                    return false;
                }
                let value: TargetValue = unsafe { *(values + value_id as usize - 1) };
                if value.id != value_id || value.type_tag != TargetTypeTag::U32 { return false; }
                operand_cursor = operand_cursor + 2;
                value_id = value_id + 1;
                if instruction.opcode == TargetOpcode::Mul {
                    text_size = text_size + 19;
                } else {
                    text_size = text_size + 18;
                }
            } else if instruction.opcode == TargetOpcode::Call {
                if saw_return || instruction.type_tag != TargetTypeTag::U32
                    || instruction.result_value != value_id
                    || value_id > unsafe { (*target_module).value_count }
                    || instruction.first_operand != operand_cursor
                    || instruction.operand_count > 6
                    || instruction.first_operand > unsafe { (*target_module).operand_count }
                    || instruction.operand_count > unsafe { (*target_module).operand_count } - instruction.first_operand
                    || instruction.symbol.length == 0 || instruction.symbol.offset > source_len
                    || instruction.symbol.length > source_len - instruction.symbol.offset {
                    return false;
                }
                let mut callee_index: u32 = 0;
                let mut callee_found: bool = false;
                while callee_index < function_count {
                    let callee: TargetFunction = unsafe { *(functions + callee_index) };
                    if callee.name.length == instruction.symbol.length
                        && callee.name.offset <= source_len
                        && callee.name.length <= source_len - callee.name.offset
                        && callee.first_parameter <= unsafe { (*target_module).parameter_count }
                        && callee.parameter_count <= unsafe { (*target_module).parameter_count } - callee.first_parameter {
                        let mut symbol_index: usize = 0;
                        let mut names_match: bool = true;
                        while symbol_index < instruction.symbol.length {
                            if unsafe { *(source + callee.name.offset + symbol_index) }
                                != unsafe { *(source + instruction.symbol.offset + symbol_index) } {
                                names_match = false;
                                break;
                            }
                            symbol_index = symbol_index + 1;
                        }
                        if names_match {
                            if callee.parameter_count != instruction.operand_count
                                || callee.parameter_count > unsafe { (*target_module).parameter_count } - callee.first_parameter {
                                return false;
                            }
                            let mut signature_index: u32 = 0;
                            while signature_index < callee.parameter_count {
                                let parameter: TargetParameter = unsafe {
                                    *(parameters + callee.first_parameter + signature_index)
                                };
                                let argument: TargetOperand = unsafe {
                                    *(operands + operand_cursor + signature_index)
                                };
                                if parameter.type_tag != TargetTypeTag::U32
                                    || argument.value_id < function_first_value
                                    || argument.value_id >= value_id
                                    || unsafe { (*(values + argument.value_id as usize - 1)).type_tag } != TargetTypeTag::U32 {
                                    return false;
                                }
                                signature_index = signature_index + 1;
                            }
                            callee_found = true;
                            break;
                        }
                    }
                    callee_index = callee_index + 1;
                }
                if !callee_found { return false; }
                let value: TargetValue = unsafe { *(values + value_id as usize - 1) };
                if value.id != value_id || value.type_tag != TargetTypeTag::U32 { return false; }
                let mut argument_index: u32 = 0;
                while argument_index < instruction.operand_count {
                    let argument: TargetOperand = unsafe { *(operands + operand_cursor + argument_index) };
                    if argument.value_id < function_first_value || argument.value_id >= value_id
                        || unsafe { (*(values + argument.value_id as usize - 1)).type_tag } != TargetTypeTag::U32 {
                        return false;
                    }
                    argument_index = argument_index + 1;
                }
                operand_cursor = operand_cursor + instruction.operand_count;
                value_id = value_id + 1;
                argument_index = 0;
                let mut call_argument_size: usize = 0;
                while argument_index < instruction.operand_count {
                    if argument_index >= 4 {
                        call_argument_size = call_argument_size + 9;
                    } else {
                        call_argument_size = call_argument_size + 8;
                    }
                    argument_index = argument_index + 1;
                }
                text_size = text_size + 11 + call_argument_size;
            } else if instruction.opcode == TargetOpcode::Return {
                if saw_return || local_instruction + 1 != block.instruction_count
                    || instruction.type_tag != TargetTypeTag::U32 || instruction.result_value != 0
                    || instruction.operand_count != 1 || instruction.first_operand != operand_cursor
                    || instruction.first_operand >= unsafe { (*target_module).operand_count } {
                    return false;
                }
                let returned: TargetOperand = unsafe { *(operands + operand_cursor) };
                if returned.value_id < function_first_value || returned.value_id >= value_id
                    || unsafe { (*(values + returned.value_id as usize - 1)).type_tag } != TargetTypeTag::U32 {
                    return false;
                }
                operand_cursor = operand_cursor + 1;
                text_size = text_size + 8;
                saw_return = true;
            } else {
                return false;
            }
            instruction_cursor = instruction_cursor + 1;
            local_instruction = local_instruction + 1;
        }
        if !saw_return { return false; }
        function_sizes[function_index as usize] = text_size - function_offsets[function_index as usize];
        strings_size = strings_size + function.name.length + 1;
        function_index = function_index + 1;
    }
    if instruction_cursor != unsafe { (*target_module).instruction_count }
        || parameter_cursor != unsafe { (*target_module).parameter_count }
        || operand_cursor != unsafe { (*target_module).operand_count }
        || value_id - 1 != unsafe { (*target_module).value_count } {
        return false;
    }

    let symbol_count: usize = function_count as usize + 1;
    if symbol_count > 178956970 { return false; }
    let symtab_offset: usize = align_to(text_offset + text_size, 8);
    let symtab_size: usize = symbol_count * 24;
    let strtab_offset: usize = symtab_offset + symtab_size;
    let shstrtab_offset: usize = strtab_offset + strings_size;
    let shstrtab_size: usize = 50;
    let abi_note_offset: usize = align_to(shstrtab_offset + shstrtab_size, 4);
    let section_header_offset: usize = align_to(abi_note_offset + 24, 8);
    let file_size: usize = section_header_offset + 6 * 64;
    if file_size > capacity { return false; }
    let mut clear_index: usize = 0;
    while clear_index < file_size {
        unsafe { *(output + clear_index) = 0; }
        clear_index = clear_index + 1;
    }
    if !put_u8(output, capacity, 0, 127) || !put_u8(output, capacity, 1, 69)
        || !put_u8(output, capacity, 2, 76) || !put_u8(output, capacity, 3, 70)
        || !put_u8(output, capacity, 4, 2) || !put_u8(output, capacity, 5, 1)
        || !put_u8(output, capacity, 6, 1) || !put_u16(output, capacity, 16, 1)
        || !put_u16(output, capacity, 18, 62) || !put_u32(output, capacity, 20, 1)
        || !put_u64(output, capacity, 40, section_header_offset as u64)
        || !put_u16(output, capacity, 52, 64) || !put_u16(output, capacity, 58, 64)
        || !put_u16(output, capacity, 60, 6) || !put_u16(output, capacity, 62, 4)
        || !put_section_header(output, capacity, section_header_offset + 64,
            1, 1, 6, text_offset as u64, text_size as u64, 0, 0, 16, 0)
        || !put_section_header(output, capacity, section_header_offset + 128,
            7, 2, 0, symtab_offset as u64, symtab_size as u64, 3, 1, 8, 24)
        || !put_section_header(output, capacity, section_header_offset + 192,
            15, 3, 0, strtab_offset as u64, strings_size as u64, 0, 0, 1, 0)
        || !put_section_header(output, capacity, section_header_offset + 256,
            23, 3, 0, shstrtab_offset as u64, shstrtab_size as u64, 0, 0, 1, 0)
        || !put_section_header(output, capacity, section_header_offset + 320,
            33, 7, 0, abi_note_offset as u64, 24, 0, 0, 4, 0)
        || !put_u32(output, capacity, abi_note_offset, 7)
        || !put_u32(output, capacity, abi_note_offset + 4, 4)
        || !put_u32(output, capacity, abi_note_offset + 8, 1)
        || !put_u8(output, capacity, abi_note_offset + 12, 83)
        || !put_u8(output, capacity, abi_note_offset + 13, 79)
        || !put_u8(output, capacity, abi_note_offset + 14, 84)
        || !put_u8(output, capacity, abi_note_offset + 15, 76)
        || !put_u8(output, capacity, abi_note_offset + 16, 65)
        || !put_u8(output, capacity, abi_note_offset + 17, 83)
        || !put_u32(output, capacity, abi_note_offset + 20,
            unsafe { (*functions).parameter_count }) {
        return false;
    }
    let section_names: *const u8 = ".text\x00.symtab\x00.strtab\x00.shstrtab\x00.note.sotlas.abi\x00";
    let mut copy_index: usize = 0;
    while copy_index < 49 {
        unsafe { *(output + shstrtab_offset + 1 + copy_index) = *(section_names + copy_index); }
        copy_index = copy_index + 1;
    }
    let mut string_cursor: usize = 1;
    let frame_size: u32 = (((unsafe { (*target_module).value_count } as u64 * 8) + 15) / 16 * 16) as u32;
    let mut code_cursor: usize = text_offset;
    function_index = 0;
    while function_index < function_count {
        let function: TargetFunction = unsafe { *(functions + function_index) };
        let function_code_start: usize = code_cursor;
        let symbol_offset: usize = symtab_offset + (function_index as usize + 1) * 24;
        if !put_u32(output, capacity, symbol_offset, string_cursor as u32)
            || !put_u8(output, capacity, symbol_offset + 4, 18)
            || !put_u16(output, capacity, symbol_offset + 6, 1)
            || !put_u64(output, capacity, symbol_offset + 8, function_offsets[function_index as usize] as u64) {
            return false;
        }
        let mut name_index: usize = 0;
        while name_index < function.name.length {
            unsafe {
                *(output + strtab_offset + string_cursor + name_index) =
                    *(source + function.name.offset + name_index);
            }
            name_index = name_index + 1;
        }
        unsafe { *(output + strtab_offset + string_cursor + function.name.length) = 0; }
        if !append_object_byte(output, capacity, &mut code_cursor, 85)
            || !append_object_byte(output, capacity, &mut code_cursor, 72)
            || !append_object_byte(output, capacity, &mut code_cursor, 137)
            || !append_object_byte(output, capacity, &mut code_cursor, 229)
            || !append_object_byte(output, capacity, &mut code_cursor, 72)
            || !append_object_byte(output, capacity, &mut code_cursor, 129)
            || !append_object_byte(output, capacity, &mut code_cursor, 236)
            || !append_object_u32(output, capacity, &mut code_cursor, frame_size) {
            return false;
        }
        let mut parameter_index: u32 = 0;
        while parameter_index < function.parameter_count {
            let parameter: TargetParameter = unsafe {
                *(parameters + function.first_parameter + parameter_index)
            };
            if !append_object_sysv_parameter_store(
                output, capacity, &mut code_cursor, parameter.value_id, parameter_index, false
            ) {
                return false;
            }
            parameter_index = parameter_index + 1;
        }
        let block: TargetBlock = unsafe { *(blocks + function_index) };
        let local_instruction: u32 = 0;
        let mut instruction_offset: u32 = 0;
        while instruction_offset < block.instruction_count {
            let instruction: TargetInstruction = unsafe {
                *(instructions + block.first_instruction + instruction_offset)
            };
            if instruction.opcode == TargetOpcode::ConstInt {
                if !append_object_byte(output, capacity, &mut code_cursor, 184)
                    || !append_object_u32(output, capacity, &mut code_cursor, instruction.immediate_bits as u32)
                    || !append_object_slot_store(output, capacity, &mut code_cursor, instruction.result_value) {
                    return false;
                }
            } else if instruction.opcode == TargetOpcode::Add
                || instruction.opcode == TargetOpcode::Sub
                || instruction.opcode == TargetOpcode::Mul {
                let left: TargetOperand = unsafe { *(operands + instruction.first_operand) };
                let right: TargetOperand = unsafe { *(operands + instruction.first_operand + 1) };
                if !append_object_slot_load(output, capacity, &mut code_cursor, left.value_id) {
                    return false;
                }
                if instruction.opcode == TargetOpcode::Add {
                    if !append_object_byte(output, capacity, &mut code_cursor, 3)
                        || !append_object_byte(output, capacity, &mut code_cursor, 133) { return false; }
                } else if instruction.opcode == TargetOpcode::Sub {
                    if !append_object_byte(output, capacity, &mut code_cursor, 43)
                        || !append_object_byte(output, capacity, &mut code_cursor, 133) { return false; }
                } else if !append_object_byte(output, capacity, &mut code_cursor, 15)
                    || !append_object_byte(output, capacity, &mut code_cursor, 175)
                    || !append_object_byte(output, capacity, &mut code_cursor, 133) {
                    return false;
                }
                if !append_object_u32(output, capacity, &mut code_cursor, 0 as u32 - right.value_id * 8)
                    || !append_object_slot_store(output, capacity, &mut code_cursor, instruction.result_value) {
                    return false;
                }
            } else if instruction.opcode == TargetOpcode::Call {
                let mut callee_index: u32 = 0;
                while callee_index < function_count {
                    let callee: TargetFunction = unsafe { *(functions + callee_index) };
                    let mut symbol_index: usize = 0;
                    let mut names_match: bool = callee.name.length == instruction.symbol.length;
                    while names_match && symbol_index < instruction.symbol.length {
                        if unsafe { *(source + callee.name.offset + symbol_index) }
                            != unsafe { *(source + instruction.symbol.offset + symbol_index) } {
                            names_match = false;
                        }
                        symbol_index = symbol_index + 1;
                    }
                    if names_match { break; }
                    callee_index = callee_index + 1;
                }
                if callee_index >= function_count { return false; }
                let mut argument_index: u32 = 0;
                while argument_index < instruction.operand_count {
                    let argument: TargetOperand = unsafe {
                        *(operands + instruction.first_operand + argument_index)
                    };
                    if !append_object_slot_load(output, capacity, &mut code_cursor, argument.value_id) {
                        return false;
                    }
                    if argument_index == 0 {
                        if !append_object_byte(output, capacity, &mut code_cursor, 137)
                            || !append_object_byte(output, capacity, &mut code_cursor, 199) { return false; }
                    } else if argument_index == 1 {
                        if !append_object_byte(output, capacity, &mut code_cursor, 137)
                            || !append_object_byte(output, capacity, &mut code_cursor, 198) { return false; }
                    } else if argument_index == 2 {
                        if !append_object_byte(output, capacity, &mut code_cursor, 137)
                            || !append_object_byte(output, capacity, &mut code_cursor, 194) { return false; }
                    } else if argument_index == 3 {
                        if !append_object_byte(output, capacity, &mut code_cursor, 137)
                            || !append_object_byte(output, capacity, &mut code_cursor, 193) { return false; }
                    } else if argument_index == 4 {
                        if !append_object_byte(output, capacity, &mut code_cursor, 65)
                            || !append_object_byte(output, capacity, &mut code_cursor, 137)
                            || !append_object_byte(output, capacity, &mut code_cursor, 192) { return false; }
                    } else if !append_object_byte(output, capacity, &mut code_cursor, 65)
                        || !append_object_byte(output, capacity, &mut code_cursor, 137)
                        || !append_object_byte(output, capacity, &mut code_cursor, 193) {
                        return false;
                    }
                    argument_index = argument_index + 1;
                }
                let call_offset: usize = code_cursor;
                if !append_object_byte(output, capacity, &mut code_cursor, 232)
                    || !append_object_u32(
                        output, capacity, &mut code_cursor,
                        (text_offset + function_offsets[callee_index as usize]) as u32
                            - (call_offset as u32 + 5)
                    )
                    || !append_object_slot_store(output, capacity, &mut code_cursor, instruction.result_value) {
                    return false;
                }
            } else if instruction.opcode == TargetOpcode::Return {
                let returned: TargetOperand = unsafe { *(operands + instruction.first_operand) };
                if !append_object_slot_load(output, capacity, &mut code_cursor, returned.value_id)
                    || !append_object_byte(output, capacity, &mut code_cursor, 201)
                    || !append_object_byte(output, capacity, &mut code_cursor, 195) {
                    return false;
                }
            } else {
                return false;
            }
            instruction_offset = instruction_offset + 1;
        }
        function_sizes[function_index as usize] = code_cursor - function_code_start;
        if !put_u64(output, capacity, symbol_offset + 16, function_sizes[function_index as usize] as u64) {
            return false;
        }
        string_cursor = string_cursor + function.name.length + 1;
        function_index = function_index + 1;
    }
    if code_cursor != text_offset + text_size { return false; }
    unsafe { *output_length = file_size; }
    return true;
}

// Link one object produced by emit_elf64_scalar_function_object into a tiny
// Linux x86-64 ET_EXEC image. The exported function becomes the process entry
// and its u32 return value is passed to the exit syscall. The accepted object
// has one function, no relocations and the fixed section layout emitted above.
@export
@system
pub fn link_elf64_scalar_executable(
    object: *const u8,
    object_length: usize,
    entry_arguments: *const u32,
    entry_argument_count: u32,
    output: *mut u8,
    capacity: usize,
    output_length: *mut usize
) -> bool {
    if output_length == null { return false; }
    unsafe { *output_length = 0; }
    if object == null || output == null || object_length < 64
        || unsafe { *object } != 127 || unsafe { *(object + 1) } != 69
        || unsafe { *(object + 2) } != 76 || unsafe { *(object + 3) } != 70
        || unsafe { *(object + 4) } != 2 || unsafe { *(object + 5) } != 1
        || get_u16(object, object_length, 16) != 1
        || get_u16(object, object_length, 18) != 62
        || get_u32(object, object_length, 20) != 1
        || get_u64(object, object_length, 32) != 0
        || get_u32(object, object_length, 48) != 0
        || get_u16(object, object_length, 52) != 64
        || get_u16(object, object_length, 54) != 0
        || get_u16(object, object_length, 56) != 0
        || get_u16(object, object_length, 58) != 64
        || get_u16(object, object_length, 60) != 6
        || get_u16(object, object_length, 62) != 4 {
        return false;
    }
    let section_headers: usize = get_u64(object, object_length, 40) as usize;
    if section_headers > object_length || 384 > object_length - section_headers {
        return false;
    }
    let text_header: usize = section_headers + 64;
    let symbol_header: usize = section_headers + 128;
    let strings_header: usize = section_headers + 192;
    let abi_note_header: usize = section_headers + 320;
    if get_u32(object, object_length, text_header + 4) != 1
        || get_u64(object, object_length, text_header + 8) != 6
        || get_u32(object, object_length, symbol_header + 4) != 2
        || get_u32(object, object_length, symbol_header + 40) != 3
        || get_u32(object, object_length, symbol_header + 44) != 1
        || get_u64(object, object_length, symbol_header + 56) != 24
        || get_u32(object, object_length, strings_header + 4) != 3 {
        return false;
    }
    let mut section_index: u32 = 0;
    while section_index < 6 {
        let section_offset: usize = section_headers + section_index as usize * 64;
        let section_name: u32 = get_u32(object, object_length, section_offset);
        let mut expected_name: u32 = 33;
        if section_index == 0 { expected_name = 0; }
        else if section_index == 1 { expected_name = 1; }
        else if section_index == 2 { expected_name = 7; }
        else if section_index == 3 { expected_name = 15; }
        else if section_index == 4 { expected_name = 23; }
        let section_type: u32 = get_u32(object, object_length, section_offset + 4);
        if section_name != expected_name { return false; }
        if (section_index == 0 && section_type != 0)
            || (section_index == 1 && section_type != 1)
            || (section_index == 2 && section_type != 2)
            || ((section_index == 3 || section_index == 4) && section_type != 3)
            || (section_index == 5 && section_type != 7) {
            return false;
        }
        if (section_index == 1 && get_u64(object, object_length, section_offset + 8) != 6)
            || (section_index != 1 && get_u64(object, object_length, section_offset + 8) != 0) {
            return false;
        }
        section_index = section_index + 1;
    }
    let text_offset: usize = get_u64(object, object_length, text_header + 24) as usize;
    let text_size: usize = get_u64(object, object_length, text_header + 32) as usize;
    let symbols_offset: usize = get_u64(object, object_length, symbol_header + 24) as usize;
    let symbols_size: usize = get_u64(object, object_length, symbol_header + 32) as usize;
    let strings_offset: usize = get_u64(object, object_length, strings_header + 24) as usize;
    let strings_size: usize = get_u64(object, object_length, strings_header + 32) as usize;
    if text_size == 0 || text_offset > object_length || text_size > object_length - text_offset
        || symbols_offset > object_length || symbols_size < 48 || symbols_size % 24 != 0
        || symbols_size > object_length - symbols_offset
        || strings_offset > object_length || strings_size == 0
        || strings_size > object_length - strings_offset
        || get_u64(object, object_length, text_header + 48) != 16
        || get_u64(object, object_length, symbol_header + 48) != 8
        || get_u64(object, object_length, strings_header + 32) == 0
        || get_u64(object, object_length, section_headers + 256 + 32) != 50
        || get_u64(object, object_length, abi_note_header + 32) != 24
        || get_u64(object, object_length, abi_note_header + 48) != 4 {
        return false;
    }
    let symbol: usize = symbols_offset + 24;
    let name_offset: u32 = get_u32(object, object_length, symbol);
    if name_offset == 0 || (name_offset as usize) >= strings_size
        || unsafe { *(object + symbol + 4) } != 18
        || get_u16(object, object_length, symbol + 6) != 1
        || get_u64(object, object_length, symbol + 8) != 0
        || get_u64(object, object_length, symbol + 16) == 0
        || get_u64(object, object_length, symbol + 16) > text_size as u64 {
        return false;
    }
    let mut symbol_name_index: usize = name_offset as usize;
    let mut symbol_name_length: usize = 0;
    while symbol_name_index < strings_size {
        let name_byte: u8 = unsafe {
            *(object + strings_offset + symbol_name_index)
        };
        if name_byte == 0 { break; }
        if !valid_symbol_byte(name_byte, symbol_name_length == 0) { return false; }
        symbol_name_length = symbol_name_length + 1;
        symbol_name_index = symbol_name_index + 1;
    }
    if symbol_name_length == 0 || symbol_name_index >= strings_size
        || unsafe { *(object + strings_offset + symbol_name_index) } != 0 {
        return false;
    }

    let abi_note_offset: usize = get_u64(
        object, object_length, abi_note_header + 24
    ) as usize;
    if abi_note_offset > object_length || 24 > object_length - abi_note_offset
        || get_u32(object, object_length, abi_note_offset) != 7
        || get_u32(object, object_length, abi_note_offset + 4) != 4
        || get_u32(object, object_length, abi_note_offset + 8) != 1
        || unsafe { *(object + abi_note_offset + 12) } != 83
        || unsafe { *(object + abi_note_offset + 13) } != 79
        || unsafe { *(object + abi_note_offset + 14) } != 84
        || unsafe { *(object + abi_note_offset + 15) } != 76
        || unsafe { *(object + abi_note_offset + 16) } != 65
        || unsafe { *(object + abi_note_offset + 17) } != 83
        || unsafe { *(object + abi_note_offset + 18) } != 0 {
        return false;
    }
    let abi_descriptor: u32 = get_u32(object, object_length, abi_note_offset + 20);
    let declared_argument_count: u32 = abi_descriptor & 255;
    let bool_argument_mask: u32 = (abi_descriptor >> 8) & 63;
    if declared_argument_count > 6 || entry_argument_count != declared_argument_count
        || (abi_descriptor >> 14) != 0
        || bool_argument_mask >= ((1 as u32) << declared_argument_count)
        || (entry_argument_count != 0 && entry_arguments == null) { return false; }
    let mut type_check_index: u32 = 0;
    while type_check_index < entry_argument_count {
        if ((bool_argument_mask >> type_check_index) & 1) != 0
            && unsafe { *(entry_arguments + type_check_index) } > 1 { return false; }
        type_check_index = type_check_index + 1;
    }

    let code_offset: usize = 120;
    let mut argument_bytes: usize = 0;
    let mut argument_index: u32 = 0;
    while argument_index < entry_argument_count {
        if argument_index >= 4 {
            argument_bytes = argument_bytes + 6;
        } else {
            argument_bytes = argument_bytes + 5;
        }
        argument_index = argument_index + 1;
    }
    let shim_size: usize = 16 + argument_bytes;
    if text_size > 4294967175 || code_offset + shim_size > capacity
        || text_size > capacity - code_offset - shim_size {
        return false;
    }
    let file_size: usize = code_offset + shim_size + text_size;
    let mut index: usize = 0;
    while index < file_size {
        unsafe { *(output + index) = 0; }
        index = index + 1;
    }
    let mut shim_cursor: usize = code_offset;
    argument_index = 0;
    while argument_index < entry_argument_count {
        let mut register_opcode: u8 = 185 as u8;
        if argument_index == 0 { register_opcode = 191 as u8; }
        else if argument_index == 1 { register_opcode = 190 as u8; }
        else if argument_index == 2 { register_opcode = 186 as u8; }
        else if argument_index == 4 { register_opcode = 184 as u8; }
        if argument_index >= 4 && !put_u8(output, capacity, shim_cursor, 65) { return false; }
        if argument_index >= 4 { shim_cursor = shim_cursor + 1; }
        if !put_u8(output, capacity, shim_cursor, register_opcode)
            || !put_u32(output, capacity, shim_cursor + 1,
                unsafe { *(entry_arguments + argument_index) }) { return false; }
        shim_cursor = shim_cursor + 5;
        argument_index = argument_index + 1;
    }
    let call_opcode_offset: usize = shim_cursor;
    let function_offset_in_executable: usize = code_offset + shim_size;
    if !put_u8(output, capacity, shim_cursor, 232)
        || !put_u32(output, capacity, shim_cursor + 1,
            (function_offset_in_executable as u32) - (call_opcode_offset as u32 + 5))
        || !put_u8(output, capacity, shim_cursor + 5, 137)
        || !put_u8(output, capacity, shim_cursor + 6, 199)
        || !put_u8(output, capacity, shim_cursor + 7, 184)
        || !put_u32(output, capacity, shim_cursor + 8, 60)
        || !put_u8(output, capacity, shim_cursor + 12, 15)
        || !put_u8(output, capacity, shim_cursor + 13, 5) { return false; }
    shim_cursor = shim_cursor + 14;
    while shim_cursor < code_offset + shim_size {
        if !put_u8(output, capacity, shim_cursor, 144) { return false; }
        shim_cursor = shim_cursor + 1;
    }
    index = 0;
    while index < text_size {
        unsafe {
            *(output + code_offset + shim_size + index) = *(object + text_offset + index);
        }
        index = index + 1;
    }
    if !put_u8(output, capacity, 0, 127)
        || !put_u8(output, capacity, 1, 69)
        || !put_u8(output, capacity, 2, 76)
        || !put_u8(output, capacity, 3, 70)
        || !put_u8(output, capacity, 4, 2)
        || !put_u8(output, capacity, 5, 1)
        || !put_u8(output, capacity, 6, 1)
        || !put_u16(output, capacity, 16, 2)
        || !put_u16(output, capacity, 18, 62)
        || !put_u32(output, capacity, 20, 1)
        || !put_u64(output, capacity, 24, 4194424)
        || !put_u64(output, capacity, 32, 64)
        || !put_u16(output, capacity, 52, 64)
        || !put_u16(output, capacity, 54, 56)
        || !put_u16(output, capacity, 56, 1)
        || !put_u32(output, capacity, 64, 1)
        || !put_u32(output, capacity, 68, 5)
        || !put_u64(output, capacity, 72, 0)
        || !put_u64(output, capacity, 80, 4194304)
        || !put_u64(output, capacity, 88, 4194304)
        || !put_u64(output, capacity, 96, file_size as u64)
        || !put_u64(output, capacity, 104, file_size as u64)
        || !put_u64(output, capacity, 112, 4096) {
        return false;
    }
    unsafe { *output_length = file_size; }
    return true;
}

fn append_object_eax_to_argument(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    argument_index: u32
) -> bool {
    if argument_index > 5 { return false; }
    if argument_index >= 4 && !append_object_byte(output, capacity, length, 65) { return false; }
    let mut modrm: u8 = 193 as u8;
    if argument_index == 0 { modrm = 199 as u8; }
    else if argument_index == 1 { modrm = 198 as u8; }
    else if argument_index == 2 { modrm = 194 as u8; }
    else if argument_index == 4 { modrm = 192 as u8; }
    return append_object_byte(output, capacity, length, 137)
        && append_object_byte(output, capacity, length, modrm);
}

fn append_object_slot_load_rax64(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    value_id: u32
) -> bool {
    if value_id == 0 || value_id > 536870911 { return false; }
    return append_object_byte(output, capacity, length, 72)
        && append_object_byte(output, capacity, length, 139)
        && append_object_byte(output, capacity, length, 133)
        && append_object_u32(output, capacity, length, 0 as u32 - value_id * 8);
}

fn append_object_rax_to_argument(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    argument_index: u32
) -> bool {
    if argument_index > 5 { return false; }
    let mut rex: u8 = 72 as u8;
    if argument_index >= 4 { rex = 73 as u8; }
    if !append_object_byte(output, capacity, length, rex) { return false; }
    let mut modrm: u8 = 193 as u8;
    if argument_index == 0 { modrm = 199 as u8; }
    else if argument_index == 1 { modrm = 198 as u8; }
    else if argument_index == 2 { modrm = 194 as u8; }
    else if argument_index == 4 { modrm = 192 as u8; }
    return append_object_byte(output, capacity, length, 137)
        && append_object_byte(output, capacity, length, modrm);
}

fn append_object_adjust_rsp(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    bytes: u32,
    reserve: bool
) -> bool {
    if bytes == 0 { return true; }
    if (bytes & 15) != 0 || bytes > 144 { return false; }
    let mut operation: u8 = 236;
    if !reserve { operation = 196; }
    return append_object_byte(output, capacity, length, 72)
        && append_object_byte(output, capacity, length, 129)
        && append_object_byte(output, capacity, length, operation)
        && append_object_u32(output, capacity, length, bytes);
}

fn append_object_rax_to_stack_argument(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    argument_index: u32
) -> bool {
    if argument_index < 6 || argument_index >= 24 { return false; }
    // mov qword ptr [rsp + disp32], rax; rsp still points at the
    // aligned outgoing-argument area until the call has returned.
    return append_object_byte(output, capacity, length, 72)
        && append_object_byte(output, capacity, length, 137)
        && append_object_byte(output, capacity, length, 132)
        && append_object_byte(output, capacity, length, 36)
        && append_object_u32(output, capacity, length, (argument_index - 6) * 8);
}

fn object_block_offset(
    blocks: *const TargetBlock,
    first_block: u32,
    block_count: u32,
    block_id: u32
) -> u32 {
    let mut offset: u32 = 0;
    while offset < block_count {
        if unsafe { (*(blocks + first_block + offset)).id } == block_id { return offset; }
        offset = offset + 1;
    }
    return block_count;
}

fn object_value_type(values: *const TargetValue, value_count: u32, value_id: u32) -> TargetTypeTag {
    if values == null || value_id == 0 || value_id > value_count { return TargetTypeTag::Invalid; }
    let value: TargetValue = unsafe { *(values + value_id - 1) };
    if value.id != value_id { return TargetTypeTag::Invalid; }
    return value.type_tag;
}

fn object_scalar_type(type_tag: TargetTypeTag) -> bool {
    return type_tag == TargetTypeTag::U8 || type_tag == TargetTypeTag::U16
        || type_tag == TargetTypeTag::U32 || type_tag == TargetTypeTag::Bool
        || type_tag == TargetTypeTag::U64 || type_tag == TargetTypeTag::I64
        || type_tag == TargetTypeTag::Pointer || type_tag == TargetTypeTag::Usize;
}

fn object_type_is_64(type_tag: TargetTypeTag) -> bool {
    return type_tag == TargetTypeTag::U64 || type_tag == TargetTypeTag::I64
        || type_tag == TargetTypeTag::Pointer || type_tag == TargetTypeTag::Usize;
}

fn object_integer_arithmetic_type(type_tag: TargetTypeTag) -> bool {
    return type_tag == TargetTypeTag::U32 || type_tag == TargetTypeTag::U64
        || type_tag == TargetTypeTag::I64 || type_tag == TargetTypeTag::Usize;
}

fn object_unsigned_integer_type(type_tag: TargetTypeTag) -> bool {
    return type_tag == TargetTypeTag::U32 || type_tag == TargetTypeTag::U64
        || type_tag == TargetTypeTag::Usize;
}

fn object_integer_cast_type(type_tag: TargetTypeTag) -> bool {
    return type_tag == TargetTypeTag::U8 || type_tag == TargetTypeTag::U16
        || type_tag == TargetTypeTag::U32 || type_tag == TargetTypeTag::U64
        || type_tag == TargetTypeTag::I64 || type_tag == TargetTypeTag::Usize;
}

fn append_object_slot_load_typed(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    value_id: u32,
    type_tag: TargetTypeTag
) -> bool {
    if object_type_is_64(type_tag) {
        return append_object_slot_load_rax64(output, capacity, length, value_id);
    }
    if type_tag == TargetTypeTag::U8 || type_tag == TargetTypeTag::U16
        || type_tag == TargetTypeTag::U32 || type_tag == TargetTypeTag::Bool {
        return append_object_slot_load(output, capacity, length, value_id);
    }
    return false;
}

fn append_object_slot_store_typed(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    value_id: u32,
    type_tag: TargetTypeTag
) -> bool {
    if object_type_is_64(type_tag) {
        return append_object_slot_store64(output, capacity, length, value_id);
    }
    if type_tag == TargetTypeTag::U8 || type_tag == TargetTypeTag::U16
        || type_tag == TargetTypeTag::U32 || type_tag == TargetTypeTag::Bool {
        return append_object_slot_store(output, capacity, length, value_id);
    }
    return false;
}


// Assign each stack allocation a stable, non-overlapping range across all
// blocks of a function. Per-block instruction ordinals are not unique.
fn object_stack_allocation_end(
    blocks: *const TargetBlock,
    instructions: *const TargetInstruction,
    function: TargetFunction,
    result_value: u32
) -> u32 {
    let mut total: u32 = 0;
    let mut block_offset: u32 = 0;
    while block_offset < function.block_count {
        let block: TargetBlock = unsafe { *(blocks + function.first_block + block_offset) };
        let mut local: u32 = 0;
        while local < block.instruction_count {
            let instruction: TargetInstruction = unsafe { *(instructions + block.first_instruction + local) };
            if instruction.opcode == TargetOpcode::AllocStack && instruction.symbol.length == 0 {
                if instruction.immediate_bits == 0 || instruction.immediate_bits > 536870895 {
                    return 4294967295;
                }
                let size: u32 = ((instruction.immediate_bits as u32 + 15) / 16) * 16;
                if size > 536870895 || total > 536870895 as u32 - size { return 4294967295; }
                total = total + size;
                if instruction.result_value == result_value { return total; }
            }
            local = local + 1;
        }
        block_offset = block_offset + 1;
    }
    if result_value != 0 { return 4294967295; }
    return total;
}

fn object_find_function(
    source: *const u8,
    source_len: usize,
    functions: *const TargetFunction,
    function_count: u32,
    symbol: TargetSourceSlice
) -> u32 {
    if symbol.length == 0 || symbol.offset > source_len || symbol.length > source_len - symbol.offset {
        return function_count;
    }
    let mut index: u32 = 0;
    while index < function_count {
        let candidate: TargetFunction = unsafe { *(functions + index) };
        if candidate.name.length == symbol.length {
            let mut byte_index: usize = 0;
            let mut same: bool = true;
            while byte_index < symbol.length {
                if unsafe { *(source + candidate.name.offset + byte_index) }
                    != unsafe { *(source + symbol.offset + byte_index) } {
                    same = false;
                    break;
                }
                byte_index = byte_index + 1;
            }
            if same { return index; }
        }
        index = index + 1;
    }
    return function_count;
}

// Copy Phi inputs for the edge predecessor -> destination through scratch
// slots first, so parallel-copy and loop-carried semantics are preserved.
fn append_object_phi_copies(
    output: *mut u8,
    capacity: usize,
    length: &mut usize,
    destination: TargetBlock,
    predecessor_id: u32,
    instructions: *const TargetInstruction,
    phi_inputs: *const TargetPhiInput,
    values: *const TargetValue,
    value_count: u32,
    scratch_base: u32,
    slot_base: u32
) -> bool {
    let mut phi_index: u32 = 0;
    while phi_index < destination.instruction_count {
        let phi: TargetInstruction = unsafe { *(instructions + destination.first_instruction + phi_index) };
        if phi.opcode != TargetOpcode::Phi { break; }
        if phi_inputs == null || !object_scalar_type(phi.type_tag) { return false; }
        let mut incoming_index: u32 = 0;
        let mut found: bool = false;
        while incoming_index < phi.phi_input_count {
            let incoming: TargetPhiInput = unsafe { *(phi_inputs + phi.first_phi_input + incoming_index) };
            if incoming.block_id == predecessor_id {
                if object_value_type(values, value_count, incoming.value_id) != phi.type_tag
                    || !append_object_slot_load_typed(output, capacity, length, incoming.value_id - slot_base, phi.type_tag)
                    || !append_object_slot_store_typed(output, capacity, length, scratch_base + phi_index + 1, phi.type_tag) {
                    return false;
                }
                found = true;
                break;
            }
            incoming_index = incoming_index + 1;
        }
        if !found { return false; }
        phi_index = phi_index + 1;
    }
    let phi_count: u32 = phi_index;
    phi_index = 0;
    while phi_index < phi_count {
        let phi: TargetInstruction = unsafe { *(instructions + destination.first_instruction + phi_index) };
        if !append_object_slot_load_typed(output, capacity, length, scratch_base + phi_index + 1, phi.type_tag)
            || !append_object_slot_store_typed(output, capacity, length, phi.result_value - slot_base, phi.type_tag) {
            return false;
        }
        phi_index = phi_index + 1;
    }
    return true;
}

// Value IDs remain module-wide in Target IR. Machine stack slots are relative
// to this function's value range; unrelated modules do not grow its frame.
fn object_function_value_bound(parameters: *const TargetParameter,
    blocks: *const TargetBlock, instructions: *const TargetInstruction,
    function: TargetFunction, largest: bool) -> u32 {
    let mut bound: u32 = 0;
    let mut parameter_index: u32 = 0;
    while parameter_index < function.parameter_count {
        let id: u32 = unsafe { (*(parameters + function.first_parameter + parameter_index)).value_id };
        if id != 0 && (bound == 0 || (largest && id > bound) || (!largest && id < bound)) { bound = id; }
        parameter_index = parameter_index + 1;
    }
    let mut block_index: u32 = 0;
    while block_index < function.block_count {
        let block: TargetBlock = unsafe { *(blocks + function.first_block + block_index) };
        let mut instruction_index: u32 = 0;
        while instruction_index < block.instruction_count {
            let id: u32 = unsafe { (*(instructions + block.first_instruction + instruction_index)).result_value };
            if id != 0 && (bound == 0 || (largest && id > bound) || (!largest && id < bound)) { bound = id; }
            instruction_index = instruction_index + 1;
        }
        block_index = block_index + 1;
    }
    return bound;
}

// Touch each stack page before descending further. This requires no host
// runtime and preserves all six SysV argument registers on Windows and Linux.
fn append_object_prologue(output: *mut u8, capacity: usize,
    length: &mut usize, frame_size: u32) -> bool {
    if !append_object_byte(output, capacity, length, 85)
        || !append_object_byte(output, capacity, length, 72)
        || !append_object_byte(output, capacity, length, 137)
        || !append_object_byte(output, capacity, length, 229) { return false; }
    if frame_size > 4096 {
        // mov eax, size; sub rsp,4096; test byte [rsp],0; sub eax,4096;
        // cmp eax,4096; jae -23; sub rsp,rax.
        return append_object_byte(output, capacity, length, 184)
            && append_object_u32(output, capacity, length, frame_size)
            && append_object_byte(output, capacity, length, 72)
            && append_object_byte(output, capacity, length, 129)
            && append_object_byte(output, capacity, length, 236)
            && append_object_u32(output, capacity, length, 4096)
            && append_object_byte(output, capacity, length, 246)
            && append_object_byte(output, capacity, length, 4)
            && append_object_byte(output, capacity, length, 36)
            && append_object_byte(output, capacity, length, 0)
            && append_object_byte(output, capacity, length, 45)
            && append_object_u32(output, capacity, length, 4096)
            && append_object_byte(output, capacity, length, 61)
            && append_object_u32(output, capacity, length, 4096)
            && append_object_byte(output, capacity, length, 115)
            && append_object_byte(output, capacity, length, 233)
            && append_object_byte(output, capacity, length, 72)
            && append_object_byte(output, capacity, length, 41)
            && append_object_byte(output, capacity, length, 196);
    }
    return append_object_byte(output, capacity, length, 72)
        && append_object_byte(output, capacity, length, 129)
        && append_object_byte(output, capacity, length, 236)
        && append_object_u32(output, capacity, length, frame_size);
}

fn linux_process_entry_name(name: *const u8, length: usize) -> bool {
    if name == null || length != 17 { return false; }
    let expected: *const u8 = "sotlas_linux_main";
    let mut index: usize = 0;
    while index < 17 {
        if unsafe { *(name + index) } != unsafe { *(expected + index) } { return false; }
        index = index + 1;
    }
    return true;
}

// Unified ELF64 relocatable writer. It accepts up to 512 scalar CFG functions
// (U32/Bool/U64/I64/Usize/Pointer/Void results and up to 24 machine parameters),
// external function declarations, direct calls in both directions, Phi on
// unconditional and conditional edges (conditional edges are split inside the
// writer), and semantic-only ownership/effect markers, which have no runtime
// encoding. Calls to external declarations become R_X86_64_PLT32 relocations
// against undefined global symbols. Callers must validate SSA dominance first.
@export
@system
pub fn emit_elf64_module_object(
    source: *const u8,
    source_len: usize,
    target_module: *const TargetModule,
    functions: *const TargetFunction,
    parameters: *const TargetParameter,
    values: *const TargetValue,
    blocks: *const TargetBlock,
    instructions: *const TargetInstruction,
    operands: *const TargetOperand,
    phi_inputs: *const TargetPhiInput,
    targets: *const u32,
    output: *mut u8,
    capacity: usize,
    output_length: *mut usize
) -> bool {
    if output_length == null { return false; }
    unsafe { *output_length = 0; }
    if source == null || target_module == null || functions == null || output == null { return false; }
    let ir: TargetModule = unsafe { *target_module };
    if ir.version != 1 || ir.function_count == 0 || ir.function_count > 512
        || ir.value_count > 536870000 {
        return false;
    }
    if !target_module_validate_cfg(
        target_module, functions, parameters, values, blocks, instructions, operands, phi_inputs, targets
    ) { return false; }

    let mut symbol_of_function: [u32; 512] = 0;
    let mut defined_count: u32 = 0;
    let mut external_count: u32 = 0;
    let mut strings_size: usize = 1;
    let mut max_phi: u32 = 0;
    let mut platform_flags: u32 = 0;
    let mut function_index: u32 = 0;
    while function_index < ir.function_count {
        let function: TargetFunction = unsafe { *(functions + function_index) };
        if function.name.length == 0 || function.name.offset > source_len
            || function.name.length > source_len - function.name.offset
            || function.name.length > 4096
            || function.parameter_count > 24
            || (function.return_type != TargetTypeTag::U8
                && function.return_type != TargetTypeTag::U16
                && function.return_type != TargetTypeTag::U32
                && function.return_type != TargetTypeTag::U64
                && function.return_type != TargetTypeTag::I64
                && function.return_type != TargetTypeTag::Pointer
                && function.return_type != TargetTypeTag::Usize
                && function.return_type != TargetTypeTag::Bool
                && function.return_type != TargetTypeTag::Void) {
            return false;
        }
        if linux_process_entry_name(unsafe { source + function.name.offset }, function.name.length as usize) {
            if function.parameter_count != 2 || function.return_type != TargetTypeTag::U32
                || (function.flags & TARGET_FUNCTION_EXTERNAL) != 0
                || unsafe { (*(parameters + function.first_parameter)).type_tag } != TargetTypeTag::U64
                || unsafe { (*(parameters + function.first_parameter + 1)).type_tag } != TargetTypeTag::Pointer { return false; }
        }
        let mut name_index: usize = 0;
        while name_index < function.name.length {
            if !valid_symbol_byte(unsafe { *(source + function.name.offset + name_index) }, name_index == 0) {
                return false;
            }
            name_index = name_index + 1;
        }
        if object_find_function(source, source_len, functions, function_index, function.name) != function_index {
            return false;
        }
        let mut parameter_index: u32 = 0;
        while parameter_index < function.parameter_count {
            let parameter: TargetParameter = unsafe { *(parameters + function.first_parameter + parameter_index) };
            if !object_scalar_type(parameter.type_tag) { return false; }
            parameter_index = parameter_index + 1;
        }
        if (function.flags & TARGET_FUNCTION_EXTERNAL) != 0 {
            let windows_id: u32 = windows_import_id(unsafe { source + function.name.offset }, function.name.length as usize);
            if !windows_signature_valid(windows_id, function, parameters) { return false; }
            external_count = external_count + 1;
        } else {
            if function.block_count > 2048 { return false; }
            defined_count = defined_count + 1;
            let mut block_offset: u32 = 0;
            while block_offset < function.block_count {
                let block: TargetBlock = unsafe { *(blocks + function.first_block + block_offset) };
                let mut phi_count: u32 = 0;
                while phi_count < block.instruction_count
                    && unsafe { (*(instructions + block.first_instruction + phi_count)).opcode } == TargetOpcode::Phi {
                    phi_count = phi_count + 1;
                }
                if phi_count > max_phi { max_phi = phi_count; }
                block_offset = block_offset + 1;
            }
        }
        strings_size = strings_size + function.name.length + 1;
        function_index = function_index + 1;
    }
    if defined_count == 0 { return false; }
    let mut next_defined: u32 = 1;
    let mut next_external: u32 = defined_count + 1;
    function_index = 0;
    while function_index < ir.function_count {
        if (unsafe { (*(functions + function_index)).flags } & TARGET_FUNCTION_EXTERNAL) != 0 {
            symbol_of_function[function_index as usize] = next_external;
            next_external = next_external + 1;
        } else {
            symbol_of_function[function_index as usize] = next_defined;
            next_defined = next_defined + 1;
        }
        function_index = function_index + 1;
    }

    let text_offset: usize = 64;
    if capacity <= text_offset { return false; }
    let mut clear_index: usize = 0;
    while clear_index < text_offset {
        unsafe { *(output + clear_index) = 0; }
        clear_index = clear_index + 1;
    }
    let mut code: usize = text_offset;
    let mut function_offsets: [usize; 512] = 0;

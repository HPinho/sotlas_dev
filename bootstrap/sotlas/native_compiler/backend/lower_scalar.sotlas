            }

            let mut source_type: TargetTypeTag = TargetTypeTag::Invalid;
            let mut sem: Sema = Sema::new();
            let source_type_ref: usize = sem.infer_expression_type_ref(
                self.nodes,
                self.node_count,
                value_index,
                self.source,
                self.source_len

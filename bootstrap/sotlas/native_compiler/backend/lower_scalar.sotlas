            if cast_type == TargetTypeTag::Pointer && value_node.kind == AstKind::ExprIdent {
                let global_index: isize = self.find_global_bss(
                    value_node.str_offset, value_node.str_len
                );
                if global_index < 0 { return TARGET_VALUE_NONE; }
                let global_slot: usize = global_index as usize;
                let pointee_type: TargetTypeTag = self.pointer_pointee_type_tag(cast_type_index);
                let pointee_struct: u32 = self.pointer_pointee_struct_id(cast_type_index);
                let element_struct: u32 = unsafe { g_bss_sym_element_structs[global_slot] };
                if unsafe { g_bss_sym_is_array[global_slot] } == 0
                    || (type_tag != TargetTypeTag::Invalid && type_tag != TargetTypeTag::Pointer) {

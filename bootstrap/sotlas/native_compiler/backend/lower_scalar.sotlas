                let metadata_type: TargetTypeTag = self.condition_expression_type(value_index, first_parameter, parameter_count);
                if metadata_type != TargetTypeTag::Invalid { source_type = metadata_type; }
            }
            if source_type != TargetTypeTag::U8
                && source_type != TargetTypeTag::U16
                && source_type != TargetTypeTag::U32
                && source_type != TargetTypeTag::U64
                && source_type != TargetTypeTag::I8 && source_type != TargetTypeTag::I16 && source_type != TargetTypeTag::I32
                && source_type != TargetTypeTag::I64 {

module sotlas::compiler::backend::lower_scalar;

import sotlas::compiler::ast::*;
import sotlas::compiler::sema::*;
import sotlas::compiler::backend::target_ir::*;

// Explicit proof frames avoid host allocation and recursion over product axes.
// Payload storage is bounded to 4096 bytes, so each constrained axis has a
// unique byte offset in this private, non-overlapping aggregate layout.
// Buffer pointers borrow payload_coverage locals and never escape that call.
pub struct NativeMatchCoverage {
    pub assigned: *mut u8;
    pub low: *mut u64;
    pub high: *mut u64;
    pub keys: *mut u32;
    pub types: *mut u32;
    pub enums: *mut u32;
    pub ordinals: *mut u32;
    pub masks: *mut u64;
    pub found_key: u32;
    pub found_type: TargetTypeTag;
    pub found_enum: u32;
    pub found_low: u64;
    pub found_high: u64;
}

impl NativeMatchCoverage {
    pub fn new()->NativeMatchCoverage {
        return NativeMatchCoverage{assigned:null,low:null,high:null,
            keys:null,types:null,enums:null,ordinals:null,masks:null,
            found_key:0,found_type:TargetTypeTag::Invalid,found_enum:0,found_low:0,found_high:0};
    }
}

// Caller-owned flat buffers let this lowering run without a host allocator.
// Offsets in TargetFunction/TargetBlock/TargetInstruction index these buffers.
pub struct ScalarLowering {
    pub nodes: *const AstNode;
    pub node_count: usize;
    pub source: *const u8;
    pub source_len: usize;
    pub values: *mut TargetValue;
    pub value_capacity: usize;
    pub value_count: usize;
    pub parameters: *mut TargetParameter;
    pub parameter_capacity: usize;
    pub parameter_count: usize;
    pub instructions: *mut TargetInstruction;
    pub instruction_capacity: usize;
    pub instruction_count: usize;
    pub operands: *mut TargetOperand;
    pub operand_capacity: usize;
    pub operand_count: usize;
    pub blocks: *mut TargetBlock;
    pub block_capacity: usize;
    pub block_count: usize;
    pub phi_inputs: *mut TargetPhiInput;
    pub phi_input_capacity: usize;
    pub phi_input_count: usize;
    pub targets: *mut u32;
    pub target_capacity: usize;
    pub target_count: usize;
    pub functions: *mut TargetFunction;
    pub function_capacity: usize;
    pub function_count: usize;
    pub next_value_id: u32;
    pub error_node: usize;
    pub error_reason: u32;
    pub local_name_offsets: [usize; 128];
    pub local_name_lens: [usize; 128];
    pub local_value_ids: [u32; 128];
    pub local_struct_ids: [u32; 128];
    pub local_storage_types: [u32; 128];
    pub local_array_types: [u32; 128];
    pub local_array_counts: [u32; 128];
    pub structured_cfg: bool;
    pub return_struct_id: u32;
    pub return_destination: u32;
    pub forwarded_return_call: usize;
    pub match_yield_storage: u32;
    pub match_yield_type: TargetTypeTag;
    pub match_yield_record: u32;
    pub cfg_current: u32;
    pub cfg_first_instruction: usize;
    pub local_count: usize;
    pub struct_name_offsets: [usize; 32];
    pub struct_name_lens: [usize; 32];
    pub struct_sizes: [u32; 32];
    pub struct_alignments: [u32; 32];
    pub struct_field_starts: [u32; 32];
    pub struct_field_counts: [u32; 32];
    pub struct_count: usize;
    pub field_name_offsets: [usize; 256];
    pub field_name_lens: [usize; 256];
    pub field_offsets: [u32; 256];
    pub field_type_tags: [u32; 256];
    pub field_struct_ids: [u32; 256];
    pub field_byte_counts: [u32; 256];
    pub field_array_types: [u32; 256];
    pub field_array_structs: [u32; 256];
    pub field_type_refs: [usize; 256];
    pub field_total_count: usize;
    pub enum_name_offsets: [usize; 32];
    pub enum_name_lens: [usize; 32];
    pub enum_variant_starts: [u32; 32];
    pub enum_variant_counts: [u32; 32];
    pub enum_count: usize;
    pub enum_record_ids: [u32;32];
    pub variant_nodes: [usize;256];
    pub variant_field_starts: [u32;256];
    pub variant_field_counts: [u32;256];
    pub variant_name_offsets: [usize; 256];
    pub variant_name_lens: [usize; 256];
    pub variant_values: [u64; 256];
    pub variant_total_count: usize;
    pub const_name_offsets: [usize; 64];
    pub const_name_lens: [usize; 64];
    pub const_type_tags: [u32; 64];
    pub const_literal_nodes: [usize; 64];
    pub const_bits: [u64; 64];
    pub const_states: [u8; 64];
    pub const_count: usize;
    pub constant_evaluation: bool;
    pub constant_validation_only: bool;
    pub constant_depth: usize;
    pub defer_nodes: [usize;128];
    pub defer_locals: [usize;128];
    pub defer_count: usize;
    pub loop_defer_base: usize;
}

fn align_val(value: usize, alignment: usize) -> usize {
    return (value + alignment - 1) / alignment * alignment;
}

pub static mut g_extended_len: usize = 0;

@export
@system
pub fn sotlas_native_extended_source_len() -> usize {
    return unsafe { g_extended_len };
}

// Exact decimal-to-binary conversion for the bounded native literal profile.
// Coefficient and decimal denominator each fit in 10^18. No host float parser,
// floating arithmetic or C runtime participates in rounding these literals.
fn native_decimal_float_bits(source: *const u8, length: usize,
    typ: TargetTypeTag, result: &mut u64) -> bool {
    if source == null || length == 0 || !target_type_is_float(typ) { return false; }
    let mut numerator: u64 = 0;
    let mut denominator: u64 = 1;
    let mut dot: bool = false;
    let mut fraction: bool = false;
    let mut digits: usize = 0;
    let mut index: usize = 0;
    let mut scientific: bool = false;
    while index < length {
        let ch: u8 = unsafe { *(source + index) };
        if ch == 101 || ch == 69 { scientific = true; break; }
        if ch == 46 {
            if dot || digits == 0 { return false; }
            dot = true;
        } else if ch != 95 {
            if ch < 48 || ch > 57 { return false; }
            if numerator > 99999999999999999 { return false; }
            numerator = numerator * 10 + (ch - 48) as u64;
            if numerator >= 1000000000000000000 { return false; }
            if dot {
                if denominator >= 1000000000000000000 { return false; }
                denominator = denominator * 10;
                fraction = true;
            }
            digits = digits + 1;
        }
        index = index + 1;
    }
    if digits == 0 || (!scientific && (!dot || !fraction)) { return false; }
    if scientific {
        index = index + 1;
        let mut negative_exponent: bool = false;
        if index < length && unsafe { *(source + index) } == 45 { negative_exponent = true; index = index + 1; }
        else if index < length && unsafe { *(source + index) } == 43 { index = index + 1; }
        if index >= length { return false; }
        let mut decimal_exponent: u32 = 0;
        while index < length {
            let ch: u8 = unsafe { *(source + index) };
            if ch != 95 {
                if ch < 48 || ch > 57 || decimal_exponent > 18 { return false; }
                decimal_exponent = decimal_exponent * 10 + (ch - 48) as u32;
            } else {
                if index == 0 || index+1 >= length { return false; }
                let previous: u8=unsafe{*(source+index-1)};let following: u8=unsafe{*(source+index+1)};
                if previous < 48 || previous > 57 || following < 48 || following > 57 { return false; }
            }
            index = index + 1;
        }
        if decimal_exponent > 18 { return false; }
        while numerator != 0 && numerator % 10 == 0 && denominator % 10 == 0 {
            numerator = numerator / 10; denominator = denominator / 10;
        }
        while decimal_exponent != 0 {
            if negative_exponent {
                if denominator > 100000000000000000 { return false; }
                denominator = denominator * 10;
            } else {
                if numerator > 99999999999999999 { return false; }
                numerator = numerator * 10;
            }
            decimal_exponent = decimal_exponent - 1;
        }
    }
    if numerator == 0 { unsafe { *result = 0; } return true; }
    let mut exponent: i32 = 0;
    while numerator / 2 >= denominator { denominator = denominator * 2; exponent = exponent + 1; }
    while numerator < denominator { numerator = numerator * 2; exponent = exponent - 1; }
    let mut precision: u64 = 53;
    let mut bias: i32 = 1023;
    if typ == TargetTypeTag::F32 { precision = 24; bias = 127; }
    let mut significand: u64 = 1;
    let mut remainder: u64 = numerator - denominator;
    let mut bit: u64 = 1;
    while bit < precision {
        remainder = remainder * 2;
        significand = significand * 2;
        if remainder >= denominator { significand = significand + 1; remainder = remainder - denominator; }
        bit = bit + 1;
    }
    // Round to nearest, ties to even, retaining the exact rational remainder.
    remainder = remainder * 2;
    if remainder > denominator || (remainder == denominator && (significand & 1) != 0) {
        significand = significand + 1;
    }
    if significand == ((1 as u64) << precision) { significand = significand >> 1; exponent = exponent + 1; }
    let fraction_bits: u64 = precision - 1;
    let bits: u64 = ((exponent + bias) as u64 << fraction_bits)
        | (significand & (((1 as u64) << fraction_bits) - 1));
    unsafe { *result = bits; }
    return true;
}

// Integer constant arithmetic is evaluated before object emission.
// Signed overflow and invalid division/shift operands are compilation errors.
fn native_constant_integer(op: TargetOpcode, typ: TargetTypeTag,
    left: u64, right: u64, result: &mut u64) -> bool {
    let width: u32 = target_integer_width(typ);
    if width == 0 { return false; }
    let mut mask: u64 = 18446744073709551615;
    if width < 64 { mask = ((1 as u64) << width as u64) - 1; }
    let a: u64 = left & mask; let b: u64 = right & mask;
    let sign: u64 = (1 as u64) << ((width - 1) as u64);
    let is_signed: bool = typ == TargetTypeTag::I8 || typ == TargetTypeTag::I16
        || typ == TargetTypeTag::I32 || typ == TargetTypeTag::I64 || typ == TargetTypeTag::Isize;
    let mut bits: u64 = 0;
    if op == TargetOpcode::Add {
        bits = (a + b) & mask;
        if is_signed && ((a ^ bits) & (b ^ bits) & sign) != 0 { return false; }
    } else if op == TargetOpcode::Sub {
        bits = (a - b) & mask;
        if is_signed && ((a ^ b) & (a ^ bits) & sign) != 0 { return false; }
    } else if op == TargetOpcode::Mul {
        if is_signed {
            let negative_a: bool = (a & sign) != 0; let negative_b: bool = (b & sign) != 0;
            let mut magnitude_a: u64 = a; let mut magnitude_b: u64 = b;
            if negative_a { magnitude_a = (0 as u64 - a) & mask; }
            if negative_b { magnitude_b = (0 as u64 - b) & mask; }
            let negative: bool = negative_a != negative_b;
            let mut limit: u64 = sign - 1; if negative { limit = sign; }
            if magnitude_b != 0 && magnitude_a > limit / magnitude_b { return false; }
            bits = magnitude_a * magnitude_b;
            if negative { bits = (0 as u64 - bits) & mask; }
        } else { bits = (a * b) & mask; }
    } else if op == TargetOpcode::Div || op == TargetOpcode::Mod {
        if b == 0 { return false; }
        if is_signed {
            if a == sign && b == mask { return false; }
            let mut signed_a: u64 = a; let mut signed_b: u64 = b;
            if (a & sign) != 0 { signed_a = a | ~mask; }
            if (b & sign) != 0 { signed_b = b | ~mask; }
            if op == TargetOpcode::Div { bits = ((signed_a as i64) / (signed_b as i64)) as u64 & mask; }
            else { bits = ((signed_a as i64) % (signed_b as i64)) as u64 & mask; }
        } else {
            if op == TargetOpcode::Div { bits = a / b; } else { bits = a % b; }
        }
    } else if op == TargetOpcode::BitAnd { bits = a & b; }
    else if op == TargetOpcode::BitOr { bits = a | b; }
    else if op == TargetOpcode::BitXor { bits = a ^ b; }
    else if op == TargetOpcode::ShiftLeft || op == TargetOpcode::ShiftRight {
        if b >= width as u64 { return false; }
        if op == TargetOpcode::ShiftLeft {
            if is_signed && ((a & sign) != 0 || a > (sign - 1) >> b) { return false; }
            bits = (a << b) & mask;
        } else if is_signed && (a & sign) != 0 { bits = (((a | ~mask) as i64) >> (b as i64)) as u64 & mask; }
        else { bits = a >> b; }
    } else { return false; }
    unsafe { *result = bits; } return true;
}

fn native_constant_float(op: TargetOpcode, typ: TargetTypeTag,
    left: u64, right: u64, result: &mut u64) -> bool {
    let mut scratch: [u64; 3] = 0;
    let words: *mut u64 = unsafe { scratch as *mut u64 };
    unsafe { *words = left; *(words + 1) = right; }
    if typ == TargetTypeTag::F32 {
        let mut narrow: [u32; 3] = 0;
        let narrow_words: *mut u32 = unsafe { narrow as *mut u32 };
        unsafe { *narrow_words = left as u32; *(narrow_words + 1) = right as u32; }
        let numbers: *mut f32 = unsafe { narrow_words as *mut f32 };
        let a: f32 = unsafe { *numbers }; let b: f32 = unsafe { *(numbers + 1) };
        let zero: f32 = 0.0;
        let mut value: f32 = 0.0;
        if op == TargetOpcode::Add { value = a + b; }
        else if op == TargetOpcode::Sub { value = a - b; }
        else if op == TargetOpcode::Mul { value = a * b; }
        else if op == TargetOpcode::Div { if b == zero { return false; } value = a / b; }
        else { return false; }
        unsafe { *(numbers + 2) = value; }
        let bits: u64 = unsafe { *(narrow_words + 2) } as u64;
        if (bits & 2139095040) == 2139095040 { return false; }
        unsafe { *result = bits; }
    } else if typ == TargetTypeTag::F64 {
        let numbers: *mut f64 = unsafe { words as *mut f64 };
        let a: f64 = unsafe { *numbers }; let b: f64 = unsafe { *(numbers + 1) };
        let mut value: f64 = 0.0;
        if op == TargetOpcode::Add { value = a + b; }
        else if op == TargetOpcode::Sub { value = a - b; }
        else if op == TargetOpcode::Mul { value = a * b; }
        else if op == TargetOpcode::Div { if b == 0.0 { return false; } value = a / b; }
        else { return false; }
        unsafe { *(numbers + 2) = value; }
        let bits: u64 = unsafe { *(words + 2) };
        if (bits & 9218868437227405312) == 9218868437227405312 { return false; }
        unsafe { *result = bits; }
    } else { return false; }
    return true;
}

fn native_constant_compare(predicate: u64, typ: TargetTypeTag,
    left: u64, right: u64, result: &mut u64) -> bool {
    let mut equal: bool = left == right; let mut less: bool = left < right;
    if target_type_is_float(typ) {
        if typ == TargetTypeTag::F32 {
            let mut scratch: [u32; 2] = 0; let words: *mut u32 = unsafe { scratch as *mut u32 };
            unsafe { *words = left as u32; *(words + 1) = right as u32; }
            let numbers: *const f32 = unsafe { words as *const f32 };
            let a: f32 = unsafe { *numbers }; let b: f32 = unsafe { *(numbers + 1) };
            equal = a == b; less = a < b;
        } else {
            let mut scratch: [u64; 2] = 0; let words: *mut u64 = unsafe { scratch as *mut u64 };
            unsafe { *words = left; *(words + 1) = right; }
            let numbers: *const f64 = unsafe { words as *const f64 };
            let a: f64 = unsafe { *numbers }; let b: f64 = unsafe { *(numbers + 1) };
            equal = a == b; less = a < b;
        }
    } else if typ == TargetTypeTag::I8 || typ == TargetTypeTag::I16
        || typ == TargetTypeTag::I32 || typ == TargetTypeTag::I64 || typ == TargetTypeTag::Isize {
        let width: u32 = target_integer_width(typ); let sign: u64 = (1 as u64) << ((width - 1) as u64);
        let negative_left: bool = (left & sign) != 0; let negative_right: bool = (right & sign) != 0;
        if negative_left != negative_right { less = negative_left; }
    } else if !target_type_is_integer(typ) && typ != TargetTypeTag::Bool && typ != TargetTypeTag::Pointer { return false; }
    let mut value: bool = false;
    if predicate == 86 { value = equal; } else if predicate == 87 { value = !equal; }
    else if predicate == 88 { value = less; } else if predicate == 89 { value = less || equal; }
    else if predicate == 90 { value = !less && !equal; } else if predicate == 91 { value = !less; }
    else { return false; }
    let mut bits: u64 = 0; if value { bits = 1; } unsafe { *result = bits; } return true;
}

// Ordered keys map every fixed-width integer domain onto 0..MAX, including
// signed minima. The same transformation converts an ordered key back to bits.
fn native_match_order_key(bits: u64, typ: TargetTypeTag) -> u64 {
    if target_type_is_float(typ) {
        let mut sign: u64 = 9223372036854775808;let mut mask: u64 = 18446744073709551615;
        if typ == TargetTypeTag::F32 { sign=2147483648;mask=4294967295; }
        if (bits & sign) != 0 { return (~bits) & mask; }
        return bits ^ sign;
    }
    let width: u32 = target_integer_width(typ);
    if width == 0 { return bits; }
    let mut mask: u64 = 18446744073709551615;
    if width < 64 { mask = ((1 as u64) << width as u64) - 1; }
    let mut key: u64 = bits & mask;
    if typ == TargetTypeTag::I8 || typ == TargetTypeTag::I16 || typ == TargetTypeTag::I32
        || typ == TargetTypeTag::I64 || typ == TargetTypeTag::Isize {
        key = key ^ ((1 as u64) << (width as u64 - 1));
    }
    return key;
}

fn native_match_float_bits(key: u64, typ: TargetTypeTag) -> u64 {
    let mut sign: u64 = 9223372036854775808;let mut mask: u64 = 18446744073709551615;
    if typ == TargetTypeTag::F32 { sign=2147483648;mask=4294967295; }
    if (key & sign) != 0 { return key ^ sign; }
    return (~key) & mask;
}

fn native_match_float_nan(bits: u64, typ: TargetTypeTag) -> bool {
    if typ == TargetTypeTag::F32 { return (bits & 2139095040) == 2139095040 && (bits & 8388607) != 0; }
    return (bits & 9218868437227405312) == 9218868437227405312 && (bits & 4503599627370495) != 0;
}

fn native_match_float_zero(bits: u64, typ: TargetTypeTag) -> bool {
    if typ == TargetTypeTag::F32 { return (bits & 2147483647) == 0; }
    return (bits & 9223372036854775807) == 0;
}

pub fn native_match_error_text(reason: u32) -> *const u8 {
    if reason == 1 { return "match range requires an integer or float selector"; }
    if reason == 2 { return "match range bounds must be typed integer constants"; }
    if reason == 3 { return "match range is empty or reversed"; }
    if reason == 4 { return "overlapping match patterns"; }
    if reason == 5 { return "non-exhaustive match: cover the domain or add a final wildcard"; }
    if reason == 6 { return "match guard must be a supported Boolean expression"; }
    if reason == 7 { return "final match arm must be unguarded"; }
    if reason == 8 { return "float match pattern requires constant numbers other than NaN"; }
    return "unsupported native form";
}

pub fn native_match_error_length(reason: u32) -> usize {
    let message: *const u8 = native_match_error_text(reason);
    let mut length: usize = 0;
    while length < 256 && unsafe{*(message+length)} != 0 { length=length+1; }
    return length;
}

impl ScalarLowering {
    pub fn append_synthetic_str_symbol(mut self: &mut Self, id: usize) -> TargetSourceSlice {
        let name_off: usize = unsafe { g_extended_len };
        if name_off > TARGET_EXTENDED_SOURCE_CAPACITY - 25 { return TargetSourceSlice::empty(); }
        let src_mut: *mut u8 = self.source as *mut u8;
        unsafe {
            *(src_mut + name_off) = 95;
            *(src_mut + name_off + 1) = 115;
            *(src_mut + name_off + 2) = 116;
            *(src_mut + name_off + 3) = 114;
            *(src_mut + name_off + 4) = 95;
        }
        let mut name_len: usize = 5;
        let mut temp: usize = id;
        if temp == 0 {
            unsafe { *(src_mut + name_off + name_len) = 48; }
            name_len = name_len + 1;
        } else {
            // Write the decimal digits in reverse order to their final
            // destination, then reverse that range in place. This supports
            // every 64-bit usize (up to 20 digits) without a bounded local
            // digit array or out-of-bounds temporary writes.
            let digits_start: usize = name_len;
            while temp > 0 {
                unsafe { *(src_mut + name_off + name_len) = ((temp % 10) as u8) + 48; }
                temp = temp / 10;
                name_len = name_len + 1;
            }
            let mut left: usize = digits_start;
            let mut right: usize = name_len;
            while left < right {
                right = right - 1;
                if left >= right { break; }
                let left_digit: u8 = unsafe { *(src_mut + name_off + left) };
                let right_digit: u8 = unsafe { *(src_mut + name_off + right) };
                unsafe {
                    *(src_mut + name_off + left) = right_digit;
                    *(src_mut + name_off + right) = left_digit;
                }
                left = left + 1;
            }
        }
        unsafe { g_extended_len = g_extended_len + name_len; }
        return TargetSourceSlice {
            offset: name_off,
            length: name_len
        };
    }

    pub fn scalar_memory_size(self: &Self, typ: TargetTypeTag) -> u32 {
        if typ == TargetTypeTag::U8 || typ == TargetTypeTag::I8 || typ == TargetTypeTag::Bool { return 1; }
        if typ == TargetTypeTag::U16 || typ == TargetTypeTag::I16 { return 2; }
        if typ == TargetTypeTag::U32 || typ == TargetTypeTag::I32 || typ == TargetTypeTag::F32 { return 4; }
        if typ == TargetTypeTag::U64 || typ == TargetTypeTag::I64 || typ == TargetTypeTag::Usize || typ == TargetTypeTag::Pointer || typ == TargetTypeTag::F64 { return 8; }
        return 0;
    }

    pub fn parse_array_element_struct(self: &Self, type_offset: usize, type_len: usize) -> u32 {
        if self.source == null || type_len < 4 || type_offset > self.source_len
            || type_len > self.source_len - type_offset
            || unsafe { *(self.source + type_offset) } != 91 { return 0; }
        let mut start: usize = 1;
        while start < type_len {
            let ch: u8 = unsafe { *(self.source + type_offset + start) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 { start = start + 1; }
            else { break; }
        }
        let mut finish: usize = start;
        while finish < type_len && unsafe { *(self.source + type_offset + finish) } != 59 {
            finish = finish + 1;
        }
        if finish == type_len { return 0; }
        while finish > start {
            let ch: u8 = unsafe { *(self.source + type_offset + finish - 1) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 { finish = finish - 1; }
            else { break; }
        }
        return self.find_struct(type_offset + start, finish - start);
    }

    pub fn parse_array_element_type(
        self: &Self,
        type_offset: usize,
        type_len: usize
    ) -> TargetTypeTag {
        if self.source == null || type_len < 4 || type_offset > self.source_len
            || type_len > self.source_len - type_offset
            || unsafe { *(self.source + type_offset) } != 91 {
            return TargetTypeTag::Invalid;
        }
        let mut start: usize = 1;
        while start < type_len {
            let ch: u8 = unsafe { *(self.source + type_offset + start) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                start = start + 1;
            } else {
                break;
            }
        }
        let mut sep: usize = start;
        while sep < type_len
            && unsafe { *(self.source + type_offset + sep) } != 59 {
            sep = sep + 1;
        }
        if sep >= type_len { return TargetTypeTag::Invalid; }
        let mut finish: usize = sep;
        while finish > start {
            let ch: u8 = unsafe { *(self.source + type_offset + finish - 1) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                finish = finish - 1;
            } else {
                break;
            }
        }
        if finish <= start { return TargetTypeTag::Invalid; }
        let elem_len: usize = finish - start;
        let mut sem: Sema = Sema::new();
        let elem_offset: usize = type_offset + start;
        if sem.source_slice_equals(self.source, self.source_len,
            elem_offset, elem_len, "f32", 3) { return TargetTypeTag::F32; }
        if sem.source_slice_equals(self.source, self.source_len,
            elem_offset, elem_len, "f64", 3) { return TargetTypeTag::F64; }
        if sem.source_slice_equals(self.source, self.source_len,
            elem_offset, elem_len, "bool", 4) { return TargetTypeTag::Bool; }
        if unsafe { *(self.source + elem_offset) } == 42 { return TargetTypeTag::Pointer; }
        if self.find_struct(elem_offset, elem_len) != 0 { return TargetTypeTag::Aggregate; }
        if sem.source_slice_equals(
            self.source, self.source_len, elem_offset, elem_len, "u8", 2
        ) { return TargetTypeTag::U8; }
        if sem.source_slice_equals(
            self.source, self.source_len, elem_offset, elem_len, "i8", 2
        ) { return TargetTypeTag::I8; }
        if sem.source_slice_equals(
            self.source, self.source_len, elem_offset, elem_len, "u16", 3
        ) { return TargetTypeTag::U16; }
        if sem.source_slice_equals(
            self.source, self.source_len, elem_offset, elem_len, "i16", 3
        ) { return TargetTypeTag::I16; }
        if sem.source_slice_equals(
            self.source, self.source_len, elem_offset, elem_len, "u32", 3
        ) { return TargetTypeTag::U32; }
        if sem.source_slice_equals(
            self.source, self.source_len, elem_offset, elem_len, "i32", 3
        ) { return TargetTypeTag::I32; }
        if sem.source_slice_equals(
            self.source, self.source_len, elem_offset, elem_len, "u64", 3
        ) { return TargetTypeTag::U64; }
        if sem.source_slice_equals(
            self.source, self.source_len, elem_offset, elem_len, "i64", 3
        ) { return TargetTypeTag::I64; }
        if sem.source_slice_equals(
            self.source, self.source_len, elem_offset, elem_len, "usize", 5
        ) { return TargetTypeTag::U64; }
        return TargetTypeTag::Invalid;
    }

    pub fn parse_array_element_stride(
        self: &Self,
        type_offset: usize,
        type_len: usize
    ) -> usize {
        let elem_type: TargetTypeTag = self.parse_array_element_type(
            type_offset, type_len
        );
        if elem_type == TargetTypeTag::U8 || elem_type == TargetTypeTag::I8 || elem_type == TargetTypeTag::Bool { return 1; }
        if elem_type == TargetTypeTag::U16 || elem_type == TargetTypeTag::I16 { return 2; }
        if elem_type == TargetTypeTag::U32 || elem_type == TargetTypeTag::I32 || elem_type == TargetTypeTag::F32 { return 4; }
        if elem_type == TargetTypeTag::U64 || elem_type == TargetTypeTag::I64 || elem_type == TargetTypeTag::Pointer || elem_type == TargetTypeTag::F64 { return 8; }
        if elem_type == TargetTypeTag::Aggregate {
            let struct_id: u32 = self.parse_array_element_struct(type_offset, type_len);
            if struct_id != 0 { return self.struct_sizes[struct_id as usize - 1] as usize; }
        }
        return 0;
    }

    pub fn parse_array_element_count(
        self: &Self,
        type_offset: usize,
        type_len: usize
    ) -> usize {
        if self.source == null || type_offset > self.source_len
            || type_len > self.source_len - type_offset {
            return 0;
        }
        return native_fixed_array_count(unsafe{self.source+type_offset},type_len);
    }

    pub fn parse_array_type_size(self: &Self, type_offset: usize, type_len: usize) -> usize {
        let stride: usize = self.parse_array_element_stride(type_offset, type_len);
        let count: usize = self.parse_array_element_count(type_offset, type_len);
        if stride == 0 || count == 0 { return 8; }
        return stride * count;
    }

    pub fn module_let_is_const(self: &Self, node: AstNode) -> bool {
        if self.source == null || node.kind != AstKind::LetStmt
            || node.span.length != 5 || node.span.offset > self.source_len
            || node.span.length > self.source_len - node.span.offset {
            return false;
        }
        return unsafe {
            *(self.source + node.span.offset) == 99
                && *(self.source + node.span.offset + 1) == 111
                && *(self.source + node.span.offset + 2) == 110
                && *(self.source + node.span.offset + 3) == 115
                && *(self.source + node.span.offset + 4) == 116
        };
    }

    pub fn register_module_integer_const(
        mut self: &mut Self,
        decl_index: usize
    ) -> bool {
        if self.nodes == null || decl_index == 0 || decl_index >= self.node_count
            || self.const_count >= 64 {
            return false;
        }
        let decl: AstNode = unsafe { *(self.nodes + decl_index) };
        if !self.module_let_is_const(decl) || decl.str_len == 0
            || decl.first_child == 0 || decl.first_child >= self.node_count {
            return false;
        }
        let type_index: usize = decl.first_child;
        let type_node: AstNode = unsafe { *(self.nodes + type_index) };
        let literal_index: usize = type_node.next_sibling;
        if type_node.kind != AstKind::TypeRef || literal_index == 0
            || literal_index >= self.node_count {
            return false;
        }
        let literal: AstNode = unsafe { *(self.nodes + literal_index) };
        if literal.next_sibling != 0 { return false; }
        let type_tag: TargetTypeTag = self.type_tag_for(type_index);
        if !target_type_is_integer(type_tag) && !target_type_is_float(type_tag)
            && type_tag != TargetTypeTag::Bool { return false; }
        if self.find_module_const(decl.str_offset, decl.str_len) >= 0 { return false; }
        let slot: usize = self.const_count;
        self.const_name_offsets[slot] = decl.str_offset;
        self.const_name_lens[slot] = decl.str_len;
        self.const_type_tags[slot] = type_tag as u32;
        self.const_literal_nodes[slot] = literal_index;
        self.const_bits[slot] = 0;
        self.const_states[slot] = 0;
        self.const_count = self.const_count + 1;
        return true;
    }

    // 0=pending, 1=resolving, 2=ready, 3=failed. A resolving dependency
    // is a cycle, never a provisional zero value.
    pub fn resolve_module_const(mut self: &mut Self, slot: usize) -> bool {
        if slot >= self.const_count || slot >= 64 { return false; }
        if self.const_states[slot] == 2 { return true; }
        if self.const_states[slot] != 0 { return false; }
        self.const_states[slot] = 1;
        let mut bits: u64 = 0;
        let valid: bool = self.constant_literal_bits(self.const_literal_nodes[slot],
            self.const_type_tags[slot] as TargetTypeTag, &mut bits);
        if !valid { self.const_states[slot] = 3; return false; }
        self.const_bits[slot] = bits;
        self.const_states[slot] = 2;
        return true;
    }

    pub fn find_module_const(self: &Self, offset: usize, len: usize) -> isize {
        let mut index: usize = 0;
        while index < self.const_count {
            if self.source_name_equals(
                self.const_name_offsets[index],
                self.const_name_lens[index],
                offset,
                len
            ) {
                return index as isize;
            }
            index = index + 1;
        }
        return -1;
    }

    // Evaluate literal initialization with the normal typed lowering rules.
    // Restore all temporary arena identities before returning to module lowering.
    pub fn constant_shape_valid(self: &Self, index: usize, depth: usize) -> bool {
        if index == 0 || index >= self.node_count || depth >= 64 { return false; }
        let node: AstNode = unsafe { *(self.nodes + index) };
        if node.kind == AstKind::ExprLiteral || node.kind == AstKind::ExprPath { return true; }
        if node.kind == AstKind::ExprIdent {
            let mut sem: Sema = Sema::new();
            return self.find_module_const(node.str_offset, node.str_len) >= 0
                || sem.source_slice_equals(self.source, self.source_len, node.str_offset, node.str_len, "null", 4);
        }
        if node.kind == AstKind::ExprCast {
            let value: usize = node.first_child;
            if value == 0 || value >= self.node_count || !self.constant_shape_valid(value, depth + 1) { return false; }
            let typ: usize = unsafe { (*(self.nodes + value)).next_sibling };
            return typ != 0 && typ < self.node_count && unsafe { (*(self.nodes + typ)).kind } == AstKind::TypeRef
                && unsafe { (*(self.nodes + typ)).next_sibling } == 0;
        }
        if node.kind == AstKind::UnsafeExpr {
            return node.first_child != 0 && node.first_child < self.node_count
                && unsafe { (*(self.nodes + node.first_child)).next_sibling } == 0
                && self.constant_shape_valid(node.first_child, depth + 1);
        }
        if node.kind != AstKind::ExprUnary && node.kind != AstKind::ExprBinary
            && node.kind != AstKind::ExprConditional { return false; }
        let mut child: usize = node.first_child; let mut count: usize = 0;
        while child != 0 {
            if child >= self.node_count || !self.constant_shape_valid(child, depth + 1) { return false; }
            child = unsafe { (*(self.nodes + child)).next_sibling }; count = count + 1;
        }
        if node.kind == AstKind::ExprUnary { return count == 1; }
        if node.kind == AstKind::ExprBinary { return count == 2; }
        return count == 3;
    }

    // Validate inactive arms with the same typed lowering, but do not execute
    // their arithmetic. Temporary instructions never escape this check.
    pub fn constant_branch_valid(mut self: &mut Self, index: usize, typ: TargetTypeTag) -> bool {
        if self.constant_depth >= 64 || !self.constant_shape_valid(index, 0) { return false; }
        let values_before: usize = self.value_count; let instructions_before: usize = self.instruction_count;
        let operands_before: usize = self.operand_count; let next_before: u32 = self.next_value_id;
        let evaluation_before: bool = self.constant_evaluation;
        let validation_before: bool = self.constant_validation_only;
        self.constant_depth = self.constant_depth + 1;
        self.constant_evaluation = true; self.constant_validation_only = true;
        let value: u32 = self.lower_expression(index, typ, 0, 0);
        let count: usize = self.instruction_count - instructions_before;
        let mut valid: bool = value != 0 && value as usize <= self.value_count
            && unsafe { (*(self.values + value as usize - 1)).type_tag } == typ && count > 0 && count <= 128;
        let mut cursor: usize = instructions_before;
        while valid && cursor < self.instruction_count {
            let instruction: TargetInstruction = unsafe { *(self.instructions + cursor) };
            if instruction.result_value == 0 { valid = false; }
            if instruction.opcode == TargetOpcode::Compare && instruction.operand_count == 2 {
                let first: u32 = unsafe { (*(self.operands + instruction.first_operand as usize)).value_id };
                let second: u32 = unsafe { (*(self.operands + instruction.first_operand as usize + 1)).value_id };
                if first == 0 || second == 0 || first as usize > self.value_count || second as usize > self.value_count
                    || unsafe { (*(self.values + first as usize - 1)).type_tag }
                        != unsafe { (*(self.values + second as usize - 1)).type_tag } { valid = false; }
            } else {
                let mut operand: usize = 0;
                while valid && operand < instruction.operand_count as usize {
                    let id: u32 = unsafe { (*(self.operands + instruction.first_operand as usize + operand)).value_id };
                    if id == 0 || id as usize > self.value_count
                        || unsafe { (*(self.values + id as usize - 1)).type_tag } != instruction.type_tag { valid = false; }
                    operand = operand + 1;
                }
            }
            cursor = cursor + 1;
        }
        self.value_count = values_before; self.instruction_count = instructions_before;
        self.operand_count = operands_before; self.next_value_id = next_before;
        self.constant_evaluation = evaluation_before; self.constant_validation_only = validation_before;
        self.constant_depth = self.constant_depth - 1;
        return valid;
    }

    pub fn constant_control_bits(mut self: &mut Self, index: usize, typ: TargetTypeTag, bits: &mut u64) -> bool {
        if index == 0 || index >= self.node_count { return false; }
        let node: AstNode = unsafe { *(self.nodes + index) };
        let condition: usize = node.first_child;
        if condition == 0 || condition >= self.node_count { return false; }
        let yes: usize = unsafe { (*(self.nodes + condition)).next_sibling };
        if yes == 0 || yes >= self.node_count { return false; }
        if node.kind == AstKind::ExprConditional {
            let no: usize = unsafe { (*(self.nodes + yes)).next_sibling };
            if no == 0 || no >= self.node_count || unsafe { (*(self.nodes + no)).next_sibling } != 0
                || !self.constant_branch_valid(condition, TargetTypeTag::Bool)
                || !self.constant_branch_valid(yes, typ) || !self.constant_branch_valid(no, typ) { return false; }
            if self.constant_validation_only { unsafe { *bits = 0; } return true; }
            let mut selected: u64 = 0;
            if !self.constant_literal_bits(condition, TargetTypeTag::Bool, &mut selected) || selected > 1 { return false; }
            if selected == 1 { return self.constant_literal_bits(yes, typ, bits); }
            return self.constant_literal_bits(no, typ, bits);
        }
        if node.kind != AstKind::ExprBinary || typ != TargetTypeTag::Bool
            || (node.int_value != 110 && node.int_value != 111)
            || unsafe { (*(self.nodes + yes)).next_sibling } != 0
            || !self.constant_branch_valid(condition, TargetTypeTag::Bool)
            || !self.constant_branch_valid(yes, TargetTypeTag::Bool) { return false; }
        if self.constant_validation_only { unsafe { *bits = 0; } return true; }
        let mut left: u64 = 0;
        if !self.constant_literal_bits(condition, TargetTypeTag::Bool, &mut left) || left > 1 { return false; }
        if (node.int_value == 110 && left == 0) || (node.int_value == 111 && left == 1) {
            unsafe { *bits = left; } return true;
        }
        return self.constant_literal_bits(yes, TargetTypeTag::Bool, bits);
    }

    pub fn constant_literal_bits(mut self: &mut Self, expression_index: usize,
        typ: TargetTypeTag, result: &mut u64) -> bool {
        if self.constant_depth >= 64 || !self.constant_shape_valid(expression_index, 0) { return false; }
        let validation_before: bool = self.constant_validation_only;
        self.constant_validation_only = false; self.constant_depth = self.constant_depth + 1;
        let valid: bool = self.constant_expression_bits(expression_index, typ, result);
        self.constant_validation_only = validation_before; self.constant_depth = self.constant_depth - 1;
        return valid;
    }

    pub fn constant_expression_bits(mut self: &mut Self, expression_index: usize,
        typ: TargetTypeTag, result: &mut u64) -> bool {
        if expression_index == 0 || expression_index >= self.node_count { return false; }
        let expression: AstNode = unsafe { *(self.nodes + expression_index) };
        let values_before: usize = self.value_count;
        let instructions_before: usize = self.instruction_count;
        let operands_before: usize = self.operand_count;
        let next_before: u32 = self.next_value_id;
        let evaluation_before: bool = self.constant_evaluation;
        self.constant_evaluation = true;
        let value: u32 = self.lower_expression(expression_index, typ, 0, 0);
        let count: usize = self.instruction_count - instructions_before;
        let mut valid: bool = value != 0 && value as usize <= self.value_count
            && unsafe { (*(self.values + value as usize - 1)).type_tag } == typ
            && count != 0 && count <= 128;
        let mut constants: [u64; 128] = 0;
        let mut ids: [u32; 128] = 0;
        let mut bits: u64 = 0;
        let mut index: usize = 0;
        while valid && index < count {
            let instruction: TargetInstruction = unsafe { *(self.instructions + instructions_before + index) };
            let mut current: u64 = instruction.immediate_bits;
            if instruction.opcode != TargetOpcode::ConstInt && instruction.opcode != TargetOpcode::ConstFloat {
                let mut first: usize = 128; let mut second: usize = 128;
                if instruction.operand_count != 0 && instruction.first_operand as usize < self.operand_count {
                    let first_id: u32 = unsafe { (*(self.operands + instruction.first_operand as usize)).value_id };
                    let mut prior: usize = 0;
                    while prior < index { if ids[prior] == first_id { first = prior; break; } prior = prior + 1; }
                }
                if instruction.operand_count == 2 && instruction.first_operand as usize + 1 < self.operand_count {
                    let second_id: u32 = unsafe { (*(self.operands + instruction.first_operand as usize + 1)).value_id };
                    let mut prior: usize = 0;
                    while prior < index { if ids[prior] == second_id { second = prior; break; } prior = prior + 1; }
                }
                if first < index && instruction.opcode != TargetOpcode::Compare
                    && unsafe { (*(self.values + ids[first] as usize - 1)).type_tag } != instruction.type_tag { valid = false; }
                if second < index && instruction.opcode != TargetOpcode::Compare
                    && unsafe { (*(self.values + ids[second] as usize - 1)).type_tag } != instruction.type_tag { valid = false; }
                if instruction.opcode == TargetOpcode::FloatNeg && first < index && instruction.operand_count == 1 {
                    current = constants[first] ^ 9223372036854775808;
                    if instruction.type_tag == TargetTypeTag::F32 { current = constants[first] ^ 2147483648; }
                } else if (instruction.opcode == TargetOpcode::BoolAnd || instruction.opcode == TargetOpcode::BoolOr)
                    && first < index && second < index && constants[first] <= 1 && constants[second] <= 1 {
                    if instruction.opcode == TargetOpcode::BoolAnd { current = constants[first] & constants[second]; }
                    else { current = constants[first] | constants[second]; }
                } else if instruction.opcode == TargetOpcode::Compare && first < index && second < index {
                    let operand_type: TargetTypeTag = unsafe { (*(self.values + ids[first] as usize - 1)).type_tag };
                    valid = operand_type == unsafe { (*(self.values + ids[second] as usize - 1)).type_tag }
                        && native_constant_compare(instruction.immediate_bits, operand_type, constants[first], constants[second], &mut current);
                } else if first < index && second < index && instruction.operand_count == 2 {
                    if target_type_is_float(instruction.type_tag) {
                        valid = native_constant_float(instruction.opcode, instruction.type_tag,
                            constants[first], constants[second], &mut current);
                    } else {
                        valid = native_constant_integer(instruction.opcode, instruction.type_tag,
                            constants[first], constants[second], &mut current);
                    }
                } else { valid = false; }
            }
            if instruction.result_value == 0 { valid = false; }
            constants[index] = current; ids[index] = instruction.result_value;
            if instruction.result_value == value { bits = current; }
            index = index + 1;
        }
        self.value_count = values_before; self.instruction_count = instructions_before;
        self.operand_count = operands_before; self.next_value_id = next_before;
        self.constant_evaluation = evaluation_before;
        if valid { unsafe { *result = bits; } }
        return valid;
    }

    pub fn find_global_bss(self: &Self, offset: usize, len: usize) -> isize {
        let count: usize = unsafe { g_bss_sym_count };
        let mut i: usize = 0;
        while i < count {
            if self.source_name_equals(unsafe { g_bss_sym_offsets[i] }, unsafe { g_bss_sym_lens[i] }, offset, len) {
                return i as isize;
            }
            i = i + 1;
        }
        return -1;
    }

    pub fn lower_string_literal(mut self: &mut Self, expression_index: usize) -> u32 {
        let node: AstNode = unsafe { *(self.nodes + expression_index) };
        if node.str_len < 2 { return TARGET_VALUE_NONE; }
        // Every string address must have a registered symbol and relocation.
        // Reject capacity exhaustion instead of producing an unpatched LEA.
        let sym_idx: usize = unsafe { g_rodata_sym_count };
        if sym_idx >= TARGET_RODATA_SYMBOL_CAPACITY { return TARGET_VALUE_NONE; }
        let rodata_start: usize = unsafe { g_rodata_len };
        let mut src_i: usize = 1;
        let mut end_i: usize = node.str_len;
        if unsafe { *(self.source + node.str_offset + node.str_len - 1) } == 34 {
            end_i = node.str_len - 1;
        }
        let mut cur_len: usize = rodata_start;
        while src_i < end_i {
            let mut ch: u8 = unsafe { *(self.source + node.str_offset + src_i) };
            if ch == 92 && src_i + 1 < end_i {
                src_i = src_i + 1;
                let next_ch: u8 = unsafe { *(self.source + node.str_offset + src_i) };
                if next_ch == 110 { ch = 10; }
                else if next_ch == 114 { ch = 13; }
                else if next_ch == 116 { ch = 9; }
                else if next_ch == 98 { ch = 8; }
                else if next_ch == 102 { ch = 12; }
                else if next_ch == 118 { ch = 11; }
                else if next_ch == 48 { ch = 0; }
                else if next_ch == 92 { ch = 92; }
                else if next_ch == 34 { ch = 34; }
                else if next_ch == 120 {
                    if src_i + 2 >= end_i { return TARGET_VALUE_NONE; }
                    let mut byte_value: u32 = 0;
                    let mut digit_index: usize = 1;
                    while digit_index <= 2 {
                        let digit_char: u32 = unsafe { *(self.source + node.str_offset + src_i + digit_index) } as u32;
                        let mut digit: u32 = 0;
                        if digit_char >= 48 && digit_char <= 57 { digit = digit_char - 48; }
                        else if digit_char >= 65 && digit_char <= 70 { digit = digit_char - 55; }
                        else if digit_char >= 97 && digit_char <= 102 { digit = digit_char - 87; }
                        else { return TARGET_VALUE_NONE; }
                        byte_value = byte_value * 16 + digit;
                        digit_index = digit_index + 1;
                    }
                    ch = byte_value as u8;
                    src_i = src_i + 2;
                }
                else if next_ch == 117 {
                    if src_i+1 >= end_i || unsafe{*(self.source+node.str_offset+src_i+1)} != 123 { return 0; }
                    let mut cursor: usize=src_i+2;let mut scalar: u32=0;let mut digits: u32=0;
                    while cursor < end_i && unsafe{*(self.source+node.str_offset+cursor)} != 125 {
                        let byte: u8=unsafe{*(self.source+node.str_offset+cursor)};let mut digit: u32=255;
                        if byte >= 48 && byte <= 57 { digit=(byte-48) as u32; }
                        if byte >= 65 && byte <= 70 { digit=(byte-55) as u32; }
                        if byte >= 97 && byte <= 102 { digit=(byte-87) as u32; }
                        if digit > 15 || digits == 6 { return 0; }
                        scalar=scalar*16+digit;digits=digits+1;cursor=cursor+1;
                    }
                    if cursor == end_i || digits == 0 || scalar > 1114111
                        || (scalar >= 55296 && scalar <= 57343) { return 0; }
                    src_i=cursor;
                    let mut width: usize=1;
                    if scalar > 127 { width=2; }if scalar > 2047 { width=3; }if scalar > 65535 { width=4; }
                    let limit: usize=65535;
                    if cur_len >= limit || width > limit-cur_len { return 0; }
                    if width == 1 { ch=scalar as u8; }
                    else {
                        let mut prefix: u32=192;if width == 3 { prefix=224; }if width == 4 { prefix=240; }
                        let mut byte_index: usize=0;
                        while byte_index+1 < width {
                            let shift: u32=((width-byte_index-1)*6) as u32;
                            let mut encoded: u32=128 | ((scalar >> shift) & 63);
                            if byte_index == 0 { encoded=prefix | (scalar >> shift); }
                            unsafe{g_rodata_buf[cur_len]=encoded as u8;}cur_len=cur_len+1;byte_index=byte_index+1;
                        }
                        ch=(128 | (scalar & 63)) as u8;
                    }
                }
                else if next_ch == 39 { ch = 39; }
                else { return TARGET_VALUE_NONE; }
            }
            if cur_len >= 65535 { return TARGET_VALUE_NONE; }
            unsafe { g_rodata_buf[cur_len] = ch; }
            cur_len = cur_len + 1;
            src_i = src_i + 1;
        }
        if cur_len >= 65536 { return TARGET_VALUE_NONE; }
        unsafe { g_rodata_buf[cur_len] = 0; }
        cur_len = cur_len + 1;
        let str_bytes_len: usize = cur_len - rodata_start;
        unsafe { g_rodata_len = cur_len; }

        let sym_slice: TargetSourceSlice = self.append_synthetic_str_symbol(sym_idx);
        if sym_slice.length == 0 { return TARGET_VALUE_NONE; }
        unsafe {
            g_rodata_sym_offsets[sym_idx] = sym_slice.offset;
            g_rodata_sym_lens[sym_idx] = sym_slice.length;
            g_rodata_sym_places[sym_idx] = rodata_start;
            g_rodata_sym_sizes[sym_idx] = str_bytes_len;
            g_rodata_sym_count = sym_idx + 1;
        }

        let ptr_val: u32 = self.append_value(TargetTypeTag::Pointer, 0, 0);
        if ptr_val == TARGET_VALUE_NONE { return TARGET_VALUE_NONE; }
        if !self.append_instruction(
            TargetOpcode::AllocStack, ptr_val, TargetTypeTag::Pointer,
            0, 0, expression_index
        ) {
            return TARGET_VALUE_NONE;
        }
        let alloc_idx: usize = self.instruction_count - 1;
        let mut instr: TargetInstruction = unsafe { *(self.instructions + alloc_idx) };
        instr.immediate_bits = str_bytes_len as u64;
        instr.symbol = sym_slice;
        unsafe { *(self.instructions + alloc_idx) = instr; }
        return ptr_val;
    }

    pub fn append_mangled_name(
        mut self: &mut Self,
        struct_offset: usize,
        struct_len: usize,
        method_offset: usize,
        method_len: usize
    ) -> TargetSourceSlice {
        let name_off: usize = unsafe { g_extended_len };
        let name_len: usize = struct_len + 1 + method_len;
        if name_off > TARGET_EXTENDED_SOURCE_CAPACITY
            || name_len > TARGET_EXTENDED_SOURCE_CAPACITY - name_off { return TargetSourceSlice::empty(); }
        let mut i: usize = 0;
        let src_mut: *mut u8 = self.source as *mut u8;
        while i < struct_len {
            unsafe { *(src_mut + name_off + i) = *(self.source + struct_offset + i); }
            i = i + 1;
        }
        unsafe { *(src_mut + name_off + struct_len) = 95; }
        i = 0;
        while i < method_len {
            unsafe { *(src_mut + name_off + struct_len + 1 + i) = *(self.source + method_offset + i); }
            i = i + 1;
        }
        unsafe { g_extended_len = g_extended_len + name_len; }
        return TargetSourceSlice {
            offset: name_off,
            length: name_len
        };
    }

    pub fn new(
        nodes: *const AstNode,
        node_count: usize,
        source: *const u8,
        source_len: usize,
        values: *mut TargetValue,
        value_capacity: usize,
        parameters: *mut TargetParameter,
        parameter_capacity: usize,
        instructions: *mut TargetInstruction,
        instruction_capacity: usize,
        operands: *mut TargetOperand,
        operand_capacity: usize,
        phi_inputs: *mut TargetPhiInput,
        phi_input_capacity: usize,
        blocks: *mut TargetBlock,
        block_capacity: usize,
        targets: *mut u32,
        target_capacity: usize,
        functions: *mut TargetFunction,
        function_capacity: usize
    ) -> ScalarLowering {
        return ScalarLowering {
            nodes: nodes,
            node_count: node_count,
            source: source,
            source_len: source_len,
            values: values,
            value_capacity: value_capacity,
            value_count: 0,
            parameters: parameters,
            parameter_capacity: parameter_capacity,
            parameter_count: 0,
            instructions: instructions,
            instruction_capacity: instruction_capacity,
            instruction_count: 0,
            operands: operands,
            operand_capacity: operand_capacity,
            operand_count: 0,
            phi_inputs: phi_inputs,
            phi_input_capacity: phi_input_capacity,
            phi_input_count: 0,
            blocks: blocks,
            block_capacity: block_capacity,
            block_count: 0,
            targets: targets,
            target_capacity: target_capacity,
            target_count: 0,
            functions: functions,
            function_capacity: function_capacity,
            function_count: 0,
            next_value_id: 1,
            error_node: 0,
            error_reason: 0,
            local_name_offsets: [0; 128],
            local_name_lens: [0; 128],
            local_value_ids: [0; 128],
            local_struct_ids: [0; 128],
            local_storage_types: [0; 128],
            local_array_types: [0; 128],
            local_array_counts: [0; 128],
            structured_cfg: false,
            return_struct_id: 0,
            return_destination: 0,
            forwarded_return_call: 0,
            match_yield_storage: 0,
            match_yield_type: TargetTypeTag::Invalid,
            match_yield_record: 0,
            cfg_current: 0,
            cfg_first_instruction: 0,
            local_count: 0,
            struct_name_offsets: [0; 32],
            struct_name_lens: [0; 32],
            struct_sizes: [0; 32],
            struct_alignments: [0; 32],
            struct_field_starts: [0; 32],
            struct_field_counts: [0; 32],
            struct_count: 0,
            field_name_offsets: [0; 256],
            field_name_lens: [0; 256],
            field_offsets: [0; 256],
            field_type_tags: [0; 256],
            field_struct_ids: [0; 256],
            field_byte_counts: [0; 256],
            field_array_types: [0; 256],
            field_array_structs: [0; 256],
            field_type_refs: [0; 256],
            field_total_count: 0,
            enum_name_offsets: [0; 32],
            enum_name_lens: [0; 32],
            enum_variant_starts: [0; 32],
            enum_variant_counts: [0; 32],
            enum_count: 0,
            enum_record_ids: [0;32],
            variant_nodes: [0;256],
            variant_field_starts: [0;256],
            variant_field_counts: [0;256],
            variant_name_offsets: [0; 256],
            variant_name_lens: [0; 256],
            variant_values: [0; 256],
            variant_total_count: 0,
            const_name_offsets: [0; 64],
            const_name_lens: [0; 64],
            const_type_tags: [0; 64],
            const_literal_nodes: [0; 64],
            const_bits: [0; 64],
            const_states: [0; 64],
            const_count: 0,
            constant_evaluation: false,
            constant_validation_only: false,
            constant_depth: 0,
            defer_nodes: [0;128], defer_locals: [0;128],
            defer_count: 0, loop_defer_base: 0
        };
    }

    pub fn reject(mut self: &mut Self, node_index: usize) -> bool {
        self.value_count = 0;
        self.parameter_count = 0;
        self.instruction_count = 0;
        self.operand_count = 0;
        self.phi_input_count = 0;
        self.block_count = 0;
        self.target_count = 0;
        self.function_count = 0;
        self.local_count = 0;
        self.struct_count = 0;
        self.field_total_count = 0;
        self.enum_count = 0;
        self.variant_total_count = 0;
        self.const_count = 0;
        self.next_value_id = 1;
        if self.error_node == 0 { self.error_node = node_index; }
        return false;
    }

    pub fn reject_match(mut self: &mut Self, node_index: usize, reason: u32) -> bool {
        if self.error_reason == 0 { self.error_reason = reason; }
        return self.reject(node_index);
    }

    pub fn type_tag_for(self: &Self, type_index: usize) -> TargetTypeTag {
        if self.nodes == null || self.source == null || type_index == 0
            || type_index >= self.node_count {
            return TargetTypeTag::Invalid;
        }
        let type_node: AstNode = unsafe { *(self.nodes + type_index) };
        let mut sem: Sema = Sema::new();
        if type_node.kind == AstKind::TypeRef && type_node.str_len >= 1 {
            let first_ch: u8 = unsafe { *(self.source + type_node.str_offset) };
            if first_ch == 42 || first_ch == 38 {
                return TargetTypeTag::Pointer;
            }
            if type_node.str_len == 4 && sem.source_slice_equals(
                self.source, self.source_len, type_node.str_offset, type_node.str_len, "Self", 4
            ) {
                return TargetTypeTag::Pointer;
            }
        }
        if type_node.kind == AstKind::TypeRef && sem.source_slice_equals(
            self.source, self.source_len, type_node.str_offset, type_node.str_len,
            "bool", 4
        ) {
            return TargetTypeTag::Bool;
        }
        if type_node.kind == AstKind::TypeRef && sem.source_slice_equals(
            self.source, self.source_len, type_node.str_offset, type_node.str_len,
            "void", 4
        ) { return TargetTypeTag::Void; }
        if type_node.kind == AstKind::TypeRef && type_node.str_len >= 1 {
            let struct_id: u32 = self.find_struct(type_node.str_offset, type_node.str_len);
            if struct_id != 0 {
                return TargetTypeTag::Pointer;
            }
            let enum_id: u32 = self.find_enum(type_node.str_offset, type_node.str_len);
            if enum_id != 0 {
                return TargetTypeTag::U32;
            }
        }
        if sem.source_slice_equals(self.source, self.source_len,
            type_node.str_offset, type_node.str_len, "f32", 3) { return TargetTypeTag::F32; }
        if sem.source_slice_equals(self.source, self.source_len,
            type_node.str_offset, type_node.str_len, "f64", 3) { return TargetTypeTag::F64; }
        let tag: i64 = sem.fixed_integer_type_tag(
            self.nodes,
            self.node_count,
            type_index,
            self.source,
            self.source_len
        );
        if tag == 1 { return TargetTypeTag::I8; }
        if tag == 2 { return TargetTypeTag::I16; }
        if tag == 3 { return TargetTypeTag::I32; }
        if tag == 4 { return TargetTypeTag::I64; }
        if tag == 5 { return TargetTypeTag::U8; }
        if tag == 6 { return TargetTypeTag::U16; }
        if tag == 7 { return TargetTypeTag::U32; }
        if tag == 8 { return TargetTypeTag::U64; }
        return TargetTypeTag::Invalid;
    }

    pub fn pointer_pointee_type_tag(
        self: &Self,
        type_index: usize
    ) -> TargetTypeTag {
        if self.nodes == null || self.source == null || type_index == 0
            || type_index >= self.node_count {
            return TargetTypeTag::Invalid;
        }
        let type_node: AstNode = unsafe { *(self.nodes + type_index) };
        if type_node.kind != AstKind::TypeRef || type_node.str_len < 2
            || type_node.str_offset > self.source_len
            || type_node.str_len > self.source_len - type_node.str_offset {
            return TargetTypeTag::Invalid;
        }
        let mut start: usize = 0;
        while start < type_node.str_len {
            let ch: u8 = unsafe { *(self.source + type_node.str_offset + start) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                start = start + 1;
            } else {
                break;
            }
        }
        if start >= type_node.str_len { return TargetTypeTag::Invalid; }
        let prefix: u8 = unsafe { *(self.source + type_node.str_offset + start) };
        if prefix != 42 && prefix != 38 {
            return TargetTypeTag::Invalid;
        }
        start = start + 1;
        while start < type_node.str_len {
            let ch: u8 = unsafe { *(self.source + type_node.str_offset + start) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                start = start + 1;
            } else {
                break;
            }
        }

        let mut sem: Sema = Sema::new();
        if start + 5 <= type_node.str_len && sem.source_slice_equals(
            self.source, self.source_len,
            type_node.str_offset + start, 5, "const", 5
        ) {
            start = start + 5;
        } else if start + 3 <= type_node.str_len && sem.source_slice_equals(
            self.source, self.source_len,
            type_node.str_offset + start, 3, "mut", 3
        ) {
            start = start + 3;
        } else if prefix == 42 {
            return TargetTypeTag::Invalid;
        }
        while start < type_node.str_len {
            let ch: u8 = unsafe { *(self.source + type_node.str_offset + start) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                start = start + 1;
            } else {
                break;
            }
        }
        if start >= type_node.str_len {
            return TargetTypeTag::Invalid;
        }

        let pointee_offset: usize = type_node.str_offset + start;
        let pointee_len: usize = type_node.str_len - start;
        if sem.source_slice_equals(
            self.source, self.source_len, pointee_offset, pointee_len, "u8", 2
        ) { return TargetTypeTag::U8; }
        if sem.source_slice_equals(
            self.source, self.source_len, pointee_offset, pointee_len, "i8", 2
        ) { return TargetTypeTag::I8; }
        if sem.source_slice_equals(
            self.source, self.source_len, pointee_offset, pointee_len, "u16", 3
        ) { return TargetTypeTag::U16; }
        if sem.source_slice_equals(
            self.source, self.source_len, pointee_offset, pointee_len, "i16", 3
        ) { return TargetTypeTag::I16; }
        if sem.source_slice_equals(
            self.source, self.source_len, pointee_offset, pointee_len, "u32", 3
        ) { return TargetTypeTag::U32; }
        if sem.source_slice_equals(
            self.source, self.source_len, pointee_offset, pointee_len, "i32", 3
        ) { return TargetTypeTag::I32; }
        if sem.source_slice_equals(
            self.source, self.source_len, pointee_offset, pointee_len, "u64", 3
        ) { return TargetTypeTag::U64; }
        if sem.source_slice_equals(
            self.source, self.source_len, pointee_offset, pointee_len, "usize", 5
        ) { return TargetTypeTag::U64; }
        if sem.source_slice_equals(
            self.source, self.source_len, pointee_offset, pointee_len, "i64", 3
        ) { return TargetTypeTag::I64; }
        if sem.source_slice_equals(self.source, self.source_len,
            pointee_offset, pointee_len, "f32", 3) { return TargetTypeTag::F32; }
        if sem.source_slice_equals(self.source, self.source_len,
            pointee_offset, pointee_len, "f64", 3) { return TargetTypeTag::F64; }
        if sem.source_slice_equals(
            self.source, self.source_len, pointee_offset, pointee_len, "bool", 4
        ) { return TargetTypeTag::Bool; }
        if unsafe { *(self.source + pointee_offset) } == 42 {
            return TargetTypeTag::Pointer;
        }
        return TargetTypeTag::Invalid;
    }

    // Pointer-array views preserve the complete element type, including inner
    // qualifiers. Ignore whitespace only; differing pointees remain rejected.
    pub fn pointer_array_cast_matches(self: &Self, array_ref: usize, cast_ref: usize) -> bool {
        if array_ref == 0 || cast_ref == 0 || array_ref >= self.node_count || cast_ref >= self.node_count { return false; }
        let array: AstNode = unsafe { *(self.nodes + array_ref) };
        let cast: AstNode = unsafe { *(self.nodes + cast_ref) };
        if array.str_len < 3 || cast.str_len < 3
            || array.str_offset > self.source_len || array.str_len > self.source_len - array.str_offset
            || cast.str_offset > self.source_len || cast.str_len > self.source_len - cast.str_offset { return false; }
        if unsafe { *(self.source + array.str_offset) } != 91
            || unsafe { *(self.source + cast.str_offset) } != 42 { return false; }
        let mut left: usize = 1;
        let mut end: usize = left;
        while end < array.str_len {
            if unsafe { *(self.source + array.str_offset + end) } == 59 { break; }
            end = end + 1;
        }
        if end == array.str_len { return false; }
        let mut right: usize = 1;
        while right < cast.str_len {
            let ch: u8 = unsafe { *(self.source + cast.str_offset + right) };
            if ch != 32 && ch != 9 && ch != 10 && ch != 13 { break; }
            right = right + 1;
        }
        if right + 5 <= cast.str_len && unsafe { *(self.source + cast.str_offset + right) } == 99
            && unsafe { *(self.source + cast.str_offset + right + 1) } == 111
            && unsafe { *(self.source + cast.str_offset + right + 2) } == 110
            && unsafe { *(self.source + cast.str_offset + right + 3) } == 115
            && unsafe { *(self.source + cast.str_offset + right + 4) } == 116 { right = right + 5; }
        else if right + 3 <= cast.str_len && unsafe { *(self.source + cast.str_offset + right) } == 109
            && unsafe { *(self.source + cast.str_offset + right + 1) } == 117
            && unsafe { *(self.source + cast.str_offset + right + 2) } == 116 { right = right + 3; }
        while left < end || right < cast.str_len {
            while left < end {
                let ch: u8 = unsafe { *(self.source + array.str_offset + left) };
                if ch != 32 && ch != 9 && ch != 10 && ch != 13 { break; }
                left = left + 1;
            }
            while right < cast.str_len {
                let ch: u8 = unsafe { *(self.source + cast.str_offset + right) };
                if ch != 32 && ch != 9 && ch != 10 && ch != 13 { break; }
                right = right + 1;
            }
            if left == end || right == cast.str_len { return left == end && right == cast.str_len; }
            if unsafe { *(self.source + array.str_offset + left) } != unsafe { *(self.source + cast.str_offset + right) } { return false; }
            left = left + 1;
            right = right + 1;
        }
        return true;
    }

    pub fn pointer_expression_type_ref(
        self: &Self,
        expression_index: usize
    ) -> usize {
        if self.nodes == null || expression_index == 0
            || expression_index >= self.node_count {
            return 0;
        }
        let expression: AstNode = unsafe { *(self.nodes + expression_index) };
        if self.structured_cfg && expression.kind == AstKind::ExprFieldAccess {
            let owner: u32 = self.cfg_struct_id(expression.first_child, 0);
            let field: u32 = self.find_field(owner, expression.str_offset, expression.str_len);
            if field != 0 {
                let declared: usize = self.field_type_refs[field as usize - 1];
                if declared != 0 && self.type_tag_for(declared) == TargetTypeTag::Pointer { return declared; }
            }
        }
        let mut sem: Sema = Sema::new();
        let inferred: usize = sem.infer_expression_type_ref(
            self.nodes, self.node_count, expression_index,
            self.source, self.source_len
        );
        if inferred != 0 && self.type_tag_for(inferred) == TargetTypeTag::Pointer {
            return inferred;
        }

        if expression.kind == AstKind::UnsafeExpr
            || (expression.kind == AstKind::ExprUnary && expression.int_value == 82) {
            return self.pointer_expression_type_ref(expression.first_child);
        }
        if expression.kind == AstKind::ExprBinary
            && (expression.int_value == 80 || expression.int_value == 81)
            && expression.first_child != 0
            && expression.first_child < self.node_count {
            return self.pointer_expression_type_ref(expression.first_child);
        }
        return 0;
    }

    pub fn pointer_pointee_struct_id(
        self: &Self,
        type_index: usize
    ) -> u32 {
        if self.nodes == null || self.source == null || type_index == 0
            || type_index >= self.node_count {
            return 0;
        }
        let type_node: AstNode = unsafe { *(self.nodes + type_index) };
        if type_node.kind != AstKind::TypeRef || type_node.str_len < 2
            || type_node.str_offset > self.source_len
            || type_node.str_len > self.source_len - type_node.str_offset {
            return 0;
        }
        let mut start: usize = 0;
        while start < type_node.str_len {
            let ch: u8 = unsafe { *(self.source + type_node.str_offset + start) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                start = start + 1;
            } else {
                break;
            }
        }
        if start >= type_node.str_len {
            return 0;
        }
        let indirect_marker: u8 = unsafe {
            *(self.source + type_node.str_offset + start)
        };
        if indirect_marker != 42 && indirect_marker != 38 {
            return 0;
        }
        start = start + 1;
        while start < type_node.str_len {
            let ch: u8 = unsafe { *(self.source + type_node.str_offset + start) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                start = start + 1;
            } else {
                break;
            }
        }

        let mut sem: Sema = Sema::new();
        if indirect_marker == 42 {
            if start + 5 <= type_node.str_len && sem.source_slice_equals(
                self.source, self.source_len,
                type_node.str_offset + start, 5, "const", 5
            ) {
                start = start + 5;
            } else if start + 3 <= type_node.str_len && sem.source_slice_equals(
                self.source, self.source_len,
                type_node.str_offset + start, 3, "mut", 3
            ) {
                start = start + 3;
            } else {
                return 0;
            }
        } else if start + 3 <= type_node.str_len && sem.source_slice_equals(
            self.source, self.source_len,
            type_node.str_offset + start, 3, "mut", 3
        ) {
            start = start + 3;
        }
        while start < type_node.str_len {
            let ch: u8 = unsafe { *(self.source + type_node.str_offset + start) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                start = start + 1;
            } else {
                break;
            }
        }
        if start >= type_node.str_len {
            return 0;
        }
        return self.find_struct(
            type_node.str_offset + start,
            type_node.str_len - start
        );
    }

    pub fn pointer_pointee_stride(
        self: &Self,
        type_index: usize
    ) -> usize {
        let pointee: TargetTypeTag = self.pointer_pointee_type_tag(type_index);
        if pointee == TargetTypeTag::U8 || pointee == TargetTypeTag::I8 || pointee == TargetTypeTag::Bool {
            return 1;
        }
        if pointee == TargetTypeTag::U16 || pointee == TargetTypeTag::I16 {
            return 2;
        }
        if pointee == TargetTypeTag::U32 || pointee == TargetTypeTag::I32 || pointee == TargetTypeTag::F32 {
            return 4;
        }
        if pointee == TargetTypeTag::U64 || pointee == TargetTypeTag::I64 || pointee == TargetTypeTag::F64
            || pointee == TargetTypeTag::Pointer {
            return 8;
        }
        let struct_id: u32 = self.pointer_pointee_struct_id(type_index);
        if struct_id != 0 && struct_id as usize <= self.struct_count {
            return self.struct_sizes[(struct_id - 1) as usize] as usize;
        }
        return 0;
    }

    pub fn integer_type_max(self: &Self, type_tag: TargetTypeTag) -> u64 {
        if type_tag == TargetTypeTag::I8 { return 127; }
        if type_tag == TargetTypeTag::I16 { return 32767; }
        if type_tag == TargetTypeTag::I32 { return 2147483647; }
        if type_tag == TargetTypeTag::I64 { return 9223372036854775807; }
        if type_tag == TargetTypeTag::U8 { return 255; }
        if type_tag == TargetTypeTag::U16 { return 65535; }
        if type_tag == TargetTypeTag::U32 { return 4294967295; }
        if type_tag == TargetTypeTag::U64 { return 18446744073709551615; }
        return 0;
    }

    pub fn source_name_equals(
        self: &Self,
        left_offset: usize,
        left_length: usize,
        right_offset: usize,
        right_length: usize
    ) -> bool {
        if left_length != right_length || left_offset > self.source_len
            || right_offset > self.source_len
            || left_length > self.source_len - left_offset
            || right_length > self.source_len - right_offset {
            return false;
        }
        let mut index: usize = 0;
        while index < left_length {
            if unsafe { *(self.source + left_offset + index) }
                != unsafe { *(self.source + right_offset + index) } {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    pub fn fold_static_array_list(mut self: &mut Self, initializer_index: usize,
        element_type: TargetTypeTag, element_count: usize,
        initial_start: &mut usize, nonzero_bits: &mut u64) -> bool {
        if initializer_index == 0 || initializer_index >= self.node_count
            || element_type == TargetTypeTag::Invalid || element_type == TargetTypeTag::Pointer
            || element_type == TargetTypeTag::Aggregate || element_count == 0 {
            return self.reject(initializer_index);
        }
        let initializer: AstNode = unsafe { *(self.nodes + initializer_index) };
        let start: usize = unsafe { g_static_list_count };
        if initializer.kind != AstKind::ExprArrayLiteral || start > TARGET_STATIC_LIST_CAPACITY
            || element_count > TARGET_STATIC_LIST_CAPACITY - start {
            return self.reject(initializer_index);
        }
        let mut child: usize = initializer.first_child;
        let mut index: usize = 0;
        let mut combined: u64 = 0;
        while child != 0 {
            if child >= self.node_count || index >= element_count { return self.reject(initializer_index); }
            let mut bits: u64 = 0;
            if !self.constant_literal_bits(child, element_type, &mut bits) { return self.reject(child); }
            unsafe { g_static_list_values[start + index] = bits; }
            combined = combined | bits;
            index = index + 1;
            child = unsafe { (*(self.nodes + child)).next_sibling };
        }
        if index != element_count { return self.reject(initializer_index); }
        // Commit the range only after shape and every element have been checked.
        unsafe { g_static_list_count = start + element_count; }
        *initial_start = start;
        *nonzero_bits = combined;
        return true;
    }

    // Static record data shares the bounded scalar-initializer pool, using one
    // byte per entry. Padding is zeroed before named fields are serialized.
    pub fn fold_static_scalar(mut self: &mut Self, expression: usize,
        typ: TargetTypeTag, start: usize, offset: usize) -> bool {
        let size: usize = self.scalar_memory_size(typ) as usize;
        if size == 0 || size > 8 || typ == TargetTypeTag::Pointer
            || typ == TargetTypeTag::Aggregate || start > TARGET_STATIC_LIST_CAPACITY
            || offset > TARGET_STATIC_LIST_CAPACITY-start
            || size > TARGET_STATIC_LIST_CAPACITY-start-offset { return false; }
        let mut bits: u64 = 0;
        if !self.constant_literal_bits(expression,typ,&mut bits) { return false; }
        let mut byte: usize = 0;
        while byte < size {
            unsafe{g_static_list_values[start+offset+byte]=(bits >> (byte*8)) & 255;}
            byte=byte+1;
        }
        return true;
    }

    pub fn fold_static_record(mut self: &mut Self, expression: usize,
        record: u32, start: usize, offset: usize, depth: usize) -> bool {
        if expression == 0 || expression >= self.node_count || record == 0
            || record as usize > self.struct_count || depth >= 32 { return false; }
        let literal: AstNode = unsafe{*(self.nodes+expression)};
        if literal.kind != AstKind::ExprStructLiteral
            || self.find_struct(literal.str_offset,literal.str_len) != record { return false; }
        let first: usize = self.struct_field_starts[record as usize-1] as usize;
        let count: usize = self.struct_field_counts[record as usize-1] as usize;
        let mut seen: [u8;256] = 0;
        let mut child: usize = literal.first_child;
        let mut initialized: usize = 0;
        while child != 0 {
            if child >= self.node_count || initialized >= count { return false; }
            let init: AstNode = unsafe{*(self.nodes+child)};
            let id: u32 = self.find_field(record,init.str_offset,init.str_len);
            if init.kind != AstKind::StructFieldInit || id == 0 { return false; }
            let field: usize = id as usize-1;
            if field < first || field-first >= count || seen[field-first] != 0 { return false; }
            seen[field-first]=1;
            let value: usize = init.first_child;
            if value == 0 || value >= self.node_count || unsafe{(*(self.nodes+value)).next_sibling} != 0 { return false; }
            let place: usize = offset+self.field_offsets[field] as usize;
            let nested: u32 = self.field_struct_ids[field];
            if self.field_byte_counts[field] != 0 {
                if !self.fold_static_field_array(value,field,start,place,depth+1) { return false; }
            } else if nested != 0 {
                if !self.fold_static_record(value,nested,start,place,depth+1) { return false; }
            } else if !self.fold_static_scalar(value,self.field_type_tags[field] as TargetTypeTag,start,place) { return false; }
            initialized=initialized+1;
            child=init.next_sibling;
        }
        return initialized == count;
    }

    pub fn fold_static_field_array(mut self: &mut Self, expression: usize,
        field: usize, start: usize, offset: usize, depth: usize) -> bool {
        if expression == 0 || expression >= self.node_count || depth >= 32 { return false; }
        let array: AstNode = unsafe{*(self.nodes+expression)};
        if array.kind != AstKind::ExprArrayLiteral && array.kind != AstKind::ExprArrayRepeat { return false; }
        let record: u32 = self.field_array_structs[field];
        let typ: TargetTypeTag = self.field_array_types[field] as TargetTypeTag;
        let count: usize = self.field_byte_counts[field] as usize;
        let mut stride: usize = self.scalar_memory_size(typ) as usize;
        if record != 0 { stride=self.struct_sizes[record as usize-1] as usize; }
        let mut element: usize = array.first_child;
        if array.kind == AstKind::ExprArrayRepeat {
            if element == 0 || element >= self.node_count { return false; }
            let length: usize = unsafe{(*(self.nodes+element)).next_sibling};
            if length == 0 || length >= self.node_count { return false; }
            let length_node: AstNode = unsafe{*(self.nodes+length)};
            if length_node.kind != AstKind::ExprLiteral || length_node.next_sibling != 0
                || self.parse_integer_value(length_node.str_offset,length_node.str_len) != count as u64 { return false; }
        }
        let mut index: usize = 0;
        while index < count {
            if element == 0 || element >= self.node_count { return false; }
            if record != 0 {
                if !self.fold_static_record(element,record,start,offset+index*stride,depth+1) { return false; }
            } else if !self.fold_static_scalar(element,typ,start,offset+index*stride) { return false; }
            if array.kind == AstKind::ExprArrayLiteral { element=unsafe{(*(self.nodes+element)).next_sibling}; }
            index=index+1;
        }
        return array.kind == AstKind::ExprArrayRepeat || element == 0;
    }

    pub fn register_static_record(mut self: &mut Self, expression: usize,
        record: u32, initial_start: &mut usize, nonzero: &mut u64) -> bool {
        let size: usize = self.struct_sizes[record as usize-1] as usize;
        let start: usize = unsafe{g_static_list_count};
        if size == 0 || start > TARGET_STATIC_LIST_CAPACITY
            || size > TARGET_STATIC_LIST_CAPACITY-start || !self.array_record_copyable(record,0) { return false; }
        let mut index: usize = 0;
        while index < size { unsafe{g_static_list_values[start+index]=0;}index=index+1; }
        if !self.fold_static_record(expression,record,start,0,0) { return false; }
        let mut bits: u64 = 0;index=0;
        while index < size { bits=bits | unsafe{g_static_list_values[start+index]};index=index+1; }
        unsafe{g_static_list_count=start+size;}
        *initial_start=start;*nonzero=bits;
        return true;
    }

    pub fn register_static_record_array(mut self: &mut Self, expression: usize,
        record: u32, count: usize, initial_start: &mut usize, nonzero: &mut u64) -> bool {
        if expression == 0 || expression >= self.node_count || record == 0
            || record as usize > self.struct_count || count == 0 || count > 256 { return false; }
        let stride: usize = self.struct_sizes[record as usize-1] as usize;
        let start: usize = unsafe{g_static_list_count};
        if stride == 0 || start > TARGET_STATIC_LIST_CAPACITY
            || count > (TARGET_STATIC_LIST_CAPACITY-start)/stride
            || !self.array_record_copyable(record,0) { return false; }
        let array: AstNode = unsafe{*(self.nodes+expression)};
        if array.kind != AstKind::ExprArrayLiteral && array.kind != AstKind::ExprArrayRepeat { return false; }
        let mut element: usize = array.first_child;
        if array.kind == AstKind::ExprArrayRepeat {
            if element == 0 || element >= self.node_count { return false; }
            let length: usize = unsafe{(*(self.nodes+element)).next_sibling};
            if length == 0 || length >= self.node_count { return false; }
            let node: AstNode = unsafe{*(self.nodes+length)};
            if node.kind != AstKind::ExprLiteral || node.next_sibling != 0
                || self.parse_integer_value(node.str_offset,node.str_len) != count as u64 { return false; }
        }
        let size: usize = count*stride;
        let mut byte: usize = 0;
        while byte < size { unsafe{g_static_list_values[start+byte]=0;}byte=byte+1; }
        let mut index: usize = 0;
        while index < count {
            if !self.fold_static_record(element,record,start,index*stride,0) { return false; }
            if array.kind == AstKind::ExprArrayLiteral { element=unsafe{(*(self.nodes+element)).next_sibling}; }
            index=index+1;
        }
        if array.kind == AstKind::ExprArrayLiteral && element != 0 { return false; }
        let mut bits: u64 = 0;byte=0;
        while byte < size { bits=bits | unsafe{g_static_list_values[start+byte]};byte=byte+1; }
        unsafe{g_static_list_count=start+size;}
        *initial_start=start;*nonzero=bits;
        return true;
    }

    pub fn global_array_record_id(self: &Self, expression_index: usize) -> u32 {
        if expression_index == 0 || expression_index >= self.node_count { return 0; }
        let expression: AstNode = unsafe{*(self.nodes+expression_index)};
        if expression.kind != AstKind::ExprIdent { return 0; }
        let global: isize = self.find_global_bss(expression.str_offset,expression.str_len);
        if global < 0 || unsafe{g_bss_sym_is_array[global as usize]} == 0 { return 0; }
        let record: u32 = unsafe{g_bss_sym_element_structs[global as usize]};
        if record == 0 || !self.array_record_copyable(record,0) { return 0; }
        let mut sem: Sema = Sema::new();
        let binding: usize = sem.find_visible_binding(self.nodes,self.node_count,expression_index,self.source,self.source_len);
        if binding == 0 || binding >= self.node_count { return 0; }
        let declaration: AstNode = unsafe{*(self.nodes+binding)};
        if declaration.kind != AstKind::LetStmt || declaration.parent == 0 || declaration.parent >= self.node_count
            || unsafe{(*(self.nodes+declaration.parent)).kind} != AstKind::Module { return 0; }
        return record;
    }

    // Resolve the binding lexically so a scalar local cannot acquire a global
    // record's layout merely by shadowing its name.
    pub fn global_record_id(self: &Self, expression_index: usize) -> u32 {
        if expression_index == 0 || expression_index >= self.node_count { return 0; }
        let expression: AstNode = unsafe{*(self.nodes+expression_index)};
        if expression.kind != AstKind::ExprIdent { return 0; }
        let global: isize = self.find_global_bss(expression.str_offset,expression.str_len);
        if global < 0 || unsafe{g_bss_sym_types[global as usize]} != TargetTypeTag::Aggregate as u32 { return 0; }
        let mut sem: Sema = Sema::new();
        let binding: usize = sem.find_visible_binding(self.nodes,self.node_count,expression_index,self.source,self.source_len);
        if binding == 0 || binding >= self.node_count { return 0; }
        let declaration: AstNode = unsafe{*(self.nodes+binding)};
        if declaration.kind != AstKind::LetStmt || declaration.parent == 0 || declaration.parent >= self.node_count
            || unsafe{(*(self.nodes+declaration.parent)).kind} != AstKind::Module { return 0; }
        let typ: usize = sem.binding_type_ref(self.nodes,self.node_count,binding);
        if typ == 0 || typ >= self.node_count { return 0; }
        let node: AstNode = unsafe{*(self.nodes+typ)};
        return self.find_struct(node.str_offset,node.str_len);
    }

    pub fn find_struct(
        self: &Self,
        name_offset: usize,
        name_length: usize
    ) -> u32 {
        let mut i: usize = 0;
        while i < self.struct_count {
            if self.source_name_equals(
                self.struct_name_offsets[i],
                self.struct_name_lens[i],
                name_offset,
                name_length
            ) {
                return (i + 1) as u32;
            }
            i = i + 1;
        }
        return 0;
    }

    pub fn find_field(
        self: &Self,
        struct_id: u32,
        name_offset: usize,
        name_length: usize
    ) -> u32 {
        if struct_id == 0 || struct_id as usize > self.struct_count {
            return 0;
        }
        let s_idx: usize = (struct_id - 1) as usize;
        let start: usize = self.struct_field_starts[s_idx] as usize;
        let count: usize = self.struct_field_counts[s_idx] as usize;
        let mut i: usize = 0;
        while i < count {
            let f_idx: usize = start + i;
            if self.source_name_equals(
                self.field_name_offsets[f_idx],
                self.field_name_lens[f_idx],
                name_offset,
                name_length
            ) {
                return (f_idx + 1) as u32;
            }
            i = i + 1;
        }
        return 0;
    }

    pub fn find_local_struct_id(
        self: &Self,
        name_offset: usize,
        name_length: usize
    ) -> u32 {
        let mut local_offset: usize = self.local_count;
        while local_offset > 0 {
            local_offset = local_offset - 1;
            if self.source_name_equals(
                self.local_name_offsets[local_offset],
                self.local_name_lens[local_offset],
                name_offset,
                name_length
            ) {
                if self.local_array_counts[local_offset] != 0 { return 0; }
                let local_struct_id: u32 = self.local_struct_ids[local_offset];
                return local_struct_id;
            }
        }
        return 0;
    }

    pub fn parse_integer_value(
        self: &Self,
        offset: usize,
        length: usize
    ) -> u64 {
        if offset > self.source_len || length > self.source_len - offset || length == 0 {
            return 0;
        }
        let mut value: u64=0;
        if !native_unsigned_slice(unsafe{self.source+offset},length,
            unsafe{(&mut value) as *mut u64}) { return 0; }
        return value;
    }

    pub fn find_enum(
        self: &Self,
        name_offset: usize,
        name_length: usize
    ) -> u32 {
        let mut i: usize = 0;
        while i < self.enum_count {
            if self.source_name_equals(
                self.enum_name_offsets[i],
                self.enum_name_lens[i],
                name_offset,
                name_length
            ) {
                return (i + 1) as u32;
            }
            i = i + 1;
        }
        return 0;
    }

    pub fn find_variant(
        self: &Self,
        enum_id: u32,
        name_offset: usize,
        name_length: usize
    ) -> u64 {
        if enum_id == 0 || enum_id as usize > self.enum_count {
            return 0;
        }
        let e_idx: usize = (enum_id - 1) as usize;
        let start: usize = self.enum_variant_starts[e_idx] as usize;
        let count: usize = self.enum_variant_counts[e_idx] as usize;
        let mut i: usize = 0;
        while i < count {
            let v_idx: usize = start + i;
            if self.source_name_equals(
                self.variant_name_offsets[v_idx],
                self.variant_name_lens[v_idx],
                name_offset,
                name_length
            ) {
                let variant_value: u64 = self.variant_values[v_idx];
                return variant_value;
            }
            i = i + 1;
        }
        return 0;
    }

    pub fn append_value(
        mut self: &mut Self,
        type_tag: TargetTypeTag,
        name_offset: usize,
        name_length: usize
    ) -> u32 {
        if self.values == null || self.value_count >= self.value_capacity
            || self.next_value_id == 0 {
            return TARGET_VALUE_NONE;
        }
        let value_id: u32 = self.next_value_id;
        self.next_value_id = self.next_value_id + 1;
        let mut value: TargetValue = TargetValue::empty();
        value.id = value_id;
        value.type_tag = type_tag;
        value.source_name = TargetSourceSlice {
            offset: name_offset,
            length: name_length
        };
        unsafe { *(self.values + self.value_count) = value; }
        self.value_count = self.value_count + 1;
        return value_id;
    }

    pub fn mark_value_domain(mut self: &mut Self, value_id: u32, type_index: usize) -> bool {
        if type_index == 0 { return true; }
        if type_index >= self.node_count || value_id == 0 || value_id as usize > self.value_count { return false; }
        let typ: AstNode = unsafe { *(self.nodes + type_index) };
        if typ.kind != AstKind::TypeRef || typ.int_value < 0 || typ.int_value > 8 { return false; }
        unsafe {
            let value: *mut TargetValue = self.values + value_id as usize - 1;
            (*value).flags = ((*value).flags & ~TARGET_VALUE_DOMAIN_MASK)
                | ((typ.int_value as u32) << TARGET_VALUE_DOMAIN_SHIFT);
        }
        return true;
    }

    pub fn append_operand(mut self: &mut Self, value_id: u32) -> bool {
        if self.operands == null || self.operand_count >= self.operand_capacity
            || value_id == TARGET_VALUE_NONE {
            return false;
        }
        unsafe {
            *(self.operands + self.operand_count) = TargetOperand::new(value_id);
        }
        self.operand_count = self.operand_count + 1;
        return true;
    }

    pub fn append_target(mut self: &mut Self, block_id: u32) -> bool {
        if self.targets == null || self.target_count >= self.target_capacity
            || block_id == TARGET_BLOCK_NONE {
            return false;
        }
        unsafe { *(self.targets + self.target_count) = block_id; }
        self.target_count = self.target_count + 1;
        return true;
    }

    pub fn append_phi_input(
        mut self: &mut Self,
        value_id: u32,
        block_id: u32
    ) -> bool {
        if self.phi_inputs == null || self.phi_input_count >= self.phi_input_capacity
            || value_id == TARGET_VALUE_NONE || block_id == TARGET_BLOCK_NONE {
            return false;
        }
        unsafe {
            *(self.phi_inputs + self.phi_input_count) = TargetPhiInput::new(
                value_id, block_id
            );
        }
        self.phi_input_count = self.phi_input_count + 1;
        return true;
    }

    pub fn append_instruction(
        mut self: &mut Self,
        opcode: TargetOpcode,
        result_value: u32,
        type_tag: TargetTypeTag,
        first_operand: u32,
        operand_count: u32,
        node_index: usize
    ) -> bool {
        if self.instructions == null
            || self.instruction_count >= self.instruction_capacity
            || node_index == 0 || node_index >= self.node_count {
            return false;
        }
        let node: AstNode = unsafe { *(self.nodes + node_index) };
        let mut instruction: TargetInstruction = TargetInstruction::new(opcode);
        instruction.result_value = result_value;
        instruction.type_tag = type_tag;
        instruction.first_operand = first_operand;
        instruction.operand_count = operand_count;
        instruction.source_point = TargetSourceSlice {
            offset: node.span.offset,
            length: node.span.length
        };
        unsafe {
            *(self.instructions + self.instruction_count) = instruction;
        }
        self.instruction_count = self.instruction_count + 1;
        return true;
    }

    pub fn lower_integer_literal(
        mut self: &mut Self,
        node_index: usize,
        type_tag: TargetTypeTag
    ) -> u32 {
        if node_index == 0 || node_index >= self.node_count {
            return TARGET_VALUE_NONE;
        }
        let node: AstNode = unsafe { *(self.nodes + node_index) };
        if node.kind != AstKind::ExprLiteral || (node.str_len == 0 && node.int_value >= 0)
            || node.str_offset > self.source_len
            || node.str_len > self.source_len - node.str_offset {
            return TARGET_VALUE_NONE;
        }
        let value_id: u32 = self.append_value(type_tag, 0, 0);
        if value_id == TARGET_VALUE_NONE {
            return TARGET_VALUE_NONE;
        }
        let instruction_index: usize = self.instruction_count;
        if !self.append_instruction(
            TargetOpcode::ConstInt,
            value_id,
            type_tag,
            0,
            0,
            node_index
        ) {
            return TARGET_VALUE_NONE;
        }

        let mut value: u64 = 0;
        let mut literal_sema: Sema = Sema::new();
        if !literal_sema.integer_literal_bits(self.nodes,self.node_count,node_index,self.source,self.source_len,
            unsafe{(&mut value) as *mut u64}) || value > self.integer_type_max(type_tag) {
            self.instruction_count = instruction_index;
            self.value_count = self.value_count-1;
            return TARGET_VALUE_NONE;
        }
        let mut instruction: TargetInstruction = unsafe {
            *(self.instructions + instruction_index)
        };
        instruction.immediate_bits = value;
        unsafe { *(self.instructions + instruction_index) = instruction; }
        return value_id;
    }

    pub fn find_top_level_function_decl(
        self: &Self,
        name_offset: usize,
        name_length: usize
    ) -> usize {
        if self.nodes == null || self.source == null || name_length == 0 {
            return 0;
        }
        let mut node_index: usize = 1;
        while node_index < self.node_count {
            let node: AstNode = unsafe { *(self.nodes + node_index) };
            if (node.kind == AstKind::FnDecl || node.kind == AstKind::TrapfnDecl)
                && node.parent != 0 && node.parent < self.node_count
                && self.source_name_equals(
                    node.str_offset, node.str_len, name_offset, name_length
                ) {
                let parent: AstNode = unsafe { *(self.nodes + node.parent) };
                if parent.kind == AstKind::Module {
                    return node_index;
                }
            }
            node_index = node_index + 1;
        }
        return 0;
    }

    pub fn function_parameter_count_from_ast(
        self: &Self,
        function_index: usize
    ) -> u32 {
        if self.nodes == null || function_index == 0 || function_index >= self.node_count {
            return 0;
        }
        let function: AstNode = unsafe { *(self.nodes + function_index) };
        if function.kind != AstKind::FnDecl && function.kind != AstKind::TrapfnDecl {
            return 0;
        }
        let mut count: u32 = 0;
        let mut child_index: usize = function.first_child;
        while child_index != 0 {
            if child_index >= self.node_count { return 0; }
            let child: AstNode = unsafe { *(self.nodes + child_index) };
            if child.kind == AstKind::ParamDecl {
                count = count + 1;
            }
            child_index = child.next_sibling;
        }
        return count;
    }

    pub fn function_parameter_type_from_ast(
        self: &Self,
        function_index: usize,
        parameter_index: u32
    ) -> TargetTypeTag {
        if self.nodes == null || function_index == 0 || function_index >= self.node_count {
            return TargetTypeTag::Invalid;
        }
        let function: AstNode = unsafe { *(self.nodes + function_index) };
        if function.kind != AstKind::FnDecl && function.kind != AstKind::TrapfnDecl {
            return TargetTypeTag::Invalid;
        }
        let mut current: u32 = 0;
        let mut child_index: usize = function.first_child;
        while child_index != 0 {
            if child_index >= self.node_count {
                return TargetTypeTag::Invalid;
            }
            let child: AstNode = unsafe { *(self.nodes + child_index) };
            if child.kind == AstKind::ParamDecl {
                if current == parameter_index {
                    if child.first_child == 0 || child.first_child >= self.node_count {
                        return TargetTypeTag::Invalid;
                    }
                    return self.type_tag_for(child.first_child);
                }
                current = current + 1;
            }
            child_index = child.next_sibling;
        }
        return TargetTypeTag::Invalid;
    }

    pub fn function_return_type_from_ast(
        self: &Self,
        function_index: usize
    ) -> TargetTypeTag {
        if self.nodes == null || function_index == 0 || function_index >= self.node_count {
            return TargetTypeTag::Invalid;
        }
        let function: AstNode = unsafe { *(self.nodes + function_index) };
        if function.kind != AstKind::FnDecl && function.kind != AstKind::TrapfnDecl {
            return TargetTypeTag::Invalid;
        }
        let mut child_index: usize = function.first_child;
        while child_index != 0 {
            if child_index >= self.node_count {
                return TargetTypeTag::Invalid;
            }
            let child: AstNode = unsafe { *(self.nodes + child_index) };
            if child.kind == AstKind::TypeRef {
                return self.type_tag_for(child_index);
            }
            child_index = child.next_sibling;
        }
        return TargetTypeTag::Void;
    }

    // Internal native aggregate ABI: source parameters retain their order and
    // a final Pointer parameter names caller-owned return storage.
    pub fn function_return_struct_from_ast(self: &Self, function_index: usize) -> u32 {
        if function_index == 0 || function_index >= self.node_count { return 0; }
        let function: AstNode = unsafe { *(self.nodes + function_index) };
        let mut child_index: usize = function.first_child;
        while child_index != 0 && child_index < self.node_count {
            let child: AstNode = unsafe { *(self.nodes + child_index) };
            if child.kind == AstKind::TypeRef {
                let mut sem: Sema = Sema::new();
                if sem.source_slice_equals(self.source, self.source_len,
                    child.str_offset, child.str_len, "Self", 4) {
                    if function.parent == 0 || function.parent >= self.node_count { return 0; }
                    let owner: AstNode = unsafe { *(self.nodes + function.parent) };
                    if owner.kind != AstKind::ImplDecl { return 0; }
                    return self.find_struct(owner.str_offset, owner.str_len);
                }
                return self.find_struct(child.str_offset, child.str_len);
            }
            child_index = child.next_sibling;
        }
        return 0;
    }

    pub fn function_parameter_struct_from_ast(self: &Self, function_index: usize, ordinal: u32) -> u32 {
        if function_index == 0 || function_index >= self.node_count { return 0; }
        let mut child_index: usize = unsafe { (*(self.nodes + function_index)).first_child };
        let mut parameter_index: u32 = 0;
        while child_index != 0 && child_index < self.node_count {
            let child: AstNode = unsafe { *(self.nodes + child_index) };
            if child.kind == AstKind::ParamDecl {
                if parameter_index == ordinal {
                    if child.first_child == 0 || child.first_child >= self.node_count { return 0; }
                    let typ: AstNode = unsafe { *(self.nodes + child.first_child) };
                    return self.find_struct(typ.str_offset, typ.str_len);
                }
                parameter_index = parameter_index + 1;
            }
            child_index = child.next_sibling;
        }
        return 0;
    }

    pub fn function_parameter_domain_from_ast(self: &Self, function_index: usize, ordinal: u32) -> i64 {
        if function_index == 0 || function_index >= self.node_count { return 0; }
        let mut child: usize = unsafe { (*(self.nodes + function_index)).first_child };
        let mut parameter: u32 = 0;
        while child != 0 && child < self.node_count {
            let node: AstNode = unsafe { *(self.nodes + child) };
            if node.kind == AstKind::ParamDecl {
                if parameter == ordinal {
                    if node.first_child == 0 || node.first_child >= self.node_count { return 0; }
                    return unsafe { (*(self.nodes + node.first_child)).int_value };
                }
                parameter = parameter + 1;
            }
            child = node.next_sibling;
        }
        return 0;
    }

    // SV8.48b: call arity and any single hidden sret pointer are already
    // checked at the call site. Preserve each declared domain once.
    pub fn call_capability_profile(self: &Self, function_index: usize,
        argument_count: u32) -> u64 {
        if function_index == 0 || function_index >= self.node_count
            || argument_count > 24 { return 18446744073709551615; }
        let mut bits: u64 = 0;
        let mut argument: u32 = 0;
        while argument < argument_count {
            let domain: i64 = self.function_parameter_domain_from_ast(
                function_index, argument
            );
            let mut role: u64 = 0;
            if domain == 1 { role = 1; }
            else if domain == 4 { role = 2; }
            else if domain == 6 { role = 3; }
            else if domain != 0 { return 18446744073709551615; }
            bits = bits | (role << ((argument as u64) * 2));
            argument = argument + 1;
        }
        return bits;
    }

    pub fn allocate_struct(mut self: &mut Self, struct_id: u32, node: usize) -> u32 {
        if struct_id == 0 || struct_id as usize > self.struct_count { return 0; }
        let size: u32 = self.struct_sizes[struct_id as usize - 1];
        let address: u32 = self.append_value(TargetTypeTag::Pointer, 0, 0);
        if size == 0 || address == 0 || !self.append_instruction(
            TargetOpcode::AllocStack, address, TargetTypeTag::Pointer, 0, 0, node
        ) { return 0; }
        unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = size as u64; }
        return address;
    }

    pub fn copy_return_struct(mut self: &mut Self, expression: usize,
        first_parameter: usize, parameter_count: usize, node: usize) -> bool {
        if self.return_struct_id == 0 || self.return_destination == 0
            || self.cfg_struct_id(expression, 0) != self.return_struct_id { return false; }
        let expression_node: AstNode = unsafe { *(self.nodes + expression) };
        if expression_node.kind == AstKind::ExprCall && self.payload_record(expression) == 0 {
            self.forwarded_return_call = expression;
            let destination: u32 = self.lower_expression(
                expression, TargetTypeTag::Pointer, first_parameter, parameter_count);
            self.forwarded_return_call = 0;
            return destination == self.return_destination;
        }
        let source_address: u32 = self.cfg_struct_address(
            expression, first_parameter, parameter_count, 0);
        return source_address != 0 && self.cfg_copy_fields(self.return_destination,
            source_address, self.return_struct_id, 0, 0, node, 0);
    }

    pub fn find_instance_impl_method_decl(
        self: &Self,
        call_index: usize,
        struct_id: u32,
        method_offset: usize,
        method_length: usize
    ) -> usize {
        if self.nodes == null || self.source == null || call_index == 0
            || call_index >= self.node_count || struct_id == 0
            || struct_id as usize > self.struct_count || method_length == 0 {
            return 0;
        }

        let struct_index: usize = (struct_id - 1) as usize;
        let struct_name_offset: usize = self.struct_name_offsets[struct_index];
        let struct_name_length: usize = self.struct_name_lens[struct_index];

        let mut sem: Sema = Sema::new();
        let module_index: usize = sem.find_enclosing_module(
            self.nodes, self.node_count, call_index
        );
        if module_index == 0 || module_index >= self.node_count {
            return 0;
        }

        let module_node: AstNode = unsafe { *(self.nodes + module_index) };
        let mut found: usize = 0;
        let mut declaration_index: usize = module_node.first_child;
        while declaration_index != 0 {
            if declaration_index >= self.node_count {
                return 0;
            }
            let declaration: AstNode = unsafe { *(self.nodes + declaration_index) };
            if declaration.kind == AstKind::ImplDecl
                && self.source_name_equals(
                    declaration.str_offset,
                    declaration.str_len,
                    struct_name_offset,
                    struct_name_length
                ) {
                let mut method_index: usize = declaration.first_child;
                while method_index != 0 {
                    if method_index >= self.node_count {
                        return 0;
                    }
                    let method: AstNode = unsafe { *(self.nodes + method_index) };
                    if method.kind == AstKind::FnDecl
                        && self.source_name_equals(
                            method.str_offset,
                            method.str_len,
                            method_offset,
                            method_length
                        ) {
                        let receiver_index: usize = sem.static_impl_receiver_index(
                            self.nodes,
                            self.node_count,
                            method_index,
                            self.source,
                            self.source_len
                        );
                        let mut first_parameter_index: usize = method.first_child;
                        while first_parameter_index != 0
                            && first_parameter_index < self.node_count
                            && unsafe { (*(self.nodes + first_parameter_index)).kind }
                                != AstKind::ParamDecl {
                            first_parameter_index = unsafe {
                                (*(self.nodes + first_parameter_index)).next_sibling
                            };
                        }
                        if receiver_index != 0
                            && receiver_index == first_parameter_index
                            && self.function_parameter_type_from_ast(
                                method_index, 0
                            ) == TargetTypeTag::Pointer {
                            if found != 0 {
                                return 0;
                            }
                            found = method_index;
                        }
                    }
                    method_index = method.next_sibling;
                }
            }
            declaration_index = declaration.next_sibling;
        }
        return found;
    }

    pub fn find_parameter_value(
        self: &Self,
        first_parameter: usize,
        parameter_count: usize,
        name_offset: usize,
        name_length: usize
    ) -> u32 {
        let mut local_offset: usize = self.local_count;
        while local_offset > 0 {
            local_offset = local_offset - 1;
            if self.source_name_equals(
                self.local_name_offsets[local_offset],
                self.local_name_lens[local_offset],
                name_offset,
                name_length
            ) {
                let local_value_id: u32 = self.local_value_ids[local_offset];
                return local_value_id;
            }
        }
        if self.parameters == null || self.values == null
            || first_parameter > self.parameter_count
            || parameter_count > self.parameter_count - first_parameter {
            return TARGET_VALUE_NONE;
        }
        let mut parameter_offset: usize = parameter_count;
        while parameter_offset > 0 {
            parameter_offset = parameter_offset - 1;
            let parameter: TargetParameter = unsafe {
                *(self.parameters + first_parameter + parameter_offset)
            };
            if self.source_name_equals(
                parameter.name.offset,
                parameter.name.length,
                name_offset,
                name_length
            ) {
                return parameter.value_id;
            }
        }
        return TARGET_VALUE_NONE;
    }

    pub fn lower_pointer_deref_store(
        mut self: &mut Self,
        statement_index: usize,
        first_parameter: usize,
        parameter_count: usize
    ) -> bool {
        if self.nodes == null || statement_index == 0
            || statement_index >= self.node_count {
            return false;
        }
        let statement: AstNode = unsafe { *(self.nodes + statement_index) };
        if statement.kind != AstKind::AssignStmt || statement.first_child == 0
            || statement.first_child >= self.node_count {
            return false;
        }
        let left_index: usize = statement.first_child;
        let left_node: AstNode = unsafe { *(self.nodes + left_index) };
        let right_index: usize = left_node.next_sibling;
        if left_node.kind != AstKind::ExprUnary || left_node.int_value != 82
            || right_index == 0 || right_index >= self.node_count
            || unsafe { (*(self.nodes + right_index)).next_sibling } != 0 {
            return false;
        }

        let pointer_expression: usize = left_node.first_child;
        if pointer_expression == 0 || pointer_expression >= self.node_count
            || unsafe { (*(self.nodes + pointer_expression)).next_sibling } != 0 {
            return false;
        }
        let pointer_type_ref: usize = self.pointer_expression_type_ref(
            pointer_expression
        );
        let pointee_type: TargetTypeTag = self.pointer_pointee_type_tag(
            pointer_type_ref
        );
        let pointee_struct: u32 = self.pointer_pointee_struct_id(pointer_type_ref);
        if self.structured_cfg && pointee_struct != 0 {
            if self.cfg_struct_id(right_index, 0) != pointee_struct { return false; }
            let destination: u32 = self.lower_expression(pointer_expression,
                TargetTypeTag::Pointer, first_parameter, parameter_count);
            let source_address: u32 = self.cfg_struct_address(right_index, first_parameter, parameter_count, 0);
            return destination != 0 && source_address != 0 && self.cfg_copy_fields(
                destination, source_address, pointee_struct, 0, 0, statement_index, 0);
        }
        if pointee_type == TargetTypeTag::Invalid {
            return false;
        }

        let pointer_value: u32 = self.lower_expression(
            pointer_expression, TargetTypeTag::Pointer,
            first_parameter, parameter_count
        );
        if pointer_value == TARGET_VALUE_NONE {
            return false;
        }
        let expr_value: u32 = self.lower_expression(
            right_index, pointee_type, first_parameter, parameter_count
        );
        if expr_value == TARGET_VALUE_NONE {
            return false;
        }

        let first_operand: u32 = self.operand_count as u32;
        if !self.append_operand(pointer_value)
            || !self.append_operand(expr_value)
            || !self.append_instruction(
                TargetOpcode::Store, TARGET_VALUE_NONE,
                pointee_type, first_operand, 2, statement_index
            ) {
            return false;
        }
        let store_index: usize = self.instruction_count - 1;
        unsafe {
            (*(self.instructions + store_index)).immediate_bits = 0;
        }
        return true;
    }

    pub fn lower_field_assignment(
        mut self: &mut Self,
        statement_index: usize,
        first_parameter: usize,
        parameter_count: usize
    ) -> bool {
        if self.nodes == null || statement_index == 0 || statement_index >= self.node_count {
            return false;
        }
        let statement: AstNode = unsafe { *(self.nodes + statement_index) };
        let field_index: usize = statement.first_child;
        if statement.kind != AstKind::AssignStmt || field_index == 0
            || field_index >= self.node_count { return false; }
        let field_node: AstNode = unsafe { *(self.nodes + field_index) };
        let value_index: usize = field_node.next_sibling;
        if field_node.kind != AstKind::ExprFieldAccess || value_index == 0
            || value_index >= self.node_count { return false; }
        let base_index: usize = field_node.first_child;
        if base_index == 0 || base_index >= self.node_count { return false; }
        let base_node: AstNode = unsafe { *(self.nodes + base_index) };
        let mut struct_id: u32 = 0;
        let mut base_ptr: u32 = 0;
        if base_node.kind == AstKind::ExprIdent {
            struct_id = self.cfg_struct_id(base_index,0);
            base_ptr = self.cfg_struct_address(base_index,first_parameter,parameter_count,0);
        } else if self.structured_cfg && (base_node.kind == AstKind::ExprFieldAccess
            || base_node.kind == AstKind::ExprIndex || base_node.kind == AstKind::UnsafeExpr
            || (base_node.kind == AstKind::ExprUnary && base_node.int_value == 82)) {
            struct_id = self.cfg_struct_id(base_index, 0);
            base_ptr = self.cfg_struct_address(base_index, first_parameter, parameter_count, 0);
        } else { return false; }
        if struct_id == 0 || base_ptr == TARGET_VALUE_NONE { return false; }
        let field_id: u32 = self.find_field(struct_id, field_node.str_offset, field_node.str_len);
        if field_id == 0 { return false; }
        let field_slot: usize = (field_id - 1) as usize;
        let field_type: TargetTypeTag = self.field_type_tags[field_slot] as TargetTypeTag;
        if self.structured_cfg && self.field_byte_counts[field_slot] != 0 {
            if self.field_array_structs[field_slot] != 0 {
                return self.initialize_record_array_field(base_ptr,field_slot,value_index,first_parameter,parameter_count);
            }
            return self.copy_array_into_field(base_ptr,field_slot,value_index,first_parameter,parameter_count);
        }
        if self.structured_cfg && self.field_struct_ids[field_slot] != 0 {
            let nested_struct: u32 = self.field_struct_ids[field_slot];
            if self.cfg_struct_id(value_index, 0) != nested_struct { return false; }
            let source_address: u32 = self.cfg_struct_address(value_index, first_parameter, parameter_count, 0);
            return source_address != 0 && self.cfg_copy_fields(base_ptr, source_address,
                nested_struct, self.field_offsets[field_slot], 0, statement_index, 0);
        }
        let value: u32 = self.lower_expression(
            value_index, field_type, first_parameter, parameter_count
        );
        if value == TARGET_VALUE_NONE { return false; }
        let first_operand: u32 = self.operand_count as u32;
        if !self.append_operand(base_ptr) || !self.append_operand(value)
            || !self.append_instruction(
                TargetOpcode::Store, TARGET_VALUE_NONE, field_type,
                first_operand, 2, statement_index
            ) { return false; }
        unsafe {
            (*(self.instructions + self.instruction_count - 1)).immediate_bits =
                self.field_offsets[field_slot] as u64;
        }
        return true;
    }

    pub fn lower_expression(
        mut self: &mut Self,
        expression_index: usize,
        type_tag: TargetTypeTag,
        first_parameter: usize,
        parameter_count: usize
    ) -> u32 {
        if self.nodes == null || expression_index == 0
            || expression_index >= self.node_count {
            return TARGET_VALUE_NONE;
        }
        let expression: AstNode = unsafe { *(self.nodes + expression_index) };
        if self.constant_evaluation && type_tag == TargetTypeTag::Bool {
            if expression.kind == AstKind::ExprBinary && expression.int_value >= 86 && expression.int_value <= 91 {
                return self.lower_condition_expression(expression_index, first_parameter, parameter_count);
            }
            if expression.kind == AstKind::ExprUnary && expression.int_value == 98 {
                let child: u32 = self.lower_expression(expression.first_child, TargetTypeTag::Bool, 0, 0);
                let zero: u32 = self.append_value(TargetTypeTag::Bool, 0, 0);
                if child == 0 || zero == 0 || !self.append_instruction(TargetOpcode::ConstInt, zero, TargetTypeTag::Bool, 0, 0, expression_index) { return 0; }
                let first: u32 = self.operand_count as u32;
                let result: u32 = self.append_value(TargetTypeTag::Bool, 0, 0);
                if result == 0 || !self.append_operand(child) || !self.append_operand(zero)
                    || !self.append_instruction(TargetOpcode::Compare, result, TargetTypeTag::Bool, first, 2, expression_index) { return 0; }
                unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = 86; }
                return result;
            }
        }
        if self.constant_evaluation && (expression.kind == AstKind::ExprConditional
            || (expression.kind == AstKind::ExprBinary && (expression.int_value == 110 || expression.int_value == 111))) {
            let mut bits: u64 = 0;
            if !self.constant_control_bits(expression_index, type_tag, &mut bits) { return 0; }
            let result: u32 = self.append_value(type_tag, 0, 0);
            let mut opcode: TargetOpcode = TargetOpcode::ConstInt;
            if target_type_is_float(type_tag) { opcode = TargetOpcode::ConstFloat; }
            if result == 0 || !self.append_instruction(opcode, result, type_tag, 0, 0, expression_index) { return 0; }
            unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = bits; }
            return result;
        }
        if self.structured_cfg && expression.kind == AstKind::ExprConditional {
            return self.cfg_conditional_value(expression_index, type_tag, first_parameter, parameter_count);
        }
        if self.structured_cfg && expression.kind == AstKind::ExprMatch {
            return self.cfg_match_value(expression_index,type_tag,first_parameter,parameter_count);
        }
        if self.structured_cfg && type_tag == TargetTypeTag::Bool
            && expression.kind == AstKind::ExprBinary
            && (expression.int_value == 110 || expression.int_value == 111) {
            return self.cfg_boolean_value(expression_index, first_parameter, parameter_count);
        }
        if target_type_is_float(type_tag) && expression.kind == AstKind::ExprLiteral {
            let mut bits: u64 = 0;
            if expression.str_offset > self.source_len || expression.str_len > self.source_len - expression.str_offset
                || !native_decimal_float_bits(unsafe { self.source + expression.str_offset },
                    expression.str_len, type_tag, &mut bits) { return 0; }
            let value: u32 = self.append_value(type_tag, 0, 0);
            if value == 0 || !self.append_instruction(TargetOpcode::ConstFloat,
                value, type_tag, 0, 0, expression_index) { return 0; }
            unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = bits; }
            return value;
        }
        if target_type_is_float(type_tag) && expression.kind == AstKind::ExprUnary && expression.int_value == 81 {
            let child: usize = expression.first_child;
            if child == 0 || child >= self.node_count || unsafe { (*(self.nodes + child)).next_sibling } != 0 { return 0; }
            let operand: u32 = self.lower_expression(child, type_tag, first_parameter, parameter_count);
            let first: u32 = self.operand_count as u32;
            if operand == 0 || !self.append_operand(operand) { return 0; }
            let value: u32 = self.append_value(type_tag, 0, 0);
            if value == 0 || !self.append_instruction(TargetOpcode::FloatNeg,
                value, type_tag, first, 1, expression_index) { return 0; }
            return value;
        }
        if expression.kind == AstKind::ExprUnary && expression.int_value == 95 {
            let width: u32 = target_integer_width(type_tag);
            let child: usize = expression.first_child;
            if width == 0 || child == 0 || child >= self.node_count
                || unsafe { (*(self.nodes + child)).next_sibling } != 0 { return 0; }
            let operand: u32 = self.lower_expression(child, type_tag, first_parameter, parameter_count);
            if operand == 0 { return 0; }
            let mask: u32 = self.append_value(type_tag, 0, 0);
            if mask == 0 || !self.append_instruction(TargetOpcode::ConstInt,
                mask, type_tag, 0, 0, expression_index) { return 0; }
            let mut bits: u64 = 18446744073709551615;
            if width < 64 { bits = ((1 as u64) << (width as u64)) - 1; }
            unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = bits; }
            let first: u32 = self.operand_count as u32;
            if !self.append_operand(operand) || !self.append_operand(mask) { return 0; }
            let result: u32 = self.append_value(type_tag, 0, 0);
            if result == 0 || !self.append_instruction(TargetOpcode::BitXor,
                result, type_tag, first, 2, expression_index) { return 0; }
            return result;
        }
        if expression.kind == AstKind::ExprUnary && expression.int_value == 81
            && (type_tag == TargetTypeTag::I64 || type_tag == TargetTypeTag::I32 || type_tag == TargetTypeTag::I8 || type_tag == TargetTypeTag::I16) {
            let child: usize = expression.first_child;
            if child != 0 && child < self.node_count
                && unsafe { (*(self.nodes + child)).kind } != AstKind::ExprLiteral {
                let operand: u32 = self.lower_expression(child, type_tag, first_parameter, parameter_count);
                if operand == 0 { return 0; }
                let zero: u32 = self.append_value(type_tag, 0, 0);
                if zero == 0 || !self.append_instruction(TargetOpcode::ConstInt, zero, type_tag, 0, 0, expression_index) { return 0; }
                let first: u32 = self.operand_count as u32;
                if !self.append_operand(zero) || !self.append_operand(operand) { return 0; }
                let result: u32 = self.append_value(type_tag, 0, 0);
                if result == 0 || !self.append_instruction(TargetOpcode::Sub, result, type_tag, first, 2, expression_index) { return 0; }
                return result;
            }
            if child == 0 || child >= self.node_count
                || unsafe { (*(self.nodes + child)).kind } != AstKind::ExprLiteral { return 0; }
            let value: u32 = self.lower_integer_literal(child, TargetTypeTag::U64);
            if value == 0 { return 0; }
            let instruction_index: usize = self.instruction_count - 1;
            let magnitude: u64 = unsafe { (*(self.instructions + instruction_index)).immediate_bits };
            let mut maximum: u64 = 9223372036854775808;
            if type_tag == TargetTypeTag::I32 { maximum = 2147483648; }
            if type_tag == TargetTypeTag::I8 { maximum = 128; }
            if type_tag == TargetTypeTag::I16 { maximum = 32768; }
            if magnitude > maximum { return 0; }
            let mut bits: u64 = 0 as u64 - magnitude;
            if type_tag == TargetTypeTag::I32 { bits = bits & 4294967295; }
            if type_tag == TargetTypeTag::I8 { bits = bits & 255; }
            if type_tag == TargetTypeTag::I16 { bits = bits & 65535; }
            unsafe {
                (*(self.instructions + instruction_index)).type_tag = type_tag;
                (*(self.instructions + instruction_index)).immediate_bits = bits;
                (*(self.values + value as usize - 1)).type_tag = type_tag;
            }
            return value;
        }
        if self.structured_cfg && expression.kind == AstKind::ExprUnary && expression.int_value == 92 {
            let child: usize = expression.first_child;
            if child == 0 || child >= self.node_count { return 0; }
            let binding: AstNode = unsafe { *(self.nodes + child) };
            if binding.kind != AstKind::ExprIdent { return 0; }
            let slot: usize = self.cfg_find_local(binding.str_offset, binding.str_len);
            if slot >= self.local_count || (self.local_struct_ids[slot] == 0 && self.local_storage_types[slot] == 0) {
                return 0;
            }
            return self.local_value_ids[slot] as u32;
        }
        if expression.kind == AstKind::ExprLiteral {
            let first_ch: u8 = unsafe { *(self.source + expression.str_offset) };
            if first_ch == 34 {
                return self.lower_string_literal(expression_index);
            }
            if type_tag == TargetTypeTag::Bool {
                let mut sem_literal: Sema = Sema::new();
                let mut bool_value: u64 = 2;
                if sem_literal.source_slice_equals(
                    self.source, self.source_len,
                    expression.str_offset, expression.str_len,
                    "false", 5
                ) {
                    bool_value = 0;
                } else if sem_literal.source_slice_equals(
                    self.source, self.source_len,
                    expression.str_offset, expression.str_len,
                    "true", 4
                ) {
                    bool_value = 1;
                }
                if bool_value <= 1 {
                    let value_id: u32 = self.append_value(
                        TargetTypeTag::Bool, 0, 0
                    );
                    if value_id == TARGET_VALUE_NONE
                        || !self.append_instruction(
                            TargetOpcode::ConstInt,
                            value_id,
                            TargetTypeTag::Bool,
                            0,
                            0,
                            expression_index
                        ) {
                        return TARGET_VALUE_NONE;
                    }
                    let instruction_index: usize = self.instruction_count - 1;
                    unsafe {
                        (*(self.instructions + instruction_index)).immediate_bits =
                            bool_value;
                    }
                    return value_id;
                }
                return TARGET_VALUE_NONE;
            }
            return self.lower_integer_literal(expression_index, type_tag);
        }
        if expression.kind == AstKind::UnsafeExpr {
            if expression.first_child == 0
                || expression.first_child >= self.node_count
                || unsafe { (*(self.nodes + expression.first_child)).next_sibling } != 0 {
                return TARGET_VALUE_NONE;
            }
            return self.lower_expression(
                expression.first_child, type_tag, first_parameter, parameter_count
            );
        }
        if expression.kind == AstKind::ExprIdent {
            let mut sem_ident: Sema = Sema::new();
            if sem_ident.source_slice_equals(
                self.source, self.source_len,
                expression.str_offset, expression.str_len,
                "null", 4
            ) {
                if type_tag != TargetTypeTag::Pointer {
                    return TARGET_VALUE_NONE;
                }
                let null_value: u32 = self.append_value(
                    TargetTypeTag::Pointer, 0, 0
                );
                if null_value == TARGET_VALUE_NONE
                    || !self.append_instruction(
                        TargetOpcode::ConstInt,
                        null_value,
                        TargetTypeTag::Pointer,
                        0,
                        0,
                        expression_index
                    ) {
                    return TARGET_VALUE_NONE;
                }
                return null_value;
            }
            let local_val: u32 = self.find_parameter_value(
                first_parameter,
                parameter_count,
                expression.str_offset,
                expression.str_len
            );
            if local_val != TARGET_VALUE_NONE {
                if self.structured_cfg {
                    let slot: usize = self.cfg_find_local(expression.str_offset, expression.str_len);
                    if slot < self.local_count && self.local_storage_types[slot] != 0 {
                        return self.cfg_load_local(slot, expression_index);
                    }
                }
                return local_val;
            }
            let const_idx: isize = self.find_module_const(
                expression.str_offset, expression.str_len
            );
            if const_idx >= 0 {
                let ci: usize = const_idx as usize;
                if !self.resolve_module_const(ci) {
                    if self.error_node == 0 { self.error_node = expression_index; }
                    return 0;
                }
                let const_type: TargetTypeTag = self.const_type_tags[ci] as TargetTypeTag;
                if type_tag != TargetTypeTag::Invalid && type_tag != TargetTypeTag::Void
                    && type_tag != const_type {
                    return TARGET_VALUE_NONE;
                }
                let value: u32 = self.append_value(const_type, 0, 0);
                let mut opcode: TargetOpcode = TargetOpcode::ConstInt;
                if target_type_is_float(const_type) { opcode = TargetOpcode::ConstFloat; }
                if value == 0 || !self.append_instruction(opcode, value, const_type, 0, 0, expression_index) { return 0; }
                unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = self.const_bits[ci]; }
                return value;
            }
            let g_idx: isize = self.find_global_bss(expression.str_offset, expression.str_len);
            if g_idx >= 0 {
                let gi: usize = g_idx as usize;
                let ptr_val: u32 = self.append_value(TargetTypeTag::Pointer, 0, 0);
                if ptr_val == TARGET_VALUE_NONE { return TARGET_VALUE_NONE; }
                let sym_slice: TargetSourceSlice = TargetSourceSlice {
                    offset: expression.str_offset,
                    length: expression.str_len
                };
                if !self.append_instruction(
                    TargetOpcode::AllocStack, ptr_val, TargetTypeTag::Pointer,
                    0, 0, expression_index
                ) {
                    return TARGET_VALUE_NONE;
                }
                let alloc_idx: usize = self.instruction_count - 1;
                let mut instr: TargetInstruction = unsafe { *(self.instructions + alloc_idx) };

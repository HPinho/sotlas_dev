            return result_val;
        }
        if expression.kind == AstKind::ExprPath && self.payload_record(expression_index) != 0 {
            return self.lower_payload_constructor(expression_index,first_parameter,parameter_count);
        }
        if expression.kind == AstKind::ExprPath {
            let mut sep_index: usize = 0;
            let mut found_sep: bool = false;
            let mut i: usize = 0;
            while i + 1 < expression.str_len {
                let c1: u8 = unsafe { *(self.source + expression.str_offset + i) };
                let c2: u8 = unsafe { *(self.source + expression.str_offset + i + 1) };
                if c1 == 58 && c2 == 58 {
                    sep_index = i;
                    found_sep = true;
                    break;
                }
                i = i + 1;
            }
            if !found_sep {
                return TARGET_VALUE_NONE;
            }
            let enum_offset: usize = expression.str_offset;
            let enum_len: usize = sep_index;
            let variant_offset: usize = expression.str_offset + sep_index + 2;
            let variant_len: usize = expression.str_len - (sep_index + 2);
            let enum_id: u32 = self.find_enum(enum_offset, enum_len);
            if enum_id == 0 {
                return TARGET_VALUE_NONE;
            }
            let variant_val: u64 = self.find_variant(enum_id, variant_offset, variant_len);
            let mut actual_type: TargetTypeTag = type_tag;
            if actual_type == TargetTypeTag::Invalid {
                actual_type = TargetTypeTag::U32;
            }
            let val_id: u32 = self.append_value(actual_type, 0, 0);
            if val_id == TARGET_VALUE_NONE {
                return TARGET_VALUE_NONE;
            }
            if !self.append_instruction(
                TargetOpcode::ConstInt,
                val_id,
                actual_type,
                0,
                0,
                expression_index
            ) {
                return TARGET_VALUE_NONE;
            }
            let const_idx: usize = self.instruction_count - 1;
            unsafe {
                (*(self.instructions + const_idx)).immediate_bits = variant_val;
            }
            return val_id;
        }
        if expression.kind == AstKind::ExprBinary
            && type_tag == TargetTypeTag::Pointer
            && (expression.int_value == 80 || expression.int_value == 81) {
            let left_index: usize = expression.first_child;
            if left_index == 0 || left_index >= self.node_count {
                return TARGET_VALUE_NONE;
            }
            let left_node: AstNode = unsafe { *(self.nodes + left_index) };
            let right_index: usize = left_node.next_sibling;
            if right_index == 0 || right_index >= self.node_count
                || unsafe { (*(self.nodes + right_index)).next_sibling } != 0 {
                return TARGET_VALUE_NONE;
            }

            let mut sem: Sema = Sema::new();
            let pointer_type_ref: usize = self.pointer_expression_type_ref(left_index);
            let stride: usize = self.pointer_pointee_stride(pointer_type_ref);
            if stride == 0 {
                return TARGET_VALUE_NONE;
            }

            let left_value: u32 = self.lower_expression(
                left_index, TargetTypeTag::Pointer,
                first_parameter, parameter_count
            );
            if left_value == TARGET_VALUE_NONE {
                return TARGET_VALUE_NONE;
            }

            let mut right_type: TargetTypeTag = TargetTypeTag::U64;
            let right_type_ref: usize = sem.infer_expression_type_ref(
                self.nodes, self.node_count, right_index,
                self.source, self.source_len
            );
            if right_type_ref != 0 {
                right_type = self.type_tag_for(right_type_ref);
            }
            let offset_type: TargetTypeTag = self.condition_expression_type(
                right_index, first_parameter, parameter_count);
            if offset_type != TargetTypeTag::Invalid { right_type = offset_type; }
            if right_type != TargetTypeTag::U8 && right_type != TargetTypeTag::U16
                && right_type != TargetTypeTag::I8 && right_type != TargetTypeTag::I16
                && right_type != TargetTypeTag::U32
                && right_type != TargetTypeTag::U64
                && right_type != TargetTypeTag::Usize && right_type != TargetTypeTag::I32
                && right_type != TargetTypeTag::I64 && right_type != TargetTypeTag::Isize {
                return TARGET_VALUE_NONE;
            }
            let right_value: u32 = self.lower_expression(
                right_index, right_type, first_parameter, parameter_count
            );
            if right_value == TARGET_VALUE_NONE {
                return TARGET_VALUE_NONE;
            }

            let first_operand: u32 = self.operand_count as u32;
            if !self.append_operand(left_value) || !self.append_operand(right_value) {
                return TARGET_VALUE_NONE;
            }
            let result: u32 = self.append_value(TargetTypeTag::Pointer, 0, 0);
            if result == TARGET_VALUE_NONE || !self.append_instruction(
                TargetOpcode::PtrOffset, result, TargetTypeTag::Pointer,
                first_operand, 2, expression_index
            ) {
                return TARGET_VALUE_NONE;
            }
            let ptr_index: usize = self.instruction_count - 1;
            let mut immediate: u64 = stride as u64;
            if expression.int_value == 81 {
                immediate = immediate | ((1 as u64) << 32);
            }
            unsafe {
                (*(self.instructions + ptr_index)).immediate_bits = immediate;
            }
            return result;
        }
        if expression.kind == AstKind::ExprUnary
            && expression.int_value == 98
            && type_tag == TargetTypeTag::Bool {
            return self.lower_condition_expression(
                expression_index, first_parameter, parameter_count
            );
        }
        if expression.kind == AstKind::ExprBinary
            && type_tag == TargetTypeTag::Bool
            && ((expression.int_value >= 86 && expression.int_value <= 91)
                || expression.int_value == 110 || expression.int_value == 111) {
            return self.lower_condition_expression(
                expression_index, first_parameter, parameter_count
            );
        }
        if expression.kind != AstKind::ExprBinary
            || expression.first_child == 0
            || expression.first_child >= self.node_count {
            return TARGET_VALUE_NONE;
        }
        let left_index: usize = expression.first_child;
        let left: u32 = self.lower_expression(
            left_index, type_tag, first_parameter, parameter_count
        );
        if left == TARGET_VALUE_NONE {
            return TARGET_VALUE_NONE;
        }
        let right_index: usize = unsafe {
            (*(self.nodes + left_index)).next_sibling
        };
        if right_index == 0 || right_index >= self.node_count
            || unsafe { (*(self.nodes + right_index)).next_sibling } != 0 {
            return TARGET_VALUE_NONE;
        }
        let right: u32 = self.lower_expression(
            right_index, type_tag, first_parameter, parameter_count
        );
        if right == TARGET_VALUE_NONE {
            return TARGET_VALUE_NONE;
        }
        let mut opcode: TargetOpcode = TargetOpcode::Invalid;
        if expression.int_value == 80 {
            opcode = TargetOpcode::Add;
        } else if expression.int_value == 81 {
            opcode = TargetOpcode::Sub;
        } else if expression.int_value == 82 {
            opcode = TargetOpcode::Mul;
        } else if expression.int_value == 83 {
            opcode = TargetOpcode::Div;
        } else if expression.int_value == 84 {
            opcode = TargetOpcode::Mod;
        } else if expression.int_value == 92 {
            opcode = TargetOpcode::BitAnd;
        } else if expression.int_value == 93 {
            opcode = TargetOpcode::BitOr;
        } else if expression.int_value == 94 {
            opcode = TargetOpcode::BitXor;
        } else if expression.int_value == 96 {
            opcode = TargetOpcode::ShiftLeft;
        } else if expression.int_value == 97 {
            opcode = TargetOpcode::ShiftRight;
        } else {
            return TARGET_VALUE_NONE;
        }
        let narrow_bitwise: bool = (type_tag == TargetTypeTag::U8
            || type_tag == TargetTypeTag::U16)
            && (opcode == TargetOpcode::BitAnd || opcode == TargetOpcode::BitOr
                || opcode == TargetOpcode::BitXor);
        // Arithmetic on narrow unsigned integers is computed in a 32-bit
        // register and normalized to the declared width by the object writer.
        // Signed narrow results are sign-extended by the same typed writer.
        let narrow_arithmetic: bool = (type_tag == TargetTypeTag::U8
            || type_tag == TargetTypeTag::U16)
            && (opcode == TargetOpcode::Add || opcode == TargetOpcode::Sub
                || opcode == TargetOpcode::Mul);
        let integer_shift: bool = opcode == TargetOpcode::ShiftLeft || opcode == TargetOpcode::ShiftRight;
        if integer_shift {
            let width: u32 = target_integer_width(type_tag);
            if width == 0 { return TARGET_VALUE_NONE; }
            let count: TargetInstruction = unsafe { *(self.instructions + self.instruction_count - 1) };
            // Known invalid counts fail during lowering. Parameters, calls and
            // computed counts use the backend's full-width runtime guard.
            if count.opcode == TargetOpcode::ConstInt && count.result_value == right
                && count.immediate_bits >= width as u64 { return TARGET_VALUE_NONE; }
        }
        let float_arithmetic: bool = target_type_is_float(type_tag)
            && (opcode == TargetOpcode::Add || opcode == TargetOpcode::Sub
                || opcode == TargetOpcode::Mul || opcode == TargetOpcode::Div);
        if !narrow_bitwise && !narrow_arithmetic && !integer_shift && !float_arithmetic
            && type_tag != TargetTypeTag::U32
            && type_tag != TargetTypeTag::U64
            && type_tag != TargetTypeTag::Usize
            && type_tag != TargetTypeTag::I8 && type_tag != TargetTypeTag::I16 && type_tag != TargetTypeTag::I32 && type_tag != TargetTypeTag::I64 {
            return TARGET_VALUE_NONE;
        }
        let first_operand: u32 = self.operand_count as u32;
        if !self.append_operand(left) || !self.append_operand(right) {
            return TARGET_VALUE_NONE;
        }
        let result: u32 = self.append_value(type_tag, 0, 0);
        if result == TARGET_VALUE_NONE || !self.append_instruction(
            opcode, result, type_tag, first_operand, 2, expression_index
        ) {
            return TARGET_VALUE_NONE;
        }
        return result;
    }

    pub fn lower_direct_void_call_statement(
        mut self: &mut Self,
        expression_index: usize,
        first_parameter: usize,
        parameter_count: usize
    ) -> bool {
        if self.nodes == null || expression_index == 0
            || expression_index >= self.node_count {
            return false;
        }
        let expression: AstNode = unsafe { *(self.nodes + expression_index) };
        if expression.kind != AstKind::ExprCall || expression.first_child == 0
            || expression.first_child >= self.node_count {
            return false;
        }
        let callee_index: usize = expression.first_child;
        let callee: AstNode = unsafe { *(self.nodes + callee_index) };
        if callee.str_len == 0
            || callee.str_offset > self.source_len
            || callee.str_len > self.source_len - callee.str_offset {
            return false;
        }

        let callee_decl: usize = self.cfg_call_declaration(expression_index, 0);
        if callee_decl == 0
            || self.function_return_type_from_ast(callee_decl) != TargetTypeTag::Void {
            return false;
        }
        let expected_count: u32 = self.function_parameter_count_from_ast(callee_decl);
        if expected_count > 24 {
            return false;
        }

        let mut argument_values: [u32; 24] = 0;
        let mut argument_count: u32 = 0;
        let mut symbol: TargetSourceSlice = TargetSourceSlice { offset: callee.str_offset, length: callee.str_len };
        if callee.kind == AstKind::ExprPath || callee.kind == AstKind::ExprFieldAccess {
            let declared: AstNode = unsafe { *(self.nodes + callee_decl) };
            if declared.parent == 0 || declared.parent >= self.node_count { return false; }
            let owner: AstNode = unsafe { *(self.nodes + declared.parent) };
            if owner.kind != AstKind::ImplDecl { return false; }
            symbol = self.append_mangled_name(owner.str_offset, owner.str_len, declared.str_offset, declared.str_len);
            if callee.kind == AstKind::ExprFieldAccess {
                if expected_count == 0 || self.function_parameter_type_from_ast(callee_decl, 0) != TargetTypeTag::Pointer
                    || self.function_parameter_struct_from_ast(callee_decl, 0) != 0 { return false; }
                let receiver: u32 = self.cfg_struct_address(callee.first_child, first_parameter, parameter_count, 0);
                if receiver == 0 { return false; }
                argument_values[0] = receiver;
                argument_count = 1;
            }
        } else if callee.kind != AstKind::ExprIdent { return false; }
        let mut argument_index: usize = callee.next_sibling;
        while argument_index != 0 {
            if argument_index >= self.node_count || argument_count >= expected_count {
                return false;
            }
            let argument_type: TargetTypeTag = self.function_parameter_type_from_ast(
                callee_decl, argument_count
            );
            if argument_type == TargetTypeTag::Invalid || argument_type == TargetTypeTag::Void {
                return false;
            }
            let mut argument_value: u32 = self.lower_expression(
                argument_index, argument_type, first_parameter, parameter_count
            );
            if argument_value == TARGET_VALUE_NONE {
                return false;
            }
            let struct_id: u32 = self.function_parameter_struct_from_ast(callee_decl, argument_count);
            if struct_id != 0 {
                if self.cfg_struct_id(argument_index, 0) != struct_id { return false; }
                if self.function_parameter_domain_from_ast(callee_decl, argument_count) != 6 {
                    let copy: u32 = self.allocate_struct(struct_id, argument_index);
                    if copy == 0 || !self.cfg_copy_fields(copy, argument_value, struct_id, 0, 0, argument_index, 0) { return false; }
                    argument_value = copy;
                }
            }
            argument_values[argument_count as usize] = argument_value;
            argument_count = argument_count + 1;
            argument_index = unsafe { (*(self.nodes + argument_index)).next_sibling };
        }
        if argument_count != expected_count {
            return false;
        }

        let first_operand: u32 = self.operand_count as u32;
        let mut published_argument: u32 = 0;
        while published_argument < argument_count {
            if !self.append_operand(argument_values[published_argument as usize]) { return false; }
            published_argument = published_argument + 1;
        }

        if !self.append_instruction(
            TargetOpcode::Call,
            TARGET_VALUE_NONE,
            TargetTypeTag::Void,
            first_operand,
            argument_count,
            expression_index
        ) {
            return false;
        }
        // SV8.48c: void calls also carry the same typed ownership
        // signature as value-returning calls. No implicit alias may be
        // smuggled through an unmarked observer call.
        let capabilities: u64 = self.call_capability_profile(callee_decl, argument_count);
        if capabilities == 18446744073709551615 { return false; }
        let call_index: usize = self.instruction_count - 1;
        let mut call: TargetInstruction = unsafe { *(self.instructions + call_index) };
        call.symbol = symbol;
        call.flags = TARGET_CALL_CAPABILITIES_TYPED;
        call.immediate_bits = capabilities;
        unsafe { *(self.instructions + call_index) = call; }
        return true;
    }

    pub fn lower_return_statement(
        mut self: &mut Self,
        return_index: usize,
        return_type: TargetTypeTag,
        first_parameter: usize,
        parameter_count: usize
    ) -> bool {
        if return_index == 0 || return_index >= self.node_count {
            return false;
        }
        let return_node: AstNode = unsafe { *(self.nodes + return_index) };
        if return_node.kind != AstKind::ReturnStmt || return_node.next_sibling != 0 {
            return false;
        }
        if return_type == TargetTypeTag::Void {
            if return_node.first_child != 0 {
                return false;
            }
            return self.append_instruction(
                TargetOpcode::Return,
                TARGET_VALUE_NONE,
                TargetTypeTag::Void,
                0,
                0,
                return_index
            );
        }
        if return_node.first_child == 0 || return_node.first_child >= self.node_count {
            return false;
        }
        let expression_index: usize = return_node.first_child;
        if unsafe { (*(self.nodes + expression_index)).next_sibling } != 0 {
            return false;
        }
        let result: u32 = self.lower_expression(
            expression_index, return_type, first_parameter, parameter_count
        );
        if result == TARGET_VALUE_NONE { return false; }
        let first_operand: u32 = self.operand_count as u32;
        return self.append_operand(result)
            && self.append_instruction(
                TargetOpcode::Return, TARGET_VALUE_NONE, return_type,
                first_operand, 1, return_index
            );
    }

    pub fn condition_expression_type(
        self: &Self,
        expression_index: usize,
        first_parameter: usize,
        parameter_count: usize
    ) -> TargetTypeTag {
        if self.nodes == null || self.values == null || expression_index == 0
            || expression_index >= self.node_count {
            return TargetTypeTag::Invalid;
        }
        let expression: AstNode = unsafe { *(self.nodes + expression_index) };
        if self.payload_record(expression_index) != 0 { return TargetTypeTag::Pointer; }
        if expression.kind == AstKind::MatchValueBlock {
            let sem: Sema = Sema::new();
            return self.condition_expression_type(sem.match_block_tail(self.nodes,self.node_count,expression_index),first_parameter,parameter_count);
        }

        if expression.kind == AstKind::ExprMatch {
            if self.match_record_id(expression_index,0) != 0 { return TargetTypeTag::Pointer; }
            let subject: usize = expression.first_child;
            if subject == 0 || subject >= self.node_count { return TargetTypeTag::Invalid; }
            let arm: usize = unsafe{(*(self.nodes+subject)).next_sibling};
            if arm == 0 || arm >= self.node_count { return TargetTypeTag::Invalid; }
            let pattern: usize = unsafe{(*(self.nodes+arm)).first_child};
            if pattern == 0 || pattern >= self.node_count { return TargetTypeTag::Invalid; }
            let body: usize = unsafe{(*(self.nodes+pattern)).next_sibling};
            if body == 0 || body >= self.node_count { return TargetTypeTag::Invalid; }
            let node: AstNode = unsafe{*(self.nodes+body)};
            let mut sem: Sema = Sema::new();
            if node.kind == AstKind::ExprLiteral
                && (sem.source_slice_equals(self.source,self.source_len,node.str_offset,node.str_len,"true",4)
                    || sem.source_slice_equals(self.source,self.source_len,node.str_offset,node.str_len,"false",5)) {
                return TargetTypeTag::Bool;
            }
            return self.condition_expression_type(body,first_parameter,parameter_count);
        }

        if self.structured_cfg && expression.kind == AstKind::ExprFieldAccess {
            let owner: u32 = self.cfg_struct_id(expression.first_child, 0);
            let field: u32 = self.find_field(owner, expression.str_offset, expression.str_len);
            if field != 0 { return self.field_type_tags[field as usize - 1] as TargetTypeTag; }
        }
        // Enum paths lower to their validated U32 discriminant. Unknown paths
        // still fail in lower_expression before publishing a value.
        if expression.kind == AstKind::ExprPath { return TargetTypeTag::U32; }
        if self.structured_cfg && expression.kind == AstKind::ExprIndex {
            if expression.first_child != 0 && expression.first_child < self.node_count {
                let base: AstNode = unsafe { *(self.nodes + expression.first_child) };
                if base.kind == AstKind::ExprIdent {
                    let slot: usize = self.cfg_find_local(base.str_offset, base.str_len);
                    if slot < self.local_count && self.local_array_counts[slot] != 0 {
                        if self.local_struct_ids[slot] != 0 { return TargetTypeTag::Pointer; }
                        return self.local_array_types[slot] as TargetTypeTag;
                    }
                    if slot >= self.local_count {
                        let global: isize = self.find_global_bss(base.str_offset, base.str_len);
                        if global >= 0 && unsafe { g_bss_sym_is_array[global as usize] } != 0 {
                            return unsafe { g_bss_sym_element_types[global as usize] } as TargetTypeTag;
                        }
                    }
                }
            }
            let field: u32 = self.indexed_array_field(expression_index);
            if field != 0 { return self.field_array_types[field as usize - 1] as TargetTypeTag; }
        }
        if expression.kind == AstKind::ExprCall {
            let declaration: usize = self.cfg_call_declaration(expression_index, 0);
            if declaration != 0 { return self.function_return_type_from_ast(declaration); }
        }
        // Carry indexed/local field widths through arithmetic before a cast.
        // The prototype Sema can infer an array declaration for its element;
        // native storage metadata is authoritative for an executable value.
        if expression.kind == AstKind::ExprBinary
            && ((expression.int_value >= 80 && expression.int_value <= 84)
                || (expression.int_value >= 92 && expression.int_value <= 97)) {
            let left_index: usize = expression.first_child;
            if left_index == 0 || left_index >= self.node_count { return TargetTypeTag::Invalid; }
            let right_index: usize = unsafe { (*(self.nodes + left_index)).next_sibling };
            if right_index == 0 || right_index >= self.node_count { return TargetTypeTag::Invalid; }
            let left_type: TargetTypeTag = self.condition_expression_type(left_index, first_parameter, parameter_count);
            let right_type: TargetTypeTag = self.condition_expression_type(right_index, first_parameter, parameter_count);
            if left_type != TargetTypeTag::Pointer && right_type != TargetTypeTag::Pointer {
                if left_type == TargetTypeTag::Invalid { return right_type; }
                if right_type == TargetTypeTag::Invalid || left_type == right_type { return left_type; }
                return TargetTypeTag::Invalid;
            }
        }
        if expression.kind == AstKind::ExprIdent {
            if self.structured_cfg {
                let slot: usize = self.cfg_find_local(expression.str_offset, expression.str_len);
                if slot < self.local_count && self.local_storage_types[slot] != 0 {
                    return self.local_storage_types[slot] as TargetTypeTag;
                }
            }
            let value_id: u32 = self.find_parameter_value(
                first_parameter,
                parameter_count,
                expression.str_offset,
                expression.str_len
            );
            if value_id != TARGET_VALUE_NONE && value_id != 0
                && value_id as usize <= self.value_count {
                return unsafe { (*(self.values + value_id as usize - 1)).type_tag };
            }
            let const_index: isize = self.find_module_const(
                expression.str_offset, expression.str_len
            );
            if const_index >= 0 {
                return self.const_type_tags[const_index as usize] as TargetTypeTag;
            }
            let global: isize = self.find_global_bss(
                expression.str_offset, expression.str_len
            );
            if global >= 0 && unsafe { g_bss_sym_is_array[global as usize] } == 0 {
                return unsafe { g_bss_sym_types[global as usize] } as TargetTypeTag;
            }
            return TargetTypeTag::Invalid;
        }

        // Scalar dereferences carry the pointee type into comparisons.
        // Do not infer an untyped unsafe byte load as U32: that would either
        // reject valid CFG guards or silently widen the memory access.
        if expression.kind == AstKind::UnsafeExpr {
            let child_index: usize = expression.first_child;
            if child_index == 0 || child_index >= self.node_count
                || unsafe { (*(self.nodes + child_index)).next_sibling } != 0 {
                return TargetTypeTag::Invalid;
            }
            return self.condition_expression_type(
                child_index, first_parameter, parameter_count
            );
        }
        if expression.kind == AstKind::ExprUnary && expression.int_value == 82 {
            let pointer_index: usize = expression.first_child;
            if pointer_index == 0 || pointer_index >= self.node_count
                || unsafe { (*(self.nodes + pointer_index)).next_sibling } != 0 {
                return TargetTypeTag::Invalid;
            }
            let pointer_type_ref: usize = self.pointer_expression_type_ref(
                pointer_index
            );
            return self.pointer_pointee_type_tag(pointer_type_ref);
        }

        if expression.kind == AstKind::ExprLiteral {
            return TargetTypeTag::Invalid;
        }

        let mut sem: Sema = Sema::new();
        let type_ref: usize = sem.infer_expression_type_ref(
            self.nodes,
            self.node_count,
            expression_index,
            self.source,
            self.source_len
        );
        if type_ref == 0 {
            return TargetTypeTag::Invalid;
        }
        return self.type_tag_for(type_ref);
    }

    pub fn pure_condition_expression(self: &Self, expression_index: usize) -> bool {
        if self.nodes == null || expression_index == 0 || expression_index >= self.node_count {
            return false;
        }
        let expression: AstNode = unsafe { *(self.nodes + expression_index) };
        if expression.kind == AstKind::ExprIdent
            || expression.kind == AstKind::ExprLiteral
            || expression.kind == AstKind::ExprPath {
            return true;
        }
        if expression.kind == AstKind::ExprFieldAccess {
            if expression.first_child == 0
                || expression.first_child >= self.node_count
                || unsafe { (*(self.nodes + expression.first_child)).next_sibling } != 0 {
                return false;
            }
            return self.pure_condition_expression(expression.first_child);
        }
        if expression.kind == AstKind::ExprUnary && expression.int_value == 98 {
            if expression.first_child == 0 || expression.first_child >= self.node_count
                || unsafe { (*(self.nodes + expression.first_child)).next_sibling } != 0 {
                return false;
            }
            return self.pure_condition_expression(expression.first_child);
        }
        if expression.kind != AstKind::ExprBinary
            || expression.first_child == 0 || expression.first_child >= self.node_count {
            return false;
        }
        if (expression.int_value < 80 || expression.int_value > 82)
            && (expression.int_value < 86 || expression.int_value > 94)
            && expression.int_value != 110 && expression.int_value != 111 {
            return false;
        }
        let left_index: usize = expression.first_child;
        let right_index: usize = unsafe { (*(self.nodes + left_index)).next_sibling };
        if right_index == 0 || right_index >= self.node_count
            || unsafe { (*(self.nodes + right_index)).next_sibling } != 0 {
            return false;
        }
        return self.pure_condition_expression(left_index)
            && self.pure_condition_expression(right_index);
    }

    pub fn lower_condition_expression(
        mut self: &mut Self,
        expression_index: usize,
        first_parameter: usize,
        parameter_count: usize
    ) -> u32 {
        if expression_index == 0 || expression_index >= self.node_count {
            return TARGET_VALUE_NONE;
        }
        let expression: AstNode = unsafe { *(self.nodes + expression_index) };
        if self.structured_cfg && (expression.kind == AstKind::ExprIdent
            || expression.kind == AstKind::UnsafeExpr
            || expression.kind == AstKind::ExprCall || expression.kind == AstKind::ExprLiteral
            || expression.kind == AstKind::ExprFieldAccess || expression.kind == AstKind::ExprIndex
            || expression.kind == AstKind::ExprConditional || expression.kind == AstKind::ExprMatch) {
            let result: u32 = self.lower_expression(
                expression_index, TargetTypeTag::Bool, first_parameter, parameter_count
            );
            if result == 0 || unsafe { (*(self.values + result as usize - 1)).type_tag } != TargetTypeTag::Bool {
                return TARGET_VALUE_NONE;
            }
            return result;
        }
        if expression.kind == AstKind::ExprIdent {
            let value_id: u32 = self.find_parameter_value(
                first_parameter, parameter_count, expression.str_offset, expression.str_len
            );
            if value_id == TARGET_VALUE_NONE || self.values == null { return TARGET_VALUE_NONE; }
            if unsafe { (*(self.values + value_id as usize - 1)).type_tag } != TargetTypeTag::Bool {
                return TARGET_VALUE_NONE;
            }
            return value_id;
        }
        if expression.kind == AstKind::ExprUnary && expression.int_value == 98 {
            let child_index: usize = expression.first_child;
            if child_index == 0 || child_index >= self.node_count
                || unsafe { (*(self.nodes + child_index)).next_sibling } != 0 {
                return TARGET_VALUE_NONE;
            }
            let child_value: u32 = self.lower_condition_expression(
                child_index, first_parameter, parameter_count
            );
            if child_value == TARGET_VALUE_NONE {
                return TARGET_VALUE_NONE;
            }
            let false_value: u32 = self.append_value(TargetTypeTag::Bool, 0, 0);
            if false_value == TARGET_VALUE_NONE
                || !self.append_instruction(
                    TargetOpcode::ConstInt, false_value, TargetTypeTag::Bool,
                    self.operand_count as u32, 0, expression_index
                ) {
                return TARGET_VALUE_NONE;
            }
            let first_operand: u32 = self.operand_count as u32;
            if !self.append_operand(child_value)
                || !self.append_operand(false_value) {
                return TARGET_VALUE_NONE;
            }
            let result: u32 = self.append_value(TargetTypeTag::Bool, 0, 0);
            if result == TARGET_VALUE_NONE
                || !self.append_instruction(
                    TargetOpcode::Compare, result, TargetTypeTag::Bool,
                    first_operand, 2, expression_index
                ) {
                return TARGET_VALUE_NONE;
            }
            let compare_index: usize = self.instruction_count - 1;
            unsafe { (*(self.instructions + compare_index)).immediate_bits = 86; }
            return result;
        }
        if expression.kind != AstKind::ExprBinary
            || expression.first_child == 0 || expression.first_child >= self.node_count {
            return TARGET_VALUE_NONE;
        }
        let left_index: usize = expression.first_child;
        let right_index: usize = unsafe { (*(self.nodes + left_index)).next_sibling };
        if right_index == 0 || right_index >= self.node_count
            || unsafe { (*(self.nodes + right_index)).next_sibling } != 0 {
            return TARGET_VALUE_NONE;
        }
        if expression.int_value == 110 || expression.int_value == 111 {
            if !self.pure_condition_expression(left_index)
                || !self.pure_condition_expression(right_index) {
                return TARGET_VALUE_NONE;
            }
            let left_bool: u32 = self.lower_condition_expression(
                left_index, first_parameter, parameter_count
            );
            let right_bool: u32 = self.lower_condition_expression(
                right_index, first_parameter, parameter_count
            );
            if left_bool == TARGET_VALUE_NONE || right_bool == TARGET_VALUE_NONE
                || self.values == null
                || left_bool as usize > self.value_count
                || right_bool as usize > self.value_count
                || unsafe { (*(self.values + left_bool as usize - 1)).type_tag }
                    != TargetTypeTag::Bool
                || unsafe { (*(self.values + right_bool as usize - 1)).type_tag }
                    != TargetTypeTag::Bool {
                return TARGET_VALUE_NONE;
            }
            let first_operand: u32 = self.operand_count as u32;
            if !self.append_operand(left_bool) || !self.append_operand(right_bool) {
                return TARGET_VALUE_NONE;
            }
            let result: u32 = self.append_value(TargetTypeTag::Bool, 0, 0);
            let mut bool_opcode: TargetOpcode = TargetOpcode::BoolAnd;
            if expression.int_value == 111 {
                bool_opcode = TargetOpcode::BoolOr;
            }
            if result == TARGET_VALUE_NONE || !self.append_instruction(
                bool_opcode,
                result,
                TargetTypeTag::Bool,
                first_operand,
                2,
                expression_index
            ) {
                return TARGET_VALUE_NONE;
            }
            return result;
        }
        if expression.int_value < 86 || expression.int_value > 91 {
            return TARGET_VALUE_NONE;
        }
        let left_type: TargetTypeTag = self.condition_expression_type(
            left_index, first_parameter, parameter_count
        );
        let right_type: TargetTypeTag = self.condition_expression_type(
            right_index, first_parameter, parameter_count
        );
        let mut compare_type: TargetTypeTag = TargetTypeTag::Invalid;
        if left_type != TargetTypeTag::Invalid {
            compare_type = left_type;
        }
        if right_type != TargetTypeTag::Invalid {
            if compare_type != TargetTypeTag::Invalid && compare_type != right_type {
                return TARGET_VALUE_NONE;
            }
            compare_type = right_type;
        }
        if compare_type == TargetTypeTag::Invalid {
            compare_type = TargetTypeTag::U32;
        }
        if compare_type != TargetTypeTag::U8
            && compare_type != TargetTypeTag::U16
            && compare_type != TargetTypeTag::U32
            && compare_type != TargetTypeTag::U64
            && compare_type != TargetTypeTag::I8 && compare_type != TargetTypeTag::I16 && compare_type != TargetTypeTag::I32
            && compare_type != TargetTypeTag::I64
            && compare_type != TargetTypeTag::Pointer && compare_type != TargetTypeTag::Bool && !target_type_is_float(compare_type) {
            return TARGET_VALUE_NONE;
        }
        if (compare_type == TargetTypeTag::Pointer || compare_type == TargetTypeTag::Bool) && expression.int_value > 87 {
            return TARGET_VALUE_NONE;
        }

        let left: u32 = self.lower_expression(
            left_index, compare_type, first_parameter, parameter_count
        );
        let right: u32 = self.lower_expression(
            right_index, compare_type, first_parameter, parameter_count
        );
        if left == TARGET_VALUE_NONE || right == TARGET_VALUE_NONE || self.values == null {
            return TARGET_VALUE_NONE;
        }
        if left == 0 || right == 0
            || left as usize > self.value_count || right as usize > self.value_count
            || unsafe { (*(self.values + left as usize - 1)).type_tag } != compare_type
            || unsafe { (*(self.values + right as usize - 1)).type_tag } != compare_type {
            return TARGET_VALUE_NONE;
        }
        let first_operand: u32 = self.operand_count as u32;
        if !self.append_operand(left) || !self.append_operand(right) {
            return TARGET_VALUE_NONE;
        }
        let result: u32 = self.append_value(TargetTypeTag::Bool, 0, 0);
        if result == TARGET_VALUE_NONE || !self.append_instruction(
            TargetOpcode::Compare, result, TargetTypeTag::Bool, first_operand, 2, expression_index
        ) {
            return TARGET_VALUE_NONE;
        }
        let compare_index: usize = self.instruction_count - 1;
        let mut compare: TargetInstruction = unsafe { *(self.instructions + compare_index) };
        compare.immediate_bits = expression.int_value as u64;
        unsafe { *(self.instructions + compare_index) = compare; }
        return result;
    }

    pub fn lower_if_return_branches(
        mut self: &mut Self,
        if_index: usize,
        return_type: TargetTypeTag,
        first_parameter: usize,
        parameter_count: usize,
        entry_first_instruction: usize
    ) -> bool {
        if if_index == 0 || if_index >= self.node_count || self.blocks == null
            || self.targets == null || self.block_count + 3 > self.block_capacity {
            return false;
        }
        let if_node: AstNode = unsafe { *(self.nodes + if_index) };
        if if_node.kind != AstKind::IfStmt || if_node.next_sibling != 0
            || if_node.first_child == 0 || if_node.first_child >= self.node_count {
            return false;
        }
        let condition_index: usize = if_node.first_child;
        let condition: AstNode = unsafe { *(self.nodes + condition_index) };
        let then_index: usize = condition.next_sibling;
        if (condition.kind != AstKind::ExprIdent && condition.kind != AstKind::ExprBinary)
            || then_index == 0
            || then_index >= self.node_count {
            return false;
        }
        let then_node: AstNode = unsafe { *(self.nodes + then_index) };
        let else_index: usize = then_node.next_sibling;
        if then_node.kind != AstKind::Block || else_index == 0
            || else_index >= self.node_count {
            return false;
        }
        let else_node: AstNode = unsafe { *(self.nodes + else_index) };
        if else_node.kind != AstKind::Block || else_node.next_sibling != 0 {
            return false;
        }
        let condition_value: u32 = self.lower_condition_expression(
            condition_index, first_parameter, parameter_count
        );
        if condition_value == TARGET_VALUE_NONE || self.values == null {
            return false;
        }
        let condition_type: TargetTypeTag = unsafe {
            (*(self.values + condition_value as usize - 1)).type_tag
        };
        if condition_type != TargetTypeTag::Bool { return false; }

        let entry_id: u32 = self.block_count as u32 + 1;
        let then_id: u32 = entry_id + 1;
        let else_id: u32 = entry_id + 2;
        let condition_operand: u32 = self.operand_count as u32;
        if !self.append_operand(condition_value)
            || !self.append_instruction(
                TargetOpcode::CondBranch, TARGET_VALUE_NONE, TargetTypeTag::Bool,
                condition_operand, 1, if_index
            ) {
            return false;
        }
        let branch_index: usize = self.instruction_count - 1;
        let first_target: u32 = self.target_count as u32;
        if !self.append_target(then_id) || !self.append_target(else_id) {
            return false;
        }
        let mut branch: TargetInstruction = unsafe {
            *(self.instructions + branch_index)
        };
        branch.first_target = first_target;
        branch.target_count = 2;
        unsafe { *(self.instructions + branch_index) = branch; }
        unsafe {
            *(self.blocks + self.block_count) = TargetBlock {
                id: entry_id,
                label: TargetSourceSlice::empty(),
                first_instruction: entry_first_instruction as u32,
                instruction_count: (self.instruction_count - entry_first_instruction) as u32
            };
        }

        let then_first_instruction: usize = self.instruction_count;
        let then_return: usize = then_node.first_child;
        if then_return == 0 || then_return >= self.node_count
            || unsafe { (*(self.nodes + then_return)).next_sibling } != 0
            || !self.lower_return_statement(
                then_return, return_type, first_parameter, parameter_count
            ) {
            return false;
        }
        unsafe {
            *(self.blocks + self.block_count + 1) = TargetBlock {
                id: then_id,
                label: TargetSourceSlice::empty(),
                first_instruction: then_first_instruction as u32,
                instruction_count: (self.instruction_count - then_first_instruction) as u32
            };
        }

        let else_first_instruction: usize = self.instruction_count;
        let else_return: usize = else_node.first_child;
        if else_return == 0 || else_return >= self.node_count
            || unsafe { (*(self.nodes + else_return)).next_sibling } != 0
            || !self.lower_return_statement(
                else_return, return_type, first_parameter, parameter_count
            ) {
            return false;
        }
        unsafe {
            *(self.blocks + self.block_count + 2) = TargetBlock {
                id: else_id,
                label: TargetSourceSlice::empty(),
                first_instruction: else_first_instruction as u32,
                instruction_count: (self.instruction_count - else_first_instruction) as u32
            };
        }
        self.block_count = self.block_count + 3;
        return true;
    }

    // Lower a leading guard clause:
    // if condition { return value; } <continuation>
    // The false edge targets the next block, which is published by subsequent
    // straight-line/control-flow lowering.
    pub fn lower_guard_return_prefix(
        mut self: &mut Self,
        if_index: usize,
        return_type: TargetTypeTag,
        first_parameter: usize,
        parameter_count: usize,
        entry_first_instruction: usize
    ) -> bool {
        if if_index == 0 || if_index >= self.node_count
            || self.blocks == null || self.targets == null
            || self.block_count + 2 > self.block_capacity {
            return false;
        }
        let if_node: AstNode = unsafe { *(self.nodes + if_index) };
        if if_node.kind != AstKind::IfStmt || if_node.next_sibling == 0
            || if_node.first_child == 0 || if_node.first_child >= self.node_count {
            return false;
        }
        let condition_index: usize = if_node.first_child;
        let condition_node: AstNode = unsafe { *(self.nodes + condition_index) };
        let then_index: usize = condition_node.next_sibling;
        if then_index == 0 || then_index >= self.node_count {
            return false;
        }
        let then_block: AstNode = unsafe { *(self.nodes + then_index) };
        if then_block.kind != AstKind::Block || then_block.next_sibling != 0
            || then_block.first_child == 0
            || then_block.first_child >= self.node_count {
            return false;
        }
        let return_index: usize = then_block.first_child;
        let return_node: AstNode = unsafe { *(self.nodes + return_index) };
        if return_node.kind != AstKind::ReturnStmt
            || return_node.next_sibling != 0 {
            return false;
        }

        let first_block: usize = self.block_count;
        let entry_id: u32 = first_block as u32 + 1;
        let return_id: u32 = entry_id + 1;
        let continuation_id: u32 = entry_id + 2;

        let condition_value: u32 = self.lower_condition_expression(
            condition_index, first_parameter, parameter_count
        );
        if condition_value == TARGET_VALUE_NONE || self.values == null
            || unsafe { (*(self.values + condition_value as usize - 1)).type_tag }
                != TargetTypeTag::Bool {
            return false;
        }
        let condition_operand: u32 = self.operand_count as u32;
        if !self.append_operand(condition_value)
            || !self.append_instruction(
                TargetOpcode::CondBranch,
                TARGET_VALUE_NONE,
                TargetTypeTag::Bool,
                condition_operand,
                1,
                if_index
            ) {
            return false;
        }
        let branch_index: usize = self.instruction_count - 1;
        let first_target: u32 = self.target_count as u32;
        if !self.append_target(return_id)
            || !self.append_target(continuation_id) {
            return false;
        }
        let mut branch: TargetInstruction = unsafe {
            *(self.instructions + branch_index)
        };
        branch.first_target = first_target;
        branch.target_count = 2;
        unsafe { *(self.instructions + branch_index) = branch; }
        unsafe {
            *(self.blocks + first_block) = TargetBlock {
                id: entry_id,
                label: TargetSourceSlice::empty(),
                first_instruction: entry_first_instruction as u32,
                instruction_count:
                    (self.instruction_count - entry_first_instruction) as u32
            };
        }

        let return_first_instruction: usize = self.instruction_count;
        if !self.lower_return_statement(
            return_index, return_type, first_parameter, parameter_count
        ) {
            return false;
        }
        unsafe {
            *(self.blocks + first_block + 1) = TargetBlock {
                id: return_id,
                label: TargetSourceSlice::empty(),
                first_instruction: return_first_instruction as u32,
                instruction_count:
                    (self.instruction_count - return_first_instruction) as u32
            };
        }
        self.block_count = self.block_count + 2;
        return true;
    }

    // Lower a search loop with one loop-carried scalar local:
    // while condition { if condition { return value; } local = expr; } return value;
    // The loop-carried local is represented by a real Phi at the loop header.
    pub fn lower_while_search_then_return(
        mut self: &mut Self,
        while_index: usize,
        return_index: usize,
        return_type: TargetTypeTag,
        first_parameter: usize,
        parameter_count: usize,
        entry_first_instruction: usize
    ) -> bool {
        if while_index == 0 || while_index >= self.node_count
            || return_index == 0 || return_index >= self.node_count
            || self.blocks == null || self.targets == null
            || self.phi_inputs == null
            || self.block_count + 6 > self.block_capacity {
            return false;
        }
        let while_node: AstNode = unsafe { *(self.nodes + while_index) };
        let final_return: AstNode = unsafe { *(self.nodes + return_index) };
        if while_node.kind != AstKind::WhileStmt
            || while_node.next_sibling != return_index
            || final_return.kind != AstKind::ReturnStmt
            || final_return.next_sibling != 0
            || while_node.first_child == 0
            || while_node.first_child >= self.node_count {
            return false;
        }

        let condition_index: usize = while_node.first_child;
        let condition_node: AstNode = unsafe { *(self.nodes + condition_index) };
        let body_index: usize = condition_node.next_sibling;
        if body_index == 0 || body_index >= self.node_count
            || unsafe { (*(self.nodes + body_index)).next_sibling } != 0 {
            return false;
        }
        let body: AstNode = unsafe { *(self.nodes + body_index) };
        let mut if_index: usize = body.first_child;
        if body.kind != AstKind::Block || if_index == 0
            || if_index >= self.node_count {
            return false;
        }
        let mut body_let_index: usize = 0;
        if unsafe { (*(self.nodes + if_index)).kind } == AstKind::LetStmt {
            body_let_index = if_index;
            if_index = unsafe { (*(self.nodes + if_index)).next_sibling };
            if if_index == 0 || if_index >= self.node_count {
                return false;
            }
        }
        let if_node: AstNode = unsafe { *(self.nodes + if_index) };
        let assignment_index: usize = if_node.next_sibling;
        if if_node.kind != AstKind::IfStmt || assignment_index == 0
            || assignment_index >= self.node_count
            || unsafe { (*(self.nodes + assignment_index)).next_sibling } != 0 {
            return false;
        }

        let test_index: usize = if_node.first_child;
        if test_index == 0 || test_index >= self.node_count {
            return false;
        }
        let test_node: AstNode = unsafe { *(self.nodes + test_index) };
        let then_index: usize = test_node.next_sibling;
        if then_index == 0 || then_index >= self.node_count
            || unsafe { (*(self.nodes + then_index)).next_sibling } != 0 {
            return false;
        }
        let then_block: AstNode = unsafe { *(self.nodes + then_index) };
        let found_return_index: usize = then_block.first_child;
        if then_block.kind != AstKind::Block || found_return_index == 0
            || found_return_index >= self.node_count
            || unsafe { (*(self.nodes + found_return_index)).kind }
                != AstKind::ReturnStmt
            || unsafe { (*(self.nodes + found_return_index)).next_sibling } != 0 {
            return false;
        }

        let assignment: AstNode = unsafe { *(self.nodes + assignment_index) };
        let local_index: usize = assignment.first_child;
        if assignment.kind != AstKind::AssignStmt || local_index == 0
            || local_index >= self.node_count {
            return false;
        }
        let local_node: AstNode = unsafe { *(self.nodes + local_index) };
        let update_index: usize = local_node.next_sibling;
        if local_node.kind != AstKind::ExprIdent || update_index == 0
            || update_index >= self.node_count
            || unsafe { (*(self.nodes + update_index)).next_sibling } != 0 {
            return false;
        }

        let initial_value: u32 = self.find_parameter_value(
            first_parameter, parameter_count,
            local_node.str_offset, local_node.str_len
        );
        if initial_value == TARGET_VALUE_NONE || self.values == null {
            return false;
        }
        let local_type: TargetTypeTag = unsafe {
            (*(self.values + initial_value as usize - 1)).type_tag
        };
        if local_type != TargetTypeTag::U32
            && local_type != TargetTypeTag::U64 {
            return false;
        }

        let first_block: usize = self.block_count;
        let preheader_id: u32 = first_block as u32 + 1;
        let header_id: u32 = preheader_id + 1;
        let body_id: u32 = preheader_id + 2;
        let found_id: u32 = preheader_id + 3;
        let latch_id: u32 = preheader_id + 4;
        let exit_id: u32 = preheader_id + 5;

        // Preheader: all straight-line instructions emitted before the while,
        // followed by an explicit edge to the loop header.
        if !self.append_instruction(
            TargetOpcode::Branch, TARGET_VALUE_NONE, TargetTypeTag::Invalid,
            self.operand_count as u32, 0, while_index
        ) {
            return false;
        }
        let preheader_branch_index: usize = self.instruction_count - 1;
        let preheader_target: u32 = self.target_count as u32;
        if !self.append_target(header_id) { return false; }
        let mut preheader_branch: TargetInstruction = unsafe {
            *(self.instructions + preheader_branch_index)
        };
        preheader_branch.first_target = preheader_target;
        preheader_branch.target_count = 1;
        unsafe { *(self.instructions + preheader_branch_index) = preheader_branch; }
        unsafe {
            *(self.blocks + first_block) = TargetBlock {
                id: preheader_id,
                label: TargetSourceSlice::empty(),
                first_instruction: entry_first_instruction as u32,
                instruction_count:
                    (self.instruction_count - entry_first_instruction) as u32
            };
        }

        // Header Phi. Inputs are attached after the latch value is created.
        let header_first_instruction: usize = self.instruction_count;
        let phi_value: u32 = self.append_value(
            local_type, local_node.str_offset, local_node.str_len
        );
        if phi_value == TARGET_VALUE_NONE || !self.append_instruction(
            TargetOpcode::Phi, phi_value, local_type,
            self.operand_count as u32, 0, while_index
        ) {
            return false;
        }
        let phi_instruction_index: usize = self.instruction_count - 1;

        if self.local_count >= 128 { return false; }
        self.local_name_offsets[self.local_count] = local_node.str_offset;
        self.local_name_lens[self.local_count] = local_node.str_len;
        self.local_value_ids[self.local_count] = phi_value;
        self.local_struct_ids[self.local_count] = 0;
        self.local_count = self.local_count + 1;

        let while_value: u32 = self.lower_condition_expression(
            condition_index, first_parameter, parameter_count
        );
        if while_value == TARGET_VALUE_NONE
            || unsafe { (*(self.values + while_value as usize - 1)).type_tag }
                != TargetTypeTag::Bool {
            return false;
        }
        let header_operand: u32 = self.operand_count as u32;
        if !self.append_operand(while_value)
            || !self.append_instruction(
                TargetOpcode::CondBranch, TARGET_VALUE_NONE, TargetTypeTag::Bool,
                header_operand, 1, while_index
            ) {
            return false;
        }
        let header_branch_index: usize = self.instruction_count - 1;
        let header_targets: u32 = self.target_count as u32;
        if !self.append_target(body_id) || !self.append_target(exit_id) {
            return false;
        }
        let mut header_branch: TargetInstruction = unsafe {
            *(self.instructions + header_branch_index)
        };
        header_branch.first_target = header_targets;
        header_branch.target_count = 2;
        unsafe { *(self.instructions + header_branch_index) = header_branch; }
        unsafe {
            *(self.blocks + first_block + 1) = TargetBlock {
                id: header_id,
                label: TargetSourceSlice::empty(),
                first_instruction: header_first_instruction as u32,
                instruction_count:
                    (self.instruction_count - header_first_instruction) as u32
            };
        }

        // Body: the search predicate chooses found-return vs latch/update.
        let body_first_instruction: usize = self.instruction_count;
        let body_scope_local_count: usize = self.local_count;
        if body_let_index != 0 {
            let body_let: AstNode = unsafe { *(self.nodes + body_let_index) };
            let type_index: usize = body_let.first_child;
            if type_index == 0 || type_index >= self.node_count
                || unsafe { (*(self.nodes + type_index)).kind } != AstKind::TypeRef {
                return false;
            }
            let body_let_type: TargetTypeTag = self.type_tag_for(type_index);
            let initializer_index: usize = unsafe {
                (*(self.nodes + type_index)).next_sibling
            };
            if initializer_index == 0 || initializer_index >= self.node_count
                || unsafe { (*(self.nodes + initializer_index)).next_sibling } != 0 {
                return false;
            }
            let mut body_struct_id: u32 = 0;
            let mut body_value: u32 = TARGET_VALUE_NONE;
            if body_let_type == TargetTypeTag::U8
                || body_let_type == TargetTypeTag::U16
                || body_let_type == TargetTypeTag::U32
                || body_let_type == TargetTypeTag::U64
                || body_let_type == TargetTypeTag::Usize
                || body_let_type == TargetTypeTag::Bool {
                body_value = self.lower_expression(
                    initializer_index, body_let_type,
                    first_parameter, parameter_count
                );
            } else {
                let type_node: AstNode = unsafe { *(self.nodes + type_index) };
                body_struct_id = self.find_struct(type_node.str_offset, type_node.str_len);
                let initializer: AstNode = unsafe { *(self.nodes + initializer_index) };
                if body_struct_id == 0 || initializer.kind != AstKind::UnsafeExpr
                    || initializer.first_child == 0
                    || initializer.first_child >= self.node_count
                    || unsafe { (*(self.nodes + initializer.first_child)).next_sibling } != 0 {
                    return false;
                }
                let deref: AstNode = unsafe { *(self.nodes + initializer.first_child) };
                if deref.kind != AstKind::ExprUnary || deref.int_value != 82
                    || deref.first_child == 0 || deref.first_child >= self.node_count
                    || unsafe { (*(self.nodes + deref.first_child)).next_sibling } != 0
                    || self.pointer_pointee_struct_id(
                        self.pointer_expression_type_ref(deref.first_child)
                    ) != body_struct_id {
                    return false;
                }
                body_value = self.lower_expression(
                    deref.first_child, TargetTypeTag::Pointer,
                    first_parameter, parameter_count
                );
            }
            if body_value == TARGET_VALUE_NONE || self.local_count >= 128 {
                return false;
            }
            self.local_name_offsets[self.local_count] = body_let.str_offset;
            self.local_name_lens[self.local_count] = body_let.str_len;
            self.local_value_ids[self.local_count] = body_value;
            self.local_struct_ids[self.local_count] = body_struct_id;
            self.local_count = self.local_count + 1;
        }
        let test_value: u32 = self.lower_condition_expression(
            test_index, first_parameter, parameter_count
        );
        if test_value == TARGET_VALUE_NONE
            || unsafe { (*(self.values + test_value as usize - 1)).type_tag }
                != TargetTypeTag::Bool {
            return false;
        }
        let body_operand: u32 = self.operand_count as u32;
        if !self.append_operand(test_value)
            || !self.append_instruction(
                TargetOpcode::CondBranch, TARGET_VALUE_NONE, TargetTypeTag::Bool,
                body_operand, 1, if_index
            ) {
            return false;
        }
        let body_branch_index: usize = self.instruction_count - 1;
        let body_targets: u32 = self.target_count as u32;
        if !self.append_target(found_id) || !self.append_target(latch_id) {
            return false;
        }
        let mut body_branch: TargetInstruction = unsafe {
            *(self.instructions + body_branch_index)
        };
        body_branch.first_target = body_targets;
        body_branch.target_count = 2;
        unsafe { *(self.instructions + body_branch_index) = body_branch; }
        unsafe {
            *(self.blocks + first_block + 2) = TargetBlock {
                id: body_id,
                label: TargetSourceSlice::empty(),
                first_instruction: body_first_instruction as u32,
                instruction_count:
                    (self.instruction_count - body_first_instruction) as u32
            };
        }

        let found_first_instruction: usize = self.instruction_count;
        if !self.lower_return_statement(
            found_return_index, return_type, first_parameter, parameter_count
        ) {
            return false;
        }
        unsafe {
            *(self.blocks + first_block + 3) = TargetBlock {
                id: found_id,
                label: TargetSourceSlice::empty(),
                first_instruction: found_first_instruction as u32,
                instruction_count:
                    (self.instruction_count - found_first_instruction) as u32
            };
        }

        // Latch/update uses the Phi mapping installed above.
        let latch_first_instruction: usize = self.instruction_count;
        let next_value: u32 = self.lower_expression(
            update_index, local_type, first_parameter, parameter_count
        );
        if next_value == TARGET_VALUE_NONE {
            return false;
        }
        if !self.append_instruction(
            TargetOpcode::Branch, TARGET_VALUE_NONE, TargetTypeTag::Invalid,
            self.operand_count as u32, 0, assignment_index
        ) {
            return false;
        }
        let latch_branch_index: usize = self.instruction_count - 1;
        let latch_target: u32 = self.target_count as u32;
        if !self.append_target(header_id) { return false; }
        let mut latch_branch: TargetInstruction = unsafe {
            *(self.instructions + latch_branch_index)
        };
        latch_branch.first_target = latch_target;
        latch_branch.target_count = 1;
        unsafe { *(self.instructions + latch_branch_index) = latch_branch; }
        unsafe {
            *(self.blocks + first_block + 4) = TargetBlock {
                id: latch_id,
                label: TargetSourceSlice::empty(),
                first_instruction: latch_first_instruction as u32,
                instruction_count:
                    (self.instruction_count - latch_first_instruction) as u32
            };
        }

        let first_phi_input: u32 = self.phi_input_count as u32;
        if !self.append_phi_input(initial_value, preheader_id)
            || !self.append_phi_input(next_value, latch_id) {
            return false;
        }
        let mut phi_instruction: TargetInstruction = unsafe {
            *(self.instructions + phi_instruction_index)
        };
        phi_instruction.first_phi_input = first_phi_input;
        phi_instruction.phi_input_count = 2;
        unsafe {
            *(self.instructions + phi_instruction_index) = phi_instruction;
        }

        // The loop-body binding is unavailable on the loop's exit edge.
        self.local_count = body_scope_local_count;
        let exit_first_instruction: usize = self.instruction_count;
        if !self.lower_return_statement(
            return_index, return_type, first_parameter, parameter_count
        ) {
            return false;
        }
        unsafe {
            *(self.blocks + first_block + 5) = TargetBlock {
                id: exit_id,
                label: TargetSourceSlice::empty(),
                first_instruction: exit_first_instruction as u32,
                instruction_count:
                    (self.instruction_count - exit_first_instruction) as u32
            };
        }

        self.block_count = self.block_count + 6;
        return true;
    }

    // Lower a deliberately explicit loop slice: `while condition { break; }
    // return value;` or its `continue` form. This creates a real conditional
    // backedge/exit and loop jump semantics; other body shapes remain closed.
    pub fn lower_while_jump_then_return(
        mut self: &mut Self,
        while_index: usize,
        return_index: usize,
        return_type: TargetTypeTag,
        first_parameter: usize,
        parameter_count: usize,
        entry_first_instruction: usize
    ) -> bool {
        if while_index == 0 || while_index >= self.node_count
            || return_index == 0 || return_index >= self.node_count
            || self.blocks == null || self.targets == null
            || self.block_count + 3 > self.block_capacity {
            return false;
        }
        let while_node: AstNode = unsafe { *(self.nodes + while_index) };
        let return_node: AstNode = unsafe { *(self.nodes + return_index) };
        if while_node.kind != AstKind::WhileStmt || while_node.next_sibling != return_index
            || return_node.kind != AstKind::ReturnStmt || return_node.next_sibling != 0
            || while_node.first_child == 0 || while_node.first_child >= self.node_count {
            return false;
        }
        let condition_index: usize = while_node.first_child;
        let condition_node: AstNode = unsafe { *(self.nodes + condition_index) };
        let body_index: usize = condition_node.next_sibling;
        if body_index == 0 || body_index >= self.node_count
            || unsafe { (*(self.nodes + body_index)).next_sibling } != 0 {
            return false;
        }
        let body: AstNode = unsafe { *(self.nodes + body_index) };
        let jump_index: usize = body.first_child;
        if body.kind != AstKind::Block || jump_index == 0 || jump_index >= self.node_count
            || (unsafe { (*(self.nodes + jump_index)).kind } != AstKind::ContinueStmt
                && unsafe { (*(self.nodes + jump_index)).kind } != AstKind::BreakStmt)
            || unsafe { (*(self.nodes + jump_index)).next_sibling } != 0 {
            return false;
        }

        let first_block: usize = self.block_count;
        let entry_id: u32 = first_block as u32 + 1;
        let body_id: u32 = entry_id + 1;
        let exit_id: u32 = entry_id + 2;
        let condition_value: u32 = self.lower_condition_expression(
            condition_index, first_parameter, parameter_count
        );
        if condition_value == TARGET_VALUE_NONE || self.values == null
            || unsafe { (*(self.values + condition_value as usize - 1)).type_tag } != TargetTypeTag::Bool {
            return false;
        }
        let condition_operand: u32 = self.operand_count as u32;
        if !self.append_operand(condition_value)
            || !self.append_instruction(
                TargetOpcode::CondBranch, TARGET_VALUE_NONE, TargetTypeTag::Bool,
                condition_operand, 1, while_index
            ) {
            return false;
        }
        let condition_branch_index: usize = self.instruction_count - 1;
        let condition_first_target: u32 = self.target_count as u32;
        if !self.append_target(body_id) || !self.append_target(exit_id) {
            return false;
        }
        let mut condition_branch: TargetInstruction = unsafe {
            *(self.instructions + condition_branch_index)
        };
        condition_branch.first_target = condition_first_target;
        condition_branch.target_count = 2;
        unsafe { *(self.instructions + condition_branch_index) = condition_branch; }
        unsafe {
            *(self.blocks + first_block) = TargetBlock {
                id: entry_id,
                label: TargetSourceSlice::empty(),
                first_instruction: entry_first_instruction as u32,
                instruction_count: (self.instruction_count - entry_first_instruction) as u32
            };
        }

        let body_first_instruction: usize = self.instruction_count;
        let jump_kind: AstKind = unsafe { (*(self.nodes + jump_index)).kind };
        let mut body_target: u32 = entry_id;
        if jump_kind == AstKind::BreakStmt { body_target = exit_id; }
        if !self.append_instruction(
            TargetOpcode::Branch, TARGET_VALUE_NONE, TargetTypeTag::Invalid,
            self.operand_count as u32, 0, jump_index
        ) {
            return false;
        }
        let body_branch_index: usize = self.instruction_count - 1;
        let body_first_target: u32 = self.target_count as u32;
        if !self.append_target(body_target) { return false; }
        let mut body_branch: TargetInstruction = unsafe {
            *(self.instructions + body_branch_index)
        };
        body_branch.first_target = body_first_target;
        body_branch.target_count = 1;
        unsafe { *(self.instructions + body_branch_index) = body_branch; }
        unsafe {
            *(self.blocks + first_block + 1) = TargetBlock {
                id: body_id,
                label: TargetSourceSlice::empty(),
                first_instruction: body_first_instruction as u32,
                instruction_count: (self.instruction_count - body_first_instruction) as u32
            };
        }

        let exit_first_instruction: usize = self.instruction_count;
        if !self.lower_return_statement(
            return_index, return_type, first_parameter, parameter_count
        ) {
            return false;
        }
        unsafe {
            *(self.blocks + first_block + 2) = TargetBlock {
                id: exit_id,
                label: TargetSourceSlice::empty(),
                first_instruction: exit_first_instruction as u32,
                instruction_count: (self.instruction_count - exit_first_instruction) as u32
            };
        }
        self.block_count = self.block_count + 3;
        return true;
    }
    pub fn lower_while_if_jumps_then_return(
        mut self: &mut Self,
        while_index: usize,
        return_index: usize,
        return_type: TargetTypeTag,
        first_parameter: usize,
        parameter_count: usize,
        entry_first_instruction: usize
    ) -> bool {
        if while_index == 0 || while_index >= self.node_count
            || return_index == 0 || return_index >= self.node_count
            || self.blocks == null || self.targets == null
            || self.block_count + 5 > self.block_capacity {
            return false;
        }
        let while_node: AstNode = unsafe { *(self.nodes + while_index) };
        let return_node: AstNode = unsafe { *(self.nodes + return_index) };
        if while_node.kind != AstKind::WhileStmt || while_node.next_sibling != return_index
            || return_node.kind != AstKind::ReturnStmt || return_node.next_sibling != 0
            || while_node.first_child == 0 || while_node.first_child >= self.node_count {
            return false;
        }
        let condition_index: usize = while_node.first_child;
        let while_condition: AstNode = unsafe { *(self.nodes + condition_index) };
        let body_index: usize = while_condition.next_sibling;
        if body_index == 0 || body_index >= self.node_count
            || unsafe { (*(self.nodes + body_index)).next_sibling } != 0 {
            return false;
        }
        let body: AstNode = unsafe { *(self.nodes + body_index) };
        let if_index: usize = body.first_child;
        if body.kind != AstKind::Block || if_index == 0 || if_index >= self.node_count
            || unsafe { (*(self.nodes + if_index)).kind } != AstKind::IfStmt
            || unsafe { (*(self.nodes + if_index)).next_sibling } != 0 {
            return false;
        }
        let if_node: AstNode = unsafe { *(self.nodes + if_index) };
        let test_index: usize = if_node.first_child;
        if test_index == 0 || test_index >= self.node_count { return false; }
        let test_node: AstNode = unsafe { *(self.nodes + test_index) };
        let then_index: usize = test_node.next_sibling;
        if then_index == 0 || then_index >= self.node_count { return false; }
        let then_node: AstNode = unsafe { *(self.nodes + then_index) };
        let else_index: usize = then_node.next_sibling;
        if then_node.kind != AstKind::Block || else_index == 0 || else_index >= self.node_count
            || unsafe { (*(self.nodes + else_index)).next_sibling } != 0 {
            return false;
        }
        let else_node: AstNode = unsafe { *(self.nodes + else_index) };
        let then_jump: usize = then_node.first_child;
        let else_jump: usize = else_node.first_child;
        if else_node.kind != AstKind::Block || then_jump == 0 || else_jump == 0
            || then_jump >= self.node_count || else_jump >= self.node_count
            || unsafe { (*(self.nodes + then_jump)).next_sibling } != 0
            || unsafe { (*(self.nodes + else_jump)).next_sibling } != 0 {
            return false;
        }
        let then_kind: AstKind = unsafe { (*(self.nodes + then_jump)).kind };
        let else_kind: AstKind = unsafe { (*(self.nodes + else_jump)).kind };
        if (then_kind != AstKind::BreakStmt && then_kind != AstKind::ContinueStmt)
            || (else_kind != AstKind::BreakStmt && else_kind != AstKind::ContinueStmt) {
            return false;
        }

        let first_block: usize = self.block_count;
        let entry_id: u32 = first_block as u32 + 1;
        let body_id: u32 = entry_id + 1;
        let then_id: u32 = entry_id + 2;
        let else_id: u32 = entry_id + 3;
        let exit_id: u32 = entry_id + 4;

        let while_value: u32 = self.lower_condition_expression(
            condition_index, first_parameter, parameter_count
        );
        if while_value == TARGET_VALUE_NONE || self.values == null
            || unsafe { (*(self.values + while_value as usize - 1)).type_tag } != TargetTypeTag::Bool {
            return false;
        }
        let entry_operand: u32 = self.operand_count as u32;
        if !self.append_operand(while_value)
            || !self.append_instruction(
                TargetOpcode::CondBranch, TARGET_VALUE_NONE, TargetTypeTag::Bool,
                entry_operand, 1, while_index
            ) {
            return false;
        }
        let entry_branch_index: usize = self.instruction_count - 1;
        let entry_targets: u32 = self.target_count as u32;
        if !self.append_target(body_id) || !self.append_target(exit_id) { return false; }
        let mut entry_branch: TargetInstruction = unsafe { *(self.instructions + entry_branch_index) };
        entry_branch.first_target = entry_targets;
        entry_branch.target_count = 2;
        unsafe { *(self.instructions + entry_branch_index) = entry_branch; }
        unsafe {
            *(self.blocks + first_block) = TargetBlock {
                id: entry_id, label: TargetSourceSlice::empty(),
                first_instruction: entry_first_instruction as u32,
                instruction_count: (self.instruction_count - entry_first_instruction) as u32
            };
        }

        let body_first_instruction: usize = self.instruction_count;
        let test_value: u32 = self.lower_condition_expression(
            test_index, first_parameter, parameter_count
        );
        if test_value == TARGET_VALUE_NONE
            || unsafe { (*(self.values + test_value as usize - 1)).type_tag } != TargetTypeTag::Bool {
            return false;
        }
        let test_operand: u32 = self.operand_count as u32;
        if !self.append_operand(test_value)
            || !self.append_instruction(
                TargetOpcode::CondBranch, TARGET_VALUE_NONE, TargetTypeTag::Bool,
                test_operand, 1, if_index
            ) {
            return false;
        }
        let body_branch_index: usize = self.instruction_count - 1;
        let body_targets: u32 = self.target_count as u32;
        if !self.append_target(then_id) || !self.append_target(else_id) { return false; }
        let mut body_branch: TargetInstruction = unsafe { *(self.instructions + body_branch_index) };
        body_branch.first_target = body_targets;
        body_branch.target_count = 2;
        unsafe { *(self.instructions + body_branch_index) = body_branch; }
        unsafe {
            *(self.blocks + first_block + 1) = TargetBlock {
                id: body_id, label: TargetSourceSlice::empty(),
                first_instruction: body_first_instruction as u32,
                instruction_count: (self.instruction_count - body_first_instruction) as u32
            };
        }

        let then_first_instruction: usize = self.instruction_count;
        let mut then_target: u32 = entry_id;
        if then_kind == AstKind::BreakStmt { then_target = exit_id; }
        if !self.append_instruction(
            TargetOpcode::Branch, TARGET_VALUE_NONE, TargetTypeTag::Invalid,
            self.operand_count as u32, 0, then_jump
        ) { return false; }
        let then_branch_index: usize = self.instruction_count - 1;
        let then_targets: u32 = self.target_count as u32;
        if !self.append_target(then_target) { return false; }
        let mut then_branch: TargetInstruction = unsafe { *(self.instructions + then_branch_index) };
        then_branch.first_target = then_targets;
        then_branch.target_count = 1;
        unsafe { *(self.instructions + then_branch_index) = then_branch; }
        unsafe {
            *(self.blocks + first_block + 2) = TargetBlock {
                id: then_id, label: TargetSourceSlice::empty(),
                first_instruction: then_first_instruction as u32,
                instruction_count: (self.instruction_count - then_first_instruction) as u32
            };
        }

        let else_first_instruction: usize = self.instruction_count;
        let mut else_target: u32 = entry_id;
        if else_kind == AstKind::BreakStmt { else_target = exit_id; }
        if !self.append_instruction(
            TargetOpcode::Branch, TARGET_VALUE_NONE, TargetTypeTag::Invalid,
            self.operand_count as u32, 0, else_jump
        ) { return false; }
        let else_branch_index: usize = self.instruction_count - 1;
        let else_targets: u32 = self.target_count as u32;
        if !self.append_target(else_target) { return false; }
        let mut else_branch: TargetInstruction = unsafe { *(self.instructions + else_branch_index) };
        else_branch.first_target = else_targets;
        else_branch.target_count = 1;
        unsafe { *(self.instructions + else_branch_index) = else_branch; }
        unsafe {
            *(self.blocks + first_block + 3) = TargetBlock {
                id: else_id, label: TargetSourceSlice::empty(),
                first_instruction: else_first_instruction as u32,
                instruction_count: (self.instruction_count - else_first_instruction) as u32
            };
        }

        let exit_first_instruction: usize = self.instruction_count;
        if !self.lower_return_statement(
            return_index, return_type, first_parameter, parameter_count
        ) { return false; }
        unsafe {
            *(self.blocks + first_block + 4) = TargetBlock {
                id: exit_id, label: TargetSourceSlice::empty(),
                first_instruction: exit_first_instruction as u32,
                instruction_count: (self.instruction_count - exit_first_instruction) as u32
            };
        }
        self.block_count = self.block_count + 5;
        return true;
    }

    // Structured CFG uses explicit storage for mutable scalar locals. SSA
    // identities stay immutable; loads at loop headers observe backedge stores.
    pub fn cfg_copy_fields(mut self: &mut Self, destination: u32, source_address: u32,
        struct_id: u32, destination_offset: u32, source_offset: u32, node: usize, depth: usize) -> bool {
        if struct_id == 0 || struct_id as usize > self.struct_count || depth >= 32 { return false; }
        let start: u32 = self.struct_field_starts[struct_id as usize - 1];
        let count: u32 = self.struct_field_counts[struct_id as usize - 1];
        let mut i: u32 = 0;
        while i < count {
            let field: usize = (start + i) as usize;
            let offset: u32 = self.field_offsets[field];
            if self.field_byte_counts[field] != 0 {
                let record: u32 = self.field_array_structs[field];
                if record != 0 {
                    let stride: u32 = self.struct_sizes[record as usize - 1];
                    let mut element: u32 = 0;
                    while element < self.field_byte_counts[field] {
                        if !self.cfg_copy_fields(destination,source_address,record,
                            destination_offset+offset+element*stride,
                            source_offset+offset+element*stride,node,depth+1) { return false; }
                        element = element+1;
                    }
                    i = i+1;
                    continue;
                }
                let array_type: TargetTypeTag = self.field_array_types[field] as TargetTypeTag;
                let stride: u32 = self.scalar_memory_size(array_type);
                let mut byte_index: u32 = 0;
                while byte_index < self.field_byte_counts[field] {
                    let value: u32 = self.append_value(array_type, 0, 0);
                    let first: u32 = self.operand_count as u32;
                    if value == 0 || !self.append_operand(source_address) || !self.append_instruction(
                        TargetOpcode::Load, value, array_type, first, 1, node) { return false; }
                    unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = (source_offset + offset + byte_index * stride) as u64; }
                    if !self.cfg_store(destination, value, array_type, node) { return false; }
                    unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = (destination_offset + offset + byte_index * stride) as u64; }
                    byte_index = byte_index + 1;
                }
            } else if self.field_struct_ids[field] != 0 {
                if !self.cfg_copy_fields(destination, source_address, self.field_struct_ids[field],
                    destination_offset + offset, source_offset + offset, node, depth + 1) { return false; }
            } else {
                let typ: TargetTypeTag = self.field_type_tags[field] as TargetTypeTag;
                let value: u32 = self.append_value(typ, 0, 0);
                let first: u32 = self.operand_count as u32;
                if value == 0 || !self.append_operand(source_address)
                    || !self.append_instruction(TargetOpcode::Load, value, typ, first, 1, node) { return false; }
                unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = (source_offset + offset) as u64; }
                if !self.cfg_store(destination, value, typ, node) { return false; }
                unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = (destination_offset + offset) as u64; }
            }
            i = i + 1;
        }
        return true;
    }

    // Pointer-free record arrays have real inline storage. Each initializer is
    // evaluated in source order; repetition evaluates its record exactly once.
    pub fn initialize_record_array_field(mut self: &mut Self, destination: u32, field: usize,
        expression_index: usize, first_parameter: usize, parameter_count: usize) -> bool {
        if field >= self.field_total_count || expression_index == 0
            || expression_index >= self.node_count { return false; }
        let record: u32 = self.field_array_structs[field];
        let count: u32 = self.field_byte_counts[field];
        if record == 0 || count == 0 || !self.array_record_copyable(record,0) { return false; }
        let expression: AstNode = unsafe{*(self.nodes+expression_index)};
        if expression.kind == AstKind::ExprIdent || expression.kind == AstKind::ExprFieldAccess {
            return self.copy_array_into_field(destination,field,expression_index,first_parameter,parameter_count);
        }
        if expression.kind != AstKind::ExprArrayLiteral && expression.kind != AstKind::ExprArrayRepeat {
            return false;
        }
        let mut element: usize = expression.first_child;
        let mut repeated: u32 = 0;
        if expression.kind == AstKind::ExprArrayRepeat {
            if element == 0 || element >= self.node_count || self.cfg_struct_id(element,0) != record { return false; }
            let length_index: usize = unsafe{(*(self.nodes+element)).next_sibling};
            if length_index == 0 || length_index >= self.node_count { return false; }
            let length: AstNode = unsafe{*(self.nodes+length_index)};
            if length.kind != AstKind::ExprLiteral || length.next_sibling != 0
                || self.parse_integer_value(length.str_offset,length.str_len) != count as u64 { return false; }
            repeated = self.cfg_struct_address(element,first_parameter,parameter_count,0);
            if repeated == 0 { return false; }
        }
        let stride: u32 = self.struct_sizes[record as usize - 1];
        // Stage the complete RHS before replacing an existing array field.
        // This also preserves swaps such as [table.items[1], table.items[0]].
        let staged: u32 = self.append_value(TargetTypeTag::Pointer,0,0);
        if staged == 0 || !self.append_instruction(TargetOpcode::AllocStack,staged,
            TargetTypeTag::Pointer,0,0,expression_index) { return false; }
        unsafe{(*(self.instructions+self.instruction_count-1)).immediate_bits = (count as u64)*(stride as u64);}
        let mut index: u32 = 0;
        while index < count {
            let mut source_address: u32 = repeated;
            if expression.kind == AstKind::ExprArrayLiteral {
                if element == 0 || element >= self.node_count || self.cfg_struct_id(element,0) != record { return false; }
                source_address = self.cfg_struct_address(element,first_parameter,parameter_count,0);
                element = unsafe{(*(self.nodes+element)).next_sibling};
            }
            if source_address == 0 || !self.cfg_copy_fields(staged,source_address,record,
                index*stride,0,expression_index,0) { return false; }
            index = index+1;
        }
        if expression.kind != AstKind::ExprArrayRepeat && element != 0 { return false; }
        index = 0;
        while index < count {
            if !self.cfg_copy_fields(destination,staged,record,self.field_offsets[field]+index*stride,
                index*stride,expression_index,0) { return false; }
            index = index+1;
        }
        return true;
    }

    pub fn copy_array_into_field(mut self: &mut Self, destination: u32, field: usize,
        expression_index: usize, first_parameter: usize, parameter_count: usize) -> bool {
        if field >= self.field_total_count || expression_index == 0 || expression_index >= self.node_count { return false; }
        let expression: AstNode = unsafe { *(self.nodes + expression_index) };
        let typ: TargetTypeTag = self.field_array_types[field] as TargetTypeTag;
        let record: u32 = self.field_array_structs[field];
        let count: u32 = self.field_byte_counts[field];
        let mut source_address: u32 = 0; let mut source_offset: u32 = 0;
        if expression.kind == AstKind::ExprIdent {
            let slot: usize = self.cfg_find_local(expression.str_offset,expression.str_len);
            if slot >= self.local_count || self.local_struct_ids[slot] != record
                || self.local_array_counts[slot] != count || self.local_array_types[slot] != typ as u32 { return false; }
            source_address = self.local_value_ids[slot];
        } else if expression.kind == AstKind::ExprFieldAccess {
            let owner_record: u32 = self.cfg_struct_id(expression.first_child,0);
            let source_field: u32 = self.find_field(owner_record,expression.str_offset,expression.str_len);
            if source_field == 0 { return false; }
            let slot: usize = source_field as usize - 1;
            if self.field_byte_counts[slot] != count || self.field_array_types[slot] != typ as u32
                || self.field_array_structs[slot] != record { return false; }
            source_address = self.cfg_struct_address(expression.first_child,first_parameter,parameter_count,0);
            source_offset = self.field_offsets[slot];
        } else { return false; }
        if source_address == 0 || count == 0 { return false; }
        if record != 0 {
            let stride: u32 = self.struct_sizes[record as usize - 1];
            let mut position: u32 = 0;
            while position < count {
                if !self.cfg_copy_fields(destination,source_address,record,
                    self.field_offsets[field]+position*stride,
                    source_offset+position*stride,expression_index,0) { return false; }
                position = position+1;
            }
            return true;
        }
        if typ == TargetTypeTag::Pointer { return false; }
        let stride: u32 = self.scalar_memory_size(typ); let mut position: u32 = 0;
        while position < count {
            let value: u32 = self.append_value(typ,0,0); let first: u32 = self.operand_count as u32;
            if value == 0 || !self.append_operand(source_address)
                || !self.append_instruction(TargetOpcode::Load,value,typ,first,1,expression_index) { return false; }
            unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = (source_offset + position*stride) as u64; }
            if !self.cfg_store(destination,value,typ,expression_index) { return false; }
            unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = (self.field_offsets[field] + position*stride) as u64; }
            position = position+1;
        }
        return true;
    }

    pub fn indexed_array_field(self: &Self, index_node: usize) -> u32 {
        if index_node == 0 || index_node >= self.node_count { return 0; }
        let expression: AstNode = unsafe { *(self.nodes + index_node) };
        let base: usize = expression.first_child;
        if expression.kind != AstKind::ExprIndex || base == 0 || base >= self.node_count { return 0; }
        let field: AstNode = unsafe { *(self.nodes + base) };
        if field.kind != AstKind::ExprFieldAccess { return 0; }
        let owner: u32 = self.cfg_struct_id(field.first_child, 0);
        let result: u32 = self.find_field(owner, field.str_offset, field.str_len);
        if result == 0 || self.field_byte_counts[result as usize - 1] == 0 { return 0; }
        return result;
    }

    pub fn cfg_field_array_index_address(mut self: &mut Self, expression_index: usize,
        field: u32, first_parameter: usize, parameter_count: usize) -> u32 {
        let expression: AstNode = unsafe { *(self.nodes + expression_index) };
        let base: AstNode = unsafe { *(self.nodes + expression.first_child) };
        let index_node: usize = base.next_sibling;
        if index_node == 0 || index_node >= self.node_count { return 0; }
        let mut index_type: TargetTypeTag = self.condition_expression_type(index_node, first_parameter, parameter_count);
        if index_type == TargetTypeTag::Invalid { index_type = TargetTypeTag::U64; }
        if index_type != TargetTypeTag::U32 && index_type != TargetTypeTag::U64 { return 0; }
        let mut address: u32 = 0;
        let mut count: u32 = 0;
        let mut stride: u32 = 0;
        if field != 0 {
            let slot: usize = field as usize - 1;
            address = self.cfg_struct_address(expression.first_child, first_parameter, parameter_count, 0);
            count = self.field_byte_counts[slot];
            stride = self.scalar_memory_size(self.field_array_types[slot] as TargetTypeTag);
            if self.field_array_structs[slot] != 0 {
                stride = self.struct_sizes[self.field_array_structs[slot] as usize - 1];
            }
        } else {
            if base.kind != AstKind::ExprIdent { return 0; }
            let global: isize = self.find_global_bss(base.str_offset, base.str_len);
            if global < 0 { return 0; }
            let slot: usize = global as usize;
            let global_count: usize = unsafe { g_bss_sym_element_counts[slot] };
            if unsafe { g_bss_sym_is_array[slot] } == 0 || global_count == 0 || global_count > 2147483647
                || (unsafe { g_bss_sym_element_structs[slot] } != 0
                    && self.global_array_record_id(expression.first_child) == 0) { return 0; }
            count = global_count as u32;
            stride = self.scalar_memory_size(unsafe { g_bss_sym_element_types[slot] } as TargetTypeTag);
            if unsafe{g_bss_sym_element_structs[slot]} != 0 {
                let record_stride: usize = unsafe{g_bss_sym_element_strides[slot]};
                if record_stride == 0 || record_stride > 4294967295 { return 0; }
                stride=record_stride as u32;
            }
            address = self.lower_expression(expression.first_child, TargetTypeTag::Pointer, first_parameter, parameter_count);
        }
        if stride == 0 || count == 0 { return 0; }
        let subscript: AstNode = unsafe{*(self.nodes+index_node)};
        let global_record: bool = field == 0 && self.global_array_record_id(expression.first_child) != 0;
        if ((field != 0 && self.field_array_structs[field as usize - 1] != 0) || global_record)
            && subscript.kind == AstKind::ExprLiteral
            && self.parse_integer_value(subscript.str_offset,subscript.str_len) >= count as u64 { return 0; }
        let index: u32 = self.lower_expression(index_node, index_type, first_parameter, parameter_count);
        let result: u32 = self.append_value(TargetTypeTag::Pointer, 0, 0);
        let operand: u32 = self.operand_count as u32;
        if address == 0 || index == 0 || result == 0 || !self.append_operand(address) || !self.append_operand(index)
            || !self.append_instruction(TargetOpcode::IndexAddr, result, TargetTypeTag::Pointer, operand, 2, expression_index) { return 0; }
        unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits =
            (count as u64 << 32) | stride as u64; }
        return result;
    }

    pub fn cfg_local_array_index_address(mut self: &mut Self,
        expression_index: usize, first_parameter: usize, parameter_count: usize) -> u32 {
        if expression_index == 0 || expression_index >= self.node_count { return 0; }
        let expression: AstNode = unsafe { *(self.nodes + expression_index) };
        if expression.kind != AstKind::ExprIndex || expression.first_child == 0
            || expression.first_child >= self.node_count { return 0; }
        let base: AstNode = unsafe { *(self.nodes + expression.first_child) };
        if base.kind != AstKind::ExprIdent { return 0; }
        let slot: usize = self.cfg_find_local(base.str_offset, base.str_len);
        if slot >= self.local_count || self.local_array_counts[slot] == 0 { return 0; }
        let index_node: usize = base.next_sibling;
        if index_node == 0 || index_node >= self.node_count
            || unsafe { (*(self.nodes + index_node)).next_sibling } != 0 { return 0; }
        if self.local_struct_ids[slot] != 0 {
            let position_node: AstNode = unsafe { *(self.nodes + index_node) };
            if position_node.kind == AstKind::ExprLiteral
                && self.parse_integer_value(position_node.str_offset, position_node.str_len) >= self.local_array_counts[slot] as u64 { return 0; }
        }
        let mut index_type: TargetTypeTag = self.condition_expression_type(
            index_node, first_parameter, parameter_count
        );
        if index_type == TargetTypeTag::Invalid { index_type = TargetTypeTag::U64; }
        if index_type != TargetTypeTag::U32 && index_type != TargetTypeTag::U64
            && index_type != TargetTypeTag::Usize { return 0; }
        let index_value: u32 = self.lower_expression(
            index_node, index_type, first_parameter, parameter_count
        );
        let address: u32 = self.append_value(TargetTypeTag::Pointer, 0, 0);
        let first: u32 = self.operand_count as u32;
        if index_value == 0 || address == 0
            || !self.append_operand(self.local_value_ids[slot])
            || !self.append_operand(index_value)
            || !self.append_instruction(
                TargetOpcode::IndexAddr, address, TargetTypeTag::Pointer,
                first, 2, expression_index
            ) { return 0; }
        let mut stride: u32 = self.scalar_memory_size(self.local_array_types[slot] as TargetTypeTag);
        let record: u32 = self.local_struct_ids[slot];
        if record != 0 {
            if record as usize > self.struct_count { return 0; }
            stride = self.struct_sizes[record as usize - 1];
        }
        if stride == 0 { return 0; }
        unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits =
            (self.local_array_counts[slot] as u64 << 32) | stride as u64; }
        return address;
    }

    pub fn cfg_call_declaration(self: &Self, expression_index: usize, depth: usize) -> usize {
        if expression_index == 0 || expression_index >= self.node_count || depth >= 64 { return 0; }
        let expression: AstNode = unsafe { *(self.nodes + expression_index) };
        if expression.kind != AstKind::ExprCall || expression.first_child == 0
            || expression.first_child >= self.node_count { return 0; }
        let callee: AstNode = unsafe { *(self.nodes + expression.first_child) };
        if callee.kind == AstKind::ExprIdent {
            return self.find_top_level_function_decl(callee.str_offset, callee.str_len);
        }
        if callee.kind == AstKind::ExprPath {
            let mut sem: Sema = Sema::new();
            let module_index: usize = sem.find_enclosing_module(self.nodes, self.node_count, expression_index);
            return sem.find_static_impl_method_for_path(self.nodes, self.node_count,
                module_index, expression.first_child, self.source, self.source_len);
        }
        if callee.kind == AstKind::ExprFieldAccess {
            let owner: u32 = self.cfg_struct_id(callee.first_child, depth + 1);
            return self.find_instance_impl_method_decl(expression_index, owner, callee.str_offset, callee.str_len);
        }
        return 0;
    }

    // Distinguish a record value from a reference whose machine type is
    // also Pointer. Conditional value copies must never change reference ABI.
    pub fn match_record_id(self: &Self, index: usize, depth: usize) -> u32 {
        if index == 0 || index >= self.node_count || depth >= 64 { return 0; }
        let node: AstNode = unsafe{*(self.nodes+index)};
        if node.kind != AstKind::ExprMatch || node.first_child == 0 || node.first_child >= self.node_count { return 0; }
        let mut arm: usize = unsafe{(*(self.nodes+node.first_child)).next_sibling};
        let mut result: u32 = 0;
        while arm != 0 {
            if arm >= self.node_count { return 0; }
            let pattern: usize = unsafe{(*(self.nodes+arm)).first_child};
            if pattern == 0 || pattern >= self.node_count { return 0; }
            let body: usize = unsafe{(*(self.nodes+pattern)).next_sibling};
            let sem: Sema = Sema::new();
            if body != 0 && body < self.node_count && unsafe{(*(self.nodes+body)).kind} == AstKind::MatchValueBlock
                && sem.block_returns_value(self.nodes,self.node_count,body) {
                arm=unsafe{(*(self.nodes+arm)).next_sibling};continue;
            }
            let record: u32 = self.cfg_record_value_id(body,depth+1);
            if record == 0 || (result != 0 && result != record) { return 0; }
            result=record;arm=unsafe{(*(self.nodes+arm)).next_sibling};
        }
        return result;
    }

    pub fn payload_variant(self: &Self, index: usize) -> u32 {
        if index == 0 || index >= self.node_count { return 0; }
        let node: AstNode = unsafe{*(self.nodes+index)};
        let mut path: usize = index;
        if node.kind == AstKind::ExprCall || node.kind == AstKind::PatternVariant { path=node.first_child; }
        if path == 0 || path >= self.node_count { return 0; }
        let name: AstNode = unsafe{*(self.nodes+path)};
        if name.kind != AstKind::ExprPath { return 0; }
        let split: usize = self.find_match_path_separator(name);
        if split+2 >= name.str_len { return 0; }
        let enumeration: u32 = self.find_enum(name.str_offset,split);
        if enumeration == 0 { return 0; }
        let mut slot: usize = self.enum_variant_starts[enumeration as usize-1] as usize;
        let end: usize = slot+self.enum_variant_counts[enumeration as usize-1] as usize;
        while slot < end {
            if self.source_name_equals(self.variant_name_offsets[slot],self.variant_name_lens[slot],
                name.str_offset+split+2,name.str_len-split-2) { return slot as u32+1; }
            slot=slot+1;
        }
        return 0;
    }

    pub fn payload_record(self: &Self, index: usize) -> u32 {
        let variant: u32 = self.payload_variant(index);
        if variant == 0 { return 0; }
        let parent: usize = unsafe{(*(self.nodes+self.variant_nodes[variant as usize-1])).parent};
        if parent == 0 || parent >= self.node_count { return 0; }
        let declaration: AstNode = unsafe{*(self.nodes+parent)};
        let enumeration: u32 = self.find_enum(declaration.str_offset,declaration.str_len);
        if enumeration == 0 { return 0; }
        return self.enum_record_ids[enumeration as usize-1];
    }

    // Payload enums use a private tagged product layout. Inactive fields are
    // zeroed; no inactive variant is exposed as a source-level struct field.
    pub fn register_payload_layouts(mut self: &mut Self) -> bool {
        let mut enumeration: usize = 0;
        while enumeration < self.enum_count {
            let start: usize = self.enum_variant_starts[enumeration] as usize;
            let end: usize = start+self.enum_variant_counts[enumeration] as usize;
            let mut variant: usize = start;let mut has_payload: bool = false;
            while variant < end {
                let child: usize = unsafe{(*(self.nodes+self.variant_nodes[variant])).first_child};
                if child != 0 && unsafe{(*(self.nodes+child)).kind} == AstKind::TypeRef { has_payload=true; }
                variant=variant+1;
            }
            if has_payload {
                if self.struct_count >= 32 || self.field_total_count >= 256 { return self.reject(self.variant_nodes[start]); }
                let record: usize = self.struct_count;
                self.enum_record_ids[enumeration]=record as u32+1;
                self.struct_name_offsets[record]=self.enum_name_offsets[enumeration];
                self.struct_name_lens[record]=self.enum_name_lens[enumeration];
                self.struct_field_starts[record]=self.field_total_count as u32;
                self.field_type_tags[self.field_total_count]=TargetTypeTag::U32 as u32;
                self.field_total_count=self.field_total_count+1;
                let mut size: u32 = 4;let mut alignment: u32 = 4;
                variant=start;
                while variant < end {
                    let mut prior: usize = start;
                    while prior < variant {
                        if self.variant_values[prior] == self.variant_values[variant] { return self.reject(self.variant_nodes[variant]); }
                        prior=prior+1;
                    }
                    self.variant_field_starts[variant]=self.field_total_count as u32;
                    let mut child: usize = unsafe{(*(self.nodes+self.variant_nodes[variant])).first_child};
                    while child != 0 && child < self.node_count && unsafe{(*(self.nodes+child)).kind} == AstKind::TypeRef {
                        let typ: AstNode = unsafe{*(self.nodes+child)};
                        let mut tag: TargetTypeTag = self.type_tag_for(child);
                        let nested: u32 = self.find_struct(typ.str_offset,typ.str_len);
                        let array: bool = typ.str_len != 0 && unsafe{*(self.source+typ.str_offset)} == 91;
                        if typ.int_value != 0 || (!array && tag == TargetTypeTag::Invalid) || tag == TargetTypeTag::Void
                            || (tag == TargetTypeTag::Pointer && (nested == 0 || !self.array_record_copyable(nested,0)))
                            || self.field_total_count >= 256 { return self.reject(child); }
                        let mut width: u32 = self.scalar_memory_size(tag);let mut align: u32 = width;
                        if nested != 0 { width=self.struct_sizes[nested as usize-1];align=self.struct_alignments[nested as usize-1]; }
                        if array {
                            let count: usize = self.parse_array_element_count(typ.str_offset,typ.str_len);
                            let mut element: TargetTypeTag = self.parse_array_element_type(typ.str_offset,typ.str_len);
                            let record: u32 = self.parse_array_element_struct(typ.str_offset,typ.str_len);
                            let mut stride: u32 = self.scalar_memory_size(element);
                            align=stride;
                            if record != 0 {
                                if !self.array_record_copyable(record,0) { return self.reject(child); }
                                stride=self.struct_sizes[record as usize-1];
                                align=self.struct_alignments[record as usize-1];
                                element=TargetTypeTag::Pointer;
                            } else if element == TargetTypeTag::Pointer { return self.reject(child); }
                            let maximum: usize = 4096;
                            if count == 0 || count > 256 || stride == 0 || count > maximum/(stride as usize)
                                || element == TargetTypeTag::Invalid || element == TargetTypeTag::Aggregate
                                || element == TargetTypeTag::Void { return self.reject(child); }
                            let field: usize = self.field_total_count;
                            self.field_byte_counts[field]=count as u32;
                            self.field_array_types[field]=element as u32;
                            self.field_array_structs[field]=record;
                            width=(count as u32)*stride;tag=TargetTypeTag::Aggregate;
                        }
                        if width == 0 || align == 0 || size > 4096 || width > 4096 { return self.reject(child); }
                        size=((size+align-1)/align)*align;
                        let field: usize = self.field_total_count;
                        self.field_offsets[field]=size;self.field_type_refs[field]=child;
                        self.field_type_tags[field]=tag as u32;self.field_struct_ids[field]=nested;
                        if nested != 0 { self.field_type_tags[field]=TargetTypeTag::Aggregate as u32; }
                        size=size+width;if size > 4096 { return self.reject(child); }
                        if align > alignment { alignment=align; }
                        self.field_total_count=field+1;
                        self.variant_field_counts[variant]=self.variant_field_counts[variant]+1;
                        child=unsafe{(*(self.nodes+child)).next_sibling};
                    }
                    variant=variant+1;
                }
                self.struct_sizes[record]=((size+alignment-1)/alignment)*alignment;
                self.struct_alignments[record]=alignment;
                self.struct_field_counts[record]=self.field_total_count as u32-self.struct_field_starts[record];
                self.struct_count=self.struct_count+1;
            }
            enumeration=enumeration+1;
        }
        // Earlier record layouts cannot silently retain a scalar discriminant
        // after a named enum acquires aggregate storage.
        let mut field: usize = 0;
        while field < self.field_total_count {
            let reference: usize = self.field_type_refs[field];
            if reference != 0 && reference < self.node_count {
                let typ: AstNode = unsafe{*(self.nodes+reference)};
                let record: u32 = self.find_struct(typ.str_offset,typ.str_len);
                if record != 0 && self.field_struct_ids[field] != record { return self.reject(reference); }
                let element: u32 = self.parse_array_element_struct(typ.str_offset,typ.str_len);
                if element != 0 && self.field_array_structs[field] != element { return self.reject(reference); }
            }
            field=field+1;
        }
        return true;
    }

    pub fn payload_address(mut self: &mut Self, base: u32, offset: u32, node: usize) -> u32 {
        let displacement: u32 = self.append_value(TargetTypeTag::U64,0,0);
        if base == 0 || displacement == 0 || !self.append_instruction(TargetOpcode::ConstInt,displacement,
            TargetTypeTag::U64,0,0,node) { return 0; }
        unsafe{(*(self.instructions+self.instruction_count-1)).immediate_bits=offset as u64;}
        let first: u32 = self.operand_count as u32;
        let address: u32 = self.append_value(TargetTypeTag::Pointer,0,0);
        if address == 0 || !self.append_operand(base) || !self.append_operand(displacement)
            || !self.append_instruction(TargetOpcode::PtrOffset,address,TargetTypeTag::Pointer,first,2,node) { return 0; }
        unsafe{(*(self.instructions+self.instruction_count-1)).immediate_bits=1;}
        return address;
    }

    // Inline payload arrays share record storage/copy rules. Repetition evaluates
    // its value once; list elements are evaluated from left to right.
    pub fn initialize_payload_array(mut self: &mut Self, address: u32, field: usize,
        expression_index: usize, first_parameter: usize, parameter_count: usize) -> bool {
        if self.field_array_structs[field] != 0 {
            return self.initialize_record_array_field(address,field,expression_index,first_parameter,parameter_count);
        }
        let expression: AstNode = unsafe{*(self.nodes+expression_index)};
        if expression.kind == AstKind::ExprIdent || expression.kind == AstKind::ExprFieldAccess {
            return self.copy_array_into_field(address,field,expression_index,first_parameter,parameter_count);
        }
        if expression.kind != AstKind::ExprArrayLiteral && expression.kind != AstKind::ExprArrayRepeat { return false; }
        let count: u32 = self.field_byte_counts[field];
        let typ: TargetTypeTag = self.field_array_types[field] as TargetTypeTag;
        let stride: u32 = self.scalar_memory_size(typ);
        let mut element: usize = expression.first_child;let mut repeated: u32 = 0;
        if expression.kind == AstKind::ExprArrayRepeat {
            if element == 0 || element >= self.node_count { return false; }
            let length: usize = unsafe{(*(self.nodes+element)).next_sibling};
            if length == 0 || length >= self.node_count { return false; }
            let literal: AstNode = unsafe{*(self.nodes+length)};
            if literal.kind != AstKind::ExprLiteral || literal.next_sibling != 0
                || self.parse_integer_value(literal.str_offset,literal.str_len) != count as u64 { return false; }
            repeated=self.lower_expression(element,typ,first_parameter,parameter_count);
            if repeated == 0 { return false; }
        }
        let mut position: u32 = 0;
        while position < count {
            let mut value: u32 = repeated;
            if expression.kind == AstKind::ExprArrayLiteral {
                if element == 0 || element >= self.node_count { return false; }
                value=self.lower_expression(element,typ,first_parameter,parameter_count);
                element=unsafe{(*(self.nodes+element)).next_sibling};
            }
            if value == 0 || unsafe{(*(self.values+value as usize-1)).type_tag} != typ
                || !self.cfg_store(address,value,typ,expression_index) { return false; }
            unsafe{(*(self.instructions+self.instruction_count-1)).immediate_bits=
                (self.field_offsets[field]+position*stride) as u64;}
            position=position+1;
        }
        return expression.kind == AstKind::ExprArrayRepeat || element == 0;
    }

    pub fn lower_payload_constructor(mut self: &mut Self, index: usize, first_parameter: usize, parameter_count: usize) -> u32 {
        let variant_id: u32 = self.payload_variant(index);let record: u32 = self.payload_record(index);
        if variant_id == 0 || record == 0 || self.cfg_current == 0 { return 0; }
        let variant: usize = variant_id as usize-1;
        let node: AstNode = unsafe{*(self.nodes+index)};
        let mut argument: usize = 0;
        if node.kind == AstKind::ExprCall { argument=unsafe{(*(self.nodes+node.first_child)).next_sibling}; }
        else if self.variant_field_counts[variant] != 0 { return 0; }
        let address: u32 = self.allocate_struct(record,index);
        if address == 0 || !self.cfg_fill_array(address,self.struct_sizes[record as usize-1] as usize,
            1,TargetTypeTag::U8,index,0,0) { return 0; }
        let tag: u32 = self.append_value(TargetTypeTag::U32,0,0);
        if tag == 0 || !self.append_instruction(TargetOpcode::ConstInt,tag,TargetTypeTag::U32,0,0,index) { return 0; }
        unsafe{(*(self.instructions+self.instruction_count-1)).immediate_bits=self.variant_values[variant];}
        if !self.cfg_store(address,tag,TargetTypeTag::U32,index) { return 0; }
        let mut ordinal: usize = 0;
        while ordinal < self.variant_field_counts[variant] as usize {
            if argument == 0 || argument >= self.node_count { return 0; }
            let field: usize = self.variant_field_starts[variant] as usize+ordinal;
            let destination: u32 = self.payload_address(address,self.field_offsets[field],index);
            let nested: u32 = self.field_struct_ids[field];
            if self.field_byte_counts[field] != 0 {
                if !self.initialize_payload_array(address,field,argument,first_parameter,parameter_count) { return 0; }
            } else if nested != 0 {
                if self.cfg_record_value_id(argument,0) != nested { return 0; }
                let source: u32 = self.cfg_struct_address(argument,first_parameter,parameter_count,0);
                if source == 0 || !self.cfg_copy_fields(destination,source,nested,0,0,argument,0) { return 0; }
            } else {
                let typ: TargetTypeTag = self.field_type_tags[field] as TargetTypeTag;
                let value: u32 = self.lower_expression(argument,typ,first_parameter,parameter_count);
                if value == 0 || unsafe{(*(self.values+value as usize-1)).type_tag} != typ
                    || !self.cfg_store(destination,value,typ,argument) { return 0; }
            }
            argument=unsafe{(*(self.nodes+argument)).next_sibling};ordinal=ordinal+1;
        }
        if argument != 0 { return 0; }
        return address;
    }

    pub fn cfg_record_value_id(self: &Self, index: usize, depth: usize) -> u32 {
        if index == 0 || index >= self.node_count || depth >= 64 { return 0; }
        let node: AstNode = unsafe { *(self.nodes + index) };
        let payload: u32 = self.payload_record(index);
        if payload != 0 { return payload; }
        if node.kind == AstKind::MatchValueBlock {
            let sem: Sema = Sema::new();
            return self.cfg_record_value_id(sem.match_block_tail(self.nodes,self.node_count,index),depth+1);
        }
        if node.kind == AstKind::ExprMatch { return self.match_record_id(index,depth+1); }
        if node.kind == AstKind::UnsafeExpr { return self.cfg_record_value_id(node.first_child, depth + 1); }
        if node.kind == AstKind::ExprIdent {
            let mut sem: Sema = Sema::new();
            let binding: usize = sem.find_visible_binding(self.nodes, self.node_count, index, self.source, self.source_len);
            let typ: usize = sem.binding_type_ref(self.nodes, self.node_count, binding);
            let payload_type: usize = sem.payload_binding_type(self.nodes,self.node_count,binding,self.source,self.source_len);
            if payload_type != 0 && payload_type < self.node_count {
                let reference: AstNode = unsafe{*(self.nodes+payload_type)};
                return self.find_struct(reference.str_offset,reference.str_len);
            }
            if typ != 0 && typ < self.node_count {
                let type_node: AstNode = unsafe { *(self.nodes + typ) };
                return self.find_struct(type_node.str_offset, type_node.str_len);
            }
            if binding != 0 && binding < self.node_count {
                let declaration: AstNode = unsafe { *(self.nodes + binding) };
                if declaration.kind == AstKind::LetStmt { return self.cfg_record_value_id(declaration.first_child, depth + 1); }
            }
            return 0;
        }
        if node.kind == AstKind::ExprStructLiteral || node.kind == AstKind::ExprCall
            || node.kind == AstKind::ExprFieldAccess || node.kind == AstKind::ExprConditional || node.kind == AstKind::ExprIndex
            || (node.kind == AstKind::ExprUnary && node.int_value == 82) { return self.cfg_struct_id(index, depth + 1); }
        return 0;
    }

    pub fn conditional_record_result(self: &Self, index: usize, depth: usize) -> bool {
        if index == 0 || index >= self.node_count || depth >= 64 { return false; }
        let node: AstNode = unsafe { *(self.nodes + index) };
        if node.kind == AstKind::UnsafeExpr || node.kind == AstKind::ExprFieldAccess {
            return self.conditional_record_result(node.first_child, depth + 1) && self.cfg_record_value_id(index, 0) != 0;
        }
        return (node.kind == AstKind::ExprConditional || node.kind == AstKind::ExprMatch) && self.cfg_record_value_id(index, 0) != 0;
    }

    pub fn cfg_struct_id(self: &Self, expression_index: usize, depth: usize) -> u32 {
        if expression_index == 0 || expression_index >= self.node_count || depth >= 64 { return 0; }
        let expression: AstNode = unsafe { *(self.nodes + expression_index) };
        let payload: u32 = self.payload_record(expression_index);
        if payload != 0 { return payload; }
        if expression.kind == AstKind::ExprMatch { return self.match_record_id(expression_index,depth+1); }
        if expression.kind == AstKind::ExprIndex && expression.first_child != 0 && expression.first_child < self.node_count {
            let base: AstNode = unsafe { *(self.nodes + expression.first_child) };
            if base.kind == AstKind::ExprIdent {
                let slot: usize = self.cfg_find_local(base.str_offset, base.str_len);
                if slot < self.local_count && self.local_array_counts[slot] != 0 { return self.local_struct_ids[slot]; }
                if slot >= self.local_count { return self.global_array_record_id(expression.first_child); }
            }
            if base.kind == AstKind::ExprFieldAccess {
                let owner: u32 = self.cfg_struct_id(base.first_child,depth+1);
                let field: u32 = self.find_field(owner,base.str_offset,base.str_len);
                if field != 0 { return self.field_array_structs[field as usize - 1]; }
            }
            return 0;
        }
        if expression.kind == AstKind::ExprConditional {
            let condition: usize = expression.first_child;
            if condition == 0 || condition >= self.node_count { return 0; }
            let yes: usize = unsafe { (*(self.nodes + condition)).next_sibling };
            if yes == 0 || yes >= self.node_count { return 0; }
            let no: usize = unsafe { (*(self.nodes + yes)).next_sibling };
            if no == 0 || no >= self.node_count || unsafe { (*(self.nodes + no)).next_sibling } != 0 { return 0; }
            let record: u32 = self.cfg_record_value_id(yes, depth + 1);
            if record != 0 && record == self.cfg_record_value_id(no, depth + 1) { return record; }
            return 0;
        }
        if expression.kind == AstKind::ExprStructLiteral {
            return self.find_struct(expression.str_offset, expression.str_len);
        }
        if expression.kind == AstKind::ExprCall && expression.first_child != 0
            && expression.first_child < self.node_count {
            return self.function_return_struct_from_ast(self.cfg_call_declaration(expression_index, depth + 1));
        }
        if expression.kind == AstKind::UnsafeExpr {
            return self.cfg_struct_id(expression.first_child, depth + 1);
        }
        if expression.kind == AstKind::ExprIdent {
            let local: u32 = self.find_local_struct_id(expression.str_offset, expression.str_len);
            if local != 0 { return local; }
            return self.global_record_id(expression_index);
        }
        if expression.kind == AstKind::ExprUnary && expression.int_value == 82 {
            return self.pointer_pointee_struct_id(self.pointer_expression_type_ref(expression.first_child));
        }
        if expression.kind == AstKind::ExprFieldAccess {
            let owner: u32 = self.cfg_struct_id(expression.first_child, depth + 1);
            let field: u32 = self.find_field(owner, expression.str_offset, expression.str_len);
            if field != 0 { return self.field_struct_ids[field as usize - 1] as u32; }
        }
        return 0;
    }

    pub fn cfg_struct_address(mut self: &mut Self, expression_index: usize,
        first_parameter: usize, parameter_count: usize, depth: usize) -> u32 {
        if expression_index == 0 || expression_index >= self.node_count || depth >= 64 { return 0; }
        let expression: AstNode = unsafe { *(self.nodes + expression_index) };
        if expression.kind == AstKind::ExprIndex && self.cfg_struct_id(expression_index, depth + 1) != 0 {
            let field: u32 = self.indexed_array_field(expression_index);
            if field != 0 {
                return self.cfg_field_array_index_address(expression_index,field,first_parameter,parameter_count);
            }
            if self.global_array_record_id(expression.first_child) != 0 {
                return self.cfg_field_array_index_address(expression_index,0,first_parameter,parameter_count);
            }
            return self.cfg_local_array_index_address(expression_index, first_parameter, parameter_count);
        }
        if expression.kind == AstKind::UnsafeExpr {
            return self.cfg_struct_address(expression.first_child, first_parameter, parameter_count, depth + 1);
        }
        if expression.kind == AstKind::ExprPath && self.payload_record(expression_index) != 0 {
            return self.lower_payload_constructor(expression_index,first_parameter,parameter_count);
        }
        if expression.kind == AstKind::ExprStructLiteral || expression.kind == AstKind::ExprCall
            || expression.kind == AstKind::ExprConditional || expression.kind == AstKind::ExprMatch {
            return self.lower_expression(expression_index, TargetTypeTag::Pointer, first_parameter, parameter_count);
        }
        if expression.kind == AstKind::ExprIdent {
            let local: u32 = self.find_parameter_value(first_parameter, parameter_count, expression.str_offset, expression.str_len);
            if local != 0 { return local; }
            if self.global_record_id(expression_index) != 0 {
                return self.lower_expression(expression_index,TargetTypeTag::Pointer,first_parameter,parameter_count);
            }
            return 0;
        }
        if expression.kind == AstKind::ExprUnary && expression.int_value == 82 {
            return self.lower_expression(expression.first_child, TargetTypeTag::Pointer, first_parameter, parameter_count);
        }
        if expression.kind != AstKind::ExprFieldAccess { return 0; }
        let owner: u32 = self.cfg_struct_id(expression.first_child, depth + 1);
        let field: u32 = self.find_field(owner, expression.str_offset, expression.str_len);
        if field == 0 || (self.field_struct_ids[field as usize - 1] == 0
            && self.field_byte_counts[field as usize - 1] == 0) { return 0; }
        let address: u32 = self.cfg_struct_address(expression.first_child, first_parameter, parameter_count, depth + 1);
        let offset: u32 = self.append_value(TargetTypeTag::U64, 0, 0);
        if address == 0 || offset == 0 || !self.append_instruction(TargetOpcode::ConstInt,
            offset, TargetTypeTag::U64, 0, 0, expression_index) { return 0; }
        unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = self.field_offsets[field as usize - 1] as u64; }
        let first: u32 = self.operand_count as u32;
        let result: u32 = self.append_value(TargetTypeTag::Pointer, 0, 0);
        if result == 0 || !self.append_operand(address) || !self.append_operand(offset)
            || !self.append_instruction(TargetOpcode::PtrOffset, result, TargetTypeTag::Pointer, first, 2, expression_index) { return 0; }
        unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = 1; }
        return result;
    }

    pub fn cfg_find_local(self: &Self, offset: usize, length: usize) -> usize {
        let mut i: usize = self.local_count;
        while i > 0 {
            i = i - 1;
            if self.source_name_equals(self.local_name_offsets[i], self.local_name_lens[i], offset, length) {
                return i;
            }
        }
        return self.local_count;
    }

    pub fn cfg_load_local(mut self: &mut Self, slot: usize, node: usize) -> u32 {
        let typ: TargetTypeTag = self.local_storage_types[slot] as TargetTypeTag;
        let result: u32 = self.append_value(typ, 0, 0);
        let first: u32 = self.operand_count as u32;
        if result == 0 || !self.append_operand(self.local_value_ids[slot])
            || !self.append_instruction(TargetOpcode::Load, result, typ, first, 1, node) {
            return 0;
        }
        return result;
    }

    pub fn cfg_expression_contains_unsafe(self: &Self, expression_index: usize, depth: usize) -> bool {
        if self.nodes == null || expression_index == 0
            || expression_index >= self.node_count || depth >= 64 { return false; }
        let expression: AstNode = unsafe { *(self.nodes + expression_index) };
        if expression.kind == AstKind::UnsafeExpr { return true; }
        let mut child: usize = expression.first_child;
        while child != 0 {
            if child >= self.node_count { return false; }
            if self.cfg_expression_contains_unsafe(child, depth + 1) { return true; }
            child = unsafe { (*(self.nodes + child)).next_sibling };
        }
        return false;
    }

    pub fn cfg_required(self: &Self, function_index: usize) -> bool {
        let mut count: usize = 0;
        let mut needs_cfg: bool = false;
        let mut no_loop_unsafe: bool = false;
        let mut nested_field_store: bool = false;
        let mut aggregate_call: bool = false;
        let mut local_array_decl: bool = false;
        // Parser allocation is ordered: a function precedes its descendants,
        // and the next function starts a new subtree. Avoid rescanning every
        // other function for each declaration in compiler-sized modules.
        let mut i: usize = function_index + 1;
        while i < self.node_count {
            let node: AstNode = unsafe { *(self.nodes + i) };
            if node.kind == AstKind::FnDecl { break; }
            if node.kind == AstKind::ExprIdent && self.global_record_id(i) != 0 { needs_cfg=true; }
            let mut signed_narrow: bool = false;
            if node.kind == AstKind::TypeRef {
                let declared: TargetTypeTag = self.type_tag_for(i);
                signed_narrow = declared == TargetTypeTag::I8 || declared == TargetTypeTag::I16 || declared == TargetTypeTag::I32
                    || target_type_is_float(declared);
            }
            if signed_narrow {
                let mut parent: usize = node.parent;
                let mut depth: usize = 0;
                while parent != 0 && parent < self.node_count && parent != function_index && depth < self.node_count {
                    parent = unsafe { (*(self.nodes + parent)).parent };
                    depth = depth + 1;
                }
                if parent == function_index { return true; }
            }
            let is_loop: bool = node.kind == AstKind::WhileStmt;
            let is_branch: bool = node.kind == AstKind::IfStmt;
            let is_defer: bool = node.kind == AstKind::DeferStmt || node.kind == AstKind::MatchStmt || node.kind == AstKind::ExprMatch;
            // Only a standalone block introduces the extra lexical scope here.
            // If/while bodies belong to their control-flow node and must keep
            // the established lowering choice for simple scalar functions.
            let mut is_lexical_block: bool = false;
            if node.kind == AstKind::Block && node.parent != 0 && node.parent < self.node_count {
                let parent_kind: AstKind = unsafe { (*(self.nodes + node.parent)).kind };
                is_lexical_block = parent_kind == AstKind::Block || parent_kind == AstKind::UnsafeBlock;
            }
            let mut is_local_array: bool = false;
            if node.kind == AstKind::LetStmt && node.first_child != 0
                && node.first_child < self.node_count {
                let first: AstNode = unsafe { *(self.nodes + node.first_child) };
                is_local_array = first.kind == AstKind::TypeRef && first.str_len != 0
                    && unsafe { *(self.source + first.str_offset) } == 91;
            }
            let is_aggregate_call: bool = node.kind == AstKind::ExprCall && self.cfg_struct_id(i, 0) != 0;
            let scalar_call: bool = node.kind == AstKind::ExprCall;
            let needs_lazy_condition: bool = node.kind == AstKind::ExprConditional
                || (node.kind == AstKind::ExprBinary && (node.int_value == 110 || node.int_value == 111));
            let array_index: bool = node.kind == AstKind::ExprIndex;
            let unsafe_block: bool = node.kind == AstKind::UnsafeBlock || node.kind == AstKind::UnsafeExpr;
            let mut method_call: bool = false;
            if node.kind == AstKind::ExprCall && node.first_child != 0 && node.first_child < self.node_count {
                let callee: AstNode = unsafe { *(self.nodes + node.first_child) };
                method_call = callee.kind == AstKind::ExprFieldAccess || callee.kind == AstKind::ExprPath;
            }
            let mut nested_field: bool = false;
            if node.kind == AstKind::ExprFieldAccess && node.first_child != 0
                && node.first_child < self.node_count {
                nested_field = unsafe { (*(self.nodes + node.first_child)).kind } == AstKind::ExprFieldAccess;
            }
            let mut is_field_assignment: bool = false;
            let is_assignment: bool = node.kind == AstKind::AssignStmt;
            if node.kind == AstKind::AssignStmt && node.first_child != 0
                && node.first_child < self.node_count {
                is_field_assignment = unsafe {
                    (*(self.nodes + node.first_child)).kind
                } == AstKind::ExprFieldAccess;
            }
            if is_loop || is_branch || is_defer || is_lexical_block || is_local_array || needs_lazy_condition || is_assignment || is_field_assignment || is_aggregate_call || unsafe_block || nested_field || method_call || array_index || scalar_call {
                let mut parent: usize = node.parent;
                let mut depth: usize = 0;
                let mut nested_in_if: bool = false;
                let mut ancestor_child: usize = i;
                let mut call_in_condition: bool = false;
                while parent != 0 && parent < self.node_count && depth < self.node_count {
                    if parent == function_index {
                        if is_loop { count = count + 1; }
                        if is_local_array { local_array_decl = true; }
                        if is_aggregate_call { aggregate_call = true; }
                        if (is_branch && nested_in_if) || call_in_condition
                            || needs_lazy_condition || is_defer || is_lexical_block || unsafe_block || nested_field || method_call || array_index { needs_cfg = true; }
                        if needs_lazy_condition && self.cfg_expression_contains_unsafe(i, 0) {
                            no_loop_unsafe = true;
                        }
                        if is_field_assignment && nested_in_if { nested_field_store = true; }
                        if is_assignment && nested_in_if { needs_cfg = true; }
                        break;
                    }
                    if unsafe { (*(self.nodes + parent)).kind } == AstKind::IfStmt {
                        nested_in_if = true;
                        if scalar_call && unsafe { (*(self.nodes + parent)).first_child } == ancestor_child {
                            call_in_condition = true;
                        }
                    }
                    ancestor_child = parent;
                    parent = unsafe { (*(self.nodes + parent)).parent };
                    depth = depth + 1;
                }
            }
            i = i + 1;
        }
        return count != 0 || needs_cfg || local_array_decl
            || no_loop_unsafe || nested_field_store || aggregate_call;
    }

    pub fn cfg_reserve_block(mut self: &mut Self) -> u32 {
        if self.blocks == null || self.block_count >= self.block_capacity { return 0; }
        let id: u32 = (self.block_count + 1) as u32;
        unsafe { *(self.blocks + self.block_count) = TargetBlock::empty(); }
        self.block_count = self.block_count + 1;
        return id;
    }

    pub fn cfg_begin(mut self: &mut Self, id: u32) -> void {
        self.cfg_current = id;
        self.cfg_first_instruction = self.instruction_count;
        return;
    }

    pub fn cfg_finish(mut self: &mut Self) -> bool {
        if self.cfg_current == 0 || self.instruction_count <= self.cfg_first_instruction { return false; }
        unsafe {
            *(self.blocks + self.cfg_current as usize - 1) = TargetBlock {
                id: self.cfg_current, label: TargetSourceSlice::empty(),
                first_instruction: self.cfg_first_instruction as u32,
                instruction_count: (self.instruction_count - self.cfg_first_instruction) as u32
            };
        }
        self.cfg_current = 0;
        return true;
    }

    pub fn cfg_jump(mut self: &mut Self, destination: u32, node: usize) -> bool {
        let first: u32 = self.target_count as u32;
        if destination == 0 || !self.append_target(destination)
            || !self.append_instruction(TargetOpcode::Branch, 0, TargetTypeTag::Invalid, 0, 0, node) {
            return false;
        }
        unsafe {
            (*(self.instructions + self.instruction_count - 1)).first_target = first;
            (*(self.instructions + self.instruction_count - 1)).target_count = 1;
        }
        return self.cfg_finish();
    }

    pub fn cfg_test(mut self: &mut Self, expression_index: usize, yes: u32, no: u32,
        first_parameter: usize, parameter_count: usize, depth: usize) -> bool {
        if depth >= 64 || expression_index == 0 || expression_index >= self.node_count { return false; }
        let expr: AstNode = unsafe { *(self.nodes + expression_index) };
        if expr.kind == AstKind::UnsafeExpr {
            return self.cfg_test(expr.first_child, yes, no, first_parameter, parameter_count, depth + 1);
        }
        if expr.kind == AstKind::ExprUnary && expr.int_value == 98 {
            return self.cfg_test(expr.first_child, no, yes, first_parameter, parameter_count, depth + 1);
        }
        if expr.kind == AstKind::ExprBinary && (expr.int_value == 110 || expr.int_value == 111) {
            let left: usize = expr.first_child;
            if left == 0 || left >= self.node_count { return false; }
            let right: usize = unsafe { (*(self.nodes + left)).next_sibling };
            let middle: u32 = self.cfg_reserve_block();
            if middle == 0 { return false; }
            let mut left_yes: u32 = middle;
            let mut left_no: u32 = no;
            if expr.int_value == 111 { left_yes = yes; left_no = middle; }
            if !self.cfg_test(left, left_yes, left_no, first_parameter, parameter_count, depth + 1) { return false; }
            self.cfg_begin(middle);
            return self.cfg_test(right, yes, no, first_parameter, parameter_count, depth + 1);
        }
        let condition: u32 = self.lower_condition_expression(expression_index, first_parameter, parameter_count);
        if condition == 0 { return self.reject(expression_index); }
        let operand: u32 = self.operand_count as u32;
        let target_start: u32 = self.target_count as u32;
        if condition == 0 || !self.append_operand(condition) || !self.append_target(yes)
            || !self.append_target(no) || !self.append_instruction(
                TargetOpcode::CondBranch, 0, TargetTypeTag::Invalid, operand, 1, expression_index
            ) { return false; }
        unsafe {
            (*(self.instructions + self.instruction_count - 1)).first_target = target_start;
            (*(self.instructions + self.instruction_count - 1)).target_count = 2;
        }
        return self.cfg_finish();
    }

    // Materialize a lazy Boolean as a value usable by return, let, assign and
    // call arguments. Each incoming path stores its bit before the join load.
    pub fn cfg_conditional_value(mut self: &mut Self, expression_index: usize,
        typ: TargetTypeTag, first_parameter: usize, parameter_count: usize) -> u32 {
        if self.cfg_current == 0 || expression_index == 0 || expression_index >= self.node_count { return 0; }
        let expression: AstNode = unsafe { *(self.nodes + expression_index) };
        let condition: usize = expression.first_child;
        if condition == 0 || condition >= self.node_count { return 0; }
        let yes_expression: usize = unsafe { (*(self.nodes + condition)).next_sibling };
        if yes_expression == 0 || yes_expression >= self.node_count { return 0; }
        let no_expression: usize = unsafe { (*(self.nodes + yes_expression)).next_sibling };
        if no_expression == 0 || no_expression >= self.node_count
            || unsafe { (*(self.nodes + no_expression)).next_sibling } != 0 { return 0; }
        let yes_record: u32 = self.cfg_record_value_id(yes_expression, 0);
        let no_record: u32 = self.cfg_record_value_id(no_expression, 0);
        if yes_record != 0 || no_record != 0 {
            if typ != TargetTypeTag::Pointer || yes_record == 0 || yes_record != no_record { return 0; }
            let destination: u32 = self.allocate_struct(yes_record, expression_index);
            let yes: u32 = self.cfg_reserve_block(); let no: u32 = self.cfg_reserve_block(); let join: u32 = self.cfg_reserve_block();
            if destination == 0 || yes == 0 || no == 0 || join == 0
                || !self.cfg_test(condition, yes, no, first_parameter, parameter_count, 0) { return 0; }
            self.cfg_begin(yes);
            let yes_value: u32 = self.cfg_struct_address(yes_expression, first_parameter, parameter_count, 0);
            if yes_value == 0 || !self.cfg_copy_fields(destination, yes_value, yes_record, 0, 0, yes_expression, 0)
                || !self.cfg_jump(join, expression_index) { return 0; }
            self.cfg_begin(no);
            let no_value: u32 = self.cfg_struct_address(no_expression, first_parameter, parameter_count, 0);
            if no_value == 0 || !self.cfg_copy_fields(destination, no_value, yes_record, 0, 0, no_expression, 0)
                || !self.cfg_jump(join, expression_index) { return 0; }
            self.cfg_begin(join);
            return destination;
        }
        let size: u32 = self.scalar_memory_size(typ);
        if size == 0 || typ == TargetTypeTag::Aggregate { return 0; }
        let storage: u32 = self.append_value(TargetTypeTag::Pointer, 0, 0);
        if storage == 0 || !self.append_instruction(TargetOpcode::AllocStack, storage,
            TargetTypeTag::Pointer, 0, 0, expression_index) { return 0; }
        unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = size as u64; }
        let yes: u32 = self.cfg_reserve_block(); let no: u32 = self.cfg_reserve_block(); let join: u32 = self.cfg_reserve_block();
        if yes == 0 || no == 0 || join == 0
            || !self.cfg_test(condition, yes, no, first_parameter, parameter_count, 0) { return 0; }
        self.cfg_begin(yes);
        let yes_value: u32 = self.lower_expression(yes_expression, typ, first_parameter, parameter_count);
        if yes_value == 0 || unsafe { (*(self.values + yes_value as usize - 1)).type_tag } != typ
            || !self.cfg_store(storage, yes_value, typ, yes_expression) || !self.cfg_jump(join, expression_index) { return 0; }
        self.cfg_begin(no);
        let no_value: u32 = self.lower_expression(no_expression, typ, first_parameter, parameter_count);
        if no_value == 0 || unsafe { (*(self.values + no_value as usize - 1)).type_tag } != typ
            || !self.cfg_store(storage, no_value, typ, no_expression) || !self.cfg_jump(join, expression_index) { return 0; }
        self.cfg_begin(join);
        let result: u32 = self.append_value(typ, 0, 0);
        let operand: u32 = self.operand_count as u32;
        if result == 0 || !self.append_operand(storage) || !self.append_instruction(TargetOpcode::Load,
            result, typ, operand, 1, expression_index) { return 0; }
        return result;
    }

    pub fn cfg_boolean_value(mut self: &mut Self, expression_index: usize,
        first_parameter: usize, parameter_count: usize) -> u32 {
        if self.cfg_current == 0 { return 0; }
        let storage: u32 = self.append_value(TargetTypeTag::Pointer, 0, 0);
        if storage == 0 || !self.append_instruction(TargetOpcode::AllocStack,
            storage, TargetTypeTag::Pointer, 0, 0, expression_index) { return 0; }
        unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = 1; }
        let yes: u32 = self.cfg_reserve_block();
        let no: u32 = self.cfg_reserve_block();
        let join: u32 = self.cfg_reserve_block();
        if yes == 0 || no == 0 || join == 0
            || !self.cfg_test(expression_index, yes, no, first_parameter, parameter_count, 0) { return 0; }
        self.cfg_begin(yes);
        let true_value: u32 = self.append_value(TargetTypeTag::Bool, 0, 0);
        if true_value == 0 || !self.append_instruction(TargetOpcode::ConstInt,
            true_value, TargetTypeTag::Bool, 0, 0, expression_index) { return 0; }
        unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = 1; }
        if !self.cfg_store(storage, true_value, TargetTypeTag::Bool, expression_index)
            || !self.cfg_jump(join, expression_index) { return 0; }
        self.cfg_begin(no);
        let false_value: u32 = self.append_value(TargetTypeTag::Bool, 0, 0);
        if false_value == 0 || !self.append_instruction(TargetOpcode::ConstInt,
            false_value, TargetTypeTag::Bool, 0, 0, expression_index)
            || !self.cfg_store(storage, false_value, TargetTypeTag::Bool, expression_index)
            || !self.cfg_jump(join, expression_index) { return 0; }
        self.cfg_begin(join);
        let result: u32 = self.append_value(TargetTypeTag::Bool, 0, 0);
        let operand: u32 = self.operand_count as u32;
        if result == 0 || !self.append_operand(storage) || !self.append_instruction(
            TargetOpcode::Load, result, TargetTypeTag::Bool, operand, 1, expression_index) { return 0; }
        return result;
    }

    pub fn cfg_store(mut self: &mut Self, address: u32, value: u32, typ: TargetTypeTag, node: usize) -> bool {
        let first: u32 = self.operand_count as u32;
        return address != 0 && value != 0 && self.append_operand(address) && self.append_operand(value)
            && self.append_instruction(TargetOpcode::Store, 0, typ, first, 2, node);
    }

    // Initialize large local arrays with bounded executable CFG instead of
    // duplicating four IR instructions for every element in compiler tables.
    // Local record arrays copy values; pointer/ownership fields need a separate lifetime contract.
    pub fn array_record_copyable(self: &Self, record: u32, depth: usize) -> bool {
        if record == 0 || record as usize > self.struct_count || depth >= 32 { return false; }
        let start: usize = self.struct_field_starts[record as usize - 1] as usize;
        let count: usize = self.struct_field_counts[record as usize - 1] as usize;
        let mut i: usize = 0;
        while i < count {
            let field: usize = start + i;
            let declared: usize = self.field_type_refs[field];
            if declared != 0 && declared < self.node_count && unsafe { (*(self.nodes + declared)).int_value } != 0 { return false; }
            if self.field_array_structs[field] != 0 {
                if !self.array_record_copyable(self.field_array_structs[field],depth+1) { return false; }
            } else if self.field_struct_ids[field] != 0 {
                if !self.array_record_copyable(self.field_struct_ids[field], depth + 1) { return false; }
            } else if (self.field_byte_counts[field] == 0 && self.field_type_tags[field] == TargetTypeTag::Pointer as u32)
                || (self.field_byte_counts[field] != 0 && self.field_array_types[field] == TargetTypeTag::Pointer as u32) { return false; }
            i = i + 1;
        }
        return true;
    }

    pub fn cfg_fill_array(mut self: &mut Self, address: u32, count: usize,
        stride: u32, element_type: TargetTypeTag, node: usize, fill: u32, record: u32) -> bool {
        if address == 0 || count == 0 || count > 4096 || stride == 0 || self.cfg_current == 0 { return false; }
        let counter: u32 = self.append_value(TargetTypeTag::Pointer, 0, 0);
        if counter == 0 || !self.append_instruction(TargetOpcode::AllocStack, counter,
            TargetTypeTag::Pointer, 0, 0, node) { return false; }
        unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = 8; }
        let start: u32 = self.append_value(TargetTypeTag::U64, 0, 0);
        let limit: u32 = self.append_value(TargetTypeTag::U64, 0, 0);
        let one: u32 = self.append_value(TargetTypeTag::U64, 0, 0);
        let mut zero: u32 = fill;
        if zero == 0 { zero = self.append_value(element_type, 0, 0); }
        if start == 0 || limit == 0 || one == 0 || zero == 0
            || !self.append_instruction(TargetOpcode::ConstInt, start, TargetTypeTag::U64, 0, 0, node)
            || !self.cfg_store(counter, start, TargetTypeTag::U64, node)
            || !self.append_instruction(TargetOpcode::ConstInt, limit, TargetTypeTag::U64, 0, 0, node) { return false; }
        unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = count as u64; }
        if !self.append_instruction(TargetOpcode::ConstInt, one, TargetTypeTag::U64, 0, 0, node) { return false; }
        unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = 1; }
        let mut zero_opcode: TargetOpcode = TargetOpcode::ConstInt;
        if target_type_is_float(element_type) { zero_opcode = TargetOpcode::ConstFloat; }
        if fill == 0 && !self.append_instruction(zero_opcode, zero, element_type, 0, 0, node) { return false; }
        let header: u32 = self.cfg_reserve_block();
        let body: u32 = self.cfg_reserve_block();
        let done: u32 = self.cfg_reserve_block();
        if header == 0 || body == 0 || done == 0 || !self.cfg_jump(header, node) { return false; }
        self.cfg_begin(header);
        let position: u32 = self.append_value(TargetTypeTag::U64, 0, 0);
        let load_operand: u32 = self.operand_count as u32;
        if position == 0 || !self.append_operand(counter) || !self.append_instruction(
            TargetOpcode::Load, position, TargetTypeTag::U64, load_operand, 1, node) { return false; }
        let condition: u32 = self.append_value(TargetTypeTag::Bool, 0, 0);
        let compare_operand: u32 = self.operand_count as u32;
        if condition == 0 || !self.append_operand(position) || !self.append_operand(limit)
            || !self.append_instruction(TargetOpcode::Compare, condition, TargetTypeTag::Bool,
                compare_operand, 2, node) { return false; }
        unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = 88; }
        let branch_operand: u32 = self.operand_count as u32;
        let branch_target: u32 = self.target_count as u32;
        if !self.append_operand(condition) || !self.append_target(body) || !self.append_target(done)
            || !self.append_instruction(TargetOpcode::CondBranch, 0, TargetTypeTag::Invalid,
                branch_operand, 1, node) { return false; }
        unsafe {
            (*(self.instructions + self.instruction_count - 1)).first_target = branch_target;
            (*(self.instructions + self.instruction_count - 1)).target_count = 2;
        }
        if !self.cfg_finish() { return false; }
        self.cfg_begin(body);
        let destination: u32 = self.append_value(TargetTypeTag::Pointer, 0, 0);
        let address_operand: u32 = self.operand_count as u32;
        if destination == 0 || !self.append_operand(address) || !self.append_operand(position)
            || !self.append_instruction(TargetOpcode::IndexAddr, destination, TargetTypeTag::Pointer,
                address_operand, 2, node) { return false; }
        unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits =
            (count as u64 << 32) | stride as u64; }
        if record != 0 {
            if !self.cfg_copy_fields(destination, zero, record, 0, 0, node, 0) { return false; }
        } else if !self.cfg_store(destination, zero, element_type, node) { return false; }
        let next: u32 = self.append_value(TargetTypeTag::U64, 0, 0);
        let add_operand: u32 = self.operand_count as u32;
        if next == 0 || !self.append_operand(position) || !self.append_operand(one)
            || !self.append_instruction(TargetOpcode::Add, next, TargetTypeTag::U64,
                add_operand, 2, node) || !self.cfg_store(counter, next, TargetTypeTag::U64, node)
            || !self.cfg_jump(header, node) { return false; }
        self.cfg_begin(done);
        return true;
    }

    pub fn cfg_simple(mut self: &mut Self, index: usize, first_parameter: usize, parameter_count: usize) -> bool {
        let stmt: AstNode = unsafe { *(self.nodes + index) };
        if stmt.kind == AstKind::LetStmt {
            if self.local_count >= 128 || stmt.first_child == 0 { return self.reject(index); }
            let first: AstNode = unsafe { *(self.nodes + stmt.first_child) };
            let mut type_index: usize = 0;
            let mut value_index: usize = stmt.first_child;
            if first.kind == AstKind::TypeRef { type_index = stmt.first_child; value_index = first.next_sibling; }
            if value_index == 0 || value_index >= self.node_count { return self.reject(index); }
            let value_node: AstNode = unsafe { *(self.nodes + value_index) };
            let mut struct_id: u32 = 0;
            if type_index != 0 {
                let declared: AstNode = unsafe { *(self.nodes + type_index) };
                struct_id = self.find_struct(declared.str_offset, declared.str_len);
                if declared.str_len != 0
                    && unsafe { *(self.source + declared.str_offset) } == 91 {
                    let mut elem: TargetTypeTag = self.parse_array_element_type(declared.str_offset, declared.str_len);
                    let record: u32 = self.parse_array_element_struct(declared.str_offset, declared.str_len);
                    let stride: u32 = self.parse_array_element_stride(declared.str_offset, declared.str_len) as u32;
                    if record != 0 {
                        if !self.array_record_copyable(record, 0) { return self.reject(index); }
                        elem = TargetTypeTag::Pointer;
                    }
                    let count: usize = self.parse_array_element_count(
                        declared.str_offset, declared.str_len
                    );
                    if stride == 0 || count == 0 || count > 4096 { return self.reject(index); }
                    let maximum_bytes: usize = 65536;
                    let record_stride: usize = stride as usize;
                    if record != 0 && count > maximum_bytes / record_stride { return self.reject(index); }
                    let zero_initializer: bool = value_node.kind == AstKind::ExprLiteral
                        && value_node.str_len == 1 && unsafe { *(self.source + value_node.str_offset) } == 48;
                    let list_initializer: bool = value_node.kind == AstKind::ExprArrayLiteral;
                    let mut repeated_value: u32 = 0;
                    let mut element_node: usize = 0;
                    if value_node.kind == AstKind::ExprArrayRepeat {
                        element_node = value_node.first_child;
                        if element_node == 0 || element_node >= self.node_count { return self.reject(index); }
                        let count_node: usize = unsafe { (*(self.nodes + element_node)).next_sibling };
                        if count_node == 0 || count_node >= self.node_count { return self.reject(index); }
                        let length_node: AstNode = unsafe { *(self.nodes + count_node) };
                        if length_node.kind != AstKind::ExprLiteral || length_node.next_sibling != 0
                            || self.parse_integer_value(length_node.str_offset, length_node.str_len) != count as u64 { return self.reject(index); }
                        if record != 0 && self.cfg_struct_id(element_node, 0) != record { return self.reject(element_node); }
                        repeated_value = self.lower_expression(element_node, elem, first_parameter, parameter_count);
                        if repeated_value == 0 { return self.reject(index); }
                    } else if list_initializer {
                        element_node = value_node.first_child;
                        let mut elements: usize = 0; let mut scan: usize = element_node;
                        while scan != 0 && elements <= count {
                            if scan >= self.node_count { return self.reject(index); }
                            elements = elements + 1; scan = unsafe { (*(self.nodes + scan)).next_sibling };
                        }
                        if elements != count || scan != 0 { return self.reject(index); }
                    } else if !zero_initializer || record != 0 { return self.reject(index); }
                    let total: usize = stride as usize * count;
                    let address: u32 = self.append_value(TargetTypeTag::Pointer, 0, 0);
                    if address == 0 || !self.append_instruction(
                        TargetOpcode::AllocStack, address, TargetTypeTag::Pointer,
                        0, 0, index
                    ) { return self.reject(index); }
                    unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits =
                        total as u64; }
                    if count > 16 && !list_initializer {
                        if !self.cfg_fill_array(address, count, stride, elem, index, repeated_value, record) { return self.reject(index); }
                    }
                    let mut element: usize = 0;
                    if count > 16 && !list_initializer { element = count; }
                    while element < count {
                        let position: u32 = self.append_value(TargetTypeTag::U64, 0, 0);
                        if position == 0 || !self.append_instruction(
                            TargetOpcode::ConstInt, position, TargetTypeTag::U64,
                            0, 0, index
                        ) { return self.reject(index); }
                        unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits =
                            element as u64; }
                        let first_op: u32 = self.operand_count as u32;
                        let element_address: u32 = self.append_value(TargetTypeTag::Pointer, 0, 0);
                        if element_address == 0 || !self.append_operand(address)
                            || !self.append_operand(position)
                            || !self.append_instruction(
                                TargetOpcode::IndexAddr, element_address,
                                TargetTypeTag::Pointer, first_op, 2, index
                            ) { return self.reject(index); }
                        unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits =
                            (count as u64 << 32) | stride as u64; }
                        let mut initial_value: u32 = repeated_value;
                        if list_initializer {
                            if record != 0 && self.cfg_struct_id(element_node, 0) != record { return self.reject(element_node); }
                            initial_value = self.lower_expression(element_node, elem, first_parameter, parameter_count);
                            element_node = unsafe { (*(self.nodes + element_node)).next_sibling };
                        } else if initial_value == 0 {
                            initial_value = self.append_value(elem, 0, 0);
                            let mut zero_opcode: TargetOpcode = TargetOpcode::ConstInt;
                            if target_type_is_float(elem) { zero_opcode = TargetOpcode::ConstFloat; }
                            if initial_value == 0 || !self.append_instruction(zero_opcode, initial_value, elem, 0, 0, index) { return self.reject(index); }
                        }
                        if initial_value == 0 || unsafe { (*(self.values + initial_value as usize - 1)).type_tag } != elem
                            { return self.reject(index); }
                        if record != 0 {
                            if !self.cfg_copy_fields(element_address, initial_value, record, 0, 0, index, 0) { return self.reject(index); }
                        } else if !self.cfg_store(element_address, initial_value, elem, index) { return self.reject(index); }
                        element = element + 1;
                    }
                    let slot: usize = self.local_count;
                    self.local_name_offsets[slot] = stmt.str_offset;
                    self.local_name_lens[slot] = stmt.str_len;
                    self.local_struct_ids[slot] = 0;
                    self.local_storage_types[slot] = 0;
                    self.local_array_types[slot] = elem as u32;
                    self.local_struct_ids[slot] = record;
                    self.local_array_counts[slot] = count as u32;
                    self.local_value_ids[slot] = address;
                    self.local_count = self.local_count + 1;
                    return true;
                }
            }
            let mut typ: TargetTypeTag = TargetTypeTag::Invalid;
            let mut value: u32 = 0;
            if struct_id != 0 && value_node.kind == AstKind::UnsafeExpr {
                let deref_index: usize = value_node.first_child;
                if deref_index == 0 || deref_index >= self.node_count { return self.reject(index); }
                let deref: AstNode = unsafe { *(self.nodes + deref_index) };
                typ = TargetTypeTag::Pointer;
                if deref.kind == AstKind::ExprUnary && deref.int_value == 82 {
                    if self.pointer_pointee_struct_id(self.pointer_expression_type_ref(deref.first_child)) != struct_id {
                        return self.reject(index);
                    }
                    value = self.lower_expression(deref.first_child, typ, first_parameter, parameter_count);
                } else {
                    if self.cfg_struct_id(deref_index, 0) != struct_id { return self.reject(index); }
                    value = self.lower_expression(deref_index, typ, first_parameter, parameter_count);
                }
            } else {
                if type_index != 0 { typ = self.type_tag_for(type_index); }
                let value_struct: u32 = self.cfg_struct_id(value_index, 0);
                if value_struct != 0 && (value_node.kind == AstKind::ExprStructLiteral
                    || value_node.kind == AstKind::ExprCall || value_node.kind == AstKind::ExprPath || value_node.kind == AstKind::ExprConditional
                    || value_node.kind == AstKind::ExprMatch || value_node.kind == AstKind::ExprIndex) {
                    if type_index != 0 && struct_id != value_struct { return self.reject(index); }
                    struct_id = value_struct;
                    typ = TargetTypeTag::Pointer;
                }
                if typ == TargetTypeTag::Invalid {
                    typ = self.condition_expression_type(value_index, first_parameter, parameter_count);
                    if typ == TargetTypeTag::Invalid { typ = TargetTypeTag::U32; }
                }
                value = self.lower_expression(value_index, typ, first_parameter, parameter_count);
            }
            if value == 0 { return self.reject(index); }
            if struct_id != 0 && (value_node.kind == AstKind::ExprIdent || value_node.kind == AstKind::ExprFieldAccess || value_node.kind == AstKind::ExprIndex
                || (value_node.kind == AstKind::UnsafeExpr && value_node.first_child != 0
                    && (unsafe { (*(self.nodes + value_node.first_child)).kind } != AstKind::ExprUnary
                        || unsafe { (*(self.nodes + value_node.first_child)).int_value } != 82))
                || (stmt.int_value == 1 && value_node.kind != AstKind::ExprStructLiteral
                    && value_node.kind != AstKind::ExprCall)) {
                let copy: u32 = self.allocate_struct(struct_id, index);
                if copy == 0 || !self.cfg_copy_fields(copy, value, struct_id, 0, 0, index, 0) {
                    return self.reject(index);
                }
                value = copy;
            }
            let slot: usize = self.local_count;
            self.local_name_offsets[slot] = stmt.str_offset;
            self.local_name_lens[slot] = stmt.str_len;
            self.local_struct_ids[slot] = struct_id;
            self.local_storage_types[slot] = 0;
            self.local_array_types[slot] = 0;
            self.local_array_counts[slot] = 0;
            if stmt.int_value == 1 && struct_id == 0 {
                let address: u32 = self.append_value(TargetTypeTag::Pointer, 0, 0);
                if address == 0 || !self.append_instruction(TargetOpcode::AllocStack, address,
                    TargetTypeTag::Pointer, 0, 0, index) { return self.reject(index); }
                unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = 8; }
                if !self.cfg_store(address, value, typ, index) { return self.reject(index); }
                self.local_value_ids[slot] = address;
                self.local_storage_types[slot] = typ as u32;
            } else { self.local_value_ids[slot] = value; }
            if !self.mark_value_domain(self.local_value_ids[slot], type_index) { return self.reject(index); }
            self.local_count = self.local_count + 1;
            return true;
        }
        if stmt.kind == AstKind::AssignStmt {
            let left_index: usize = stmt.first_child;
            if left_index == 0 || left_index >= self.node_count { return self.reject(index); }
            let left: AstNode = unsafe { *(self.nodes + left_index) };
            if left.kind == AstKind::ExprUnary && left.int_value == 82 {
                return self.lower_pointer_deref_store(index, first_parameter, parameter_count);
            }
            if left.kind == AstKind::ExprFieldAccess {
                return self.lower_field_assignment(index, first_parameter, parameter_count);
            }
            if left.kind == AstKind::ExprIndex {
                let field: u32 = self.indexed_array_field(left_index);
                let mut typ: TargetTypeTag = TargetTypeTag::Invalid;
                let base: AstNode = unsafe { *(self.nodes + left.first_child) };
                let mut local_slot: usize = self.local_count;
                if base.kind == AstKind::ExprIdent {
                    local_slot = self.cfg_find_local(base.str_offset, base.str_len);
                }
                let is_local: bool = local_slot < self.local_count
                    && self.local_array_counts[local_slot] != 0;
                if is_local {
                    let record: u32 = self.local_struct_ids[local_slot];
                    if record != 0 {
                        if self.cfg_struct_id(left.next_sibling, 0) != record { return self.reject(index); }
                        let destination: u32 = self.cfg_local_array_index_address(left_index, first_parameter, parameter_count);
                        let source_address: u32 = self.cfg_struct_address(left.next_sibling, first_parameter, parameter_count, 0);
                        return destination != 0 && source_address != 0 && self.cfg_copy_fields(destination, source_address, record, 0, 0, index, 0);
                    }
                    typ = self.local_array_types[local_slot] as TargetTypeTag;
                } else if field != 0 {
                    let record: u32 = self.field_array_structs[field as usize - 1];
                    if record != 0 {
                        if self.cfg_struct_id(left.next_sibling,0) != record { return self.reject(index); }
                        let destination: u32 = self.cfg_field_array_index_address(left_index,field,first_parameter,parameter_count);
                        let source_address: u32 = self.cfg_struct_address(left.next_sibling,first_parameter,parameter_count,0);
                        return destination != 0 && source_address != 0
                            && self.cfg_copy_fields(destination,source_address,record,0,0,index,0);
                    }
                    typ = self.field_array_types[field as usize - 1] as TargetTypeTag;
                } else {
                    if base.kind != AstKind::ExprIdent { return self.reject(index); }
                    let global: isize = self.find_global_bss(base.str_offset, base.str_len);
                    if global < 0 { return self.reject(index); }
                    let record: u32 = self.global_array_record_id(left.first_child);
                    if record != 0 {
                        if self.cfg_struct_id(left.next_sibling,0) != record { return self.reject(index); }
                        let destination: u32 = self.cfg_field_array_index_address(left_index,0,first_parameter,parameter_count);
                        let source_address: u32 = self.cfg_struct_address(left.next_sibling,first_parameter,parameter_count,0);
                        return destination != 0 && source_address != 0
                            && self.cfg_copy_fields(destination,source_address,record,0,0,index,0);
                    }
                    typ = unsafe { g_bss_sym_element_types[global as usize] } as TargetTypeTag;
                }
                let mut address: u32 = 0;
                if is_local {
                    address = self.cfg_local_array_index_address(
                        left_index, first_parameter, parameter_count
                    );
                } else {
                    address = self.cfg_field_array_index_address(
                        left_index, field, first_parameter, parameter_count
                    );
                }
                let value: u32 = self.lower_expression(left.next_sibling, typ, first_parameter, parameter_count);
                return self.cfg_store(address, value, typ, index);
            }
            if left.kind != AstKind::ExprIdent { return self.reject(index); }
            let slot: usize = self.cfg_find_local(left.str_offset, left.str_len);
            if slot < self.local_count && self.local_struct_ids[slot] != 0 {
                let struct_id: u32 = self.local_struct_ids[slot];
                if self.cfg_struct_id(left.next_sibling, 0) != struct_id { return self.reject(index); }
                let address: u32 = self.cfg_struct_address(left.next_sibling, first_parameter, parameter_count, 0);
                return address != 0 && self.cfg_copy_fields(self.local_value_ids[slot], address,
                    struct_id, 0, 0, index, 0);
            }
            if slot >= self.local_count {
                // A module-level mutable scalar has stable BSS storage. An
                // AllocStack carrying its symbol is a global address, not a
                // fresh local allocation; the ELF backend resolves its relocation.
                // Keep arrays, aggregates and unknown names fail-closed here.
                let global: isize = self.find_global_bss(left.str_offset, left.str_len);
                if global < 0 { return self.reject(index); }
                let gi: usize = global as usize;
                if unsafe { g_bss_sym_is_array[gi] } != 0 {
                    return self.reject(index);
                }
                // The module loader registers static scalar storage whether
                // the declaration is mutable or not. Do not permit a write
                // solely because a BSS symbol was found: require the AST's
                // explicit `static mut` bit on the module declaration.
                let mut mutable_global: bool = false;
                let mut decl: usize = 1;
                while decl < self.node_count {
                    let candidate: AstNode = unsafe { *(self.nodes + decl) };
                    if candidate.kind == AstKind::LetStmt
                        && candidate.parent != 0 && candidate.parent < self.node_count
                        && unsafe { (*(self.nodes + candidate.parent)).kind } == AstKind::Module
                        && self.source_name_equals(
                            candidate.str_offset, candidate.str_len,
                            left.str_offset, left.str_len
                        ) {
                        mutable_global = candidate.int_value == 1;
                        break;
                    }
                    decl = decl + 1;
                }
                if !mutable_global { return self.reject(index); }
                let record: u32 = self.global_record_id(left_index);
                if record != 0 {
                    if self.cfg_struct_id(left.next_sibling,0) != record { return self.reject(index); }
                    let destination: u32 = self.cfg_struct_address(left_index,first_parameter,parameter_count,0);
                    let source_address: u32 = self.cfg_struct_address(left.next_sibling,first_parameter,parameter_count,0);
                    return destination != 0 && source_address != 0
                        && self.cfg_copy_fields(destination,source_address,record,0,0,index,0);
                }
                let typ: TargetTypeTag = unsafe { g_bss_sym_types[gi] } as TargetTypeTag;
                if typ != TargetTypeTag::U8 && typ != TargetTypeTag::U16
                    && typ != TargetTypeTag::U32 && typ != TargetTypeTag::U64
                    && typ != TargetTypeTag::Usize && typ != TargetTypeTag::I8 && typ != TargetTypeTag::I16 && typ != TargetTypeTag::I32 && typ != TargetTypeTag::I64
                    && typ != TargetTypeTag::Bool && typ != TargetTypeTag::Pointer && !target_type_is_float(typ) {
                    return self.reject(index);
                }
                let address: u32 = self.append_value(TargetTypeTag::Pointer, 0, 0);
                if address == 0 || !self.append_instruction(
                    TargetOpcode::AllocStack, address, TargetTypeTag::Pointer,
                    0, 0, left_index
                ) { return self.reject(index); }
                let alloc_index: usize = self.instruction_count - 1;
                let mut alloc: TargetInstruction = unsafe {
                    *(self.instructions + alloc_index)
                };
                alloc.immediate_bits = unsafe { g_bss_sym_sizes[gi] } as u64;
                alloc.symbol = TargetSourceSlice {
                    offset: left.str_offset,
                    length: left.str_len
                };
                unsafe { *(self.instructions + alloc_index) = alloc; }
                let value: u32 = self.lower_expression(
                    left.next_sibling, typ, first_parameter, parameter_count
                );
                return self.cfg_store(address, value, typ, index);
            }
            if self.local_storage_types[slot] == 0 { return self.reject(index); }
            let typ: TargetTypeTag = self.local_storage_types[slot] as TargetTypeTag;
            let value: u32 = self.lower_expression(left.next_sibling, typ, first_parameter, parameter_count);
            return self.cfg_store(self.local_value_ids[slot], value, typ, index);
        }
        if stmt.kind == AstKind::ExprCall {
            let declaration: usize = self.cfg_call_declaration(index, 0);
            if declaration != 0 && self.function_return_type_from_ast(declaration) == TargetTypeTag::Void {
                return self.lower_direct_void_call_statement(index, first_parameter, parameter_count);
            }
            return self.lower_expression(index, TargetTypeTag::Invalid, first_parameter, parameter_count) != 0;
        }
        return self.reject(index);
    }

    pub fn defer_payload_valid(self: &Self, index: usize, depth: usize) -> bool {
        if index == 0 || index >= self.node_count || depth >= 64 { return false; }
        let node: AstNode = unsafe { *(self.nodes + index) };
        if node.kind == AstKind::ReturnStmt || node.kind == AstKind::BreakStmt
            || node.kind == AstKind::ContinueStmt || node.kind == AstKind::DeferStmt
            || node.kind == AstKind::TryExpr { return false; }
        let mut child: usize = node.first_child;
        while child != 0 {
            if child >= self.node_count || !self.defer_payload_valid(child, depth + 1) { return false; }
            child = unsafe { (*(self.nodes + child)).next_sibling };
        }
        return true;
    }

    pub fn cfg_emit_defers(mut self: &mut Self, base: usize,
        first_parameter: usize, parameter_count: usize, depth: usize) -> bool {
        if base > self.defer_count || self.defer_count > 128 || depth >= 64 { return false; }
        if base == self.defer_count { return true; }
        let visible: usize = self.local_count;
        let mut saved: [usize;896] = 0;
        let mut slot: usize = 0;
        while slot < visible {
            saved[slot*7] = self.local_name_offsets[slot];
            saved[slot*7+1] = self.local_name_lens[slot];
            saved[slot*7+2] = self.local_value_ids[slot] as usize;
            saved[slot*7+3] = self.local_struct_ids[slot] as usize;
            saved[slot*7+4] = self.local_storage_types[slot] as usize;
            saved[slot*7+5] = self.local_array_types[slot] as usize;
            saved[slot*7+6] = self.local_array_counts[slot] as usize;
            slot = slot + 1;
        }
        let mut cursor: usize = self.defer_count;
        while cursor > base {
            cursor = cursor - 1;
            let payload: usize = self.defer_nodes[cursor];
            if payload == 0 || payload >= self.node_count { return self.reject(payload); }
            self.local_count = self.defer_locals[cursor];
            let node: AstNode = unsafe { *(self.nodes + payload) };
            let mut valid: bool = false;
            if node.kind == AstKind::Block || node.kind == AstKind::UnsafeBlock {
                let mut block_index: usize = payload;
                if node.kind == AstKind::UnsafeBlock { block_index = node.first_child; }
                if block_index == 0 || block_index >= self.node_count { return self.reject(payload); }
                valid = self.cfg_sequence(unsafe { (*(self.nodes + block_index)).first_child }, TargetTypeTag::Void,
                    first_parameter, parameter_count, 0, 0, depth + 1);
            } else {
                valid = self.cfg_simple(payload, first_parameter, parameter_count);
            }
            slot = 0;
            while slot < visible {
                self.local_name_offsets[slot] = saved[slot*7];
                self.local_name_lens[slot] = saved[slot*7+1];
                self.local_value_ids[slot] = saved[slot*7+2] as u32;
                self.local_struct_ids[slot] = saved[slot*7+3] as u32;
                self.local_storage_types[slot] = saved[slot*7+4] as u32;
                self.local_array_types[slot] = saved[slot*7+5] as u32;
                self.local_array_counts[slot] = saved[slot*7+6] as u32;
                slot = slot + 1;
            }
            self.local_count = visible;
            if !valid || self.cfg_current == 0 { return self.reject(payload); }
        }
        return true;
    }

    pub fn find_match_path_separator(self: &Self, node: AstNode) -> usize {
        let mut i: usize = 0;
        while i + 1 < node.str_len {
            if unsafe { *(self.source + node.str_offset + i) } == 58
                && unsafe { *(self.source + node.str_offset + i + 1) } == 58 { return i; }
            i = i + 1;
        }
        return 0;
    }

    pub fn match_coverage_complete(self: &Self, typ: TargetTypeTag, enum_id: u32,
        patterns: *const u64, count: usize) -> bool {
        if patterns == null || count == 0 || count > 64 { return false; }
        if typ == TargetTypeTag::Bool {
            let mut zero: bool = false; let mut one: bool = false;
            let mut i: usize = 0;
            while i < count {
                let bits: u64 = unsafe { *(patterns + i) };
                if bits == 0 { zero = true; } else if bits == 1 { one = true; } else { return false; }
                i = i + 1;
            }
            return zero && one;
        }
        if enum_id == 0 || enum_id as usize > self.enum_count { return false; }
        let start: usize = self.enum_variant_starts[enum_id as usize - 1] as usize;
        let variants: usize = self.enum_variant_counts[enum_id as usize - 1] as usize;
        if variants == 0 || start > self.variant_total_count || variants > self.variant_total_count - start { return false; }
        let mut variant: usize = 0;
        while variant < variants {
            let expected: u64 = self.variant_values[start + variant];
            let mut covered: bool = false; let mut i: usize = 0;
            while i < count { if unsafe { *(patterns + i) } == expected { covered = true; break; } i = i + 1; }
            if !covered { return false; }
            variant = variant + 1;
        }
        return true;
    }

    pub fn match_integer_coverage(self: &Self, typ: TargetTypeTag,
        starts: *const u64, ends: *const u64, count: usize) -> bool {
        let width: u32 = target_integer_width(typ);
        if width == 0 || starts == null || ends == null || count == 0 || count > 64 { return false; }
        let mut maximum: u64 = 18446744073709551615;
        if width < 64 { maximum = ((1 as u64) << width as u64) - 1; }
        let mut next: u64 = 0;
        let mut visited: usize = 0;
        // Alternatives within one source arm may overlap. Grow the covered
        // prefix by the furthest interval containing its next point.
        while visited < count {
            let mut found: bool = false;
            let mut furthest: u64 = 0;
            let mut index: usize = 0;
            while index < count {
                if native_match_order_key(unsafe { *(starts + index) }, typ) <= next {
                    let last: u64 = native_match_order_key(unsafe { *(ends + index) }, typ);
                    if last >= next && (!found || last > furthest) { furthest=last;found=true; }
                }
                index = index + 1;
            }
            if !found { return false; }
            if furthest == maximum { return true; }
            next=furthest+1;
            visited = visited + 1;
        }
        return false;
    }

    pub fn match_bound_has_enum(self: &Self, index: usize, depth: usize) -> bool {
        if index == 0 || index >= self.node_count || depth >= 64 { return true; }
        let node: AstNode = unsafe { *(self.nodes + index) };
        if node.kind == AstKind::ExprPath
            && self.find_enum(node.str_offset, self.find_match_path_separator(node)) != 0 { return true; }
        let mut sem: Sema = Sema::new();
        let declared: usize = sem.infer_expression_type_ref(self.nodes, self.node_count,
            index, self.source, self.source_len);
        if declared != 0 && declared < self.node_count {
            let reference: AstNode = unsafe { *(self.nodes + declared) };
            if self.find_enum(reference.str_offset, reference.str_len) != 0 { return true; }
        }
        let mut child: usize = node.first_child;
        while child != 0 {
            if child >= self.node_count || self.match_bound_has_enum(child, depth + 1) { return true; }
            child = unsafe { (*(self.nodes + child)).next_sibling };
        }
        return false;
    }

    pub fn match_range_bounds(mut self: &mut Self, pattern: usize, typ: TargetTypeTag,
        first: &mut u64, last: &mut u64) -> bool {
        if target_type_is_float(typ) { return self.match_float_bounds(pattern,typ,first,last); }
        let node: AstNode = unsafe { *(self.nodes + pattern) };
        if node.int_value < 0 || node.int_value > 6 { return self.reject_match(pattern,2); }
        let missing_start: bool = (node.int_value & 2) != 0;
        let missing_end: bool = (node.int_value & 4) != 0;
        let inclusive: bool = (node.int_value & 1) != 0;
        if missing_end && inclusive { return self.reject_match(pattern,2); }
        let mut child: usize = node.first_child;
        *first=native_match_order_key(0,typ);
        *last=self.integer_type_max(typ);
        if typ == TargetTypeTag::Usize { *last=18446744073709551615; }
        if !missing_start {
            if child == 0 || child >= self.node_count || self.match_bound_has_enum(child,0)
                || !self.constant_literal_bits(child,typ,first) { return self.reject_match(pattern,2); }
            child=unsafe{(*(self.nodes+child)).next_sibling};
        }
        if !missing_end {
            if child == 0 || child >= self.node_count || self.match_bound_has_enum(child,0)
                || !self.constant_literal_bits(child,typ,last) { return self.reject_match(pattern,2); }
            child=unsafe{(*(self.nodes+child)).next_sibling};
        }
        if child != 0 { return self.reject_match(pattern,2); }
        let low: u64 = native_match_order_key(unsafe { *first }, typ);
        let mut high: u64 = native_match_order_key(unsafe { *last }, typ);
        if low > high || (low == high && !inclusive && !missing_end) { return self.reject_match(pattern, 3); }
        if !inclusive && !missing_end { high = high - 1; }
        unsafe { *last = native_match_order_key(high, typ); }
        return true;
    }

    pub fn match_float_bounds(mut self: &mut Self, pattern: usize, typ: TargetTypeTag,
        first: &mut u64, last: &mut u64) -> bool {
        let node: AstNode = unsafe{*(self.nodes+pattern)};
        let mut sign: u64 = 9223372036854775808;let mut infinity: u64 = 9218868437227405312;
        if typ == TargetTypeTag::F32 { sign=2147483648;infinity=2139095040; }
        if node.kind != AstKind::PatternRange {
            let mut value: u64 = 0;
            if !self.constant_literal_bits(pattern,typ,&mut value) || native_match_float_nan(value,typ) { return self.reject_match(pattern,8); }
            unsafe{*first=value;*last=value;}
            if native_match_float_zero(value,typ) { unsafe{*first=sign;*last=0;} }
            return true;
        }
        if node.int_value < 0 || node.int_value > 6 { return self.reject_match(pattern,2); }
        let missing_start: bool = (node.int_value & 2) != 0;
        let missing_end: bool = (node.int_value & 4) != 0;
        let inclusive: bool = (node.int_value & 1) != 0;
        if missing_end && inclusive { return self.reject_match(pattern,2); }
        let mut low: u64 = sign | infinity;let mut high: u64 = infinity;
        let mut child: usize = node.first_child;
        if !missing_start {
            if child == 0 || child >= self.node_count || self.match_bound_has_enum(child,0)
                || !self.constant_literal_bits(child,typ,&mut low) { return self.reject_match(pattern,8); }
            child=unsafe{(*(self.nodes+child)).next_sibling};
        }
        if !missing_end {
            if child == 0 || child >= self.node_count || self.match_bound_has_enum(child,0)
                || !self.constant_literal_bits(child,typ,&mut high) { return self.reject_match(pattern,8); }
            child=unsafe{(*(self.nodes+child)).next_sibling};
        }
        if child != 0 || native_match_float_nan(low,typ) || native_match_float_nan(high,typ) { return self.reject_match(pattern,8); }
        if native_match_float_zero(low,typ) { low=sign; }
        if native_match_float_zero(high,typ) {
            high=0;
            if !inclusive && !missing_end { high=sign; }
        }
        let low_key: u64 = native_match_order_key(low,typ);
        let mut high_key: u64 = native_match_order_key(high,typ);
        if !inclusive && !missing_end {
            if high_key == 0 { return self.reject_match(pattern,3); }
            high_key=high_key-1;
        }
        if low_key > high_key { return self.reject_match(pattern,3); }
        unsafe{*first=low;*last=native_match_float_bits(high_key,typ);}
        return true;
    }

    pub fn append_match_compare(mut self: &mut Self, value: u32, typ: TargetTypeTag,
        bits: u64, predicate: u64, node: usize) -> u32 {
        let literal: u32 = self.append_value(typ, 0, 0);
        let mut opcode: TargetOpcode = TargetOpcode::ConstInt;
        if target_type_is_float(typ) { opcode=TargetOpcode::ConstFloat; }
        if literal == 0 || !self.append_instruction(opcode, literal, typ, 0, 0, node) { return 0; }
        unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = bits; }
        let first: u32 = self.operand_count as u32;
        let result: u32 = self.append_value(TargetTypeTag::Bool, 0, 0);
        if result == 0 || !self.append_operand(value) || !self.append_operand(literal)
            || !self.append_instruction(TargetOpcode::Compare, result, TargetTypeTag::Bool, first, 2, node) { return 0; }
        unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = predicate; }
        return result;
    }

    pub fn append_match_interval(mut self: &mut Self, value: u32, typ: TargetTypeTag,
        first_bits: u64, last_bits: u64, node: usize) -> u32 {
        if first_bits == last_bits { return self.append_match_compare(value, typ, first_bits, 86, node); }
        let lower: u32 = self.append_match_compare(value, typ, first_bits, 91, node);
        let upper: u32 = self.append_match_compare(value, typ, last_bits, 89, node);
        let first: u32 = self.operand_count as u32;
        let result: u32 = self.append_value(TargetTypeTag::Bool, 0, 0);
        if lower == 0 || upper == 0 || result == 0 || !self.append_operand(lower) || !self.append_operand(upper)
            || !self.append_instruction(TargetOpcode::BoolAnd, result, TargetTypeTag::Bool, first, 2, node) { return 0; }
        return result;
    }

    pub fn cfg_match_validity_guard(mut self: &mut Self, value: u32, typ: TargetTypeTag,
        patterns: *const u64, count: usize, node: usize) -> bool {
        if value == 0 || patterns == null || count == 0 || count > 64 { return false; }
        let valid: u32 = self.cfg_reserve_block();
        if valid == 0 { return false; }
        let mut i: usize = 0;
        while i < count {
            let next: u32 = self.cfg_reserve_block();
            let literal: u32 = self.append_value(typ, 0, 0);
            if next == 0 || literal == 0 || !self.append_instruction(TargetOpcode::ConstInt, literal, typ, 0, 0, node) { return false; }
            unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = *(patterns + i); }
            let first: u32 = self.operand_count as u32;
            let condition: u32 = self.append_value(TargetTypeTag::Bool, 0, 0);
            if condition == 0 || !self.append_operand(value) || !self.append_operand(literal)
                || !self.append_instruction(TargetOpcode::Compare, condition, TargetTypeTag::Bool, first, 2, node) { return false; }
            unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = 86; }
            let test: u32 = self.operand_count as u32;
            if !self.append_operand(condition) || !self.append_instruction(TargetOpcode::CondBranch, 0, TargetTypeTag::Bool, test, 1, node) { return false; }
            let branch: usize = self.instruction_count - 1;
            let targets: u32 = self.target_count as u32;
            if !self.append_target(valid) || !self.append_target(next) { return false; }
            unsafe { (*(self.instructions + branch)).first_target = targets; (*(self.instructions + branch)).target_count = 2; }
            if !self.cfg_finish() { return false; }
            self.cfg_begin(next); i = i + 1;
        }
        // Invalid representations use the existing checked-index trap. No
        // match arm or cleanup action executes after this failed domain guard.
        let invalid: u32 = self.cfg_current;
        let storage: u32 = self.append_value(TargetTypeTag::Pointer, 0, 0);
        if storage == 0 || !self.append_instruction(TargetOpcode::AllocStack, storage, TargetTypeTag::Pointer, 0, 0, node) { return false; }
        unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = 1; }
        let position: u32 = self.append_value(TargetTypeTag::U64, 0, 0);
        if position == 0 || !self.append_instruction(TargetOpcode::ConstInt, position, TargetTypeTag::U64, 0, 0, node) { return false; }
        unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = 1; }
        let first: u32 = self.operand_count as u32;
        let address: u32 = self.append_value(TargetTypeTag::Pointer, 0, 0);
        if address == 0 || !self.append_operand(storage) || !self.append_operand(position)
            || !self.append_instruction(TargetOpcode::IndexAddr, address, TargetTypeTag::Pointer, first, 2, node) { return false; }
        unsafe { (*(self.instructions + self.instruction_count - 1)).immediate_bits = 4294967297; }
        if !self.cfg_jump(invalid, node) { return false; }
        self.cfg_begin(valid);
        return true;
    }

    pub fn match_enum_id(self: &Self, index: usize, depth: usize) -> u32 {
        if index == 0 || index >= self.node_count || depth >= 64 { return 0; }
        let node: AstNode = unsafe{*(self.nodes+index)};
        let mut sem: Sema = Sema::new();
        if node.kind == AstKind::MatchValueBlock { return self.match_enum_id(sem.match_block_tail(self.nodes,self.node_count,index),depth+1); }
        if node.kind == AstKind::UnsafeExpr { return self.match_enum_id(node.first_child,depth+1); }
        if node.kind == AstKind::ExprMatch {
            if node.first_child == 0 || node.first_child >= self.node_count { return 0; }
            let mut arm: usize = unsafe{(*(self.nodes+node.first_child)).next_sibling};let mut result: u32 = 0;
            while arm != 0 {
                if arm >= self.node_count { return 0; }
                let pattern: usize = unsafe{(*(self.nodes+arm)).first_child};
                if pattern == 0 || pattern >= self.node_count { return 0; }
                let body: usize = unsafe{(*(self.nodes+pattern)).next_sibling};
                if body != 0 && body < self.node_count && unsafe{(*(self.nodes+body)).kind} == AstKind::MatchValueBlock
                    && sem.block_returns_value(self.nodes,self.node_count,body) {
                    arm=unsafe{(*(self.nodes+arm)).next_sibling};continue;
                }
                let kind: u32 = self.match_enum_id(body,depth+1);
                if kind == 0 || (result != 0 && kind != result) { return 0; }
                result=kind;arm=unsafe{(*(self.nodes+arm)).next_sibling};
            }
            return result;
        }
        if node.kind == AstKind::ExprPath { return self.find_enum(node.str_offset,self.find_match_path_separator(node)); }
        let reference: usize = sem.infer_expression_type_ref(self.nodes,self.node_count,index,self.source,self.source_len);
        if reference != 0 && reference < self.node_count {
            let typ: AstNode = unsafe{*(self.nodes+reference)};
            return self.find_enum(typ.str_offset,typ.str_len);
        }
        return 0;
    }

    pub fn match_context_type(self: &Self, index: usize, depth: usize) -> usize {
        if index == 0 || index >= self.node_count || depth >= 64 { return 0; }
        let parent: usize = unsafe{(*(self.nodes+index)).parent};
        if parent == 0 || parent >= self.node_count { return 0; }
        let node: AstNode = unsafe{*(self.nodes+parent)};
        let mut sem: Sema = Sema::new();
        if node.kind == AstKind::LetStmt { return sem.binding_type_ref(self.nodes,self.node_count,parent); }
        if node.kind == AstKind::UnsafeExpr || node.kind == AstKind::ExprConditional { return self.match_context_type(parent,depth+1); }
        if node.kind == AstKind::AssignStmt { return sem.infer_expression_type_ref(self.nodes,self.node_count,node.first_child,self.source,self.source_len); }
        if node.kind == AstKind::ReturnStmt {
            let mut ancestor: usize = parent;let mut steps: usize = 0;
            while ancestor != 0 && ancestor < self.node_count && steps < self.node_count {
                let outer: AstNode = unsafe{*(self.nodes+ancestor)};
                if outer.kind == AstKind::FnDecl || outer.kind == AstKind::TrapfnDecl {
                    let mut child: usize = outer.first_child;
                    while child != 0 && child < self.node_count {
                        let value: AstNode = unsafe{*(self.nodes+child)};
                        if value.kind == AstKind::TypeRef { return child; }
                        child=value.next_sibling;
                    }
                    return 0;
                }
                ancestor=outer.parent;steps=steps+1;
            }
        }
        if node.kind == AstKind::ExprCall {
            let function: usize = self.cfg_call_declaration(parent,0);
            if function == 0 || node.first_child == 0 || node.first_child >= self.node_count { return 0; }
            let mut argument: usize = unsafe{(*(self.nodes+node.first_child)).next_sibling};let mut ordinal: usize = 0;
            while argument != 0 && argument < self.node_count && argument != index { ordinal=ordinal+1;argument=unsafe{(*(self.nodes+argument)).next_sibling}; }
            if argument != index { return 0; }
            if unsafe{(*(self.nodes+node.first_child)).kind} == AstKind::ExprFieldAccess { ordinal=ordinal+1; }
            let mut parameter: usize = unsafe{(*(self.nodes+function)).first_child};
            while parameter != 0 && parameter < self.node_count {
                let value: AstNode = unsafe{*(self.nodes+parameter)};
                if value.kind == AstKind::ParamDecl { if ordinal == 0 { return value.first_child; }ordinal=ordinal-1; }
                parameter=value.next_sibling;
            }
        }
        return 0;
    }

    pub fn cfg_match_yield(mut self: &mut Self, expression: usize, first_parameter: usize, parameter_count: usize) -> bool {
        if self.match_yield_storage == 0 { return false; }
        if self.match_yield_record != 0 {
            if self.cfg_record_value_id(expression,0) != self.match_yield_record { return false; }
            let source: u32 = self.cfg_struct_address(expression,first_parameter,parameter_count,0);
            return source != 0 && self.cfg_copy_fields(self.match_yield_storage,source,self.match_yield_record,0,0,expression,0);
        }
        let value: u32 = self.lower_expression(expression,self.match_yield_type,first_parameter,parameter_count);
        return value != 0 && unsafe{(*(self.values+value as usize-1)).type_tag} == self.match_yield_type
            && self.cfg_store(self.match_yield_storage,value,self.match_yield_type,expression);
    }

    pub fn cfg_match_value_block(mut self: &mut Self, body: usize, storage: u32, typ: TargetTypeTag,
        record: u32, first_parameter: usize, parameter_count: usize, depth: usize) -> bool {
        let before_storage: u32 = self.match_yield_storage;
        let before_type: TargetTypeTag = self.match_yield_type;
        let before_record: u32 = self.match_yield_record;
        self.match_yield_storage=storage;self.match_yield_type=typ;self.match_yield_record=record;
        let mut function: usize = body;
        while function != 0 && function < self.node_count && unsafe{(*(self.nodes+function)).kind} != AstKind::FnDecl
            && unsafe{(*(self.nodes+function)).kind} != AstKind::TrapfnDecl {
            function=unsafe{(*(self.nodes+function)).parent};
        }
        let return_type: TargetTypeTag = self.function_return_type_from_ast(function);
        let scope: usize = self.local_count;
        let valid: bool = self.cfg_sequence(unsafe{(*(self.nodes+body)).first_child},return_type,
            first_parameter,parameter_count,0,0,depth+1);
        self.local_count=scope;
        self.match_yield_storage=before_storage;self.match_yield_type=before_type;self.match_yield_record=before_record;
        return valid;
    }

    pub fn cfg_match_value(mut self: &mut Self, index: usize, typ: TargetTypeTag,
        first_parameter: usize, parameter_count: usize) -> u32 {
        let record: u32 = self.match_record_id(index,0);
        let enum_id: u32 = self.match_enum_id(index,0);
        let context: usize = self.match_context_type(index,0);
        if context != 0 && context < self.node_count {
            let node: AstNode = unsafe{*(self.nodes+context)};
            let expected_enum: u32 = self.find_enum(node.str_offset,node.str_len);
            if (expected_enum != 0 || enum_id != 0) && expected_enum != enum_id { return 0; }
        }
        if typ == TargetTypeTag::Pointer && (record == 0 || !self.array_record_copyable(record,0)) { return 0; }
        if typ == TargetTypeTag::Invalid || typ == TargetTypeTag::Void
            || typ == TargetTypeTag::Aggregate || self.cfg_current == 0 { return 0; }
        let size: u32 = self.scalar_memory_size(typ);
        if size == 0 { return 0; }
        let mut storage: u32 = 0;
        if record != 0 { storage=self.allocate_struct(record,index); }
        else {
            storage=self.append_value(TargetTypeTag::Pointer,0,0);
            if storage == 0 || !self.append_instruction(TargetOpcode::AllocStack,storage,
                TargetTypeTag::Pointer,0,0,index) { return 0; }
            unsafe{(*(self.instructions+self.instruction_count-1)).immediate_bits=size as u64;}
        }
        if storage == 0 { return 0; }
        if !self.cfg_match_statement(index,typ,first_parameter,parameter_count,0,0,0,storage) { return 0; }
        if record != 0 { return storage; }
        let result: u32 = self.append_value(typ,0,0);
        let operand: u32 = self.operand_count as u32;
        if result == 0 || !self.append_operand(storage) || !self.append_instruction(TargetOpcode::Load,
            result,typ,operand,1,index) { return 0; }
        return result;
    }

    pub fn pattern_capture(self: &Self, index: usize) -> bool {
        if index == 0 || index >= self.node_count { return false; }
        let node: AstNode = unsafe{*(self.nodes+index)};let sem: Sema = Sema::new();
        return sem.match_pattern_binding(self.nodes,self.node_count,index,self.source,self.source_len)
            || (node.kind == AstKind::ExprIdent && sem.source_slice_equals(self.source,self.source_len,node.str_offset,node.str_len,"_",1));
    }

    pub fn payload_pattern_total(self: &Self, pattern: usize, depth: usize) -> bool {
        if pattern == 0 || pattern >= self.node_count || depth >= 32 { return false; }
        if self.pattern_capture(pattern) { return true; }
        let node: AstNode = unsafe{*(self.nodes+pattern)};
        if node.kind != AstKind::PatternVariant && node.kind != AstKind::PatternRecord { return false; }
        let mut child: usize = self.pattern_children(pattern);
        while child != 0 && child < self.node_count {
            let argument: usize = self.pattern_argument(child);
            if unsafe{(*(self.nodes+argument)).kind} == AstKind::PatternRecord {
                if !self.payload_pattern_total(argument,depth+1) { return false; }
            } else if !self.pattern_capture(argument) { return false; }
            child=unsafe{(*(self.nodes+child)).next_sibling};
        }
        return child == 0;
    }

    pub fn pattern_record(self: &Self, pattern: usize) -> u32 {
        let node: AstNode = unsafe{*(self.nodes+pattern)};
        if node.kind != AstKind::PatternRecord { return self.payload_record(pattern); }
        let record: u32 = self.find_struct(node.str_offset,node.str_len);
        let mut enumeration: usize = 0;
        while enumeration < self.enum_count {
            if self.enum_record_ids[enumeration] == record { return 0; }
            enumeration=enumeration+1;
        }
        return record;
    }

    pub fn pattern_children(self: &Self, pattern: usize) -> usize {
        let node: AstNode = unsafe{*(self.nodes+pattern)};
        if node.kind == AstKind::PatternRecord { return node.first_child; }
        if node.kind == AstKind::PatternVariant && node.first_child != 0 {
            return unsafe{(*(self.nodes+node.first_child)).next_sibling};
        }
        return 0;
    }

    pub fn pattern_argument(self: &Self, child: usize) -> usize {
        if unsafe{(*(self.nodes+child)).kind} == AstKind::PatternField { return unsafe{(*(self.nodes+child)).first_child}; }
        return child;
    }

    pub fn pattern_field(self: &Self, pattern: usize, child: usize, ordinal: usize) -> u32 {
        if unsafe{(*(self.nodes+pattern)).kind} == AstKind::PatternRecord {
            let field: AstNode = unsafe{*(self.nodes+child)};
            return self.find_field(self.pattern_record(pattern),field.str_offset,field.str_len);
        }
        let variant: u32 = self.payload_variant(pattern);
        if variant == 0 || ordinal >= self.variant_field_counts[variant as usize-1] as usize { return 0; }
        return self.variant_field_starts[variant as usize-1]+ordinal as u32+1;
    }

    pub fn payload_scalar_bounds(mut self: &mut Self, pattern: usize, field: usize, low: &mut u64, high: &mut u64) -> bool {
        let node: AstNode = unsafe{*(self.nodes+pattern)};
        let typ: TargetTypeTag = self.field_type_tags[field] as TargetTypeTag;
        let reference: usize = self.field_type_refs[field];let mut enumeration: u32 = 0;
        if reference != 0 && reference < self.node_count {
            let declared: AstNode = unsafe{*(self.nodes+reference)};
            enumeration=self.find_enum(declared.str_offset,declared.str_len);
        }
        if self.field_byte_counts[field] != 0 || typ == TargetTypeTag::Pointer || typ == TargetTypeTag::Aggregate { return false; }
        if target_type_is_float(typ) { return self.match_float_bounds(pattern,typ,low,high); }
        if node.kind == AstKind::PatternRange {
            if enumeration != 0 || typ == TargetTypeTag::Bool { return false; }
            return self.match_range_bounds(pattern,typ,low,high);
        }
        if node.kind != AstKind::ExprPath && node.kind != AstKind::ExprLiteral
            && node.kind != AstKind::ExprIdent && node.kind != AstKind::ExprUnary { return false; }
        if node.kind == AstKind::ExprPath {
            if enumeration == 0 || self.find_enum(node.str_offset,self.find_match_path_separator(node)) != enumeration { return false; }
            let variant: u32 = self.payload_variant(pattern);
            if variant == 0 || self.variant_field_counts[variant as usize-1] != 0 { return false; }
        } else if enumeration != 0 {
            let mut sem: Sema = Sema::new();
            let declared: usize = sem.infer_expression_type_ref(self.nodes,self.node_count,pattern,self.source,self.source_len);
            if declared == 0 || declared >= self.node_count { return false; }
            let reference_node: AstNode = unsafe{*(self.nodes+declared)};
            if self.find_enum(reference_node.str_offset,reference_node.str_len) != enumeration { return false; }
        }
        let mut bits: u64 = 0;
        if !self.constant_literal_bits(pattern,typ,&mut bits) { return false; }
        unsafe{*low=bits;*high=bits;}
        return true;
    }

    pub fn match_binding_subset(self: &Self, pattern: usize, other: usize, depth: usize) -> bool {
        if pattern == 0 || pattern >= self.node_count || depth >= 32 { return false; }
        let sem: Sema = Sema::new();let node: AstNode = unsafe{*(self.nodes+pattern)};
        if sem.match_pattern_binding(self.nodes,self.node_count,pattern,self.source,self.source_len) {
            let found: usize = sem.find_pattern_binding(self.nodes,self.node_count,other,node,self.source,self.source_len,0);
            if found == 0 { return false; }
            let left: usize = sem.payload_binding_type(self.nodes,self.node_count,pattern,self.source,self.source_len);
            let right: usize = sem.payload_binding_type(self.nodes,self.node_count,found,self.source,self.source_len);
            if left == 0 || right == 0 { return left == right; }
            let first: AstNode = unsafe{*(self.nodes+left)};let second: AstNode = unsafe{*(self.nodes+right)};
            if first.str_len != 0 && second.str_len != 0
                && unsafe{*(self.source+first.str_offset)} == 91
                && unsafe{*(self.source+second.str_offset)} == 91 {
                let first_element: TargetTypeTag = self.parse_array_element_type(first.str_offset,first.str_len);
                return first_element != TargetTypeTag::Invalid
                    && first_element == self.parse_array_element_type(second.str_offset,second.str_len)
                    && self.parse_array_element_count(first.str_offset,first.str_len) == self.parse_array_element_count(second.str_offset,second.str_len)
                    && self.parse_array_element_struct(first.str_offset,first.str_len) == self.parse_array_element_struct(second.str_offset,second.str_len);
            }
            return sem.source_slices_equal(self.source,self.source_len,first.str_offset,first.str_len,second.str_offset,second.str_len);
        }
        if node.kind != AstKind::PatternVariant && node.kind != AstKind::PatternRecord { return true; }
        let mut child: usize = self.pattern_children(pattern);
        while child != 0 && child < self.node_count {
            if !self.match_binding_subset(self.pattern_argument(child),other,depth+1) { return false; }
            child=unsafe{(*(self.nodes+child)).next_sibling};
        }
        return child == 0;
    }

    pub fn payload_pattern_valid(mut self: &mut Self, pattern: usize, variant: u32) -> bool {
        return self.payload_pattern_valid_at(pattern,variant,pattern,0);
    }

    pub fn payload_pattern_valid_at(mut self: &mut Self, pattern: usize, variant: u32, root: usize, depth: usize) -> bool {
        if depth >= 32 { return false; }
        let container: u32 = self.pattern_record(pattern);
        if container == 0 { return false; }
        let named: bool = unsafe{(*(self.nodes+pattern)).kind} == AstKind::PatternRecord;
        let mut expected: usize = self.struct_field_counts[container as usize-1] as usize;
        if !named {
            if variant == 0 { return false; }
            expected=self.variant_field_counts[variant as usize-1] as usize;
        }
        let mut seen: [u8;256] = 0;
        let mut child: usize = self.pattern_children(pattern);let mut count: usize = 0;
        let sem: Sema = Sema::new();
        while child != 0 && child < self.node_count {
            let binding: usize = self.pattern_argument(child);
            if binding == 0 || binding >= self.node_count { return false; }
            let node: AstNode = unsafe{*(self.nodes+binding)};
            let found: u32 = self.pattern_field(pattern,child,count);
            if count >= expected || found == 0 || found > 256 { return false; }
            let field: usize = found as usize-1;
            if seen[field] != 0 { return false; }seen[field]=1;
            if self.pattern_capture(binding) {
                if sem.match_pattern_binding(self.nodes,self.node_count,binding,self.source,self.source_len)
                    && sem.find_pattern_binding(self.nodes,self.node_count,root,node,self.source,self.source_len,0) != binding { return false; }
            } else if self.field_struct_ids[field] != 0 {
                let nested: u32 = self.payload_variant(binding);
                if self.field_byte_counts[field] != 0 || self.pattern_record(binding) != self.field_struct_ids[field] { return false; }
                if node.kind == AstKind::PatternVariant || node.kind == AstKind::PatternRecord {
                    if !self.payload_pattern_valid_at(binding,nested,root,depth+1) { return false; }
                } else if nested == 0 || node.kind != AstKind::ExprPath || self.variant_field_counts[nested as usize-1] != 0 { return false; }
            } else {
                let mut low: u64 = 0;let mut high: u64 = 0;
                if !self.payload_scalar_bounds(binding,field,&mut low,&mut high) { return false; }
            }
            child=unsafe{(*(self.nodes+child)).next_sibling};count=count+1;
        }
        if child != 0 { return false; }
        return count == expected || (named && unsafe{(*(self.nodes+pattern)).int_value} == 1);
    }

    pub fn cfg_payload_bindings(mut self: &mut Self, pattern: usize, address: u32) -> bool {
        return self.cfg_payload_bindings_at(pattern,address,0);
    }

    pub fn cfg_payload_bindings_at(mut self: &mut Self, pattern: usize, address: u32, depth: usize) -> bool {
        if depth >= 32 { return false; }
        let kind: AstKind = unsafe{(*(self.nodes+pattern)).kind};
        if kind != AstKind::PatternVariant && kind != AstKind::PatternRecord { return true; }
        let container: u32 = self.pattern_record(pattern);
        if container == 0 || address == 0 { return false; }
        let mut child: usize = self.pattern_children(pattern);let mut ordinal: usize = 0;
        let sem: Sema = Sema::new();
        while child != 0 && child < self.node_count {
            let binding: usize = self.pattern_argument(child);
            let node: AstNode = unsafe{*(self.nodes+binding)};
            let field: usize = self.pattern_field(pattern,child,ordinal) as usize-1;
            if node.kind == AstKind::PatternVariant || node.kind == AstKind::PatternRecord {
                let pointer: u32 = self.payload_address(address,self.field_offsets[field],binding);
                if !self.cfg_payload_bindings_at(binding,pointer,depth+1) { return false; }
            } else if sem.match_pattern_binding(self.nodes,self.node_count,binding,self.source,self.source_len) {
                if self.local_count >= 128 { return false; }
                let pointer: u32 = self.payload_address(address,self.field_offsets[field],binding);
                let record: u32 = self.field_struct_ids[field];let mut value: u32 = pointer;
                if self.field_byte_counts[field] != 0 {
                    let copy: u32 = self.allocate_struct(container,binding);
                    if copy == 0 || !self.cfg_copy_fields(copy,address,container,0,0,binding,0) { return false; }
                    value=self.payload_address(copy,self.field_offsets[field],binding);
                } else if record != 0 {
                    value=self.allocate_struct(record,binding);
                    if !self.cfg_copy_fields(value,pointer,record,0,0,binding,0) { return false; }
                } else {
                    let typ: TargetTypeTag = self.field_type_tags[field] as TargetTypeTag;
                    value=self.append_value(typ,0,0);let operand: u32 = self.operand_count as u32;
                    if pointer == 0 || value == 0 || !self.append_operand(pointer)
                        || !self.append_instruction(TargetOpcode::Load,value,typ,operand,1,binding) { return false; }
                }
                let slot: usize = self.local_count;
                self.local_name_offsets[slot]=node.str_offset;self.local_name_lens[slot]=node.str_len;
                self.local_value_ids[slot]=value;self.local_struct_ids[slot]=record;
                self.local_storage_types[slot]=0;self.local_array_counts[slot]=0;self.local_array_types[slot]=0;
                if self.field_byte_counts[field] != 0 {
                    self.local_array_counts[slot]=self.field_byte_counts[field];
                    self.local_array_types[slot]=self.field_array_types[field];
                    self.local_struct_ids[slot]=self.field_array_structs[field];
                }
                self.local_count=slot+1;
            }
            child=unsafe{(*(self.nodes+child)).next_sibling};ordinal=ordinal+1;
        }
        return child == 0;
    }

    pub fn cfg_pattern_branch(mut self: &mut Self, condition: u32, yes: u32, no: u32, node: usize) -> bool {
        let operand: u32 = self.operand_count as u32;let targets: u32 = self.target_count as u32;
        if condition == 0 || yes == 0 || no == 0 || !self.append_operand(condition)
            || !self.append_target(yes) || !self.append_target(no)
            || !self.append_instruction(TargetOpcode::CondBranch,0,TargetTypeTag::Bool,operand,1,node) { return false; }
        unsafe{(*(self.instructions+self.instruction_count-1)).first_target=targets;
            (*(self.instructions+self.instruction_count-1)).target_count=2;}
        return self.cfg_finish();
    }

    pub fn cfg_payload_load(mut self: &mut Self, pointer: u32, typ: TargetTypeTag, node: usize) -> u32 {
        let value: u32 = self.append_value(typ,0,0);let operand: u32 = self.operand_count as u32;
        if pointer == 0 || value == 0 || !self.append_operand(pointer)
            || !self.append_instruction(TargetOpcode::Load,value,typ,operand,1,node) { return 0; }
        return value;
    }

    pub fn cfg_payload_fields_test(mut self: &mut Self, pattern: usize, address: u32,
        yes: u32, no: u32, depth: usize) -> bool {
        if depth >= 32 { return false; }
        if self.pattern_record(pattern) == 0 { return false; }
        let mut child: usize = self.pattern_children(pattern);let mut ordinal: usize = 0;
        if child == 0 { return self.cfg_jump(yes,pattern); }
        while child != 0 && child < self.node_count {
            let argument: usize = self.pattern_argument(child);
            let node: AstNode = unsafe{*(self.nodes+child)};
            let kind: AstKind = unsafe{(*(self.nodes+argument)).kind};
            let field: usize = self.pattern_field(pattern,child,ordinal) as usize-1;
            let mut next: u32 = yes;
            if node.next_sibling != 0 { next=self.cfg_reserve_block(); }
            if next == 0 { return false; }
            if self.pattern_capture(argument) {
                if !self.cfg_jump(next,child) { return false; }
            } else {
                let pointer: u32 = self.payload_address(address,self.field_offsets[field],child);
                let record: u32 = self.field_struct_ids[field];
                if kind == AstKind::PatternRecord {
                    if !self.cfg_payload_fields_test(argument,pointer,next,no,depth+1) { return false; }
                } else if record != 0 {
                    let nested: u32 = self.payload_variant(argument);
                    let tag: u32 = self.cfg_payload_load(pointer,TargetTypeTag::U32,child);
                    let condition: u32 = self.append_match_interval(tag,TargetTypeTag::U32,
                        self.variant_values[nested as usize-1],self.variant_values[nested as usize-1],child);
                    if kind == AstKind::PatternVariant {
                        let matched: u32 = self.cfg_reserve_block();
                        if !self.cfg_pattern_branch(condition,matched,no,child) { return false; }
                        self.cfg_begin(matched);
                        if !self.cfg_payload_fields_test(argument,pointer,next,no,depth+1) { return false; }
                    } else if !self.cfg_pattern_branch(condition,next,no,child) { return false; }
                } else {
                    let typ: TargetTypeTag = self.field_type_tags[field] as TargetTypeTag;
                    let value: u32 = self.cfg_payload_load(pointer,typ,child);
                    let mut low: u64 = 0;let mut high: u64 = 0;
                    if !self.payload_scalar_bounds(argument,field,&mut low,&mut high) { return false; }
                    let condition: u32 = self.append_match_interval(value,typ,low,high,argument);
                    if !self.cfg_pattern_branch(condition,next,no,child) { return false; }
                }
            }
            if node.next_sibling != 0 { self.cfg_begin(next); }
            child=node.next_sibling;ordinal=ordinal+1;
        }
        return child == 0;
    }

    pub fn cfg_match_trap(mut self: &mut Self, node: usize) -> bool {
        let block: u32 = self.cfg_current;
        let storage: u32 = self.append_value(TargetTypeTag::Pointer,0,0);
        if block == 0 || storage == 0 || !self.append_instruction(TargetOpcode::AllocStack,
            storage,TargetTypeTag::Pointer,0,0,node) { return false; }
        unsafe{(*(self.instructions+self.instruction_count-1)).immediate_bits=1;}
        let position: u32 = self.append_value(TargetTypeTag::U64,0,0);
        if position == 0 || !self.append_instruction(TargetOpcode::ConstInt,position,TargetTypeTag::U64,0,0,node) { return false; }
        unsafe{(*(self.instructions+self.instruction_count-1)).immediate_bits=1;}
        let operand: u32 = self.operand_count as u32;
        let address: u32 = self.append_value(TargetTypeTag::Pointer,0,0);
        if address == 0 || !self.append_operand(storage) || !self.append_operand(position)
            || !self.append_instruction(TargetOpcode::IndexAddr,address,TargetTypeTag::Pointer,operand,2,node) { return false; }
        unsafe{(*(self.instructions+self.instruction_count-1)).immediate_bits=4294967297;}
        return self.cfg_jump(block,node);
    }

    pub fn coverage_enum(self: &Self, variant: u32) -> u32 {
        if variant == 0 || variant as usize > self.variant_total_count { return 0; }
        let parent: usize = unsafe{(*(self.nodes+self.variant_nodes[variant as usize-1])).parent};
        if parent == 0 || parent >= self.node_count { return 0; }
        let declaration: AstNode = unsafe{*(self.nodes+parent)};
        return self.find_enum(declaration.str_offset,declaration.str_len);
    }

    // Probe result: 0 contradicts the current cell, 1 covers it, 2 exposes
    // an unassigned axis (or the requested interval in boundary lookup mode).
    pub fn coverage_constraint(self: &Self, state: &mut NativeMatchCoverage,
        key: u32, typ: TargetTypeTag, enumeration: u32, low: u64, high: u64,
        wanted: u32, lookup: bool) -> u32 {
        unsafe {
            if key >= 4096 { return 0; }
            let slot: usize = key as usize;
            if lookup && key == wanted {
                state.found_low=low;state.found_high=high;return 2;
            }
            if (*(state.assigned+slot)) != 0 {
                if low <= (*(state.low+slot)) && (*(state.high+slot)) <= high { return 1; }
                return 0;
            }
            if lookup { return 1; }
            state.found_key=key;state.found_type=typ;state.found_enum=enumeration;
            return 2;
        }
    }

    pub fn coverage_pattern(mut self: &mut Self, pattern: usize, offset: u32,
        state: &mut NativeMatchCoverage, wanted: u32, lookup: bool, depth: usize) -> u32 {
        if pattern == 0 || pattern >= self.node_count || depth >= 32 { return 0; }
        if self.pattern_capture(pattern) { return 1; }
        let node: AstNode = unsafe{*(self.nodes+pattern)};
        if node.kind != AstKind::PatternRecord {
            let variant: u32 = self.payload_variant(pattern);
            if variant == 0 { return 0; }
            let tag: u64 = self.variant_values[variant as usize-1];
            let tagged: u32 = self.coverage_constraint(state,offset,TargetTypeTag::U32,
                self.coverage_enum(variant),tag,tag,wanted,lookup);
            if tagged != 1 { return tagged; }
        }
        if node.kind == AstKind::ExprPath { return 1; }
        if node.kind != AstKind::PatternVariant && node.kind != AstKind::PatternRecord { return 0; }
        let mut child: usize = self.pattern_children(pattern);let mut ordinal: usize = 0;
        while child != 0 && child < self.node_count {
            let argument: usize = self.pattern_argument(child);
            let field: usize = self.pattern_field(pattern,child,ordinal) as usize-1;
            if !self.pattern_capture(argument) {
                let key: u32 = offset+self.field_offsets[field];
                let mut result: u32 = 0;
                if self.field_struct_ids[field] != 0 {
                    result=self.coverage_pattern(argument,key,state,wanted,lookup,depth+1);
                } else {
                    let typ: TargetTypeTag = self.field_type_tags[field] as TargetTypeTag;
                    let reference: usize = self.field_type_refs[field];let mut enumeration: u32 = 0;
                    if reference != 0 && reference < self.node_count {
                        let declared: AstNode = unsafe{*(self.nodes+reference)};
                        enumeration=self.find_enum(declared.str_offset,declared.str_len);
                    }
                    let mut low: u64 = 0;let mut high: u64 = 0;
                    if !self.payload_scalar_bounds(argument,field,&mut low,&mut high) { return 0; }
                    result=self.coverage_constraint(state,key,typ,enumeration,
                        native_match_order_key(low,typ),native_match_order_key(high,typ),wanted,lookup);
                }
                if result != 1 { return result; }
            }
            child=unsafe{(*(self.nodes+child)).next_sibling};ordinal=ordinal+1;
        }
        return 1;
    }

    pub fn coverage_cell(mut self: &mut Self, rows: *const usize, count: usize,
        state: &mut NativeMatchCoverage, frame: usize, first: bool) -> bool {
        unsafe {
            let key: u32 = (*(state.keys+frame));let slot: usize = key as usize;
            let enumeration: u32 = (*(state.enums+frame));
            let typ: TargetTypeTag = (*(state.types+frame)) as TargetTypeTag;
            (*(state.assigned+slot))=0;
            if enumeration != 0 {
                let mut ordinal: u32 = 0;
                if !first { ordinal=(*(state.ordinals+frame))+1; }
                if ordinal >= self.enum_variant_counts[enumeration as usize-1] { return false; }
                let variant: usize = self.enum_variant_starts[enumeration as usize-1] as usize+ordinal as usize;
                let value: u64 = native_match_order_key(self.variant_values[variant],typ);
                (*(state.low+slot))=value;(*(state.high+slot))=value;(*(state.ordinals+frame))=ordinal;
            } else {
                let mut maximum: u64 = 18446744073709551615;
                let mut width: u32 = target_integer_width(typ);
                if typ == TargetTypeTag::F32 { width=32; }
                else if typ == TargetTypeTag::F64 { width=64; }
                if typ == TargetTypeTag::Bool { maximum=1; }
                else if width == 0 { return false; }
                else if width < 64 { maximum=((1 as u64) << width as u64)-1; }
                let mut start: u64 = 0;
                if !first {
                    if (*(state.high+slot)) == maximum { return false; }
                    start=(*(state.high+slot))+1;
                }
                let mut end: u64 = maximum;let mut row: usize = 0;
                while row < count {
                    if ((*(state.masks+frame)) & ((1 as u64) << row as u64)) != 0 {
                        let result: u32 = self.coverage_pattern(unsafe{*(rows+row)},0,state,key,true,0);
                        if result == 2 {
                            let low: u64 = state.found_low;let high: u64 = state.found_high;
                            if low > start && low-1 < end { end=low-1; }
                            if high >= start && high < end { end=high; }
                        }
                    }
                    row=row+1;
                }
                (*(state.low+slot))=start;(*(state.high+slot))=end;
            }
            (*(state.assigned+slot))=1;
            return true;
        }
    }

    pub fn payload_coverage(mut self: &mut Self, first_arm: usize) -> bool {
        unsafe {
            let mut rows: [usize;64] = 0;let mut count: usize = 0;let mut arm: usize = first_arm;
            while arm != 0 && arm < self.node_count && count < 64 {
                let pattern: usize = unsafe{(*(self.nodes+arm)).first_child};
                let body: usize = unsafe{(*(self.nodes+pattern)).next_sibling};
                if unsafe{(*(self.nodes+body)).next_sibling} == 0 { rows[count]=pattern;count=count+1; }
                arm=unsafe{(*(self.nodes+arm)).next_sibling};
            }
            if count == 0 || arm != 0 { return false; }
            let mut state: NativeMatchCoverage = NativeMatchCoverage::new();
            let mut proof_assigned: [u8;4096] = 0;
            state.assigned=unsafe{proof_assigned as *mut u8};
            let mut proof_low: [u64;4096] = 0;
            state.low=unsafe{proof_low as *mut u64};
            let mut proof_high: [u64;4096] = 0;
            state.high=unsafe{proof_high as *mut u64};
            let mut proof_keys: [u32;4096] = 0;
            state.keys=unsafe{proof_keys as *mut u32};
            let mut proof_types: [u32;4096] = 0;
            state.types=unsafe{proof_types as *mut u32};
            let mut proof_enums: [u32;4096] = 0;
            state.enums=unsafe{proof_enums as *mut u32};
            let mut proof_ordinals: [u32;4096] = 0;
            state.ordinals=unsafe{proof_ordinals as *mut u32};
            let mut proof_masks: [u64;4096] = 0;
            state.masks=unsafe{proof_masks as *mut u64};

            let mut mask: u64 = 18446744073709551615;
            if count < 64 { mask=((1 as u64) << count as u64)-1; }
            let mut depth: usize = 0;
            // Stage 1 C11 emission supports while, but not the bare loop form.
            // Keep the native proof compatible with both bootstrap paths.
            while true {
                let mut covered: bool = false;let mut possible: u64 = 0;let mut row: usize = 0;
                let mut key: u32 = 0;let mut typ: TargetTypeTag = TargetTypeTag::Invalid;let mut enumeration: u32 = 0;
                while row < count {
                    let bit: u64 = (1 as u64) << row as u64;
                    if (mask & bit) != 0 {
                        let result: u32 = self.coverage_pattern(rows[row],0,&mut state,0,false,0);
                        if result == 1 { covered=true;break; }
                        if result == 2 {
                            if possible == 0 { key=state.found_key;typ=state.found_type;enumeration=state.found_enum; }
                            possible=possible | bit;
                        }
                    }
                    row=row+1;
                }
                if !covered {
                    if possible == 0 || depth >= 4096 { return false; }
                    (*(state.keys+depth))=key;(*(state.types+depth))=typ as u32;(*(state.enums+depth))=enumeration;(*(state.masks+depth))=possible;
                    if self.coverage_cell(unsafe{rows as *const usize},count,&mut state,depth,true) {
                        mask=possible;depth=depth+1;continue;
                    }
                }
                let mut advanced: bool = false;
                while depth > 0 {
                    let frame: usize = depth-1;
                    if self.coverage_cell(unsafe{rows as *const usize},count,&mut state,frame,false) {
                        mask=(*(state.masks+frame));advanced=true;break;
                    }
                    depth=frame;
                }
                if !advanced { return true; }
            }
            return false;
        }
    }

    pub fn match_float_literal(self: &Self, index: usize, depth: usize) -> bool {
        if index == 0 || index >= self.node_count || depth >= 32 { return false; }
        let node: AstNode = unsafe{*(self.nodes+index)};
        if node.kind == AstKind::ExprUnary && (node.int_value == 80 || node.int_value == 81) {
            return self.match_float_literal(node.first_child,depth+1);
        }
        if node.kind != AstKind::ExprLiteral { return false; }
        if node.str_len == 0 || node.str_offset > self.source_len
            || node.str_len > self.source_len-node.str_offset { return false; }
        let initial: u8 = unsafe{*(self.source+node.str_offset)};
        if initial < 48 || initial > 57 { return false; }
        if node.str_len >= 2 && unsafe{*(self.source+node.str_offset)} == 48 {
            let prefix: u8 = unsafe{*(self.source+node.str_offset+1)};
            if prefix == 120 || prefix == 88 || prefix == 98 || prefix == 66 || prefix == 111 || prefix == 79 { return false; }
        }
        let mut i: usize = 0;
        while i < node.str_len {
            let byte: u8 = unsafe{*(self.source+node.str_offset+i)};
            if byte == 46 || byte == 101 || byte == 69 { return true; }
            i=i+1;
        }
        return false;
    }

    pub fn cfg_match_statement(mut self: &mut Self, index: usize, return_type: TargetTypeTag,
        first_parameter: usize, parameter_count: usize, break_id: u32, continue_id: u32, depth: usize,
        result_storage: u32) -> bool {
        if index == 0 || index >= self.node_count || depth >= 64 { return self.reject(index); }
        let subject: usize = unsafe { (*(self.nodes + index)).first_child };
        let mut sem: Sema = Sema::new();
        let mut typ: TargetTypeTag = self.condition_expression_type(subject, first_parameter, parameter_count);
        if subject == 0 || subject >= self.node_count { return self.reject(index); }
        let subject_node: AstNode = unsafe { *(self.nodes + subject) };
        if typ == TargetTypeTag::Invalid && self.match_float_literal(subject,0) { typ=TargetTypeTag::F64; }
        if typ == TargetTypeTag::Invalid && subject_node.kind == AstKind::ExprLiteral {
            if sem.source_slice_equals(self.source, self.source_len, subject_node.str_offset, subject_node.str_len, "true", 4)
                || sem.source_slice_equals(self.source, self.source_len, subject_node.str_offset, subject_node.str_len, "false", 5) { typ = TargetTypeTag::Bool; }
            else { typ = TargetTypeTag::U32; }
        }
        if typ == TargetTypeTag::Invalid && subject_node.kind == AstKind::ExprUnary
            && subject_node.int_value == 81 { typ = TargetTypeTag::I64; }
        let subject_enum: u32 = self.match_enum_id(subject,0);
        let mut payload_record: u32 = 0;
        if subject_enum != 0 { payload_record=self.enum_record_ids[subject_enum as usize-1]; }
        let mut record_subject: bool = false;
        if payload_record == 0 && subject_enum == 0 {
            let record: u32 = self.cfg_record_value_id(subject,0);
            if record != 0 {
                if self.struct_sizes[record as usize-1] > 4096 || !self.array_record_copyable(record,0) { return self.reject(subject); }
                payload_record=record;record_subject=true;
            }
        }
        if payload_record != 0 { typ=TargetTypeTag::U32; }
        if typ != TargetTypeTag::Bool && typ != TargetTypeTag::U8 && typ != TargetTypeTag::U16
            && typ != TargetTypeTag::U32 && typ != TargetTypeTag::U64 && typ != TargetTypeTag::Usize
            && typ != TargetTypeTag::I8 && typ != TargetTypeTag::I16 && typ != TargetTypeTag::I32
            && typ != TargetTypeTag::I64 && !target_type_is_float(typ) { return self.reject(subject); }
        let subject_ref: usize = sem.infer_expression_type_ref(self.nodes, self.node_count, subject, self.source, self.source_len);
        let mut enum_id: u32 = subject_enum;
        if subject_ref != 0 && subject_ref < self.node_count {
            let declared: AstNode = unsafe { *(self.nodes + subject_ref) };
            enum_id = self.find_enum(declared.str_offset, declared.str_len);
        }
        if enum_id == 0 && subject_node.kind == AstKind::ExprPath {
            enum_id = self.find_enum(subject_node.str_offset, self.find_match_path_separator(subject_node));
        }
        let mut patterns: [u64;64] = 0;
        let mut ends: [u64;64] = 0;
        let mut guarded: [u8;64] = 0;
        let mut wildcards: [u8;64] = 0;
        let mut bindings: [u8;64] = 0;
        let mut refutable: [u8;64] = 0;
        let mut groups: [usize;64] = 0;
        let mut group_pattern: usize = 0;
        let mut current_group: usize = 0;
        let mut proof_patterns: [u64;64] = 0;
        let mut proof_ends: [u64;64] = 0;
        let mut proof_count: usize = 0;
        let mut arm: usize = unsafe { (*(self.nodes + subject)).next_sibling };
        let first_arm: usize = arm;
        let mut count: usize = 0; let mut wildcard: bool = false;
        while arm != 0 {
            if arm >= self.node_count || count >= 64 { return self.reject(index); }
            let arm_node: AstNode = unsafe { *(self.nodes + arm) };
            let pattern: usize = arm_node.first_child;
            if arm_node.kind != AstKind::MatchArm || pattern == 0 || pattern >= self.node_count { return self.reject(arm); }
            let node: AstNode = unsafe { *(self.nodes + pattern) };
            let mut source_after: usize = arm_node.next_sibling;
            let mut remaining: usize = arm_node.str_len;
            while remaining > 1 {
                if source_after == 0 || source_after >= self.node_count { return self.reject(arm); }
                source_after=unsafe{(*(self.nodes+source_after)).next_sibling};remaining=remaining-1;
            }
            groups[count]=arm_node.str_offset;
            if arm_node.str_offset != 0 {
                if current_group != arm_node.str_offset { current_group=arm_node.str_offset;group_pattern=pattern; }
                else if !self.match_binding_subset(pattern,group_pattern,0)
                    || !self.match_binding_subset(group_pattern,pattern,0) { return self.reject(pattern); }
            }
            let body: usize = node.next_sibling;
            if body == 0 || body >= self.node_count || (result_storage == 0
                && unsafe { (*(self.nodes + body)).kind } != AstKind::Block) {
                return self.reject(arm);
            }
            if result_storage != 0 && unsafe{(*(self.nodes+body)).kind} == AstKind::MatchValueBlock
                && sem.match_block_tail(self.nodes,self.node_count,body) == 0
                && !sem.block_returns_value(self.nodes,self.node_count,body) { return self.reject(body); }
            if result_storage != 0 && !(unsafe{(*(self.nodes+body)).kind} == AstKind::MatchValueBlock
                && sem.block_returns_value(self.nodes,self.node_count,body)) {
                if self.match_enum_id(body,0) != self.match_enum_id(index,0) { return self.reject(body); }
            }
            let guard: usize = unsafe { (*(self.nodes + body)).next_sibling };
            if guard != 0 {
                if guard >= self.node_count || unsafe { (*(self.nodes + guard)).next_sibling } != 0
                    || arm_node.int_value != 1 { return self.reject(arm); }
                if source_after == 0 { return self.reject_match(guard, 7); }
                guarded[count] = 1;
            } else if arm_node.int_value != 0 { return self.reject(arm); }
            if node.kind == AstKind::PatternRecord {
                if payload_record == 0 || self.pattern_record(pattern) != payload_record
                    || !self.payload_pattern_valid(pattern,0) { return self.reject(pattern); }
                patterns[count]=0;ends[count]=0;
                if !self.payload_pattern_total(pattern,0) { refutable[count]=1; }
            } else if node.kind == AstKind::PatternVariant {
                if record_subject { return self.reject(pattern); }
                let variant: u32 = self.payload_variant(pattern);
                if payload_record == 0 || variant == 0 || self.payload_record(pattern) != payload_record
                    || !self.payload_pattern_valid(pattern,variant) { return self.reject(pattern); }
                patterns[count]=self.variant_values[variant as usize-1];ends[count]=patterns[count];
                if !self.payload_pattern_total(pattern,0) { refutable[count]=1; }
            } else if node.kind == AstKind::PatternRange {
                if typ == TargetTypeTag::Bool || enum_id != 0 { return self.reject_match(pattern, 1); }
                let mut low: u64 = 0; let mut high: u64 = 0;
                if !self.match_range_bounds(pattern, typ, &mut low, &mut high) { return false; }
                patterns[count] = low; ends[count] = high;
            } else if (node.kind == AstKind::ExprIdent && node.str_len == 1
                && unsafe { *(self.source + node.str_offset) } == 95)
                || sem.match_pattern_binding(self.nodes,self.node_count,pattern,self.source,self.source_len) {
                if guard == 0 && source_after != 0 { return self.reject(pattern); }
                wildcards[count] = 1;
                if sem.match_pattern_binding(self.nodes,self.node_count,pattern,self.source,self.source_len) { bindings[count]=1; }
                if guard == 0 { wildcard = true; }
            } else {
                if node.kind != AstKind::ExprLiteral && node.kind != AstKind::ExprIdent
                    && node.kind != AstKind::ExprUnary && node.kind != AstKind::ExprPath { return self.reject(pattern); }
                if enum_id != 0 {
                    let mut pattern_enum: u32 = 0;
                    if node.kind == AstKind::ExprPath {
                        pattern_enum = self.find_enum(node.str_offset, self.find_match_path_separator(node));
                    } else if node.kind == AstKind::ExprIdent {
                        let declared: usize = sem.infer_expression_type_ref(self.nodes, self.node_count, pattern, self.source, self.source_len);
                        if declared != 0 && declared < self.node_count {
                            let reference: AstNode = unsafe { *(self.nodes + declared) };
                            pattern_enum = self.find_enum(reference.str_offset, reference.str_len);
                        }
                    }
                    if pattern_enum != enum_id { return self.reject(pattern); }
                } else if node.kind == AstKind::ExprPath { return self.reject(pattern); }
                else if node.kind == AstKind::ExprIdent {
                    let declared: usize = sem.infer_expression_type_ref(self.nodes, self.node_count, pattern, self.source, self.source_len);
                    if declared != 0 && declared < self.node_count {
                        let reference: AstNode = unsafe { *(self.nodes + declared) };
                        if self.find_enum(reference.str_offset, reference.str_len) != 0 { return self.reject(pattern); }
                    }
                }
                let mut bits: u64 = 0;
                if payload_record != 0 && node.kind == AstKind::ExprPath {
                    if record_subject { return self.reject(pattern); }
                    let variant: u32 = self.payload_variant(pattern);
                    if variant == 0 || self.variant_field_counts[variant as usize-1] != 0 { return self.reject(pattern); }
                    bits=self.variant_values[variant as usize-1];
                } else {
                    if record_subject { return self.reject(pattern); }
                    if !target_type_is_float(typ) && !self.constant_literal_bits(pattern, typ, &mut bits) { return self.reject(pattern); }
                }
                patterns[count] = bits;
                ends[count] = bits;
                if target_type_is_float(typ) {
                    let mut last: u64 = bits;
                    if !self.match_float_bounds(pattern,typ,&mut bits,&mut last) { return self.reject(pattern); }
                    patterns[count]=bits;ends[count]=last;
                }
            }
            if wildcards[count] == 0 {
                let low: u64 = native_match_order_key(patterns[count], typ);
                let high: u64 = native_match_order_key(ends[count], typ);
                let mut prior: usize = 0;
                while prior < count {
                    if guarded[prior] == 0 && refutable[prior] == 0 && wildcards[prior] == 0
                        && (groups[count] == 0 || groups[prior] != groups[count])
                        && low <= native_match_order_key(ends[prior], typ)
                        && native_match_order_key(patterns[prior], typ) <= high {
                        return self.reject_match(pattern, 4);
                    }
                    prior = prior + 1;
                }
                if guard == 0 && refutable[count] == 0 {
                    proof_patterns[proof_count] = patterns[count];
                    proof_ends[proof_count] = ends[count];
                    proof_count = proof_count + 1;
                }
            }
            count = count + 1; arm = arm_node.next_sibling;
        }
        if count == 0 { return self.reject(index); }
        if !wildcard {
            let mut covered: bool = false;
            if payload_record != 0 {
                covered=self.payload_coverage(first_arm);
                if covered && enum_id != 0 {
                    proof_count=self.enum_variant_counts[enum_id as usize-1] as usize;
                    if proof_count > 64 { return self.reject(index); }
                    let start: usize = self.enum_variant_starts[enum_id as usize-1] as usize;
                    let mut variant: usize = 0;
                    while variant < proof_count { proof_patterns[variant]=self.variant_values[start+variant];variant=variant+1; }
                }
            } else if typ == TargetTypeTag::Bool || enum_id != 0 {
                covered = self.match_coverage_complete(typ, enum_id, unsafe { proof_patterns as *const u64 }, proof_count);
            } else if !target_type_is_float(typ) {
                covered = self.match_integer_coverage(typ, unsafe { proof_patterns as *const u64 },
                    unsafe { proof_ends as *const u64 }, proof_count);
            }
            if !covered { return self.reject_match(index, 5); }
        }
        // Keep the subject SSA value live across the decision chain; evaluate it once.
        let mut value: u32 = 0;let mut subject_address: u32 = 0;
        if payload_record != 0 {
            if self.cfg_record_value_id(subject,0) != payload_record { return self.reject(subject); }
            let original: u32 = self.cfg_struct_address(subject,first_parameter,parameter_count,0);
            subject_address=self.allocate_struct(payload_record,subject);
            if original == 0 || subject_address == 0
                || !self.cfg_copy_fields(subject_address,original,payload_record,0,0,subject,0) { return self.reject(subject); }
            value=self.append_value(TargetTypeTag::U32,0,0);
            if record_subject {
                if value == 0 || !self.append_instruction(TargetOpcode::ConstInt,value,TargetTypeTag::U32,0,0,subject) { return self.reject(subject); }
            } else {
                let operand: u32 = self.operand_count as u32;
                if subject_address == 0 || value == 0 || !self.append_operand(subject_address)
                    || !self.append_instruction(TargetOpcode::Load,value,TargetTypeTag::U32,operand,1,subject) { return self.reject(subject); }
            }
        } else { value=self.lower_expression(subject,typ,first_parameter,parameter_count); }
        if value == 0 { return self.reject(subject); }
        if !wildcard && (typ == TargetTypeTag::Bool || enum_id != 0)
            && !self.cfg_match_validity_guard(value, typ, unsafe { proof_patterns as *const u64 }, proof_count, subject) { return self.reject(subject); }
        let join: u32 = self.cfg_reserve_block();
        if join == 0 { return self.reject(subject); }
        let scope: usize = self.local_count;
        let mut guard_skips: [u32;64] = 0;
        let mut group_skip: u32 = 0;current_group=0;
        arm=first_arm;let mut skip_ordinal: usize = 0;
        while arm != 0 {
            let item: AstNode = unsafe{*(self.nodes+arm)};
            if item.str_offset != 0 && guarded[skip_ordinal] != 0 {
                if current_group != item.str_offset {
                    current_group=item.str_offset;group_skip=self.cfg_reserve_block();
                    if group_skip == 0 { return self.reject(arm); }
                }
                guard_skips[skip_ordinal]=group_skip;
            }
            skip_ordinal=skip_ordinal+1;arm=item.next_sibling;
        }
        let mut any_open: bool = false; let mut first_body: u32 = 0;
        arm = first_arm; let mut ordinal: usize = 0;
        while arm != 0 {
            let arm_node: AstNode = unsafe { *(self.nodes + arm) };
            let pattern: usize = arm_node.first_child;
            let body: usize = unsafe { (*(self.nodes + pattern)).next_sibling };
            let guard: usize = unsafe { (*(self.nodes + body)).next_sibling };
            if bindings[ordinal] != 0 {
                if self.local_count >= 128 { return self.reject(pattern); }
                let binding: AstNode = unsafe{*(self.nodes+pattern)};
                let slot: usize = self.local_count;
                self.local_name_offsets[slot]=binding.str_offset;self.local_name_lens[slot]=binding.str_len;
                self.local_value_ids[slot]=value;self.local_storage_types[slot]=0;
                self.local_struct_ids[slot]=payload_record;self.local_array_counts[slot]=0;self.local_array_types[slot]=0;
                if payload_record != 0 { self.local_value_ids[slot]=subject_address; }
                self.local_count=self.local_count+1;
            }
            let selected: u32 = self.cfg_reserve_block();
            if selected == 0 { return self.reject(arm); }
            if first_body == 0 { first_body = selected; }
            let mut next: u32 = 0;
            if arm_node.next_sibling == 0 && refutable[ordinal] == 0 {
                if !self.cfg_jump(selected, arm) { return self.reject(arm); }
            } else {
                if arm_node.str_len == 1 && guard_skips[ordinal] != 0 { next=guard_skips[ordinal]; }
                else { next = self.cfg_reserve_block(); }
                let mut matched: u32 = selected;
                if guard != 0 || refutable[ordinal] != 0 { matched = self.cfg_reserve_block(); }
                if next == 0 || matched == 0 { return self.reject(arm); }
                if wildcards[ordinal] != 0 {
                    if !self.cfg_jump(matched, arm) { return self.reject(arm); }
                } else {
                    let condition: u32 = self.append_match_interval(value, typ, patterns[ordinal], ends[ordinal], pattern);
                    let operand: u32 = self.operand_count as u32;
                    let targets: u32 = self.target_count as u32;
                    if condition == 0 || !self.append_operand(condition)
                        || !self.append_target(matched) || !self.append_target(next)
                        || !self.append_instruction(TargetOpcode::CondBranch, 0, TargetTypeTag::Bool, operand, 1, pattern) {
                        return self.reject(arm);
                    }
                    unsafe {
                        (*(self.instructions + self.instruction_count - 1)).first_target = targets;
                        (*(self.instructions + self.instruction_count - 1)).target_count = 2;
                    }
                    if !self.cfg_finish() { return self.reject(arm); }
                }
                if guard != 0 || refutable[ordinal] != 0 {
                    self.cfg_begin(matched);
                    if refutable[ordinal] != 0 {
                        let eligible: u32 = self.cfg_reserve_block();
                        if eligible == 0 || !self.cfg_payload_fields_test(pattern,subject_address,eligible,next,0) { return self.reject(pattern); }
                        self.cfg_begin(eligible);
                    }
                    if !self.cfg_payload_bindings(pattern,subject_address) { return self.reject(pattern); }
                    if guard == 0 {
                        if !self.cfg_jump(selected,arm) { return self.reject(arm); }
                    } else {
                        let mut guard_miss: u32 = next;
                        if guard_skips[ordinal] != 0 { guard_miss=guard_skips[ordinal]; }
                        if !self.cfg_test(guard,selected,guard_miss,first_parameter,parameter_count,depth+1) {
                            return self.reject_match(guard,6);
                        }
                    }
                }
            }
            self.cfg_begin(selected);
            if guard == 0 && refutable[ordinal] == 0 && !self.cfg_payload_bindings(pattern,subject_address) { return self.reject(pattern); }
            if result_storage != 0 {
                if unsafe{(*(self.nodes+body)).kind} == AstKind::MatchValueBlock {
                    if !self.cfg_match_value_block(body,result_storage,return_type,self.match_record_id(index,0),
                        first_parameter,parameter_count,depth+1) { return self.reject(body); }
                } else if return_type == TargetTypeTag::Pointer {
                    let record: u32 = self.match_record_id(index,0);
                    let source: u32 = self.cfg_struct_address(body,first_parameter,parameter_count,0);
                    if record == 0 || source == 0 || !self.cfg_copy_fields(result_storage,source,record,0,0,body,0) { return self.reject(body); }
                } else {
                    let result: u32 = self.lower_expression(body,return_type,first_parameter,parameter_count);
                    if result == 0 || unsafe{(*(self.values+result as usize-1)).type_tag} != return_type
                        || !self.cfg_store(result_storage,result,return_type,body) { return self.reject(body); }
                }
            } else if !self.cfg_sequence(unsafe { (*(self.nodes + body)).first_child }, return_type,
                first_parameter, parameter_count, break_id, continue_id, depth + 1) { return false; }
            if self.cfg_current != 0 { any_open = true; if !self.cfg_jump(join, arm) { return self.reject(arm); } }
            self.local_count = scope;
            if next != 0 {
                self.cfg_begin(next);
                if arm_node.next_sibling == 0 {
                    // Exhaustiveness proves this edge unreachable for valid
                    // values. Invalid raw representations still trap, rather
                    // than silently selecting the last refutable arm.
                    if !self.cfg_match_trap(index) { return self.reject(index); }
                }
            }
            ordinal = ordinal + 1;
            arm = arm_node.next_sibling;
        }
        self.cfg_begin(join);
        if !any_open && !self.cfg_jump(first_body, index) { return self.reject(index); }
        return true;
    }

    pub fn cfg_sequence(mut self: &mut Self, first_statement: usize, return_type: TargetTypeTag,
        first_parameter: usize, parameter_count: usize, break_id: u32, continue_id: u32, depth: usize) -> bool {
        if depth >= 64 { return self.reject(first_statement); }
        let defer_base: usize = self.defer_count;
        let mut index: usize = first_statement;
        while index != 0 && self.cfg_current != 0 {
            if index >= self.node_count { return self.reject(index); }
            let stmt: AstNode = unsafe { *(self.nodes + index) };
            if stmt.kind == AstKind::DeferStmt {
                let payload: usize = stmt.first_child;
                if payload == 0 || payload >= self.node_count || self.defer_count >= 128
                    || !self.defer_payload_valid(payload, 0) { return self.reject(index); }
                let action: AstNode = unsafe { *(self.nodes + payload) };
                if action.kind != AstKind::Block && action.kind != AstKind::UnsafeBlock
                    && action.kind != AstKind::AssignStmt && action.kind != AstKind::ExprCall { return self.reject(index); }
                self.defer_nodes[self.defer_count] = payload;
                self.defer_locals[self.defer_count] = self.local_count;
                self.defer_count = self.defer_count + 1;
            } else if stmt.kind == AstKind::MatchYield {
                if stmt.next_sibling != 0 || !self.cfg_match_yield(stmt.first_child,first_parameter,parameter_count) { return self.reject(index); }
            } else if stmt.kind == AstKind::ReturnStmt {
                let mut result: u32 = 0;
                let mut count: u32 = 0;
                if self.return_struct_id != 0 {
                    if !self.copy_return_struct(stmt.first_child, first_parameter, parameter_count, index) {
                        return self.reject(index);
                    }
                } else if return_type != TargetTypeTag::Void {
                    if self.conditional_record_result(stmt.first_child, 0) { return self.reject(index); }
                    result = self.lower_expression(stmt.first_child, return_type, first_parameter, parameter_count);
                    // Expressions may append operands: record the return range afterwards.
                    if result == 0 { return self.reject(index); }
                    count = 1;
                } else if stmt.first_child != 0 { return self.reject(index); }
                if !self.cfg_emit_defers(0, first_parameter, parameter_count, depth) { return self.reject(index); }
                let return_operand: u32 = self.operand_count as u32;
                if count != 0 && !self.append_operand(result) { return self.reject(index); }
                if !self.append_instruction(TargetOpcode::Return, 0, return_type, return_operand, count, index)
                    || !self.cfg_finish() { return self.reject(index); }
            } else if stmt.kind == AstKind::BreakStmt || stmt.kind == AstKind::ContinueStmt {
                let mut destination: u32 = break_id;
                if stmt.kind == AstKind::ContinueStmt { destination = continue_id; }
                if !self.cfg_emit_defers(self.loop_defer_base, first_parameter, parameter_count, depth) { return self.reject(index); }
                if !self.cfg_jump(destination, index) { return self.reject(index); }
            } else if stmt.kind == AstKind::MatchStmt {
                if !self.cfg_match_statement(index, return_type, first_parameter, parameter_count,
                    break_id, continue_id, depth + 1,0) { return false; }
            } else if stmt.kind == AstKind::IfStmt {
                let condition_index: usize = stmt.first_child;
                if condition_index == 0 || condition_index >= self.node_count { return self.reject(index); }
                let then_index: usize = unsafe { (*(self.nodes + condition_index)).next_sibling };
                if then_index == 0 || then_index >= self.node_count { return self.reject(index); }
                let then_node: AstNode = unsafe { *(self.nodes + then_index) };
                if then_node.kind != AstKind::Block { return self.reject(index); }
                let else_index: usize = then_node.next_sibling;
                let yes: u32 = self.cfg_reserve_block();
                let no: u32 = self.cfg_reserve_block();
                let join: u32 = self.cfg_reserve_block();
                if yes == 0 || no == 0 || join == 0 || !self.cfg_test(condition_index, yes, no,
                    first_parameter, parameter_count, depth + 1) { return self.reject(index); }
                let scope: usize = self.local_count;
                self.cfg_begin(yes);
                if !self.cfg_sequence(then_node.first_child, return_type, first_parameter, parameter_count,
                    break_id, continue_id, depth + 1) { return false; }
                let yes_open: bool = self.cfg_current != 0;
                if yes_open && !self.cfg_jump(join, index) { return self.reject(index); }
                self.local_count = scope;
                self.cfg_begin(no);
                if else_index != 0 {
                    if else_index >= self.node_count { return self.reject(index); }
                    let else_node: AstNode = unsafe { *(self.nodes + else_index) };
                    let mut else_first: usize = else_node.first_child;
                    if else_node.kind == AstKind::IfStmt { else_first = else_index; }
                    else if else_node.kind != AstKind::Block { return self.reject(index); }
                    if !self.cfg_sequence(else_first, return_type, first_parameter, parameter_count,
                        break_id, continue_id, depth + 1) { return false; }
                }
                let no_open: bool = self.cfg_current != 0;
                if no_open && !self.cfg_jump(join, index) { return self.reject(index); }
                self.local_count = scope;
                self.cfg_begin(join);
                // An unused join still needs a valid terminator, but has no
                // incoming edge and must not resurrect terminated source paths.
                if !yes_open && !no_open && !self.cfg_jump(yes, index) { return self.reject(index); }
            } else if stmt.kind == AstKind::WhileStmt {
                let condition_index: usize = stmt.first_child;
                if condition_index == 0 || condition_index >= self.node_count { return self.reject(index); }
                if stmt.int_value == 1 {
                    let left:usize=unsafe{(*(self.nodes+condition_index)).first_child};
                    if !target_type_is_integer(self.condition_expression_type(left,first_parameter,parameter_count)) { return self.reject(index); }
                }
                let body_index: usize = unsafe { (*(self.nodes + condition_index)).next_sibling };
                if body_index == 0 || body_index >= self.node_count { return self.reject(index); }
                let body: AstNode = unsafe { *(self.nodes + body_index) };
                if body.kind != AstKind::Block { return self.reject(index); }
                let header: u32 = self.cfg_reserve_block();
                let loop_body: u32 = self.cfg_reserve_block();
                let exit: u32 = self.cfg_reserve_block();
                if header == 0 || loop_body == 0 || exit == 0 || !self.cfg_jump(header, index) { return self.reject(index); }
                self.cfg_begin(header);
                if !self.cfg_test(condition_index, loop_body, exit, first_parameter, parameter_count, depth + 1) {
                    return self.reject(index);
                }
                let scope: usize = self.local_count;
                self.cfg_begin(loop_body);
                let outer_loop_defer_base: usize = self.loop_defer_base;
                self.loop_defer_base = self.defer_count;
                if !self.cfg_sequence(body.first_child, return_type, first_parameter, parameter_count,
                    exit, header, depth + 1) { return false; }
                self.loop_defer_base = outer_loop_defer_base;
                if self.cfg_current != 0 && !self.cfg_jump(header, index) { return self.reject(index); }
                self.local_count = scope;
                self.cfg_begin(exit);
                if stmt.int_value == 2 {
                    let mut return_sem:Sema=Sema::new();
                    if return_sem.loop_body_returns(self.nodes,self.node_count,body_index)
                        && !self.cfg_jump(header,index) { return self.reject(index); }
                }
            } else if stmt.kind == AstKind::UnsafeBlock || stmt.kind == AstKind::Block {
                let mut block_index: usize = index;
                if stmt.kind == AstKind::UnsafeBlock { block_index = stmt.first_child; }
                if block_index == 0 || block_index >= self.node_count { return self.reject(index); }
                let block: AstNode = unsafe { *(self.nodes + block_index) };
                let scope: usize = self.local_count;
                if !self.cfg_sequence(block.first_child, return_type, first_parameter, parameter_count,
                    break_id, continue_id, depth + 1) { return false; }
                self.local_count = scope;
            } else if !self.cfg_simple(index, first_parameter, parameter_count) {
                return self.reject(index);
            }
            index = stmt.next_sibling;
        }
        if self.cfg_current != 0 && !self.cfg_emit_defers(defer_base, first_parameter, parameter_count, depth) { return false; }
        self.defer_count = defer_base;
        return true;
    }

    pub fn lower_declared_function(
        mut self: &mut Self,
        function_node: AstNode,
        function_index: usize,
        fn_name: TargetSourceSlice,
        impl_struct_id: u32
    ) -> bool {
        if self.function_count >= self.function_capacity || self.functions == null {
            return self.reject(function_index);
        }
        let mut function_is_external: bool = true;
        let mut signature_scan: usize = function_node.first_child;
        while signature_scan != 0 && signature_scan < self.node_count {
            if unsafe { (*(self.nodes + signature_scan)).kind } == AstKind::Block {
                function_is_external = false;
                break;
            }
            signature_scan = unsafe { (*(self.nodes + signature_scan)).next_sibling };
        }
        let first_parameter: usize = self.parameter_count;
        self.local_count = 0;
        self.defer_count = 0; self.loop_defer_base = 0;
        self.structured_cfg = false;
        self.return_struct_id = self.function_return_struct_from_ast(function_index);
        self.return_destination = 0;
        self.forwarded_return_call = 0;
        let mut reset_local: usize = 0;
        while reset_local < 128 {
            self.local_storage_types[reset_local] = 0;
            self.local_array_types[reset_local] = 0;
            self.local_array_counts[reset_local] = 0;
            reset_local = reset_local + 1;
        }
        let mut return_type: TargetTypeTag = TargetTypeTag::Invalid;
        let mut return_type_index: usize = 0;
        let mut body_index: usize = 0;
        let mut child_index: usize = function_node.first_child;
        let mut is_first_param: bool = true;
        while child_index != 0 {
            if child_index >= self.node_count {
                return self.reject(function_index);
            }
            let child: AstNode = unsafe { *(self.nodes + child_index) };
            if child.kind == AstKind::ParamDecl {
                if child.first_child == 0 || child.first_child >= self.node_count
                    || self.parameters == null
                    || self.parameter_count >= self.parameter_capacity {
                    return self.reject(child_index);
                }
                let type_index: usize = child.first_child;
                let type_tag: TargetTypeTag = self.type_tag_for(type_index);
                let parameter_type_node: AstNode = unsafe { *(self.nodes + type_index) };
                if function_is_external && (target_type_is_float(type_tag)
                    || self.find_struct(parameter_type_node.str_offset,
                        parameter_type_node.str_len) != 0) { return self.reject(child_index); }
                if type_tag == TargetTypeTag::Invalid || child.str_len == 0
                    || (child.int_value != 0 && child.int_value != 1) {
                    return self.reject(child_index);
                }
                let mut value_id: u32 = TARGET_VALUE_NONE;
                if !function_is_external {
                    value_id = self.append_value(type_tag, child.str_offset, child.str_len);
                }
                if !function_is_external && value_id == TARGET_VALUE_NONE { return self.reject(child_index); }
                if !function_is_external && !self.mark_value_domain(value_id, type_index) { return self.reject(child_index); }
                unsafe {
                    *(self.parameters + self.parameter_count) = TargetParameter {
                        value_id: value_id,
                        type_tag: type_tag,
                        name: TargetSourceSlice {
                            offset: child.str_offset,
                            length: child.str_len
                        }
                    };
                }
                self.parameter_count = self.parameter_count + 1;
                let is_self_param: bool = child.str_len == 4
                    && unsafe { *(self.source + child.str_offset) == 115
                        && *(self.source + child.str_offset + 1) == 101
                        && *(self.source + child.str_offset + 2) == 108
                        && *(self.source + child.str_offset + 3) == 102 };
                let mut parameter_struct_id: u32 = 0;
                if is_first_param && impl_struct_id != 0 && is_self_param {
                    parameter_struct_id = impl_struct_id;
                } else if !function_is_external {
                    parameter_struct_id = self.pointer_pointee_struct_id(type_index);
                    if parameter_struct_id == 0 && type_tag == TargetTypeTag::Pointer {
                        let type_node: AstNode = unsafe { *(self.nodes + type_index) };
                        parameter_struct_id = self.find_struct(
                            type_node.str_offset, type_node.str_len
                        );
                    }
                }
                if !function_is_external && parameter_struct_id != 0 {
                    if self.local_count >= 128 {
                        return self.reject(child_index);
                    }
                    self.local_name_offsets[self.local_count] = child.str_offset;
                    self.local_name_lens[self.local_count] = child.str_len;
                    self.local_value_ids[self.local_count] = value_id;
                    self.local_struct_ids[self.local_count] = parameter_struct_id;
                    self.local_count = self.local_count + 1;
                }
                is_first_param = false;
            } else if child.kind == AstKind::TypeRef {
                if return_type != TargetTypeTag::Invalid {
                    return self.reject(child_index);
                }
                return_type = self.type_tag_for(child_index);
                return_type_index = child_index;
                if return_type == TargetTypeTag::Invalid {
                    return self.reject(child_index);
                }
            } else if child.kind == AstKind::Block {
                if body_index != 0 {
                    return self.reject(child_index);
                }
                body_index = child_index;
                function_is_external = false;
            } else {
                return self.reject(child_index);
            }
            child_index = child.next_sibling;
        }
        if return_type == TargetTypeTag::Invalid {
            return_type = TargetTypeTag::Void;
        }
        if function_is_external && target_type_is_float(return_type) { return self.reject(function_index); }
        if self.return_struct_id != 0 {
            if function_is_external || self.parameter_count >= self.parameter_capacity
                || self.parameter_count - first_parameter >= 24 { return self.reject(function_index); }
            self.return_destination = self.append_value(TargetTypeTag::Pointer, 0, 0);
            if self.return_destination == 0 { return self.reject(function_index); }
            if !self.mark_value_domain(self.return_destination, return_type_index) { return self.reject(function_index); }
            unsafe {
                *(self.parameters + self.parameter_count) = TargetParameter {
                    value_id: self.return_destination, type_tag: TargetTypeTag::Pointer,
                    name: TargetSourceSlice { offset: 0, length: 0 }
                };
            }
            self.parameter_count = self.parameter_count + 1;
            return_type = TargetTypeTag::Void;
        }
        let function_param_count: usize = self.parameter_count - first_parameter;
        if function_is_external {
            if body_index != 0 { return self.reject(function_index); }
            let external_function: TargetFunction = TargetFunction {
                name: fn_name,
                return_type: return_type,
                first_parameter: first_parameter as u32,
                parameter_count: function_param_count as u32,
                first_block: self.block_count as u32,
                block_count: 0,
                flags: TARGET_FUNCTION_EXTERNAL
            };
            unsafe { *(self.functions + self.function_count) = external_function; }
            self.function_count = self.function_count + 1;
            return true;
        }

        if body_index == 0 || self.blocks == null {
            return self.reject(function_index);
        }
        if self.return_struct_id != 0 || self.cfg_required(function_index) {
            self.structured_cfg = true;
            let cfg_first_block: usize = self.block_count;
            let entry: u32 = self.cfg_reserve_block();
            if entry == 0 { return self.reject(function_index); }
            self.cfg_begin(entry);
            let cfg_body: AstNode = unsafe { *(self.nodes + body_index) };
            if !self.cfg_sequence(cfg_body.first_child, return_type, first_parameter,
                function_param_count, 0, 0, 0) {
                return false;
            }
            if self.cfg_current != 0 {
                if self.return_struct_id != 0 || return_type != TargetTypeTag::Void || !self.append_instruction(
                    TargetOpcode::Return, 0, TargetTypeTag::Void, 0, 0, body_index
                ) || !self.cfg_finish() { return self.reject(function_index); }
            }
            unsafe {
                *(self.functions + self.function_count) = TargetFunction {
                    name: fn_name, return_type: return_type,
                    first_parameter: first_parameter as u32,
                    parameter_count: function_param_count as u32,
                    first_block: cfg_first_block as u32,
                    block_count: (self.block_count - cfg_first_block) as u32, flags: 0
                };
            }
            self.function_count = self.function_count + 1;
            self.structured_cfg = false;
            return true;
        }
        let first_block: usize = self.block_count;
        let mut first_instruction: usize = self.instruction_count;
        let mut statement_index: usize = unsafe { (*(self.nodes + body_index)).first_child };
        let mut function_block_count: u32 = 0;
        while statement_index != 0 {
            if statement_index >= self.node_count {
                return self.reject(statement_index);
            }
            let statement: AstNode = unsafe { *(self.nodes + statement_index) };
            if statement.kind == AstKind::LetStmt {
                let mut type_child: usize = 0;
                let mut right_index: usize = 0;
                if statement.first_child != 0 && statement.first_child < self.node_count {
                    let first_c: AstNode = unsafe { *(self.nodes + statement.first_child) };
                    if first_c.kind == AstKind::TypeRef {
                        type_child = statement.first_child;
                        right_index = first_c.next_sibling;
                    } else {
                        right_index = statement.first_child;
                    }
                }
                if right_index == 0 || right_index >= self.node_count {
                    return self.reject(statement_index);
                }
                let right_node: AstNode = unsafe { *(self.nodes + right_index) };
                if right_node.kind == AstKind::ExprStructLiteral
                    || (right_node.kind == AstKind::ExprCall && self.cfg_struct_id(right_index, 0) != 0) {
                    let struct_id: u32 = self.cfg_struct_id(right_index, 0);
                    if struct_id == 0 { return self.reject(statement_index); }
                    if type_child != 0 {
                        let declared_type: AstNode = unsafe { *(self.nodes + type_child) };
                        if self.find_struct(declared_type.str_offset, declared_type.str_len) != struct_id {
                            return self.reject(statement_index);
                        }
                    }
                    let ptr_val: u32 = self.lower_expression(right_index, TargetTypeTag::Pointer, first_parameter, function_param_count);
                    if ptr_val == TARGET_VALUE_NONE { return self.reject(statement_index); }
                    if self.local_count >= 128 { return self.reject(statement_index); }
                    self.local_name_offsets[self.local_count] = statement.str_offset;
                    self.local_name_lens[self.local_count] = statement.str_len;
                    self.local_value_ids[self.local_count] = ptr_val;
                    self.local_struct_ids[self.local_count] = struct_id;
                    self.local_count = self.local_count + 1;
                    statement_index = statement.next_sibling;
                    continue;
                }
                if type_child != 0 {
                    let declared_type: AstNode = unsafe { *(self.nodes + type_child) };
                    let declared_struct_id: u32 = self.find_struct(
                        declared_type.str_offset, declared_type.str_len
                    );
                    if declared_struct_id != 0
                        && right_node.kind == AstKind::UnsafeExpr
                        && right_node.first_child != 0
                        && right_node.first_child < self.node_count
                        && unsafe { (*(self.nodes + right_node.first_child)).next_sibling } == 0 {
                        let deref_node: AstNode = unsafe {
                            *(self.nodes + right_node.first_child)
                        };
                        if deref_node.kind == AstKind::ExprUnary
                            && deref_node.int_value == 82
                            && deref_node.first_child != 0
                            && deref_node.first_child < self.node_count
                            && unsafe {
                                (*(self.nodes + deref_node.first_child)).next_sibling
                            } == 0 {
                            let pointer_type_ref: usize =
                                self.pointer_expression_type_ref(deref_node.first_child);
                            let pointee_struct_id: u32 =
                                self.pointer_pointee_struct_id(pointer_type_ref);
                            if pointee_struct_id != declared_struct_id {
                                return self.reject(statement_index);
                            }
                            let ptr_val: u32 = self.lower_expression(
                                deref_node.first_child,
                                TargetTypeTag::Pointer,
                                first_parameter,
                                function_param_count
                            );
                            if ptr_val == TARGET_VALUE_NONE || self.local_count >= 128 {
                                return self.reject(statement_index);
                            }
                            self.local_name_offsets[self.local_count] =
                                statement.str_offset;
                            self.local_name_lens[self.local_count] =
                                statement.str_len;
                            self.local_value_ids[self.local_count] = ptr_val;
                            self.local_struct_ids[self.local_count] =
                                declared_struct_id;
                            self.local_count = self.local_count + 1;
                            statement_index = statement.next_sibling;
                            continue;
                        }
                    }
                }
                let mut var_type: TargetTypeTag = TargetTypeTag::Invalid;
                if type_child != 0 && type_child < self.node_count {
                    var_type = self.type_tag_for(type_child);
                }
                if var_type == TargetTypeTag::Invalid {
                    let mut sem: Sema = Sema::new();
                    if right_node.kind == AstKind::ExprCall {
                        let inferred_type_ref: usize = sem.infer_expression_type_ref(
                            self.nodes,
                            self.node_count,
                            right_index,
                            self.source,
                            self.source_len
                        );
                        if inferred_type_ref != 0 {
                            var_type = self.type_tag_for(inferred_type_ref);
                        }
                    }
                    if var_type == TargetTypeTag::Invalid {
                        if sem.expression_is_integer_literal(
                            self.nodes,
                            self.node_count,
                            right_index,
                            self.source,
                            self.source_len
                        ) {
                            var_type = TargetTypeTag::U32;
                        } else if right_node.kind == AstKind::ExprPath {
                            var_type = TargetTypeTag::U32;
                        } else {
                            var_type = TargetTypeTag::U32;
                        }
                    }
                }
                let expr_value: u32 = self.lower_expression(right_index, var_type, first_parameter, function_param_count);
                if expr_value == TARGET_VALUE_NONE { return self.reject(statement_index); }
                if self.local_count >= 128 { return self.reject(statement_index); }
                let struct_id: u32 = self.find_local_struct_id(statement.str_offset, statement.str_len);
                self.local_name_offsets[self.local_count] = statement.str_offset;
                self.local_name_lens[self.local_count] = statement.str_len;
                self.local_value_ids[self.local_count] = expr_value;
                self.local_struct_ids[self.local_count] = struct_id;
                self.local_count = self.local_count + 1;
                statement_index = statement.next_sibling;
                continue;
            } else if statement.kind == AstKind::UnsafeBlock {
                let unsafe_body_index: usize = statement.first_child;
                if unsafe_body_index == 0 || unsafe_body_index >= self.node_count {
                    return self.reject(statement_index);
                }
                let unsafe_body: AstNode = unsafe {
                    *(self.nodes + unsafe_body_index)
                };
                if unsafe_body.kind != AstKind::Block
                    || unsafe_body.next_sibling != 0 {
                    return self.reject(statement_index);
                }
                let mut unsafe_statement_index: usize = unsafe_body.first_child;
                while unsafe_statement_index != 0 {
                    if unsafe_statement_index >= self.node_count {
                        return self.reject(statement_index);
                    }
                    let unsafe_statement: AstNode = unsafe {
                        *(self.nodes + unsafe_statement_index)
                    };
                    if !self.lower_pointer_deref_store(
                        unsafe_statement_index,
                        first_parameter,
                        function_param_count
                    ) {
                        return self.reject(unsafe_statement_index);
                    }
                    unsafe_statement_index = unsafe_statement.next_sibling;
                }
                statement_index = statement.next_sibling;
                continue;
            } else if statement.kind == AstKind::AssignStmt {
                let left_index: usize = statement.first_child;
                let right_index: usize = unsafe { (*(self.nodes + left_index)).next_sibling };
                if left_index == 0 || right_index == 0
                    || left_index >= self.node_count || right_index >= self.node_count {
                    return self.reject(statement_index);
                }
                let left_node: AstNode = unsafe { *(self.nodes + left_index) };
                if left_node.kind == AstKind::ExprUnary
                    && left_node.int_value == 82 {
                    if !self.lower_pointer_deref_store(
                        statement_index, first_parameter, function_param_count
                    ) {
                        return self.reject(statement_index);
                    }
                    statement_index = statement.next_sibling;
                    continue;
                }
                if left_node.kind == AstKind::ExprIndex {
                    let base_index: usize = left_node.first_child;
                    if base_index == 0 || base_index >= self.node_count {
                        return self.reject(statement_index);
                    }
                    let base_node: AstNode = unsafe { *(self.nodes + base_index) };
                    let index_index: usize = base_node.next_sibling;
                    if base_node.kind != AstKind::ExprIdent || index_index == 0
                        || index_index >= self.node_count
                        || unsafe { (*(self.nodes + index_index)).next_sibling } != 0 {
                        return self.reject(statement_index);
                    }
                    let global_index: isize = self.find_global_bss(
                        base_node.str_offset, base_node.str_len
                    );
                    if global_index < 0 {
                        return self.reject(statement_index);
                    }
                    let gi: usize = global_index as usize;
                    if unsafe { g_bss_sym_is_array[gi] } == 0 {
                        return self.reject(statement_index);
                    }
                    let element_type: TargetTypeTag = unsafe {
                        g_bss_sym_element_types[gi] as TargetTypeTag
                    };
                    let stride: usize = unsafe { g_bss_sym_element_strides[gi] };
                    let count: usize = unsafe { g_bss_sym_element_counts[gi] };
                    if (element_type != TargetTypeTag::U8
                            && element_type != TargetTypeTag::U16
                            && element_type != TargetTypeTag::U32
                            && element_type != TargetTypeTag::I8 && element_type != TargetTypeTag::I16 && element_type != TargetTypeTag::I32
                            && element_type != TargetTypeTag::I64 && element_type != TargetTypeTag::U64 && !target_type_is_float(element_type))
                        || stride == 0 || count == 0
                        || stride > 4294967295 || count > 2147483647 {
                        return self.reject(statement_index);
                    }

                    let base_value: u32 = self.lower_expression(
                        base_index, TargetTypeTag::Pointer,
                        first_parameter, function_param_count
                    );
                    if base_value == TARGET_VALUE_NONE {
                        return self.reject(statement_index);
                    }
                    let index_value: u32 = self.lower_expression(
                        index_index, TargetTypeTag::U64,
                        first_parameter, function_param_count
                    );
                    if index_value == TARGET_VALUE_NONE {
                        return self.reject(statement_index);
                    }
                    let address_operand: u32 = self.operand_count as u32;
                    if !self.append_operand(base_value)
                        || !self.append_operand(index_value) {
                        return self.reject(statement_index);
                    }
                    let address_value: u32 = self.append_value(
                        TargetTypeTag::Pointer, 0, 0
                    );
                    if address_value == TARGET_VALUE_NONE
                        || !self.append_instruction(
                            TargetOpcode::IndexAddr,
                            address_value,
                            TargetTypeTag::Pointer,
                            address_operand,
                            2,
                            left_index
                        ) {
                        return self.reject(statement_index);
                    }
                    let address_instruction: usize = self.instruction_count - 1;
                    unsafe {
                        (*(self.instructions + address_instruction)).immediate_bits =
                            ((count as u64) << 32) | (stride as u64);
                    }

                    let expr_value: u32 = self.lower_expression(
                        right_index, element_type,
                        first_parameter, function_param_count
                    );
                    if expr_value == TARGET_VALUE_NONE {
                        return self.reject(statement_index);
                    }
                    let store_operand: u32 = self.operand_count as u32;
                    if !self.append_operand(address_value)
                        || !self.append_operand(expr_value)
                        || !self.append_instruction(
                            TargetOpcode::Store,
                            TARGET_VALUE_NONE,
                            element_type,
                            store_operand,
                            2,
                            statement_index
                        ) {
                        return self.reject(statement_index);
                    }
                    let store_index: usize = self.instruction_count - 1;
                    unsafe {
                        (*(self.instructions + store_index)).immediate_bits = 0;
                    }
                    statement_index = statement.next_sibling;
                    continue;
                }
                if left_node.kind == AstKind::ExprFieldAccess {
                    if !self.lower_field_assignment(
                        statement_index, first_parameter, function_param_count
                    ) { return self.reject(statement_index); }
                    statement_index = statement.next_sibling;
                    continue;
                }
                if left_node.kind != AstKind::ExprIdent { return self.reject(statement_index); }
                let old_value_id: u32 = self.find_parameter_value(first_parameter, function_param_count, left_node.str_offset, left_node.str_len);
                if old_value_id == TARGET_VALUE_NONE {
                    let g_idx: isize = self.find_global_bss(left_node.str_offset, left_node.str_len);
                    if g_idx >= 0 {
                        let gi: usize = g_idx as usize;
                        let ptr_val: u32 = self.append_value(TargetTypeTag::Pointer, 0, 0);
                        if ptr_val == TARGET_VALUE_NONE { return self.reject(statement_index); }
                        let sym_slice: TargetSourceSlice = TargetSourceSlice {
                            offset: left_node.str_offset,
                            length: left_node.str_len
                        };
                        if !self.append_instruction(
                            TargetOpcode::AllocStack, ptr_val, TargetTypeTag::Pointer,
                            0, 0, statement_index
                        ) {
                            return self.reject(statement_index);
                        }
                        let alloc_idx: usize = self.instruction_count - 1;
                        let mut instr: TargetInstruction = unsafe { *(self.instructions + alloc_idx) };
                        instr.immediate_bits = unsafe { g_bss_sym_sizes[gi] } as u64;
                        instr.symbol = sym_slice;
                        unsafe { *(self.instructions + alloc_idx) = instr; }

                        let var_type: TargetTypeTag = unsafe { g_bss_sym_types[gi] } as TargetTypeTag;
                        let expr_value: u32 = self.lower_expression(right_index, var_type, first_parameter, function_param_count);
                        if expr_value == TARGET_VALUE_NONE { return self.reject(statement_index); }
                        let first_op: u32 = self.operand_count as u32;
                        if !self.append_operand(ptr_val) || !self.append_operand(expr_value) { return self.reject(statement_index); }
                        if !self.append_instruction(TargetOpcode::Store, TARGET_VALUE_NONE, var_type, first_op, 2, statement_index) { return self.reject(statement_index); }
                        let store_idx: usize = self.instruction_count - 1;
                        unsafe { (*(self.instructions + store_idx)).immediate_bits = 0; }
                        statement_index = statement.next_sibling;
                        continue;
                    }
                    return self.reject(statement_index);
                }
                if self.values == null { return self.reject(statement_index); }
                let var_type: TargetTypeTag = unsafe { (*(self.values + old_value_id as usize - 1)).type_tag };
                let expr_value: u32 = self.lower_expression(right_index, var_type, first_parameter, function_param_count);
                if expr_value == TARGET_VALUE_NONE { return self.reject(statement_index); }
                if self.local_count >= 128 { return self.reject(statement_index); }
                let struct_id: u32 = self.find_local_struct_id(left_node.str_offset, left_node.str_len);
                self.local_name_offsets[self.local_count] = left_node.str_offset;
                self.local_name_lens[self.local_count] = left_node.str_len;
                self.local_value_ids[self.local_count] = expr_value;
                self.local_struct_ids[self.local_count] = struct_id;
                self.local_count = self.local_count + 1;
                statement_index = statement.next_sibling;
                continue;
            } else if statement.kind == AstKind::ExprCall {
                let mut lowered_call: bool = false;
                if statement.first_child != 0 && statement.first_child < self.node_count {
                    let callee_node: AstNode = unsafe { *(self.nodes + statement.first_child) };
                    if callee_node.kind == AstKind::ExprIdent {
                        let callee_decl: usize = self.find_top_level_function_decl(
                            callee_node.str_offset, callee_node.str_len
                        );
                        if callee_decl != 0
                            && self.function_return_type_from_ast(callee_decl)
                                == TargetTypeTag::Void {
                            lowered_call = self.lower_direct_void_call_statement(
                                statement_index, first_parameter, function_param_count
                            );
                            if !lowered_call {
                                return self.reject(statement_index);
                            }
                        }
                    }
                }
                if !lowered_call {
                    let call_val: u32 = self.lower_expression(
                        statement_index,
                        TargetTypeTag::Invalid,
                        first_parameter,
                        function_param_count
                    );
                    if call_val == TARGET_VALUE_NONE {
                        return self.reject(statement_index);
                    }
                }
                statement_index = statement.next_sibling;
                continue;
            } else if statement.kind == AstKind::ReturnStmt {
                if statement.next_sibling != 0
                    || self.block_count >= self.block_capacity
                    || !self.lower_return_statement(
                        statement_index, return_type, first_parameter,
                        function_param_count
                    ) {
                    return self.reject(statement_index);
                }
                let current_block: usize = self.block_count;
                unsafe {
                    *(self.blocks + current_block) = TargetBlock {
                        id: (current_block + 1) as u32,
                        label: TargetSourceSlice::empty(),
                        first_instruction: first_instruction as u32,
                        instruction_count: (self.instruction_count - first_instruction) as u32
                    };
                }
                self.block_count = self.block_count + 1;
                function_block_count = (self.block_count - first_block) as u32;
                break;
            } else if statement.kind == AstKind::IfStmt {
                if statement.next_sibling != 0 {
                    if !self.lower_guard_return_prefix(
                        statement_index, return_type, first_parameter,
                        function_param_count, first_instruction
                    ) {
                        return self.reject(statement_index);
                    }
                    first_instruction = self.instruction_count;
                    statement_index = statement.next_sibling;
                    continue;
                }
                if !self.lower_if_return_branches(
                    statement_index, return_type, first_parameter,
                    function_param_count, first_instruction
                ) {
                    return self.reject(statement_index);
                }
                function_block_count = (self.block_count - first_block) as u32;
                break;
            } else if statement.kind == AstKind::WhileStmt {
                let return_index: usize = statement.next_sibling;
                let while_condition_index: usize = statement.first_child;
                let mut while_body_index: usize = 0;
                if while_condition_index != 0 && while_condition_index < self.node_count {
                    while_body_index = unsafe { (*(self.nodes + while_condition_index)).next_sibling };
                }
                let mut first_body_statement: usize = 0;
                if while_body_index != 0 && while_body_index < self.node_count {
                    first_body_statement = unsafe { (*(self.nodes + while_body_index)).first_child };
                }
                let body_is_if: bool = first_body_statement != 0
                    && first_body_statement < self.node_count
                    && unsafe { (*(self.nodes + first_body_statement)).kind } == AstKind::IfStmt;
                let mut body_is_search: bool = body_is_if;
                if first_body_statement != 0 && first_body_statement < self.node_count
                    && unsafe { (*(self.nodes + first_body_statement)).kind } == AstKind::LetStmt {
                    let next_body_statement: usize = unsafe {
                        (*(self.nodes + first_body_statement)).next_sibling
                    };
                    body_is_search = next_body_statement != 0
                        && next_body_statement < self.node_count
                        && unsafe { (*(self.nodes + next_body_statement)).kind } == AstKind::IfStmt;
                }
                let mut loop_lowered: bool = false;
                if body_is_search {
                    loop_lowered = self.lower_while_search_then_return(
                        statement_index, return_index, return_type, first_parameter,
                        function_param_count, first_instruction
                    );
                    if !loop_lowered && body_is_if {
                        loop_lowered = self.lower_while_if_jumps_then_return(
                            statement_index, return_index, return_type, first_parameter,
                            function_param_count, first_instruction
                        );
                    }
                } else {
                    loop_lowered = self.lower_while_jump_then_return(
                        statement_index, return_index, return_type, first_parameter,
                        function_param_count, first_instruction
                    );
                }
                if return_index == 0 || !loop_lowered {
                    return self.reject(statement_index);
                }
                function_block_count = (self.block_count - first_block) as u32;
                break;
            } else {
                return self.reject(statement_index);
            }
        }

        if function_block_count == 0 {
            if return_type != TargetTypeTag::Void
                || self.block_count >= self.block_capacity
                || !self.append_instruction(
                    TargetOpcode::Return,
                    TARGET_VALUE_NONE,
                    TargetTypeTag::Void,
                    self.operand_count as u32,
                    0,
                    body_index
                ) {
                return self.reject(function_index);
            }
            let current_block: usize = self.block_count;
            unsafe {
                *(self.blocks + current_block) = TargetBlock {
                    id: (current_block + 1) as u32,
                    label: TargetSourceSlice::empty(),
                    first_instruction: first_instruction as u32,
                    instruction_count: (self.instruction_count - first_instruction) as u32
                };
            }
            self.block_count = self.block_count + 1;
            function_block_count = 1;
        }

        let function: TargetFunction = TargetFunction {
            name: fn_name,
            return_type: return_type,
            first_parameter: first_parameter as u32,
            parameter_count: function_param_count as u32,
            first_block: first_block as u32,
            block_count: function_block_count,
            flags: 0
        };
        unsafe {
            *(self.functions + self.function_count) = function;
        }
        self.function_count = self.function_count + 1;
        return true;
    }
}

// Lowers typed scalar functions with decimal arithmetic and direct returns,
// plus a boolean-parameter if/else whose two arms return. The caller runs native
// sema first; this routine still checks shape and caller-buffer capacity.
pub fn lower_scalar_module(
    lowering: &mut ScalarLowering,
    module_index: usize,
    output: &mut TargetModule
) -> bool {
    *output = TargetModule::empty();
    lowering.error_node = 0;
    lowering.error_reason = 0;
    unsafe {
        g_rodata_len = 0;
        g_rodata_sym_count = 0;
        g_bss_total_size = 0;
        g_bss_sym_count = 0;
        g_data_total_size = 0;
        g_static_list_count = 0;
    }
    if lowering.nodes == null || lowering.source == null || module_index == 0
        || module_index >= lowering.node_count {
        return lowering.reject(module_index);
    }
    let module_node: AstNode = unsafe { *(lowering.nodes + module_index) };
    if module_node.kind != AstKind::Module {
        return lowering.reject(module_index);
    }

    let mut struct_scan_index: usize = module_node.first_child;
    while struct_scan_index != 0 {
        if struct_scan_index >= lowering.node_count {
            return lowering.reject(struct_scan_index);
        }
        let decl_node: AstNode = unsafe { *(lowering.nodes + struct_scan_index) };
        if decl_node.kind == AstKind::StructDecl {
            if lowering.struct_count >= 32 { return lowering.reject(struct_scan_index); }
            let s_id: usize = lowering.struct_count;
            lowering.struct_name_offsets[s_id] = decl_node.str_offset;
            lowering.struct_name_lens[s_id] = decl_node.str_len;
            lowering.struct_field_starts[s_id] = lowering.field_total_count as u32;
            let mut cur_offset: u32 = 0;
            let mut struct_alignment: u32 = 1;
            let mut f_cnt: u32 = 0;
            let mut f_scan: usize = decl_node.first_child;
            while f_scan != 0 {
                if f_scan >= lowering.node_count {
                    return lowering.reject(f_scan);
                }
                let f_node: AstNode = unsafe { *(lowering.nodes + f_scan) };
                if f_node.kind == AstKind::FieldDecl {
                    if lowering.field_total_count >= 256 { return lowering.reject(f_scan); }
                    let f_idx: usize = lowering.field_total_count;
                    lowering.field_name_offsets[f_idx] = f_node.str_offset;
                    lowering.field_name_lens[f_idx] = f_node.str_len;
                    lowering.field_type_refs[f_idx] = f_node.first_child;
                    lowering.field_offsets[f_idx] = cur_offset;
                    let mut f_type: TargetTypeTag = TargetTypeTag::U32;
                    let mut field_struct: u32 = 0;
                    if f_node.first_child != 0 && f_node.first_child < lowering.node_count {
                        let field_type: AstNode = unsafe { *(lowering.nodes + f_node.first_child) };
                        field_struct = lowering.find_struct(field_type.str_offset, field_type.str_len);
                        f_type = lowering.type_tag_for(f_node.first_child);
                        if f_type == TargetTypeTag::Invalid {
                            if field_type.str_len == 0 || unsafe { *(lowering.source + field_type.str_offset) } != 91 {
                                return lowering.reject(f_scan);
                            }
                            f_type = TargetTypeTag::U32;
                        }
                    }
                    lowering.field_type_tags[f_idx] = f_type as u32;
                    lowering.field_struct_ids[f_idx] = field_struct;
                    let mut f_sz: u32 = 4;
                    if f_type == TargetTypeTag::U64 || f_type == TargetTypeTag::I64 || f_type == TargetTypeTag::Pointer || f_type == TargetTypeTag::F64 {
                        f_sz = 8;
                    } else if f_type == TargetTypeTag::U16 || f_type == TargetTypeTag::I16 {
                        f_sz = 2;
                    } else if f_type == TargetTypeTag::U8 || f_type == TargetTypeTag::I8 || f_type == TargetTypeTag::Bool {
                        f_sz = 1;
                    }
                    let mut f_alignment: u32 = f_sz;
                    let field_type_node: AstNode = unsafe { *(lowering.nodes + f_node.first_child) };
                    if field_type_node.str_len != 0 && unsafe { *(lowering.source + field_type_node.str_offset) } == 91 {
                        let mut element: TargetTypeTag = lowering.parse_array_element_type(
                            field_type_node.str_offset, field_type_node.str_len);
                        let count: usize = lowering.parse_array_element_count(
                            field_type_node.str_offset, field_type_node.str_len);
                        let record: u32 = lowering.parse_array_element_struct(field_type_node.str_offset,field_type_node.str_len);
                        let mut stride: u32 = lowering.scalar_memory_size(element);
                        if record != 0 {
                            stride = lowering.struct_sizes[record as usize - 1];
                            let limit: usize = 65536;
                            if stride == 0 || count == 0 || count > 256 || count > limit/(stride as usize)
                                || !lowering.array_record_copyable(record,0) { return lowering.reject(f_scan); }
                            element = TargetTypeTag::Pointer;
                            lowering.field_array_structs[f_idx] = record;
                        }
                        if stride == 0 || element == TargetTypeTag::Aggregate || count == 0 || count > 256 { return lowering.reject(f_scan); }
                        let maximum: usize = 65536;
                        if count > maximum/(stride as usize) { return lowering.reject(f_scan); }
                        lowering.field_byte_counts[f_idx] = count as u32;
                        lowering.field_array_types[f_idx] = element as u32;
                        lowering.field_type_tags[f_idx] = TargetTypeTag::Aggregate as u32;
                        f_sz = count as u32 * stride;
                        f_alignment = stride;
                        if record != 0 { f_alignment = lowering.struct_alignments[record as usize - 1]; }
                    }
                    if field_struct != 0 {
                        f_sz = lowering.struct_sizes[field_struct as usize - 1];
                        f_alignment = lowering.struct_alignments[field_struct as usize - 1];
                        lowering.field_type_tags[f_idx] = TargetTypeTag::Aggregate as u32;
                    }
                    if f_alignment == 0 { return lowering.reject(f_scan); }
                    if f_alignment > struct_alignment { struct_alignment = f_alignment; }
                    let layout_limit: u32 = 4294967295;
                    if cur_offset > layout_limit-(f_alignment-1) { return lowering.reject(f_scan); }
                    cur_offset = ((cur_offset + f_alignment - 1) / f_alignment) * f_alignment;
                    lowering.field_offsets[f_idx] = cur_offset;
                    if f_sz > layout_limit-cur_offset { return lowering.reject(f_scan); }
                    cur_offset = cur_offset + f_sz;
                    lowering.field_total_count = lowering.field_total_count + 1;
                    f_cnt = f_cnt + 1;
                }
                f_scan = f_node.next_sibling;
            }
            lowering.struct_field_counts[s_id] = f_cnt;
            let mut cur_size: u32 = 8;
            if cur_offset > 0 {
                cur_size = cur_offset;
            }
            let layout_limit: u32 = 4294967295;
            if cur_size > layout_limit-(struct_alignment-1) { return lowering.reject(struct_scan_index); }
            lowering.struct_sizes[s_id] = ((cur_size + struct_alignment - 1) / struct_alignment) * struct_alignment;
            lowering.struct_alignments[s_id] = struct_alignment;
            lowering.struct_count = lowering.struct_count + 1;
        }
        if decl_node.kind == AstKind::EnumDecl && lowering.enum_count < 32 {
            let e_id: usize = lowering.enum_count;
            lowering.enum_name_offsets[e_id] = decl_node.str_offset;
            lowering.enum_name_lens[e_id] = decl_node.str_len;
            lowering.enum_variant_starts[e_id] = lowering.variant_total_count as u32;
            let mut v_cnt: u32 = 0;let mut next_discriminant:u64=0;
            let mut v_scan: usize = decl_node.first_child;
            while v_scan != 0 {
                if v_scan >= lowering.node_count {
                    return lowering.reject(v_scan);
                }
                let v_node: AstNode = unsafe { *(lowering.nodes + v_scan) };
                if v_node.kind == AstKind::EnumVariant && lowering.variant_total_count < 256 {
                    let v_idx: usize = lowering.variant_total_count;
                    lowering.variant_nodes[v_idx] = v_scan;
                    lowering.variant_name_offsets[v_idx] = v_node.str_offset;
                    lowering.variant_name_lens[v_idx] = v_node.str_len;
                    let mut v_val:u64=next_discriminant;
                    if v_node.first_child != 0 && v_node.first_child < lowering.node_count
                        && unsafe{(*(lowering.nodes+v_node.first_child)).kind} != AstKind::TypeRef {
                        let mut literal_sem:Sema=Sema::new();
                        if !literal_sem.integer_literal_bits(lowering.nodes,lowering.node_count,v_node.first_child,
                            lowering.source,lowering.source_len,unsafe{(&mut v_val) as *mut u64}) { return lowering.reject(v_scan); }
                    }
                    if v_val > 4294967295 { return lowering.reject(v_scan); }next_discriminant=v_val+1;
                    lowering.variant_values[v_idx] = v_val;
                    lowering.variant_total_count = lowering.variant_total_count + 1;
                    v_cnt = v_cnt + 1;
                }
                v_scan = v_node.next_sibling;
            }
            lowering.enum_variant_counts[e_id] = v_cnt;
            lowering.enum_count = lowering.enum_count + 1;
        }
        struct_scan_index = decl_node.next_sibling;
    }

    if !lowering.register_payload_layouts() { return false; }

    // Layouts precede declaration registration; expressions never observe
    // a partially registered constant table or provisional constant bits.
    struct_scan_index = module_node.first_child;
    while struct_scan_index != 0 {
        if struct_scan_index >= lowering.node_count { return lowering.reject(struct_scan_index); }
        let declaration: AstNode = unsafe { *(lowering.nodes + struct_scan_index) };
        if lowering.module_let_is_const(declaration)
            && !lowering.register_module_integer_const(struct_scan_index) { return lowering.reject(struct_scan_index); }
        struct_scan_index = declaration.next_sibling;
    }
    let mut constant_slot: usize = 0;
    while constant_slot < lowering.const_count {
        if !lowering.resolve_module_const(constant_slot) {
            if lowering.error_node != 0 { return false; }
            return lowering.reject(lowering.const_literal_nodes[constant_slot]);
        }
        constant_slot = constant_slot + 1;
    }
    struct_scan_index = module_node.first_child;
    while struct_scan_index != 0 {
        if struct_scan_index >= lowering.node_count { return lowering.reject(struct_scan_index); }
        let decl_node: AstNode = unsafe { *(lowering.nodes + struct_scan_index) };
        if decl_node.kind == AstKind::LetStmt && !lowering.module_let_is_const(decl_node) {
            if unsafe { g_bss_sym_count } >= 256 { return lowering.reject(struct_scan_index); }
            let mut var_size: usize = 8 as usize;
            let mut is_array: u8 = 0;
            let mut type_tag_val: u32 = 4;
            let mut array_element_type: u32 = 0;
            let mut array_element_struct: u32 = 0;
            let mut array_element_stride: usize = 0;
            let mut array_element_count: usize = 0;
            let mut initial_bits: u64 = 0;
            let mut initial_stride: usize = 0;
            let mut initial_start: usize = 0;
            let mut initial_count: usize = 0;
            if decl_node.first_child != 0 && decl_node.first_child < lowering.node_count {
                let type_node: AstNode = unsafe { *(lowering.nodes + decl_node.first_child) };
                if type_node.str_len > 0 {
                    let first_c: u8 = unsafe { *(lowering.source + type_node.str_offset) };
                    if first_c == 91 {
                        is_array = 1;
                        let element_type: TargetTypeTag = lowering.parse_array_element_type(
                            type_node.str_offset, type_node.str_len
                        );
                        array_element_stride = lowering.parse_array_element_stride(
                            type_node.str_offset, type_node.str_len
                        );
                        array_element_count = lowering.parse_array_element_count(
                            type_node.str_offset, type_node.str_len
                        );
                        if element_type == TargetTypeTag::Invalid
                            || array_element_stride == 0 || array_element_count == 0 {
                            return lowering.reject(struct_scan_index);
                        }
                        array_element_type = element_type as u32;
                        array_element_struct = lowering.parse_array_element_struct(
                            type_node.str_offset, type_node.str_len);
                        let maximum_size: usize = 18446744073709551615;
                        if array_element_count > maximum_size / array_element_stride {
                            return lowering.reject(struct_scan_index);
                        }
                        let initializer_index: usize = type_node.next_sibling;
                        if initializer_index == 0 || initializer_index >= lowering.node_count { return lowering.reject(struct_scan_index); }
                        let initializer: AstNode = unsafe { *(lowering.nodes + initializer_index) };
                        if array_element_struct != 0 && (initializer.kind == AstKind::ExprArrayRepeat
                            || initializer.kind == AstKind::ExprArrayLiteral) {
                            if type_node.int_value != 0 || !lowering.register_static_record_array(initializer_index,
                                array_element_struct,array_element_count,&mut initial_start,&mut initial_bits) {
                                return lowering.reject(initializer_index);
                            }
                            initial_count=array_element_stride*array_element_count;
                            initial_stride=1;
                        } else if initializer.kind == AstKind::ExprArrayRepeat {
                            let repeated: usize = initializer.first_child;
                            if repeated == 0 || repeated >= lowering.node_count { return lowering.reject(struct_scan_index); }
                            let count_node: usize = unsafe { (*(lowering.nodes + repeated)).next_sibling };
                            if count_node == 0 || count_node >= lowering.node_count { return lowering.reject(struct_scan_index); }
                            let count_expr: AstNode = unsafe { *(lowering.nodes + count_node) };
                            if count_expr.kind != AstKind::ExprLiteral || count_expr.next_sibling != 0
                                || lowering.parse_integer_value(count_expr.str_offset, count_expr.str_len) != array_element_count as u64
                                || array_element_struct != 0 || element_type == TargetTypeTag::Pointer
                                || !lowering.constant_literal_bits(repeated, element_type, &mut initial_bits) { return lowering.reject(struct_scan_index); }
                        } else if initializer.kind == AstKind::ExprArrayLiteral {
                            if array_element_struct != 0
                                || !lowering.fold_static_array_list(initializer_index, element_type,
                                    array_element_count, &mut initial_start, &mut initial_bits) {
                                return lowering.reject(initializer_index);
                            }
                            initial_count = array_element_count;
                        } else if initializer.kind != AstKind::ExprLiteral || initializer.str_len != 1
                            || unsafe { *(lowering.source + initializer.str_offset) } != 48 { return lowering.reject(struct_scan_index); }
                        if initial_stride == 0 { initial_stride = array_element_stride; }
                        var_size = array_element_stride * array_element_count;
                        type_tag_val = TargetTypeTag::Pointer as u32;
                    } else {
                        let tt: TargetTypeTag = lowering.type_tag_for(decl_node.first_child);
                        let initializer_index: usize = type_node.next_sibling;
                        let record: u32 = lowering.find_struct(type_node.str_offset,type_node.str_len);
                        if record != 0 {
                            if type_node.int_value != 0 || !lowering.register_static_record(initializer_index,
                                record,&mut initial_start,&mut initial_bits) { return lowering.reject(struct_scan_index); }
                            var_size=lowering.struct_sizes[record as usize-1] as usize;
                            initial_stride=1;initial_count=var_size;
                            type_tag_val=TargetTypeTag::Aggregate as u32;
                        } else {
                        if tt == TargetTypeTag::Invalid || tt == TargetTypeTag::Aggregate
                            || initializer_index == 0 || initializer_index >= lowering.node_count
                            || !lowering.constant_literal_bits(initializer_index, tt, &mut initial_bits) { return lowering.reject(struct_scan_index); }
                        if tt != TargetTypeTag::Invalid {
                            type_tag_val = tt as u32;
                            var_size = 4;
                            if tt == TargetTypeTag::U64 || tt == TargetTypeTag::I64 || tt == TargetTypeTag::Pointer || tt == TargetTypeTag::F64 {
                                var_size = 8;
                            } else if tt == TargetTypeTag::U16 || tt == TargetTypeTag::I16 {
                                var_size = 2;
                            } else if tt == TargetTypeTag::U8 || tt == TargetTypeTag::I8 || tt == TargetTypeTag::Bool {
                                var_size = 1;
                            }
                        }
                        }
                    }
                }
            }
            if initial_stride == 0 { initial_stride = var_size; }
            let maximum_size: usize = 18446744073709551615;
            let mut storage_size: usize = unsafe { g_bss_total_size };
            if initial_bits != 0 { storage_size = unsafe { g_data_total_size }; }
            if storage_size > maximum_size - 7 { return lowering.reject(struct_scan_index); }
            let bss_off: usize = align_val(storage_size, 8);
            if var_size > maximum_size - bss_off { return lowering.reject(struct_scan_index); }
            let b_idx: usize = unsafe { g_bss_sym_count };
            unsafe {
                g_bss_sym_offsets[b_idx] = decl_node.str_offset;
                g_bss_sym_lens[b_idx] = decl_node.str_len;
                g_bss_sym_places[b_idx] = bss_off;
                g_bss_sym_sizes[b_idx] = var_size;
                g_bss_sym_is_array[b_idx] = is_array;
                g_bss_sym_types[b_idx] = type_tag_val;
                g_bss_sym_element_types[b_idx] = array_element_type;
                g_bss_sym_element_structs[b_idx] = array_element_struct;
                g_bss_sym_element_strides[b_idx] = array_element_stride;
                g_bss_sym_element_counts[b_idx] = array_element_count;
                g_bss_sym_type_refs[b_idx] = decl_node.first_child;
                g_bss_sym_initial_bits[b_idx] = initial_bits;
                g_bss_sym_initial_stride[b_idx] = initial_stride;
                g_bss_sym_initial_start[b_idx] = initial_start;
                g_bss_sym_initial_count[b_idx] = initial_count;
                g_bss_sym_count = b_idx + 1;
                if initial_bits != 0 { g_data_total_size = bss_off + var_size; }
                else { g_bss_total_size = bss_off + var_size; }
            }
        }
        struct_scan_index = decl_node.next_sibling;
    }

    unsafe { g_extended_len = lowering.source_len; }
    let mut function_index: usize = module_node.first_child;
    while function_index != 0 {
        if function_index >= lowering.node_count {
            return lowering.reject(function_index);
        }
        let function_node: AstNode = unsafe { *(lowering.nodes + function_index) };
        if function_node.kind == AstKind::Import
            || function_node.kind == AstKind::StructDecl
            || function_node.kind == AstKind::EnumDecl
            || function_node.kind == AstKind::MeshDecl
            || function_node.kind == AstKind::LetStmt {
            function_index = function_node.next_sibling;
            continue;
        }
        if function_node.kind == AstKind::ImplDecl {
            let struct_id: u32 = lowering.find_struct(function_node.str_offset, function_node.str_len);
            let mut method_index: usize = function_node.first_child;
            while method_index != 0 {
                if method_index >= lowering.node_count { return lowering.reject(method_index); }
                let method_node: AstNode = unsafe { *(lowering.nodes + method_index) };
                if method_node.kind == AstKind::FnDecl {
                    let fn_name: TargetSourceSlice = lowering.append_mangled_name(
                        function_node.str_offset, function_node.str_len,
                        method_node.str_offset, method_node.str_len
                    );
                    if !lowering.lower_declared_function(method_node, method_index, fn_name, struct_id) {
                        if lowering.error_node != 0 {
                            return false;
                        }
                        return lowering.reject(method_index);
                    }
                }
                method_index = method_node.next_sibling;
            }
            function_index = function_node.next_sibling;
            continue;
        }
        if function_node.kind != AstKind::FnDecl {
            return lowering.reject(function_index);
        }
        let fn_name: TargetSourceSlice = TargetSourceSlice {
            offset: function_node.str_offset,
            length: function_node.str_len
        };
        if !lowering.lower_declared_function(function_node, function_index, fn_name, 0) {
            if lowering.error_node != 0 {
                return false;
            }
            return lowering.reject(function_index);
        }
        function_index = function_node.next_sibling;
    }

    if lowering.function_count == 0 {
        return lowering.reject(module_index);
    }
    output.version = TARGET_IR_VERSION;
    output.function_count = lowering.function_count as u32;
    output.parameter_count = lowering.parameter_count as u32;
    output.block_count = lowering.block_count as u32;
    output.instruction_count = lowering.instruction_count as u32;
    output.value_count = lowering.value_count as u32;
    output.operand_count = lowering.operand_count as u32;
    output.phi_input_count = lowering.phi_input_count as u32;
    output.target_count = lowering.target_count as u32;
    return true;
}

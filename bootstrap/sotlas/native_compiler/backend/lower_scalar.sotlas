                unsafe { *(self.instructions + alloc_idx) = instr; }

                if unsafe { g_bss_sym_is_array[gi] } != 0 || self.global_record_id(expression_index) != 0 {
                    return ptr_val;
                }
                let mut actual_type: TargetTypeTag = type_tag;
                if type_tag == TargetTypeTag::Invalid || type_tag == TargetTypeTag::Void {
                    actual_type = unsafe { g_bss_sym_types[gi] } as TargetTypeTag;
                }
                let val_id: u32 = self.append_value(actual_type, 0, 0);
                let first_op: u32 = self.operand_count as u32;
                if !self.append_operand(ptr_val) { return TARGET_VALUE_NONE; }
                if !self.append_instruction(
                    TargetOpcode::Load, val_id, actual_type,
                    first_op, 1, expression_index
                ) {
                    return TARGET_VALUE_NONE;
                }
                let load_idx: usize = self.instruction_count - 1;
                unsafe { (*(self.instructions + load_idx)).immediate_bits = 0; }
                return val_id;
            }
            return TARGET_VALUE_NONE;
        }
        if expression.kind == AstKind::ExprUnary
            && expression.int_value == 82 {
            let operand_index: usize = expression.first_child;

            if self.structured_cfg && field != 0 {
                let element: TargetTypeTag = self.field_array_types[field as usize - 1] as TargetTypeTag;
                if type_tag != TargetTypeTag::Invalid && type_tag != element { return 0; }
                let address: u32 = self.cfg_field_array_index_address(expression_index, field, first_parameter, parameter_count);
                let result: u32 = self.append_value(element, 0, 0);
                let first: u32 = self.operand_count as u32;

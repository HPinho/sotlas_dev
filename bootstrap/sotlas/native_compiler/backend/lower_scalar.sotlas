                if type_tag != TargetTypeTag::Invalid && type_tag != cast_type { return 0; }
                let operand: u32 = self.lower_expression(value_index, numeric_source, first_parameter, parameter_count);
                let first: u32 = self.operand_count as u32;
                if operand == 0 || !self.append_operand(operand) { return 0; }
                let value: u32 = self.append_value(cast_type, 0, 0);

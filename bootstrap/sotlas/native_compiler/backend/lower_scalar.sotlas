            }
            let mut numeric_source: TargetTypeTag = self.condition_expression_type(value_index, first_parameter, parameter_count);
            if numeric_source == TargetTypeTag::Invalid {
                let mut literal: AstNode = value_node;
                let mut negative: bool = false;
                if literal.kind == AstKind::ExprUnary && literal.int_value == 81
                    && literal.first_child != 0 && literal.first_child < self.node_count {

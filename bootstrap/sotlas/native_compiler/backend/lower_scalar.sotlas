                return TARGET_VALUE_NONE;
            }
            if self.structured_cfg && type_tag == TargetTypeTag::Pointer
                && self.pointer_pointee_struct_id(pointer_type_ref) != 0 {
                return self.cfg_struct_address(expression_index, first_parameter, parameter_count, 0);
            }
            let pointee_type: TargetTypeTag = self.pointer_pointee_type_tag(
                pointer_type_ref
            );
            if pointee_type == TargetTypeTag::Invalid {
                return TARGET_VALUE_NONE;
            }
            if type_tag != TargetTypeTag::Invalid && type_tag != TargetTypeTag::Void
                && type_tag != pointee_type {
                return TARGET_VALUE_NONE;
            }
            let pointer_value: u32 = self.lower_expression(
                operand_index, TargetTypeTag::Pointer,
                first_parameter, parameter_count
            );
            if pointer_value == TARGET_VALUE_NONE {
                return TARGET_VALUE_NONE;
            }
            let first_operand: u32 = self.operand_count as u32;
            if !self.append_operand(pointer_value) {
                return TARGET_VALUE_NONE;
            }
            let result: u32 = self.append_value(pointee_type, 0, 0);
            if result == TARGET_VALUE_NONE || !self.append_instruction(
                TargetOpcode::Load, result, pointee_type,
                first_operand, 1, expression_index
            ) {
                return TARGET_VALUE_NONE;
            }
            let load_index: usize = self.instruction_count - 1;
            unsafe {
                (*(self.instructions + load_index)).immediate_bits = 0;
            }
            return result;
        }
        if expression.kind == AstKind::ExprCast {
            let value_index: usize = expression.first_child;
            if value_index == 0 || value_index >= self.node_count {
                return TARGET_VALUE_NONE;
            }
            let value_node: AstNode = unsafe { *(self.nodes + value_index) };
            let cast_type_index: usize = value_node.next_sibling;
            if cast_type_index == 0 || cast_type_index >= self.node_count
                || unsafe { (*(self.nodes + cast_type_index)).next_sibling } != 0 {
                return TARGET_VALUE_NONE;
            }
            let cast_type: TargetTypeTag = self.type_tag_for(cast_type_index);
            let mut address_source: TargetTypeTag = self.condition_expression_type(value_index,first_parameter,parameter_count);
            if cast_type == TargetTypeTag::Pointer && value_node.kind == AstKind::ExprLiteral
                && value_node.str_len != 0 && value_node.str_offset < self.source_len {
                let address_first: u8 = unsafe{*(self.source+value_node.str_offset)};
                if address_first >= 48 && address_first <= 57 { address_source=TargetTypeTag::U64; }
            }
            if (address_source == TargetTypeTag::Pointer && (cast_type == TargetTypeTag::U64 || cast_type == TargetTypeTag::Usize))
                || (cast_type == TargetTypeTag::Pointer && (address_source == TargetTypeTag::U64 || address_source == TargetTypeTag::Usize)
                    && !(value_node.kind == AstKind::ExprUnary && value_node.int_value == 92)) {

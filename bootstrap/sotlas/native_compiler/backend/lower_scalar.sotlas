            let field: u32 = self.indexed_array_field(expression_index);
            if self.structured_cfg && field == 0 && self.global_array_record_id(expression.first_child) != 0 {
                if type_tag != TargetTypeTag::Pointer { return 0; }
                return self.cfg_field_array_index_address(expression_index,0,first_parameter,parameter_count);
            }
            if field != 0 && self.field_array_structs[field as usize - 1] != 0 {

                    let target_struct: u32 = self.pointer_pointee_struct_id(cast_type_index);
                    let source_element: TargetTypeTag = self.pointer_pointee_type_tag(source_ref);
                    let target_element: TargetTypeTag = self.pointer_pointee_type_tag(cast_type_index);
                    let mut cast_sema: Sema = Sema::new();
                    let reinterpret: bool = source_struct == 0 && target_struct == 0
                        && ((target_type_is_integer(source_element) && target_type_is_float(target_element))
                            || (target_type_is_float(source_element) && target_type_is_integer(target_element)))
                        && self.scalar_memory_size(source_element) == self.scalar_memory_size(target_element)
                        && cast_sema.is_in_unsafe_block(self.nodes, self.node_count, expression_index);
                    if (type_tag != TargetTypeTag::Invalid && type_tag != TargetTypeTag::Pointer)

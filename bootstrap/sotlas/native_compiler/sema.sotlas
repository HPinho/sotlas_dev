module sotlas::compiler::sema;

import sotlas::compiler::token::*;
import sotlas::compiler::ast::*;


// Checked numeric slices are shared by literal decoding and fixed array shapes.
pub fn native_unsigned_slice(bytes: *const u8, length: usize, output: *mut u64) -> bool {
    if bytes == null || output == null || length == 0 { return false; }
    let mut radix: u64=10;let mut index: usize=0;
    if length >= 2 && unsafe{*bytes} == 48 {
        let marker: u8=unsafe{*(bytes+1)};
        if marker == 120 || marker == 88 { radix=16;index=2; }
        if marker == 98 || marker == 66 { radix=2;index=2; }
        if marker == 111 || marker == 79 { radix=8;index=2; }
    }
    let mut value: u64=0;let mut saw: bool=false;let mut separated: bool=false;
    let maximum: u64=18446744073709551615;
    while index < length {
        let ch: u8=unsafe{*(bytes+index)};
        if ch == 95 {
            if !saw || separated || index+1 == length { return false; }
            separated=true;
        } else {
            let mut digit: u64=255;
            if ch >= 48 && ch <= 57 { digit=(ch-48) as u64; }
            if ch >= 65 && ch <= 70 { digit=(ch-55) as u64; }
            if ch >= 97 && ch <= 102 { digit=(ch-87) as u64; }
            if digit >= radix || value > (maximum-digit)/radix { return false; }
            value=value*radix+digit;saw=true;separated=false;
        }
        index=index+1;
    }
    if !saw { return false; }unsafe{*output=value;}return true;
}

pub fn native_fixed_array_count(bytes: *const u8, length: usize) -> usize {
    if bytes == null || length < 5 || unsafe{*bytes} != 91 { return 0; }
    let mut index: usize=1;
    while index < length && unsafe{*(bytes+index)} != 59 { index=index+1; }
    if index == length { return 0; }index=index+1;
    while index < length && (unsafe{*(bytes+index)} == 32 || unsafe{*(bytes+index)} == 9
        || unsafe{*(bytes+index)} == 10 || unsafe{*(bytes+index)} == 13) { index=index+1; }
    let first: usize=index;
    while index < length && unsafe{*(bytes+index)} != 93 { index=index+1; }
    if index == length { return 0; }let mut end: usize=index;index=index+1;
    while end > first && (unsafe{*(bytes+end-1)} == 32 || unsafe{*(bytes+end-1)} == 9
        || unsafe{*(bytes+end-1)} == 10 || unsafe{*(bytes+end-1)} == 13) { end=end-1; }
    while index < length {
        let ch: u8=unsafe{*(bytes+index)};
        if ch != 32 && ch != 9 && ch != 10 && ch != 13 { return 0; }index=index+1;
    }
    let mut count: u64=0;
    if !native_unsigned_slice(unsafe{bytes+first},end-first,unsafe{(&mut count) as *mut u64}) { return 0; }
    return count as usize;
}

pub const MAX_SYMBOLS: usize = 4096;

pub enum SymbolKind {
    Unknown = 0,
    Variable = 1,
    Function = 2,
    Type = 3
}

pub struct Symbol {
    pub kind: SymbolKind;
    pub str_offset: usize;
    pub str_len: usize;
    pub is_system: bool;
    pub is_sole: bool;
    pub is_borrowed: bool;
    pub is_moved: bool;
}

pub struct Sema {
    pub error_count: usize;
    pub error_line: u32;
    pub error_col: u32;
    pub ownership_error_reason: u32;
    pub is_in_system: bool;
    pub is_in_unsafe: bool;
    pub symbol_count: usize;
}

impl Sema {
    pub fn new() -> Sema {
        return Sema {
            error_count: 0,
            error_line: 0,
            error_col: 0,
            ownership_error_reason: 0,
            is_in_system: false,
            is_in_unsafe: false,
            symbol_count: 0
        };
    }

    pub fn enter_system(mut self: &mut Self) {
        self.is_in_system = true;
    }

    pub fn exit_system(mut self: &mut Self) {
        self.is_in_system = false;
    }

    pub fn enter_unsafe(mut self: &mut Self) {
        self.is_in_unsafe = true;
    }

    pub fn exit_unsafe(mut self: &mut Self) {
        self.is_in_unsafe = false;
    }

    pub fn check_system_privilege(mut self: &mut Self) -> bool {
        if !self.is_in_system && !self.is_in_unsafe {
            self.error_count = self.error_count + 1;
            return false;
        }
        return true;
    }

    pub fn check_sole_access(mut self: &mut Self, is_moved: bool) -> bool {
        if is_moved {
            self.error_count = self.error_count + 1;
            return false; // Valor jÃ¡ transferido via handover
        }
        return true;
    }

    pub fn can_borrow_whisper(mut self: &mut Self, is_moved: bool) -> bool {
        if is_moved {
            self.error_count = self.error_count + 1;
            return false;
        }
        return true;
    }

    pub fn add_symbol(mut self: &mut Self, kind: SymbolKind, offset: usize, len: usize, is_sys: bool) -> bool {
        if self.symbol_count >= MAX_SYMBOLS {
            return false;
        }
        self.symbol_count = self.symbol_count + 1;
        return true;
    }

    pub fn declaration_namespace(self: &Self, kind: AstKind) -> i64 {
        if kind == AstKind::FnDecl || kind == AstKind::TrapfnDecl {
            return 1;
        }
        if kind == AstKind::StructDecl
            || kind == AstKind::EnumDecl
            || kind == AstKind::MeshDecl
            || kind == AstKind::SpecDecl {
            return 2;
        }
        return 0;
    }

    pub fn same_declaration_name(
        self: &Self,
        source: *const u8,
        source_len: usize,
        left: AstNode,
        right: AstNode
    ) -> bool {
        if left.str_len != right.str_len
            || left.str_offset > source_len
            || right.str_offset > source_len {
            return false;
        }
        if left.str_len > source_len - left.str_offset
            || right.str_len > source_len - right.str_offset {
            return false;
        }
        let mut index: usize = 0;
        while index < left.str_len {
            let left_byte: u8 = unsafe { *(source + left.str_offset + index) };
            let right_byte: u8 = unsafe { *(source + right.str_offset + index) };
            if left_byte != right_byte {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    pub fn reject_node(mut self: &mut Self, node: AstNode) -> bool {
        self.error_count = self.error_count + 1;
        self.error_line = node.span.line;
        self.error_col = node.span.col;
        return false;
    }

    pub fn is_in_unsafe_block(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        node_index: usize
    ) -> bool {
        if nodes == null || node_index == 0 || node_index >= node_count {
            return false;
        }
        let mut parent_index: usize = unsafe { (*(nodes + node_index)).parent };
        let mut traversed: usize = 0;
        while parent_index != 0 && traversed < node_count {
            if parent_index >= node_count {
                return false;
            }
            let parent: AstNode = unsafe { *(nodes + parent_index) };
            if parent.kind == AstKind::UnsafeBlock
                || parent.kind == AstKind::UnsafeExpr {
                return true;
            }
            if parent.kind == AstKind::FnDecl
                || parent.kind == AstKind::TrapfnDecl
                || parent.kind == AstKind::Module {
                return false;
            }
            parent_index = parent.parent;
            traversed = traversed + 1;
        }
        return false;
    }

    // Fixed scalar arrays contain no aliases or resource handles. Keep this
    // field-only contract aligned with the native record layout's 256 limit.
    pub fn ownership_pod_array(self: &Self, node: AstNode,
        source: *const u8, source_len: usize) -> bool {
        if source == null || node.str_offset > source_len
            || node.str_len > source_len - node.str_offset || node.str_len < 5 { return false; }
        let end: usize = node.str_offset + node.str_len;
        let mut cursor: usize = node.str_offset;
        if unsafe { *(source + cursor) } != 91 { return false; }
        cursor = cursor + 1;
        while cursor < end && unsafe { *(source + cursor) } == 32 { cursor = cursor + 1; }
        let start: usize = cursor;
        while cursor < end && unsafe { *(source + cursor) } != 59 { cursor = cursor + 1; }
        if cursor == end { return false; }
        let mut type_end: usize = cursor;
        while type_end > start && unsafe { *(source + type_end - 1) } == 32 { type_end = type_end - 1; }
        let length: usize = type_end - start;
        let scalar: bool = self.source_slice_equals(source,source_len,start,length,"bool",4)
            || self.source_slice_equals(source,source_len,start,length,"u8",2)
            || self.source_slice_equals(source,source_len,start,length,"i8",2)
            || self.source_slice_equals(source,source_len,start,length,"u16",3)
            || self.source_slice_equals(source,source_len,start,length,"i16",3)
            || self.source_slice_equals(source,source_len,start,length,"u32",3)
            || self.source_slice_equals(source,source_len,start,length,"i32",3)
            || self.source_slice_equals(source,source_len,start,length,"u64",3)
            || self.source_slice_equals(source,source_len,start,length,"i64",3)
            || self.source_slice_equals(source,source_len,start,length,"usize",5)
            || self.source_slice_equals(source,source_len,start,length,"isize",5)
            || self.source_slice_equals(source,source_len,start,length,"f32",3)
            || self.source_slice_equals(source,source_len,start,length,"f64",3);
        if !scalar { return false; }
        let count: usize=native_fixed_array_count(unsafe{source+node.str_offset},node.str_len);
        return count != 0 && count <= 256;
    }

    pub fn ownership_pod_type(self: &Self, nodes: *const AstNode,
        node_count: usize, typ: usize, source: *const u8, source_len: usize, depth: usize) -> bool {
        if typ == 0 || typ >= node_count || depth >= 32 { return false; }
        let node: AstNode = unsafe { *(nodes + typ) };
        if self.fixed_integer_type_tag(nodes, node_count, typ, source, source_len) != 0
            || self.source_slice_equals(source, source_len, node.str_offset, node.str_len, "bool", 4)
            || self.source_slice_equals(source, source_len, node.str_offset, node.str_len, "f32", 3)
            || self.source_slice_equals(source, source_len, node.str_offset, node.str_len, "f64", 3) { return true; }
        let mut index: usize = 1;
        let impl_index: usize = self.enclosing_impl(nodes,node_count,typ);
        while index < node_count {
            let declaration: AstNode = unsafe { *(nodes + index) };
            let self_type: bool = self.source_slice_equals(source,source_len,node.str_offset,node.str_len,"Self",4)
                && impl_index != 0 && impl_index < node_count
                && self.same_source_text(source,source_len,unsafe { *(nodes + impl_index) },declaration);
            if declaration.kind == AstKind::StructDecl && (self.same_source_text(source, source_len, node, declaration) || self_type) {
                let mut field: usize = declaration.first_child;
                while field != 0 {
                    if field >= node_count { return false; }
                    let member: AstNode = unsafe { *(nodes + field) };
                    if member.first_child == 0 || member.first_child >= node_count
                        || unsafe { (*(nodes + member.first_child)).int_value } != 0
                        || (!self.ownership_pod_array(unsafe { *(nodes + member.first_child) }, source, source_len)
                            && !self.ownership_pod_type(nodes, node_count, member.first_child, source, source_len, depth + 1)) { return false; }
                    field = member.next_sibling;
                }
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    pub fn ownership_called_function(self: &Self, nodes: *const AstNode,
        count: usize, call_index: usize, source: *const u8, length: usize) -> usize {
        if call_index == 0 || call_index >= count { return 0; }
        let call: AstNode = unsafe { *(nodes + call_index) };
        if call.kind != AstKind::ExprCall || call.first_child == 0 || call.first_child >= count { return 0; }
        let callee: AstNode = unsafe { *(nodes + call.first_child) };
        if callee.kind == AstKind::ExprIdent {
            return self.find_module_function(nodes, count, call.first_child, source, length);
        }
        let module_index: usize = self.find_enclosing_module(nodes, count, call_index);
        if module_index == 0 || module_index >= count { return 0; }
        if callee.kind == AstKind::ExprPath {
            return self.find_static_impl_method_for_path(nodes, count, module_index, call.first_child, source, length);
        }
        if callee.kind != AstKind::ExprFieldAccess { return 0; }
        let record_index: usize = self.find_struct_for_receiver(nodes, count, callee.first_child, source, length);
        if record_index == 0 || record_index >= count { return 0; }
        let record: AstNode = unsafe { *(nodes + record_index) };
        let mut declaration: usize = unsafe { (*(nodes + module_index)).first_child };
        let mut found: usize = 0;
        while declaration != 0 && declaration < count {
            let impl_node: AstNode = unsafe { *(nodes + declaration) };
            if impl_node.kind == AstKind::ImplDecl && self.same_source_text(source, length, impl_node, record) {
                let mut child: usize = impl_node.first_child;
                while child != 0 && child < count {
                    let method: AstNode = unsafe { *(nodes + child) };
                    if method.kind == AstKind::FnDecl && self.same_source_text(source, length, method, callee) {
                        if found != 0 { return 0; }
                        found = child;
                    }
                    child = method.next_sibling;
                }
            }
            declaration = impl_node.next_sibling;
        }
        return found;
    }

    pub fn check_native_ownership(mut self: &mut Self, nodes: *const AstNode,
        node_count: usize, source: *const u8, source_len: usize) -> bool {
        let mut any_owned: bool = false; let mut index: usize = 1;
        while index < node_count {
            let node: AstNode = unsafe { *(nodes + index) };
            if node.kind == AstKind::TypeRef && node.int_value != 0 {
                if (node.int_value != 1 && node.int_value != 4 && node.int_value != 6) || !self.ownership_pod_type(nodes, node_count, index, source, source_len, 0)
                    || node.parent == 0 || node.parent >= node_count { return self.reject_node(node); }
                let parent: AstNode = unsafe { *(nodes + node.parent) };
                if (node.int_value == 4 || node.int_value == 6) && parent.kind != AstKind::ParamDecl { return self.reject_node(node); }
                if parent.kind == AstKind::FieldDecl || parent.kind == AstKind::ExprCast
                    || (parent.kind == AstKind::LetStmt && parent.parent != 0
                        && unsafe { (*(nodes + parent.parent)).kind } == AstKind::Module) { return self.reject_node(node); }
                any_owned = true;
            }
            index = index + 1;
        }
        if !any_owned { return true; }
        index = 1;
        while index < node_count {
            let function: AstNode = unsafe { *(nodes + index) };
            if function.kind == AstKind::FnDecl || function.kind == AstKind::TrapfnDecl {
                let mut owns: bool = false; let mut scan: usize = 1;
                while scan < node_count {
                    let node: AstNode = unsafe { *(nodes + scan) };
                    let mut transfers: bool = node.kind == AstKind::TypeRef && node.int_value != 0;
                    if node.kind == AstKind::ExprCall && node.first_child != 0 && node.first_child < node_count {
                        let called: usize = self.ownership_called_function(nodes, node_count, scan, source, source_len);
                        if called != 0 {
                            let mut result: usize = unsafe { (*(nodes + called)).first_child };
                            while result != 0 && result < node_count {
                                let result_node: AstNode = unsafe { *(nodes + result) };
                                if result_node.kind == AstKind::TypeRef && result_node.int_value != 0 { transfers = true; }
                                result = result_node.next_sibling;
                            }
                        }
                    }
                    if transfers {
                        let mut ancestor: usize = node.parent; let mut traversed: usize = 0;
                        while ancestor != 0 && ancestor < node_count && traversed < node_count {
                            if ancestor == index { owns = true; break; }
                            ancestor = unsafe { (*(nodes + ancestor)).parent }; traversed = traversed + 1;
                        }
                    }
                    scan = scan + 1;
                }
                if owns {
                    let mut analysis: NativeOwnershipCheck = NativeOwnershipCheck {
                        nodes:nodes,node_count:node_count,source:source,source_len:source_len,
                        bindings:[0;256],states:[0;256],domains:[0;256],deferred:[0;256],mixed_break_states:[0;256],count:0,error_node:0,error_reason:0,return_domain:0
                    };
                    let mut child: usize = function.first_child; let mut body: usize = 0;
                    while child != 0 {
                        if child >= node_count { return self.reject_node(function); }
                        let node: AstNode = unsafe { *(nodes + child) };
                        if node.kind == AstKind::ParamDecl && !analysis.bind(child) { return self.reject_node(node); }
                        if node.kind == AstKind::TypeRef { analysis.return_domain = node.int_value; }
                        if node.kind == AstKind::Block { body = child; }
                        child = node.next_sibling;
                    }
                    if body == 0 { return self.reject_node(function); }
                    if analysis.sequence(unsafe { (*(nodes + body)).first_child }, 0) == 0 {
                        self.ownership_error_reason = analysis.error_reason;
                        if analysis.error_node == 0 || analysis.error_node >= node_count { return self.reject_node(function); }
                        return self.reject_node(unsafe { *(nodes + analysis.error_node) });
                    }
                }
            }
            index = index + 1;
        }
        return true;
    }

    pub fn check_top_level_declarations(
        mut self: &mut Self,
        nodes: *const AstNode,
        node_count: usize,
        module_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        if nodes == null || source == null || module_index == 0
            || module_index >= node_count {
            self.error_count = self.error_count + 1;
            return false;
        }

        let module_node: AstNode = unsafe { *(nodes + module_index) };
        if module_node.kind != AstKind::Module {
            self.error_count = self.error_count + 1;
            self.error_line = module_node.span.line;
            self.error_col = module_node.span.col;
            return false;
        }

        let mut current_index: usize = module_node.first_child;
        let mut declaration_count: usize = 0;
        while current_index != 0 {
            if current_index >= node_count {
                self.error_count = self.error_count + 1;
                return false;
            }
            declaration_count = declaration_count + 1;
            if declaration_count > MAX_SYMBOLS {
                let overflow: AstNode = unsafe { *(nodes + current_index) };
                self.error_count = self.error_count + 1;
                self.error_line = overflow.span.line;
                self.error_col = overflow.span.col;
                return false;
            }
            let current: AstNode = unsafe { *(nodes + current_index) };
            let namespace: i64 = self.declaration_namespace(current.kind);
            if namespace != 0 && current.str_len != 0 {
                let mut previous_index: usize = module_node.first_child;
                while previous_index != current_index {
                    if previous_index == 0 || previous_index >= node_count {
                        self.error_count = self.error_count + 1;
                        return false;
                    }
                    let previous: AstNode = unsafe { *(nodes + previous_index) };
                    if self.declaration_namespace(previous.kind) == namespace
                        && self.same_declaration_name(
                            source, source_len, previous, current
                        ) {
                        self.error_count = self.error_count + 1;
                        self.error_line = current.span.line;
                        self.error_col = current.span.col;
                        return false;
                    }
                    previous_index = previous.next_sibling;
                }
            }
            if current.kind == AstKind::ImplDecl
                && !self.check_impl_declaration(
                    nodes,
                    node_count,
                    module_index,
                    current_index,
                    source,
                    source_len
                ) {
                return false;
            }
            current_index = current.next_sibling;
        }

        if !self.check_native_ownership(nodes, node_count, source, source_len) { return false; }
        let mut node_index: usize = 1;
        while node_index < node_count {
            let node: AstNode = unsafe { *(nodes + node_index) };
            if node.kind == AstKind::ExprUnary && node.int_value == 82
                && !self.is_in_unsafe_block(nodes, node_count, node_index)
                && !self.expression_is_borrow_deref(
                    nodes, node_count, node_index, source, source_len
                ) {
                self.error_count = self.error_count + 1;
                self.error_line = node.span.line;
                self.error_col = node.span.col;
                return false;
            }
            if node.kind == AstKind::FnDecl || node.kind == AstKind::TrapfnDecl {
                if !self.check_function_parameters(nodes, node_count, node_index, source, source_len) {
                    return false;
                }
                if !self.check_function_return_paths(
                    nodes, node_count, node_index, source, source_len
                ) {
                    return false;
                }
            }
            if node.kind == AstKind::Block {
                if !self.check_block_locals(nodes, node_count, node_index, source, source_len) {
                    return false;
                }
            }
            if node.kind == AstKind::ExprStructLiteral
                && !self.check_struct_literal(
                    nodes, node_count, node_index, source, source_len
                ) {
                return false;
            }
            if node.kind == AstKind::ExprArrayRepeat
                && !self.check_array_repeat_context(
                    nodes, node_count, node_index, source, source_len
                ) {
                return false;
            }
            if node.kind == AstKind::BreakStmt
                || node.kind == AstKind::ContinueStmt
                || node.kind == AstKind::ReturnStmt {
                if !self.check_control_context(nodes, node_count, node_index) {
                    return false;
                }
            }
            if node.kind == AstKind::ExprIdent
                && !self.check_local_reference(
                    nodes, node_count, node_index, source, source_len
                ) {
                return false;
            }
            if node.kind == AstKind::ExprCall
                && !self.check_call_arity(
                    nodes, node_count, node_index, source, source_len
                ) {
                return false;
            }
            if node.kind == AstKind::ExprCall
                && !self.check_qualified_static_call(
                    nodes,
                    node_count,
                    module_index,
                    node_index,
                    source,
                    source_len
                ) {
                return false;
            }
            if node.kind == AstKind::ExprCall
                && !self.check_call_argument_types(
                    nodes, node_count, node_index, source, source_len
                ) {
                return false;
            }
            if node.kind == AstKind::ReturnStmt
                && !self.check_return_type(
                    nodes, node_count, node_index, source, source_len
                ) {
                return false;
            }
            if node.kind == AstKind::AssignStmt {
                let target_index: usize = node.first_child;
                if target_index == 0 || target_index >= node_count {
                    self.error_count = self.error_count + 1;
                    self.error_line = node.span.line;
                    self.error_col = node.span.col;
                    return false;
                }
                let assignment_target: AstNode = unsafe { *(nodes + target_index) };
                if assignment_target.kind == AstKind::ExprUnary && assignment_target.int_value == 82 {
                    if assignment_target.first_child == 0 || assignment_target.first_child >= node_count {
                        self.error_count = self.error_count + 1;
                        self.error_line = assignment_target.span.line;
                        self.error_col = assignment_target.span.col;
                        return false;
                    }
                    if !self.is_in_unsafe_block(nodes, node_count, target_index)
                        && !self.expression_is_mutable_borrow_deref(
                            nodes, node_count, target_index, source, source_len
                        ) {
                        return self.reject_node(assignment_target);
                    }
                } else {
                    let mut base_ident_index: usize = target_index;
                    let mut base_node: AstNode = assignment_target;
                    let mut field_depth: usize = 0;
                    while base_node.kind == AstKind::ExprFieldAccess
                        || base_node.kind == AstKind::ExprIndex {
                        base_ident_index = base_node.first_child;
                        if base_ident_index == 0 || base_ident_index >= node_count
                            || field_depth >= node_count {
                            self.error_count = self.error_count + 1;
                            self.error_line = assignment_target.span.line;
                            self.error_col = assignment_target.span.col;
                            return false;
                        }
                        base_node = unsafe { *(nodes + base_ident_index) };
                        field_depth = field_depth + 1;
                    }
                    if base_node.kind == AstKind::ExprUnary && base_node.int_value == 82 {
                        if base_node.first_child == 0 || base_node.first_child >= node_count {
                            self.error_count = self.error_count + 1;
                            self.error_line = assignment_target.span.line;
                            self.error_col = assignment_target.span.col;
                            return false;
                        }
                        if !self.is_in_unsafe_block(nodes, node_count, base_ident_index)
                            && !self.expression_is_mutable_borrow_deref(
                                nodes, node_count, base_ident_index, source, source_len
                            ) {
                            return self.reject_node(assignment_target);
                        }
                    } else {
                        if base_node.kind != AstKind::ExprIdent {
                            self.error_count = self.error_count + 1;
                            self.error_line = assignment_target.span.line;
                            self.error_col = assignment_target.span.col;
                            return false;
                        }
                        let binding_index: usize = self.find_visible_binding(
                            nodes, node_count, base_ident_index, source, source_len
                        );
                        if binding_index == 0 || binding_index >= node_count {
                            self.error_count = self.error_count + 1;
                            self.error_line = assignment_target.span.line;
                            self.error_col = assignment_target.span.col;
                            return false;
                        }
                        let binding: AstNode = unsafe { *(nodes + binding_index) };
                        if binding.int_value != 1
                            && (field_depth == 0 || binding.kind != AstKind::ParamDecl
                                || !self.binding_is_mutable_borrow(
                                    nodes, node_count, binding_index, source, source_len
                                )) {
                            self.error_count = self.error_count + 1;
                            self.error_line = assignment_target.span.line;
                            self.error_col = assignment_target.span.col;
                            return false;
                        }
                    }
                }
            }
            node_index = node_index + 1;
        }
        return true;
    }

    pub fn check_control_context(
        mut self: &mut Self,
        nodes: *const AstNode,
        node_count: usize,
        statement_index: usize
    ) -> bool {
        let statement: AstNode = unsafe { *(nodes + statement_index) };
        let mut parent_index: usize = statement.parent;
        let mut traversed: usize = 0;
        let mut valid_context: bool = false;
        while parent_index != 0 {
            if parent_index >= node_count || traversed >= node_count {
                self.error_count = self.error_count + 1;
                self.error_line = statement.span.line;
                self.error_col = statement.span.col;
                return false;
            }
            let parent: AstNode = unsafe { *(nodes + parent_index) };
            if statement.kind == AstKind::ReturnStmt {
                if parent.kind == AstKind::FnDecl || parent.kind == AstKind::TrapfnDecl {
                    valid_context = true;
                    break;
                }
            } else {
                if parent.kind == AstKind::FnDecl || parent.kind == AstKind::TrapfnDecl {
                    break;
                }
                if parent.kind == AstKind::WhileStmt {
                    valid_context = true;
                    break;
                }
            }
            parent_index = parent.parent;
            traversed = traversed + 1;
        }
        if !valid_context {
            self.error_count = self.error_count + 1;
            self.error_line = statement.span.line;
            self.error_col = statement.span.col;
            return false;
        }
        return true;
    }

    pub fn check_local_reference(
        mut self: &mut Self,
        nodes: *const AstNode,
        node_count: usize,
        expression_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        let expression: AstNode = unsafe { *(nodes + expression_index) };
        if self.source_slice_equals(source, source_len, expression.str_offset, expression.str_len, "null", 4) {
            return true;
        }
        let parent_index: usize = expression.parent;
        if parent_index != 0 && parent_index < node_count {
            let parent: AstNode = unsafe { *(nodes + parent_index) };
            if parent.kind == AstKind::MatchArm && parent.first_child == expression_index
                && self.source_slice_equals(source, source_len, expression.str_offset, expression.str_len, "_", 1) { return true; }
            if parent.kind == AstKind::ExprCall && parent.first_child == expression_index {
                if self.find_module_function(
                    nodes, node_count, expression_index, source, source_len
                ) != 0 {
                    return true;
                }
                self.error_count = self.error_count + 1;
                self.error_line = expression.span.line;
                self.error_col = expression.span.col;
                return false;
            }
        }
        if self.find_visible_binding(
            nodes, node_count, expression_index, source, source_len
        ) != 0 {
            return true;
        }
        self.error_count = self.error_count + 1;
        self.error_line = expression.span.line;
        self.error_col = expression.span.col;
        return false;
    }

    pub fn find_module_function(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        expression_index: usize,
        source: *const u8,
        source_len: usize
    ) -> usize {
        if nodes == null || expression_index == 0 || expression_index >= node_count {
            return 0;
        }
        let expression: AstNode = unsafe { *(nodes + expression_index) };
        let mut parent_index: usize = expression.parent;
        let mut traversed: usize = 0;
        let mut module_index: usize = 0;
        while parent_index != 0 {
            if parent_index >= node_count || traversed >= node_count {
                return 0;
            }
            let parent: AstNode = unsafe { *(nodes + parent_index) };
            if parent.kind == AstKind::Module {
                module_index = parent_index;
                break;
            }
            parent_index = parent.parent;
            traversed = traversed + 1;
        }
        if module_index == 0 {
            return 0;
        }

        let module_node: AstNode = unsafe { *(nodes + module_index) };
        let mut declaration_index: usize = module_node.first_child;
        let mut declaration_count: usize = 0;
        while declaration_index != 0 {
            if declaration_index >= node_count || declaration_count >= MAX_SYMBOLS {
                return 0;
            }
            let declaration: AstNode = unsafe { *(nodes + declaration_index) };
            if (declaration.kind == AstKind::FnDecl
                || declaration.kind == AstKind::TrapfnDecl)
                && self.same_declaration_name(
                    source, source_len, declaration, expression
                ) {
                return declaration_index;
            }
            declaration_index = declaration.next_sibling;
            declaration_count = declaration_count + 1;
        }
        return 0;
    }

    pub fn check_call_arity(
        mut self: &mut Self,
        nodes: *const AstNode,
        node_count: usize,
        call_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        if nodes == null || call_index == 0 || call_index >= node_count {
            self.error_count = self.error_count + 1;
            return false;
        }
        let call: AstNode = unsafe { *(nodes + call_index) };
        if call.kind != AstKind::ExprCall || call.first_child == 0
            || call.first_child >= node_count {
            self.error_count = self.error_count + 1;
            self.error_line = call.span.line;
            self.error_col = call.span.col;
            return false;
        }
        let callee: AstNode = unsafe { *(nodes + call.first_child) };
        if callee.kind != AstKind::ExprIdent {
            return true; // Qualified calls are checked by check_qualified_static_call.
        }
        let function_index: usize = self.find_module_function(
            nodes, node_count, call.first_child, source, source_len
        );
        if function_index == 0 {
            return true; // The name check reports the more specific error.
        }
        let function: AstNode = unsafe { *(nodes + function_index) };
        let mut expected: usize = 0;
        let mut child: usize = function.first_child;
        while child != 0 {
            if child >= node_count {
                self.error_count = self.error_count + 1;
                return false;
            }
            let parameter: AstNode = unsafe { *(nodes + child) };
            if parameter.kind == AstKind::ParamDecl {
                expected = expected + 1;
            }
            child = parameter.next_sibling;
        }
        let mut actual: usize = 0;
        child = callee.next_sibling;
        while child != 0 {
            if child >= node_count {
                self.error_count = self.error_count + 1;
                return false;
            }
            actual = actual + 1;
            child = unsafe { (*(nodes + child)).next_sibling };
        }
        if actual != expected {
            self.error_count = self.error_count + 1;
            self.error_line = call.span.line;
            self.error_col = call.span.col;
            return false;
        }
        return true;
    }

    pub fn same_source_text(
        self: &Self,
        source: *const u8,
        source_len: usize,
        left: AstNode,
        right: AstNode
    ) -> bool {
        if left.str_len != right.str_len
            || left.str_offset > source_len
            || right.str_offset > source_len {
            return false;
        }
        if left.str_len > source_len - left.str_offset
            || right.str_len > source_len - right.str_offset {
            return false;
        }
        let mut index: usize = 0;
        while index < left.str_len {
            if unsafe { *(source + left.str_offset + index) }
                != unsafe { *(source + right.str_offset + index) } {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    pub fn source_slices_equal(
        self: &Self,
        source: *const u8,
        source_len: usize,
        left_offset: usize,
        left_len: usize,
        right_offset: usize,
        right_len: usize
    ) -> bool {
        if source == null || left_len != right_len
            || left_offset > source_len || right_offset > source_len
            || left_len > source_len - left_offset
            || right_len > source_len - right_offset {
            return false;
        }
        let mut index: usize = 0;
        while index < left_len {
            if unsafe { *(source + left_offset + index) }
                != unsafe { *(source + right_offset + index) } {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    pub fn source_slice_equals(
        self: &Self,
        source: *const u8,
        source_len: usize,
        offset: usize,
        len: usize,
        expected: *const u8,
        expected_len: usize
    ) -> bool {
        if source == null || expected == null || len != expected_len
            || offset > source_len || len > source_len - offset {
            return false;
        }
        let mut index: usize = 0;
        while index < len {
            if unsafe { *(source + offset + index) }
                != unsafe { *(expected + index) } {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    pub fn source_slice_equals_compact(
        self: &Self,
        source: *const u8,
        source_len: usize,
        offset: usize,
        len: usize,
        expected: *const u8,
        expected_len: usize
    ) -> bool {
        if source == null || expected == null
            || offset > source_len || len > source_len - offset {
            return false;
        }
        let mut source_index: usize = 0;
        let mut expected_index: usize = 0;
        while source_index < len {
            let ch: u8 = unsafe { *(source + offset + source_index) };
            source_index = source_index + 1;
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                continue;
            }
            if expected_index >= expected_len
                || ch != unsafe { *(expected + expected_index) } {
                return false;
            }
            expected_index = expected_index + 1;
        }
        return expected_index == expected_len;
    }

    pub fn fixed_integer_type_tag(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        type_index: usize,
        source: *const u8,
        source_len: usize
    ) -> i64 {
        if nodes == null || source == null || type_index == 0
            || type_index >= node_count {
            return 0;
        }
        let typ: AstNode = unsafe { *(nodes + type_index) };
        if typ.kind != AstKind::TypeRef || typ.str_len == 0 {
            return 0;
        }
        if self.source_slice_equals(source, source_len, typ.str_offset, typ.str_len, "i8", 2) {
            return 1;
        }
        if self.source_slice_equals(source, source_len, typ.str_offset, typ.str_len, "i16", 3) {
            return 2;
        }
        if self.source_slice_equals(source, source_len, typ.str_offset, typ.str_len, "i32", 3) {
            return 3;
        }
        if self.source_slice_equals(source, source_len, typ.str_offset, typ.str_len, "i64", 3) {
            return 4;
        }
        if self.source_slice_equals(source, source_len, typ.str_offset, typ.str_len, "isize", 5) {
            return 4;
        }
        if self.source_slice_equals(source, source_len, typ.str_offset, typ.str_len, "u8", 2) {
            return 5;
        }
        if self.source_slice_equals(source, source_len, typ.str_offset, typ.str_len, "u16", 3) {
            return 6;
        }
        if self.source_slice_equals(source, source_len, typ.str_offset, typ.str_len, "u32", 3) {
            return 7;
        }
        if self.source_slice_equals(source, source_len, typ.str_offset, typ.str_len, "u64", 3) {
            return 8;
        }
        if self.source_slice_equals(source, source_len, typ.str_offset, typ.str_len, "usize", 5) {
            return 8;
        }
        return 0;
    }

    pub fn integer_digit_value(self: &Self, ch: u8, is_hex: bool) -> i64 {
        if ch == 48 { return 0; }
        if ch == 49 { return 1; }
        if ch == 50 { return 2; }
        if ch == 51 { return 3; }
        if ch == 52 { return 4; }
        if ch == 53 { return 5; }
        if ch == 54 { return 6; }
        if ch == 55 { return 7; }
        if ch == 56 { return 8; }
        if ch == 57 { return 9; }
        if is_hex {
            if ch == 65 || ch == 97 { return 10; }
            if ch == 66 || ch == 98 { return 11; }
            if ch == 67 || ch == 99 { return 12; }
            if ch == 68 || ch == 100 { return 13; }
            if ch == 69 || ch == 101 { return 14; }
            if ch == 70 || ch == 102 { return 15; }
        }
        return -1;
    }

    pub fn expression_is_integer_literal(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        expression_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        if nodes == null || source == null || expression_index == 0
            || expression_index >= node_count {
            return false;
        }
        let expression: AstNode = unsafe { *(nodes + expression_index) };
        if expression.kind != AstKind::ExprLiteral || expression.str_len == 0
            || expression.str_offset > source_len
            || expression.str_len > source_len - expression.str_offset {
            return false;
        }
        let first: u8 = unsafe { *(source + expression.str_offset) };
        return (first >= 48 && first <= 57) || first == 39;
    }

    // Decode bounded radix integers and ASCII byte characters without host
    // parsers. Only publish the result after the entire literal is valid.
    pub fn integer_literal_bits(self: &Self, nodes: *const AstNode, node_count: usize,
        literal_index: usize, source: *const u8, source_len: usize, output: *mut u64) -> bool {
        if output == null || !self.expression_is_integer_literal(nodes,node_count,literal_index,source,source_len) { return false; }
        let literal: AstNode = unsafe{*(nodes+literal_index)};
        let bytes: *const u8 = unsafe{source+literal.str_offset};
        if unsafe{*bytes} == 39 {
            if literal.str_len < 3 || unsafe{*(bytes+literal.str_len-1)} != 39 { return false; }
            let mut value: u64 = unsafe{*(bytes+1)} as u64;
            if literal.str_len == 3 {
                if value >= 128 || value == 39 || value == 92 || value == 10 || value == 13 { return false; }
            } else {
                if literal.str_len == 6 && value == 92 && unsafe{*(bytes+2)} == 120 {
                    let high: i64=self.integer_digit_value(unsafe{*(bytes+3)},true);
                    let low: i64=self.integer_digit_value(unsafe{*(bytes+4)},true);
                    if high < 0 || low < 0 { return false; }
                    unsafe{*output=(high*16+low) as u64;}return true;
                }
                if literal.str_len != 4 || value != 92 { return false; }
                let escaped: u8 = unsafe{*(bytes+2)};
                value = escaped as u64;
                if escaped == 48 { value = 0; }
                else if escaped == 110 { value = 10; }
                else if escaped == 114 { value = 13; }
                else if escaped == 116 { value = 9; }
                else if escaped == 98 { value = 8; }
                else if escaped == 102 { value = 12; }
                else if escaped == 118 { value = 11; }
                else if escaped != 39 && escaped != 34 && escaped != 92 { return false; }
            }
            unsafe{*output=value;}return true;
        }
        let mut radix: u64 = 10;let mut index: usize = 0;
        if literal.str_len >= 2 && unsafe{*bytes} == 48 {
            let marker: u8 = unsafe{*(bytes+1)};
            if marker == 120 || marker == 88 { radix=16;index=2; }
            if marker == 98 || marker == 66 { radix=2;index=2; }
            if marker == 111 || marker == 79 { radix=8;index=2; }
        }
        let mut value: u64 = 0;let mut saw_digit: bool = false;
        let maximum: u64 = 18446744073709551615;
        let mut separated: bool = false;
        while index < literal.str_len {
            let ch: u8 = unsafe{*(bytes+index)};
            if ch == 95 {
                if !saw_digit || separated || index+1 == literal.str_len { return false; }
                separated=true;
            } else {
                let decoded: i64 = self.integer_digit_value(ch,radix==16);
                if decoded < 0 || decoded as u64 >= radix { return false; }
                let digit: u64 = decoded as u64;
                if value > (maximum-digit)/radix { return false; }
                value=value*radix+digit;saw_digit=true;separated=false;
            }
            index=index+1;
        }
        if !saw_digit { return false; }
        unsafe{*output=value;}return true;
    }

    pub fn integer_literal_fits_limit(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        literal_index: usize,
        source: *const u8,
        source_len: usize,
        is_hex: bool,
        limit: *const u8,
        limit_len: usize
    ) -> bool {
        if !self.expression_is_integer_literal(
            nodes, node_count, literal_index, source, source_len
        ) || limit == null || limit_len == 0 {
            return false;
        }
        let literal: AstNode = unsafe { *(nodes + literal_index) };
        let mut index: usize = 0;
        if is_hex {
            if literal.str_len < 3
                || unsafe { *(source + literal.str_offset) } != 48 {
                return false;
            }
            let marker: u8 = unsafe { *(source + literal.str_offset + 1) };
            if marker != 120 && marker != 88 {
                return false;
            }
            index = 2;
        }

        let mut saw_digit: bool = false;
        let mut started: bool = false;
        let mut significant_count: usize = 0;
        while index < literal.str_len {
            let ch: u8 = unsafe { *(source + literal.str_offset + index) };
            if ch == 95 {
                index = index + 1;
                continue;
            }
            let digit: i64 = self.integer_digit_value(ch, is_hex);
            if digit < 0 || (!is_hex && digit > 9) {
                return false;
            }
            saw_digit = true;
            if digit != 0 || started {
                started = true;
                significant_count = significant_count + 1;
            }
            index = index + 1;
        }
        if !saw_digit {
            return false;
        }
        if significant_count == 0 {
            return true;
        }
        if significant_count < limit_len {
            return true;
        }
        if significant_count > limit_len {
            return false;
        }

        if is_hex {
            index = 2;
        } else {
            index = 0;
        }
        started = false;
        let mut limit_index: usize = 0;
        while index < literal.str_len {
            let ch: u8 = unsafe { *(source + literal.str_offset + index) };
            if ch == 95 {
                index = index + 1;
                continue;
            }
            let digit: i64 = self.integer_digit_value(ch, is_hex);
            if !started && digit == 0 {
                index = index + 1;
                continue;
            }
            started = true;
            if limit_index >= limit_len {
                return false;
            }
            let limit_ch: u8 = unsafe { *(limit + limit_index) };
            let limit_digit: i64 = self.integer_digit_value(limit_ch, is_hex);
            if limit_digit < 0 {
                return false;
            }
            if digit < limit_digit {
                return true;
            }
            if digit > limit_digit {
                return false;
            }
            limit_index = limit_index + 1;
            index = index + 1;
        }
        return limit_index == limit_len;
    }

    pub fn integer_literal_fits_type(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        type_index: usize,
        literal_index: usize,
        negative: bool,
        source: *const u8,
        source_len: usize
    ) -> bool {
        let tag: i64 = self.fixed_integer_type_tag(
            nodes, node_count, type_index, source, source_len
        );
        if tag == 0 {
            return true;
        }
        if negative && tag >= 5 {
            return false;
        }
        if !self.expression_is_integer_literal(
            nodes, node_count, literal_index, source, source_len
        ) {
            return true;
        }
        let literal: AstNode = unsafe { *(nodes + literal_index) };
        let first: u8 = unsafe{*(source+literal.str_offset)};
        let mut extended: bool = first == 39;
        if literal.str_len >= 2 && first == 48 {
            let prefix: u8 = unsafe{*(source+literal.str_offset+1)};
            extended = prefix == 98 || prefix == 66 || prefix == 111 || prefix == 79;
        }
        if extended {
            let mut magnitude: u64 = 0;
            if !self.integer_literal_bits(nodes,node_count,literal_index,source,source_len,unsafe{(&mut magnitude) as *mut u64}) { return false; }
            let mut maximum: u64 = 18446744073709551615;
            if tag == 1 { maximum=127; }else if tag == 2 { maximum=32767; }
            else if tag == 3 { maximum=2147483647; }else if tag == 4 { maximum=9223372036854775807; }
            else if tag == 5 { maximum=255; }else if tag == 6 { maximum=65535; }
            else if tag == 7 { maximum=4294967295; }
            if negative { maximum=maximum+1; }
            return magnitude <= maximum;
        }
        let is_hex: bool = literal.str_len >= 2
            && unsafe { *(source + literal.str_offset) } == 48
            && (unsafe { *(source + literal.str_offset + 1) } == 120
                || unsafe { *(source + literal.str_offset + 1) } == 88);

        if tag == 1 {
            if is_hex {
                if negative {
                    return self.integer_literal_fits_limit(
                        nodes, node_count, literal_index, source, source_len,
                        true, "80", 2
                    );
                }
                return self.integer_literal_fits_limit(
                    nodes, node_count, literal_index, source, source_len,
                    true, "7f", 2
                );
            }
            if negative {
                return self.integer_literal_fits_limit(
                    nodes, node_count, literal_index, source, source_len,
                    false, "128", 3
                );
            }
            return self.integer_literal_fits_limit(
                nodes, node_count, literal_index, source, source_len,
                false, "127", 3
            );
        }
        if tag == 2 {
            if is_hex {
                if negative {
                    return self.integer_literal_fits_limit(
                        nodes, node_count, literal_index, source, source_len,
                        true, "8000", 4
                    );
                }
                return self.integer_literal_fits_limit(
                    nodes, node_count, literal_index, source, source_len,
                    true, "7fff", 4
                );
            }
            if negative {
                return self.integer_literal_fits_limit(
                    nodes, node_count, literal_index, source, source_len,
                    false, "32768", 5
                );
            }
            return self.integer_literal_fits_limit(
                nodes, node_count, literal_index, source, source_len,
                false, "32767", 5
            );
        }
        if tag == 3 {
            if is_hex {
                if negative {
                    return self.integer_literal_fits_limit(
                        nodes, node_count, literal_index, source, source_len,
                        true, "80000000", 8
                    );
                }
                return self.integer_literal_fits_limit(
                    nodes, node_count, literal_index, source, source_len,
                    true, "7fffffff", 8
                );
            }
            if negative {
                return self.integer_literal_fits_limit(
                    nodes, node_count, literal_index, source, source_len,
                    false, "2147483648", 10
                );
            }
            return self.integer_literal_fits_limit(
                nodes, node_count, literal_index, source, source_len,
                false, "2147483647", 10
            );
        }
        if tag == 4 {
            if is_hex {
                if negative {
                    return self.integer_literal_fits_limit(
                        nodes, node_count, literal_index, source, source_len,
                        true, "8000000000000000", 16
                    );
                }
                return self.integer_literal_fits_limit(
                    nodes, node_count, literal_index, source, source_len,
                    true, "7fffffffffffffff", 16
                );
            }
            if negative {
                return self.integer_literal_fits_limit(
                    nodes, node_count, literal_index, source, source_len,
                    false, "9223372036854775808", 19
                );
            }
            return self.integer_literal_fits_limit(
                nodes, node_count, literal_index, source, source_len,
                false, "9223372036854775807", 19
            );
        }
        if tag == 5 {
            if is_hex { return self.integer_literal_fits_limit(
                nodes, node_count, literal_index, source, source_len,
                true, "ff", 2
            ); }
            return self.integer_literal_fits_limit(
                nodes, node_count, literal_index, source, source_len,
                false, "255", 3
            );
        }
        if tag == 6 {
            if is_hex { return self.integer_literal_fits_limit(
                nodes, node_count, literal_index, source, source_len,
                true, "ffff", 4
            ); }
            return self.integer_literal_fits_limit(
                nodes, node_count, literal_index, source, source_len,
                false, "65535", 5
            );
        }
        if tag == 7 {
            if is_hex { return self.integer_literal_fits_limit(
                nodes, node_count, literal_index, source, source_len,
                true, "ffffffff", 8
            ); }
            return self.integer_literal_fits_limit(
                nodes, node_count, literal_index, source, source_len,
                false, "4294967295", 10
            );
        }
        if is_hex { return self.integer_literal_fits_limit(
            nodes, node_count, literal_index, source, source_len,
            true, "ffffffffffffffff", 16
        ); }
        return self.integer_literal_fits_limit(
            nodes, node_count, literal_index, source, source_len,
            false, "18446744073709551615", 20
        );
    }

    pub fn contextual_integer_expression_fits(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        type_index: usize,
        expression_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        if self.fixed_integer_type_tag(
            nodes, node_count, type_index, source, source_len
        ) == 0 || nodes == null || expression_index == 0
            || expression_index >= node_count {
            return true;
        }
        let expression: AstNode = unsafe { *(nodes + expression_index) };
        if expression.kind == AstKind::ExprLiteral {
            if !self.expression_is_integer_literal(
                nodes, node_count, expression_index, source, source_len
            ) {
                return true;
            }
            return self.integer_literal_fits_type(
                nodes, node_count, type_index, expression_index,
                false, source, source_len
            );
        }
        if expression.kind == AstKind::ExprUnary
            && (expression.int_value == 80 || expression.int_value == 81)
            && expression.first_child != 0
            && expression.first_child < node_count
            && self.expression_is_integer_literal(
                nodes, node_count, expression.first_child, source, source_len
            ) {
            return self.integer_literal_fits_type(
                nodes, node_count, type_index, expression.first_child,
                expression.int_value == 81, source, source_len
            );
        }
        return true;
    }

    pub fn result_constructor_kind(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        call_index: usize,
        source: *const u8,
        source_len: usize
    ) -> i64 {
        if nodes == null || call_index == 0 || call_index >= node_count {
            return 0;
        }
        let call: AstNode = unsafe { *(nodes + call_index) };
        if call.kind != AstKind::ExprCall || call.first_child == 0
            || call.first_child >= node_count {
            return 0;
        }
        let callee: AstNode = unsafe { *(nodes + call.first_child) };
        if callee.kind != AstKind::ExprPath || callee.str_len == 0 {
            return 0;
        }
        if self.source_slice_equals_compact(
            source, source_len, callee.str_offset, callee.str_len, "Result::ok", 10
        ) || self.source_slice_equals_compact(
            source, source_len, callee.str_offset, callee.str_len, "Result::Ok", 10
        ) {
            return 1;
        }
        if self.source_slice_equals_compact(
            source, source_len, callee.str_offset, callee.str_len, "Result::err", 11
        ) || self.source_slice_equals_compact(
            source, source_len, callee.str_offset, callee.str_len, "Result::Err", 11
        ) {
            return 2;
        }
        return 0;
    }

    pub fn impl_target_is_declared(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        module_index: usize,
        impl_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        if nodes == null || source == null || module_index == 0 || impl_index == 0
            || module_index >= node_count || impl_index >= node_count {
            return false;
        }
        let module_node: AstNode = unsafe { *(nodes + module_index) };
        let impl_node: AstNode = unsafe { *(nodes + impl_index) };
        if module_node.kind != AstKind::Module || impl_node.kind != AstKind::ImplDecl
            || impl_node.str_len == 0 {
            return false;
        }
        let mut declaration_index: usize = module_node.first_child;
        let mut traversed: usize = 0;
        while declaration_index != 0 {
            if declaration_index >= node_count || traversed >= MAX_SYMBOLS {
                return false;
            }
            let declaration: AstNode = unsafe { *(nodes + declaration_index) };
            if (declaration.kind == AstKind::StructDecl
                || declaration.kind == AstKind::EnumDecl)
                && declaration.str_len != 0
                && self.source_slices_equal(
                    source,
                    source_len,
                    declaration.str_offset,
                    declaration.str_len,
                    impl_node.str_offset,
                    impl_node.str_len
                ) {
                return true;
            }
            declaration_index = declaration.next_sibling;
            traversed = traversed + 1;
        }
        return false;
    }

    pub fn static_method_is_unique(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        module_index: usize,
        impl_index: usize,
        method_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        if nodes == null || source == null || module_index == 0 || impl_index == 0
            || method_index == 0 || module_index >= node_count
            || impl_index >= node_count || method_index >= node_count {
            return false;
        }
        let module_node: AstNode = unsafe { *(nodes + module_index) };
        let impl_node: AstNode = unsafe { *(nodes + impl_index) };
        let method: AstNode = unsafe { *(nodes + method_index) };
        if module_node.kind != AstKind::Module || impl_node.kind != AstKind::ImplDecl
            || method.kind != AstKind::FnDecl || method.parent != impl_index
            || impl_node.str_len == 0 || method.str_len == 0 {
            return false;
        }

        let mut declaration_index: usize = module_node.first_child;
        let mut traversed: usize = 0;
        while declaration_index != 0 {
            if declaration_index >= node_count || traversed >= MAX_SYMBOLS {
                return false;
            }
            let declaration: AstNode = unsafe { *(nodes + declaration_index) };
            if declaration.kind == AstKind::ImplDecl && declaration.str_len != 0
                && self.source_slices_equal(
                    source,
                    source_len,
                    declaration.str_offset,
                    declaration.str_len,
                    impl_node.str_offset,
                    impl_node.str_len
                ) {
                let mut candidate_index: usize = declaration.first_child;
                while candidate_index != 0 {
                    if candidate_index >= node_count {
                        return false;
                    }
                    if declaration_index == impl_index && candidate_index == method_index {
                        return true;
                    }
                    let candidate: AstNode = unsafe { *(nodes + candidate_index) };
                    if candidate.kind == AstKind::FnDecl && candidate.str_len != 0
                        && self.source_slices_equal(
                            source,
                            source_len,
                            candidate.str_offset,
                            candidate.str_len,
                            method.str_offset,
                            method.str_len
                        ) {
                        return false;
                    }
                    candidate_index = candidate.next_sibling;
                }
            }
            if declaration_index == impl_index {
                return false;
            }
            declaration_index = declaration.next_sibling;
            traversed = traversed + 1;
        }
        return false;
    }

    pub fn static_impl_receiver_index(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        method_index: usize,
        source: *const u8,
        source_len: usize
    ) -> usize {
        if nodes == null || source == null || method_index == 0
            || method_index >= node_count {
            return 0;
        }
        let method: AstNode = unsafe { *(nodes + method_index) };
        if method.kind != AstKind::FnDecl {
            return 0;
        }
        let mut child: usize = method.first_child;
        while child != 0 {
            if child >= node_count {
                return 0;
            }
            let node: AstNode = unsafe { *(nodes + child) };
            if node.kind == AstKind::ParamDecl
                && self.source_slice_equals(
                    source, source_len, node.str_offset, node.str_len, "self", 4
                ) {
                return child;
            }
            child = node.next_sibling;
        }
        return 0;
    }

    pub fn is_by_value_self_receiver(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        param_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        if nodes == null || source == null || param_index == 0 || param_index >= node_count {
            return false;
        }
        let param: AstNode = unsafe { *(nodes + param_index) };
        if param.first_child == 0 || param.first_child >= node_count {
            return false;
        }
        let type_ref: AstNode = unsafe { *(nodes + param.first_child) };
        if type_ref.int_value == 4 || type_ref.int_value == 6 { return false; }
        if type_ref.str_len == 0 || type_ref.str_offset >= source_len {
            return false;
        }
        let first_ch: u8 = unsafe { *(source + type_ref.str_offset) };
        return first_ch != 38 && first_ch != 42;
    }

    pub fn path_matches_static_method(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        path_index: usize,
        impl_index: usize,
        method_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        if nodes == null || source == null || path_index == 0 || impl_index == 0
            || method_index == 0 || path_index >= node_count
            || impl_index >= node_count || method_index >= node_count {
            return false;
        }
        let path: AstNode = unsafe { *(nodes + path_index) };
        let impl_node: AstNode = unsafe { *(nodes + impl_index) };
        let method: AstNode = unsafe { *(nodes + method_index) };
        if path.kind != AstKind::ExprPath || path.str_len == 0
            || impl_node.kind != AstKind::ImplDecl || impl_node.str_len == 0
            || method.kind != AstKind::FnDecl || method.str_len == 0
            || method.parent != impl_index || path.str_offset > source_len
            || path.str_len > source_len - path.str_offset {
            return false;
        }

        let mut first: usize = 0;
        while first < path.str_len {
            let ch: u8 = unsafe { *(source + path.str_offset + first) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                first = first + 1;
            } else {
                break;
            }
        }

        let mut separator: usize = first;
        let mut found_separator: bool = false;
        while separator + 1 < path.str_len {
            let left: u8 = unsafe { *(source + path.str_offset + separator) };
            let right: u8 = unsafe { *(source + path.str_offset + separator + 1) };
            if left == 58 && right == 58 {
                found_separator = true;
                break;
            }
            separator = separator + 1;
        }
        if !found_separator || separator <= first {
            return false;
        }

        let mut target_end: usize = separator;
        while target_end > first {
            let ch: u8 = unsafe { *(source + path.str_offset + target_end - 1) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                target_end = target_end - 1;
            } else {
                break;
            }
        }
        if target_end <= first {
            return false;
        }

        let mut method_start: usize = separator + 2;
        while method_start < path.str_len {
            let ch: u8 = unsafe { *(source + path.str_offset + method_start) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                method_start = method_start + 1;
            } else {
                break;
            }
        }

        let mut method_end: usize = path.str_len;
        while method_end > method_start {
            let ch: u8 = unsafe { *(source + path.str_offset + method_end - 1) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                method_end = method_end - 1;
            } else {
                break;
            }
        }
        if method_end <= method_start {
            return false;
        }

        let mut scan: usize = method_start;
        while scan + 1 < method_end {
            let left: u8 = unsafe { *(source + path.str_offset + scan) };
            let right: u8 = unsafe { *(source + path.str_offset + scan + 1) };
            if left == 58 && right == 58 {
                return false;
            }
            scan = scan + 1;
        }

        return self.source_slices_equal(
            source,
            source_len,
            path.str_offset + first,
            target_end - first,
            impl_node.str_offset,
            impl_node.str_len
        ) && self.source_slices_equal(
            source,
            source_len,
            path.str_offset + method_start,
            method_end - method_start,
            method.str_offset,
            method.str_len
        );
    }

    pub fn find_static_impl_method_for_path(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        module_index: usize,
        path_index: usize,
        source: *const u8,
        source_len: usize
    ) -> usize {
        if nodes == null || source == null || module_index == 0 || path_index == 0
            || module_index >= node_count || path_index >= node_count {
            return 0;
        }
        let module_node: AstNode = unsafe { *(nodes + module_index) };
        if module_node.kind != AstKind::Module {
            return 0;
        }

        let mut found: usize = 0;
        let mut declaration_index: usize = module_node.first_child;
        let mut traversed: usize = 0;
        while declaration_index != 0 {
            if declaration_index >= node_count || traversed >= MAX_SYMBOLS {
                return 0;
            }
            let declaration: AstNode = unsafe { *(nodes + declaration_index) };
            if declaration.kind == AstKind::ImplDecl
                && self.impl_target_is_declared(
                    nodes,
                    node_count,
                    module_index,
                    declaration_index,
                    source,
                    source_len
                ) {
                let mut method_index: usize = declaration.first_child;
                while method_index != 0 {
                    if method_index >= node_count {
                        return 0;
                    }
                    let method: AstNode = unsafe { *(nodes + method_index) };
                    if method.kind == AstKind::FnDecl
                        && self.path_matches_static_method(
                            nodes,
                            node_count,
                            path_index,
                            declaration_index,
                            method_index,
                            source,
                            source_len
                        ) {
                        if found != 0 {
                            return 0;
                        }
                        found = method_index;
                    }
                    method_index = method.next_sibling;
                }
            }
            declaration_index = declaration.next_sibling;
            traversed = traversed + 1;
        }
        return found;
    }

    pub fn static_impl_call_arity_matches(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        call_index: usize,
        method_index: usize
    ) -> bool {
        if nodes == null || call_index == 0 || method_index == 0
            || call_index >= node_count || method_index >= node_count {
            return false;
        }
        let call: AstNode = unsafe { *(nodes + call_index) };
        let method: AstNode = unsafe { *(nodes + method_index) };
        if call.kind != AstKind::ExprCall || call.first_child == 0
            || call.first_child >= node_count || method.kind != AstKind::FnDecl {
            return false;
        }
        let callee: AstNode = unsafe { *(nodes + call.first_child) };
        if callee.kind != AstKind::ExprPath {
            return false;
        }

        let mut expected: usize = 0;
        let mut child: usize = method.first_child;
        while child != 0 {
            if child >= node_count {
                return false;
            }
            let node: AstNode = unsafe { *(nodes + child) };
            if node.kind == AstKind::ParamDecl {
                expected = expected + 1;
            }
            child = node.next_sibling;
        }

        let mut actual: usize = 0;
        child = callee.next_sibling;
        while child != 0 {
            if child >= node_count {
                return false;
            }
            let node: AstNode = unsafe { *(nodes + child) };
            actual = actual + 1;
            child = node.next_sibling;
        }
        return actual == expected;
    }

    pub fn check_impl_declaration(
        mut self: &mut Self,
        nodes: *const AstNode,
        node_count: usize,
        module_index: usize,
        impl_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        if nodes == null || impl_index == 0 || impl_index >= node_count
            || module_index == 0 || module_index >= node_count {
            self.error_count = self.error_count + 1;
            return false;
        }
        let impl_node: AstNode = unsafe { *(nodes + impl_index) };
        if impl_node.kind != AstKind::ImplDecl || impl_node.str_len == 0
            || !self.impl_target_is_declared(
                nodes,
                node_count,
                module_index,
                impl_index,
                source,
                source_len
            ) {
            return self.reject_node(impl_node);
        }

        let mut method_index: usize = impl_node.first_child;
        let mut method_count: usize = 0;
        while method_index != 0 {
            if method_index >= node_count || method_count >= MAX_SYMBOLS {
                return self.reject_node(impl_node);
            }
            let method: AstNode = unsafe { *(nodes + method_index) };
            if method.kind != AstKind::FnDecl || method.parent != impl_index
                || method.str_len == 0 {
                return self.reject_node(method);
            }
            let receiver_index: usize = self.static_impl_receiver_index(
                nodes, node_count, method_index, source, source_len
            );
            if receiver_index != 0 {
                let receiver: AstNode = unsafe { *(nodes + receiver_index) };
                let receiver_type: AstNode = unsafe { *(nodes + receiver.first_child) };
                if (receiver_type.int_value == 4 || receiver_type.int_value == 6)
                    && !self.same_source_text(source,source_len,receiver_type,impl_node)
                    && !self.source_slice_equals(source,source_len,receiver_type.str_offset,receiver_type.str_len,"Self",4) {
                    return self.reject_node(receiver);
                }
                if self.is_by_value_self_receiver(nodes, node_count, receiver_index, source, source_len) {
                    let receiver: AstNode = unsafe { *(nodes + receiver_index) };
                    return self.reject_node(receiver);
                }
            }
            if !self.static_method_is_unique(
                nodes,
                node_count,
                module_index,
                impl_index,
                method_index,
                source,
                source_len
            ) {
                return self.reject_node(method);
            }
            method_index = method.next_sibling;
            method_count = method_count + 1;
        }
        return true;
    }

    pub fn check_static_impl_call_argument_types(
        mut self: &mut Self,
        nodes: *const AstNode,
        node_count: usize,
        call_index: usize,
        method_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        if nodes == null || call_index == 0 || method_index == 0
            || call_index >= node_count || method_index >= node_count {
            self.error_count = self.error_count + 1;
            return false;
        }
        let call: AstNode = unsafe { *(nodes + call_index) };
        let method: AstNode = unsafe { *(nodes + method_index) };
        if call.kind != AstKind::ExprCall || call.first_child == 0
            || call.first_child >= node_count || method.kind != AstKind::FnDecl {
            return false;
        }
        let callee: AstNode = unsafe { *(nodes + call.first_child) };
        if callee.kind != AstKind::ExprPath {
            return false;
        }

        let mut parameter_index: usize = method.first_child;
        let mut argument_index: usize = callee.next_sibling;
        while parameter_index != 0 {
            if parameter_index >= node_count {
                self.error_count = self.error_count + 1;
                return false;
            }
            let parameter: AstNode = unsafe { *(nodes + parameter_index) };
            if parameter.kind == AstKind::ParamDecl {
                if argument_index == 0 || argument_index >= node_count {
                    return true; // Arity is owned by the qualified-call check.
                }
                let argument: AstNode = unsafe { *(nodes + argument_index) };
                let expected_type: usize = self.binding_type_ref(
                    nodes, node_count, parameter_index
                );
                if expected_type != 0
                    && !self.contextual_integer_expression_fits(
                        nodes, node_count, expected_type, argument_index, source, source_len
                    ) {
                    return self.reject_node(argument);
                }
                let errors_before: usize = self.error_count;
                let actual_type: usize = self.infer_expression_type_ref(
                    nodes, node_count, argument_index, source, source_len
                );
                if self.error_count != errors_before {
                    return false;
                }
                if expected_type != 0 && actual_type != 0 {
                    let expected: AstNode = unsafe { *(nodes + expected_type) };
                    let actual: AstNode = unsafe { *(nodes + actual_type) };
                    if !self.same_source_text(source, source_len, expected, actual)
                        && !self.mutable_pointer_to_const_matches(
                            source, source_len, actual, expected
                        ) {
                        return self.reject_node(argument);
                    }
                }
                argument_index = argument.next_sibling;
            }
            parameter_index = parameter.next_sibling;
        }
        return true;
    }

    pub fn check_qualified_static_call(
        mut self: &mut Self,
        nodes: *const AstNode,
        node_count: usize,
        module_index: usize,
        call_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        if nodes == null || call_index == 0 || call_index >= node_count {
            self.error_count = self.error_count + 1;
            return false;
        }
        let call: AstNode = unsafe { *(nodes + call_index) };
        if call.kind != AstKind::ExprCall || call.first_child == 0
            || call.first_child >= node_count {
            return true;
        }
        let callee: AstNode = unsafe { *(nodes + call.first_child) };
        if callee.kind != AstKind::ExprPath {
            return true;
        }
        if self.result_constructor_kind(
            nodes, node_count, call_index, source, source_len
        ) != 0 {
            return true;
        }
        let method_index: usize = self.find_static_impl_method_for_path(
            nodes,
            node_count,
            module_index,
            call.first_child,
            source,
            source_len
        );
        if method_index == 0 {
            return self.reject_node(callee);
        }
        let receiver_index: usize = self.static_impl_receiver_index(
            nodes, node_count, method_index, source, source_len
        );
        if receiver_index != 0
            || !self.static_impl_call_arity_matches(
                nodes, node_count, call_index, method_index
            ) {
            return self.reject_node(callee);
        }
        if !self.check_static_impl_call_argument_types(
            nodes,
            node_count,
            call_index,
            method_index,
            source,
            source_len
        ) {
            return false;
        }
        return true;
    }

    pub fn find_enclosing_module(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        node_index: usize
    ) -> usize {
        if nodes == null || node_index == 0 || node_index >= node_count {
            return 0;
        }
        let mut current_index: usize = node_index;
        let mut traversed: usize = 0;
        while current_index != 0 {
            if current_index >= node_count || traversed >= node_count {
                return 0;
            }
            let current: AstNode = unsafe { *(nodes + current_index) };
            if current.kind == AstKind::Module {
                return current_index;
            }
            current_index = current.parent;
            traversed = traversed + 1;
        }
        return 0;
    }

    pub fn find_module_struct(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        expression_index: usize,
        source: *const u8,
        source_len: usize
    ) -> usize {
        if nodes == null || source == null || expression_index == 0
            || expression_index >= node_count {
            return 0;
        }
        let expression: AstNode = unsafe { *(nodes + expression_index) };
        if expression.kind != AstKind::ExprStructLiteral || expression.str_len == 0 {
            return 0;
        }
        let module_index: usize = self.find_enclosing_module(
            nodes, node_count, expression_index
        );
        if module_index == 0 {
            return 0;
        }
        let module_node: AstNode = unsafe { *(nodes + module_index) };
        let mut declaration_index: usize = module_node.first_child;
        let mut traversed: usize = 0;
        while declaration_index != 0 {
            if declaration_index >= node_count || traversed >= MAX_SYMBOLS {
                return 0;
            }
            let declaration: AstNode = unsafe { *(nodes + declaration_index) };
            if declaration.kind == AstKind::StructDecl
                && declaration.str_len != 0
                && self.same_declaration_name(
                    source, source_len, declaration, expression
                ) {
                return declaration_index;
            }
            declaration_index = declaration.next_sibling;
            traversed = traversed + 1;
        }
        return 0;
    }

    pub fn find_struct_field_for_init(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        struct_index: usize,
        init_index: usize,
        source: *const u8,
        source_len: usize
    ) -> usize {
        if nodes == null || struct_index == 0 || init_index == 0
            || struct_index >= node_count || init_index >= node_count {
            return 0;
        }
        let declaration: AstNode = unsafe { *(nodes + struct_index) };
        let init: AstNode = unsafe { *(nodes + init_index) };
        if declaration.kind != AstKind::StructDecl
            || init.kind != AstKind::StructFieldInit
            || init.str_len == 0 {
            return 0;
        }
        let mut field_index: usize = declaration.first_child;
        let mut traversed: usize = 0;
        while field_index != 0 {
            if field_index >= node_count || traversed >= MAX_SYMBOLS {
                return 0;
            }
            let field: AstNode = unsafe { *(nodes + field_index) };
            if field.kind == AstKind::FieldDecl
                && field.str_len != 0
                && self.same_declaration_name(
                    source, source_len, field, init
                ) {
                return field_index;
            }
            field_index = field.next_sibling;
            traversed = traversed + 1;
        }
        return 0;
    }

    pub fn type_ref_matches_struct_literal(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        type_index: usize,
        literal_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        if nodes == null || type_index == 0 || literal_index == 0
            || type_index >= node_count || literal_index >= node_count {
            return false;
        }
        let typ: AstNode = unsafe { *(nodes + type_index) };
        let literal: AstNode = unsafe { *(nodes + literal_index) };
        if typ.kind != AstKind::TypeRef
            || literal.kind != AstKind::ExprStructLiteral
            || typ.str_len == 0 || literal.str_len == 0 {
            return false;
        }
        return self.same_source_text(source, source_len, typ, literal);
    }

    pub fn fixed_array_type_matches_zero_repeat(
        self: &Self, nodes: *const AstNode, node_count: usize,
        type_index: usize, repeat_index: usize, source: *const u8, source_len: usize
    ) -> bool {
        return self.fixed_array_type_matches_repeat(nodes, node_count, type_index,
            repeat_index, source, source_len, true);
    }

    pub fn fixed_array_type_matches_repeat(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        type_index: usize,
        repeat_index: usize,
        source: *const u8,
        source_len: usize,
        require_zero: bool
    ) -> bool {
        if nodes == null || source == null || type_index == 0 || repeat_index == 0
            || type_index >= node_count || repeat_index >= node_count {
            return false;
        }
        let typ: AstNode = unsafe { *(nodes + type_index) };
        let repeat: AstNode = unsafe { *(nodes + repeat_index) };
        if typ.kind != AstKind::TypeRef || repeat.kind != AstKind::ExprArrayRepeat
            || typ.str_offset > source_len || typ.str_len > source_len - typ.str_offset
            || repeat.first_child == 0 || repeat.first_child >= node_count {
            return false;
        }
        let value_index: usize = repeat.first_child;
        let value: AstNode = unsafe { *(nodes + value_index) };
        let count_index: usize = value.next_sibling;
        let boolean_zero: bool = self.source_slice_equals(source, source_len,
            value.str_offset, value.str_len, "false", 5);
        if (require_zero && (value.kind != AstKind::ExprLiteral
            || value.str_offset > source_len || value.str_len > source_len - value.str_offset
            || (!boolean_zero && (value.str_len != 1 || unsafe { *(source + value.str_offset) } != 48))))
            || count_index == 0 || count_index >= node_count {
            return false;
        }
        let count: AstNode = unsafe { *(nodes + count_index) };
        if count.kind != AstKind::ExprLiteral || count.str_len == 0
            || count.str_offset > source_len
            || count.str_len > source_len - count.str_offset
            || count.next_sibling != 0 {
            return false;
        }

        let mut i: usize = 0;
        while i < typ.str_len {
            let ch: u8 = unsafe { *(source + typ.str_offset + i) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                i = i + 1;
            } else {
                break;
            }
        }
        if i >= typ.str_len || unsafe { *(source + typ.str_offset + i) } != 91 {
            return false;
        }
        i = i + 1;
        while i < typ.str_len {
            let ch: u8 = unsafe { *(source + typ.str_offset + i) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                i = i + 1;
            } else {
                break;
            }
        }
        let element_start: usize = i;
        while i < typ.str_len {
            let ch: u8 = unsafe { *(source + typ.str_offset + i) };
            let alpha: bool = (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122);
            let digit: bool = ch >= 48 && ch <= 57;
            if alpha || digit || ch == 95 {
                i = i + 1;
            } else {
                break;
            }
        }
        if i == element_start {
            return false;
        }
        if require_zero && boolean_zero && !self.source_slice_equals(source, source_len,
            typ.str_offset + element_start, i - element_start, "bool", 4) { return false; }
        while i < typ.str_len {
            let ch: u8 = unsafe { *(source + typ.str_offset + i) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                i = i + 1;
            } else {
                break;
            }
        }
        if i >= typ.str_len || unsafe { *(source + typ.str_offset + i) } != 59 {
            return false;
        }
        i = i + 1;
        while i < typ.str_len {
            let ch: u8 = unsafe { *(source + typ.str_offset + i) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                i = i + 1;
            } else {
                break;
            }
        }
        let type_count: usize=native_fixed_array_count(unsafe{source+typ.str_offset},typ.str_len);
        let mut repeat_count: u64=0;
        if !native_unsigned_slice(unsafe{source+count.str_offset},count.str_len,
            unsafe{(&mut repeat_count) as *mut u64}) { return false; }
        return type_count != 0 && type_count as u64 == repeat_count;
    }

    pub fn check_array_repeat_context(
        mut self: &mut Self,
        nodes: *const AstNode,
        node_count: usize,
        repeat_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        if nodes == null || repeat_index == 0 || repeat_index >= node_count {
            self.error_count = self.error_count + 1;
            return false;
        }
        let repeat: AstNode = unsafe { *(nodes + repeat_index) };
        if repeat.kind != AstKind::ExprArrayRepeat
            || repeat.parent == 0 || repeat.parent >= node_count {
            return self.reject_node(repeat);
        }
        let init_index: usize = repeat.parent;
        let init: AstNode = unsafe { *(nodes + init_index) };
        if init.kind == AstKind::LetStmt && init.parent != 0 && init.parent < node_count
            && (unsafe { (*(nodes + init.parent)).kind } == AstKind::Module
                || unsafe { (*(nodes + init.parent)).kind } == AstKind::Block) {
            if init.first_child == 0 || init.first_child >= node_count
                || unsafe { (*(nodes + init.first_child)).next_sibling } != repeat_index
                || !self.fixed_array_type_matches_repeat(nodes, node_count, init.first_child,
                    repeat_index, source, source_len, false) { return self.reject_node(repeat); }
            return true;
        }
        if init.kind != AstKind::StructFieldInit
            || init.parent == 0 || init.parent >= node_count {
            return self.reject_node(repeat);
        }
        let literal_index: usize = init.parent;
        let literal: AstNode = unsafe { *(nodes + literal_index) };
        if literal.kind != AstKind::ExprStructLiteral {
            return self.reject_node(repeat);
        }
        let struct_index: usize = self.find_module_struct(
            nodes, node_count, literal_index, source, source_len
        );
        let field_index: usize = self.find_struct_field_for_init(
            nodes, node_count, struct_index, init_index, source, source_len
        );
        if field_index == 0 || field_index >= node_count {
            return self.reject_node(repeat);
        }
        let field: AstNode = unsafe { *(nodes + field_index) };
        if field.first_child == 0 || field.first_child >= node_count
            || !self.fixed_array_type_matches_repeat(
                nodes, node_count, field.first_child, repeat_index, source, source_len, false
            ) {
            return self.reject_node(repeat);
        }
        return true;
    }

    pub fn check_struct_literal(
        mut self: &mut Self,
        nodes: *const AstNode,
        node_count: usize,
        literal_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        if nodes == null || literal_index == 0 || literal_index >= node_count {
            self.error_count = self.error_count + 1;
            return false;
        }
        let literal: AstNode = unsafe { *(nodes + literal_index) };
        if literal.kind != AstKind::ExprStructLiteral || literal.str_len == 0 {
            return self.reject_node(literal);
        }
        let struct_index: usize = self.find_module_struct(
            nodes, node_count, literal_index, source, source_len
        );
        if struct_index == 0 || struct_index >= node_count {
            return self.reject_node(literal);
        }
        let declaration: AstNode = unsafe { *(nodes + struct_index) };

        let mut declared_count: usize = 0;
        let mut field_index: usize = declaration.first_child;
        while field_index != 0 {
            if field_index >= node_count || declared_count >= MAX_SYMBOLS {
                return self.reject_node(literal);
            }
            let field: AstNode = unsafe { *(nodes + field_index) };
            if field.kind != AstKind::FieldDecl || field.str_len == 0
                || field.first_child == 0 || field.first_child >= node_count {
                return self.reject_node(field);
            }
            let typ: AstNode = unsafe { *(nodes + field.first_child) };
            if typ.kind != AstKind::TypeRef || typ.next_sibling != 0 {
                return self.reject_node(field);
            }
            declared_count = declared_count + 1;
            field_index = field.next_sibling;
        }
        if declared_count == 0 {
            return self.reject_node(literal);
        }

        let mut init_count: usize = 0;
        let mut init_index: usize = literal.first_child;
        while init_index != 0 {
            if init_index >= node_count || init_count >= MAX_SYMBOLS {
                return self.reject_node(literal);
            }
            let init: AstNode = unsafe { *(nodes + init_index) };
            if init.kind != AstKind::StructFieldInit || init.str_len == 0
                || init.first_child == 0 || init.first_child >= node_count {
                return self.reject_node(init);
            }
            let matched_field: usize = self.find_struct_field_for_init(
                nodes, node_count, struct_index, init_index, source, source_len
            );
            if matched_field == 0 || matched_field >= node_count {
                return self.reject_node(init);
            }

            let mut previous_index: usize = literal.first_child;
            while previous_index != init_index {
                if previous_index == 0 || previous_index >= node_count {
                    return self.reject_node(init);
                }
                let previous: AstNode = unsafe { *(nodes + previous_index) };
                if previous.kind != AstKind::StructFieldInit {
                    return self.reject_node(previous);
                }
                if self.same_declaration_name(
                    source, source_len, previous, init
                ) {
                    return self.reject_node(init);
                }
                previous_index = previous.next_sibling;
            }

            let field: AstNode = unsafe { *(nodes + matched_field) };
            let type_index: usize = field.first_child;
            let value_index: usize = init.first_child;
            let value: AstNode = unsafe { *(nodes + value_index) };
            if value.next_sibling != 0 {
                return self.reject_node(value);
            }
            if value.kind == AstKind::ExprStructLiteral {
                if !self.type_ref_matches_struct_literal(
                    nodes, node_count, type_index, value_index, source, source_len
                ) {
                    return self.reject_node(value);
                }
                if !self.check_struct_literal(
                    nodes, node_count, value_index, source, source_len
                ) {
                    return false;
                }
            } else if value.kind == AstKind::ExprArrayLiteral {
                if !self.ownership_pod_array(unsafe { *(nodes + type_index) }, source, source_len) {
                    return self.reject_node(value);
                }
                // Lowering checks the list length and every element against
                // the declared scalar field type before object emission.
            } else if value.kind == AstKind::ExprArrayRepeat {
                if !self.fixed_array_type_matches_repeat(
                    nodes, node_count, type_index, value_index, source, source_len, false
                ) {
                    return self.reject_node(value);
                }
            } else if !self.contextual_integer_expression_fits(
                nodes, node_count, type_index, value_index, source, source_len
            ) {
                return self.reject_node(value);
            }

            init_count = init_count + 1;
            init_index = init.next_sibling;
        }
        if init_count != declared_count {
            return self.reject_node(literal);
        }
        return true;
    }

    pub fn expression_is_borrow_deref(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        expression_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        let expression: AstNode = unsafe { *(nodes + expression_index) };
        if expression.first_child == 0 || expression.first_child >= node_count {
            return false;
        }
        let operand: AstNode = unsafe { *(nodes + expression.first_child) };
        if operand.kind != AstKind::ExprIdent {
            return false;
        }
        let binding_index: usize = self.find_visible_binding(
            nodes, node_count, expression.first_child, source, source_len
        );
        let type_index: usize = self.binding_type_ref(nodes, node_count, binding_index);
        if type_index == 0 || source == null {
            return false;
        }
        let typ: AstNode = unsafe { *(nodes + type_index) };
        if typ.str_offset > source_len || typ.str_len > source_len - typ.str_offset {
            return false;
        }
        let mut offset: usize = typ.str_offset;
        let end: usize = offset + typ.str_len;
        while offset < end && unsafe { *(source + offset) } == 32 {
            offset = offset + 1;
        }
        return offset < end && unsafe { *(source + offset) } == 38;
    }

    pub fn indexed_element_matches(
        self: &Self,
        source: *const u8,
        source_len: usize,
        array_type: AstNode,
        element_type: AstNode
    ) -> bool {
        if source == null || array_type.str_offset > source_len
            || array_type.str_len > source_len - array_type.str_offset
            || array_type.str_len < 4 {
            return false;
        }
        let mut start: usize = array_type.str_offset;
        let end: usize = start + array_type.str_len;
        if unsafe { *(source + start) } != 91 { // '['
            return false;
        }
        start = start + 1;
        while start < end && unsafe { *(source + start) } == 32 {
            start = start + 1;
        }
        let element_start: usize = start;
        while start < end && unsafe { *(source + start) } != 59 { // ';'
            start = start + 1;
        }
        if start >= end {
            return false;
        }
        while start > element_start && unsafe { *(source + start - 1) } == 32 {
            start = start - 1;
        }
        return self.source_slices_equal(
            source, source_len, element_start, start - element_start,
            element_type.str_offset, element_type.str_len
        );
    }

    pub fn mutable_pointer_to_const_matches(
        self: &Self,
        source: *const u8,
        source_len: usize,
        mutable_type: AstNode,
        const_type: AstNode
    ) -> bool {
        if mutable_type.str_len <= 5 || const_type.str_len <= 7 {
            return false;
        }
        if !self.source_slice_equals(
            source, source_len, mutable_type.str_offset, 5, "*mut ", 5
        ) || !self.source_slice_equals(
            source, source_len, const_type.str_offset, 7, "*const ", 7
        ) {
            return false;
        }
        return self.source_slices_equal(
            source, source_len,
            mutable_type.str_offset + 5, mutable_type.str_len - 5,
            const_type.str_offset + 7, const_type.str_len - 7
        );
    }

    pub fn expression_is_mutable_borrow_deref(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        expression_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        let expression: AstNode = unsafe { *(nodes + expression_index) };
        if expression.first_child == 0 || expression.first_child >= node_count {
            return false;
        }
        let operand: AstNode = unsafe { *(nodes + expression.first_child) };
        if operand.kind != AstKind::ExprIdent {
            return false;
        }
        let binding_index: usize = self.find_visible_binding(
            nodes, node_count, expression.first_child, source, source_len
        );
        return self.binding_is_mutable_borrow(
            nodes, node_count, binding_index, source, source_len
        );
    }

    pub fn binding_is_mutable_borrow(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        binding_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        let type_index: usize = self.binding_type_ref(nodes, node_count, binding_index);
        if type_index == 0 || source == null {
            return false;
        }
        let typ: AstNode = unsafe { *(nodes + type_index) };
        if typ.str_offset > source_len || typ.str_len > source_len - typ.str_offset {
            return false;
        }
        let mut offset: usize = typ.str_offset;
        let end: usize = offset + typ.str_len;
        while offset < end && unsafe { *(source + offset) } == 32 {
            offset = offset + 1;
        }
        if offset >= end || unsafe { *(source + offset) } != 38 {
            return false;
        }
        offset = offset + 1;
        while offset < end && unsafe { *(source + offset) } == 32 {
            offset = offset + 1;
        }
        return offset + 3 <= end
            && self.source_slice_equals(source, source_len, offset, 3, "mut", 3);
    }

    pub fn binding_type_ref(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        binding_index: usize
    ) -> usize {
        if nodes == null || binding_index == 0 || binding_index >= node_count {
            return 0;
        }
        let binding: AstNode = unsafe { *(nodes + binding_index) };
        let type_index: usize = binding.first_child;
        if type_index == 0 || type_index >= node_count {
            return 0;
        }
        let type_node: AstNode = unsafe { *(nodes + type_index) };
        if type_node.kind != AstKind::TypeRef {
            return 0;
        }
        return type_index;
    }

    pub fn enclosing_impl(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        index: usize
    ) -> usize {
        if nodes == null || index == 0 || index >= node_count {
            return 0;
        }
        let mut current: usize = index;
        let mut traversed: usize = 0;
        while current != 0 {
            if current >= node_count || traversed >= node_count {
                return 0;
            }
            let node: AstNode = unsafe { *(nodes + current) };
            if node.kind == AstKind::ImplDecl {
                return current;
            }
            current = node.parent;
            traversed = traversed + 1;
        }
        return 0;
    }

    pub fn find_struct_for_receiver(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        receiver_index: usize,
        source: *const u8,
        source_len: usize
    ) -> usize {
        if nodes == null || source == null || receiver_index == 0
            || receiver_index >= node_count {
            return 0;
        }
        let receiver: AstNode = unsafe { *(nodes + receiver_index) };
        let mut binding_receiver: usize = receiver_index;
        if receiver.kind == AstKind::ExprIndex && receiver.first_child != 0 && receiver.first_child < node_count {
            binding_receiver = receiver.first_child;
        }
        if unsafe { (*(nodes + binding_receiver)).kind } != AstKind::ExprIdent {
            return 0;
        }
        let binding_index: usize = self.find_visible_binding(
            nodes, node_count, binding_receiver, source, source_len
        );
        let type_index: usize = self.binding_type_ref(nodes, node_count, binding_index);
        if type_index == 0 {
            return 0;
        }
        let typ: AstNode = unsafe { *(nodes + type_index) };
        if typ.str_len == 0 || typ.str_offset > source_len
            || typ.str_len > source_len - typ.str_offset {
            return 0;
        }

        let mut start: usize = 0;
        while start < typ.str_len {
            let ch: u8 = unsafe { *(source + typ.str_offset + start) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13
                || ch == 38 || ch == 42 {
                start = start + 1;
            } else {
                break;
            }
        }
        if start + 3 <= typ.str_len
            && self.source_slice_equals(
                source, source_len, typ.str_offset + start, 3, "mut", 3
            ) {
            start = start + 3;
        } else if start + 5 <= typ.str_len
            && self.source_slice_equals(
                source, source_len, typ.str_offset + start, 5, "const", 5
            ) {
            start = start + 5;
        }
        while start < typ.str_len {
            let ch: u8 = unsafe { *(source + typ.str_offset + start) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                start = start + 1;
            } else {
                break;
            }
        }
        let mut end: usize = typ.str_len;
        if receiver.kind == AstKind::ExprIndex {
            if start >= end || unsafe { *(source + typ.str_offset + start) } != 91 { return 0; }
            start = start + 1;
            while start < end && unsafe { *(source + typ.str_offset + start) } == 32 { start = start + 1; }
            let mut separator: usize = start;
            while separator < end && unsafe { *(source + typ.str_offset + separator) } != 59 { separator = separator + 1; }
            if separator == end { return 0; }
            end = separator;
        }
        while end > start {
            let ch: u8 = unsafe { *(source + typ.str_offset + end - 1) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                end = end - 1;
            } else {
                break;
            }
        }
        let mut name_start: usize = start;
        let mut separator: usize = start;
        while separator + 1 < end {
            if unsafe { *(source + typ.str_offset + separator) } == 58
                && unsafe { *(source + typ.str_offset + separator + 1) } == 58 {
                name_start = separator + 2;
            }
            separator = separator + 1;
        }

        let module_index: usize = self.find_enclosing_module(
            nodes, node_count, receiver_index
        );
        if module_index == 0 || module_index >= node_count {
            return 0;
        }
        let module_node: AstNode = unsafe { *(nodes + module_index) };
        let mut declaration_index: usize = module_node.first_child;
        while declaration_index != 0 {
            if declaration_index >= node_count {
                return 0;
            }
            let declaration: AstNode = unsafe { *(nodes + declaration_index) };
            if declaration.kind == AstKind::StructDecl && declaration.str_len != 0 {
                let matches_type: bool = self.source_slices_equal(
                    source, source_len,
                    typ.str_offset + name_start, end - name_start,
                    declaration.str_offset, declaration.str_len
                );
                let self_impl: usize = self.enclosing_impl(
                    nodes, node_count, receiver_index
                );
                let matches_self: bool = start < end
                    && self.source_slice_equals(
                        source, source_len, typ.str_offset + start,
                        end - start, "Self", 4
                    )
                    && self_impl != 0 && self_impl < node_count
                    && self.source_slices_equal(
                        source, source_len,
                        declaration.str_offset, declaration.str_len,
                        unsafe { (*(nodes + self_impl)).str_offset },
                        unsafe { (*(nodes + self_impl)).str_len }
                    );
                if matches_type || matches_self {
                    return declaration_index;
                }
            }
            declaration_index = declaration.next_sibling;
        }
        return 0;
    }

    pub fn find_struct_field_for_access(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        field_access_index: usize,
        source: *const u8,
        source_len: usize
    ) -> usize {
        if nodes == null || field_access_index == 0
            || field_access_index >= node_count {
            return 0;
        }
        let access: AstNode = unsafe { *(nodes + field_access_index) };
        if access.kind != AstKind::ExprFieldAccess || access.first_child == 0 {
            return 0;
        }
        let struct_index: usize = self.find_struct_for_receiver(
            nodes, node_count, access.first_child, source, source_len
        );
        if struct_index == 0 || struct_index >= node_count {
            return 0;
        }
        let declaration: AstNode = unsafe { *(nodes + struct_index) };
        let mut field_index: usize = declaration.first_child;
        while field_index != 0 {
            if field_index >= node_count {
                return 0;
            }
            let field: AstNode = unsafe { *(nodes + field_index) };
            if field.kind == AstKind::FieldDecl
                && self.source_slices_equal(
                    source, source_len,
                    field.str_offset, field.str_len,
                    access.str_offset, access.str_len
                ) {
                return field.first_child;
            }
            field_index = field.next_sibling;
        }
        return 0;
    }

    pub fn is_pointer_type_ref(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        type_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        if nodes == null || type_index == 0 || type_index >= node_count {
            return false;
        }
        let typ: AstNode = unsafe { *(nodes + type_index) };
        if typ.kind != AstKind::TypeRef || typ.str_len == 0
            || typ.str_offset > source_len || typ.str_len > source_len - typ.str_offset {
            return false;
        }
        let mut i: usize = 0;
        while i < typ.str_len {
            let ch: u8 = unsafe { *(source + typ.str_offset + i) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                i = i + 1;
            } else {
                return ch == 42 || ch == 38;
            }
        }
        return false;
    }

    pub fn pointer_type_matches_pointee(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        pointer_index: usize,
        pointee_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        if nodes == null || pointer_index == 0 || pointee_index == 0
            || pointer_index >= node_count || pointee_index >= node_count {
            return false;
        }
        let pointer: AstNode = unsafe { *(nodes + pointer_index) };
        let pointee: AstNode = unsafe { *(nodes + pointee_index) };
        if pointer.kind != AstKind::TypeRef || pointee.kind != AstKind::TypeRef
            || pointer.str_len == 0 {
            return false;
        }
        let mut start: usize = 0;
        while start < pointer.str_len {
            let ch: u8 = unsafe { *(source + pointer.str_offset + start) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                start = start + 1;
            } else {
                break;
            }
        }
        if start >= pointer.str_len || unsafe { *(source + pointer.str_offset + start) } != 42 {
            return false;
        }
        start = start + 1;
        while start < pointer.str_len {
            let ch: u8 = unsafe { *(source + pointer.str_offset + start) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                start = start + 1;
            } else {
                break;
            }
        }
        if start + 5 <= pointer.str_len
            && self.source_slice_equals(
                source, source_len, pointer.str_offset + start, 5, "const", 5
            ) {
            start = start + 5;
        } else if start + 3 <= pointer.str_len
            && self.source_slice_equals(
                source, source_len, pointer.str_offset + start, 3, "mut", 3
            ) {
            start = start + 3;
        }
        while start < pointer.str_len {
            let ch: u8 = unsafe { *(source + pointer.str_offset + start) };
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                start = start + 1;
            } else {
                break;
            }
        }
        return self.source_slices_equal(
            source, source_len,
            pointer.str_offset + start, pointer.str_len - start,
            pointee.str_offset, pointee.str_len
        );
    }

    pub fn infer_expression_type_ref(
        mut self: &mut Self,
        nodes: *const AstNode,
        node_count: usize,
        expression_index: usize,
        source: *const u8,
        source_len: usize
    ) -> usize {
        if nodes == null || expression_index == 0
            || expression_index >= node_count {
            return 0;
        }
        let expression: AstNode = unsafe { *(nodes + expression_index) };
        if expression.kind == AstKind::ExprIdent {
            let binding: usize = self.find_visible_binding(
                nodes, node_count, expression_index, source, source_len
            );
            return self.binding_type_ref(nodes, node_count, binding);
        }
        if expression.kind == AstKind::ExprFieldAccess {
            return self.find_struct_field_for_access(
                nodes, node_count, expression_index, source, source_len
            );
        }
        if expression.kind == AstKind::ExprStructLiteral {
            if !self.check_struct_literal(
                nodes, node_count, expression_index, source, source_len
            ) {
                return 0;
            }
            return expression_index;
        }
        if expression.kind == AstKind::ExprCast {
            if expression.first_child == 0 || expression.first_child >= node_count {
                return 0;
            }
            let value: AstNode = unsafe { *(nodes + expression.first_child) };
            let type_index: usize = value.next_sibling;
            if type_index == 0 || type_index >= node_count {
                return 0;
            }
            let cast_type: AstNode = unsafe { *(nodes + type_index) };
            if cast_type.kind == AstKind::TypeRef && cast_type.next_sibling == 0 {
                return type_index;
            }
            return 0;
        }
        if expression.kind == AstKind::ExprIndex {
            if expression.first_child == 0 || expression.first_child >= node_count {
                return 0;
            }
            let array_index: usize = self.infer_expression_type_ref(
                nodes, node_count, expression.first_child, source, source_len
            );
            if array_index == 0 || array_index >= node_count { return 0; }
            let array_type: AstNode = unsafe { *(nodes + array_index) };
            // An indexed value has the element type, not the container type.
            // Reuse an existing TypeRef identity; do not mutate the source AST.
            let mut candidate: usize = 1;
            while candidate < node_count {
                let element: AstNode = unsafe { *(nodes + candidate) };
                if element.kind == AstKind::TypeRef && element.int_value == 0
                    && self.indexed_element_matches(source, source_len, array_type, element) { return candidate; }
                candidate = candidate + 1;
            }
            return array_index;
        }
        if expression.kind == AstKind::ExprUnary {
            if expression.int_value == 98 {
                return 0; // Boolean result inference is not represented yet.
            }
            return self.infer_expression_type_ref(
                nodes, node_count, expression.first_child, source, source_len
            );
        }
        if expression.kind == AstKind::ExprBinary {
            if (expression.int_value >= 86 && expression.int_value <= 91)
                || expression.int_value == 110
                || expression.int_value == 111 {
                return 0; // Comparison/logical results are boolean, not operand-typed.
            }
            let left_index: usize = expression.first_child;
            if left_index == 0 || left_index >= node_count {
                return 0;
            }
            let left_node: AstNode = unsafe { *(nodes + left_index) };
            let right_index: usize = left_node.next_sibling;
            let left_type: usize = self.infer_expression_type_ref(
                nodes, node_count, left_index, source, source_len
            );
            let right_type: usize = self.infer_expression_type_ref(
                nodes, node_count, right_index, source, source_len
            );
            if left_type != 0 && right_type != 0 {
                if (expression.int_value == 80 || expression.int_value == 81)
                    && self.is_pointer_type_ref(
                        nodes, node_count, left_type, source, source_len
                    )
                    && self.fixed_integer_type_tag(
                        nodes, node_count, right_type, source, source_len
                    ) != 0 {
                    return left_type;
                }
                let left: AstNode = unsafe { *(nodes + left_type) };
                let right: AstNode = unsafe { *(nodes + right_type) };
                if !self.same_source_text(source, source_len, left, right) {
                    self.error_count = self.error_count + 1;
                    self.error_line = expression.span.line;
                    self.error_col = expression.span.col;
                    return 0;
                }
                return left_type;
            }
            if left_type != 0 { return left_type; }
            return right_type;
        }
        if expression.kind == AstKind::ExprCall {
            if expression.first_child == 0
                || expression.first_child >= node_count {
                return 0;
            }
            let callee: AstNode = unsafe { *(nodes + expression.first_child) };
            let mut function_index: usize = 0;
            if callee.kind == AstKind::ExprIdent {
                function_index = self.find_module_function(
                    nodes, node_count, expression.first_child, source, source_len
                );
            } else if callee.kind == AstKind::ExprPath {
                if self.result_constructor_kind(
                    nodes, node_count, expression_index, source, source_len
                ) != 0 {
                    return 0;
                }
                let module_index: usize = self.find_enclosing_module(
                    nodes, node_count, expression_index
                );
                if module_index == 0 {
                    return 0;
                }
                function_index = self.find_static_impl_method_for_path(
                    nodes,
                    node_count,
                    module_index,
                    expression.first_child,
                    source,
                    source_len
                );
            } else if callee.kind == AstKind::ExprFieldAccess {
                function_index = self.ownership_called_function(nodes,node_count,expression_index,source,source_len);
            } else {
                return 0;
            }
            if function_index == 0 {
                return 0;
            }
            let function: AstNode = unsafe { *(nodes + function_index) };
            let mut child: usize = function.first_child;
            while child != 0 {
                if child >= node_count { return 0; }
                let current: AstNode = unsafe { *(nodes + child) };
                if current.kind == AstKind::TypeRef {
                    return child;
                }
                child = current.next_sibling;
            }
        }
        return 0;
    }

    pub fn check_call_argument_types(
        mut self: &mut Self,
        nodes: *const AstNode,
        node_count: usize,
        call_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        if nodes == null || call_index == 0 || call_index >= node_count {
            self.error_count = self.error_count + 1;
            return false;
        }
        let call: AstNode = unsafe { *(nodes + call_index) };
        if call.kind != AstKind::ExprCall || call.first_child == 0
            || call.first_child >= node_count {
            return true;
        }
        let callee: AstNode = unsafe { *(nodes + call.first_child) };
        if callee.kind != AstKind::ExprIdent && callee.kind != AstKind::ExprFieldAccess {
            return true;
        }
        let function_index: usize = self.ownership_called_function(nodes,node_count,call_index,source,source_len);
        if function_index == 0 {
            return true;
        }
        let function: AstNode = unsafe { *(nodes + function_index) };
        let mut parameter_index: usize = function.first_child;
        if callee.kind == AstKind::ExprFieldAccess && parameter_index != 0 && parameter_index < node_count {
            parameter_index = unsafe { (*(nodes + parameter_index)).next_sibling };
        }
        let mut argument_index: usize = callee.next_sibling;
        while parameter_index != 0 && argument_index != 0 {
            if parameter_index >= node_count || argument_index >= node_count {
                self.error_count = self.error_count + 1;
                return false;
            }
            let parameter: AstNode = unsafe { *(nodes + parameter_index) };
            let argument: AstNode = unsafe { *(nodes + argument_index) };
            if parameter.kind == AstKind::ParamDecl {
                let expected_type: usize = self.binding_type_ref(
                    nodes, node_count, parameter_index
                );
                if expected_type != 0
                    && !self.contextual_integer_expression_fits(
                        nodes, node_count, expected_type, argument_index, source, source_len
                    ) {
                    return self.reject_node(argument);
                }
                let errors_before: usize = self.error_count;
                let actual_type: usize = self.infer_expression_type_ref(
                    nodes, node_count, argument_index, source, source_len
                );
                if self.error_count != errors_before {
                    return false;
                }
                if expected_type != 0 && actual_type != 0 {
                    let expected: AstNode = unsafe { *(nodes + expected_type) };
                    let actual: AstNode = unsafe { *(nodes + actual_type) };
                    let mut types_match: bool = self.same_source_text(
                        source, source_len, expected, actual
                    );
                    if !types_match && argument.kind == AstKind::ExprIndex {
                        types_match = self.indexed_element_matches(
                            source, source_len, actual, expected
                        );
                    }
                    if !types_match {
                        types_match = self.mutable_pointer_to_const_matches(
                            source, source_len, actual, expected
                        );
                    }
                    if !types_match && argument.kind == AstKind::ExprUnary
                        && argument.int_value == 92 && expected.str_len > 1
                        && expected.str_offset < source_len
                        && unsafe { *(source + expected.str_offset) } == 38 {
                        let mut referenced_type: AstNode = expected;
                        let end: usize = expected.str_offset + expected.str_len;
                        let mut start: usize = expected.str_offset + 1;
                        while start < end && unsafe { *(source + start) } == 32 {
                            start = start + 1;
                        }
                        if start + 3 <= end && self.source_slice_equals(
                            source, source_len, start, 3, "mut", 3
                        ) {
                            start = start + 3;
                        }
                        while start < end && unsafe { *(source + start) } == 32 {
                            start = start + 1;
                        }
                        referenced_type.str_offset = start;
                        referenced_type.str_len = end - start;
                        types_match = self.same_source_text(
                            source, source_len, referenced_type, actual
                        );
                    }
                    if !types_match {
                        self.error_count = self.error_count + 1;
                        self.error_line = argument.span.line;
                        self.error_col = argument.span.col;
                        return false;
                    }
                }
            }
            parameter_index = parameter.next_sibling;
            argument_index = argument.next_sibling;
        }
        return true;
    }

    pub fn check_return_type(
        mut self: &mut Self,
        nodes: *const AstNode,
        node_count: usize,
        return_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        if nodes == null || return_index == 0 || return_index >= node_count {
            self.error_count = self.error_count + 1;
            return false;
        }
        let return_node: AstNode = unsafe { *(nodes + return_index) };
        let expression_index: usize = return_node.first_child;
        let mut parent_index: usize = return_node.parent;
        let mut traversed: usize = 0;
        let mut function_index: usize = 0;
        while parent_index != 0 {
            if parent_index >= node_count || traversed >= node_count {
                self.error_count = self.error_count + 1;
                return false;
            }
            let parent: AstNode = unsafe { *(nodes + parent_index) };
            if parent.kind == AstKind::FnDecl
                || parent.kind == AstKind::TrapfnDecl {
                function_index = parent_index;
                break;
            }
            parent_index = parent.parent;
            traversed = traversed + 1;
        }
        if function_index == 0 {
            return true; // The control-context check reports this case.
        }
        let function: AstNode = unsafe { *(nodes + function_index) };
        let mut expected_type: usize = 0;
        let mut child: usize = function.first_child;
        while child != 0 {
            if child >= node_count {
                self.error_count = self.error_count + 1;
                return false;
            }
            let current: AstNode = unsafe { *(nodes + child) };
            if current.kind == AstKind::TypeRef {
                expected_type = child;
            }
            child = current.next_sibling;
        }
        if expected_type == 0 {
            if expression_index != 0 {
                let expression: AstNode = unsafe { *(nodes + expression_index) };
                self.error_count = self.error_count + 1;
                self.error_line = expression.span.line;
                self.error_col = expression.span.col;
                return false;
            }
            return true;
        }
        let expected_result: AstNode = unsafe { *(nodes + expected_type) };
        if self.source_slice_equals(source, source_len, expected_result.str_offset,
            expected_result.str_len, "void", 4) {
            if expression_index == 0 { return true; }
            return self.reject_node(return_node);
        }
        if expression_index == 0 {
            self.error_count = self.error_count + 1;
            self.error_line = return_node.span.line;
            self.error_col = return_node.span.col;
            return false;
        }
        if expression_index >= node_count {
            self.error_count = self.error_count + 1;
            self.error_line = return_node.span.line;
            self.error_col = return_node.span.col;
            return false;
        }
        let expression: AstNode = unsafe { *(nodes + expression_index) };
        if !self.contextual_integer_expression_fits(
            nodes, node_count, expected_type, expression_index, source, source_len
        ) {
            return self.reject_node(expression);
        }
        let errors_before: usize = self.error_count;
        let actual_type: usize = self.infer_expression_type_ref(
            nodes, node_count, expression_index, source, source_len
        );
        if self.error_count != errors_before {
            return false;
        }
        if actual_type != 0 {
            let expected: AstNode = unsafe { *(nodes + expected_type) };
            let actual: AstNode = unsafe { *(nodes + actual_type) };
            let direct_match: bool = self.same_source_text(
                source, source_len, expected, actual
            );
            let dereference_match: bool = expression.kind == AstKind::ExprUnary
                && expression.int_value == 82
                && self.pointer_type_matches_pointee(
                    nodes, node_count, actual_type, expected_type, source, source_len
                );
            let indexed_match: bool = expression.kind == AstKind::ExprIndex
                && self.indexed_element_matches(source, source_len, actual, expected);
            if !direct_match && !dereference_match && !indexed_match {
                self.error_count = self.error_count + 1;
                self.error_line = expression.span.line;
                self.error_col = expression.span.col;
                return false;
            }
        }
        return true;
    }

    pub fn block_returns_value(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        block_index: usize
    ) -> bool {
        if nodes == null || block_index == 0 || block_index >= node_count {
            return false;
        }
        let block: AstNode = unsafe { *(nodes + block_index) };
        if block.kind != AstKind::Block {
            return false;
        }
        let mut statement_index: usize = block.first_child;
        let mut traversed: usize = 0;
        while statement_index != 0 {
            if statement_index >= node_count || traversed >= node_count {
                return false;
            }
            let statement: AstNode = unsafe { *(nodes + statement_index) };
            if statement.kind == AstKind::ReturnStmt {
                return true;
            }
            if statement.kind == AstKind::IfStmt || statement.kind == AstKind::MatchStmt
                || statement.kind == AstKind::UnsafeBlock {
                if self.statement_returns_value(nodes, node_count, statement_index) {
                    return true;
                }
            }
            if statement.kind == AstKind::IfStmt {
                let condition: usize = statement.first_child;
                if condition == 0 || condition >= node_count {
                    return false;
                }
                let condition_node: AstNode = unsafe { *(nodes + condition) };
                let then_index: usize = condition_node.next_sibling;
                if then_index == 0 || then_index >= node_count {
                    return false;
                }
                let then_returns: bool = self.block_returns_value(
                    nodes, node_count, then_index
                );
                let then_node: AstNode = unsafe { *(nodes + then_index) };
                let else_index: usize = then_node.next_sibling;
                if else_index != 0 {
                    let else_node: AstNode = unsafe { *(nodes + else_index) };
                    let mut else_returns: bool = false;
                    if else_node.kind == AstKind::IfStmt {
                        else_returns = self.statement_returns_value(
                            nodes, node_count, else_index
                        );
                    } else {
                        else_returns = self.block_returns_value(
                            nodes, node_count, else_index
                        );
                    }
                    if then_returns && else_returns {
                        return true;
                    }
                }
            }
            statement_index = statement.next_sibling;
            traversed = traversed + 1;
        }
        return false;
    }

    pub fn statement_returns_value(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        statement_index: usize
    ) -> bool {
        if nodes == null || statement_index == 0
            || statement_index >= node_count {
            return false;
        }
        let statement: AstNode = unsafe { *(nodes + statement_index) };
        if statement.kind == AstKind::ReturnStmt {
            return true;
        }
        if statement.kind == AstKind::UnsafeBlock {
            let body_index: usize = statement.first_child;
            if body_index == 0 || body_index >= node_count {
                return false;
            }
            return self.block_returns_value(nodes, node_count, body_index);
        }
        if statement.kind == AstKind::MatchStmt {
            let subject: usize = statement.first_child;
            if subject == 0 || subject >= node_count { return false; }
            let mut arm: usize = unsafe { (*(nodes + subject)).next_sibling };
            if arm == 0 { return false; }
            while arm != 0 {
                if arm >= node_count { return false; }
                let pattern: usize = unsafe { (*(nodes + arm)).first_child };
                if pattern == 0 || pattern >= node_count { return false; }
                let body: usize = unsafe { (*(nodes + pattern)).next_sibling };
                if !self.block_returns_value(nodes, node_count, body) { return false; }
                arm = unsafe { (*(nodes + arm)).next_sibling };
            }
            return true;
        }
        if statement.kind != AstKind::IfStmt {
            return false;
        }
        let condition: usize = statement.first_child;
        if condition == 0 || condition >= node_count {
            return false;
        }
        let condition_node: AstNode = unsafe { *(nodes + condition) };
        let then_index: usize = condition_node.next_sibling;
        if then_index == 0 || then_index >= node_count {
            return false;
        }
        let then_returns: bool = self.block_returns_value(
            nodes, node_count, then_index
        );
        let then_node: AstNode = unsafe { *(nodes + then_index) };
        let else_index: usize = then_node.next_sibling;
        if else_index == 0 || else_index >= node_count {
            return false;
        }
        let else_node: AstNode = unsafe { *(nodes + else_index) };
        let mut else_returns: bool = false;
        if else_node.kind == AstKind::IfStmt {
            else_returns = self.statement_returns_value(
                nodes, node_count, else_index
            );
        } else {
            else_returns = self.block_returns_value(
                nodes, node_count, else_index
            );
        }
        return then_returns && else_returns;
    }

    pub fn check_function_return_paths(
        mut self: &mut Self,
        nodes: *const AstNode,
        node_count: usize,
        function_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        if nodes == null || function_index == 0 || function_index >= node_count {
            self.error_count = self.error_count + 1;
            return false;
        }
        let function: AstNode = unsafe { *(nodes + function_index) };
        let mut child: usize = function.first_child;
        let mut has_result: bool = false;
        let mut body_index: usize = 0;
        while child != 0 {
            if child >= node_count {
                self.error_count = self.error_count + 1;
                return false;
            }
            let current: AstNode = unsafe { *(nodes + child) };
            if current.kind == AstKind::TypeRef {
                has_result = !self.source_slice_equals(source, source_len,
                    current.str_offset, current.str_len, "void", 4);
            }
            if current.kind == AstKind::Block {
                body_index = child;
            }
            child = current.next_sibling;
        }
        if !has_result || body_index == 0 {
            return true;
        }
        if !self.block_returns_value(nodes, node_count, body_index) {
            self.error_count = self.error_count + 1;
            self.error_line = function.span.line;
            self.error_col = function.span.col;
            return false;
        }
        return true;
    }

    pub fn find_visible_binding(
        self: &Self,
        nodes: *const AstNode,
        node_count: usize,
        expression_index: usize,
        source: *const u8,
        source_len: usize
    ) -> usize {
        if nodes == null || expression_index == 0 || expression_index >= node_count {
            return 0;
        }
        let expression: AstNode = unsafe { *(nodes + expression_index) };
        let mut parent_index: usize = expression.parent;
        let mut child_on_path: usize = expression_index;
        let mut traversed: usize = 0;
        while parent_index != 0 {
            if parent_index >= node_count || traversed >= node_count {
                return 0;
            }
            let parent: AstNode = unsafe { *(nodes + parent_index) };
            if parent.kind == AstKind::Block {
                let mut sibling_index: usize = parent.first_child;
                let mut found_path: bool = false;
                while sibling_index != 0 {
                    if sibling_index >= node_count {
                        return 0;
                    }
                    if sibling_index == child_on_path {
                        found_path = true;
                        break;
                    }
                    let sibling: AstNode = unsafe { *(nodes + sibling_index) };
                    if sibling.kind == AstKind::LetStmt
                        && self.same_declaration_name(
                            source, source_len, sibling, expression
                        ) {
                        return sibling_index;
                    }
                    sibling_index = sibling.next_sibling;
                }
                if !found_path {
                    return 0;
                }
            }
            if parent.kind == AstKind::FnDecl || parent.kind == AstKind::TrapfnDecl {
                let mut parameter_index: usize = parent.first_child;
                let mut parameter_count: usize = 0;
                while parameter_index != 0 {
                    if parameter_index >= node_count {
                        return 0;
                    }
                    let parameter: AstNode = unsafe { *(nodes + parameter_index) };
                    if parameter.kind == AstKind::ParamDecl {
                        parameter_count = parameter_count + 1;
                        if parameter_count > MAX_SYMBOLS {
                            return 0;
                        }
                        if self.same_declaration_name(
                            source, source_len, parameter, expression
                        ) {
                            return parameter_index;
                        }
                    }
                    parameter_index = parameter.next_sibling;
                }
            }
            if parent.kind == AstKind::Module {
                let mut decl_index: usize = parent.first_child;
                while decl_index != 0 {
                    if decl_index >= node_count {
                        return 0;
                    }
                    let decl: AstNode = unsafe { *(nodes + decl_index) };
                    if decl.kind == AstKind::LetStmt
                        && self.same_declaration_name(
                            source, source_len, decl, expression
                        ) {
                        return decl_index;
                    }
                    decl_index = decl.next_sibling;
                }
                return 0;
            }
            child_on_path = parent_index;
            parent_index = parent.parent;
            traversed = traversed + 1;
        }
        return 0;
    }

    pub fn check_function_parameters(
        mut self: &mut Self,
        nodes: *const AstNode,
        node_count: usize,
        function_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        let function: AstNode = unsafe { *(nodes + function_index) };
        let mut current_index: usize = function.first_child;
        let mut parameter_count: usize = 0;
        while current_index != 0 {
            if current_index >= node_count {
                self.error_count = self.error_count + 1;
                return false;
            }
            let current: AstNode = unsafe { *(nodes + current_index) };
            if current.kind == AstKind::ParamDecl {
                parameter_count = parameter_count + 1;
                if parameter_count > MAX_SYMBOLS {
                    self.error_count = self.error_count + 1;
                    self.error_line = current.span.line;
                    self.error_col = current.span.col;
                    return false;
                }
                let mut previous_index: usize = function.first_child;
                while previous_index != current_index {
                    if previous_index == 0 || previous_index >= node_count {
                        self.error_count = self.error_count + 1;
                        return false;
                    }
                    let previous: AstNode = unsafe { *(nodes + previous_index) };
                    if previous.kind == AstKind::ParamDecl
                        && self.same_declaration_name(
                            source, source_len, previous, current
                        ) {
                        self.error_count = self.error_count + 1;
                        self.error_line = current.span.line;
                        self.error_col = current.span.col;
                        return false;
                    }
                    previous_index = previous.next_sibling;
                }
            }
            current_index = current.next_sibling;
        }
        return true;
    }

    pub fn check_block_locals(
        mut self: &mut Self,
        nodes: *const AstNode,
        node_count: usize,
        block_index: usize,
        source: *const u8,
        source_len: usize
    ) -> bool {
        let block: AstNode = unsafe { *(nodes + block_index) };
        let mut current_index: usize = block.first_child;
        let mut local_count: usize = 0;
        while current_index != 0 {
            if current_index >= node_count {
                self.error_count = self.error_count + 1;
                return false;
            }
            let current: AstNode = unsafe { *(nodes + current_index) };
            if current.kind == AstKind::LetStmt {
                local_count = local_count + 1;
                if local_count > MAX_SYMBOLS {
                    self.error_count = self.error_count + 1;
                    self.error_line = current.span.line;
                    self.error_col = current.span.col;
                    return false;
                }
                let mut previous_index: usize = block.first_child;
                while previous_index != current_index {
                    if previous_index == 0 || previous_index >= node_count {
                        self.error_count = self.error_count + 1;
                        return false;
                    }
                    let previous: AstNode = unsafe { *(nodes + previous_index) };
                    if previous.kind == AstKind::LetStmt
                        && self.same_declaration_name(
                            source, source_len, previous, current
                        ) {
                        self.error_count = self.error_count + 1;
                        self.error_line = current.span.line;
                        self.error_col = current.span.col;
                        return false;
                    }
                    previous_index = previous.next_sibling;
                }
            }
            current_index = current.next_sibling;
        }
        return true;
    }
}

pub struct NativeOwnershipCheck {
    pub nodes: *const AstNode;
    pub node_count: usize;
    pub source: *const u8;
    pub source_len: usize;
    pub bindings: [usize; 256];
    pub states: [u8; 256];
    pub domains: [u8; 256];
    pub deferred: [u8; 256];
    pub mixed_break_states: [u8; 256];
    pub count: usize;
    pub error_node: usize;
    pub error_reason: u32;
    pub return_domain: i64;
}

impl NativeOwnershipCheck {
    pub fn fail(mut self: &mut Self, node: usize) -> bool {
        self.error_node = node;
        if self.error_reason == 0 { self.error_reason = 1; }
        return false;
    }
    pub fn fail_reason(mut self: &mut Self, node: usize, reason: u32) -> bool {
        self.error_reason = reason; return self.fail(node);
    }
    pub fn domain(self: &Self, binding: usize) -> i64 {
        if binding == 0 || binding >= self.node_count { return 0; }
        let node: AstNode = unsafe { *(self.nodes + binding) };
        if node.first_child == 0 || node.first_child >= self.node_count { return 0; }
        let typ: AstNode = unsafe { *(self.nodes + node.first_child) };
        if typ.kind == AstKind::TypeRef { return typ.int_value; }
        return 0;
    }
    pub fn slot(self: &Self, expression: usize) -> usize {
        if expression == 0 || expression >= self.node_count { return 256; }
        let node: AstNode = unsafe { *(self.nodes + expression) };
        let mut index: usize = self.count;
        let mut sem: Sema = Sema::new();
        while index > 0 {
            index = index - 1;
            let binding: AstNode = unsafe { *(self.nodes + self.bindings[index]) };
            if sem.same_source_text(self.source, self.source_len, node, binding) { return index; }
        }
        return 256;
    }
    pub fn bind(mut self: &mut Self, node: usize) -> bool {
        if self.count >= 256 { return self.fail(node); }
        self.bindings[self.count] = node;
        self.domains[self.count] = self.domain(node) as u8;
        self.states[self.count] = 1;
        self.deferred[self.count] = 0;
        self.count = self.count + 1;
        return true;
    }
    pub fn expression_domain(self: &Self, node_index: usize) -> i64 {
        return self.expression_domain_at(node_index, 0);
    }
    pub fn expression_domain_at(self: &Self, node_index: usize, depth: usize) -> i64 {
        if depth >= 64 { return 1; }
        if node_index == 0 || node_index >= self.node_count { return 0; }
        let node: AstNode = unsafe { *(self.nodes + node_index) };
        if node.kind == AstKind::UnsafeExpr { return self.expression_domain_at(node.first_child, depth + 1); }
        if node.kind == AstKind::ExprConditional {
            let condition: usize = node.first_child;
            if condition == 0 || condition >= self.node_count { return 9; }
            let yes: usize = unsafe { (*(self.nodes + condition)).next_sibling };
            if yes == 0 || yes >= self.node_count { return 9; }
            let no: usize = unsafe { (*(self.nodes + yes)).next_sibling };
            if no == 0 || no >= self.node_count { return 9; }
            let yes_domain: i64 = self.expression_domain_at(yes, depth + 1);
            let no_domain: i64 = self.expression_domain_at(no, depth + 1);
            if yes_domain == no_domain || no_domain == 0 { return yes_domain; }
            if yes_domain == 0 { return no_domain; }
            return 9;
        }

        if node.kind == AstKind::ExprIdent {
            let index: usize = self.slot(node_index);
            if index < self.count { return self.domains[index] as i64; }
        }
        if node.kind == AstKind::ExprCall && node.first_child != 0 && node.first_child < self.node_count {
            let callee: AstNode = unsafe { *(self.nodes + node.first_child) };
            let mut sem: Sema = Sema::new();
            let function: usize = sem.ownership_called_function(self.nodes, self.node_count, node_index, self.source, self.source_len);
            if function == 0 { return 0; }
            let mut child: usize = unsafe { (*(self.nodes + function)).first_child };
            while child != 0 && child < self.node_count {
                let result: AstNode = unsafe { *(self.nodes + child) };
                if result.kind == AstKind::TypeRef { return result.int_value; }
                child = result.next_sibling;
            }
        }
        return 0;
    }
    pub fn contains_owner(self: &Self, node_index: usize, depth: usize) -> bool {
        if node_index == 0 || node_index >= self.node_count || depth >= 64 { return true; }
        let node: AstNode = unsafe { *(self.nodes + node_index) };
        if node.kind == AstKind::ExprIdent {
            let index: usize = self.slot(node_index);
            return index < self.count && self.domains[index] != 0;
        }
        let mut child: usize = node.first_child;
        while child != 0 {
            if self.contains_owner(child, depth + 1) { return true; }
            child = unsafe { (*(self.nodes + child)).next_sibling };
        }
        return false;
    }
    pub fn contains_borrow(self: &Self, node_index: usize, depth: usize) -> bool {
        if node_index == 0 || node_index >= self.node_count || depth >= 64 { return true; }
        let node: AstNode = unsafe { *(self.nodes + node_index) };
        if node.kind == AstKind::ExprIdent {
            let index: usize = self.slot(node_index);
            return index < self.count && (self.domains[index] == 4 || self.domains[index] == 6);
        }
        let mut child: usize = node.first_child;
        while child != 0 {
            if child >= self.node_count || self.contains_borrow(child, depth + 1) { return true; }
            child = unsafe { (*(self.nodes + child)).next_sibling };
        }
        return false;
    }
    // Capturing owned bindings requires a separate reservation/cleanup
    // contract. Reject it before lowering instead of treating it as a read.
    pub fn defer_ownership_free(self: &Self, index: usize, depth: usize) -> bool {
        if index == 0 || index >= self.node_count || depth >= 64 { return false; }
        let node: AstNode = unsafe { *(self.nodes + index) };
        if node.kind == AstKind::TypeRef && node.int_value != 0 { return false; }
        if node.kind == AstKind::ExprIdent {
            let binding: usize = self.slot(index);
            if binding < self.count && self.domains[binding] != 0 { return false; }
        }
        let mut child: usize = node.first_child;
        while child != 0 {
            if child >= self.node_count || !self.defer_ownership_free(child, depth + 1) { return false; }
            child = unsafe { (*(self.nodes + child)).next_sibling };
        }
        return true;
    }

    pub fn collect_borrow_roots(self: &Self, index: usize, mask: *mut u8, depth: usize) -> bool {
        if index == 0 || index >= self.node_count || mask == null || depth >= 64 { return false; }
        let node: AstNode = unsafe { *(self.nodes + index) };
        if node.kind == AstKind::ExprIdent {
            let owner: usize = self.slot(index);
            if owner < self.count && self.domains[owner] != 0 { unsafe { *(mask + owner) = 1; } }
            return true;
        }
        if node.kind == AstKind::UnsafeExpr || node.kind == AstKind::ExprFieldAccess {
            return self.collect_borrow_roots(node.first_child, mask, depth + 1);
        }
        if node.kind == AstKind::ExprIndex || node.kind == AstKind::ExprBinary
            || node.kind == AstKind::ExprUnary || node.kind == AstKind::ExprCast {
            let mut child: usize = node.first_child;
            while child != 0 {
                if child >= self.node_count
                    || !self.collect_borrow_roots(child,mask,depth+1) { return false; }
                child = unsafe { (*(self.nodes + child)).next_sibling };
            }
            return true;
        }
        if node.kind == AstKind::ExprConditional {
            let condition: usize = node.first_child;
            if condition == 0 || condition >= self.node_count { return false; }
            let yes: usize = unsafe { (*(self.nodes + condition)).next_sibling };
            if yes == 0 || yes >= self.node_count { return false; }
            let no: usize = unsafe { (*(self.nodes + yes)).next_sibling };
            return self.collect_borrow_roots(condition,mask,depth+1)
                && self.collect_borrow_roots(yes, mask, depth + 1)
                && self.collect_borrow_roots(no, mask, depth + 1);
        }
        // A resolved internal call produces its own scalar result. Its
        // receiver/arguments were checked by expression() before the outer
        // call consumes anything; they are not stored borrows of that result.
        if node.kind == AstKind::ExprCall && self.expression_domain(index) == 0 {
            let mut sem: Sema = Sema::new();
            let result: usize = sem.infer_expression_type_ref(
                self.nodes,self.node_count,index,self.source,self.source_len
            );
            if result == 0 || result >= self.node_count
                || sem.is_pointer_type_ref(
                    self.nodes,self.node_count,result,self.source,self.source_len
                ) { return false; }
            let typ: AstNode = unsafe { *(self.nodes + result) };
            return typ.kind == AstKind::TypeRef && typ.int_value == 0;
        }
        // All other opaque owner-bearing expressions fail closed.
        return !self.contains_owner(index, depth + 1);
    }

    pub fn scalar_projection(self: &Self, index: usize, depth: usize) -> bool {
        if index == 0 || index >= self.node_count || depth >= 64 { return false; }
        let node: AstNode = unsafe { *(self.nodes + index) };
        let mut sem: Sema = Sema::new();
        if node.kind == AstKind::ExprIndex {
            let typ: usize = sem.infer_expression_type_ref(self.nodes,self.node_count,node.first_child,self.source,self.source_len);
            return typ != 0 && typ < self.node_count
                && sem.ownership_pod_array(unsafe { *(self.nodes + typ) },self.source,self.source_len);
        }
        if node.kind == AstKind::ExprFieldAccess {
            let typ: usize = sem.find_struct_field_for_access(self.nodes,self.node_count,index,self.source,self.source_len);
            if typ == 0 || typ >= self.node_count { return false; }
            let field: AstNode = unsafe { *(self.nodes + typ) };
            return sem.fixed_integer_type_tag(self.nodes,self.node_count,typ,self.source,self.source_len) != 0
                || sem.source_slice_equals(self.source,self.source_len,field.str_offset,field.str_len,"f32",3)
                || sem.source_slice_equals(self.source,self.source_len,field.str_offset,field.str_len,"f64",3)
                || sem.source_slice_equals(self.source,self.source_len,field.str_offset,field.str_len,"bool",4);
        }
        if node.kind == AstKind::ExprLiteral { return true; }
        if node.kind == AstKind::UnsafeExpr { return self.scalar_projection(node.first_child,depth+1); }
        if node.kind == AstKind::ExprBinary {
            let left: usize = node.first_child;
            return left != 0 && left < self.node_count && self.scalar_projection(left,depth+1)
                && self.scalar_projection(unsafe { (*(self.nodes + left)).next_sibling },depth+1);
        }
        return false;
    }

    pub fn reserve_defer_roots(mut self: &mut Self, index: usize, depth: usize) -> bool {
        if index == 0 || index >= self.node_count || depth >= 64 { return self.fail(index); }
        let node: AstNode = unsafe { *(self.nodes + index) };
        if node.kind == AstKind::ExprIdent {
            let owner: usize = self.slot(index);
            if owner < self.count && self.domains[owner] != 0 { self.deferred[owner] = 1; }
        }
        let mut child: usize = node.first_child;
        while child != 0 {
            if child >= self.node_count || !self.reserve_defer_roots(child,depth+1) { return false; }
            child = unsafe { (*(self.nodes + child)).next_sibling };
        }
        return true;
    }

    // Reuse the canonical lexical resolver instead of a second scoping
    // algorithm. Module globals are excluded from pure deferred arguments.
    pub fn deferred_effect_local(self: &Self, index: usize) -> bool {
        if index == 0 || index >= self.node_count { return false; }
        let mut sem: Sema = Sema::new();
        let binding: usize = sem.find_visible_binding(
            self.nodes,self.node_count,index,self.source,self.source_len
        );
        if binding == 0 || binding >= self.node_count { return false; }
        let node: AstNode = unsafe { *(self.nodes + binding) };
        if node.kind == AstKind::ParamDecl { return true; }
        if node.kind != AstKind::LetStmt || node.parent == 0
            || node.parent >= self.node_count { return false; }
        return unsafe { (*(self.nodes + node.parent)).kind } != AstKind::Module;
    }

    // SV8.46: only argument computations of an owned deferred borrow are
    // proven effect-free. The eventual deferred observer is *not* claimed
    // pure: it may write independent state, but cannot mutate/escape its
    // direct/whisper owner. Unknown, foreign and cyclic callees fail closed.
    // This walks the original typed AST, not string matches or C metadata.
    pub fn deferred_argument_effects(self: &Self, index: usize, depth: usize) -> bool {
        if index == 0 || index >= self.node_count || depth >= 32 { return false; }
        let node: AstNode = unsafe { *(self.nodes + index) };
        if node.kind == AstKind::UnsafeExpr || node.kind == AstKind::UnsafeBlock
            || node.kind == AstKind::AssignStmt || node.kind == AstKind::DeferStmt
            || node.kind == AstKind::TryExpr || node.kind == AstKind::ExprCast
            || node.kind == AstKind::AsmStmt || node.kind == AstKind::ClinchStmt
            || node.kind == AstKind::DiscernStmt || node.kind == AstKind::TrapfnDecl
            || node.kind == AstKind::WhileStmt || node.kind == AstKind::MatchStmt {
            return false;
        }
        if node.kind == AstKind::ExprIdent && !self.deferred_effect_local(index) {
            return false;
        }
        if node.kind == AstKind::ExprUnary && (node.int_value == 82 || node.int_value == 92) {
            return false;
        }
        if node.kind == AstKind::ExprCall {
            let mut sem: Sema = Sema::new();
            let callee: usize = sem.ownership_called_function(
                self.nodes, self.node_count, index, self.source, self.source_len
            );
            if callee == 0 || callee >= self.node_count { return false; }
            let called: AstNode = unsafe { *(self.nodes + callee) };
            if called.kind != AstKind::FnDecl { return false; }
            let mut body: usize = called.first_child;
            let mut checked_body: bool = false;
            while body != 0 {
                if body >= self.node_count { return false; }
                let declaration: AstNode = unsafe { *(self.nodes + body) };
                if declaration.kind == AstKind::ParamDecl {
                    // A consuming or pointer-escaping input is a capability,
                    // even when the callee body has no mutable statements.
                    let type_index: usize = declaration.first_child;
                    if type_index == 0 || type_index >= self.node_count { return false; }
                    let typ: AstNode = unsafe { *(self.nodes + type_index) };
                    if typ.kind != AstKind::TypeRef
                        || (typ.int_value != 0 && typ.int_value != 4 && typ.int_value != 6) {
                        return false;
                    }
                    if sem.is_pointer_type_ref(
                        self.nodes,self.node_count,type_index,self.source,self.source_len
                    ) {
                        // Preserve the existing readonly instance receiver.
                        if !sem.source_slice_equals(
                            self.source,self.source_len,
                            declaration.str_offset,declaration.str_len,"self",4
                        ) || !sem.source_slice_equals(
                            self.source,self.source_len,
                            typ.str_offset,typ.str_len,"&Self",5
                        ) { return false; }
                    }
                } else if declaration.kind == AstKind::TypeRef {
                    // Owned, borrowed and pointer results cannot be treated
                    // as independent effect-free scalar values.
                    if declaration.int_value != 0 || sem.is_pointer_type_ref(
                        self.nodes,self.node_count,body,self.source,self.source_len
                    ) { return false; }
                } else if declaration.kind == AstKind::Block {
                    if checked_body || !self.deferred_argument_effects(body, depth + 1) {
                        return false;
                    }
                    checked_body = true;
                }
                body = declaration.next_sibling;
            }
            if !checked_body { return false; }
            // Calee path identifiers are symbols, not value expressions.
            // Traverse only a receiver and the actual argument expressions.
            let callee_expression: usize = node.first_child;
            if callee_expression == 0 || callee_expression >= self.node_count { return false; }
            let name: AstNode = unsafe { *(self.nodes + callee_expression) };
            if name.kind == AstKind::ExprFieldAccess {
                if !self.deferred_argument_effects(name.first_child,depth+1) { return false; }
            } else if name.kind != AstKind::ExprIdent && name.kind != AstKind::ExprPath {
                return false;
            }
            let mut argument: usize = name.next_sibling;
            while argument != 0 {
                if argument >= self.node_count
                    || !self.deferred_argument_effects(argument,depth+1) { return false; }
                argument = unsafe { (*(self.nodes + argument)).next_sibling };
            }
            return true;
        }
        let mut child: usize = node.first_child;
        while child != 0 {
            if child >= self.node_count || !self.deferred_argument_effects(child, depth + 1) {
                return false;
            }
            child = unsafe { (*(self.nodes + child)).next_sibling };
        }
        return true;
    }

    // Only calls capturing an owned POD root need this incremental effect
    // proof. Existing ownership-free defers and observer bodies are unchanged.
    pub fn deferred_call_effects(self: &Self, index: usize) -> bool {
        if index == 0 || index >= self.node_count { return false; }
        let call: AstNode = unsafe { *(self.nodes + index) };
        if call.kind != AstKind::ExprCall || call.first_child == 0
            || call.first_child >= self.node_count { return false; }
        if !self.contains_owner(index,0) { return true; }
        let callee: AstNode = unsafe { *(self.nodes + call.first_child) };
        if callee.kind == AstKind::ExprFieldAccess
            && !self.deferred_argument_effects(callee.first_child,0) { return false; }
        let mut argument: usize = callee.next_sibling;
        while argument != 0 {
            if argument >= self.node_count || !self.deferred_argument_effects(argument,0) {
                return false;
            }
            argument = unsafe { (*(self.nodes + argument)).next_sibling };
        }
        return true;
    }

    // A deferred block may borrow owned POD roots only through a bounded
    // sequence of non-owning, direct calls. At registration, validate *each*
    // call and reserve its roots for the whole lexical cleanup scope. This is
    // not a general owned closure: assignments, nested scopes, consuming calls
    // and resource-bearing return values remain fail-closed.
    pub fn reserve_readonly_defer_block(mut self: &mut Self, block: usize) -> bool {
        if block == 0 || block >= self.node_count { return self.fail_reason(block,5); }
        let payload: AstNode = unsafe { *(self.nodes + block) };
        if payload.kind != AstKind::Block || payload.first_child == 0 {
            return self.fail_reason(block,5);
        }
        let mut action: usize = payload.first_child;
        let mut count: usize = 0;
        while action != 0 {
            if action >= self.node_count || count >= 128 { return self.fail_reason(block,5); }
            let statement: AstNode = unsafe { *(self.nodes + action) };
            if statement.kind != AstKind::ExprCall || self.expression_domain(action) != 0
                || !self.deferred_call_effects(action) {
                return self.fail_reason(action,6);
            }
            let mut before: [u8;256] = 0;
            let mut slot: usize = 0;
            while slot < self.count {
                before[slot] = self.states[slot];
                slot = slot + 1;
            }
            if !self.expression(action,false,0) { return false; }
            slot = 0;
            while slot < self.count {
                if before[slot] != self.states[slot] {
                    return self.fail_reason(action,5);
                }
                slot = slot + 1;
            }
            if !self.reserve_defer_roots(action,0) { return false; }
            action = statement.next_sibling;
            count = count + 1;
        }
        return true;
    }

    pub fn expression(mut self: &mut Self, node_index: usize, take: bool, depth: usize) -> bool {
        if node_index == 0 { return true; }
        if node_index >= self.node_count || depth >= 64 { return self.fail(node_index); }
        let node: AstNode = unsafe { *(self.nodes + node_index) };
        if node.kind == AstKind::UnsafeExpr {
            return self.expression(node.first_child, take, depth + 1);
        }
        if node.kind == AstKind::ExprIdent {
            let index: usize = self.slot(node_index);
            if index < self.count && self.domains[index] != 0 {
                if self.states[index] != 1 { return self.fail_reason(node_index,2); }
                if take {
                    if self.deferred[index] != 0 { return self.fail_reason(node_index,5); }
                    if self.domains[index] != 1 { return self.fail(node_index); }
                    self.states[index] = 2;
                }
            }
            return true;
        }
        if node.kind == AstKind::ExprUnary && node.int_value == 92 {
            if self.contains_owner(node.first_child, depth + 1) { return self.fail_reason(node_index,4); }
        }
        if node.kind == AstKind::ExprCast && self.contains_owner(node.first_child,depth+1) {
            let operand: usize = node.first_child;
            let cast_type: usize = unsafe { (*(self.nodes + operand)).next_sibling };
            let mut cast_sem: Sema = Sema::new();
            if cast_type == 0 || cast_type >= self.node_count
                || cast_sem.is_pointer_type_ref(self.nodes,self.node_count,cast_type,self.source,self.source_len)
                || !self.scalar_projection(operand,0) { return self.fail_reason(node_index,4); }
        }
        if node.kind == AstKind::ExprCall {
            let callee_index: usize = node.first_child;
            if callee_index == 0 || callee_index >= self.node_count { return self.fail(node_index); }
            let callee: AstNode = unsafe { *(self.nodes + callee_index) };
            let mut sem: Sema = Sema::new();
            let function: usize = sem.ownership_called_function(self.nodes, self.node_count, node_index, self.source, self.source_len);
            let mut parameter: usize = 0;
            if function != 0 { parameter = unsafe { (*(self.nodes + function)).first_child }; }
            let mut borrowed: [u8;256] = 0;
            if callee.kind == AstKind::ExprFieldAccess && parameter != 0 && parameter < self.node_count {
                let receiver_domain: i64 = self.domain(parameter);
                if self.contains_owner(callee.first_child,depth+1)
                    && receiver_domain != 4 && receiver_domain != 6 { return self.fail_reason(node_index,4); }
                if (receiver_domain == 4 || receiver_domain == 6)
                    && !self.collect_borrow_roots(callee.first_child,unsafe { borrowed as *mut u8 },0) { return self.fail(node_index); }
                if !self.expression(callee.first_child,false,depth+1) { return false; }
                parameter = unsafe { (*(self.nodes + parameter)).next_sibling };
            } else if callee.kind == AstKind::ExprFieldAccess && self.contains_owner(callee_index,depth+1) {
                return self.fail_reason(node_index,4);
            }
            let mut argument: usize = callee.next_sibling;
            while argument != 0 {
                let mut consumes: bool = false;
                let mut borrow: bool = false;
                if parameter != 0 && parameter < self.node_count {
                    let param: AstNode = unsafe { *(self.nodes + parameter) };
                    if param.kind == AstKind::ParamDecl {
                        consumes = self.domain(parameter) == 1;
                        borrow = self.domain(parameter) == 4 || self.domain(parameter) == 6;
                        parameter = param.next_sibling;
                    }
                }
                let arg: AstNode = unsafe { *(self.nodes + argument) };
                if !consumes && !borrow && self.expression_domain(argument) != 0 { return self.fail(argument); }
                if borrow && !self.collect_borrow_roots(argument, unsafe { borrowed as *mut u8 }, 0) { return self.fail(argument); }
                if !self.expression(argument, consumes, depth + 1) { return false; }
                argument = arg.next_sibling;
            }
            let mut slot: usize = 0;
            while slot < self.count {
                if borrowed[slot] != 0 && self.states[slot] != 1 { return self.fail(node_index); }
                slot = slot + 1;
            }
            return true;
        }
        if node.kind == AstKind::ExprConditional {
            let condition: usize = node.first_child;
            if condition == 0 || condition >= self.node_count || !self.expression(condition, false, depth + 1) { return self.fail(node_index); }
            let yes: usize = unsafe { (*(self.nodes + condition)).next_sibling };
            if yes == 0 || yes >= self.node_count { return self.fail(node_index); }
            let no: usize = unsafe { (*(self.nodes + yes)).next_sibling };
            if no == 0 || no >= self.node_count { return self.fail(node_index); }
            let domain: i64 = self.expression_domain(node_index);
            if domain != 0 && domain != 1 && domain != 4 && domain != 6 { return self.fail(node_index); }
            let scope: usize = self.count;
            let mut before: [u8;256] = 0; let mut after_yes: [u8;256] = 0;
            let mut index: usize = 0;
            while index < scope { before[index] = self.states[index]; index = index + 1; }
            if !self.expression(yes, take, depth + 1) { return false; }
            index = 0;
            while index < scope { after_yes[index] = self.states[index]; self.states[index] = before[index]; index = index + 1; }
            if !self.expression(no, take, depth + 1) { return false; }
            index = 0;
            while index < scope {
                if self.domains[index] != 0 && after_yes[index] != self.states[index] { self.states[index] = 3; }
                index = index + 1;
            }
            return true;
        }
        if node.kind == AstKind::ExprBinary && (node.int_value == 110 || node.int_value == 111) {
            let left: usize = node.first_child;
            if left == 0 || left >= self.node_count || !self.expression(left,false,depth+1) { return self.fail(node_index); }
            let right: usize = unsafe { (*(self.nodes + left)).next_sibling };
            let scope: usize = self.count;
            let mut before: [u8;256] = 0; let mut slot: usize = 0;
            while slot < scope { before[slot] = self.states[slot]; slot = slot+1; }
            if !self.expression(right,false,depth+1) { return false; }
            let first: AstNode = unsafe { *(self.nodes + left) };
            let mut literal_sem: Sema = Sema::new();
            let yes: bool = first.kind == AstKind::ExprLiteral && literal_sem.source_slice_equals(self.source,self.source_len,first.str_offset,first.str_len,"true",4);
            let no: bool = first.kind == AstKind::ExprLiteral && literal_sem.source_slice_equals(self.source,self.source_len,first.str_offset,first.str_len,"false",5);
            let skipped: bool = (no && node.int_value == 110) || (yes && node.int_value == 111);
            slot = 0;
            while slot < scope {
                if skipped { self.states[slot] = before[slot]; }
                else if !yes && !no && self.domains[slot] != 0 && before[slot] != self.states[slot] { self.states[slot] = 3; }
                slot = slot+1;
            }
            return true;
        }
        if node.kind == AstKind::StructFieldInit && self.expression_domain(node.first_child) != 0 { return self.fail(node_index); }
        if node.kind == AstKind::ExprArrayLiteral || node.kind == AstKind::ExprArrayRepeat {
            let mut element: usize = node.first_child;
            while element != 0 {
                if element >= self.node_count || self.expression_domain(element) != 0 { return self.fail(node_index); }
                element = unsafe { (*(self.nodes + element)).next_sibling };
            }
        }
        let mut child: usize = node.first_child;
        while child != 0 {
            if child >= self.node_count || !self.expression(child, false, depth + 1) { return false; }
            child = unsafe { (*(self.nodes + child)).next_sibling };
        }
        return true;
    }
    pub fn sequence(mut self: &mut Self, first: usize, depth: usize) -> i64 {
        let mut reservations: [u8;256] = 0; let mut slot: usize = 0;
        while slot < self.count { reservations[slot] = self.deferred[slot]; slot = slot+1; }
        let result: i64 = self.sequence_inner(first,depth);
        slot = 0;
        while slot < self.count { self.deferred[slot] = reservations[slot]; slot = slot+1; }
        return result;
    }
    pub fn sequence_inner(mut self: &mut Self, first: usize, depth: usize) -> i64 {
        if depth >= 64 { self.error_node = first; return 0; }
        let mut index: usize = first;
        while index != 0 {
            if index >= self.node_count { self.error_node = index; return 0; }
            let node: AstNode = unsafe { *(self.nodes + index) };
            if node.kind == AstKind::DeferStmt {
                if !self.defer_ownership_free(node.first_child,0) {
                    if node.first_child == 0 || node.first_child >= self.node_count {
                        self.fail_reason(index,5); return 0;
                    }
                    let payload: AstNode = unsafe { *(self.nodes + node.first_child) };
                    if payload.kind == AstKind::Block {
                        if !self.reserve_readonly_defer_block(node.first_child) { return 0; }
                    } else if payload.kind == AstKind::ExprCall {
                        if !self.deferred_call_effects(node.first_child) {
                            self.fail_reason(node.first_child,6); return 0;
                        }
                        let mut before: [u8;256] = 0; let mut slot: usize = 0;
                        while slot < self.count { before[slot] = self.states[slot]; slot = slot+1; }
                        if !self.expression(node.first_child,false,0) { return 0; }
                        slot = 0;
                        while slot < self.count {
                            if before[slot] != self.states[slot] { self.fail_reason(index,5); return 0; }
                            slot = slot+1;
                        }
                        if !self.reserve_defer_roots(node.first_child,0) { return 0; }
                    } else {
                        self.fail_reason(index,5); return 0;
                    }
                }
            } else if node.kind == AstKind::LetStmt {
                let mut value: usize = node.first_child;
                if value != 0 && unsafe { (*(self.nodes + value)).kind } == AstKind::TypeRef { value = unsafe { (*(self.nodes + value)).next_sibling }; }
                if self.domain(index) == 0 && self.expression_domain(value) != 0 { self.error_node = value; return 0; }
                if !self.expression(value, self.domain(index) != 0, 0) || !self.bind(index) { return 0; }
            } else if node.kind == AstKind::ReturnStmt {
                if self.return_domain == 0 && self.expression_domain(node.first_child) != 0 { self.error_node = node.first_child; return 0; }
                if !self.expression(node.first_child, self.return_domain != 0, 0) { return 0; }
                return 2;
            } else if node.kind == AstKind::Block || node.kind == AstKind::UnsafeBlock {
                let scope: usize = self.count;
                let result: i64 = self.sequence(node.first_child, depth + 1);
                self.count = scope;
                if result != 1 { return result; }
            } else if node.kind == AstKind::MatchStmt {
                let subject: usize = node.first_child;
                if subject == 0 || subject >= self.node_count || self.expression_domain(subject) != 0
                    || !self.expression(subject, false, 0) { return 0; }
                let scope: usize = self.count;
                let mut before: [u8;256] = 0; let mut merged: [u8;256] = 0;
                let mut slot: usize = 0;
                while slot < scope { before[slot] = self.states[slot]; slot = slot + 1; }
                let mut arm: usize = unsafe { (*(self.nodes + subject)).next_sibling };
                let mut live: bool = false; let mut arms: usize = 0;
                let mut loop_exit: i64 = 0; let mut has_break: bool = false;
                let mut arm_breaks: [u8;256] = 0;
                let mut fallthrough: bool = false;
                while arm != 0 {
                    if arm >= self.node_count || arms >= 64 { self.error_node = index; return 0; }
                    let pattern: usize = unsafe { (*(self.nodes + arm)).first_child };
                    if pattern == 0 || pattern >= self.node_count { self.error_node = index; return 0; }
                    let body: usize = unsafe { (*(self.nodes + pattern)).next_sibling };
                    if body == 0 || body >= self.node_count { self.error_node = index; return 0; }
                    self.count = scope; slot = 0;
                    while slot < scope { self.states[slot] = before[slot]; slot = slot + 1; }
                    let result: i64 = self.sequence(unsafe { (*(self.nodes + body)).first_child }, depth + 1);
                    if result == 0 { self.error_node = index; return 0; }
                    if result >= 3 {
                        if fallthrough || result > 5 { self.error_node = index; return 0; }
                        slot = 0;
                        while slot < scope {
                            if self.domains[slot] != 0 && result != 3 && self.states[slot] != before[slot] {
                                self.error_node = index; return 0;
                            }
                            if result != 4 {
                                let mut breaking: u8=self.states[slot];
                                if result == 5 { breaking=self.mixed_break_states[slot]; }
                                if !has_break { arm_breaks[slot]=breaking; }
                                else if self.domains[slot] != 0 && arm_breaks[slot] != breaking { arm_breaks[slot]=3; }
                            }
                            slot = slot + 1;
                        }
                        if result != 4 { has_break = true; }
                        if loop_exit == 0 { loop_exit = result; }
                        else if loop_exit != result { loop_exit = 5; }
                    } else if result == 1 {
                        if loop_exit != 0 { self.error_node = index; return 0; }
                        fallthrough = true;
                    }
                    if result == 1 || result >= 3 {
                        slot = 0;
                        while slot < scope {
                            if !live { merged[slot] = self.states[slot]; }
                            else if self.domains[slot] != 0 && merged[slot] != self.states[slot] { merged[slot] = 3; }
                            slot = slot + 1;
                        }
                        live = true;
                    }
                    arms = arms + 1; arm = unsafe { (*(self.nodes + arm)).next_sibling };
                }
                self.count = scope;
                if arms == 0 { self.error_node = index; return 0; }
                if !live { return 2; }
                slot = 0;
                while slot < scope {
                    if has_break { self.mixed_break_states[slot]=arm_breaks[slot]; }
                    if loop_exit == 5 { self.states[slot] = before[slot]; }
                    else if loop_exit == 3 { self.states[slot]=arm_breaks[slot]; }
                    else { self.states[slot] = merged[slot]; }
                    slot = slot + 1;
                }
                if loop_exit != 0 { return loop_exit; }
            } else if node.kind == AstKind::IfStmt {
                let condition: usize = node.first_child;
                if condition == 0 || condition >= self.node_count || !self.expression(condition, false, 0) { self.error_node = index; return 0; }
                let yes: usize = unsafe { (*(self.nodes + condition)).next_sibling };
                if yes == 0 || yes >= self.node_count { self.error_node = index; return 0; }
                let no: usize = unsafe { (*(self.nodes + yes)).next_sibling };
                let scope: usize = self.count;
                let mut before: [u8;256] = 0; let mut after_yes: [u8;256] = 0;
                let mut slot: usize = 0;
                while slot < scope { before[slot] = self.states[slot]; slot = slot + 1; }
                let mut yes_breaks: [u8;256] = 0;
                let yes_result: i64 = self.sequence(unsafe { (*(self.nodes + yes)).first_child }, depth + 1);
                if yes_result == 0 { return 0; }
                self.count = scope; slot = 0;
                while slot < scope { after_yes[slot] = self.states[slot]; yes_breaks[slot] = self.mixed_break_states[slot]; self.states[slot] = before[slot]; slot = slot + 1; }
                let mut no_result: i64 = 1;
                if no != 0 {
                    if no >= self.node_count { self.error_node = index; return 0; }
                    let no_node: AstNode = unsafe { *(self.nodes + no) };
                    let mut no_first: usize = no_node.first_child;
                    if no_node.kind == AstKind::IfStmt { no_first = no; }
                    no_result = self.sequence(no_first, depth + 1);
                    if no_result == 0 { return 0; }
                }
                self.count = scope;
                if yes_result == 2 && no_result == 2 { return 2; }
                // Closed loop exits carry independent break and continue states.
                // Result 5 contains both edges and never ordinary fallthrough.
                if yes_result >= 3 || no_result >= 3 {
                    if yes_result < 3 || yes_result > 5 || no_result < 3 || no_result > 5 {
                        self.error_node = index; return 0;
                    }
                    let has_break: bool=yes_result != 4 || no_result != 4;
                    let has_continue: bool=yes_result != 3 || no_result != 3;
                    slot=0;
                    while slot < scope {
                        let mut breaking: u8=0;
                        if yes_result == 3 { breaking=after_yes[slot]; }
                        if yes_result == 5 { breaking=yes_breaks[slot]; }
                        if no_result != 4 {
                            let mut other: u8=self.states[slot];
                            if no_result == 5 { other=self.mixed_break_states[slot]; }
                            if yes_result == 4 { breaking=other; }
                            else if self.domains[slot] != 0 && breaking != other { breaking=3; }
                        }
                        if self.domains[slot] != 0 && ((yes_result != 3 && after_yes[slot] != before[slot])
                            || (no_result != 3 && self.states[slot] != before[slot])) {
                            self.error_node=index;return 0;
                        }
                        self.mixed_break_states[slot]=breaking;
                        if has_continue { self.states[slot]=before[slot]; }
                        else { self.states[slot]=breaking; }
                        slot=slot+1;
                    }
                    if has_break && has_continue { return 5; }
                    if has_break { return 3; }return 4;
                }
                slot = 0;
                while slot < scope {
                    if no_result == 2 { self.states[slot] = after_yes[slot]; }
                    else if yes_result != 2 && after_yes[slot] != self.states[slot] && self.domains[slot] != 0 { self.states[slot] = 3; }
                    slot = slot + 1;
                }
            } else if node.kind == AstKind::WhileStmt {
                let condition: usize = node.first_child;
                if condition == 0 || condition >= self.node_count { self.error_node = index; return 0; }
                let body: usize = unsafe { (*(self.nodes + condition)).next_sibling };
                if body == 0 || body >= self.node_count { self.error_node = index; return 0; }
                let scope: usize = self.count; let mut before: [u8;256] = 0;
                let mut slot: usize = 0;
                while slot < scope { before[slot] = self.states[slot]; slot = slot + 1; }
                if !self.expression(condition, false, 0) { return 0; }
                slot = 0;
                while slot < scope {
                    if self.domains[slot] != 0 && before[slot] != self.states[slot] { self.error_node = condition; return 0; }
                    slot = slot + 1;
                }
                // Nested loops must not overwrite their parent's break-edge summary.
                let mut saved_breaks: [u8;256] = 0;
                slot = 0;
                while slot < scope { saved_breaks[slot] = self.mixed_break_states[slot]; slot = slot+1; }
                let result: i64 = self.sequence(unsafe { (*(self.nodes + body)).first_child }, depth + 1);
                if result == 0 { return 0; }
                // For mixed loop edges, the if/else checked each individual
                // owner snapshot; the while rechecks that the surviving path
                // has not mutated an owner before its next iteration.
                if result == 5 {
                    slot = 0;
                    while slot < scope {
                        if self.domains[slot] != 0
                            && before[slot] != self.states[slot] {
                            self.error_node = index; return 0;
                        }
                        slot = slot + 1;
                    }
                }
                self.count = scope; slot = 0;
                while slot < scope {
                    if result == 5 && self.domains[slot] != 0 {
                        if before[slot] != self.mixed_break_states[slot] { self.states[slot] = 3; }
                        else { self.states[slot] = before[slot]; }
                    } else if self.domains[slot] != 0 && before[slot] != self.states[slot] {
                        if result == 1 || result == 4 { self.error_node = index; return 0; }
                        if result == 3 { self.states[slot] = 3; }
                        else { self.states[slot] = before[slot]; }
                    }
                    self.mixed_break_states[slot] = saved_breaks[slot];
                    slot = slot + 1;
                }
            } else if node.kind == AstKind::BreakStmt { return 3; }
            else if node.kind == AstKind::ContinueStmt { return 4;
            } else if node.kind == AstKind::AssignStmt {
                let left: usize = node.first_child;
                if left == 0 || left >= self.node_count { self.error_node = index; return 0; }
                let target_node: AstNode = unsafe { *(self.nodes + left) };
                if self.contains_borrow(left, 0) { self.fail_reason(left,3); return 0; }
                let owner: usize = self.slot(left);
                if target_node.kind == AstKind::ExprIdent && owner < self.count && self.domains[owner] != 0 {
                    if self.states[owner] == 1 { self.error_node = index; return 0; }
                    if !self.expression(target_node.next_sibling, true, 0) { return 0; }
                    self.states[owner] = 1;
                } else {
                    if self.expression_domain(target_node.next_sibling) != 0 { self.error_node = target_node.next_sibling; return 0; }
                    if !self.expression(left, false, 0) || !self.expression(target_node.next_sibling, false, 0) { return 0; }
                }
            } else if !self.expression(index, false, 0) { return 0; }
            index = node.next_sibling;
        }
        return 1;
    }
}

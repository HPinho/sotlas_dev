module sotlas::compiler::main;

import sotlas::compiler::token::*;
import sotlas::compiler::lexer::*;
import sotlas::compiler::ast::*;
import sotlas::compiler::parser::*;
import sotlas::compiler::sema::*;
import sotlas::compiler::emitter_c::*;

pub const TOKEN_BUFFER_CAPACITY: usize = 32768;
pub const AST_NODE_BUFFER_CAPACITY: usize = 65536;

static mut g_token_buffer: [Token; 32768] = 0;
static mut g_ast_node_buffer: [AstNode; 65536] = 0;

// Bootstrap-only adapter for the first bounded `impl` lowering subset.
// Existing modules without `impl` continue through CEmitter::emit_module
// unchanged.  When an impl is present, this adapter keeps the same strict
// top-level dispatch and adds only static methods with namespaced C symbols.
pub fn emit_native_static_impl_function(
    emitter: &mut CEmitter,
    impl_index: usize,
    fn_index: usize
) -> bool {
    if !emitter.valid_node(impl_index) || !emitter.valid_node(fn_index) {
        return false;
    }

    let impl_node: AstNode = unsafe { *(emitter.nodes + impl_index) };
    let function_node: AstNode = unsafe { *(emitter.nodes + fn_index) };
    if impl_node.kind != AstKind::ImplDecl
        || impl_node.str_len == 0
        || function_node.kind != AstKind::FnDecl
        || function_node.str_len == 0
        || function_node.parent != impl_index {
        return false;
    }

    let return_type: usize = emitter.find_function_return_type(fn_index);
    if return_type == 0 {
        if !emitter.write_str("void", 4) {
            return false;
        }
    } else if !emitter.emit_c_type(return_type) {
        return false;
    }

    if !emitter.write_byte(32) {
        return false;
    }
    if !emitter.write_source_slice(impl_node.str_offset, impl_node.str_len) {
        return false;
    }
    if !emitter.write_byte(95) {
        return false;
    }
    if !emitter.write_source_slice(function_node.str_offset, function_node.str_len) {
        return false;
    }
    if !emitter.write_byte(40) {
        return false;
    }

    let mut child: usize = function_node.first_child;
    let mut first_param: bool = true;
    while child != 0 {
        if !emitter.valid_node(child) {
            return false;
        }
        let node: AstNode = unsafe { *(emitter.nodes + child) };
        if node.kind == AstKind::ParamDecl {
            // Receivers need a real object/reference ABI.  Do not disguise
            // them as ordinary C parameters in the static-method subset.
            if emitter.source_slice_equals(node.str_offset, node.str_len, "self", 4) {
                return false;
            }
            if !first_param {
                if !emitter.write_str(", ", 2) {
                    return false;
                }
            }
            if !emitter.emit_parameter(child) {
                return false;
            }
            first_param = false;
        } else if node.kind != AstKind::TypeRef && node.kind != AstKind::Block {
            return false;
        }
        child = node.next_sibling;
    }

    let body_index: usize = emitter.find_function_body(fn_index);
    if body_index == 0 {
        // Declaration-only methods are not part of this bounded subset.
        return false;
    }
    if !emitter.write_str(") ", 2) {
        return false;
    }
    return emitter.emit_braced_block(body_index);
}

pub fn emit_native_impl(
    emitter: &mut CEmitter,
    impl_index: usize
) -> bool {
    if !emitter.valid_node(impl_index) {
        return false;
    }
    let impl_node: AstNode = unsafe { *(emitter.nodes + impl_index) };
    if impl_node.kind != AstKind::ImplDecl || impl_node.str_len == 0
        || impl_node.first_child == 0 {
        return false;
    }

    let mut method_index: usize = impl_node.first_child;
    while method_index != 0 {
        if !emitter.valid_node(method_index) {
            return false;
        }
        let method: AstNode = unsafe { *(emitter.nodes + method_index) };
        if method.kind != AstKind::FnDecl || method.parent != impl_index {
            return false;
        }
        if !emit_native_static_impl_function(emitter, impl_index, method_index) {
            return false;
        }
        if !emitter.write_byte(10) {
            return false;
        }
        method_index = method.next_sibling;
    }
    return true;
}

pub fn emit_native_module(
    emitter: &mut CEmitter,
    module_index: usize
) -> bool {
    if !emitter.valid_node(module_index) {
        return false;
    }
    let module_node: AstNode = unsafe { *(emitter.nodes + module_index) };
    if module_node.kind != AstKind::Module {
        return false;
    }

    let mut child: usize = module_node.first_child;
    while child != 0 {
        if !emitter.valid_node(child) {
            return false;
        }
        let node: AstNode = unsafe { *(emitter.nodes + child) };

        if node.kind == AstKind::Import {
            // Imports are resolved by the compiler/module graph.
        } else if node.kind == AstKind::EnumDecl {
            if !emitter.emit_enum(child) || !emitter.write_byte(10) {
                return false;
            }
        } else if node.kind == AstKind::StructDecl {
            if !emitter.emit_struct(child) || !emitter.write_byte(10) {
                return false;
            }
        } else if node.kind == AstKind::FnDecl {
            if !emitter.emit_function(child) || !emitter.write_byte(10) {
                return false;
            }
        } else if node.kind == AstKind::ImplDecl {
            if !emit_native_impl(emitter, child) {
                return false;
            }
        } else {
            return false;
        }

        child = node.next_sibling;
    }
    return true;
}

pub fn native_module_has_impl(
    nodes: *const AstNode,
    node_count: usize,
    module_index: usize
) -> bool {
    if nodes == null || module_index == 0 || module_index >= node_count {
        return false;
    }
    let module_node: AstNode = unsafe { *(nodes + module_index) };
    if module_node.kind != AstKind::Module {
        return false;
    }

    let mut child: usize = module_node.first_child;
    while child != 0 {
        if child >= node_count {
            return false;
        }
        let node: AstNode = unsafe { *(nodes + child) };
        if node.kind == AstKind::ImplDecl {
            return true;
        }
        child = node.next_sibling;
    }
    return false;
}

@export
@system
pub fn sotlas_native_compile_diagnostic(
    source: *const u8,
    len: usize,
    out_buf: *mut u8,
    max_out: usize,
    error_line: *mut u32,
    error_col: *mut u32
) -> usize {
    if error_line != null {
        unsafe { *error_line = 0; }
    }
    if error_col != null {
        unsafe { *error_col = 0; }
    }
    if source == null || len == 0 || out_buf == null || max_out == 0 {
        return 0;
    }

    // 1. Inicializa o Lexer em Sotlas puro
    let mut lex: Lexer = Lexer::new(source, len);
    let mut tok_count: usize = 0;

    while !lex.is_at_end() && tok_count < TOKEN_BUFFER_CAPACITY {
        let tok: Token = lex.next_token();
        unsafe {
            *(g_token_buffer as *mut Token + tok_count) = tok;
        }
        tok_count = tok_count + 1;
        if tok.kind == TokenKind::Eof {
            break;
        }
    }
    // Never parse a truncated token stream when the fixed bootstrap buffer fills.
    if !lex.is_at_end() {
        return 0;
    }

    // 2. Inicializa o Parser em Sotlas puro
    let mut tok_ptr: *const Token = null;
    unsafe {
        tok_ptr = g_token_buffer as *const Token;
    }
    let mut node_ptr: *mut AstNode = null;
    unsafe {
        node_ptr = g_ast_node_buffer as *mut AstNode;
    }
    let mut p: Parser = Parser::new(
        tok_ptr,
        tok_count,
        node_ptr,
        AST_NODE_BUFFER_CAPACITY
    );
    let module_node: usize = p.parse_module();
    if module_node == 0 {
        if p.error_count != 0 {
            if error_line != null {
                unsafe { *error_line = p.error_line; }
            }
            if error_col != null {
                unsafe { *error_col = p.error_col; }
            }
        }
        return 0;
    }

    // 3. Inicializa o Sema em Sotlas puro
    let mut sem: Sema = Sema::new();
    sem.enter_system();
    let _is_safe: bool = sem.check_system_privilege();
    if !sem.check_top_level_declarations(
        node_ptr, p.node_count, module_node, source, len
    ) {
        if error_line != null {
            unsafe { *error_line = sem.error_line; }
        }
        if error_col != null {
            unsafe { *error_col = sem.error_col; }
        }
        return 0;
    }

    // 4. Inicializa o Emissor C11 em Sotlas puro. Preserve the canonical
    // emitter for every module that does not need the bounded impl adapter.
    let mut emitter: CEmitter = CEmitter::new(
        out_buf,
        max_out,
        source,
        len,
        node_ptr,
        p.node_count
    );
    if !emitter.emit_header() {
        return 0;
    }
    if native_module_has_impl(node_ptr, p.node_count, module_node) {
        if !emit_native_module(&mut emitter, module_node) {
            return 0;
        }
    } else {
        if !emitter.emit_module(module_node) {
            return 0;
        }
    }

    return emitter.cursor;
}

@export
@system
pub fn sotlas_native_compile(
    source: *const u8,
    len: usize,
    out_buf: *mut u8,
    max_out: usize
) -> usize {
    return sotlas_native_compile_diagnostic(
        source, len, out_buf, max_out, null, null
    );
}

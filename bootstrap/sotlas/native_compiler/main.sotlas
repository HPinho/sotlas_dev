module sotlas::compiler::main;

import sotlas::compiler::token::*;
import sotlas::compiler::lexer::*;
import sotlas::compiler::ast::*;
import sotlas::compiler::parser::*;
import sotlas::compiler::sema::*;
import sotlas::compiler::emitter_c::*;
import sotlas::compiler::backend::target_ir::*;
import sotlas::compiler::backend::lower_scalar::*;
import sotlas::compiler::backend::x86_64_scalar::*;

pub const TOKEN_BUFFER_CAPACITY: usize = 262144;
pub const AST_NODE_BUFFER_CAPACITY: usize = 262144;
pub const TARGET_VALUE_CAPACITY: usize = 16384;
pub const TARGET_PARAM_CAPACITY: usize = 16384;
pub const TARGET_INSTR_CAPACITY: usize = 16384;
pub const TARGET_OPERAND_CAPACITY: usize = 16384;
pub const TARGET_PHI_CAPACITY: usize = 16384;
pub const TARGET_TARGET_CAPACITY: usize = 16384;
pub const TARGET_BLOCK_CAPACITY: usize = 8192;
pub const TARGET_FUNCTION_CAPACITY: usize = 8192;

static mut g_token_buffer: [Token; 262144] = 0;
static mut g_ast_node_buffer: [AstNode; 262144] = 0;
static mut g_target_values: [TargetValue; 16384] = 0;
static mut g_target_parameters: [TargetParameter; 16384] = 0;
static mut g_target_instructions: [TargetInstruction; 16384] = 0;
static mut g_target_operands: [TargetOperand; 16384] = 0;
static mut g_target_phi_inputs: [TargetPhiInput; 16384] = 0;
static mut g_target_targets: [u32; 16384] = 0;
static mut g_target_blocks: [TargetBlock; 8192] = 0;
static mut g_target_functions: [TargetFunction; 8192] = 0;
static mut g_target_module: [TargetModule; 1] = 0;
static mut g_err_line: [u32; 1] = 0;
static mut g_err_col: [u32; 1] = 0;
static mut g_link_offset: [usize; 1] = 0;
static mut g_link_length: [usize; 1] = 0;
static mut g_extended_source: [u8; 1048576] = 0;
static mut g_project_objects: [u8; 4194304] = 0;
static mut g_project_obj_offsets: [usize; 64] = 0;
static mut g_project_obj_lengths: [usize; 64] = 0;

pub fn backfill_decimal_float_literal_slices(
    nodes: *mut AstNode,
    node_count: usize,
    source: *const u8,
    source_len: usize
) -> bool {
    if nodes == null || source == null {
        return false;
    }
    let mut node_index: usize = 1;
    while node_index < node_count {
        let mut node: AstNode = unsafe { *(nodes + node_index) };
        if node.kind == AstKind::ExprLiteral && node.str_len == 0
            && node.span.length >= 3
            && node.span.offset <= source_len
            && node.span.length <= source_len - node.span.offset {
            let mut i: usize = 0;
            let mut saw_dot: bool = false;
            let mut digit_before_dot: bool = false;
            let mut digit_after_dot: bool = false;
            let mut valid: bool = true;
            while i < node.span.length {
                let ch: u8 = unsafe { *(source + node.span.offset + i) };
                if ch >= 48 && ch <= 57 {
                    if !saw_dot {
                        digit_before_dot = true;
                    } else {
                        digit_after_dot = true;
                    }
                } else if ch == 95 {
                    // Numeric separator; CEmitter canonicalizes it for C11.
                } else if ch == 46 && !saw_dot {
                    saw_dot = true;
                } else {
                    valid = false;
                }
                i = i + 1;
            }
            if valid && saw_dot && digit_before_dot && digit_after_dot {
                node.str_offset = node.span.offset;
                node.str_len = node.span.length;
                unsafe {
                    *(nodes + node_index) = node;
                }
            }
        }
        node_index = node_index + 1;
    }
    return true;
}

pub fn backfill_boolean_literal_slices(
    nodes: *mut AstNode,
    node_count: usize,
    source: *const u8,
    source_len: usize
) -> bool {
    if nodes == null || source == null {
        return false;
    }
    let mut node_index: usize = 1;
    while node_index < node_count {
        let mut node: AstNode = unsafe { *(nodes + node_index) };
        if node.kind == AstKind::ExprLiteral && node.str_len == 0
            && node.span.offset <= source_len
            && node.span.length <= source_len - node.span.offset {
            let mut is_boolean: bool = false;
            if node.span.length == 4 {
                is_boolean = unsafe { *(source + node.span.offset) } == 116
                    && unsafe { *(source + node.span.offset + 1) } == 114
                    && unsafe { *(source + node.span.offset + 2) } == 117
                    && unsafe { *(source + node.span.offset + 3) } == 101;
            } else if node.span.length == 5 {
                is_boolean = unsafe { *(source + node.span.offset) } == 102
                    && unsafe { *(source + node.span.offset + 1) } == 97
                    && unsafe { *(source + node.span.offset + 2) } == 108
                    && unsafe { *(source + node.span.offset + 3) } == 115
                    && unsafe { *(source + node.span.offset + 4) } == 101;
            }
            if is_boolean {
                node.str_offset = node.span.offset;
                node.str_len = node.span.length;
                unsafe {
                    *(nodes + node_index) = node;
                }
            }
        }
        node_index = node_index + 1;
    }
    return true;
}

pub fn native_numeric_literal_kind(
    nodes: *const AstNode,
    node_count: usize,
    expression_index: usize,
    source: *const u8,
    source_len: usize
) -> i64 {
    if nodes == null || source == null || expression_index == 0
        || expression_index >= node_count {
        return 0;
    }
    let expression: AstNode = unsafe { *(nodes + expression_index) };
    if expression.kind == AstKind::ExprUnary
        && (expression.int_value == 80 || expression.int_value == 81)
        && expression.first_child != 0
        && expression.first_child < node_count {
        return native_numeric_literal_kind(
            nodes, node_count, expression.first_child, source, source_len
        );
    }
    if expression.kind != AstKind::ExprLiteral || expression.str_len == 0
        || expression.str_offset > source_len
        || expression.str_len > source_len - expression.str_offset {
        return 0;
    }

    if expression.str_len == 4
        && unsafe { *(source + expression.str_offset) } == 116
        && unsafe { *(source + expression.str_offset + 1) } == 114
        && unsafe { *(source + expression.str_offset + 2) } == 117
        && unsafe { *(source + expression.str_offset + 3) } == 101 {
        return 3; // true
    }
    if expression.str_len == 5
        && unsafe { *(source + expression.str_offset) } == 102
        && unsafe { *(source + expression.str_offset + 1) } == 97
        && unsafe { *(source + expression.str_offset + 2) } == 108
        && unsafe { *(source + expression.str_offset + 3) } == 115
        && unsafe { *(source + expression.str_offset + 4) } == 101 {
        return 3; // false
    }

    let first: u8 = unsafe { *(source + expression.str_offset) };
    if first < 48 || first > 57 {
        return 0;
    }

    let is_hex: bool = expression.str_len >= 2 && first == 48
        && (unsafe { *(source + expression.str_offset + 1) } == 120
            || unsafe { *(source + expression.str_offset + 1) } == 88);
    let mut index: usize = if is_hex { 2 } else { 0 };
    let mut saw_digit: bool = false;
    let mut saw_dot: bool = false;
    let mut digit_before_dot: bool = false;
    let mut digit_after_dot: bool = false;

    while index < expression.str_len {
        let ch: u8 = unsafe { *(source + expression.str_offset + index) };
        if ch == 95 {
            index = index + 1;
            continue;
        }
        let decimal_digit: bool = ch >= 48 && ch <= 57;
        let hex_digit: bool = decimal_digit
            || (ch >= 65 && ch <= 70)
            || (ch >= 97 && ch <= 102);
        if (if is_hex { hex_digit } else { decimal_digit }) {
            saw_digit = true;
            if !saw_dot {
                digit_before_dot = true;
            } else {
                digit_after_dot = true;
            }
            index = index + 1;
            continue;
        }
        if !is_hex && ch == 46 && !saw_dot {
            saw_dot = true;
            index = index + 1;
            continue;
        }
        return 0;
    }

    if !saw_digit {
        return 0;
    }
    if saw_dot {
        if digit_before_dot && digit_after_dot {
            return 2; // decimal float literal
        }
        return 0;
    }
    return 1; // integer literal
}

pub fn native_numeric_type_domain(
    sem: &Sema,
    nodes: *const AstNode,
    node_count: usize,
    type_index: usize,
    source: *const u8,
    source_len: usize
) -> i64 {
    if sem.fixed_integer_type_tag(
        nodes, node_count, type_index, source, source_len
    ) != 0 {
        return 1;
    }
    if nodes == null || type_index == 0 || type_index >= node_count {
        return 0;
    }
    let typ: AstNode = unsafe { *(nodes + type_index) };
    if typ.kind != AstKind::TypeRef || typ.str_len == 0 {
        return 0;
    }
    if sem.source_slice_equals(
        source, source_len, typ.str_offset, typ.str_len, "f32", 3
    ) || sem.source_slice_equals(
        source, source_len, typ.str_offset, typ.str_len, "f64", 3
    ) {
        return 2;
    }
    if sem.source_slice_equals(
        source, source_len, typ.str_offset, typ.str_len, "bool", 4
    ) {
        return 3;
    }
    return 0;
}

pub fn native_function_return_type(
    nodes: *const AstNode,
    node_count: usize,
    function_index: usize
) -> usize {
    if nodes == null || function_index == 0 || function_index >= node_count {
        return 0;
    }
    let function: AstNode = unsafe { *(nodes + function_index) };
    if function.kind != AstKind::FnDecl && function.kind != AstKind::TrapfnDecl {
        return 0;
    }
    let mut child: usize = function.first_child;
    while child != 0 {
        if child >= node_count {
            return 0;
        }
        let node: AstNode = unsafe { *(nodes + child) };
        if node.kind == AstKind::TypeRef {
            return child;
        }
        child = node.next_sibling;
    }
    return 0;
}

pub fn native_call_argument_expected_type(
    sem: &Sema,
    nodes: *const AstNode,
    node_count: usize,
    call_index: usize,
    expression_index: usize,
    source: *const u8,
    source_len: usize
) -> usize {
    if nodes == null || call_index == 0 || expression_index == 0
        || call_index >= node_count || expression_index >= node_count {
        return 0;
    }
    let call: AstNode = unsafe { *(nodes + call_index) };
    if call.kind != AstKind::ExprCall || call.first_child == 0
        || call.first_child >= node_count {
        return 0;
    }
    let callee_index: usize = call.first_child;
    let callee: AstNode = unsafe { *(nodes + callee_index) };
    let mut function_index: usize = 0;
    if callee.kind == AstKind::ExprIdent {
        function_index = sem.find_module_function(
            nodes, node_count, callee_index, source, source_len
        );
    } else if callee.kind == AstKind::ExprPath {
        let module_index: usize = sem.find_enclosing_module(
            nodes, node_count, call_index
        );
        if module_index != 0 {
            function_index = sem.find_static_impl_method_for_path(
                nodes,
                node_count,
                module_index,
                callee_index,
                source,
                source_len
            );
        }
    }
    if function_index == 0 || function_index >= node_count {
        return 0;
    }

    let function: AstNode = unsafe { *(nodes + function_index) };
    let mut argument_index: usize = callee.next_sibling;
    let mut parameter_index: usize = function.first_child;
    while argument_index != 0 {
        if argument_index >= node_count {
            return 0;
        }
        while parameter_index != 0 {
            if parameter_index >= node_count {
                return 0;
            }
            let parameter: AstNode = unsafe { *(nodes + parameter_index) };
            if parameter.kind == AstKind::ParamDecl {
                break;
            }
            parameter_index = parameter.next_sibling;
        }
        if parameter_index == 0 {
            return 0;
        }
        let parameter: AstNode = unsafe { *(nodes + parameter_index) };
        if argument_index == expression_index {
            if parameter.first_child != 0 && parameter.first_child < node_count {
                let typ: AstNode = unsafe { *(nodes + parameter.first_child) };
                if typ.kind == AstKind::TypeRef {
                    return parameter.first_child;
                }
            }
            return 0;
        }
        let argument: AstNode = unsafe { *(nodes + argument_index) };
        argument_index = argument.next_sibling;
        parameter_index = parameter.next_sibling;
    }
    return 0;
}

pub fn native_numeric_expected_type(
    sem: &Sema,
    nodes: *const AstNode,
    node_count: usize,
    expression_index: usize,
    source: *const u8,
    source_len: usize
) -> usize {
    if nodes == null || expression_index == 0 || expression_index >= node_count {
        return 0;
    }
    let expression: AstNode = unsafe { *(nodes + expression_index) };
    let parent_index: usize = expression.parent;
    if parent_index == 0 || parent_index >= node_count {
        return 0;
    }
    let parent: AstNode = unsafe { *(nodes + parent_index) };

    if parent.kind == AstKind::LetStmt {
        if parent.first_child != 0 && parent.first_child < node_count {
            let typ: AstNode = unsafe { *(nodes + parent.first_child) };
            if typ.kind == AstKind::TypeRef {
                return parent.first_child;
            }
        }
        return 0;
    }

    if parent.kind == AstKind::ReturnStmt {
        let mut ancestor: usize = parent.parent;
        while ancestor != 0 {
            if ancestor >= node_count {
                return 0;
            }
            let node: AstNode = unsafe { *(nodes + ancestor) };
            if node.kind == AstKind::FnDecl || node.kind == AstKind::TrapfnDecl {
                return native_function_return_type(nodes, node_count, ancestor);
            }
            ancestor = node.parent;
        }
        return 0;
    }

    if parent.kind == AstKind::StructFieldInit {
        let literal_index: usize = parent.parent;
        if literal_index == 0 || literal_index >= node_count {
            return 0;
        }
        let struct_index: usize = sem.find_module_struct(
            nodes, node_count, literal_index, source, source_len
        );
        let field_index: usize = sem.find_struct_field_for_init(
            nodes, node_count, struct_index, parent_index, source, source_len
        );
        if field_index != 0 && field_index < node_count {
            let field: AstNode = unsafe { *(nodes + field_index) };
            if field.first_child != 0 && field.first_child < node_count {
                return field.first_child;
            }
        }
        return 0;
    }

    if parent.kind == AstKind::ExprCall {
        return native_call_argument_expected_type(
            sem,
            nodes,
            node_count,
            parent_index,
            expression_index,
            source,
            source_len
        );
    }

    return 0;
}

pub fn check_native_contextual_numeric_literals(
    sem: &mut Sema,
    nodes: *const AstNode,
    node_count: usize,
    source: *const u8,
    source_len: usize
) -> bool {
    if nodes == null || source == null {
        return false;
    }
    let mut index: usize = 1;
    while index < node_count {
        let node: AstNode = unsafe { *(nodes + index) };
        let mut expression_index: usize = 0;
        if node.kind == AstKind::ExprLiteral {
            let parent_index: usize = node.parent;
            if parent_index != 0 && parent_index < node_count {
                let parent: AstNode = unsafe { *(nodes + parent_index) };
                if parent.kind == AstKind::ExprUnary
                    && (parent.int_value == 80 || parent.int_value == 81) {
                    index = index + 1;
                    continue;
                }
            }
            expression_index = index;
        } else if node.kind == AstKind::ExprUnary
            && (node.int_value == 80 || node.int_value == 81) {
            expression_index = index;
        }

        if expression_index != 0 {
            let literal_kind: i64 = native_numeric_literal_kind(
                nodes, node_count, expression_index, source, source_len
            );
            if literal_kind != 0 {
                let expected_type: usize = native_numeric_expected_type(
                    sem,
                    nodes,
                    node_count,
                    expression_index,
                    source,
                    source_len
                );
                let expected_domain: i64 = native_numeric_type_domain(
                    sem,
                    nodes,
                    node_count,
                    expected_type,
                    source,
                    source_len
                );
                if expected_domain != 0 && expected_domain != literal_kind {
                    let expression: AstNode = unsafe { *(nodes + expression_index) };
                    return sem.reject_node(expression);
                }
            }
        }
        index = index + 1;
    }
    return true;
}

@export
@system
pub fn sotlas_native_compile_diagnostic(
    source: *const u8,
    len: usize,
    out_buf: *mut u8,
    max_out: usize,
    error_line: *mut u32,
    error_col: *mut u32
) -> usize {
    if error_line != null {
        unsafe { *error_line = 0; }
    }
    if error_col != null {
        unsafe { *error_col = 0; }
    }
    if source == null || len == 0 || out_buf == null || max_out == 0 {
        return 0;
    }

    let mut lex: Lexer = Lexer::new(source, len);
    let mut tok_count: usize = 0;
    while !lex.is_at_end() && tok_count < TOKEN_BUFFER_CAPACITY {
        let tok: Token = lex.next_token();
        unsafe {
            *(g_token_buffer as *mut Token + tok_count) = tok;
        }
        tok_count = tok_count + 1;
        if tok.kind == TokenKind::Eof || tok.kind == TokenKind::Error {
            break;
        }
    }
    if lex.error_count != 0 {
        if error_line != null {
            unsafe { *error_line = lex.error_line; }
        }
        if error_col != null {
            unsafe { *error_col = lex.error_col; }
        }
        return 0;
    }
    if !lex.is_at_end() {
        return 0;
    }

    let mut tok_ptr: *const Token = null;
    unsafe {
        tok_ptr = g_token_buffer as *const Token;
    }
    let mut node_ptr: *mut AstNode = null;
    unsafe {
        node_ptr = g_ast_node_buffer as *mut AstNode;
    }
    let mut p: Parser = Parser::new(
        tok_ptr,
        tok_count,
        node_ptr,
        AST_NODE_BUFFER_CAPACITY
    );
    let module_node: usize = p.parse_module();
    if module_node == 0 {
        if p.error_count != 0 {
            if error_line != null {
                unsafe { *error_line = p.error_line; }
            }
            if error_col != null {
                unsafe { *error_col = p.error_col; }
            }
        }
        return 0;
    }
    if !backfill_decimal_float_literal_slices(
        node_ptr, p.node_count, source, len
    ) || !backfill_boolean_literal_slices(
        node_ptr, p.node_count, source, len
    ) {
        return 0;
    }

    let mut sem: Sema = Sema::new();
    sem.enter_system();
    let _is_safe: bool = sem.check_system_privilege();
    if !check_native_contextual_numeric_literals(
        &mut sem, node_ptr, p.node_count, source, len
    ) || !sem.check_top_level_declarations(
        node_ptr, p.node_count, module_node, source, len
    ) {
        if error_line != null {
            unsafe { *error_line = sem.error_line; }
        }
        if error_col != null {
            unsafe { *error_col = sem.error_col; }
        }
        return 0;
    }

    let mut emitter: CEmitter = CEmitter::new(
        out_buf,
        max_out,
        source,
        len,
        node_ptr,
        p.node_count
    );
    // Preserve the Sotlas surface spelling in generated signatures while
    // establishing exact C11 ABI aliases for the bounded float subset.
    if !emitter.write_str("typedef float f32;\ntypedef double f64;\n", 39) {
        return 0;
    }
    if !emitter.emit_header() {
        return 0;
    }
    if !emitter.emit_module(module_node) {
        unsafe {
            *(g_err_line as *mut u32) = emitter.error_line;
            *(g_err_col as *mut u32) = emitter.error_col;
        }
        return 0;
    }

    return emitter.cursor;
}

@export
@system
pub fn sotlas_native_compile(
    source: *const u8,
    len: usize,
    out_buf: *mut u8,
    max_out: usize
) -> usize {
    return sotlas_native_compile_diagnostic(
        source,
        len,
        out_buf,
        max_out,
        unsafe { g_err_line as *mut u32 },
        unsafe { g_err_col as *mut u32 }
    );
}

@export
@system
pub fn sotlas_compile(
    source: *const u8,
    out_buf: *mut u8,
    max_len: usize
) -> usize {
    if source == null || out_buf == null || max_len == 0 { return 0; }
    let mut len: usize = 0;
    while unsafe { *(source + len) } != 0 {
        len = len + 1;
    }
    return sotlas_native_compile(source, len, out_buf, max_len);
}

// Native frontend entry point for the initial Sotlas-owned Target IR slice.
// Unlike sotlas_native_compile_diagnostic, this path stops at Target IR and
// never invokes CEmitter. Output storage belongs to the caller.
@export
@system
pub fn sotlas_native_lower_scalar_diagnostic(
    source: *const u8,
    len: usize,
    out_values: *mut TargetValue,
    value_capacity: usize,
    out_parameters: *mut TargetParameter,
    parameter_capacity: usize,
    out_instructions: *mut TargetInstruction,
    instruction_capacity: usize,
    out_operands: *mut TargetOperand,
    operand_capacity: usize,
    out_phi_inputs: *mut TargetPhiInput,
    phi_input_capacity: usize,
    out_targets: *mut u32,
    target_capacity: usize,
    out_blocks: *mut TargetBlock,
    block_capacity: usize,
    out_functions: *mut TargetFunction,
    function_capacity: usize,
    out_module: *mut TargetModule,
    error_line: *mut u32,
    error_col: *mut u32
) -> bool {
    if error_line != null {
        unsafe { *error_line = 0; }
    }
    if error_col != null {
        unsafe { *error_col = 0; }
    }
    if out_module == null {
        return false;
    }
    unsafe {
        *out_module = TargetModule {
            version: 1,
            function_count: 0,
            parameter_count: 0,
            block_count: 0,
            instruction_count: 0,
            value_count: 0,
            operand_count: 0,
            phi_input_count: 0,
            target_count: 0
        };
    }
    if source == null || len == 0 {
        return false;
    }

    let mut lex: Lexer = Lexer::new(source, len);
    let mut token_count: usize = 0;
    while !lex.is_at_end() && token_count < TOKEN_BUFFER_CAPACITY {
        let token: Token = lex.next_token();
        unsafe {
            *(g_token_buffer as *mut Token + token_count) = token;
        }
        token_count = token_count + 1;
        if token.kind == TokenKind::Eof || token.kind == TokenKind::Error {
            break;
        }
    }
    if lex.error_count != 0 || !lex.is_at_end() {
        if error_line != null {
            unsafe { *error_line = lex.error_line; }
        }
        if error_col != null {
            unsafe { *error_col = lex.error_col; }
        }
        return false;
    }

    let token_ptr: *const Token = unsafe { g_token_buffer as *const Token };
    let node_ptr: *mut AstNode = unsafe { g_ast_node_buffer as *mut AstNode };
    let mut parser: Parser = Parser::new(
        token_ptr,
        token_count,
        node_ptr,
        AST_NODE_BUFFER_CAPACITY
    );
    let module_index: usize = parser.parse_module();
    if module_index == 0 {
        if error_line != null {
            unsafe { *error_line = parser.error_line; }
        }
        if error_col != null {
            unsafe { *error_col = parser.error_col; }
        }
        return false;
    }

    let mut sem: Sema = Sema::new();
    if !sem.check_top_level_declarations(
        node_ptr, parser.node_count, module_index, source, len
    ) {
        if error_line != null {
            unsafe { *error_line = sem.error_line; }
        }
        if error_col != null {
            unsafe { *error_col = sem.error_col; }
        }
        return false;
    }

    let mut lowering: ScalarLowering = ScalarLowering::new(
        node_ptr,
        parser.node_count,
        source,
        len,
        out_values,
        value_capacity,
        out_parameters,
        parameter_capacity,
        out_instructions,
        instruction_capacity,
        out_operands,
        operand_capacity,
        out_phi_inputs,
        phi_input_capacity,
        out_blocks,
        block_capacity,
        out_targets,
        target_capacity,
        out_functions,
        function_capacity
    );
    let mut target_module: TargetModule = TargetModule {
        version: 1,
        function_count: 0,
        parameter_count: 0,
        block_count: 0,
        instruction_count: 0,
        value_count: 0,
        operand_count: 0,
        phi_input_count: 0,
        target_count: 0
    };
    if !lower_scalar_module(&mut lowering, module_index, &mut target_module) {
        if lowering.error_node != 0 && lowering.error_node < parser.node_count {
            let error_node: AstNode = unsafe { *(node_ptr + lowering.error_node) };
            if error_line != null {
                unsafe { *error_line = error_node.span.line; }
            }
            if error_col != null {
                unsafe { *error_col = error_node.span.col; }
            }
        }
        return false;
    }

    unsafe { *out_module = target_module; }
    return true;
}

@extern(C)
fn emit_elf64_module_object(
    source: *const u8,
    len: usize,
    target_module: *const TargetModule,
    functions: *const TargetFunction,
    parameters: *const TargetParameter,
    values: *const TargetValue,
    blocks: *const TargetBlock,
    instructions: *const TargetInstruction,
    operands: *const TargetOperand,
    phi_inputs: *const TargetPhiInput,
    targets: *const u32,
    output: *mut u8,
    capacity: usize,
    out_length: *mut usize
) -> bool;

@extern(C)
fn link_elf64_executable(
    object_data: *const u8,
    object_offsets: *const usize,
    object_lengths: *const usize,
    object_count: u32,
    entry_name: *const u8,
    entry_name_length: usize,
    entry_arguments: *const u32,
    entry_argument_count: u32,
    base_address: u64,
    freestanding: bool,
    output: *mut u8,
    capacity: usize,
    output_length: *mut usize
) -> bool;

// Compiles Sotlas source code directly to a freestanding or hosted ELF64 relocatable
// object without invoking the C11 emitter or external assemblers.
@export
@system
pub fn sotlas_native_compile_object(
    source: *const u8,
    len: usize,
    output: *mut u8,
    capacity: usize,
    out_length: *mut usize
) -> bool {
    if out_length == null { return false; }
    unsafe { *out_length = 0; }
    if source == null || len == 0 || output == null || capacity == 0 || len > 1048576 {
        return false;
    }

    let mut i: usize = 0;
    while i < len {
        unsafe {
            *(g_extended_source as *mut u8 + i) = *(source + i);
        }
        i = i + 1;
    }

    let lower_ok: bool = sotlas_native_lower_scalar_diagnostic(
        unsafe { g_extended_source as *const u8 },
        len,
        unsafe { g_target_values as *mut TargetValue },
        TARGET_VALUE_CAPACITY,
        unsafe { g_target_parameters as *mut TargetParameter },
        TARGET_PARAM_CAPACITY,
        unsafe { g_target_instructions as *mut TargetInstruction },
        TARGET_INSTR_CAPACITY,
        unsafe { g_target_operands as *mut TargetOperand },
        TARGET_OPERAND_CAPACITY,
        unsafe { g_target_phi_inputs as *mut TargetPhiInput },
        TARGET_PHI_CAPACITY,
        unsafe { g_target_targets as *mut u32 },
        TARGET_TARGET_CAPACITY,
        unsafe { g_target_blocks as *mut TargetBlock },
        TARGET_BLOCK_CAPACITY,
        unsafe { g_target_functions as *mut TargetFunction },
        TARGET_FUNCTION_CAPACITY,
        unsafe { g_target_module as *mut TargetModule },
        unsafe { g_err_line as *mut u32 },
        unsafe { g_err_col as *mut u32 }
    );
    let target_mod: TargetModule = unsafe { *(g_target_module as *const TargetModule) };
    if !lower_ok || target_mod.function_count == 0 {
        return false;
    }

    let ext_len: usize = sotlas_native_extended_source_len();
    let total_src_len: usize = if ext_len > len { ext_len } else { len };

    return emit_elf64_module_object(
        unsafe { g_extended_source as *const u8 },
        total_src_len,
        unsafe { g_target_module as *const TargetModule },
        unsafe { g_target_functions as *const TargetFunction },
        unsafe { g_target_parameters as *const TargetParameter },
        unsafe { g_target_values as *const TargetValue },
        unsafe { g_target_blocks as *const TargetBlock },
        unsafe { g_target_instructions as *const TargetInstruction },
        unsafe { g_target_operands as *const TargetOperand },
        unsafe { g_target_phi_inputs as *const TargetPhiInput },
        unsafe { g_target_targets as *const u32 },
        output,
        capacity,
        out_length
    );
}

@export
@system
pub fn sotlas_native_last_error_line() -> u32 {
    return unsafe { *(g_err_line as *const u32) };
}

@export
@system
pub fn sotlas_native_last_error_col() -> u32 {
    return unsafe { *(g_err_col as *const u32) };
}

@export
@system
pub fn sotlas_native_last_function_count() -> u32 {
    return unsafe { (*(g_target_module as *const TargetModule)).function_count };
}

// Links an ELF64 relocatable object into an ELF64 executable directly
// without calling external linkers. Supports both hosted executables and
// freestanding kernels with explicit entry points.
@export
@system
pub fn sotlas_native_link_executable(
    object: *const u8,
    object_len: usize,
    entry_name: *const u8,
    entry_name_len: usize,
    freestanding: bool,
    output: *mut u8,
    capacity: usize,
    out_length: *mut usize
) -> bool {
    if out_length == null { return false; }
    unsafe { *out_length = 0; }
    if object == null || object_len == 0 || output == null || capacity == 0 {
        return false;
    }
    unsafe {
        *(g_link_offset as *mut usize) = 0;
        *(g_link_length as *mut usize) = object_len;
    }
    let base_addr: u64 = if freestanding { 1048576 } else { 4194304 };
    return link_elf64_executable(
        object,
        unsafe { g_link_offset as *const usize },
        unsafe { g_link_length as *const usize },
        1,
        entry_name,
        entry_name_len,
        null,
        0,
        base_addr,
        freestanding,
        output,
        capacity,
        out_length
    );
}

// Links several ELF64 relocatable objects into one executable. Objects are
// supplied as one buffer plus per-object offsets/lengths. Cross-object symbol
// resolution and relocations are done by link_elf64_executable; undefined
// references and duplicate strong symbols fail closed.
@export
@system
pub fn sotlas_native_link_objects(
    object_data: *const u8,
    object_offsets: *const usize,
    object_lengths: *const usize,
    object_count: u32,
    entry_name: *const u8,
    entry_name_len: usize,
    freestanding: bool,
    output: *mut u8,
    capacity: usize,
    out_length: *mut usize
) -> bool {
    if out_length == null { return false; }
    unsafe { *out_length = 0; }
    if object_data == null || object_offsets == null || object_lengths == null
        || object_count == 0 || output == null || capacity == 0 {
        return false;
    }
    let base_addr: u64 = if freestanding { 1048576 } else { 4194304 };
    return link_elf64_executable(
        object_data,
        object_offsets,
        object_lengths,
        object_count,
        entry_name,
        entry_name_len,
        null,
        0,
        base_addr,
        freestanding,
        output,
        capacity,
        out_length
    );
}

// Compiles a multi-module Sotlas project into relocatable ELF64 objects and links
// them directly into an ELF64 executable without external linkers or Python driver.
@export
@system
pub fn sotlas_native_compile_project(
    sources_data: *const u8,
    source_offsets: *const usize,
    source_lengths: *const usize,
    source_count: u32,
    entry_name: *const u8,
    entry_name_len: usize,
    freestanding: bool,
    output: *mut u8,
    capacity: usize,
    out_length: *mut usize
) -> bool {
    if out_length == null { return false; }
    unsafe { *out_length = 0; }
    if sources_data == null || source_offsets == null || source_lengths == null
        || source_count == 0 || source_count > 64 || output == null || capacity == 0 {
        return false;
    }

    let mut current_obj_offset: usize = 0;
    let max_obj_cap: usize = 4194304;
    let mut mod_idx: u32 = 0;

    while mod_idx < source_count {
        let s_off: usize = unsafe { *(source_offsets + mod_idx as usize) };
        let s_len: usize = unsafe { *(source_lengths + mod_idx as usize) };
        if s_len == 0 { return false; }
        let src_ptr: *const u8 = unsafe { sources_data + s_off };

        if current_obj_offset >= max_obj_cap { return false; }
        let obj_dest: *mut u8 = unsafe { g_project_objects as *mut u8 + current_obj_offset };
        let remaining_cap: usize = max_obj_cap - current_obj_offset;

        let dest_len_ptr: *mut usize = unsafe { (g_project_obj_lengths as *mut usize + mod_idx as usize) };
        let ok: bool = sotlas_native_compile_object(
            src_ptr, s_len, obj_dest, remaining_cap, dest_len_ptr
        );
        let obj_len: usize = unsafe { *(g_project_obj_lengths as *const usize + mod_idx as usize) };
        if !ok || obj_len == 0 {
            return false;
        }

        unsafe {
            *(g_project_obj_offsets as *mut usize + mod_idx as usize) = current_obj_offset;
        }

        let aligned_obj_len: usize = ((obj_len + 15) / 16) * 16;
        current_obj_offset = current_obj_offset + aligned_obj_len;
        mod_idx = mod_idx + 1;
    }

    return sotlas_native_link_objects(
        unsafe { g_project_objects as *const u8 },
        unsafe { g_project_obj_offsets as *const usize },
        unsafe { g_project_obj_lengths as *const usize },
        source_count,
        entry_name,
        entry_name_len,
        freestanding,
        output,
        capacity,
        out_length
    );
}


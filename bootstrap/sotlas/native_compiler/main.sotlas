module sotlas::compiler::main;

import sotlas::compiler::token::*;
import sotlas::compiler::lexer::*;
import sotlas::compiler::ast::*;
import sotlas::compiler::parser::*;
import sotlas::compiler::sema::*;
import sotlas::compiler::emitter_c::*;

pub const TOKEN_BUFFER_CAPACITY: usize = 32768;

static mut g_token_buffer: [Token; 32768] = 0;

@export
@system
pub fn sotlas_native_compile(source: *const u8, len: usize, out_buf: *mut u8, max_out: usize) -> usize {
    if source == null || len == 0 || out_buf == null || max_out == 0 {
        return 0;
    }

    // 1. Inicializa o Lexer em Sotlas puro
    let mut lex: Lexer = Lexer::new(source, len);
    let mut tok_count: usize = 0;

    while !lex.is_at_end() && tok_count < TOKEN_BUFFER_CAPACITY {
        let tok: Token = lex.next_token();
        unsafe {
            *(g_token_buffer as *mut Token + tok_count) = tok;
        }
        tok_count = tok_count + 1;
        if tok.kind == TokenKind::Eof {
            break;
        }
    }

    // 2. Inicializa o Parser em Sotlas puro
    let mut tok_ptr: *const Token = null;
    unsafe {
        tok_ptr = g_token_buffer as *const Token;
    }
    let mut p: Parser = Parser::new(tok_ptr, tok_count);
    let _module_node: usize = p.parse_module();

    // 3. Inicializa o Sema em Sotlas puro
    let mut sem: Sema = Sema::new();
    sem.enter_system();
    let _is_safe: bool = sem.check_system_privilege();

    // 4. Inicializa o Emissor C11 em Sotlas puro
    let mut emitter: CEmitter = CEmitter::new(out_buf, max_out);
    if !emitter.emit_header() {
        return 0;
    }

    return emitter.cursor;
}

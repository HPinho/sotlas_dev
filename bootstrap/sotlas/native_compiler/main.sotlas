module sotlas::compiler::main;

import sotlas::compiler::token::*;
import sotlas::compiler::lexer::*;
import sotlas::compiler::ast::*;
import sotlas::compiler::parser::*;
import sotlas::compiler::sema::*;
import sotlas::compiler::emitter_c::*;

pub const TOKEN_BUFFER_CAPACITY: usize = 32768;
pub const AST_NODE_BUFFER_CAPACITY: usize = 65536;
pub const LOWERED_SOURCE_BUFFER_CAPACITY: usize = 1048576;

static mut g_token_buffer: [Token; 32768] = 0;
static mut g_ast_node_buffer: [AstNode; 65536] = 0;
static mut g_lowered_source_buffer: [u8; 1048576] = 0;

// Bootstrap-only adapter for the first bounded `impl` lowering subset.
// Existing modules without `impl` continue through CEmitter::emit_module
// unchanged.  When an impl is present, this adapter keeps the same strict
// top-level dispatch and adds only static methods with namespaced C symbols.
pub fn native_source_slices_equal(
    emitter: &CEmitter,
    left_offset: usize,
    left_len: usize,
    right_offset: usize,
    right_len: usize
) -> bool {
    if emitter.source == null || left_len != right_len
        || left_offset > emitter.source_len || right_offset > emitter.source_len
        || left_len > emitter.source_len - left_offset
        || right_len > emitter.source_len - right_offset {
        return false;
    }

    let mut index: usize = 0;
    while index < left_len {
        let left: u8 = unsafe { *(emitter.source + left_offset + index) };
        let right: u8 = unsafe { *(emitter.source + right_offset + index) };
        if left != right {
            return false;
        }
        index = index + 1;
    }
    return true;
}

pub fn native_impl_target_is_declared(
    emitter: &CEmitter,
    module_index: usize,
    impl_index: usize
) -> bool {
    if !emitter.valid_node(module_index) || !emitter.valid_node(impl_index) {
        return false;
    }
    let module_node: AstNode = unsafe { *(emitter.nodes + module_index) };
    let impl_node: AstNode = unsafe { *(emitter.nodes + impl_index) };
    if module_node.kind != AstKind::Module || impl_node.kind != AstKind::ImplDecl
        || impl_node.str_len == 0 {
        return false;
    }

    let mut child: usize = module_node.first_child;
    while child != 0 {
        if !emitter.valid_node(child) {
            return false;
        }
        let candidate: AstNode = unsafe { *(emitter.nodes + child) };
        if (candidate.kind == AstKind::StructDecl || candidate.kind == AstKind::EnumDecl)
            && candidate.str_len != 0
            && native_source_slices_equal(
                emitter,
                candidate.str_offset,
                candidate.str_len,
                impl_node.str_offset,
                impl_node.str_len
            ) {
            return true;
        }
        child = candidate.next_sibling;
    }
    return false;
}

pub fn native_static_method_is_unique(
    emitter: &CEmitter,
    module_index: usize,
    impl_index: usize,
    method_index: usize
) -> bool {
    if !emitter.valid_node(module_index) || !emitter.valid_node(impl_index)
        || !emitter.valid_node(method_index) {
        return false;
    }
    let module_node: AstNode = unsafe { *(emitter.nodes + module_index) };
    let impl_node: AstNode = unsafe { *(emitter.nodes + impl_index) };
    let method: AstNode = unsafe { *(emitter.nodes + method_index) };
    if module_node.kind != AstKind::Module || impl_node.kind != AstKind::ImplDecl
        || method.kind != AstKind::FnDecl || method.parent != impl_index
        || impl_node.str_len == 0 || method.str_len == 0 {
        return false;
    }

    let mut declaration_index: usize = module_node.first_child;
    while declaration_index != 0 {
        if !emitter.valid_node(declaration_index) {
            return false;
        }
        let declaration: AstNode = unsafe { *(emitter.nodes + declaration_index) };
        if declaration.kind == AstKind::ImplDecl && declaration.str_len != 0
            && native_source_slices_equal(
                emitter,
                declaration.str_offset,
                declaration.str_len,
                impl_node.str_offset,
                impl_node.str_len
            ) {
            let mut candidate_index: usize = declaration.first_child;
            while candidate_index != 0 {
                if !emitter.valid_node(candidate_index) {
                    return false;
                }
                let candidate: AstNode = unsafe { *(emitter.nodes + candidate_index) };
                if candidate_index != method_index
                    && candidate.kind == AstKind::FnDecl
                    && candidate.str_len != 0
                    && native_source_slices_equal(
                        emitter,
                        candidate.str_offset,
                        candidate.str_len,
                        method.str_offset,
                        method.str_len
                    ) {
                    return false;
                }
                candidate_index = candidate.next_sibling;
            }
        }
        declaration_index = declaration.next_sibling;
    }
    return true;
}

pub fn native_path_matches_static_method(
    emitter: &CEmitter,
    path_index: usize,
    impl_index: usize,
    method_index: usize
) -> bool {
    if !emitter.valid_node(path_index) || !emitter.valid_node(impl_index)
        || !emitter.valid_node(method_index) || emitter.source == null {
        return false;
    }
    let path: AstNode = unsafe { *(emitter.nodes + path_index) };
    let impl_node: AstNode = unsafe { *(emitter.nodes + impl_index) };
    let method: AstNode = unsafe { *(emitter.nodes + method_index) };
    if path.kind != AstKind::ExprPath || path.str_len == 0
        || impl_node.kind != AstKind::ImplDecl || impl_node.str_len == 0
        || method.kind != AstKind::FnDecl || method.str_len == 0
        || method.parent != impl_index
        || path.str_offset > emitter.source_len
        || path.str_len > emitter.source_len - path.str_offset {
        return false;
    }

    let mut first: usize = 0;
    while first < path.str_len {
        let ch: u8 = unsafe { *(emitter.source + path.str_offset + first) };
        if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
            first = first + 1;
        } else {
            break;
        }
    }

    let mut separator: usize = first;
    let mut found_separator: bool = false;
    while separator + 1 < path.str_len {
        let left: u8 = unsafe { *(emitter.source + path.str_offset + separator) };
        let right: u8 = unsafe { *(emitter.source + path.str_offset + separator + 1) };
        if left == 58 && right == 58 {
            found_separator = true;
            break;
        }
        separator = separator + 1;
    }
    if !found_separator || separator <= first {
        return false;
    }

    let mut target_end: usize = separator;
    while target_end > first {
        let ch: u8 = unsafe { *(emitter.source + path.str_offset + target_end - 1) };
        if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
            target_end = target_end - 1;
        } else {
            break;
        }
    }
    if target_end <= first {
        return false;
    }

    let mut method_start: usize = separator + 2;
    while method_start < path.str_len {
        let ch: u8 = unsafe { *(emitter.source + path.str_offset + method_start) };
        if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
            method_start = method_start + 1;
        } else {
            break;
        }
    }

    let mut method_end: usize = path.str_len;
    while method_end > method_start {
        let ch: u8 = unsafe { *(emitter.source + path.str_offset + method_end - 1) };
        if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
            method_end = method_end - 1;
        } else {
            break;
        }
    }
    if method_end <= method_start {
        return false;
    }

    let mut scan: usize = method_start;
    while scan + 1 < method_end {
        let left: u8 = unsafe { *(emitter.source + path.str_offset + scan) };
        let right: u8 = unsafe { *(emitter.source + path.str_offset + scan + 1) };
        if left == 58 && right == 58 {
            return false;
        }
        scan = scan + 1;
    }

    return native_source_slices_equal(
        emitter,
        path.str_offset + first,
        target_end - first,
        impl_node.str_offset,
        impl_node.str_len
    ) && native_source_slices_equal(
        emitter,
        path.str_offset + method_start,
        method_end - method_start,
        method.str_offset,
        method.str_len
    );
}

pub fn native_find_static_impl_method_for_path(
    emitter: &CEmitter,
    module_index: usize,
    path_index: usize
) -> usize {
    if !emitter.valid_node(module_index) || !emitter.valid_node(path_index) {
        return 0;
    }
    let module_node: AstNode = unsafe { *(emitter.nodes + module_index) };
    if module_node.kind != AstKind::Module {
        return 0;
    }

    let mut found: usize = 0;
    let mut declaration_index: usize = module_node.first_child;
    while declaration_index != 0 {
        if !emitter.valid_node(declaration_index) {
            return 0;
        }
        let declaration: AstNode = unsafe { *(emitter.nodes + declaration_index) };
        if declaration.kind == AstKind::ImplDecl
            && native_impl_target_is_declared(emitter, module_index, declaration_index) {
            let mut method_index: usize = declaration.first_child;
            while method_index != 0 {
                if !emitter.valid_node(method_index) {
                    return 0;
                }
                let method: AstNode = unsafe { *(emitter.nodes + method_index) };
                if method.kind == AstKind::FnDecl
                    && native_path_matches_static_method(
                        emitter, path_index, declaration_index, method_index
                    ) {
                    if found != 0 {
                        return 0;
                    }
                    found = method_index;
                }
                method_index = method.next_sibling;
            }
        }
        declaration_index = declaration.next_sibling;
    }
    return found;
}

pub fn native_static_impl_method_has_receiver(
    emitter: &CEmitter,
    method_index: usize
) -> bool {
    if !emitter.valid_node(method_index) {
        return true;
    }
    let method: AstNode = unsafe { *(emitter.nodes + method_index) };
    if method.kind != AstKind::FnDecl {
        return true;
    }
    let mut child: usize = method.first_child;
    while child != 0 {
        if !emitter.valid_node(child) {
            return true;
        }
        let node: AstNode = unsafe { *(emitter.nodes + child) };
        if node.kind == AstKind::ParamDecl
            && emitter.source_slice_equals(node.str_offset, node.str_len, "self", 4) {
            return true;
        }
        child = node.next_sibling;
    }
    return false;
}

pub fn native_static_impl_call_arity_matches(
    emitter: &CEmitter,
    call_index: usize,
    method_index: usize
) -> bool {
    if !emitter.valid_node(call_index) || !emitter.valid_node(method_index) {
        return false;
    }
    let call: AstNode = unsafe { *(emitter.nodes + call_index) };
    let method: AstNode = unsafe { *(emitter.nodes + method_index) };
    if call.kind != AstKind::ExprCall || !emitter.valid_node(call.first_child)
        || method.kind != AstKind::FnDecl {
        return false;
    }

    let callee: AstNode = unsafe { *(emitter.nodes + call.first_child) };
    if callee.kind != AstKind::ExprPath {
        return false;
    }

    let mut expected: usize = 0;
    let mut child: usize = method.first_child;
    while child != 0 {
        if !emitter.valid_node(child) {
            return false;
        }
        let node: AstNode = unsafe { *(emitter.nodes + child) };
        if node.kind == AstKind::ParamDecl {
            expected = expected + 1;
        }
        child = node.next_sibling;
    }

    let mut actual: usize = 0;
    child = callee.next_sibling;
    while child != 0 {
        if !emitter.valid_node(child) {
            return false;
        }
        let node: AstNode = unsafe { *(emitter.nodes + child) };
        actual = actual + 1;
        child = node.next_sibling;
    }
    return actual == expected;
}

pub fn native_validate_static_impl_calls(
    sem: &mut Sema,
    emitter: &CEmitter,
    module_index: usize
) -> bool {
    if !emitter.valid_node(module_index) {
        sem.error_count = sem.error_count + 1;
        return false;
    }

    let mut node_index: usize = 1;
    while node_index < emitter.node_count {
        let node: AstNode = unsafe { *(emitter.nodes + node_index) };
        if node.kind == AstKind::ExprCall && emitter.valid_node(node.first_child) {
            let callee: AstNode = unsafe { *(emitter.nodes + node.first_child) };
            if callee.kind == AstKind::ExprPath {
                if emitter.result_constructor_kind(node_index) == 0 {
                    let method_index: usize = native_find_static_impl_method_for_path(
                        emitter, module_index, node.first_child
                    );
                    if method_index == 0
                        || native_static_impl_method_has_receiver(emitter, method_index)
                        || !native_static_impl_call_arity_matches(
                            emitter, node_index, method_index
                        ) {
                        sem.error_count = sem.error_count + 1;
                        sem.error_line = callee.span.line;
                        sem.error_col = callee.span.col;
                        return false;
                    }
                }
            }
        }
        node_index = node_index + 1;
    }
    return true;
}

pub fn lower_native_static_impl_calls_to_c_symbols(
    nodes: *mut AstNode,
    node_count: usize,
    module_index: usize,
    source: *const u8,
    source_len: usize
) -> usize {
    if nodes == null || source == null || source_len == 0
        || source_len > LOWERED_SOURCE_BUFFER_CAPACITY {
        return 0;
    }

    let mut lowered_source: *mut u8 = null;
    unsafe {
        lowered_source = g_lowered_source_buffer as *mut u8;
    }
    let mut copy_index: usize = 0;
    while copy_index < source_len {
        let ch: u8 = unsafe { *(source + copy_index) };
        unsafe {
            *(lowered_source + copy_index) = ch;
        }
        copy_index = copy_index + 1;
    }

    let resolver: CEmitter = CEmitter::new(
        null,
        0,
        source,
        source_len,
        nodes as *const AstNode,
        node_count
    );
    if !resolver.valid_node(module_index) {
        return 0;
    }

    let mut lowered_len: usize = source_len;
    let mut node_index: usize = 1;
    while node_index < node_count {
        let node: AstNode = unsafe { *(nodes + node_index) };
        if node.kind == AstKind::ExprCall && resolver.valid_node(node.first_child) {
            let callee: AstNode = unsafe { *(nodes + node.first_child) };
            if callee.kind == AstKind::ExprPath
                && resolver.result_constructor_kind(node_index) == 0 {
                let method_index: usize = native_find_static_impl_method_for_path(
                    &resolver, module_index, node.first_child
                );
                if method_index == 0 || !resolver.valid_node(method_index) {
                    return 0;
                }
                let method: AstNode = unsafe { *(nodes + method_index) };
                let impl_index: usize = method.parent;
                if !resolver.valid_node(impl_index) {
                    return 0;
                }
                let impl_node: AstNode = unsafe { *(nodes + impl_index) };
                if impl_node.kind != AstKind::ImplDecl || impl_node.str_len == 0
                    || method.kind != AstKind::FnDecl || method.str_len == 0
                    || impl_node.str_offset > source_len
                    || impl_node.str_len > source_len - impl_node.str_offset
                    || method.str_offset > source_len
                    || method.str_len > source_len - method.str_offset {
                    return 0;
                }

                let symbol_len: usize = impl_node.str_len + 1 + method.str_len;
                if symbol_len > LOWERED_SOURCE_BUFFER_CAPACITY - lowered_len {
                    return 0;
                }
                let symbol_offset: usize = lowered_len;

                let mut name_index: usize = 0;
                while name_index < impl_node.str_len {
                    let ch: u8 = unsafe { *(source + impl_node.str_offset + name_index) };
                    unsafe {
                        *(lowered_source + lowered_len) = ch;
                    }
                    lowered_len = lowered_len + 1;
                    name_index = name_index + 1;
                }
                unsafe {
                    *(lowered_source + lowered_len) = 95;
                }
                lowered_len = lowered_len + 1;

                name_index = 0;
                while name_index < method.str_len {
                    let ch: u8 = unsafe { *(source + method.str_offset + name_index) };
                    unsafe {
                        *(lowered_source + lowered_len) = ch;
                    }
                    lowered_len = lowered_len + 1;
                    name_index = name_index + 1;
                }

                let mut lowered_path: AstNode = callee;
                lowered_path.kind = AstKind::ExprIdent;
                lowered_path.str_offset = symbol_offset;
                lowered_path.str_len = symbol_len;
                unsafe {
                    *(nodes + node.first_child) = lowered_path;
                }
            }
        }
        node_index = node_index + 1;
    }
    return lowered_len;
}

pub fn native_find_struct_decl_for_literal(
    emitter: &CEmitter,
    literal_index: usize
) -> usize {
    if !emitter.valid_node(literal_index) {
        return 0;
    }
    let literal: AstNode = unsafe { *(emitter.nodes + literal_index) };
    if literal.kind != AstKind::ExprStructLiteral || literal.str_len == 0 {
        return 0;
    }
    let module_index: usize = emitter.find_enclosing_module(literal_index);
    if !emitter.valid_node(module_index) {
        return 0;
    }
    let module_node: AstNode = unsafe { *(emitter.nodes + module_index) };
    let mut child: usize = module_node.first_child;
    while child != 0 {
        if !emitter.valid_node(child) {
            return 0;
        }
        let candidate: AstNode = unsafe { *(emitter.nodes + child) };
        if candidate.kind == AstKind::StructDecl && candidate.str_len != 0
            && native_source_slices_equal(
                emitter,
                candidate.str_offset,
                candidate.str_len,
                literal.str_offset,
                literal.str_len
            ) {
            return child;
        }
        child = candidate.next_sibling;
    }
    return 0;
}

pub fn native_find_struct_field_decl(
    emitter: &CEmitter,
    struct_index: usize,
    init_index: usize
) -> usize {
    if !emitter.valid_node(struct_index) || !emitter.valid_node(init_index) {
        return 0;
    }
    let decl: AstNode = unsafe { *(emitter.nodes + struct_index) };
    let init: AstNode = unsafe { *(emitter.nodes + init_index) };
    if decl.kind != AstKind::StructDecl || init.kind != AstKind::StructFieldInit
        || init.str_len == 0 {
        return 0;
    }
    let mut field_index: usize = decl.first_child;
    while field_index != 0 {
        if !emitter.valid_node(field_index) {
            return 0;
        }
        let field: AstNode = unsafe { *(emitter.nodes + field_index) };
        if field.kind == AstKind::FieldDecl && field.str_len != 0
            && native_source_slices_equal(
                emitter,
                field.str_offset,
                field.str_len,
                init.str_offset,
                init.str_len
            ) {
            return field_index;
        }
        field_index = field.next_sibling;
    }
    return 0;
}

pub fn native_struct_literal_shape_valid(
    emitter: &CEmitter,
    literal_index: usize
) -> bool {
    let struct_index: usize = native_find_struct_decl_for_literal(emitter, literal_index);
    if struct_index == 0 || !emitter.valid_node(literal_index) {
        return false;
    }
    let decl: AstNode = unsafe { *(emitter.nodes + struct_index) };
    let literal: AstNode = unsafe { *(emitter.nodes + literal_index) };

    let mut declared_count: usize = 0;
    let mut field_index: usize = decl.first_child;
    while field_index != 0 {
        if !emitter.valid_node(field_index) {
            return false;
        }
        let field: AstNode = unsafe { *(emitter.nodes + field_index) };
        if field.kind != AstKind::FieldDecl || field.str_len == 0
            || !emitter.valid_node(field.first_child) {
            return false;
        }
        let typ: AstNode = unsafe { *(emitter.nodes + field.first_child) };
        if typ.kind != AstKind::TypeRef || typ.next_sibling != 0 {
            return false;
        }
        declared_count = declared_count + 1;
        field_index = field.next_sibling;
    }

    let mut init_count: usize = 0;
    let mut init_index: usize = literal.first_child;
    while init_index != 0 {
        if !emitter.valid_node(init_index) {
            return false;
        }
        let init: AstNode = unsafe { *(emitter.nodes + init_index) };
        if init.kind != AstKind::StructFieldInit || init.str_len == 0
            || !emitter.valid_node(init.first_child)
            || native_find_struct_field_decl(emitter, struct_index, init_index) == 0 {
            return false;
        }
        let value: AstNode = unsafe { *(emitter.nodes + init.first_child) };
        if value.next_sibling != 0 {
            return false;
        }

        let mut previous: usize = literal.first_child;
        while previous != init_index {
            if previous == 0 || !emitter.valid_node(previous) {
                return false;
            }
            let previous_init: AstNode = unsafe { *(emitter.nodes + previous) };
            if previous_init.kind != AstKind::StructFieldInit {
                return false;
            }
            if native_source_slices_equal(
                emitter,
                previous_init.str_offset,
                previous_init.str_len,
                init.str_offset,
                init.str_len
            ) {
                return false;
            }
            previous = previous_init.next_sibling;
        }

        init_count = init_count + 1;
        init_index = init.next_sibling;
    }

    return declared_count != 0 && declared_count == init_count;
}

pub fn native_fixed_array_type_matches_zero_repeat(
    emitter: &CEmitter,
    type_index: usize,
    repeat_index: usize
) -> bool {
    if !emitter.valid_node(type_index) || !emitter.valid_node(repeat_index)
        || emitter.source == null {
        return false;
    }
    let typ: AstNode = unsafe { *(emitter.nodes + type_index) };
    let repeat: AstNode = unsafe { *(emitter.nodes + repeat_index) };
    if typ.kind != AstKind::TypeRef || typ.str_len < 5
        || repeat.kind != AstKind::ExprArrayRepeat
        || !emitter.valid_node(repeat.first_child) {
        return false;
    }
    let value_index: usize = repeat.first_child;
    let value: AstNode = unsafe { *(emitter.nodes + value_index) };
    let count_index: usize = value.next_sibling;
    if value.kind != AstKind::ExprLiteral
        || !emitter.source_slice_equals(value.str_offset, value.str_len, "0", 1)
        || !emitter.valid_node(count_index) {
        return false;
    }
    let count: AstNode = unsafe { *(emitter.nodes + count_index) };
    if count.kind != AstKind::ExprLiteral || count.str_len == 0
        || count.next_sibling != 0 {
        return false;
    }

    let mut i: usize = 0;
    while i < typ.str_len {
        let ch: u8 = unsafe { *(emitter.source + typ.str_offset + i) };
        if ch == 32 || ch == 9 || ch == 10 || ch == 13 { i = i + 1; }
        else { break; }
    }
    if i >= typ.str_len || unsafe { *(emitter.source + typ.str_offset + i) } != 91 {
        return false;
    }
    i = i + 1;
    while i < typ.str_len {
        let ch: u8 = unsafe { *(emitter.source + typ.str_offset + i) };
        if ch == 32 || ch == 9 || ch == 10 || ch == 13 { i = i + 1; }
        else { break; }
    }
    let element_start: usize = i;
    while i < typ.str_len {
        let ch: u8 = unsafe { *(emitter.source + typ.str_offset + i) };
        let alpha: bool = (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122);
        let digit: bool = ch >= 48 && ch <= 57;
        if alpha || digit || ch == 95 { i = i + 1; }
        else { break; }
    }
    if i == element_start {
        return false;
    }
    while i < typ.str_len {
        let ch: u8 = unsafe { *(emitter.source + typ.str_offset + i) };
        if ch == 32 || ch == 9 || ch == 10 || ch == 13 { i = i + 1; }
        else { break; }
    }
    if i >= typ.str_len || unsafe { *(emitter.source + typ.str_offset + i) } != 59 {
        return false;
    }
    i = i + 1;
    while i < typ.str_len {
        let ch: u8 = unsafe { *(emitter.source + typ.str_offset + i) };
        if ch == 32 || ch == 9 || ch == 10 || ch == 13 { i = i + 1; }
        else { break; }
    }
    let count_start: usize = i;
    let mut nonzero: bool = false;
    while i < typ.str_len {
        let ch: u8 = unsafe { *(emitter.source + typ.str_offset + i) };
        if ch >= 48 && ch <= 57 {
            if ch != 48 { nonzero = true; }
            i = i + 1;
        } else {
            break;
        }
    }
    let type_count_len: usize = i - count_start;
    if type_count_len == 0 || !nonzero {
        return false;
    }
    while i < typ.str_len {
        let ch: u8 = unsafe { *(emitter.source + typ.str_offset + i) };
        if ch == 32 || ch == 9 || ch == 10 || ch == 13 { i = i + 1; }
        else { break; }
    }
    if i >= typ.str_len || unsafe { *(emitter.source + typ.str_offset + i) } != 93 {
        return false;
    }
    i = i + 1;
    while i < typ.str_len {
        let ch: u8 = unsafe { *(emitter.source + typ.str_offset + i) };
        if ch == 32 || ch == 9 || ch == 10 || ch == 13 { i = i + 1; }
        else { return false; }
    }

    return native_source_slices_equal(
        emitter,
        typ.str_offset + count_start,
        type_count_len,
        count.str_offset,
        count.str_len
    );
}

pub fn native_type_ref_matches_struct_literal(
    emitter: &CEmitter,
    type_index: usize,
    literal_index: usize
) -> bool {
    if !emitter.valid_node(type_index) || !emitter.valid_node(literal_index) {
        return false;
    }
    let typ: AstNode = unsafe { *(emitter.nodes + type_index) };
    let literal: AstNode = unsafe { *(emitter.nodes + literal_index) };
    if typ.kind != AstKind::TypeRef || literal.kind != AstKind::ExprStructLiteral
        || typ.str_len == 0 || literal.str_len == 0 {
        return false;
    }
    return native_source_slices_equal(
        emitter,
        typ.str_offset,
        typ.str_len,
        literal.str_offset,
        literal.str_len
    );
}

pub fn emit_native_struct_literal(
    emitter: &mut CEmitter,
    literal_index: usize
) -> bool {
    if !native_struct_literal_shape_valid(emitter, literal_index) {
        return false;
    }
    let literal: AstNode = unsafe { *(emitter.nodes + literal_index) };
    let struct_index: usize = native_find_struct_decl_for_literal(emitter, literal_index);
    if struct_index == 0 {
        return false;
    }

    if !emitter.write_byte(40)
        || !emitter.write_source_slice(literal.str_offset, literal.str_len)
        || !emitter.write_str("){ ", 3) {
        return false;
    }

    let mut init_index: usize = literal.first_child;
    let mut first: bool = true;
    while init_index != 0 {
        if !emitter.valid_node(init_index) {
            return false;
        }
        let init: AstNode = unsafe { *(emitter.nodes + init_index) };
        let field_index: usize = native_find_struct_field_decl(
            emitter, struct_index, init_index
        );
        if field_index == 0 || !emitter.valid_node(init.first_child) {
            return false;
        }
        let field: AstNode = unsafe { *(emitter.nodes + field_index) };
        let type_index: usize = field.first_child;
        let value_index: usize = init.first_child;
        let value: AstNode = unsafe { *(emitter.nodes + value_index) };

        if !first && !emitter.write_str(", ", 2) {
            return false;
        }
        if !emitter.write_byte(46)
            || !emitter.write_source_slice(init.str_offset, init.str_len)
            || !emitter.write_str(" = ", 3) {
            return false;
        }

        if value.kind == AstKind::ExprStructLiteral {
            if !native_type_ref_matches_struct_literal(emitter, type_index, value_index)
                || !emit_native_struct_literal(emitter, value_index) {
                return false;
            }
        } else if value.kind == AstKind::ExprArrayRepeat {
            if !native_fixed_array_type_matches_zero_repeat(
                emitter, type_index, value_index
            ) || !emitter.write_str("{0}", 3) {
                return false;
            }
        } else if !emitter.emit_expression(value_index) {
            return false;
        }

        first = false;
        init_index = init.next_sibling;
    }
    return emitter.write_str(" }", 2);
}

pub fn emit_native_static_struct_constructor_body(
    emitter: &mut CEmitter,
    fn_index: usize,
    body_index: usize
) -> bool {
    if !emitter.valid_node(fn_index) || !emitter.valid_node(body_index) {
        return false;
    }
    let body: AstNode = unsafe { *(emitter.nodes + body_index) };
    if body.kind != AstKind::Block || !emitter.valid_node(body.first_child) {
        return false;
    }
    let ret_index: usize = body.first_child;
    let ret: AstNode = unsafe { *(emitter.nodes + ret_index) };
    if ret.kind != AstKind::ReturnStmt || ret.next_sibling != 0
        || !emitter.valid_node(ret.first_child) {
        return false;
    }
    let literal_index: usize = ret.first_child;
    let literal: AstNode = unsafe { *(emitter.nodes + literal_index) };
    if literal.kind != AstKind::ExprStructLiteral || literal.next_sibling != 0 {
        return false;
    }
    let return_type: usize = emitter.find_function_return_type(fn_index);
    if return_type == 0
        || !native_type_ref_matches_struct_literal(emitter, return_type, literal_index)
        || !native_struct_literal_shape_valid(emitter, literal_index) {
        return false;
    }

    if !emitter.write_str("{\nreturn ", 9)
        || !emit_native_struct_literal(emitter, literal_index) {
        return false;
    }
    return emitter.write_str(";\n}\n", 4);
}

pub fn emit_native_static_impl_function(
    emitter: &mut CEmitter,
    impl_index: usize,
    fn_index: usize
) -> bool {
    if !emitter.valid_node(impl_index) || !emitter.valid_node(fn_index) {
        return false;
    }

    let impl_node: AstNode = unsafe { *(emitter.nodes + impl_index) };
    let function_node: AstNode = unsafe { *(emitter.nodes + fn_index) };
    if impl_node.kind != AstKind::ImplDecl
        || impl_node.str_len == 0
        || function_node.kind != AstKind::FnDecl
        || function_node.str_len == 0
        || function_node.parent != impl_index {
        return false;
    }

    let return_type: usize = emitter.find_function_return_type(fn_index);
    if return_type == 0 {
        if !emitter.write_str("void", 4) {
            return false;
        }
    } else if !emitter.emit_c_type(return_type) {
        return false;
    }

    if !emitter.write_byte(32)
        || !emitter.write_source_slice(impl_node.str_offset, impl_node.str_len)
        || !emitter.write_byte(95)
        || !emitter.write_source_slice(function_node.str_offset, function_node.str_len)
        || !emitter.write_byte(40) {
        return false;
    }

    let mut child: usize = function_node.first_child;
    let mut first_param: bool = true;
    while child != 0 {
        if !emitter.valid_node(child) {
            return false;
        }
        let node: AstNode = unsafe { *(emitter.nodes + child) };
        if node.kind == AstKind::ParamDecl {
            if emitter.source_slice_equals(node.str_offset, node.str_len, "self", 4) {
                return false;
            }
            if !first_param && !emitter.write_str(", ", 2) {
                return false;
            }
            if !emitter.emit_parameter(child) {
                return false;
            }
            first_param = false;
        } else if node.kind != AstKind::TypeRef && node.kind != AstKind::Block {
            return false;
        }
        child = node.next_sibling;
    }

    let body_index: usize = emitter.find_function_body(fn_index);
    if body_index == 0 || !emitter.write_str(") ", 2) {
        return false;
    }

    let body: AstNode = unsafe { *(emitter.nodes + body_index) };
    if emitter.valid_node(body.first_child) {
        let first_stmt: AstNode = unsafe { *(emitter.nodes + body.first_child) };
        if first_stmt.kind == AstKind::ReturnStmt
            && first_stmt.next_sibling == 0
            && emitter.valid_node(first_stmt.first_child) {
            let returned: AstNode = unsafe { *(emitter.nodes + first_stmt.first_child) };
            if returned.kind == AstKind::ExprStructLiteral {
                return emit_native_static_struct_constructor_body(
                    emitter, fn_index, body_index
                );
            }
        }
    }
    return emitter.emit_braced_block(body_index);
}

pub fn emit_native_impl(
    emitter: &mut CEmitter,
    module_index: usize,
    impl_index: usize
) -> bool {
    if !emitter.valid_node(impl_index)
        || !native_impl_target_is_declared(emitter, module_index, impl_index) {
        return false;
    }
    let impl_node: AstNode = unsafe { *(emitter.nodes + impl_index) };
    if impl_node.kind != AstKind::ImplDecl || impl_node.str_len == 0
        || impl_node.first_child == 0 {
        return false;
    }

    let mut method_index: usize = impl_node.first_child;
    while method_index != 0 {
        if !emitter.valid_node(method_index) {
            return false;
        }
        let method: AstNode = unsafe { *(emitter.nodes + method_index) };
        if method.kind != AstKind::FnDecl || method.parent != impl_index
            || !native_static_method_is_unique(
                emitter, module_index, impl_index, method_index
            ) {
            return false;
        }
        if !emit_native_static_impl_function(emitter, impl_index, method_index) {
            return false;
        }
        if !emitter.write_byte(10) {
            return false;
        }
        method_index = method.next_sibling;
    }
    return true;
}

pub fn emit_native_module(
    emitter: &mut CEmitter,
    module_index: usize
) -> bool {
    if !emitter.valid_node(module_index) {
        return false;
    }
    let module_node: AstNode = unsafe { *(emitter.nodes + module_index) };
    if module_node.kind != AstKind::Module {
        return false;
    }

    let mut child: usize = module_node.first_child;
    while child != 0 {
        if !emitter.valid_node(child) {
            return false;
        }
        let node: AstNode = unsafe { *(emitter.nodes + child) };

        if node.kind == AstKind::Import {
        } else if node.kind == AstKind::EnumDecl {
            if !emitter.emit_enum(child) || !emitter.write_byte(10) {
                return false;
            }
        } else if node.kind == AstKind::StructDecl {
            if !emitter.emit_struct(child) || !emitter.write_byte(10) {
                return false;
            }
        } else if node.kind == AstKind::FnDecl {
            if !emitter.emit_function(child) || !emitter.write_byte(10) {
                return false;
            }
        } else if node.kind == AstKind::ImplDecl {
            if !emit_native_impl(emitter, module_index, child) {
                return false;
            }
        } else {
            return false;
        }

        child = node.next_sibling;
    }
    return true;
}

pub fn native_module_has_impl(
    nodes: *const AstNode,
    node_count: usize,
    module_index: usize
) -> bool {
    if nodes == null || module_index == 0 || module_index >= node_count {
        return false;
    }
    let module_node: AstNode = unsafe { *(nodes + module_index) };
    if module_node.kind != AstKind::Module {
        return false;
    }

    let mut child: usize = module_node.first_child;
    while child != 0 {
        if child >= node_count {
            return false;
        }
        let node: AstNode = unsafe { *(nodes + child) };
        if node.kind == AstKind::ImplDecl {
            return true;
        }
        child = node.next_sibling;
    }
    return false;
}

@export
@system
pub fn sotlas_native_compile_diagnostic(
    source: *const u8,
    len: usize,
    out_buf: *mut u8,
    max_out: usize,
    error_line: *mut u32,
    error_col: *mut u32
) -> usize {
    if error_line != null {
        unsafe { *error_line = 0; }
    }
    if error_col != null {
        unsafe { *error_col = 0; }
    }
    if source == null || len == 0 || out_buf == null || max_out == 0 {
        return 0;
    }

    let mut lex: Lexer = Lexer::new(source, len);
    let mut tok_count: usize = 0;
    while !lex.is_at_end() && tok_count < TOKEN_BUFFER_CAPACITY {
        let tok: Token = lex.next_token();
        unsafe {
            *(g_token_buffer as *mut Token + tok_count) = tok;
        }
        tok_count = tok_count + 1;
        if tok.kind == TokenKind::Eof {
            break;
        }
    }
    if !lex.is_at_end() {
        return 0;
    }

    let mut tok_ptr: *const Token = null;
    unsafe {
        tok_ptr = g_token_buffer as *const Token;
    }
    let mut node_ptr: *mut AstNode = null;
    unsafe {
        node_ptr = g_ast_node_buffer as *mut AstNode;
    }
    let mut p: Parser = Parser::new(
        tok_ptr,
        tok_count,
        node_ptr,
        AST_NODE_BUFFER_CAPACITY
    );
    let module_node: usize = p.parse_module();
    if module_node == 0 {
        if p.error_count != 0 {
            if error_line != null {
                unsafe { *error_line = p.error_line; }
            }
            if error_col != null {
                unsafe { *error_col = p.error_col; }
            }
        }
        return 0;
    }

    let mut sem: Sema = Sema::new();
    sem.enter_system();
    let _is_safe: bool = sem.check_system_privilege();
    if !sem.check_top_level_declarations(
        node_ptr, p.node_count, module_node, source, len
    ) {
        if error_line != null {
            unsafe { *error_line = sem.error_line; }
        }
        if error_col != null {
            unsafe { *error_col = sem.error_col; }
        }
        return 0;
    }

    let semantic_emitter: CEmitter = CEmitter::new(
        out_buf,
        max_out,
        source,
        len,
        node_ptr,
        p.node_count
    );
    if !native_validate_static_impl_calls(&mut sem, &semantic_emitter, module_node) {
        if error_line != null {
            unsafe { *error_line = sem.error_line; }
        }
        if error_col != null {
            unsafe { *error_col = sem.error_col; }
        }
        return 0;
    }

    let lowered_len: usize = lower_native_static_impl_calls_to_c_symbols(
        node_ptr, p.node_count, module_node, source, len
    );
    if lowered_len == 0 {
        return 0;
    }
    let mut lowered_source: *const u8 = null;
    unsafe {
        lowered_source = g_lowered_source_buffer as *const u8;
    }

    let mut emitter: CEmitter = CEmitter::new(
        out_buf,
        max_out,
        lowered_source,
        lowered_len,
        node_ptr,
        p.node_count
    );
    if !emitter.emit_header() {
        return 0;
    }
    if native_module_has_impl(node_ptr, p.node_count, module_node) {
        if !emit_native_module(&mut emitter, module_node) {
            return 0;
        }
    } else if !emitter.emit_module(module_node) {
        return 0;
    }

    return emitter.cursor;
}

@export
@system
pub fn sotlas_native_compile(
    source: *const u8,
    len: usize,
    out_buf: *mut u8,
    max_out: usize
) -> usize {
    return sotlas_native_compile_diagnostic(
        source, len, out_buf, max_out, null, null
    );
}

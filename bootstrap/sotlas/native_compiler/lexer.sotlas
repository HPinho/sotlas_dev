module sotlas::compiler::lexer;

import sotlas::compiler::token::*;

pub struct Lexer {
    pub source: *const u8;
    pub source_len: usize;
    pub cursor: usize;
    pub line: u32;
    pub col: u32;
    pub error_count: usize;
    pub error_line: u32;
    pub error_col: u32;
    pub reached_eof: bool;
}

impl Lexer {
    pub fn new(src: *const u8, len: usize) -> Lexer {
        return Lexer {
            source: src,
            source_len: len,
            cursor: 0,
            line: 1,
            col: 1,
            error_count: 0,
            error_line: 0,
            error_col: 0,
            reached_eof: false
        };
    }

    pub fn is_at_end(self: &Self) -> bool {
        return self.reached_eof || self.cursor >= self.source_len;
    }

    pub fn peek(self: &Self) -> u8 {
        if self.cursor >= self.source_len {
            return 0;
        }
        unsafe {
            return *(self.source + self.cursor);
        }
    }

    pub fn peek_next(self: &Self) -> u8 {
        if self.cursor + 1 >= self.source_len {
            return 0;
        }
        unsafe {
            return *(self.source + self.cursor + 1);
        }
    }

    pub fn advance(mut self: &mut Self) -> u8 {
        if self.cursor >= self.source_len {
            return 0;
        }
        let ch: u8 = unsafe { *(self.source + self.cursor) };
        self.cursor = self.cursor + 1;
        if ch == 10 { // '\n'
            self.line = self.line + 1;
            self.col = 1;
        } else {
            self.col = self.col + 1;
        }
        return ch;
    }

    pub fn token_from_span(
        self: &Self,
        kind: TokenKind,
        line: u32,
        col: u32,
        start_offset: usize
    ) -> Token {
        let mut tok: Token = Token::new(kind, line, col);
        tok.span.offset = start_offset;
        tok.span.length = self.cursor - start_offset;
        return tok;
    }

    pub fn skip_whitespace_and_comments(mut self: &mut Self) {
        while !self.is_at_end() {
            let ch: u8 = self.peek();
            // Espaços em branco: espaço, tab, retorno de carro, nova linha
            if ch == 32 || ch == 9 || ch == 13 || ch == 10 {
                self.advance();
            } else if ch == 47 && self.peek_next() == 47 { // // comentário de linha
                while !self.is_at_end() && self.peek() != 10 {
                    self.advance();
                }
            } else if ch == 47 && self.peek_next() == 42 { // /* comentário de bloco
                let comment_line: u32 = self.line;
                let comment_col: u32 = self.col;
                self.advance();
                self.advance();
                let mut closed: bool = false;
                while !self.is_at_end() {
                    if self.peek() == 42 && self.peek_next() == 47 {
                        self.advance();
                        self.advance();
                        closed = true;
                        break;
                    }
                    self.advance();
                }
                if !closed {
                    self.error_count = self.error_count + 1;
                    if self.error_line == 0 {
                        self.error_line = comment_line;
                        self.error_col = comment_col;
                    }
                    return;
                }
            } else {
                break;
            }
        }
    }

    pub fn next_token(mut self: &mut Self) -> Token {
        self.skip_whitespace_and_comments();
        if self.error_count != 0 {
            return Token::new(TokenKind::Error, self.error_line, self.error_col);
        }
        if self.cursor >= self.source_len && !self.reached_eof {
            self.reached_eof = true;
            return Token::new(TokenKind::Eof, self.line, self.col);
        }
        if self.reached_eof {
            return Token::new(TokenKind::Eof, self.line, self.col);
        }

        let start_line: u32 = self.line;
        let start_col: u32 = self.col;
        let start_offset: usize = self.cursor;
        let ch: u8 = self.advance();

        // Identificadores, palavras-chave e literais booleanos reservados.
        if (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95 { // A-Z, a-z, _
            while !self.is_at_end() {
                let p: u8 = self.peek();
                if (p >= 65 && p <= 90) || (p >= 97 && p <= 122) || (p >= 48 && p <= 57) || p == 95 {
                    self.advance();
                } else {
                    break;
                }
            }
            let length: usize = self.cursor - start_offset;
            let mut tok: Token = Token::new(TokenKind::Ident, start_line, start_col);
            tok.span.offset = start_offset;
            tok.span.length = length;
            tok.text_len = length;
            // Classifica palavra-chave ou literal reservado.
            tok.kind = self.classify_keyword(start_offset, length);
            return tok;
        }

        // Literais numéricos. O subset nativo reconhece inteiros hexadecimais
        // e decimais, além de floats decimais `digits.digits`. Um `..` continua
        // reservado ao operador de intervalo e nunca é absorvido pelo literal.
        if ch >= 48 && ch <= 57 { // 0-9
            let mut numeric_kind: TokenKind = TokenKind::IntLit;
            if ch == 48 && (self.peek() == 120 || self.peek() == 88) { // 0x
                self.advance();
                while !self.is_at_end() {
                    let p: u8 = self.peek();
                    if (p >= 48 && p <= 57) || (p >= 65 && p <= 70) || (p >= 97 && p <= 102) || p == 95 {
                        self.advance();
                    } else {
                        break;
                    }
                }
            } else {
                while !self.is_at_end() {
                    let p: u8 = self.peek();
                    if (p >= 48 && p <= 57) || p == 95 {
                        self.advance();
                    } else {
                        break;
                    }
                }
                let fraction_first: u8 = self.peek_next();
                if self.peek() == 46 && fraction_first >= 48 && fraction_first <= 57 {
                    numeric_kind = TokenKind::FloatLit;
                    self.advance(); // ponto decimal
                    while !self.is_at_end() {
                        let p: u8 = self.peek();
                        if (p >= 48 && p <= 57) || p == 95 {
                            self.advance();
                        } else {
                            break;
                        }
                    }
                }
            }
            let length: usize = self.cursor - start_offset;
            let mut tok: Token = Token::new(numeric_kind, start_line, start_col);
            tok.span.offset = start_offset;
            tok.span.length = length;
            return tok;
        }

        // Strings normais "..."
        if ch == 34 { // '"'
            while !self.is_at_end() && self.peek() != 34 {
                if self.peek() == 92 { // '\\'
                    self.advance();
                }
                if self.peek() == 10 {
                    break;
                }
                self.advance();
            }
            if !self.is_at_end() && self.peek() == 34 {
                self.advance(); // fecha-aspas
            } else {
                self.error_count = self.error_count + 1;
                if self.error_line == 0 {
                    self.error_line = start_line;
                    self.error_col = start_col;
                }
                return Token::new(TokenKind::Error, start_line, start_col);
            }
            let length: usize = self.cursor - start_offset;
            let mut tok: Token = Token::new(TokenKind::StrLit, start_line, start_col);
            tok.span.offset = start_offset;
            tok.span.length = length;
            return tok;
        }

        // Character literals share the same escape and termination contract as strings.
        if ch == 39 {
            while !self.is_at_end() && self.peek() != 39 && self.peek() != 10 {
                if self.peek() == 92 {
                    self.advance();
                }
                if !self.is_at_end() {
                    self.advance();
                }
            }
            if self.is_at_end() || self.peek() != 39 {
                self.error_count = self.error_count + 1;
                if self.error_line == 0 {
                    self.error_line = start_line;
                    self.error_col = start_col;
                }
                return Token::new(TokenKind::Error, start_line, start_col);
            }
            self.advance();
            return self.token_from_span(TokenKind::CharLit, start_line, start_col, start_offset);
        }

        // Operadores compostos e pontuação
        if ch == 61 { // '='
            if self.peek() == 61 { self.advance(); return self.token_from_span(TokenKind::EqEq, start_line, start_col, start_offset); }
            if self.peek() == 62 { self.advance(); return self.token_from_span(TokenKind::FatArrow, start_line, start_col, start_offset); }
            return self.token_from_span(TokenKind::Equal, start_line, start_col, start_offset);
        }
        if ch == 33 { // '!'
            if self.peek() == 61 { self.advance(); return self.token_from_span(TokenKind::BangEq, start_line, start_col, start_offset); }
            return self.token_from_span(TokenKind::Bang, start_line, start_col, start_offset);
        }
        if ch == 60 { // '<'
            if self.peek() == 61 { self.advance(); return self.token_from_span(TokenKind::LtEq, start_line, start_col, start_offset); }
            if self.peek() == 60 { self.advance(); return self.token_from_span(TokenKind::Shl, start_line, start_col, start_offset); }
            return self.token_from_span(TokenKind::Lt, start_line, start_col, start_offset);
        }
        if ch == 62 { // '>'
            if self.peek() == 61 { self.advance(); return self.token_from_span(TokenKind::GtEq, start_line, start_col, start_offset); }
            if self.peek() == 62 { self.advance(); return self.token_from_span(TokenKind::Shr, start_line, start_col, start_offset); }
            return self.token_from_span(TokenKind::Gt, start_line, start_col, start_offset);
        }
        if ch == 58 { // ':'
            if self.peek() == 58 { self.advance(); return self.token_from_span(TokenKind::DColon, start_line, start_col, start_offset); }
            return self.token_from_span(TokenKind::Colon, start_line, start_col, start_offset);
        }
        if ch == 46 { // '.'
            if self.peek() == 46 { self.advance(); return self.token_from_span(TokenKind::DotDot, start_line, start_col, start_offset); }
            return self.token_from_span(TokenKind::Dot, start_line, start_col, start_offset);
        }
        if ch == 45 { // '-'
            if self.peek() == 62 { self.advance(); return self.token_from_span(TokenKind::Arrow, start_line, start_col, start_offset); }
            return self.token_from_span(TokenKind::Minus, start_line, start_col, start_offset);
        }

        // Operadores simples
        if ch == 43 { return self.token_from_span(TokenKind::Plus, start_line, start_col, start_offset); }
        if ch == 42 { return self.token_from_span(TokenKind::Star, start_line, start_col, start_offset); }
        if ch == 47 { return self.token_from_span(TokenKind::Slash, start_line, start_col, start_offset); }
        if ch == 37 { return self.token_from_span(TokenKind::Percent, start_line, start_col, start_offset); }
        if ch == 38 {
            if self.peek() == 38 {
                self.advance();
                return self.token_from_span(TokenKind::LogicalAnd, start_line, start_col, start_offset);
            }
            return self.token_from_span(TokenKind::Amp, start_line, start_col, start_offset);
        }
        if ch == 124 {
            if self.peek() == 124 {
                self.advance();
                return self.token_from_span(TokenKind::LogicalOr, start_line, start_col, start_offset);
            }
            return self.token_from_span(TokenKind::Pipe, start_line, start_col, start_offset);
        }
        if ch == 94 { return self.token_from_span(TokenKind::Caret, start_line, start_col, start_offset); }
        if ch == 126 { return self.token_from_span(TokenKind::Tilde, start_line, start_col, start_offset); }
        if ch == 59 { return self.token_from_span(TokenKind::SemiColon, start_line, start_col, start_offset); }
        if ch == 44 { return self.token_from_span(TokenKind::Comma, start_line, start_col, start_offset); }
        if ch == 63 { return self.token_from_span(TokenKind::Qmark, start_line, start_col, start_offset); }
        if ch == 40 { return self.token_from_span(TokenKind::OpenParen, start_line, start_col, start_offset); }
        if ch == 41 { return self.token_from_span(TokenKind::CloseParen, start_line, start_col, start_offset); }
        if ch == 123 { return self.token_from_span(TokenKind::OpenBrace, start_line, start_col, start_offset); }
        if ch == 125 { return self.token_from_span(TokenKind::CloseBrace, start_line, start_col, start_offset); }
        if ch == 91 { return self.token_from_span(TokenKind::OpenBracket, start_line, start_col, start_offset); }
        if ch == 93 { return self.token_from_span(TokenKind::CloseBracket, start_line, start_col, start_offset); }
        if ch == 64 { return self.token_from_span(TokenKind::At, start_line, start_col, start_offset); }

        self.error_count = self.error_count + 1;
        if self.error_line == 0 {
            self.error_line = start_line;
            self.error_col = start_col;
        }
        return Token::new(TokenKind::Error, start_line, start_col);
    }

    pub fn classify_keyword(self: &Self, offset: usize, len: usize) -> TokenKind {
        // Comparador eficiente de palavras-chave e literais estáticos em Sotlas
        if len == 2 {
            if self.matches_str(offset, 2, "fn") { return TokenKind::KwFn; }
            if self.matches_str(offset, 2, "if") { return TokenKind::KwIf; }
            if self.matches_str(offset, 2, "as") { return TokenKind::KwAs; }
            if self.matches_str(offset, 2, "in") { return TokenKind::KwIn; }
        } else if len == 3 {
            if self.matches_str(offset, 3, "pub") { return TokenKind::KwPub; }
            if self.matches_str(offset, 3, "let") { return TokenKind::KwLet; }
            if self.matches_str(offset, 3, "var") { return TokenKind::KwVar; }
            if self.matches_str(offset, 3, "mut") { return TokenKind::KwMut; }
            if self.matches_str(offset, 3, "asm") { return TokenKind::KwAsm; }
        } else if len == 4 {
            if self.matches_str(offset, 4, "true") { return TokenKind::BoolLit; }
            if self.matches_str(offset, 4, "else") { return TokenKind::KwElse; }
            if self.matches_str(offset, 4, "loop") { return TokenKind::KwLoop; }
            if self.matches_str(offset, 4, "sole") { return TokenKind::KwSole; }
            if self.matches_str(offset, 4, "mesh") { return TokenKind::KwMesh; }
            if self.matches_str(offset, 4, "spec") { return TokenKind::KwSpec; }
            if self.matches_str(offset, 4, "enum") { return TokenKind::KwEnum; }
            if self.matches_str(offset, 4, "impl") { return TokenKind::KwImpl; }
            if self.matches_str(offset, 4, "gate") { return TokenKind::KwGate; }
            if self.matches_str(offset, 4, "emit") { return TokenKind::KwEmit; }
        } else if len == 5 {
            if self.matches_str(offset, 5, "false") { return TokenKind::BoolLit; }
            if self.matches_str(offset, 5, "while") { return TokenKind::KwWhile; }
            if self.matches_str(offset, 5, "const") { return TokenKind::KwConst; }
            if self.matches_str(offset, 5, "class") { return TokenKind::KwClass; }
            if self.matches_str(offset, 5, "match") { return TokenKind::KwMatch; }
            if self.matches_str(offset, 5, "break") { return TokenKind::KwBreak; }
            if self.matches_str(offset, 5, "defer") { return TokenKind::KwDefer; }
            if self.matches_str(offset, 5, "pulse") { return TokenKind::KwPulse; }
            if self.matches_str(offset, 5, "probe") { return TokenKind::KwProbe; }
            if self.matches_str(offset, 5, "forge") { return TokenKind::KwForge; }
            if self.matches_str(offset, 5, "async") { return TokenKind::KwAsync; }
            if self.matches_str(offset, 5, "await") { return TokenKind::KwAwait; }
        } else if len == 6 {
            if self.matches_str(offset, 6, "module") { return TokenKind::KwModule; }
            if self.matches_str(offset, 6, "import") { return TokenKind::KwImport; }
            if self.matches_str(offset, 6, "struct") { return TokenKind::KwStruct; }
            if self.matches_str(offset, 6, "static") { return TokenKind::KwStatic; }
            if self.matches_str(offset, 6, "trapfn") { return TokenKind::KwTrapfn; }
            if self.matches_str(offset, 6, "return") { return TokenKind::KwReturn; }
            if self.matches_str(offset, 6, "unsafe") { return TokenKind::KwUnsafe; }
            if self.matches_str(offset, 6, "clinch") { return TokenKind::KwClinch; }
            if self.matches_str(offset, 6, "revert") { return TokenKind::KwRevert; }
            if self.matches_str(offset, 6, "system") { return TokenKind::KwSystem; }
            if self.matches_str(offset, 6, "target") { return TokenKind::KwTarget; }
        } else if len == 7 {
            if self.matches_str(offset, 7, "discern") { return TokenKind::KwDiscern; }
            if self.matches_str(offset, 7, "rebound") { return TokenKind::KwRebound; }
            if self.matches_str(offset, 7, "whisper") { return TokenKind::KwWhisper; }
            if self.matches_str(offset, 7, "enclave") { return TokenKind::KwEnclave; }
        } else if len == 8 {
            if self.matches_str(offset, 8, "handover") { return TokenKind::KwHandover; }
            if self.matches_str(offset, 8, "volatile") { return TokenKind::KwVolatile; }
            if self.matches_str(offset, 8, "comptime") { return TokenKind::KwComptime; }
            if self.matches_str(offset, 8, "continue") { return TokenKind::KwContinue; }
            if self.matches_str(offset, 8, "barecore") { return TokenKind::KwBarecore; }
        } else if len == 9 {
            if self.matches_str(offset, 9, "typealias") { return TokenKind::KwTypealias; }
        }
        return TokenKind::Ident;
    }

    pub fn matches_str(self: &Self, offset: usize, len: usize, needle: *const u8) -> bool {
        let mut i: usize = 0;
        while i < len {
            let a: u8 = unsafe { *(self.source + offset + i) };
            let b: u8 = unsafe { *(needle + i) };
            if a != b {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
}

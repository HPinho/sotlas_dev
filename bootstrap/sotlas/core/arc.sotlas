module core::arc;
import core::mem::*;

@repr(C)
pub struct ArcHeader {
    ref_count: u64;
    data_size: usize;
}

@system
pub fn arc_init(header: *mut ArcHeader, size: usize) {
    if header != null {
        unsafe {
            __atomic_store_u64((&header.ref_count) as u64, 1);
            header.data_size = size;
        }
    }
}

@system
pub fn arc_retain(header: *mut ArcHeader) -> *mut ArcHeader {
    if header == null {
        return null;
    }

    let mut address: u64 = 0;
    let mut count: u64 = 0;
    unsafe {
        address = (&header.ref_count) as u64;
        count = __atomic_load_u64(address);
    }
    while count > 0 {
        if count == 18446744073709551615u64 {
            return null;
        }
        let mut observed: u64 = 0;
        unsafe {
            observed = __atomic_cmpxchg_u64(
                address,
                count as u64,
                (count + 1) as u64
            );
        }
        if observed == count {
            return header;
        }
        count = observed;
    }
    return null;
}

@system
pub fn arc_release(header: *mut ArcHeader) -> bool {
    if header == null {
        return false;
    }

    let mut address: u64 = 0;
    let mut count: u64 = 0;
    unsafe {
        address = (&header.ref_count) as u64;
        count = __atomic_load_u64(address);
    }
    while count > 0 {
        let mut observed: u64 = 0;
        unsafe {
            observed = __atomic_cmpxchg_u64(
                address,
                count as u64,
                (count - 1) as u64
            );
        }
        if observed == count {
            return count == 1;
        }
        count = observed;
    }
    return false;
}

@system
pub fn arc_count(header: *const ArcHeader) -> u64 {
    if header == null {
        return 0;
    }
    unsafe {
        return __atomic_load_u64((&header.ref_count) as u64);
    }
}

pub class SharedCounter {
    header: ArcHeader;
    value: u64;

    @system
    pub fn new(initial: u64) -> SharedCounter {
        let mut sc: SharedCounter = 0;
        unsafe {
            arc_init((&sc.header) as *mut ArcHeader, 8);
        }
        sc.value = initial;
        return sc;
    }

    pub fn increment(self: *mut SharedCounter) {
        if self != null {
            unsafe {
                self.value = self.value + 1;
            }
        }
    }

    pub fn get_value(self: *const SharedCounter) -> u64 {
        if self == null {
            return 0;
        }
        unsafe {
            return self.value;
        }
    }

    @system
    pub fn retain(self: *mut SharedCounter) {
        if self != null {
            unsafe {
                arc_retain((&self.header) as *mut ArcHeader);
            }
        }
    }

    @system
    pub fn release(self: *mut SharedCounter) -> bool {
        if self != null {
            unsafe {
                return arc_release((&self.header) as *mut ArcHeader);
            }
        }
        return false;
    }
}

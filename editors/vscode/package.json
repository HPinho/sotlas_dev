{
  "name": "vscode-sotlas",
  "displayName": "Sotlas Language",
  "publisher": "sotlas-lang",
  "author": "Hiago Pinho",
  "description": "Sotlas language support with syntax highlighting, structural diagnostics, outline, hover, and compiler commands.",
  "version": "1.0.0",
  "preview": true,
  "icon": "./icons/sotlas-icon.png",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "license": "Apache-2.0 WITH LLVM-exception",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sotlas/vscode-sotlas.git"
  },
  "bugs": {
    "url": "https://github.com/Sotlas/vscode-sotlas/issues"
  },
  "homepage": "https://sotlas.org",
  "keywords": ["sotlas", "systems", "game-engine", "compiler", "language", "bare-metal", "general-purpose"],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:sotlas"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test test/*.test.cjs",
    "test:vsix": "node test/installVsix.cjs",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "package:preview": "vsce package --out sotlas-preview.vsix"
  },
  "contributes": {
    "languages": [
      {
        "id": "sotlas",
        "aliases": [
          "Sotlas",
          "sotlas"
        ],
        "extensions": [
          ".sotlas",
          ".sth"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/sotlas-icon.svg",
          "dark": "./icons/sotlas-logo.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "sotlas",
        "scopeName": "source.sotlas",
        "path": "./syntaxes/sotlas.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "sotlas-icons",
        "label": "Sotlas File Icons",
        "path": "./icons/sotlas-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "sotlas.build",
        "title": "Sotlas: Build Workspace"
      },
      {
        "command": "sotlas.check",
        "title": "Sotlas: Check Active File"
      },
      {
        "command": "sotlas.format",
        "title": "Sotlas: Format Active File"
      },
      {
        "command": "sotlas.studio",
        "title": "Sotlas: Open Studio"
      },
      {
        "command": "sotlas.repl",
        "title": "Sotlas: Start REPL"
      },
      {
        "command": "sotlas.dumpWasm",
        "title": "Sotlas: Emit WebAssembly (.wat)"
      },
      {
        "command": "sotlas.restartServer",
        "title": "Sotlas: Restart Language Server"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Sotlas Configuration",
      "properties": {
        "sotlas.compilerPath": {
          "type": "string",
          "default": "sotlas",
          "description": "Path to the Sotlas compiler executable or command"
        },
        "sotlas.enableExternalLsp": {
          "type": "boolean",
          "default": false,
          "description": "Enable the optional external `sotlas lsp --stdio` server"
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2",
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.60.0",
    "typescript": "^4.5.4"
  }
}

module tensor_rows::main;
import sotlas::runtime::tensor_cpu::*;
import sotlas::runtime::tensor_ops::*;

// Two samples, three features per sample. Apply channel offsets and scales,
// compute sample statistics, then project each sample onto a fixed vector.
pub fn main_entry()->u32 {
    let samples:[f32;6]=[10.0,20.0,30.0,40.0,50.0,60.0];
    let offsets:[f32;3]=[-10.0,-20.0,-30.0];
    let scales:[f32;3]=[0.5,1.0,2.0];
    let weights:[f32;3]=[1.0,0.0,-1.0];
    let mut normalized:[f32;6]=0;
    let mut means:[f32;2]=0;
    let mut maxima:[f32;2]=0;
    let mut scores:[f32;2]=0;

    let input:NativeF32View=NativeF32View{data:unsafe{samples as *const f32},length:6};
    let offset:NativeF32View=NativeF32View{data:unsafe{offsets as *const f32},length:3};
    let scale:NativeF32View=NativeF32View{data:unsafe{scales as *const f32},length:3};
    let projection:NativeF32View=NativeF32View{data:unsafe{weights as *const f32},length:3};
    let output:NativeF32MutView=NativeF32MutView{data:unsafe{normalized as *mut f32},length:6};
    let transformed:NativeF32View=NativeF32View{data:unsafe{normalized as *const f32},length:6};
    let mean_output:NativeF32MutView=NativeF32MutView{data:unsafe{means as *mut f32},length:2};
    let max_output:NativeF32MutView=NativeF32MutView{data:unsafe{maxima as *mut f32},length:2};
    let score_output:NativeF32MutView=NativeF32MutView{data:unsafe{scores as *mut f32},length:2};
    if native_f32_broadcast_add_cpu(output,input,offset,2,3)!=0 { return 1; }
    if native_f32_broadcast_mul_cpu(output,transformed,scale,2,3)!=0 { return 2; }
    if native_f32_row_mean_cpu(mean_output,transformed,2,3)!=0 { return 3; }
    if native_f32_row_max_cpu(max_output,transformed,2,3)!=0 { return 4; }
    if native_f32_gemv_cpu(score_output,projection,transformed,2,3)!=0 { return 5; }
    if means[0]!=0.0 || means[1]!=35.0 || maxima[0]!=0.0 || maxima[1]!=60.0
        || scores[0]!=0.0 || scores[1]!=-45.0 { return 6; }
    return 0;
}

module examples::cli_tool;

pub enum Command {
    None = 0,
    Build = 1,
    Test = 2,
    Help = 3
}

// Demonstrates command selection logic. Process arguments and terminal I/O
// are outside the current source-language preview contract.
pub fn parse_command(arg: u32) -> Command {
    if arg == 1 {
        return Command::Build;
    }
    if arg == 2 {
        return Command::Test;
    }
    if arg == 3 {
        return Command::Help;
    }
    return Command::None;
}

pub fn main() -> i32 {
    let command: Command = parse_command(1);
    if command != Command::Build {
        return 2;
    }

    // The demo selects Build and returns status 0; other commands have their
    // own dispatch paths without claiming to consume process argv.
    if command == Command::Build {
        return 0;
    }
    if command == Command::Test {
        return 10;
    }
    if command == Command::Help {
        return 0;
    }
    return 1;
}

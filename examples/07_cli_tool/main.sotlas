module examples::cli_tool;

pub enum Command {
    None = 0,
    Build = 1,
    Test = 2,
    Help = 3
}

// Demonstrates command selection logic. Process arguments and terminal I/O
// are outside the current source-language preview contract.
pub fn parse_command(arg: u32) -> Command {
    if arg == 1 {
        return Command::Build;
    }
    if arg == 2 {
        return Command::Test;
    }
    if arg == 3 {
        return Command::Help;
    }
    return Command::None;
}

pub fn dispatch(command: Command) -> i32 {
    if command == Command::Build {
        return 0;
    }
    if command == Command::Test {
        return 10;
    }
    if command == Command::Help {
        return 0;
    }
    return 1;
}

pub fn main() -> i32 {
    if dispatch(parse_command(1)) != 0 {
        return 2;
    }
    if parse_command(2) != Command::Test {
        return 3;
    }
    if dispatch(parse_command(2)) != 10 {
        return 4;
    }
    if dispatch(parse_command(3)) != 0 {
        return 5;
    }
    if parse_command(99) != Command::None || dispatch(parse_command(99)) != 1 {
        return 6;
    }
    return 0;
}

module native_utf8_pipeline;
import sotlas::runtime::results::*;
import sotlas::runtime::utf8::*;

static mut completed:u32=0;

fn report(input:*const u8,length:usize)->NativeUtf8TextResult{
    defer{unsafe{completed=completed+1;}}
    let source:NativeUtf8Text=native_utf8_from_bytes(input,length)?;
    let separator:NativeUtf8Text=native_utf8_from_bytes("=",1)?;
    let key:NativeUtf8Text=native_utf8_before(source,separator)?;
    let name:NativeUtf8Text=native_utf8_trim(key)?;
    let normalized:NativeUtf8Text=native_utf8_ascii_case(name,1)?;
    let expected:NativeUtf8Text=native_utf8_from_bytes("count",5)?;
    if !native_utf8_equal(normalized,expected){return native_utf8_error(7,0);}
    let tail:NativeUtf8Text=native_utf8_after(source,separator)?;
    let digits:NativeUtf8Text=native_utf8_trim(tail)?;
    let number:NativeU32Result=native_utf8_parse_u32(digits);
    if number.status!=0{return native_utf8_error(number.status,number.error.offset);}
    let sum:NativeU32Result=native_u32_add(number.value,22);
    if sum.status!=0{return native_utf8_error(sum.status,sum.error.offset);}
    let formatted:NativeUtf8Text=native_utf8_from_u32(sum.value)?;
    let label:NativeUtf8Text=native_utf8_from_bytes("total=",6)?;
    return native_utf8_concat(label,formatted);
}

pub fn main_entry()->u32{
    let good:NativeUtf8TextResult=report(" COUNT = 20 ",12);
    let invalid:NativeUtf8TextResult=report("count=2x",8);
    let missing:NativeUtf8TextResult=report("count",5);
    let overflow:NativeUtf8TextResult=report("count=4294967295",16);
    let expected:NativeUtf8Text=native_utf8_from_bytes("total=42",8).value;
    if good.status!=0 || !native_utf8_equal(good.value,expected)
        || invalid.status!=3 || invalid.error.offset!=1 || missing.status!=9
        || overflow.status!=4 || unsafe{completed}!=4{return 1;}
    let euro:NativeUtf8Text=native_utf8_push_scalar(native_utf8_empty(),8364).value;
    if native_utf8_validate(euro).value!=1 || native_utf8_slice(euro,1,3).status!=8{return 2;}
    return 42;
}

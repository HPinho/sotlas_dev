module native_pool_text;
import sotlas::runtime::pool::*;
import sotlas::runtime::pool_text::*;

// Persistent UTF-8 key/value parsing and text ownership, all within reusable
// Sotlas-managed slots. No C runtime, Python or OS heap on this path.
pub fn main_entry()->u32{
    let mut storage:[u8;128]=0;
    let mut metadata:[u64;16]=0;
    let words:*mut u64=unsafe{metadata as *mut u64};
    let mut pool:NativePool=native_pool_empty();
    let p:*mut NativePool=unsafe{(&mut pool) as *mut NativePool};
    if !native_pool_open_words(p,unsafe{storage as *mut u8},128,words,16,4,32){return 1;}

    // Allocate, clone, release and reuse while retaining the independent copy.
    let title:NativePoolHandle=native_pool_text_create(p,"Sotlas",6);
    let copy:NativePoolHandle=native_pool_clone(title);
    let old:NativePoolView=native_pool_text_view(title);
    if !native_pool_release(title,true){return 2;}
    let reused:NativePoolHandle=native_pool_text_create(p,"reused",6);
    if reused.index!=title.index || native_pool_current(title)
        || native_pool_view_current(old) || !native_pool_current(copy){return 3;}

    // A complete key/value record is stored independently from the text report.
    let record:NativePoolHandle=native_pool_text_create(p,"answer=42",9);
    let parts:NativePoolTextSplit=native_pool_text_split_once(record,"=",1);
    if !parts.found || parts.before.length!=6
        || native_pool_text_parse_u32(parts.after).value!=42{return 4;}
    let key:NativePoolHandle=native_pool_text_clone_scalars(record,0,6);
    if !native_pool_current(key) || native_pool_length(key)!=6
        || !native_pool_text_equal_handles(key,key){return 5;}
    if !native_pool_release(record,true)
        || native_pool_view_current(parts.after)
        || native_pool_text_parse_u32(parts.after).status!=7{return 6;}

    // Compose and edit Unicode while all four slots are accounted for.
    if native_pool_text_append(copy," ready",6).status!=0
        || native_pool_text_append_from(copy,reused).status!=0
        || native_pool_text_insert_scalar(copy,6,58).status!=0
        || native_pool_text_append_scalar(copy,8364).status!=0{return 7;}
    if native_pool_text_remove_scalar(copy,6).value!=58
        || native_pool_text_pop_scalar(copy).value!=8364
        || native_pool_length(copy)!=18{return 8;}
    let mut output:[u8;18]=0;
    if !native_pool_read(native_pool_text_view(copy),unsafe{output as *mut u8},18)
        || output[0]!=83 || output[6]!=32 || output[12]!=114
        || output[17]!=100{return 9;}

    if !native_pool_release(copy,true) || !native_pool_release(reused,true)
        || !native_pool_release(key,true) || !native_pool_close(p){return 10;}
    return 42;
}

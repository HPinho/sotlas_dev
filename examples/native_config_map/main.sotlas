module native_config_map;
import sotlas::runtime::text_map::*;
import sotlas::runtime::pool::*;
import sotlas::runtime::pool_text::*;
import sotlas::runtime::results::*;
import sotlas::runtime::json::*;
import sotlas::runtime::json_writer::*;
import sotlas::runtime::text::*;

fn configure_json(map:*mut NativeTextMap)->NativeU32Result{
    let source:NativeByteSlice=native_text_open("{\"base\":20,\"options\":{\"increment\":22},\"label\":\"Sotlas \\u20ac\"}",62);
    let document:NativeJsonResult=native_json_parse(source);
    if document.status!=0{return native_u32_error(11,document.offset);}
    let base:NativeJsonResult=native_json_object_get(document.value,native_text_open("base",4));
    let options:NativeJsonResult=native_json_object_get(document.value,native_text_open("options",7));
    let increment:NativeJsonResult=native_json_object_get(options.value,native_text_open("increment",9));
    let label:NativeJsonResult=native_json_object_get(document.value,native_text_open("label",5));
    if !base.found || !increment.found || !label.found{return native_u32_error(11,0);}
    let a:u32=native_json_u32(base.value)?;let b:u32=native_json_u32(increment.value)?;
    let mut bytes:[u8;16]=0;let data:*mut u8=unsafe{bytes as *mut u8};
    let copied:NativeJsonStringResult=native_json_string_copy(label.value,data,16);
    if copied.status!=0{return native_u32_error(11,copied.offset);}
    native_text_map_set_u32(map,"base",4,a)?;
    native_text_map_set_u32(map,"increment",9,b)?;
    native_text_map_set(map,"label",5,data,copied.length)?;
    return native_u32_ok(a+b);
}

fn export_config(map:*mut NativeTextMap)->NativeU32Result{
    let base:u32=native_text_map_get_u32(map,"base",4)?;
    let increment:u32=native_text_map_get_u32(map,"increment",9)?;
    let label:NativePoolView=native_text_map_get(map,"label",5);
    let mut text:[u8;32]=0;let content:*mut u8=unsafe{text as *mut u8};
    if !native_pool_read(label,content,32){return native_u32_error(11,0);}
    let mut output:[u8;160]=0;let data:*mut u8=unsafe{output as *mut u8};
    let mut writer:NativeJsonWriter=native_json_writer_open(data,160);
    let w:*mut NativeJsonWriter=unsafe{(&mut writer) as *mut NativeJsonWriter};
    if native_json_writer_object(w)!=0 || native_json_writer_key(w,native_text_open("base",4))!=0
        || native_json_writer_u32(w,base)!=0 || native_json_writer_key(w,native_text_open("options",7))!=0
        || native_json_writer_object(w)!=0 || native_json_writer_key(w,native_text_open("increment",9))!=0
        || native_json_writer_u32(w,increment)!=0 || native_json_writer_end_object(w)!=0
        || native_json_writer_key(w,native_text_open("label",5))!=0
        || native_json_writer_string(w,native_text_open(content,label.length))!=0
        || native_json_writer_end_object(w)!=0{return native_u32_error(11,1);}
    let view:NativeByteSlice=native_json_writer_view(w);
    let parsed:NativeJsonResult=native_json_parse(view);if parsed.status!=0{return native_u32_error(11,parsed.offset);}
    let a:NativeJsonResult=native_json_object_get(parsed.value,native_text_open("base",4));
    let options:NativeJsonResult=native_json_object_get(parsed.value,native_text_open("options",7));
    let b:NativeJsonResult=native_json_object_get(options.value,native_text_open("increment",9));
    let name:NativeJsonResult=native_json_object_get(parsed.value,native_text_open("label",5));
    let decoded:NativeJsonStringResult=native_json_string_copy(name.value,content,32);
    if !a.found || !b.found || decoded.status!=0 || decoded.length!=10
        || text[0]!=83 || text[9]!=172{return native_u32_error(11,2);}
    let first:u32=native_json_u32(a.value)?;let second:u32=native_json_u32(b.value)?;
    return native_u32_ok(first+second);
}

fn configured(map:*mut NativeTextMap)->NativeU32Result{
    defer{native_text_map_close(map,true);}
    let imported:u32=configure_json(map)?;
    if imported!=42{return native_u32_error(11,0);}
    native_text_map_set(map,"mode",4,"native",6)?;
    native_text_map_set_u32(map,"base",4,20)?;
    let source:NativePoolHandle=unsafe{native_pool_text_create(map.pool,"increment=22",12)};
    let field:NativePoolTextSplit=native_pool_text_split_once(source,"=",1);
    if !field.found{native_pool_release(source,true);return native_u32_error(11,4);}
    let inserted:NativeU32Result=native_text_map_set_views(map,field.before,field.after);
    native_pool_release(source,true);
    inserted?;
    native_text_map_set(map,"label",5,"Sotlas €",10)?;
    let old:NativePoolView=native_text_map_get(map,"base",4);
    native_text_map_set_u32(map,"base",4,21)?;
    native_text_map_set_u32(map,"increment",9,21)?;
    if native_pool_view_current(old){return native_u32_error(11,0);}
    native_text_map_remove(map,"mode",4,true)?;
    native_text_map_set(map,"mode",4,"ready",5)?;
    let mut cursor:NativeTextMapCursor=native_text_map_cursor(map);
    let mut count:u32=0;
    while true{
        let item:NativeTextMapItem=native_text_map_next(cursor);
        if !item.valid{return native_u32_error(11,1);}if item.done{break;}
        if !native_pool_view_current(item.key) || !native_pool_view_current(item.value){return native_u32_error(11,2);}
        count=count+1;cursor=item.next;
    }
    if count!=4{return native_u32_error(11,3);}
    return export_config(map);
}

pub fn main_entry()->u32{
    let mut bytes:[u8;320]=0;let data:*mut u8=unsafe{bytes as *mut u8};
    let mut metadata:[NativePoolSlot;10]=[NativePoolSlot{generation:0,revision:0,length:0,live:false};10];
    let slots:*mut NativePoolSlot=unsafe{metadata as *mut NativePoolSlot};
    let mut pool:NativePool=native_pool_empty();let p:*mut NativePool=unsafe{(&mut pool) as *mut NativePool};
    if !native_pool_open(p,data,320,slots,10,32){return 1;}
    let mut entries:[u64;28]=0;let table:*mut u64=unsafe{entries as *mut u64};
    let mut map:NativeTextMap=native_text_map_empty();let m:*mut NativeTextMap=unsafe{(&mut map) as *mut NativeTextMap};
    if !native_text_map_open(m,p,table,28,4){return 2;}
    let result:NativeU32Result=configured(m);
    if result.status!=0 || map.live || !native_pool_close(p){return 3;}
    return result.value;
}

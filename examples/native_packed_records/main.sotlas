module examples::native_packed_records;

// Ordinary RAM, not volatile hardware registers or an MMIO mapping.
@repr(C)
@packed
pub struct Packet {
    pub kind: u8;
    pub sequence: u64;
    pub length: u16;
    pub bytes: [u8; 3];
}

fn advance(mut packet: Packet) -> Packet {
    packet.sequence = packet.sequence + 2;
    return packet;
}

pub fn main_entry() -> u32 {
    if span_of::<Packet>() != 14 || align_of::<Packet>() != 1
        || field_offset!(Packet, sequence) != 1
        || field_offset!(Packet, length) != 9
        || field_offset!(Packet, bytes) != 11 { return 1; }
    let mut packets: [Packet; 2] = [Packet { kind: 7, sequence: 40, length: 3, bytes: [1, 2, 3] }; 2];
    packets[1] = advance(packets[0]);
    packets[1].bytes[2] = 9;
    let first: *mut Packet = unsafe { (&mut packets[0]) as *mut Packet };
    let second: *mut Packet = unsafe { (&mut packets[1]) as *mut Packet };
    let begin: usize = unsafe { first as usize };
    let next: usize = unsafe { second as usize };
    if next - begin != stride_of::<Packet>() || packets[0].sequence != 40
        || packets[0].bytes[2] != 3 || packets[1].kind != 7
        || packets[1].length != 3 || packets[1].bytes[2] != 9 { return 2; }
    return packets[1].sequence as u32;
}

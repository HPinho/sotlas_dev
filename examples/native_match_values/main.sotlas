module native_match_values;

enum ResultKind { Small = 1, Large = 2 }

struct Classification { pub kind:ResultKind; pub score:u32; }

enum Measurement { Missing, Reading(Classification,u32) }
enum Envelope { Missing, Data(Measurement) }
enum Samples { Missing, Values([u32;2]) }

fn sample_score(value:whisper Samples)->u32 {
    return match value { Samples::Values([first,last])=>first+last,Samples::Missing=>0 };
}

fn consume_samples(value:sole Samples)->u32 { return sample_score(value); }

fn sample_window()->u32 {
    let values:[u32;3]=[20,99,22];
    return match values { [first,..,last]=>first+last };
}

fn selected_samples(flag:bool)->u32 {
    let values:[u32;2]=match flag { true=>[20,22],false=>[0;2] };
    return match values { [first,last]=>first+last };
}

fn make_samples()->[u32;2] { return [20,22]; }
fn sum_samples(values:[u32;2])->u32 { return match values { [first,last]=>first+last }; }

fn envelope_score(value:Envelope)->u32 {
    return match value {
        Envelope::Data(Measurement::Reading(item,2)) if item.score>0 => item.score+2,
        Envelope::Data(Measurement::Missing) => 0,
        Envelope::Data(_) | Envelope::Missing => 0
    };
}

fn measure(value:u32)->Measurement {
    return Measurement::Reading(Classification{kind:ResultKind::Large,score:value},2);
}

fn measured_score(value:Measurement)->u32 {
    return match value {
        Measurement::Reading(item,bias) if item.score>0 => item.score+bias,
        Measurement::Reading(_,_) => 0,
        Measurement::Missing => 0
    };
}

fn select_owned(flag:bool,left:sole Classification,right:sole Classification)->sole Classification {
    return match flag { true=>{left},false=>{right} };
}

fn score(value: u8) -> u32 {
    return match value {
        0..=9 if value == 0 => 0,
        0..=9 => 20,
        10..=255 => 22
    };
}

fn adjustment(kind: ResultKind) -> u32 {
    return match kind {
        ResultKind::Small => 0,
        ResultKind::Large => 1
    };
}

fn classify(value:i16)->Classification {
    return match value {
        ..0 => Classification{kind:ResultKind::Small,score:0},
        n if n<10 => {
            let score:u32=20;
            Classification{kind:ResultKind::Small,score:score}
        },
        n => Classification{kind:ResultKind::Large,score:22}
    };
}

fn category(large:bool)->ResultKind {
    return match large { true=>ResultKind::Large, false=>ResultKind::Small };
}

fn named_score(value:Classification)->u32 {
    return match value {
        Classification{score:n,kind:ResultKind::Large}=>n,
        Classification{kind:ResultKind::Small,..}=>0
    };
}

fn fraction_score(value:f32)->u32 {
    return match value { 0.0=>0,1.0..=2.0=>2,_=>0 };
}

fn read_owned_samples(values:direct [u32;2])->u32 { return values[0]+values[1]; }
fn move_owned_samples(values:sole [u32;2])->sole [u32;2] { return values; }
fn replace_samples(mut values:[u32;2])->u32 {
    values=match true{true=>[20,22],false=>[0;2]};
    values=[values[1],values[0]];
    return values[0]+values[1];
}

pub fn main_entry() -> u32 {
    let selected = match true { true => 5, false => 0 };
    let total: u32 = score(selected as u8) + score(10);
    let left:Classification=classify(5);
    let right:Classification=classify(10);
    if left.score+right.score!=42 || adjustment(category(false))!=0 { return 1; }
    if measured_score(measure(40))!=42 { return 2; }
    if envelope_score(Envelope::Data(measure(40)))!=42 { return 4; }
    let first:sole Classification=Classification{kind:ResultKind::Large,score:42};
    let second:sole Classification=Classification{kind:ResultKind::Small,score:0};
    let owned:sole Classification=select_owned(true,first,second);
    if owned.score!=42 { return 3; }
    if named_score(Classification{kind:ResultKind::Large,score:40})+fraction_score(1.5)!=42 { return 5; }
    let samples:sole Samples=Samples::Values([21;2]);
    if sample_score(samples)!=42 || consume_samples(samples)!=42 { return 6; }
    if sample_window()!=42 { return 7; }
    if selected_samples(true)!=42 { return 8; }
    if sum_samples(make_samples())!=42 { return 9; }
    let owned_array:sole [u32;2]=[20,22];
    if read_owned_samples(owned_array)!=42 { return 10; }
    let moved_array:sole [u32;2]=move_owned_samples(owned_array);
    if moved_array[0]+moved_array[1]!=42 { return 11; }
    if replace_samples([0;2])!=42 { return 12; }
    return total + adjustment(ResultKind::Small);
}

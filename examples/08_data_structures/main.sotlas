module examples::data_structures;

import foundation::hashmap::*;
import core::iter::*;

static mut map_entries: [HashEntry; 16] = 0;

pub fn main() -> i32 {
    let mut map: HashMapU64 = 0;
    unsafe {
    map = hashmap_new(map_entries as *mut HashEntry, 16);
    let mutable_map: *mut HashMapU64 = (&mut map) as *mut HashMapU64;
    let readonly_map: *const HashMapU64 = (&map) as *const HashMapU64;
    if !hashmap_insert(mutable_map, 100, 1000) { return 1; }
    if !hashmap_insert(mutable_map, 200, 2000) { return 2; }
    if !hashmap_insert(mutable_map, 300, 3000) { return 3; }

    let found: OptionU64 = hashmap_get(readonly_map, 200);
    if !found.has_value || found.value != 2000 { return 4; }
    if hashmap_len(readonly_map) != 3 { return 5; }

    let mut numbers: [u32; 4] = 0;
    numbers[0] = 10;
    numbers[1] = 20;
    numbers[2] = 30;
    numbers[3] = 40;

    let total: u32 = slice_fold_u32(numbers as *const u32, 4, 0, false);
    if total != 100 { return 6; }
    if !slice_contains_u32(numbers as *const u32, 4, 30) { return 7; }
    return 0;
    }
}

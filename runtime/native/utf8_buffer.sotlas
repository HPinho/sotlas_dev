module sotlas::runtime::utf8_buffer;
import sotlas::runtime::results::*;
import sotlas::runtime::text::*;
import sotlas::runtime::unicode::*;

// Caller-backed storage. Descriptor and backing must be disjoint and remain
// accessible for every call. No allocation, reallocation or implicit terminator.
pub struct NativeUtf8Buffer{pub data:*mut u8;pub capacity:usize;pub length:usize;pub valid:bool;}

pub fn native_utf8_buffer_open(data:*mut u8,capacity:usize)->NativeUtf8Buffer{
    let address:usize=unsafe{data as usize};
    let valid:bool=(data!=null || capacity==0) && capacity<=4294967295
        && capacity<=18446744073709551615-address;
    return NativeUtf8Buffer{data:data,capacity:capacity,length:0,valid:valid};
}

pub fn native_utf8_buffer_shape(buffer:*const NativeUtf8Buffer)->bool{
    if buffer==null{return false;}
    unsafe{return buffer.valid && buffer.length<=buffer.capacity
        && native_utf8_buffer_open(buffer.data,buffer.capacity).valid;}
}

pub fn native_utf8_buffer_check(buffer:*const NativeUtf8Buffer)->NativeU32Result{
    if !native_utf8_buffer_shape(buffer){return native_u32_error(7,0);}
    unsafe{
        let mut offset:usize=0;let mut count:u32=0;
        while offset<buffer.length{
            let scalar:NativeUtf8Scalar=native_utf8_scalar(buffer.data,buffer.length,offset);
            if !scalar.valid{return native_u32_error(8,offset);}
            offset=scalar.next;count=count+1;
        }
        return native_u32_ok(count);
    }
}

pub fn native_utf8_buffer_view(buffer:*const NativeUtf8Buffer)->NativeByteSlice{
    if native_utf8_buffer_check(buffer).status!=0{return native_text_invalid();}
    unsafe{return native_text_open(buffer.data,buffer.length);}
}

// Validate complete source and destination before writing, then copy in memmove
// order. The source may alias existing buffer bytes. Concurrent mutation is not
// supported, and raw ranges must refer to accessible caller-owned storage.
pub fn native_utf8_buffer_append(mut buffer:*mut NativeUtf8Buffer,data:*const u8,length:usize)->NativeU32Result{
    let checked:NativeU32Result=native_utf8_buffer_check(buffer);if checked.status!=0{return checked;}
    if data==null && length!=0{return native_u32_error(1,0);}
    if length>18446744073709551615-(unsafe{data as usize}){return native_u32_error(7,0);}
    unsafe{
        if length>buffer.capacity-buffer.length{return native_u32_error(7,buffer.length);}
        let mut offset:usize=0;
        while offset<length{let scalar:NativeUtf8Scalar=native_utf8_scalar(data,length,offset);
            if !scalar.valid{return native_u32_error(8,offset);}offset=scalar.next;}
        if length==0{return native_u32_ok(buffer.length as u32);}
        let destination:*mut u8=buffer.data+buffer.length;
        let source_address:usize=data as usize;let target_address:usize=destination as usize;
        let mut i:usize=0;
        if target_address>source_address && target_address-source_address<length{
            i=length;while i!=0{i=i-1;*(destination+i)=*(data+i);}
        }else{while i<length{*(destination+i)=*(data+i);i=i+1;}}
        buffer.length=buffer.length+length;return native_u32_ok(buffer.length as u32);
    }
}

pub fn native_utf8_buffer_append_slice(buffer:*mut NativeUtf8Buffer,value:NativeByteSlice)->NativeU32Result{
    if !native_text_valid(value){return native_u32_error(7,0);}
    return native_utf8_buffer_append(buffer,value.data,value.length);
}

pub fn native_utf8_buffer_append_u32(buffer:*mut NativeUtf8Buffer,value:u32)->NativeU32Result{
    let mut digits:[u8;10]=0;let address:*mut u8=unsafe{digits as *mut u8};
    let count:u32=native_format_u32(value,address,10)?;
    return native_utf8_buffer_append(buffer,address,count as usize);
}

pub fn native_utf8_buffer_append_scalar(buffer:*mut NativeUtf8Buffer,value:u32)->NativeU32Result{
    if value>1114111 || (value>=55296 && value<=57343){return native_u32_error(8,0);}
    let mut bytes:[u8;4]=0;let mut length:usize=1;
    if value<128{bytes[0]=value as u8;}
    else if value<2048{length=2;bytes[0]=(192+(value>>6)) as u8;bytes[1]=(128+(value&63)) as u8;}
    else if value<65536{length=3;bytes[0]=(224+(value>>12)) as u8;
        bytes[1]=(128+((value>>6)&63)) as u8;bytes[2]=(128+(value&63)) as u8;}
    else{length=4;bytes[0]=(240+(value>>18)) as u8;bytes[1]=(128+((value>>12)&63)) as u8;
        bytes[2]=(128+((value>>6)&63)) as u8;bytes[3]=(128+(value&63)) as u8;}
    return native_utf8_buffer_append(buffer,unsafe{bytes as *const u8},length);
}

// Replace a byte range at scalar boundaries. Source storage must not overlap
// the destination backing: reject aliasing before shifting or writing bytes.
pub fn native_utf8_buffer_replace(mut buffer:*mut NativeUtf8Buffer,start:usize,end:usize,
    data:*const u8,length:usize)->NativeU32Result{
    let checked:NativeU32Result=native_utf8_buffer_check(buffer);if checked.status!=0{return checked;}
    unsafe{
        if start>end || end>buffer.length{return native_u32_error(7,start);}
        if start<buffer.length && *(buffer.data+start)>=128 && *(buffer.data+start)<=191{return native_u32_error(8,start);}
        if end<buffer.length && *(buffer.data+end)>=128 && *(buffer.data+end)<=191{return native_u32_error(8,end);}
        if data==null && length!=0{return native_u32_error(1,0);}
        if length>18446744073709551615-(data as usize){return native_u32_error(7,0);}
        let retained:usize=buffer.length-(end-start);
        if length>buffer.capacity-retained{return native_u32_error(7,start);}
        if length!=0{
            let source:usize=data as usize;let base:usize=buffer.data as usize;
            if (source>=base && source-base<buffer.capacity) || (base>source && base-source<length){return native_u32_error(7,start);}
        }
        let mut i:usize=0;
        while i<length{let scalar:NativeUtf8Scalar=native_utf8_scalar(data,length,i);
            if !scalar.valid{return native_u32_error(8,i);}i=scalar.next;}
        let tail:usize=buffer.length-end;let destination:usize=start+length;
        if destination>end{
            i=tail;while i!=0{i=i-1;*(buffer.data+destination+i)=*(buffer.data+end+i);}
        }else{ i=0;while i<tail{*(buffer.data+destination+i)=*(buffer.data+end+i);i=i+1;} }
        i=0;while i<length{*(buffer.data+start+i)=*(data+i);i=i+1;}
        buffer.length=retained+length;return native_u32_ok(buffer.length as u32);
    }
}

pub fn native_utf8_buffer_truncate(mut buffer:*mut NativeUtf8Buffer,length:usize)->NativeU32Result{
    let checked:NativeU32Result=native_utf8_buffer_check(buffer);if checked.status!=0{return checked;}
    unsafe{
        if length>buffer.length{return native_u32_error(7,length);}
        if length<buffer.length && *(buffer.data+length)>=128 && *(buffer.data+length)<=191{return native_u32_error(8,length);}
        buffer.length=length;return native_u32_ok(length as u32);
    }
}

// Reset does not read possibly malformed content. Wipe clears used bytes before
// resetting; neither operation clears unused backing or revokes borrowed views.
pub fn native_utf8_buffer_reset(mut buffer:*mut NativeUtf8Buffer,wipe:bool)->NativeU32Result{
    if !native_utf8_buffer_shape(buffer){return native_u32_error(7,0);}
    unsafe{
        if wipe{let mut i:usize=0;while i<buffer.length{*(buffer.data+i)=0;i=i+1;}}
        buffer.length=0;return native_u32_ok(0);
    }
}

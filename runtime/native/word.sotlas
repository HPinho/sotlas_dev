module sotlas::runtime::word;

// Portable word operations lowered through the owned scalar backend. These
// do not promise dedicated rotate/popcount machine instructions or CPU flags.
pub fn native_word_rotate_left(value: u64, count: u32) -> u64 {
    let shift: u64=(count & 63) as u64;
    if shift == 0 { return value; }
    return (value << shift) | (value >> (64-shift));
}

pub fn native_word_rotate_right(value: u64, count: u32) -> u64 {
    let shift: u64=(count & 63) as u64;
    if shift == 0 { return value; }
    return (value >> shift) | (value << (64-shift));
}

pub fn native_word_swap_bytes(value: u64) -> u64 {
    let mut result: u64=0;let mut index: u32=0;
    while index < 8 {
        let shift: u64=(index as u64)*8;
        result=(result << 8) | ((value >> shift) & 255);index=index+1;
    }
    return result;
}

pub fn native_word_popcount(value: u64) -> u32 {
    let mut bits: u64=value;let mut count: u32=0;
    while bits != 0 { bits=bits & (bits-1);count=count+1; }
    return count;
}

pub fn native_word_leading_zeros(value: u64) -> u32 {
    if value == 0 { return 64; }
    let mut mask: u64=9223372036854775808;let mut count: u32=0;
    while (value & mask) == 0 { count=count+1;mask=mask >> 1; }return count;
}

pub fn native_word_trailing_zeros(value: u64) -> u32 {
    if value == 0 { return 64; }
    let mut bits: u64=value;let mut count: u32=0;
    while (bits & 1) == 0 { count=count+1;bits=bits >> 1; }return count;
}

pub fn native_word_reverse_bits(value: u64) -> u64 {
    let mut bits: u64=value;let mut result: u64=0;let mut count: u32=0;
    while count < 64 { result=(result << 1) | (bits & 1);bits=bits >> 1;count=count+1; }return result;
}

pub fn native_word_extract(value: u64, start: u32, width: u32, output: *mut u64) -> bool {
    if output == null || start > 64 || width > 64-start { return false; }
    if width == 0 { unsafe{*output=0;}return true; }
    let mut mask: u64=18446744073709551615;
    if width < 64 { mask=((1 as u64) << (width as u64))-1; }
    unsafe{*output=(value >> (start as u64)) & mask;}return true;
}

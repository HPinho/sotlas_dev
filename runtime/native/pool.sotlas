module sotlas::runtime::pool;
import sotlas::runtime::managed::*;

// x86-64 caller-owned storage. Control, metadata and bytes must remain accessible
// and disjoint. Handles are allocation identities, not independent ARC claims.
pub struct NativePoolSlot{pub generation:u64;pub revision:u64;pub length:usize;pub live:bool;}
pub struct NativePool{pub data:*mut u8;pub capacity:usize;pub slots:*mut NativePoolSlot;
    pub count:u32;pub block_size:usize;pub epoch:u64;pub live:bool;}
pub struct NativePoolHandle{pub pool:*mut NativePool;pub epoch:u64;pub generation:u64;pub index:u32;}
pub struct NativePoolView{pub handle:NativePoolHandle;pub revision:u64;pub offset:usize;pub length:usize;pub valid:bool;}

pub fn native_pool_slot_empty()->NativePoolSlot{
    return NativePoolSlot{generation:1,revision:1,length:0,live:false};
}
pub fn native_pool_empty()->NativePool{
    return NativePool{data:null,capacity:0,slots:null,count:0,block_size:0,epoch:1,live:false};
}
pub fn native_pool_invalid()->NativePoolHandle{
    return NativePoolHandle{pool:null,epoch:0,generation:0,index:0};
}
pub fn native_pool_range(address:usize,length:usize)->bool{
    return (address!=0 || length==0) && length<=18446744073709551615-address;
}
pub fn native_pool_overlap(a:usize,n:usize,b:usize,m:usize)->bool{
    if n==0 || m==0{return false;}
    if !native_pool_range(a,n) || !native_pool_range(b,m){return true;}
    if a>=b{return a-b<m;}return b-a<n;
}
pub fn native_pool_layout(pool:*const NativePool,data:*mut u8,capacity:usize,
    slots:*mut NativePoolSlot,count:u32,block_size:usize)->bool{
    let control:usize=unsafe{pool as usize};let bytes:usize=unsafe{data as usize};
    let metadata:usize=unsafe{slots as usize};let size:usize=(count as usize)*32;
    if count==0 || count>4096 || block_size==0 || block_size>4294967295
        || !native_pool_range(control,56) || control%8!=0
        || !native_pool_range(bytes,capacity) || !native_pool_range(metadata,size) || metadata%8!=0{return false;}
    if (count as usize)*block_size>capacity{return false;}
    return !native_pool_overlap(control,56,bytes,capacity)
        && !native_pool_overlap(control,56,metadata,size)
        && !native_pool_overlap(bytes,capacity,metadata,size);
}
pub fn native_pool_open(mut pool:*mut NativePool,data:*mut u8,capacity:usize,
    mut slots:*mut NativePoolSlot,count:u32,block_size:usize)->bool{
    if pool==null || !native_pool_layout(pool,data,capacity,slots,count,block_size){return false;}
    unsafe{
        if pool.live || pool.epoch==0 || pool.epoch==18446744073709551615{return false;}
        let mut i:u32=0;while i<count{*(slots+(i as usize))=native_pool_slot_empty();i=i+1;}
        pool.data=data;pool.capacity=capacity;pool.slots=slots;pool.count=count;
        pool.block_size=block_size;pool.epoch=pool.epoch+1;pool.live=true;return true;
    }
}
pub fn native_pool_shape(pool:*const NativePool)->bool{
    if pool==null{return false;}
    unsafe{return pool.live && pool.epoch!=0 && native_pool_layout(pool,pool.data,pool.capacity,pool.slots,pool.count,pool.block_size);}
}
// Scalar backing avoids requiring a general record-array address conversion in
// the native frontend. Four aligned u64 words are reserved for each slot.
pub fn native_pool_open_words(pool:*mut NativePool,data:*mut u8,capacity:usize,
    words:*mut u64,word_capacity:usize,count:u32,block_size:usize)->bool{
    if count==0 || count>4096 || word_capacity>2305843009213693951
        || (count as usize)*4>word_capacity{return false;}
    let address:usize=unsafe{words as usize};
    if !native_pool_range(address,word_capacity*8){return false;}
    return native_pool_open(pool,data,capacity,unsafe{address as *mut NativePoolSlot},count,block_size);
}
pub fn native_pool_current(handle:NativePoolHandle)->bool{
    if handle.pool==null{return false;}
    unsafe{
        // Reject epoch changes before consulting metadata or backing memory.
        if !handle.pool.live || handle.epoch!=handle.pool.epoch || !native_pool_shape(handle.pool)
            || handle.index>=handle.pool.count{return false;}
        let slot:*const NativePoolSlot=handle.pool.slots+(handle.index as usize);
        return slot.live && slot.generation==handle.generation && slot.generation!=0
            && slot.revision!=0 && slot.length<=handle.pool.block_size;
    }
}
pub fn native_pool_allocate(mut pool:*mut NativePool,length:usize)->NativePoolHandle{
    if !native_pool_shape(pool){return native_pool_invalid();}
    unsafe{
        if length>pool.block_size{return native_pool_invalid();}
        let mut i:u32=0;while i<pool.count{
            let mut slot:*mut NativePoolSlot=pool.slots+(i as usize);
            if !slot.live && slot.generation!=0 && slot.generation<18446744073709551615{
                let mut j:usize=0;let mut data:*mut u8=pool.data+(i as usize)*pool.block_size;
                while j<pool.block_size{*(data+j)=0;j=j+1;}
                slot.generation=slot.generation+1;slot.revision=1;slot.length=length;slot.live=true;
                return NativePoolHandle{pool:pool,epoch:pool.epoch,generation:slot.generation,index:i};
            }i=i+1;
        }return native_pool_invalid();
    }
}
pub fn native_pool_length(handle:NativePoolHandle)->usize{
    if !native_pool_current(handle){return 0;}
    unsafe{return (*(handle.pool.slots+(handle.index as usize))).length;}
}
pub fn native_pool_release(handle:NativePoolHandle,wipe:bool)->bool{
    if !native_pool_current(handle){return false;}
    unsafe{
        let mut slot:*mut NativePoolSlot=handle.pool.slots+(handle.index as usize);
        if wipe{let mut data:*mut u8=handle.pool.data+(handle.index as usize)*handle.pool.block_size;
            let mut i:usize=0;while i<handle.pool.block_size{*(data+i)=0;i=i+1;}}
        slot.live=false;slot.length=0;return true;
    }
}
// Raw source ranges must be accessible and cannot overlap control or metadata.
pub fn native_pool_source(pool:*const NativePool,data:*const u8,length:usize)->bool{
    if !native_pool_shape(pool){return false;}
    let address:usize=unsafe{data as usize};if !native_pool_range(address,length){return false;}
    unsafe{return !native_pool_overlap(address,length,pool as usize,56)
        && !native_pool_overlap(address,length,pool.slots as usize,(pool.count as usize)*32);}
}
pub fn native_pool_write(handle:NativePoolHandle,offset:usize,data:*const u8,length:usize)->bool{
    if !native_pool_current(handle) || !native_pool_source(handle.pool,data,length){return false;}
    unsafe{
        let mut slot:*mut NativePoolSlot=handle.pool.slots+(handle.index as usize);
        if offset>slot.length || length>slot.length-offset{return false;}
        if length==0{return true;}if slot.revision==18446744073709551615{return false;}
        let destination:*mut u8=handle.pool.data+(handle.index as usize)*handle.pool.block_size+offset;
        if !native_memory_move(destination,data,length){return false;}
        slot.revision=slot.revision+1;return true;
    }
}
pub fn native_pool_resize(handle:NativePoolHandle,length:usize,wipe:bool)->bool{
    if !native_pool_current(handle){return false;}
    unsafe{
        let mut slot:*mut NativePoolSlot=handle.pool.slots+(handle.index as usize);
        if length>handle.pool.block_size{return false;}if length==slot.length{return true;}
        if slot.revision==18446744073709551615{return false;}
        let mut data:*mut u8=handle.pool.data+(handle.index as usize)*handle.pool.block_size;
        let mut i:usize=slot.length;while i<length{*(data+i)=0;i=i+1;}
        if wipe{i=length;while i<slot.length{*(data+i)=0;i=i+1;}}
        slot.length=length;slot.revision=slot.revision+1;return true;
    }
}
pub fn native_pool_view(handle:NativePoolHandle,offset:usize,length:usize)->NativePoolView{
    let mut view:NativePoolView=NativePoolView{handle:handle,revision:0,offset:offset,length:length,valid:false};
    if !native_pool_current(handle){return view;}
    unsafe{let slot:*const NativePoolSlot=handle.pool.slots+(handle.index as usize);
        if offset>slot.length || length>slot.length-offset{return view;}
        view.revision=slot.revision;view.valid=true;return view;}
}
pub fn native_pool_view_current(view:NativePoolView)->bool{
    if !view.valid || !native_pool_current(view.handle){return false;}
    unsafe{let slot:*const NativePoolSlot=view.handle.pool.slots+(view.handle.index as usize);
        return slot.revision==view.revision && view.offset<=slot.length && view.length<=slot.length-view.offset;}
}
pub fn native_pool_read(view:NativePoolView,destination:*mut u8,capacity:usize)->bool{
    if !native_pool_view_current(view) || capacity<view.length
        || !native_pool_source(view.handle.pool,destination,view.length){return false;}
    unsafe{
        let pool:*const NativePool=view.handle.pool;
        if native_pool_overlap(destination as usize,view.length,pool.data as usize,pool.capacity){return false;}
        return native_memory_move(destination,pool.data+(view.handle.index as usize)*pool.block_size+view.offset,view.length);
    }
}
pub fn native_pool_clone(handle:NativePoolHandle)->NativePoolHandle{
    if !native_pool_current(handle){return native_pool_invalid();}
    let length:usize=native_pool_length(handle);let copy:NativePoolHandle=native_pool_allocate(handle.pool,length);
    if !native_pool_current(copy){return copy;}
    unsafe{native_pool_write(copy,0,handle.pool.data+(handle.index as usize)*handle.pool.block_size,length);}
    return copy;
}
pub fn native_pool_reset(mut pool:*mut NativePool,wipe:bool)->bool{
    if !native_pool_shape(pool){return false;}
    unsafe{
        if pool.epoch==18446744073709551615{return false;}
        if wipe{let mut i:usize=0;while i<pool.capacity{*(pool.data+i)=0;i=i+1;}}
        let mut i:u32=0;while i<pool.count{*(pool.slots+(i as usize))=native_pool_slot_empty();i=i+1;}
        pool.epoch=pool.epoch+1;return true;
    }
}
pub fn native_pool_close(mut pool:*mut NativePool)->bool{
    if !native_pool_shape(pool){return false;}
    unsafe{
        let mut i:u32=0;while i<pool.count{if (*(pool.slots+(i as usize))).live{return false;}i=i+1;}
        pool.live=false;return true;
    }
}

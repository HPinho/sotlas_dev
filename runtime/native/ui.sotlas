module sotlas::runtime::ui;
import sotlas::runtime::unicode::*;

// Borrowed UTF-8 labels and caller-backed items remain live through rendering.
// This first declarative profile is bounded to 64 items and 4096 layout units.
pub struct UiRect { pub x:i32; pub y:i32; pub width:u32; pub height:u32; pub valid:bool; }
pub struct UiLayout { pub bounds:UiRect; pub gap:u32; pub cursor:u32; pub horizontal:bool; }
pub struct UiItem { pub id:u32; pub kind:u32; pub bounds:UiRect; pub label:*const u8; pub length:usize; pub caret:usize; }
pub struct UiView { pub items:*mut UiItem; pub count:usize; pub capacity:usize; pub focus:u32; pub error:u32; }

pub fn ui_rect(x:i32,y:i32,width:u32,height:u32) -> UiRect {
    let mut valid:bool=x >= 0 && y >= 0 && width > 0 && height > 0 && width <= 4096 && height <= 4096;
    if valid { valid=(x as u32) <= 4096-width && (y as u32) <= 4096-height; }
    return UiRect{x:x,y:y,width:width,height:height,valid:valid};
}
pub fn ui_row(bounds:UiRect,gap:u32) -> UiLayout {
    return UiLayout{bounds:bounds,gap:gap,cursor:0,horizontal:true};
}
pub fn ui_column(bounds:UiRect,gap:u32) -> UiLayout {
    return UiLayout{bounds:bounds,gap:gap,cursor:0,horizontal:false};
}
// Equal grid tracks distribute leftover units from the leading edge. Geometry
// is checked before subtraction/division; no storage or mutable cursor is used.
pub fn ui_grid_cell(bounds:UiRect,columns:u32,rows:u32,gap:u32,column:u32,row:u32) -> UiRect {
    let invalid:UiRect=ui_rect(0,0,0,0);
    let checked:UiRect=ui_rect(bounds.x,bounds.y,bounds.width,bounds.height);
    if !bounds.valid || !checked.valid || columns == 0 || columns > 64 || rows == 0 || rows > 64
        || column >= columns || row >= rows || gap > 4096 { return invalid; }
    if columns > 1 { if gap > bounds.width/(columns-1) { return invalid; } }
    if rows > 1 { if gap > bounds.height/(rows-1) { return invalid; } }
    let width:u32=bounds.width-gap*(columns-1);let height:u32=bounds.height-gap*(rows-1);
    let mut cell_width:u32=width/columns;let mut cell_height:u32=height/rows;
    if cell_width == 0 || cell_height == 0 { return invalid; }
    let extra_x:u32=width%columns;let extra_y:u32=height%rows;
    let mut leading_x:u32=extra_x;let mut leading_y:u32=extra_y;
    if column < extra_x { leading_x=column; }
    if row < extra_y { leading_y=row; }
    let x:u32=(cell_width+gap)*column+leading_x;let y:u32=(cell_height+gap)*row+leading_y;
    if column < extra_x { cell_width=cell_width+1; }
    if row < extra_y { cell_height=cell_height+1; }
    return ui_rect(bounds.x+x as i32,bounds.y+y as i32,cell_width,cell_height);
}
pub fn ui_cell(mut layout:*mut UiLayout, extent:u32) -> UiRect {
    if layout == null { return ui_rect(0,0,0,0); }
    unsafe {
        let bounds:UiRect=layout.bounds;
        let mut available:u32=bounds.height;
        if layout.horizontal { available=bounds.width; }
        let checked:UiRect=ui_rect(bounds.x,bounds.y,bounds.width,bounds.height);
        if !bounds.valid || !checked.valid || extent == 0 || layout.cursor > available || extent > available-layout.cursor { return ui_rect(0,0,0,0); }
        let mut result:UiRect=ui_rect(bounds.x,bounds.y,bounds.width,extent);
        if layout.horizontal { result=ui_rect(bounds.x+layout.cursor as i32,bounds.y,extent,bounds.height); }
        else { result=ui_rect(bounds.x,bounds.y+layout.cursor as i32,bounds.width,extent); }
        layout.cursor=layout.cursor+extent;
        if layout.gap <= available-layout.cursor { layout.cursor=layout.cursor+layout.gap; }
        else { layout.cursor=available; }
        return result;
    }
}
pub fn ui_view(items:*mut UiItem,capacity:usize,focus:u32) -> UiView {
    let mut error:u32=0;
    if items == null || capacity == 0 || capacity > 64 { error=1; }
    return UiView{items:items,count:0,capacity:capacity,focus:focus,error:error};
}
pub fn ui_label_valid(label:*const u8,length:usize) -> bool {
    if label == null || length > 128 || length > 18446744073709551615-(unsafe { label as usize }) { return false; }
    let mut offset:usize=0;
    while offset < length {
        let value:NativeUtf8Scalar=native_utf8_scalar(label,length,offset);
        if !value.valid || value.scalar < 32 || (value.scalar >= 127 && value.scalar <= 159) { return false; }
        offset=value.next;
    }
    return true;
}
pub fn ui_caret_valid(label:*const u8,length:usize,caret:usize) -> bool {
    if !ui_label_valid(label,length) || caret > length { return false; }
    if caret == length { return true; }
    let byte:u8=unsafe { *(label+caret) };
    return byte < 128 || byte >= 192;
}

// Pointer shape checks do not prove accessibility. Caller storage must remain
// live, correctly typed and exclusive to the UI thread for the entire call.
fn ui_range(address:usize,length:usize) -> bool {
    return address != 0 && length <= 18446744073709551615-address;
}
fn ui_separate(first:usize,length:usize,second:usize,count:usize) -> bool {
    if !ui_range(first,length) || !ui_range(second,count) { return false; }
    return length == 0 || count == 0 || first+length <= second || second+count <= first;
}
pub fn ui_view_valid(view:*const UiView) -> bool {
    if view == null { return false; }
    let current:UiView=unsafe { *view };
    let address:usize=unsafe { current.items as usize };
    if current.error != 0 || current.capacity == 0 || current.capacity > 64 || current.count > current.capacity
        || address%align_of::<UiItem>() != 0 || !ui_range(address,current.capacity*stride_of::<UiItem>()) { return false; }
    let mut index:usize=0;
    while index < current.count {
        let item:UiItem=unsafe { *(current.items+index) };
        let checked:UiRect=ui_rect(item.bounds.x,item.bounds.y,item.bounds.width,item.bounds.height);
        if item.id == 0 || item.kind < 1 || item.kind > 3 || !item.bounds.valid || !checked.valid
            || !ui_label_valid(item.label,item.length) { return false; }
        if item.kind == 3 { if !ui_caret_valid(item.label,item.length,item.caret) { return false; } }
        else { if item.caret != 0 { return false; } }
        let mut previous:usize=0;
        while previous < index {
            if unsafe { (*(current.items+previous)).id } == item.id { return false; }
            previous=previous+1;
        }
        index=index+1;
    }
    return true;
}

// Validate everything before writing either destination buffer or metadata.
// On success labels belong to the supplied snapshot storage, not the model.
// All source ranges must be disjoint from all destination ranges. Source data
// must stay stable during validation/copy; snapshots are not a concurrency API.
pub fn ui_snapshot(source:*const UiView,destination:*mut UiView,items:*mut UiItem,capacity:usize,labels:*mut u8,label_capacity:usize) -> bool {
    if source == null || destination == null || capacity == 0 || capacity > 64 || label_capacity == 0 || label_capacity > 8192 { return false; }
    let from:usize=unsafe { source as usize }; let to:usize=unsafe { destination as usize };
    let item_address:usize=unsafe { items as usize }; let text_address:usize=unsafe { labels as usize };
    let view_size:usize=span_of::<UiView>(); let item_size:usize=capacity*stride_of::<UiItem>();
    if from%align_of::<UiView>() != 0 || to%align_of::<UiView>() != 0 || item_address%align_of::<UiItem>() != 0
        || !ui_separate(to,view_size,item_address,item_size) || !ui_separate(to,view_size,text_address,label_capacity)
        || !ui_separate(item_address,item_size,text_address,label_capacity)
        || !ui_separate(from,view_size,to,view_size) || !ui_separate(from,view_size,item_address,item_size)
        || !ui_separate(from,view_size,text_address,label_capacity) { return false; }
    if !ui_view_valid(source) { return false; }
    let current:UiView=unsafe { *source };
    let input:usize=unsafe { current.items as usize };let input_size:usize=current.capacity*stride_of::<UiItem>();
    if current.count > capacity || !ui_separate(input,input_size,to,view_size)
        || !ui_separate(input,input_size,item_address,item_size) || !ui_separate(input,input_size,text_address,label_capacity) { return false; }
    let mut index:usize=0;let mut needed:usize=0;
    while index < current.count {
        let item:UiItem=unsafe { *(current.items+index) };let label:usize=unsafe { item.label as usize };
        if item.length > label_capacity-needed || !ui_separate(label,item.length,to,view_size)
            || !ui_separate(label,item.length,item_address,item_size) || !ui_separate(label,item.length,text_address,label_capacity) { return false; }
        needed=needed+item.length;index=index+1;
    }
    index=0;let mut offset:usize=0;
    while index < current.count {
        let mut item:UiItem=unsafe { *(current.items+index) };let mut byte:usize=0;
        while byte < item.length { unsafe { *(labels+offset+byte)=*(item.label+byte); }byte=byte+1; }
        item.label=unsafe { (labels+offset) as *const u8 };
        unsafe { *(items+index)=item; }offset=offset+item.length;index=index+1;
    }
    unsafe { *destination=UiView{items:items,count:current.count,capacity:capacity,focus:current.focus,error:0}; }
    return true;
}
fn ui_add(mut view:*mut UiView,id:u32,kind:u32,bounds:UiRect,label:*const u8,length:usize) -> bool {
    if view == null { return false; }
    unsafe {
        if view.error != 0 { return false; }
        if view.items == null || view.count >= view.capacity || view.capacity > 64 { view.error=1; return false; }
        let checked:UiRect=ui_rect(bounds.x,bounds.y,bounds.width,bounds.height);
        if id == 0 || !bounds.valid || !checked.valid || label == null || length > 128 { view.error=2; return false; }
        let mut index:usize=0;
        while index < view.count {
            if (*(view.items+index)).id == id { view.error=3; return false; }
            index=index+1;
        }
        if !ui_label_valid(label,length) { view.error=4; return false; }
        let mut caret:usize=0;if kind == 3 { caret=length; }
        *(view.items+view.count)=UiItem{id:id,kind:kind,bounds:bounds,label:label,length:length,caret:caret};
        view.count=view.count+1;
    }
    return true;
}
pub fn ui_text(view:*mut UiView,id:u32,bounds:UiRect,label:*const u8,length:usize) -> bool { return ui_add(view,id,1,bounds,label,length); }
pub fn ui_button(view:*mut UiView,id:u32,bounds:UiRect,label:*const u8,length:usize) -> bool { return ui_add(view,id,2,bounds,label,length); }
pub fn ui_text_field(view:*mut UiView,id:u32,bounds:UiRect,label:*const u8,length:usize) -> bool { return ui_add(view,id,3,bounds,label,length); }
pub fn ui_text_field_at(mut view:*mut UiView,id:u32,bounds:UiRect,label:*const u8,length:usize,caret:usize) -> bool {
    if view == null { return false; }
    if !ui_caret_valid(label,length,caret) {
        unsafe { if view.error == 0 { view.error=5; } }return false;
    }
    if !ui_add(view,id,3,bounds,label,length) { return false; }
    unsafe { let mut item:*mut UiItem=view.items+view.count-1;item.caret=caret; }
    return true;
}
pub fn ui_click(mut view:*mut UiView,x:i32,y:i32) -> u32 {
    if view == null { return 0; }
    unsafe {
        if !ui_view_valid(unsafe { view as *const UiView }) { return 0; }
        let mut index:usize=view.count;
        while index != 0 {
            index=index-1;
            let item:UiItem=*(view.items+index);
            let bounds:UiRect=item.bounds;
            if item.kind != 1 && x >= bounds.x && y >= bounds.y && x-bounds.x < bounds.width as i32 && y-bounds.y < bounds.height as i32 {
                view.focus=item.id;
                if item.kind == 2 { return item.id; }
                return 0;
            }
        }
    }
    return 0;
}
pub fn ui_key(mut view:*mut UiView,key:u32) -> u32 {
    if view == null { return 0; }
    unsafe {
        if !ui_view_valid(unsafe { view as *const UiView }) { return 0; }
        let mut index:usize=0; let mut first:u32=0; let mut next:bool=false;
        while index < view.count {
            let item:UiItem=*(view.items+index);
            if item.kind != 1 {
                if first == 0 { first=item.id; }
                if key == 9 && next { view.focus=item.id; return 0; }
                if item.id == view.focus {
                    next=true;
                    if item.kind == 2 && (key == 13 || key == 32) { return item.id; }
                }
            }
            index=index+1;
        }
        if key == 9 { view.focus=first; }
    }
    return 0;
}

module sotlas::runtime::managed;

// Caller-owned storage. These APIs are single-threaded and perform no hidden
// allocation, OS calls or foreign calls. They do not implement automatic ARC.
pub struct NativeArena {
    pub buffer: *mut u8;
    pub capacity: usize;
    pub used: usize;
    pub epoch: u64;
}

pub fn native_arena_init(buffer: *mut u8, capacity: usize) -> NativeArena {
    let mut size: usize = capacity;
    if buffer == null { size = 0; }
    return NativeArena { buffer:buffer, capacity:size, used:0, epoch:1 };
}

// Alignment is relative to the actual backing address. Failure leaves the
// allocation cursor unchanged. Zero-sized requests are deliberately rejected.
pub fn native_arena_alloc(mut arena: *mut NativeArena, size: usize, alignment: usize) -> *mut u8 {
    if arena == null || size == 0 || alignment == 0
        || alignment > 4096 || (alignment & (alignment-1)) != 0 { return null; }
    unsafe {
        if arena.buffer == null || arena.used > arena.capacity { return null; }
        let base: usize = arena.buffer as usize;
        if arena.used > 18446744073709551615 - base { return null; }
        let address: usize = base + arena.used;
        let padding: usize = (alignment - (address & (alignment-1))) & (alignment-1);
        let available: usize = arena.capacity - arena.used;
        if padding > available || size > available-padding
            || padding > 18446744073709551615-address
            || size > 18446744073709551615-address-padding { return null; }
        let backing: *mut u8 = arena.buffer;
        let offset: usize = arena.used + padding;
        let result: *mut u8 = backing + offset;
        arena.used = arena.used + padding + size;
        return result;
    }
}

pub struct NativeArenaMark { pub used: usize; pub epoch: u64; pub owner: *const NativeArena; }

pub fn native_arena_mark(arena: *const NativeArena) -> NativeArenaMark {
    if arena == null { return NativeArenaMark { used:0, epoch:0, owner:null }; }
    unsafe { return NativeArenaMark { used:arena.used, epoch:arena.epoch, owner:arena }; }
}

// Rewind invalidates every previous mark, including marks from a later cursor.
// The caller must ensure that no pointer into discarded storage remains live.
pub fn native_arena_rewind(mut arena: *mut NativeArena, mark: NativeArenaMark) -> bool {
    if arena == null { return false; }
    unsafe {
        if mark.epoch == 0 || mark.epoch != arena.epoch || mark.used > arena.used || mark.owner != arena
            || arena.used > arena.capacity || arena.epoch == 18446744073709551615 { return false; }
        arena.used = mark.used;
        arena.epoch = arena.epoch + 1;
        return true;
    }
}

// A control block must outlive all weak tokens. Generations never wrap and
// concurrent access is unsupported. The payload remains caller-owned.
pub struct NativeRefHeader { pub strong: u64; pub generation: u64; pub live: bool; }

pub fn native_ref_init() -> NativeRefHeader {
    return NativeRefHeader { strong:1, generation:1, live:true };
}

pub fn native_ref_retain(mut header: *mut NativeRefHeader) -> bool {
    if header == null { return false; }
    unsafe {
        if !header.live || header.strong == 0 || header.strong == 18446744073709551615 { return false; }
        header.strong = header.strong + 1;
        return true;
    }
}

// True authorizes the caller to destroy its payload exactly once. Repeated
// releases and attempts to resurrect a dead control block return false.
pub fn native_ref_release(mut header: *mut NativeRefHeader) -> bool {
    if header == null { return false; }
    unsafe {
        if !header.live || header.strong == 0 { return false; }
        header.strong = header.strong - 1;
        if header.strong != 0 { return false; }
        header.live = false;
        // Saturation still invalidates all tokens because live is false.
        if header.generation != 18446744073709551615 { header.generation = header.generation + 1; }
        return true;
    }
}

// A successful upgrade owns a new strong reference, which must be released.
pub fn native_ref_upgrade(header: *mut NativeRefHeader, generation: u64) -> bool {
    if header == null || generation == 0 { return false; }
    unsafe { if header.generation != generation { return false; } }
    return native_ref_retain(header);
}

// Explicit runtime guards. These do not infer effects or replace the canonical
// language authority/state syntax. Masks must be granted by the embedding app.
pub fn native_authority_allows(granted: u64, required: u64) -> bool {
    return (granted & required) == required;
}

pub fn native_authority_narrow(granted: u64, delegated: u64, result: *mut u64) -> bool {
    if result == null || !native_authority_allows(granted,delegated) { return false; }
    unsafe { *result = delegated; }
    return true;
}

pub fn native_state_transition(state: *mut u32, expected: u32, next: u32,
    granted: u64, required: u64) -> bool {
    if state == null || !native_authority_allows(granted,required) { return false; }
    unsafe {
        if *state != expected { return false; }
        *state = next;
    }
    return true;
}

// Subtraction prevents overflow when callers supply untrusted offsets/sizes.
pub fn native_contract_range(capacity: usize, offset: usize, size: usize) -> bool {
    return offset <= capacity && size <= capacity-offset;
}

pub struct NativeWeakToken { pub owner: *mut NativeRefHeader; pub generation: u64; }

pub fn native_ref_weak(header: *mut NativeRefHeader) -> NativeWeakToken {
    if header == null { return NativeWeakToken{owner:null,generation:0}; }
    unsafe{
        if !header.live || header.strong == 0 { return NativeWeakToken{owner:null,generation:0}; }
        return NativeWeakToken{owner:header,generation:header.generation};
    }
}

pub fn native_weak_upgrade(token: NativeWeakToken) -> bool {
    return native_ref_upgrade(token.owner,token.generation);
}

// Only recycle a fully released header. A saturated generation cannot wrap
// back to an old weak token. Retained weak tokens require stable storage.
pub fn native_ref_recycle(mut header: *mut NativeRefHeader) -> bool {
    if header == null { return false; }
    unsafe{
        if header.live || header.strong != 0 || header.generation == 0 || header.generation == 18446744073709551615 { return false; }
        header.generation=header.generation+1;header.strong=1;header.live=true;
    }
    return true;
}

// 0=invalid, 1=retained references remain, 2=caller must destroy the payload.
pub fn native_ref_release_checked(header: *mut NativeRefHeader) -> u32 {
    if header == null { return 0; }
    unsafe{if !header.live || header.strong == 0 { return 0; }}
    if native_ref_release(header) { return 2; }
    return 1;
}

pub fn native_arena_alloc_zero(arena: *mut NativeArena, size: usize, alignment: usize) -> *mut u8 {
    let memory: *mut u8 = native_arena_alloc(arena,size,alignment);
    if memory == null { return null; }
    let mut index: usize = 0;
    while index < size { unsafe{*(memory+index)=0;}index=index+1; }
    return memory;
}

// Explicit raw-memory APIs require valid backing ranges supplied by callers.
// Null pointers are allowed for an empty operation; arithmetic must not wrap.
pub fn native_memory_copy(destination: *mut u8, source: *const u8, count: usize) -> bool {
    if count == 0 { return true; }
    if destination == null || source == null { return false; }
    let to: usize = unsafe{destination as usize};let from: usize = unsafe{source as usize};
    if count > 18446744073709551615-to || count > 18446744073709551615-from { return false; }
    if to < from+count && from < to+count { return false; }
    let mut index: usize = 0;
    while index < count { unsafe{*(destination+index)=*(source+index);}index=index+1; }
    return true;
}

pub fn native_memory_move(destination: *mut u8, source: *const u8, count: usize) -> bool {
    if count == 0 { return true; }
    if destination == null || source == null { return false; }
    let to: usize = unsafe{destination as usize};let from: usize = unsafe{source as usize};
    if count > 18446744073709551615-to || count > 18446744073709551615-from { return false; }
    let mut index: usize = 0;
    if to > from && to < from+count {
        index=count;
        while index > 0 { index=index-1;unsafe{*(destination+index)=*(source+index);} }
    } else {
        while index < count { unsafe{*(destination+index)=*(source+index);}index=index+1; }
    }
    return true;
}

// Check every rewind condition before clearing discarded bytes. Clearing is
// observable native memory behavior; secure erasure against DMA is not proved.
pub fn native_arena_rewind_zero(mut arena: *mut NativeArena, mark: NativeArenaMark) -> bool {
    if arena == null { return false; }
    unsafe{
        if mark.owner != arena || mark.epoch == 0 || mark.epoch != arena.epoch
            || mark.used > arena.used || arena.used > arena.capacity
            || arena.epoch == 18446744073709551615 || arena.buffer == null { return false; }
        let base: usize=arena.buffer as usize;
        if arena.used > 18446744073709551615-base { return false; }
        let backing: *mut u8=arena.buffer;let mut index: usize=mark.used;
        while index < arena.used { *(backing+index)=0;index=index+1; }
    }
    return native_arena_rewind(arena,mark);
}

pub struct NativeAuthority { pub bits: u64; pub generation: u64; }

pub fn native_authority_init(bits: u64) -> NativeAuthority {
    return NativeAuthority{bits:bits,generation:1};
}

pub fn native_authority_revoke(mut authority: *mut NativeAuthority, revoked: u64) -> bool {
    if authority == null { return false; }
    unsafe{
        if authority.generation == 0 || authority.generation == 18446744073709551615 { return false; }
        authority.bits=authority.bits & ~revoked;authority.generation=authority.generation+1;
    }
    return true;
}

pub fn native_authority_current(authority: *const NativeAuthority, generation: u64, required: u64) -> bool {
    if authority == null || generation == 0 { return false; }
    unsafe{return authority.generation == generation && native_authority_allows(authority.bits,required);}
}

// A state machine with at most 64 states supplies the permitted destination
// mask. Authority revocation invalidates previously observed generations.
pub fn native_state_transition_current(state: *mut u32, expected: u32, next: u32,
    allowed_states: u64, authority: *const NativeAuthority, generation: u64, required: u64) -> bool {
    if state == null || next >= 64 || ((allowed_states >> (next as u64)) & 1) == 0
        || !native_authority_current(authority,generation,required) { return false; }
    unsafe{if *state != expected { return false; }*state=next;}
    return true;
}

// Batch operations either reject without mutation or update the whole count.
pub fn native_ref_retain_many(mut header: *mut NativeRefHeader, count: u64) -> bool {
    if header == null { return false; }
    unsafe {
        if !header.live || header.strong == 0 || count > 18446744073709551615-header.strong { return false; }
        header.strong=header.strong+count;
    }
    return true;
}

// The same release status as native_ref_release_checked; one final destruction.
pub fn native_ref_release_many(mut header: *mut NativeRefHeader, count: u64) -> u32 {
    if header == null || count == 0 { return 0; }
    unsafe {
        if !header.live || header.strong == 0 || count > header.strong { return 0; }
        if count < header.strong { header.strong=header.strong-count;return 1; }
        header.strong=1;
    }
    return native_ref_release_checked(header);
}

// Observation does not acquire a strong reference; no concurrency is promised.
pub fn native_weak_current(token: NativeWeakToken) -> bool {
    return native_ref_generation_current(token.owner,token.generation);
}

fn native_ref_generation_current(header: *const NativeRefHeader, generation: u64) -> bool {
    if header == null || generation == 0 { return false; }
    unsafe{if !header.live || header.strong == 0 || header.generation != generation { return false; }}
    return true;
}

pub fn native_ref_is_unique(header: *const NativeRefHeader) -> bool {
    if header == null { return false; }
    unsafe{if !header.live || header.strong != 1 || header.generation == 0 { return false; }}
    return true;
}

pub fn native_memory_fill(destination: *mut u8, count: usize, byte: u8) -> bool {
    if count == 0 { return true; }
    if destination == null { return false; }
    let address: usize=unsafe{destination as usize};
    if count > 18446744073709551615-address { return false; }
    let mut index: usize=0;
    while index < count { unsafe{*(destination+index)=byte;}index=index+1; }
    return true;
}

// Byte equality, not a constant-time secret comparison.
pub fn native_memory_equal(left: *const u8, right: *const u8, count: usize) -> bool {
    if count == 0 { return true; }
    if left == null || right == null { return false; }
    let a: usize=unsafe{left as usize};let b: usize=unsafe{right as usize};
    if count > 18446744073709551615-a || count > 18446744073709551615-b { return false; }
    let mut index: usize=0;
    while index < count { if unsafe{*(left+index)} != unsafe{*(right+index)} { return false; }index=index+1; }
    return true;
}

pub fn native_arena_remaining(arena: *const NativeArena) -> usize {
    if arena == null { return 0; }
    unsafe {
        if arena.buffer == null || arena.used > arena.capacity || arena.epoch == 0 { return 0; }
        return arena.capacity-arena.used;
    }
}

// All outstanding arena allocations become invalid; the caller proves disuse.
pub fn native_arena_reset_zero(arena: *mut NativeArena) -> bool {
    if arena == null { return false; }
    let generation: u64=unsafe{arena.epoch};
    let origin: NativeArenaMark=NativeArenaMark{used:0,epoch:generation,owner:arena};
    return native_arena_rewind_zero(arena,origin);
}

pub struct NativeAuthorityToken { pub owner: *const NativeAuthority; pub generation: u64; pub required: u64; }

pub fn native_authority_capture(authority: *const NativeAuthority, required: u64) -> NativeAuthorityToken {
    if authority != null {
        let generation: u64=unsafe{authority.generation};
        if native_authority_current(authority,generation,required) {
            return NativeAuthorityToken{owner:authority,generation:generation,required:required};
        }
    }
    return NativeAuthorityToken{owner:null,generation:0,required:0};
}

pub fn native_authority_token_current(token: NativeAuthorityToken) -> bool {
    return native_authority_current(token.owner,token.generation,token.required);
}

pub fn native_authority_delegate(token: NativeAuthorityToken, required: u64) -> NativeAuthorityToken {
    if native_authority_token_current(token) && native_authority_allows(token.required,required) {
        return NativeAuthorityToken{owner:token.owner,generation:token.generation,required:required};
    }
    return NativeAuthorityToken{owner:null,generation:0,required:0};
}

pub fn native_state_transition_token(state: *mut u32, expected: u32, next: u32,
    allowed_states: u64, token: NativeAuthorityToken) -> bool {
    return native_state_transition_current(state,expected,next,allowed_states,
        token.owner,token.generation,token.required);
}

pub fn native_arena_calloc(arena: *mut NativeArena, count: usize, stride: usize, alignment: usize) -> *mut u8 {
    let maximum: usize=18446744073709551615;
    if count == 0 || stride == 0 || count > maximum/stride { return null; }
    return native_arena_alloc_zero(arena,count*stride,alignment);
}

// This is a cursor/range query, not proof that an allocation is still alive.
pub fn native_arena_contains(arena: *const NativeArena, memory: *const u8, size: usize) -> bool {
    if arena == null || memory == null { return false; }
    unsafe {
        if arena.buffer == null || arena.used > arena.capacity || arena.epoch == 0 { return false; }
        let base: usize=arena.buffer as usize;let address: usize=memory as usize;
        let maximum: usize=18446744073709551615;
        if arena.used > maximum-base || address < base { return false; }
        let offset: usize=address-base;
        return offset <= arena.used && size <= arena.used-offset;
    }
}

// Only a known allocation at the cursor can grow; callers supply its true size.
pub fn native_arena_grow_last(mut arena: *mut NativeArena, memory: *mut u8, old_size: usize, new_size: usize) -> bool {
    if old_size == 0 || new_size < old_size || !native_arena_contains(arena,memory,old_size) { return false; }
    unsafe {
        let base: usize=arena.buffer as usize;let address: usize=memory as usize;
        let offset: usize=address-base;
        if old_size != arena.used-offset || new_size > arena.capacity-offset { return false; }
        if new_size > 18446744073709551615-address { return false; }
        arena.used=offset+new_size;
    }
    return true;
}

// Shrinking invalidates marks and requires disuse of the truncated suffix.
pub fn native_arena_shrink_last(mut arena: *mut NativeArena, memory: *mut u8, old_size: usize, new_size: usize) -> bool {
    if old_size == 0 || new_size > old_size || !native_arena_contains(arena,memory,old_size) { return false; }
    unsafe {
        let base: usize=arena.buffer as usize;let address: usize=memory as usize;
        let offset: usize=address-base;
        if old_size != arena.used-offset || arena.epoch == 18446744073709551615 { return false; }
        arena.used=offset+new_size;arena.epoch=arena.epoch+1;
    }
    return true;
}

// Checked arithmetic guards publish an output only after the whole operation.
pub fn native_contract_add(left: u64, right: u64, output: *mut u64) -> bool {
    let maximum: u64=18446744073709551615;
    if output == null || right > maximum-left { return false; }
    unsafe{*output=left+right;}return true;
}

pub fn native_contract_sub(left: u64, right: u64, output: *mut u64) -> bool {
    if output == null || right > left { return false; }
    unsafe{*output=left-right;}return true;
}

pub fn native_contract_mul(left: u64, right: u64, output: *mut u64) -> bool {
    let maximum: u64=18446744073709551615;
    if output == null { return false; }
    if right != 0 && left > maximum/right { return false; }
    unsafe{*output=left*right;}return true;
}

pub fn native_contract_align(value: u64, alignment: u64, output: *mut u64) -> bool {
    let maximum: u64=18446744073709551615;
    if output == null || alignment == 0 || (alignment & (alignment-1)) != 0 { return false; }
    let padding: u64=(alignment-(value & (alignment-1))) & (alignment-1);
    if padding > maximum-value { return false; }
    unsafe{*output=value+padding;}return true;
}

pub fn native_memory_find(bytes: *const u8, count: usize, needle: u8, output: *mut usize) -> bool {
    if bytes == null || output == null || count == 0 { return false; }
    let address: usize=unsafe{bytes as usize};
    if count > 18446744073709551615-address { return false; }
    let mut index: usize=0;
    while index < count {
        if unsafe{*(bytes+index)} == needle { unsafe{*output=index;}return true; }
        index=index+1;
    }
    return false;
}

pub fn native_memory_reverse(bytes: *mut u8, count: usize) -> bool {
    if count == 0 { return true; }if bytes == null { return false; }
    let address: usize=unsafe{bytes as usize};
    if count > 18446744073709551615-address { return false; }
    let mut index: usize=0;
    while index < count/2 {
        unsafe{let temporary: u8=*(bytes+index);*(bytes+index)=*(bytes+count-index-1);*(bytes+count-index-1)=temporary;}
        index=index+1;
    }
    return true;
}

pub fn native_memory_swap(left: *mut u8, right: *mut u8, count: usize) -> bool {
    if count == 0 { return true; }if left == null || right == null { return false; }
    let a: usize=unsafe{left as usize};let b: usize=unsafe{right as usize};
    if count > 18446744073709551615-a || count > 18446744073709551615-b { return false; }
    if a == b { return true; }if a < b+count && b < a+count { return false; }
    let mut index: usize=0;
    while index < count { unsafe{let temporary: u8=*(left+index);*(left+index)=*(right+index);*(right+index)=temporary;}index=index+1; }
    return true;
}

pub fn native_arena_copy(arena: *mut NativeArena, source: *const u8, count: usize, alignment: usize) -> *mut u8 {
    if source == null || count == 0 { return null; }
    let address: usize=unsafe{source as usize};
    if count > 18446744073709551615-address { return null; }
    let destination: *mut u8=native_arena_alloc(arena,count,alignment);
    if destination == null { return null; }
    if !native_memory_move(destination,source,count) { return null; }
    return destination;
}

pub fn native_contract_div(left: u64, right: u64, output: *mut u64) -> bool {
    if output == null || right == 0 { return false; }unsafe{*output=left/right;}return true;
}

pub fn native_contract_shift_left(value: u64, count: u32, output: *mut u64) -> bool {
    let maximum: u64=18446744073709551615;
    if output == null || count >= 64 { return false; }
    let shift: u64=count as u64;if value > (maximum >> shift) { return false; }
    unsafe{*output=value << shift;}return true;
}

pub fn native_contract_index(count: u64, index: u64, stride: u64, output: *mut u64) -> bool {
    let maximum: u64=18446744073709551615;
    if output == null || index >= count || stride == 0 || index > maximum/stride { return false; }
    unsafe{*output=index*stride;}return true;
}

pub fn native_contract_extent(offset: u64, count: u64, stride: u64, capacity: u64, output: *mut u64) -> bool {
    if output == null || stride == 0 || offset > capacity || count > (capacity-offset)/stride { return false; }
    unsafe{*output=offset+count*stride;}return true;
}

pub struct NativeByteBuffer { pub data: *mut u8; pub capacity: usize; pub used: usize; }

pub fn native_buffer_init(data: *mut u8, capacity: usize) -> NativeByteBuffer {
    let mut size: usize=capacity;if data == null { size=0; }
    return NativeByteBuffer{data:data,capacity:size,used:0};
}

pub fn native_buffer_append(mut buffer: *mut NativeByteBuffer, source: *const u8, count: usize) -> bool {
    if buffer == null { return false; }
    unsafe {
        if buffer.used > buffer.capacity || count > buffer.capacity-buffer.used { return false; }
        if count == 0 { return true; }if buffer.data == null || source == null { return false; }
        let base: usize=buffer.data as usize;let maximum: usize=18446744073709551615;
        if buffer.used > maximum-base || count > maximum-base-buffer.used { return false; }
        let backing: *mut u8=buffer.data;let used: usize=buffer.used;
        if !native_memory_move(backing+used,source,count) { return false; }
        buffer.used=used+count;
    }
    return true;
}

pub fn native_buffer_truncate_zero(mut buffer: *mut NativeByteBuffer, length: usize) -> bool {
    if buffer == null { return false; }
    unsafe {
        if buffer.used > buffer.capacity || length > buffer.used { return false; }
        if length == buffer.used { return true; }if buffer.data == null { return false; }
        let base: usize=buffer.data as usize;
        if buffer.used > 18446744073709551615-base { return false; }
        let backing: *mut u8=buffer.data;let discarded: usize=buffer.used-length;
        if !native_memory_fill(backing+length,discarded,0) { return false; }buffer.used=length;
    }
    return true;
}

pub fn native_buffer_consume(mut buffer: *mut NativeByteBuffer, count: usize) -> bool {
    if buffer == null { return false; }
    unsafe {
        if buffer.used > buffer.capacity || count > buffer.used { return false; }
        if count == 0 { return true; }if buffer.data == null { return false; }
        let base: usize=buffer.data as usize;
        if buffer.used > 18446744073709551615-base { return false; }
        let backing: *mut u8=buffer.data;let remaining: usize=buffer.used-count;
        if !native_memory_move(backing,backing+count,remaining)
            || !native_memory_fill(backing+remaining,count,0) { return false; }
        buffer.used=remaining;
    }
    return true;
}

pub fn native_contract_i64_add(left: i64, right: i64, output: *mut i64) -> bool {
    let maximum: i64=9223372036854775807;let minimum: i64=-9223372036854775808;
    if output == null || (right > 0 && left > maximum-right) || (right < 0 && left < minimum-right) { return false; }
    unsafe{*output=left+right;}return true;
}

pub fn native_contract_i64_sub(left: i64, right: i64, output: *mut i64) -> bool {
    let maximum: i64=9223372036854775807;let minimum: i64=-9223372036854775808;
    if output == null || (right > 0 && left < minimum+right) || (right < 0 && left > maximum+right) { return false; }
    unsafe{*output=left-right;}return true;
}

pub fn native_contract_i64_mul(left: i64, right: i64, output: *mut i64) -> bool {
    let maximum: i64=9223372036854775807;let minimum: i64=-9223372036854775808;
    if output == null { return false; }
    if left > 0 {
        if (right > 0 && left > maximum/right) || (right < 0 && right < minimum/left) { return false; }
    } else if left < 0 {
        if (right > 0 && left < minimum/right) || (right < 0 && left < maximum/right) { return false; }
    }
    unsafe{*output=left*right;}return true;
}

pub fn native_contract_i64_div(left: i64, right: i64, output: *mut i64) -> bool {
    let minimum: i64=-9223372036854775808;
    if output == null || right == 0 || (left == minimum && right == -1) { return false; }
    unsafe{*output=left/right;}return true;
}


// SV8.58: a caller-backed managed byte resource. The control block, handle
// and payload must remain at stable, disjoint addresses until all strong and
// weak users have stopped accessing them. These functions are single-threaded;
// they implement explicit zero-on-last-release, not compiler-generated ARC.
pub struct NativeManagedBytes {
    pub control: *mut NativeRefHeader;
    pub bytes: *mut u8;
    pub length: usize;
    pub generation: u64;
}

pub fn native_managed_bytes_open(
    control: *mut NativeRefHeader, bytes: *mut u8, length: usize
) -> NativeManagedBytes {
    let empty: NativeManagedBytes = NativeManagedBytes {
        control:null, bytes:null, length:0, generation:0
    };
    if control == null || bytes == null || length == 0 { return empty; }
    let address: usize = unsafe { bytes as usize };
    if length > 18446744073709551615-address { return empty; }
    unsafe {
        // Bind only a unique, live reference. A shared block cannot be
        // rebound to unrelated payload memory by a second owner.
        if !control.live || control.strong != 1 || control.generation == 0 {
            return empty;
        }
        return NativeManagedBytes {
            control:control, bytes:bytes, length:length,
            generation:control.generation
        };
    }
}

pub fn native_managed_bytes_current(resource: *const NativeManagedBytes) -> bool {
    if resource == null { return false; }
    unsafe {
        if resource.control == null || resource.bytes == null
            || resource.length == 0 || resource.generation == 0 { return false; }
        let address: usize = resource.bytes as usize;
        if resource.length > 18446744073709551615-address { return false; }
        let block: *const NativeRefHeader = resource.control as *const NativeRefHeader;
        return native_ref_generation_current(block,resource.generation);
    }
}

pub fn native_managed_bytes_retain(resource: *const NativeManagedBytes) -> bool {
    if !native_managed_bytes_current(resource) { return false; }
    unsafe { return native_ref_retain(resource.control); }
}

pub fn native_managed_bytes_weak(resource: *const NativeManagedBytes) -> NativeWeakToken {
    if !native_managed_bytes_current(resource) {
        return NativeWeakToken{owner:null,generation:0};
    }
    unsafe { return native_ref_weak(resource.control); }
}

pub fn native_managed_bytes_upgrade(
    resource: *const NativeManagedBytes, token: NativeWeakToken
) -> bool {
    if !native_managed_bytes_current(resource) { return false; }
    unsafe {
        if token.owner != resource.control || token.generation != resource.generation {
            return false;
        }
    }
    return native_weak_upgrade(token);
}

// 0=invalid/no change, 1=other strong references remain, 2=payload cleared
// and weak handles invalidated. The caller must not use the released payload.
// Retained and invalid releases do not modify its bytes. No foreign runtime.
pub fn native_managed_bytes_release(resource: *const NativeManagedBytes) -> u32 {
    if !native_managed_bytes_current(resource) { return 0; }
    let control: *mut NativeRefHeader = unsafe { resource.control };
    let bytes: *mut u8 = unsafe { resource.bytes };
    let count: usize = unsafe { resource.length };
    let outcome: u32 = native_ref_release_checked(control);
    if outcome == 2 {
        // The range was checked before changing the reference count. Its
        // backing storage and disjointness are explicit caller guarantees.
        if !native_memory_fill(bytes,count,0) { return 0; }
    }
    return outcome;
}

// SV8.59: explicit slot-based destruction for lexical native defer cleanup.
// This helper closes one strong claim and poisons that handle after a valid
// release. Aliases to the same handle must not be used after close; external
// retains require separately managed strong claims. This is not automatic ARC.
pub fn native_managed_bytes_close(mut resource: *mut NativeManagedBytes) -> void {
    if resource == null { return; }
    let view: *const NativeManagedBytes = unsafe { resource as *const NativeManagedBytes };
    if !native_managed_bytes_current(view) { return; }
    let outcome: u32 = native_managed_bytes_release(view);
    if outcome != 0 {
        unsafe {
            resource.control = null;
            resource.bytes = null;
            resource.length = 0;
            resource.generation = 0;
        }
    }
}

// Explicit strong-claim slots; caller-owned metadata must be disjoint/stable.
pub fn native_managed_bytes_empty(resource: *const NativeManagedBytes) -> bool {
    if resource == null { return false; }
    unsafe{return resource.control == null && resource.bytes == null && resource.length == 0 && resource.generation == 0;}
}

pub fn native_managed_bytes_clone_into(source: *const NativeManagedBytes, destination: *mut NativeManagedBytes) -> bool {
    if !native_managed_bytes_empty(destination) || !native_managed_bytes_current(source) { return false; }
    if !native_managed_bytes_retain(source) { return false; }
    unsafe{*destination=*source;}return true;
}

pub fn native_managed_bytes_upgrade_into(source: *const NativeManagedBytes, token: NativeWeakToken,
    destination: *mut NativeManagedBytes) -> bool {
    if !native_managed_bytes_empty(destination) || !native_managed_bytes_upgrade(source,token) { return false; }
    unsafe{*destination=*source;}return true;
}

pub fn native_managed_bytes_take(mut source: *mut NativeManagedBytes, destination: *mut NativeManagedBytes) -> bool {
    if !native_managed_bytes_empty(destination) || !native_managed_bytes_current(source) { return false; }
    unsafe{*destination=*source;source.control=null;source.bytes=null;source.length=0;source.generation=0;}return true;
}

pub fn native_managed_bytes_swap(left: *mut NativeManagedBytes, mut right: *mut NativeManagedBytes) -> bool {
    if (!native_managed_bytes_empty(left) && !native_managed_bytes_current(left))
        || (!native_managed_bytes_empty(right) && !native_managed_bytes_current(right)) { return false; }
    if left == right { return true; }
    unsafe{
        let control:*mut NativeRefHeader=left.control;let bytes:*mut u8=left.bytes;
        let length:usize=left.length;let generation:u64=left.generation;
        *left=*right;right.control=control;right.bytes=bytes;right.length=length;right.generation=generation;
    }return true;
}

pub fn native_contract_u8(value: u64, output: *mut u8) -> bool {
    if output == null || value > 255 { return false; }unsafe{*output=value as u8;}return true;
}
pub fn native_contract_u16(value: u64, output: *mut u16) -> bool {
    if output == null || value > 65535 { return false; }unsafe{*output=value as u16;}return true;
}
pub fn native_contract_u32(value: u64, output: *mut u32) -> bool {
    if output == null || value > 4294967295 { return false; }unsafe{*output=value as u32;}return true;
}
pub fn native_contract_i32(value: i64, output: *mut i32) -> bool {
    if output == null || value < -2147483648 || value > 2147483647 { return false; }unsafe{*output=value as i32;}return true;
}


// SV8.66: bounded resource scopes, with caller-owned metadata. Table slots
// store machine-sized addresses, not pointer-to-pointer array locals; the
// native compiler's pointer-to-pointer array conversion is not certified
// (CI #1250). Stable/disjoint storage and single-threaded execution remain
// explicit caller guarantees; no hosted allocator or automatic ARC.
pub struct NativeManagedScope {
    pub entries: *mut usize;
    pub capacity: usize;
    pub used: usize;
}

pub fn native_managed_scope_init(
    entries: *mut usize, capacity: usize
) -> NativeManagedScope {
    let empty: NativeManagedScope = NativeManagedScope {
        entries:null, capacity:0, used:0
    };
    if entries == null || capacity == 0 || capacity > 64 { return empty; }
    let address: usize = unsafe { entries as usize };
    if capacity > (18446744073709551615-address)/8 { return empty; }
    let mut index: usize = 0;
    while index < capacity {
        unsafe { *(entries+index) = 0; }
        index = index + 1;
    }
    return NativeManagedScope { entries:entries, capacity:capacity, used:0 };
}

pub fn native_managed_scope_valid(scope: *const NativeManagedScope) -> bool {
    if scope == null { return false; }
    unsafe {
        if scope.entries == null || scope.capacity == 0
            || scope.capacity > 64 || scope.used > scope.capacity { return false; }
        let address: usize = scope.entries as usize;
        return scope.capacity <= (18446744073709551615-address)/8;
    }
}

pub fn native_managed_scope_depth(scope: *const NativeManagedScope) -> usize {
    if !native_managed_scope_valid(scope) { return 0; }
    unsafe { return scope.used; }
}

pub fn native_managed_scope_contains(
    scope: *const NativeManagedScope, resource: *mut NativeManagedBytes
) -> bool {
    if !native_managed_scope_valid(scope) || resource == null { return false; }
    let mut index: usize = 0;
    unsafe {
        while index < scope.used {
            if *(scope.entries+index) == resource as usize { return true; }
            index = index + 1;
        }
    }
    return false;
}

pub fn native_managed_scope_push(
    mut scope: *mut NativeManagedScope, resource: *mut NativeManagedBytes
) -> bool {
    if !native_managed_scope_valid(scope)
        || !native_managed_bytes_current(resource)
        || native_managed_scope_contains(scope,resource) { return false; }
    unsafe {
        if scope.used >= scope.capacity { return false; }
        *(scope.entries+scope.used) = resource as usize;
        scope.used = scope.used + 1;
    }
    return true;
}

// Untrack without release; the live claim returns to caller responsibility.
pub fn native_managed_scope_detach(
    mut scope: *mut NativeManagedScope, resource: *mut NativeManagedBytes
) -> bool {
    if !native_managed_scope_contains(scope,resource) { return false; }
    unsafe {
        let mut index: usize = 0;
        while index < scope.used {
            if *(scope.entries+index) == resource as usize { break; }
            index = index + 1;
        }
        while index + 1 < scope.used {
            *(scope.entries+index) = *(scope.entries+index+1);
            index = index + 1;
        }
        scope.used = scope.used - 1;
        *(scope.entries+scope.used) = 0;
    }
    return true;
}

pub fn native_managed_scope_release_last(mut scope: *mut NativeManagedScope) -> bool {
    if !native_managed_scope_valid(scope) { return false; }
    unsafe {
        if scope.used == 0 { return false; }
        let slot: *mut NativeManagedBytes = (*(scope.entries+scope.used-1)) as *mut NativeManagedBytes;
        if !native_managed_bytes_current(slot) { return false; }
        native_managed_bytes_close(slot);
        if !native_managed_bytes_empty(slot) { return false; }
        scope.used = scope.used - 1;
        *(scope.entries+scope.used) = 0;
    }
    return true;
}

// Validate the entire suffix before mutating it; a stale slot fails closed.
// Callers may explicitly detach a previously closed slot to recover.
pub fn native_managed_scope_rewind(
    scope: *mut NativeManagedScope, mark: usize
) -> bool {
    if !native_managed_scope_valid(scope) { return false; }
    unsafe {
        if mark > scope.used { return false; }
        let mut index: usize = mark;
        while index < scope.used {
            let slot: *mut NativeManagedBytes = (*(scope.entries+index)) as *mut NativeManagedBytes;
            if !native_managed_bytes_current(slot) { return false; }
            index = index + 1;
        }
        while scope.used > mark {
            if !native_managed_scope_release_last(scope) { return false; }
        }
    }
    return true;
}

pub fn native_managed_scope_drain(scope: *mut NativeManagedScope) -> bool {
    return native_managed_scope_rewind(scope,0);
}

// Void signature supports Sotlas-native lexical defer. Callers with possible
// corrupted/stale table entries must use the checked drain first.
pub fn native_managed_scope_close(scope: *mut NativeManagedScope) -> void {
    let completed: bool = native_managed_scope_drain(scope);
}

// Promote one registered strong claim between distinct disjoint scopes.
pub fn native_managed_scope_transfer(
    source: *mut NativeManagedScope, destination: *mut NativeManagedScope,
    resource: *mut NativeManagedBytes
) -> bool {
    if source == destination || !native_managed_scope_valid(source)
        || !native_managed_scope_valid(destination)
        || !native_managed_scope_contains(source,resource)
        || native_managed_scope_contains(destination,resource)
        || !native_managed_bytes_current(resource) { return false; }
    unsafe {
        if destination.used >= destination.capacity { return false; }
    }
    if !native_managed_scope_push(destination,resource) { return false; }
    return native_managed_scope_detach(source,resource);
}

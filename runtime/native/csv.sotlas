module sotlas::runtime::csv;
import sotlas::runtime::text::*;

// Byte-oriented, caller-backed CSV. A field borrows the original input;
// decoding uses separate caller storage and never appends an implicit NUL.
pub struct NativeCsvReader {
    pub input:NativeByteSlice; pub offset:usize; pub row:usize;
    pub column:usize; pub finished:bool;
}
pub struct NativeCsvField {
    pub status:u32; pub raw:NativeByteSlice; pub length:usize; pub quoted:bool;
    pub row_end:bool; pub row:usize; pub column:usize; pub offset:usize;
}
pub struct NativeCsvDecoded { pub status:u32; pub length:usize; }

fn csv_overlap(a:usize,an:usize,b:usize,bn:usize)->bool {
    return an!=0 && bn!=0 && a<b+bn && b<a+an;
}
pub fn native_csv_open(input:NativeByteSlice)->NativeCsvReader {
    return NativeCsvReader{input:input,offset:0,row:0,column:0,finished:input.length==0};
}
pub fn native_csv_reader_shape(p:*const NativeCsvReader)->bool {
    if p==null { return false; }
    let address:usize=unsafe{p as usize};
    if address%align_of::<NativeCsvReader>()!=0
        || span_of::<NativeCsvReader>()>18446744073709551615-address { return false; }
    unsafe {
        if !native_text_valid(p.input) || p.offset>p.input.length
            || p.row>p.input.length || p.column>p.input.length
            || (p.finished && p.offset!=p.input.length) { return false; }
        return !csv_overlap(address,span_of::<NativeCsvReader>(),p.input.data as usize,p.input.length);
    }
}
fn csv_result(status:u32,row:usize,column:usize,offset:usize)->NativeCsvField {
    return NativeCsvField{status:status,raw:native_text_invalid(),length:0,
        quoted:false,row_end:false,row:row,column:column,offset:offset};
}

// 0 field, 1 invalid metadata, 2 EOF, 3 malformed CSV. Syntax rejection and EOF
// leave the reader untouched. LF and CRLF delimit records; bare CR is rejected.
pub fn native_csv_next(mut p:*mut NativeCsvReader)->NativeCsvField {
    if !native_csv_reader_shape(p) { return csv_result(1,0,0,0); }
    let reader:NativeCsvReader=unsafe{*p};
    if reader.finished { return csv_result(2,reader.row,reader.column,reader.offset); }
    let source:NativeByteSlice=reader.input;
    let start:usize=reader.offset;
    let mut cursor:usize=start; let mut first:usize=start;
    let mut last:usize=start; let mut length:usize=0; let mut quoted:bool=false;
    unsafe {
        if cursor<source.length && *(source.data+cursor)==34 {
            quoted=true;cursor+=1;first=cursor;
            let mut closed:bool=false;
            while cursor<source.length {
                let byte:u8= *(source.data+cursor);
                if byte==34 {
                    if cursor+1<source.length && *(source.data+cursor+1)==34 {
                        length+=1;cursor+=2;
                    } else { last=cursor;cursor+=1;closed=true;break; }
                } else { length+=1;cursor+=1; }
            }
            if !closed { return csv_result(3,reader.row,reader.column,source.length); }
        } else {
            while cursor<source.length {
                let byte:u8= *(source.data+cursor);
                if byte==44 || byte==10 || byte==13 { break; }
                if byte==34 { return csv_result(3,reader.row,reader.column,cursor); }
                cursor+=1;
            }
            last=cursor;length=last-first;
        }
    }
    let mut row_end:bool=true; let mut finished:bool=false;
    if cursor==source.length { finished=true; }
    else {
        let delimiter:u8=unsafe{*(source.data+cursor)};
        if delimiter==44 { row_end=false;cursor+=1; }
        else if delimiter==10 { cursor+=1;finished=cursor==source.length; }
        else if delimiter==13 {
            if cursor+1>=source.length || unsafe{*(source.data+cursor+1)}!=10 {
                return csv_result(3,reader.row,reader.column,cursor);
            }
            cursor+=2;finished=cursor==source.length;
        } else { return csv_result(3,reader.row,reader.column,cursor); }
    }
    unsafe {
        p.offset=cursor;p.finished=finished;
        if row_end { p.row=reader.row+1;p.column=0; }
        else { p.column=reader.column+1; }
    }
    return NativeCsvField{status:0,raw:native_text_sub(source,first,last-first),
        length:length,quoted:quoted,row_end:row_end,row:reader.row,
        column:reader.column,offset:start};
}

// 0 success, 1 invalid field/output metadata, 3 invalid raw field syntax,
// 6 insufficient capacity, 7 overlap. All rejection precedes output writes.
pub fn native_csv_decode(field:NativeCsvField,output:*mut u8,capacity:usize)->NativeCsvDecoded {
    let address:usize=unsafe{output as usize};
    if field.status!=0 || !native_text_valid(field.raw)
        || (capacity!=0 && output==null) || capacity>18446744073709551615-address {
        return NativeCsvDecoded{status:1,length:0};
    }
    let mut cursor:usize=0;let mut length:usize=0;
    unsafe {
        while cursor<field.raw.length {
            let byte:u8= *(field.raw.data+cursor);
            if byte==34 {
                if !field.quoted || cursor+1>=field.raw.length || *(field.raw.data+cursor+1)!=34 {
                    return NativeCsvDecoded{status:3,length:0};
                }
                cursor+=1;
            } else if !field.quoted && (byte==44 || byte==10 || byte==13) {
                return NativeCsvDecoded{status:3,length:0};
            }
            cursor+=1;length+=1;
        }
    }
    if length!=field.length { return NativeCsvDecoded{status:1,length:0}; }
    if length>capacity { return NativeCsvDecoded{status:6,length:0}; }
    if csv_overlap(address,capacity,unsafe{field.raw.data as usize},field.raw.length) {
        return NativeCsvDecoded{status:7,length:0};
    }
    cursor=0;let mut destination:usize=0;
    unsafe {
        while cursor<field.raw.length {
            let byte:u8= *(field.raw.data+cursor);
            *(output+destination)=byte;destination+=1;
            if byte==34 { cursor+=1; }
            cursor+=1;
        }
    }
    return NativeCsvDecoded{status:0,length:length};
}

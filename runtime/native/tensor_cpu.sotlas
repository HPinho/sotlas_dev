module sotlas::runtime::tensor_cpu;

// CPU reference kernels. Callers own storage and must keep every range live.
// Metadata checks cannot establish pointer provenance or exclusive access.
pub struct NativeF32View { pub data:*const f32; pub length:usize; }
pub struct NativeF32MutView { pub data:*mut f32; pub length:usize; }
pub struct NativeF32Result { pub status:u32; pub value:f32; }

// Status: 0 success, 1 invalid range, 2 incompatible shape, 3 unsafe overlap.
pub fn native_f32_range_valid(data:*const f32,length:usize)->bool {
    if length==0 { return true; }
    if data==null || length>4611686018427387903 { return false; }
    let address:usize=unsafe{data as usize};
    return address%4==0 && length*4<=18446744073709551615-address;
}

// Only called after both ranges have passed native_f32_range_valid.
fn native_f32_overlap(a:*const f32,an:usize,b:*const f32,bn:usize)->bool {
    if an==0 || bn==0 { return false; }
    let start_a:usize=unsafe{a as usize};
    let start_b:usize=unsafe{b as usize};
    return start_a<start_b+bn*4 && start_b<start_a+an*4;
}

pub fn native_f32_dot_cpu(left:NativeF32View,right:NativeF32View)->NativeF32Result {
    if !native_f32_range_valid(left.data,left.length) || !native_f32_range_valid(right.data,right.length) {
        return NativeF32Result{status:1,value:0.0};
    }
    if left.length!=right.length { return NativeF32Result{status:2,value:0.0}; }
    let mut value:f32=0.0; let mut i:usize=0;
    unsafe { while i<left.length { value+= *(left.data+i)* *(right.data+i); i+=1; } }
    return NativeF32Result{status:0,value:value};
}

pub fn native_f32_scale_cpu(output:NativeF32MutView,scale:f32)->u32 {
    if !native_f32_range_valid(unsafe{output.data as *const f32},output.length) { return 1; }
    let mut i:usize=0;
    unsafe { while i<output.length { *(output.data+i)*=scale; i+=1; } }
    return 0;
}

pub fn native_f32_axpy_cpu(output:NativeF32MutView,input:NativeF32View,scale:f32)->u32 {
    let output_data:*const f32=unsafe{output.data as *const f32};
    if !native_f32_range_valid(output_data,output.length) || !native_f32_range_valid(input.data,input.length) { return 1; }
    if output.length!=input.length { return 2; }
    if output_data!=input.data && native_f32_overlap(output_data,output.length,input.data,input.length) { return 3; }
    let mut i:usize=0;
    unsafe { while i<output.length { *(output.data+i)+=scale* *(input.data+i); i+=1; } }
    return 0;
}

// Row-major weights[rows,columns] times input[columns] -> output[rows].
// All metadata and overlap checks finish before the first output write.
pub fn native_f32_gemv_cpu(output:NativeF32MutView,input:NativeF32View,weights:NativeF32View,rows:usize,columns:usize)->u32 {
    let output_data:*const f32=unsafe{output.data as *const f32};
    if !native_f32_range_valid(output_data,output.length) || !native_f32_range_valid(input.data,input.length)
        || !native_f32_range_valid(weights.data,weights.length) { return 1; }
    if columns!=0 && rows>18446744073709551615/columns { return 2; }
    if output.length!=rows || input.length!=columns || weights.length!=rows*columns { return 2; }
    if native_f32_overlap(output_data,output.length,input.data,input.length)
        || native_f32_overlap(output_data,output.length,weights.data,weights.length) { return 3; }
    let mut row:usize=0;
    unsafe {
        while row<rows {
            *(output.data+row)=0.0;
            let mut column:usize=0;
            while column<columns {
                *(output.data+row)+= *(weights.data+row*columns+column)* *(input.data+column);
                column+=1;
            }
            row+=1;
        }
    }
    return 0;
}

// Row-major left[rows,inner] * right[inner,columns]. Validate all ranges,
// products and output aliases before any write, including empty matrices.
fn native_f32_gemm_status(output:NativeF32MutView,left:NativeF32View,right:NativeF32View,
    rows:usize,inner:usize,columns:usize)->u32 {
    let destination:*const f32=unsafe{output.data as *const f32};
    if !native_f32_range_valid(destination,output.length)
        || !native_f32_range_valid(left.data,left.length)
        || !native_f32_range_valid(right.data,right.length) { return 1; }
    let maximum:usize=18446744073709551615;
    if (inner!=0 && rows>maximum/inner) || (columns!=0 && inner>maximum/columns)
        || (columns!=0 && rows>maximum/columns) { return 2; }
    if left.length!=rows*inner || right.length!=inner*columns
        || output.length!=rows*columns { return 2; }
    if native_f32_overlap(destination,output.length,left.data,left.length)
        || native_f32_overlap(destination,output.length,right.data,right.length) { return 3; }
    return 0;
}

pub fn native_f32_gemm_cpu(output:NativeF32MutView,left:NativeF32View,right:NativeF32View,
    rows:usize,inner:usize,columns:usize)->u32 {
    let status:u32=native_f32_gemm_status(output,left,right,rows,inner,columns);
    if status!=0 || output.length==0 { return status; }
    let mut row:usize=0;
    unsafe {
        while row<rows {
            let mut column:usize=0;
            while column<columns {
                let mut sum:f32=0.0;let mut k:usize=0;
                while k<inner {
                    sum+= *(left.data+row*inner+k)* *(right.data+k*columns+column);
                    k+=1;
                }
                *(output.data+row*columns+column)=sum;column+=1;
            }
            row+=1;
        }
    }
    return 0;
}

// Batched dense layer: input[batch,inputs] * weights[inputs,outputs] + bias[outputs].
// Bias is added after each sequential dot product. No hidden allocation or FMA.
pub fn native_f32_linear_cpu(output:NativeF32MutView,input:NativeF32View,weights:NativeF32View,
    bias:NativeF32View,batch:usize,inputs:usize,outputs:usize)->u32 {
    let status:u32=native_f32_gemm_status(output,input,weights,batch,inputs,outputs);
    if status!=0 { return status; }
    if !native_f32_range_valid(bias.data,bias.length) { return 1; }
    if bias.length!=outputs { return 2; }
    if native_f32_overlap(unsafe{output.data as *const f32},output.length,bias.data,bias.length) { return 3; }
    // All fallible metadata work precedes GEMM, preserving output on rejection.
    let product:u32=native_f32_gemm_cpu(output,input,weights,batch,inputs,outputs);
    if product!=0 || output.length==0 { return product; }
    let mut row:usize=0;
    unsafe {
        while row<batch {
            let mut column:usize=0;
            while column<outputs { *(output.data+row*outputs+column)+= *(bias.data+column);column+=1; }
            row+=1;
        }
    }
    return 0;
}

// Separate storage is required even for square matrices; this is not an
// in-place transpose. Readonly inputs may share storage in other kernels.
pub fn native_f32_transpose_cpu(output:NativeF32MutView,input:NativeF32View,rows:usize,columns:usize)->u32 {
    let destination:*const f32=unsafe{output.data as *const f32};
    if !native_f32_range_valid(destination,output.length)
        || !native_f32_range_valid(input.data,input.length) { return 1; }
    if columns!=0 && rows>18446744073709551615/columns { return 2; }
    if input.length!=rows*columns || output.length!=input.length { return 2; }
    if native_f32_overlap(destination,output.length,input.data,input.length) { return 3; }
    if output.length==0 { return 0; }
    let mut row:usize=0;
    unsafe {
        while row<rows {
            let mut column:usize=0;
            while column<columns { *(output.data+column*rows+row)= *(input.data+row*columns+column);column+=1; }
            row+=1;
        }
    }
    return 0;
}

// Preserve NaNs and signed zero: only values strictly below zero are replaced.
pub fn native_f32_relu_cpu(output:NativeF32MutView)->u32 {
    if !native_f32_range_valid(unsafe{output.data as *const f32},output.length) { return 1; }
    let mut i:usize=0;
    unsafe { while i<output.length { if *(output.data+i)<0.0 { *(output.data+i)=0.0; }i+=1; } }
    return 0;
}

module core::string;

import core::alloc::*;
import core::result::*;

// Borrowed UTF-8 string slice (&str)
pub struct StringSlice {
    pub data: *const u8;
    pub length: usize;
}

pub struct StringSplit {
    pub before: StringSlice;
    pub after: StringSlice;
    pub found: bool;
}

pub fn string_from_raw(data: *const u8, len: usize) -> StringSlice {
    let mut s: StringSlice = 0;
    s.data = data;
    s.length = len;
    return s;
}

pub fn string_len(s: StringSlice) -> usize {
    return s.length;
}

pub fn string_is_empty(s: StringSlice) -> bool {
    return s.length == 0 || s.data == null;
}

fn string_byte_in_range(
    s: StringSlice,
    index: usize,
    minimum: u8,
    maximum: u8
) -> bool {
    if s.data == null || index >= s.length {
        return false;
    }
    let byte: u8 = string_char_at(s, index);
    return byte >= minimum && byte <= maximum;
}

// Validate Unicode scalar encodings without allocating or decoding them.
// Other StringSlice operations remain byte-oriented.
pub fn string_is_valid_utf8(s: StringSlice) -> bool {
    if s.length == 0 {
        return true;
    }
    if s.data == null {
        return false;
    }

    let mut index: usize = 0;
    while index < s.length {
        let first: u8 = string_char_at(s, index);
        let remaining: usize = s.length - index;

        if first <= 0x7Fu8 {
            index = index + 1;
            continue;
        }
        if first >= 0xC2u8 && first <= 0xDFu8 {
            if remaining < 2 || !string_byte_in_range(
                s, index + 1, 0x80u8, 0xBFu8
            ) {
                return false;
            }
            index = index + 2;
            continue;
        }
        if first == 0xE0u8 {
            if remaining < 3 ||
                !string_byte_in_range(s, index + 1, 0xA0u8, 0xBFu8) ||
                !string_byte_in_range(s, index + 2, 0x80u8, 0xBFu8) {
                return false;
            }
            index = index + 3;
            continue;
        }
        if (first >= 0xE1u8 && first <= 0xECu8) ||
            (first >= 0xEEu8 && first <= 0xEFu8) {
            if remaining < 3 ||
                !string_byte_in_range(s, index + 1, 0x80u8, 0xBFu8) ||
                !string_byte_in_range(s, index + 2, 0x80u8, 0xBFu8) {
                return false;
            }
            index = index + 3;
            continue;
        }
        if first == 0xEDu8 {
            if remaining < 3 ||
                !string_byte_in_range(s, index + 1, 0x80u8, 0x9Fu8) ||
                !string_byte_in_range(s, index + 2, 0x80u8, 0xBFu8) {
                return false;
            }
            index = index + 3;
            continue;
        }
        if first == 0xF0u8 {
            if remaining < 4 ||
                !string_byte_in_range(s, index + 1, 0x90u8, 0xBFu8) ||
                !string_byte_in_range(s, index + 2, 0x80u8, 0xBFu8) ||
                !string_byte_in_range(s, index + 3, 0x80u8, 0xBFu8) {
                return false;
            }
            index = index + 4;
            continue;
        }
        if first >= 0xF1u8 && first <= 0xF3u8 {
            if remaining < 4 ||
                !string_byte_in_range(s, index + 1, 0x80u8, 0xBFu8) ||
                !string_byte_in_range(s, index + 2, 0x80u8, 0xBFu8) ||
                !string_byte_in_range(s, index + 3, 0x80u8, 0xBFu8) {
                return false;
            }
            index = index + 4;
            continue;
        }
        if first == 0xF4u8 {
            if remaining < 4 ||
                !string_byte_in_range(s, index + 1, 0x80u8, 0x8Fu8) ||
                !string_byte_in_range(s, index + 2, 0x80u8, 0xBFu8) ||
                !string_byte_in_range(s, index + 3, 0x80u8, 0xBFu8) {
                return false;
            }
            index = index + 4;
            continue;
        }
        return false;
    }
    return true;
}

pub fn string_as_bytes(s: StringSlice) -> *const u8 {
    return s.data;
}

pub fn string_char_at(s: StringSlice, index: usize) -> u8 {
    if index >= s.length || s.data == null {
        return 0;
    }
    unsafe {
        return s.data[index];
    }
}

// Reads one byte without conflating an embedded NUL with an invalid index.
// The output is unchanged when the slice, index, or output pointer is invalid.
pub fn string_try_byte_at(
    s: StringSlice,
    index: usize,
    out: *mut u8
) -> bool {
    if s.data == null || index >= s.length || out == null {
        return false;
    }
    unsafe {
        *out = s.data[index];
    }
    return true;
}

pub fn string_equals(a: StringSlice, b: StringSlice) -> bool {
    if a.length != b.length {
        return false;
    }
    if a.length == 0 {
        return true;
    }
    if a.data == null || b.data == null {
        return false;
    }
    let mut i: usize = 0;
    unsafe {
        while i < a.length {
            if a.data[i] != b.data[i] {
                return false;
            }
            i = i + 1;
        }
    }
    return true;
}

pub fn string_compare(a: StringSlice, b: StringSlice) -> i32 {
    // -2 is reserved for a malformed non-empty slice with a null pointer.
    // Returning an error sentinel keeps callers from dereferencing invalid data.
    if a.length > 0 && a.data == null {
        return -2;
    }
    if b.length > 0 && b.data == null {
        return -2;
    }

    let mut min_len: usize = a.length;
    if b.length < min_len {
        min_len = b.length;
    }
    let mut i: usize = 0;
    unsafe {
        while i < min_len {
            if a.data[i] < b.data[i] {
                return -1;
            }
            if a.data[i] > b.data[i] {
                return 1;
            }
            i = i + 1;
        }
    }
    if a.length < b.length {
        return -1;
    }
    if a.length > b.length {
        return 1;
    }
    return 0;
}

pub fn string_slice(s: StringSlice, start: usize, end: usize) -> StringSlice {
    if s.data == null || start >= s.length || start >= end {
        return string_from_raw(null, 0);
    }
    let mut actual_end: usize = end;
    if actual_end > s.length {
        actual_end = s.length;
    }
    unsafe {
        return string_from_raw(s.data + start, actual_end - start);
    }
}

pub fn string_starts_with(s: StringSlice, prefix: StringSlice) -> bool {
    if prefix.length > s.length {
        return false;
    }
    let sub: StringSlice = string_slice(s, 0, prefix.length);
    return string_equals(sub, prefix);
}

pub fn string_ends_with(s: StringSlice, suffix: StringSlice) -> bool {
    if suffix.length > s.length {
        return false;
    }
    let start: usize = s.length - suffix.length;
    let sub: StringSlice = string_slice(s, start, s.length);
    return string_equals(sub, suffix);
}

pub fn string_find_char(s: StringSlice, ch: u8) -> i64 {
    if s.data == null {
        return -1;
    }
    let mut i: usize = 0;
    unsafe {
        while i < s.length {
            if s.data[i] == ch {
                let res: i64 = i as i64;
                return res;
            }
            i = i + 1;
        }
    }
    return -1;
}

pub fn string_find(s: StringSlice, needle: StringSlice) -> i64 {
    if needle.length == 0 {
        return 0;
    }
    if s.data == null || needle.data == null || needle.length > s.length {
        return -1;
    }

    let mut start: usize = 0;
    unsafe {
        while start <= s.length - needle.length {
            let mut i: usize = 0;
            let mut matches: bool = true;
            while i < needle.length {
                if s.data[start + i] != needle.data[i] {
                    matches = false;
                    break;
                }
                i = i + 1;
            }
            if matches {
                return start as i64;
            }
            start = start + 1;
        }
    }
    return -1;
}

pub fn string_split_once(s: StringSlice, delimiter: StringSlice) -> StringSplit {
    let mut result: StringSplit = 0;
    result.before = s;
    result.after = string_from_raw(null, 0);
    result.found = false;

    if delimiter.length == 0 {
        return result;
    }

    let index: i64 = string_find(s, delimiter);
    if index < 0 {
        return result;
    }

    let cut: usize = index as usize;
    if cut == 0 {
        result.before = string_from_raw(null, 0);
    } else {
        result.before = string_slice(s, 0, cut);
    }

    let after_start: usize = cut + delimiter.length;
    if after_start < s.length {
        result.after = string_slice(s, after_start, s.length);
    }

    result.found = true;
    return result;
}

pub fn string_trim_start(s: StringSlice) -> StringSlice {
    if s.data == null || s.length == 0 {
        return s;
    }
    let mut start: usize = 0;
    unsafe {
        while start < s.length {
            let c: u8 = s.data[start];
            if c != 32 && c != 9 && c != 10 && c != 13 {
                break;
            }
            start = start + 1;
        }
    }
    return string_slice(s, start, s.length);
}

pub fn string_trim_end(s: StringSlice) -> StringSlice {
    if s.data == null || s.length == 0 {
        return s;
    }
    let mut end: usize = s.length;
    unsafe {
        while end > 0 {
            let c: u8 = s.data[end - 1];
            if c != 32 && c != 9 && c != 10 && c != 13 {
                break;
            }
            end = end - 1;
        }
    }
    return string_slice(s, 0, end);
}

pub fn string_trim(s: StringSlice) -> StringSlice {
    return string_trim_end(string_trim_start(s));
}

// Parse an ASCII decimal u32. This intentionally does not trim whitespace or
// accept signs; callers can normalize a borrowed slice before parsing.
pub fn string_parse_u32(s: StringSlice) -> ResultU32 {
    if s.data == null || s.length == 0 {
        return ResultU32::err(ResultCode::InvalidParam);
    }

    let max_value: u32 = 4294967295u32;
    let radix: u32 = 10u32;
    let mut value: u32 = 0u32;
    let mut index: usize = 0;
    unsafe {
        while index < s.length {
            let byte: u8 = s.data[index];
            if byte < 48u8 || byte > 57u8 {
                return ResultU32::err(ResultCode::InvalidParam);
            }
            let digit: u32 = (byte - 48u8) as u32;
            if value > (max_value - digit) / radix {
                return ResultU32::err(ResultCode::Overflow);
            }
            value = value * radix + digit;
            index = index + 1;
        }
    }

    return ResultU32::ok(value);
}

// Parse a signed 32-bit decimal integer. An optional leading sign is accepted;
// whitespace and trailing characters are rejected.
pub fn string_parse_i32(s: StringSlice) -> ResultI32 {
    if s.data == null || s.length == 0 {
        return ResultI32::err(ResultCode::InvalidParam);
    }

    let mut index: usize = 0;
    let mut negative: bool = false;
    unsafe {
        if s.data[0] == 45u8 {
            negative = true;
            index = 1;
        } else if s.data[0] == 43u8 {
            index = 1;
        }
    }
    if index >= s.length {
        return ResultI32::err(ResultCode::InvalidParam);
    }

    let mut limit: u32 = 2147483647u32;
    if negative {
        limit = 2147483648u32;
    }
    let radix: u32 = 10u32;
    let mut magnitude: u32 = 0u32;
    unsafe {
        while index < s.length {
            let byte: u8 = s.data[index];
            if byte < 48u8 || byte > 57u8 {
                return ResultI32::err(ResultCode::InvalidParam);
            }
            let digit: u32 = (byte - 48u8) as u32;
            if magnitude > (limit - digit) / radix {
                return ResultI32::err(ResultCode::Overflow);
            }
            magnitude = magnitude * radix + digit;
            index = index + 1;
        }
    }

    if negative {
        if magnitude == 2147483648u32 {
            return ResultI32::ok(-2147483647 - 1);
        }
        return ResultI32::ok(-(magnitude as i32));
    }
    return ResultI32::ok(magnitude as i32);
}

// Owned, growable UTF-8 string buffer
pub struct String {
    pub data: *mut u8;
    pub length: usize;
    pub capacity: usize;
    pub allocator: *mut Allocator;
}

pub fn string_new(backing: *mut u8, cap: usize) -> String {
    let mut s: String = 0;
    s.data = backing;
    s.length = 0;
    s.capacity = cap;
    s.allocator = null;
    return s;
}

pub fn string_new_with_allocator(
    allocator: *mut Allocator,
    cap: usize
) -> String {
    let mut s: String = string_new(null, 0);
    s.allocator = allocator;

    if allocator == null || cap == 0 {
        return s;
    }

    unsafe {
        let backing: *mut u8 = allocator_alloc(*allocator, cap, 1);
        if backing == null {
            return s;
        }
        s.data = backing;
        s.capacity = cap;
        return s;
    }
}

fn string_growth_capacity(
    current_capacity: usize,
    required_capacity: usize
) -> usize {
    if required_capacity <= current_capacity {
        return current_capacity;
    }

    let max_capacity: usize = ~0usize;
    let mut next_capacity: usize = current_capacity;

    if next_capacity < 8 {
        next_capacity = 8;
    }

    while next_capacity < required_capacity {
        if next_capacity > max_capacity - next_capacity {
            return required_capacity;
        }
        next_capacity = next_capacity + next_capacity;
    }

    return next_capacity;
}

pub fn string_reserve(
    s: *mut String,
    min_capacity: usize
) -> bool {
    if s == null {
        return false;
    }

    unsafe {
        if min_capacity <= (*s).capacity {
            return true;
        }
        if (*s).allocator == null {
            return false;
        }
        if (*s).length > (*s).capacity {
            return false;
        }
        if (*s).length > 0 && (*s).data == null {
            return false;
        }

        let allocator_ptr: *mut Allocator = (*s).allocator;
        let allocator_value: Allocator = *allocator_ptr;
        let new_backing: *mut u8 = allocator_realloc(
            allocator_value,
            (*s).data,
            (*s).capacity,
            min_capacity,
            1
        );
        if new_backing == null {
            return false;
        }

        (*s).data = new_backing;
        (*s).capacity = min_capacity;
        return true;
    }
}

// Explicit owned cleanup. This is intentionally not wired to automatic
// Type_deinit RAII yet: returned String values still require move-aware cleanup
// suppression in the native emitter before automatic destruction is safe.
pub fn string_deinit(s: *mut String) -> void {
    if s == null {
        return;
    }

    unsafe {
        let allocator_ptr: *mut Allocator = (*s).allocator;
        let data_ptr: *mut u8 = (*s).data;
        let old_capacity: usize = (*s).capacity;

        if allocator_ptr != null && data_ptr != null {
            let allocator_value: Allocator = *allocator_ptr;
            allocator_free(
                allocator_value,
                data_ptr,
                old_capacity,
                1
            );
        }

        (*s).data = null;
        (*s).length = 0;
        (*s).capacity = 0;
        (*s).allocator = null;
    }
}

pub fn string_new_in_arena(
    arena: *mut ArenaAllocator,
    cap: usize
) -> String {
    if arena == null || cap == 0 {
        return string_new(null, 0);
    }
    let backing: *mut u8 = arena_alloc(arena, cap);
    if backing == null {
        return string_new(null, 0);
    }
    return string_new(backing, cap);
}

pub fn string_reserve_in_arena(
    s: *mut String,
    arena: *mut ArenaAllocator,
    min_capacity: usize
) -> bool {
    if s == null || arena == null {
        return false;
    }

    unsafe {
        if min_capacity <= (*s).capacity {
            return true;
        }
        if (*s).length > 0 && (*s).data == null {
            return false;
        }

        let new_backing: *mut u8 = arena_alloc(arena, min_capacity);
        if new_backing == null {
            return false;
        }

        let old_length: usize = (*s).length;
        let old_data: *const u8 = (*s).data as *const u8;
        let mut grown: String = string_new(new_backing, min_capacity);
        let grown_ptr: *mut String = (&mut grown) as *mut String;

        if old_length > 0 {
            let old_slice: StringSlice = string_from_raw(old_data, old_length);
            if !string_append_slice(grown_ptr, old_slice) {
                return false;
            }
        }

        (*s).data = grown.data;
        (*s).length = grown.length;
        (*s).capacity = grown.capacity;
        return true;
    }
}

pub fn string_append_char(s: *mut String, ch: u8) -> bool {
    if s == null {
        return false;
    }
    unsafe {
        if (*s).data == null || (*s).length >= (*s).capacity {
            return false;
        }
        let target: *mut u8 = (*s).data + (*s).length;
        *target = ch;
        (*s).length = (*s).length + 1;
        return true;
    }
}

pub fn string_append_slice(s: *mut String, slice: StringSlice) -> bool {
    if s == null {
        return false;
    }
    // Appending an empty slice is a successful no-op, even when its data
    // pointer is null. Keep this consistent with the owned append variants.
    if slice.length == 0 {
        return true;
    }
    if slice.data == null {
        return false;
    }
    unsafe {
        if (*s).length > (*s).capacity || (*s).data == null {
            return false;
        }
        if slice.length > (*s).capacity - (*s).length {
            return false;
        }
        let max_address: usize = ~0usize;
        let base_address: usize = (*s).data as usize;
        if (*s).capacity > max_address - base_address {
            return false;
        }
        let buffer_end: usize = base_address + (*s).capacity;
        let source_address: usize = slice.data as usize;
        let mut aliases_buffer: bool = false;
        let mut source_offset: usize = 0;
        if source_address >= base_address && source_address <= buffer_end {
            if slice.length > buffer_end - source_address {
                return false;
            }
            aliases_buffer = true;
            source_offset = source_address - base_address;
        }
        if aliases_buffer && source_offset < (*s).length &&
           slice.length > (*s).length - source_offset {
            let mut remaining: usize = slice.length;
            while remaining > 0 {
                remaining = remaining - 1;
                let target: *mut u8 = (*s).data + ((*s).length + remaining);
                *target = slice.data[remaining];
            }
            (*s).length = (*s).length + slice.length;
            return true;
        }
        let mut i: usize = 0;
        while i < slice.length {
            let target: *mut u8 = (*s).data + ((*s).length + i);
            *target = slice.data[i];
            i = i + 1;
        }
        (*s).length = (*s).length + slice.length;
        return true;
    }
}

pub fn string_append_char_owned(
    s: *mut String,
    ch: u8
) -> bool {
    if s == null {
        return false;
    }

    unsafe {
        if (*s).length > (*s).capacity {
            return false;
        }

        let max_length: usize = ~0usize;
        if (*s).length == max_length {
            return false;
        }

        if (*s).length == (*s).capacity {
            let required: usize = (*s).length + 1;
            let target_capacity: usize =
                string_growth_capacity((*s).capacity, required);
            if !string_reserve(s, target_capacity) {
                return false;
            }
        }
    }

    return string_append_char(s, ch);
}

pub fn string_append_slice_owned(
    s: *mut String,
    slice: StringSlice
) -> bool {
    if s == null {
        return false;
    }
    if slice.length == 0 {
        return true;
    }
    if slice.data == null {
        return false;
    }

    let mut aliases_buffer: bool = false;
    let mut source_offset: usize = 0;
    unsafe {
        if (*s).length > (*s).capacity {
            return false;
        }
        if (*s).data == null {
            return false;
        }

        let max_address: usize = ~0usize;
        let base_address: usize = (*s).data as usize;
        if (*s).capacity > max_address - base_address {
            return false;
        }
        let buffer_end: usize = base_address + (*s).capacity;
        let source_address: usize = slice.data as usize;
        if source_address >= base_address && source_address <= buffer_end {
            if slice.length > buffer_end - source_address {
                return false;
            }
            aliases_buffer = true;
            source_offset = source_address - base_address;
        }

        let max_length: usize = ~0usize;
        if slice.length > max_length - (*s).length {
            return false;
        }

        let available: usize = (*s).capacity - (*s).length;
        if slice.length > available {
            if slice.length > (~0usize - (*s).length) {
                return false;
            }
            let required: usize = (*s).length + slice.length;
            let target_capacity: usize =
                string_growth_capacity((*s).capacity, required);
            if !string_reserve(s, target_capacity) {
                return false;
            }
            if aliases_buffer {
                slice.data = (*s).data + source_offset;
            }
        }
    }

    return string_append_slice(s, slice);
}

pub fn string_append_char_in_arena(
    s: *mut String,
    arena: *mut ArenaAllocator,
    ch: u8
) -> bool {
    if s == null || arena == null {
        return false;
    }

    unsafe {
        if (*s).length > (*s).capacity {
            return false;
        }

        let max_length: usize = ~0usize;
        if (*s).length == max_length {
            return false;
        }

        if (*s).length == (*s).capacity {
            let required: usize = (*s).length + 1;
            if !string_reserve_in_arena(s, arena, required) {
                return false;
            }
        }
    }

    return string_append_char(s, ch);
}

pub fn string_append_slice_in_arena(
    s: *mut String,
    arena: *mut ArenaAllocator,
    slice: StringSlice
) -> bool {
    if s == null || arena == null {
        return false;
    }
    if slice.length == 0 {
        return true;
    }
    if slice.data == null {
        return false;
    }

    unsafe {
        if (*s).length > (*s).capacity {
            return false;
        }

        let max_length: usize = ~0usize;
        if slice.length > max_length - (*s).length {
            return false;
        }

        let available: usize = (*s).capacity - (*s).length;
        if slice.length > available {
            if slice.length > (~0usize - (*s).length) {
                return false;
            }
            let required: usize = (*s).length + slice.length;
            if !string_reserve_in_arena(s, arena, required) {
                return false;
            }
        }
    }

    return string_append_slice(s, slice);
}

pub fn string_concat_into(
    out: *mut String,
    a: StringSlice,
    b: StringSlice
) -> bool {
    if out == null {
        return false;
    }

    unsafe {
        if (*out).data == null {
            return false;
        }
        if a.length > 0 && a.data == null {
            return false;
        }
        if b.length > 0 && b.data == null {
            return false;
        }
        if a.length > (*out).capacity {
            return false;
        }
        if b.length > (*out).capacity - a.length {
            return false;
        }

        (*out).length = 0;
    }

    if a.length > 0 && !string_append_slice(out, a) {
        return false;
    }
    if b.length > 0 && !string_append_slice(out, b) {
        return false;
    }
    return true;
}

pub fn string_as_slice(s: *const String) -> StringSlice {
    if s == null {
        return string_from_raw(null, 0);
    }
    unsafe {
        return string_from_raw((*s).data as *const u8, (*s).length);
    }
}

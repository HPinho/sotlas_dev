module core::sort;

// ============================================================================
// core::sort — Algoritmos de Ordenação Zero-Alloc
// ============================================================================
//
// "Sorting is the most deeply studied problem in computer science."
//    — Donald Knuth, provavelmente enquanto tomava café
//
// Três algoritmos, cada um pro seu cenário:
// - InsertionSort: arrays pequenos (< 16). Rápido pra dados quase ordenados.
// - ShellSort: médio porte. Sem recursão, sem alocação extra.
// - HeapSort: O(n log n) GARANTIDO. Sem recursão. Ideal pra real-time e kernel.
//
// Todos operam in-place com backing buffer fornecido pelo caller.
// Nenhum usa malloc, nenhum usa stack recursivo, nenhum usa libc.
// ============================================================================

// ============================================================================
// Insertion Sort — O "isso é pequeno demais pra justificar algo complexo"
// ============================================================================
// Complexidade: O(n²) worst case, O(n) best case (dados já ordenados).
// Na prática, bate quicksort pra n < ~16 por causa do overhead menor.

pub fn insertion_sort_u32(arr: *mut u32, len: usize) {
    if arr == null || len < 2 {
        return;
    }
    let mut i: usize = 1;
    unsafe {
        while i < len {
            let key: u32 = *(arr + i);
            let mut j: usize = i;
            // Empurra elementos maiores pra direita
            while j > 0 && *(arr + (j - 1)) > key {
                *(arr + j) = *(arr + (j - 1));
                j = j - 1;
            }
            *(arr + j) = key;
            i = i + 1;
        }
    }
}

pub fn insertion_sort_u64(arr: *mut u64, len: usize) {
    if arr == null || len < 2 {
        return;
    }
    let mut i: usize = 1;
    unsafe {
        while i < len {
            let key: u64 = *(arr + i);
            let mut j: usize = i;
            while j > 0 && *(arr + (j - 1)) > key {
                *(arr + j) = *(arr + (j - 1));
                j = j - 1;
            }
            *(arr + j) = key;
            i = i + 1;
        }
    }
}


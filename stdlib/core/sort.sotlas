}

// ============================================================================
// Shell Sort — O "diminishing increment sort" de 1959
// ============================================================================
// Donald Shell inventou isso antes de muita gente aqui ter nascido.
// Gap sequence de Ciura (usado por glibc e muitos outros):
// 701, 301, 132, 57, 23, 10, 4, 1
//
// Complexidade: O(n^(4/3)) pra essa sequência de gaps. Na prática, pra
// arrays de até ~10000 elementos, é mais rápido que mergesort por causa
// do cache locality superior e zero alocações extras.

pub fn shell_sort_u32(arr: *mut u32, len: usize) {
    if arr == null || len < 2 {
        return;
    }
    // Gap sequence de Ciura — cada gap é ~2.25x o anterior
    let mut gaps: [usize; 8] = 0;
    gaps[0] = 701;
    gaps[1] = 301;
    gaps[2] = 132;
    gaps[3] = 57;
    gaps[4] = 23;
    gaps[5] = 10;
    gaps[6] = 4;
    gaps[7] = 1;

    let mut g: usize = 0;
    while g < 8 {
        let gap: usize = gaps[g];
        if gap < len {
            let mut i: usize = gap;
            unsafe {
                while i < len {
                    let temp: u32 = *(arr + i);
                    let mut j: usize = i;
                    while j >= gap && *(arr + (j - gap)) > temp {
                        *(arr + j) = *(arr + (j - gap));
                        j = j - gap;
                    }
                    *(arr + j) = temp;
                    i = i + 1;
                }
            }
        }
        g = g + 1;
    }
}

pub fn shell_sort_u64(arr: *mut u64, len: usize) {
    if arr == null || len < 2 {
        return;
    }
    let mut gaps: [usize; 8] = 0;
    gaps[0] = 701;
    gaps[1] = 301;
    gaps[2] = 132;
    gaps[3] = 57;
    gaps[4] = 23;
    gaps[5] = 10;
    gaps[6] = 4;
    gaps[7] = 1;

    let mut g: usize = 0;
    while g < 8 {
        let gap: usize = gaps[g];
        if gap < len {
            let mut i: usize = gap;
            unsafe {
                while i < len {
                    let temp: u64 = *(arr + i);
                    let mut j: usize = i;
                    while j >= gap && *(arr + (j - gap)) > temp {
                        *(arr + j) = *(arr + (j - gap));
                        j = j - gap;
                    }
                    *(arr + j) = temp;
                    i = i + 1;
                }
            }
        }
        g = g + 1;
    }
}

// ============================================================================
// Heap Sort — O(n log n) GARANTIDO, in-place, sem recursão
// ============================================================================
// Pra quem precisa de previsibilidade absoluta (real-time, kernel scheduler).
// Quicksort pode degradar pra O(n²) com dados adversários.
// Heapsort NUNCA faz isso. É o "always on time" dos algoritmos.

// Sift-down: restaura a propriedade do max-heap a partir do índice `start`
fn sift_down_u32(arr: *mut u32, start: usize, end: usize) {
    let mut root: usize = start;
    unsafe {
        while root * 2 + 1 <= end {
            let left: usize = root * 2 + 1;
            let mut swap_idx: usize = root;

            if *(arr + swap_idx) < *(arr + left) {
                swap_idx = left;
            }
            if left + 1 <= end && *(arr + swap_idx) < *(arr + left + 1) {
                swap_idx = left + 1;
            }
            if swap_idx == root {
                return;
            }
            // Swap manual — não temos std::swap, fazemos na marra
            let tmp: u32 = *(arr + root);
            *(arr + root) = *(arr + swap_idx);
            *(arr + swap_idx) = tmp;
            root = swap_idx;
        }
    }
}

pub fn heap_sort_u32(arr: *mut u32, len: usize) {
    if arr == null || len < 2 {
        return;
    }
    // Fase 1: Build max-heap (heapify)
    // Começa do último nó não-folha e sobe
    let mut start: usize = (len - 2) / 2;
    loop {
        sift_down_u32(arr, start, len - 1);
        if start == 0 {
            break;
        }
        start = start - 1;
    }

    // Fase 2: Extract max repetidamente
    let mut end: usize = len - 1;
    unsafe {
        while end > 0 {
            // O maior elemento está em arr[0] — troca com arr[end]
            let tmp: u32 = *(arr + 0);
            *(arr + 0) = *(arr + end);
            *(arr + end) = tmp;
            end = end - 1;
            sift_down_u32(arr, 0, end);
        }
    }
}

fn sift_down_u64(arr: *mut u64, start: usize, end: usize) {
    let mut root: usize = start;
    unsafe {
        while root * 2 + 1 <= end {
            let left: usize = root * 2 + 1;
            let mut swap_idx: usize = root;

            if *(arr + swap_idx) < *(arr + left) {
                swap_idx = left;
            }
            if left + 1 <= end && *(arr + swap_idx) < *(arr + left + 1) {
                swap_idx = left + 1;
            }
            if swap_idx == root {
                return;
            }
            let tmp: u64 = *(arr + root);
            *(arr + root) = *(arr + swap_idx);
            *(arr + swap_idx) = tmp;
            root = swap_idx;
        }
    }
}

pub fn heap_sort_u64(arr: *mut u64, len: usize) {
    if arr == null || len < 2 {
        return;
    }
    let mut start: usize = (len - 2) / 2;
    loop {
        sift_down_u64(arr, start, len - 1);
        if start == 0 {
            break;
        }
        start = start - 1;
    }

    let mut end: usize = len - 1;
    unsafe {
        while end > 0 {
            let tmp: u64 = *(arr + 0);
            *(arr + 0) = *(arr + end);
            *(arr + end) = tmp;
            end = end - 1;
            sift_down_u64(arr, 0, end);
        }
    }
}

// ============================================================================
// Utilitários — Porque ninguém quer escrever um loop só pra checar se tá ordenado
// ============================================================================

pub fn is_sorted_u32(arr: *const u32, len: usize) -> bool {
    if arr == null || len < 2 {
        return true;
    }
    let mut i: usize = 1;
    unsafe {
        while i < len {
            if *(arr + i) < *(arr + (i - 1)) {
                return false;
            }
            i = i + 1;
        }
    }
    return true;
}

pub fn is_sorted_u64(arr: *const u64, len: usize) -> bool {
    if arr == null || len < 2 {
        return true;
    }
    let mut i: usize = 1;
    unsafe {
        while i < len {
            if *(arr + i) < *(arr + (i - 1)) {
                return false;
            }
            i = i + 1;
        }
    }
    return true;
}

pub fn reverse_u32(arr: *mut u32, len: usize) {
    if arr == null || len < 2 {
        return;
    }
    let mut lo: usize = 0;
    let mut hi: usize = len - 1;
    unsafe {
        while lo < hi {
            let tmp: u32 = *(arr + lo);
            *(arr + lo) = *(arr + hi);
            *(arr + hi) = tmp;
            lo = lo + 1;
            hi = hi - 1;
        }
    }
}

pub fn reverse_u64(arr: *mut u64, len: usize) {
    if arr == null || len < 2 {
        return;
    }
    let mut lo: usize = 0;
    let mut hi: usize = len - 1;
    unsafe {
        while lo < hi {
            let tmp: u64 = *(arr + lo);
            *(arr + lo) = *(arr + hi);
            *(arr + hi) = tmp;
            lo = lo + 1;
            hi = hi - 1;
        }
    }
}

pub fn min_u32(arr: *const u32, len: usize) -> u32 {
    if arr == null || len == 0 {
        return 0;
    }
    unsafe {
        let mut best: u32 = *(arr + 0);
        let mut i: usize = 1;
        while i < len {
            if *(arr + i) < best {
                best = *(arr + i);
            }
            i = i + 1;
        }
        return best;
    }
}

pub fn max_u32(arr: *const u32, len: usize) -> u32 {
    if arr == null || len == 0 {
        return 0;
    }
    unsafe {
        let mut best: u32 = *(arr + 0);
        let mut i: usize = 1;
        while i < len {
            if *(arr + i) > best {
                best = *(arr + i);
            }
            i = i + 1;
        }
        return best;
    }
}

pub fn min_u64(arr: *const u64, len: usize) -> u64 {
    if arr == null || len == 0 {
        return 0;
    }
    unsafe {
        let mut best: u64 = *(arr + 0);
        let mut i: usize = 1;
        while i < len {
            if *(arr + i) < best {
                best = *(arr + i);
            }
            i = i + 1;
        }
        return best;
    }
}

pub fn max_u64(arr: *const u64, len: usize) -> u64 {
    if arr == null || len == 0 {
        return 0;
    }
    unsafe {
        let mut best: u64 = *(arr + 0);
        let mut i: usize = 1;
        while i < len {
            if *(arr + i) > best {
                best = *(arr + i);
            }
            i = i + 1;
        }
        return best;
    }
}

// Swap individual — útil pra quem quer montar seu próprio sort customizado
pub fn swap_u32(arr: *mut u32, i: usize, j: usize) {
    if arr == null || i == j {
        return;
    }
    unsafe {
        let tmp: u32 = *(arr + i);
        *(arr + i) = *(arr + j);
        *(arr + j) = tmp;
    }
}

pub fn swap_u64(arr: *mut u64, i: usize, j: usize) {
    if arr == null || i == j {
        return;
    }
    unsafe {
        let tmp: u64 = *(arr + i);
        *(arr + i) = *(arr + j);
        *(arr + j) = tmp;
    }
}

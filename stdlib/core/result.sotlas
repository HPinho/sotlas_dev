module core::result;

pub enum ResultCode {
    Ok = 0,
    Error = 1,
    OutOfMemory = 2,
    InvalidParam = 3,
    NotFound = 4,
    PermissionDenied = 5,
    TimedOut = 6,
    Busy = 7,
    Overflow = 8
}

pub class ResultBool {
    status: ResultCode;
    value: bool;

    pub fn ok(val: bool) -> ResultBool {
        let mut r: ResultBool = 0;
        r.status = ResultCode::Ok;
        r.value = val;
        return r;
    }

    pub fn err(code: ResultCode) -> ResultBool {
        let mut r: ResultBool = 0;
        r.status = code;
        r.value = false;
        return r;
    }

    pub fn is_ok(self: *const ResultBool) -> bool {
        if self == null { return false; }
        unsafe { return self.status == ResultCode::Ok; }
    }

    pub fn is_err(self: *const ResultBool) -> bool {
        if self == null { return true; }
        unsafe { return self.status != ResultCode::Ok; }
    }

    pub fn unwrap_or(self: *const ResultBool, default_val: bool) -> bool {
        if self == null { return default_val; }
        unsafe {
            if self.status == ResultCode::Ok { return self.value; }
        }
        return default_val;
    }

    // Copies the success value and leaves output untouched on error.
    pub fn try_unwrap(self: *const ResultBool, out: *mut bool) -> bool {
        if self == null || out == null { return false; }
        unsafe {
            if self.status != ResultCode::Ok { return false; }
            *out = self.value;
            return true;
        }
    }

    pub fn unwrap(self: *const ResultBool) -> bool {
        unsafe { return self.unwrap_or(false); }
    }

    pub fn unwrap_err(self: *const ResultBool) -> ResultCode {
        if self == null { return ResultCode::Error; }
        unsafe { return self.status; }
    }
}

pub class ResultU32 {
    status: ResultCode;
    value: u32;

    pub fn ok(val: u32) -> ResultU32 {
        let mut r: ResultU32 = 0;
        r.status = ResultCode::Ok;
        r.value = val;
        return r;
    }

    pub fn err(code: ResultCode) -> ResultU32 {
        let mut r: ResultU32 = 0;
        r.status = code;
        r.value = 0;
        return r;
    }

    pub fn is_ok(self: *const ResultU32) -> bool {
        if self == null {
            return false;
        }
        unsafe {
            return self.status == ResultCode::Ok;
        }
    }

    pub fn is_err(self: *const ResultU32) -> bool {
        if self == null {
            return true;
        }
        unsafe {
            return self.status != ResultCode::Ok;
        }
    }

    pub fn unwrap_or(self: *const ResultU32, default_val: u32) -> u32 {
        if self == null {
            return default_val;
        }
        unsafe {
            if self.status == ResultCode::Ok {
                return self.value;
            }
        }
        return default_val;
    }

    // Copies the success value to caller storage and leaves it untouched on error.
    pub fn try_unwrap(self: *const ResultU32, out: *mut u32) -> bool {
        if self == null || out == null {
            return false;
        }
        unsafe {
            if self.status != ResultCode::Ok {
                return false;
            }
            *out = self.value;
            return true;
        }
    }

    pub fn unwrap(self: *const ResultU32) -> u32 {
        unsafe {
            return self.unwrap_or(0);
        }
    }

    pub fn unwrap_err(self: *const ResultU32) -> ResultCode {
        if self == null {
            return ResultCode::Error;
        }
        unsafe {
            return self.status;
        }
    }
}


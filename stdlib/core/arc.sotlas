module core::arc;
import core::mem::*;

@repr(C)
pub struct ArcHeader {
    ref_count: u64;
    data_size: usize;
}

// ============================================================================
// Atomic ARC — seguro para SMP
// ============================================================================
// Retain and release use compare-and-swap loops over sequentially consistent
// atomic loads. The checked C11 runtime supplies these operations on supported
// project builds; local helpers below remain explicitly single-threaded.

@system
pub fn arc_init(header: *mut ArcHeader, size: usize) {
    if header != null {
        unsafe {
            // Inicialização não precisa ser atômica — nenhuma outra CPU tem
            // acesso ao header neste ponto.
            __atomic_store_u64((&header.ref_count) as u64, 1u64);
            header.data_size = size;
        }
    }
}

// Incrementa atomicamente o ref_count. Retorna o header para encadeamento.
@system
pub fn arc_retain(header: *mut ArcHeader) -> *mut ArcHeader {
    if header == null {
        return null;
    }
    let mut address: u64 = 0;
    let mut count: u64 = 0;
    unsafe {
        address = (&header.ref_count) as u64;
        count = __atomic_load_u64(address);
    }
    while count > 0 {
        if count == 18446744073709551615u64 {
            return null;
        }
        let mut observed: u64 = 0;
        unsafe {
            observed = __atomic_cmpxchg_u64(address, count, count + 1u64);
        }
        if observed == count {
            return header;
        }
        count = observed;
    }
    return null;
}

// Decrementa atomicamente o ref_count. Retorna true se o ref_count chegou a 0
// (o chamador é responsável por liberar a memória).
@system
pub fn arc_release(header: *mut ArcHeader) -> bool {
    if header == null {
        return false;
    }
    let mut address: u64 = 0;
    let mut count: u64 = 0;
    unsafe {
        address = (&header.ref_count) as u64;
        count = __atomic_load_u64(address);
    }
    while count > 0 {
        let mut observed: u64 = 0;
        unsafe {
            observed = __atomic_cmpxchg_u64(address, count, count - 1u64);
        }
        if observed == count {
            return count == 1u64;
        }
        count = observed;
    }
    return false;
}

// Lê atomicamente o ref_count sem modificá-lo.
@system
pub fn arc_count(header: *const ArcHeader) -> u64 {
    if header == null {
        return 0;
    }
    unsafe {
        return __atomic_load_u64((&header.ref_count) as u64);
    }
}

// ============================================================================
// Versões locais (não-atômicas) — para hot paths single-CPU
// ============================================================================
// Use SOMENTE quando tiver certeza de que o ArcHeader não é compartilhado
// entre CPUs (e.g., dados thread-local, período de bootstrap antes de SMP).

pub fn arc_retain_local(header: *mut ArcHeader) -> *mut ArcHeader {
    if header == null {
        return null;
    }
    unsafe {
        if header.ref_count == 0 ||
           header.ref_count == 18446744073709551615u64 {
            return null;
        }
        header.ref_count = header.ref_count + 1u64;
    }
    return header;
}

pub fn arc_release_local(header: *mut ArcHeader) -> bool {
    if header == null {
        return false;
    }
    unsafe {
        if header.ref_count == 0 {
            return false;
        }
        header.ref_count = header.ref_count - 1u64;
        return header.ref_count == 0;
    }
}

// ============================================================================
// SharedCounter — exemplo de uso do ARC atômico
// ============================================================================

pub class SharedCounter {
    header: ArcHeader;
    value: u64;

    pub fn new(initial: u64) -> SharedCounter {
        let mut sc: SharedCounter = 0;
        unsafe { arc_init((&mut sc.header) as *mut ArcHeader, 8); }
        sc.value = initial;
        return sc;
    }

    pub fn increment(self: *mut SharedCounter) {
        if self != null {
            unsafe {
                // O incremento do value em si não é atômico aqui;
                // o caller deve proteger com SpinLock se acessado de múltiplas CPUs.
                self.value = self.value + 1;
            }
        }
    }

    pub fn get_value(self: *const SharedCounter) -> u64 {
        if self == null {
            return 0;
        }
        unsafe {
            return self.value;
        }
    }

    pub fn retain(self: *mut SharedCounter) -> bool {
        if self == null {
            return false;
        }
        unsafe {
            return arc_retain((&self.header) as *mut ArcHeader) != null;
        }
    }

    pub fn release(self: *mut SharedCounter) -> bool {
        if self != null {
            unsafe {
                return arc_release(self as *mut ArcHeader);
            }
        }
        return false;
    }
}
